{
  "name": "vscode-rune",
  "displayName": "Rune",
  "description": "Language support for Rune source files.",
  "version": "0.1.0",
  "publisher": "oboard",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:rune"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Rune",
      "properties": {
        "rune.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the rune executable. Empty means use workspace .bin/rune first, then PATH."
        }
      }
    },
    "languages": [
      {
        "id": "rune",
        "aliases": [
          "Rune",
          "rune"
        ],
        "extensions": [
          ".rn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rune",
        "scopeName": "source.rune",
        "path": "./syntaxes/rune.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rune",
        "path": "./snippets/rune.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.3"
  }
}
