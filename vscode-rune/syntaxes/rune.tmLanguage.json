{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rune",
  "scopeName": "source.rune",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#regex" },
    { "include": "#numbers" },
    { "include": "#modules" },
    { "include": "#typeDefinition" },
    { "include": "#functionDefinition" },
    { "include": "#operators" },
    { "include": "#bindings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rune",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rune",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rune",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rune",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.rune",
          "begin": "(/)(?=([^/\\\\\\n\\[]|\\\\.|\\[([^\\]\\\\\\n]|\\\\.)*\\])+/[A-Za-z]*)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.rune" }
          },
          "end": "(/)([A-Za-z]*)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.rune" },
            "2": { "name": "keyword.other.regex-options.rune" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.rune",
              "match": "\\\\."
            },
            {
              "name": "constant.other.character-class.regexp.rune",
              "begin": "\\[",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.character-class.begin.rune" }
              },
              "end": "\\]",
              "endCaptures": {
                "0": { "name": "punctuation.definition.character-class.end.rune" }
              },
              "patterns": [
                {
                  "name": "constant.character.escape.rune",
                  "match": "\\\\."
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.bigint.rune",
          "match": "\\b\\d+n\\b"
        },
        {
          "name": "constant.numeric.double.rune",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.rune",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "meta.module-call.rune",
          "match": "(@[A-Za-z_][A-Za-z0-9_]*)(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.rune" },
            "2": { "name": "punctuation.accessor.dot.rune" },
            "3": { "name": "entity.name.function.rune" }
          }
        },
        {
          "name": "meta.module.rune",
          "match": "(@[A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.rune" }
          }
        }
      ]
    },
    "typeDefinition": {
      "patterns": [
        {
          "name": "meta.type.rune",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\[[^\\]\\r\\n]*\\])?\\s*(:)\\s*(\\{)",
          "captures": {
            "1": { "name": "entity.name.type.rune" },
            "2": { "name": "entity.name.type.parameter.rune" },
            "3": { "name": "punctuation.separator.type.rune" },
            "4": { "name": "punctuation.definition.block.begin.rune" }
          }
        },
        {
          "name": "meta.enum-member.rune",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(-?\\d+)\\b",
          "captures": {
            "1": { "name": "constant.other.enum.rune" },
            "2": { "name": "keyword.operator.assignment.rune" },
            "3": { "name": "constant.numeric.integer.rune" }
          }
        }
      ]
    },
    "functionDefinition": {
      "patterns": [
        {
          "name": "meta.function.generic.rune",
          "begin": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\[)(?=[^\\]\\r\\n]*\\]\\s*\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.function.rune" },
            "2": { "name": "punctuation.definition.typeparameters.begin.rune" }
          },
          "end": "(\\])\\s*(\\()",
          "endCaptures": {
            "1": { "name": "punctuation.definition.typeparameters.end.rune" },
            "2": { "name": "punctuation.definition.parameters.begin.rune" }
          },
          "patterns": [
            {
              "name": "entity.name.type.parameter.rune",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.rune",
              "match": ","
            }
          ]
        },
        {
          "name": "meta.function.rune",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "entity.name.function.rune" },
            "2": { "name": "punctuation.definition.parameters.begin.rune" }
          }
        },
        {
          "name": "storage.type.rune",
          "match": "\\b(Int|Int4|Int8|Int16|Int64|UInt|UInt8|UInt16|UInt64|Float|Double|BigInt|String|Bool|Regex|Null|Void|HTMLElement|Any|Dynamic|Binary|Buffer|Reader|Writer|Array|Map|Set|WeakMap|WeakSet|Record)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.rune",
          "match": "(=>|->)"
        },
        {
          "name": "keyword.operator.assignment.rune",
          "match": "(:=|~=|\\$=|=)"
        },
        {
          "name": "keyword.operator.comparison.rune",
          "match": "(<=|>=|==|!=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.rune",
          "match": "(\\+\\+|[+\\-*/%])"
        },
        {
          "name": "keyword.operator.bitwise.rune",
          "match": "(>>>|>>|<<|[~&|^])"
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "name": "constant.language.boolean.rune",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.wildcard.rune",
          "match": "\\b_\\b"
        }
      ]
    }
  }
}
