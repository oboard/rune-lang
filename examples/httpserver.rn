response() -> Bytes => @bytes.fromInts([72, 84, 84, 80, 47, 49, 46, 49, 32, 50, 48, 48, 32, 79, 75, 13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 84, 121, 112, 101, 58, 32, 116, 101, 120, 116, 47, 112, 108, 97, 105, 110, 59, 32, 99, 104, 97, 114, 115, 101, 116, 61, 117, 116, 102, 45, 56, 13, 10, 67, 111, 110, 116, 101, 110, 116, 45, 76, 101, 110, 103, 116, 104, 58, 32, 49, 51, 13, 10, 67, 111, 110, 110, 101, 99, 116, 105, 111, 110, 58, 32, 99, 108, 111, 115, 101, 13, 10, 13, 10, 72, 101, 108, 108, 111, 44, 32, 82, 117, 110, 101, 33, 10])

~ main() => {
  listener := @net.listen("127.0.0.1:8080")?
  @io.println("listening on http://" + listener.address())
  conn := listener.accept()?
  conn.read(1024)?
  conn.write(response())?
  conn.close()?
  listener.close()?
}
