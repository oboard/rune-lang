~ demo() => {
  path := ".rune-core-example.txt"
  @fs.writeFileText(path, "hello from fs")?
  text := @fs.readFileText(path)?
  compressed := @compress.gzipText(text)?
  restored := @compress.gunzipText(compressed)?
  brotli := @compress.brotliText(text)?
  brotliRestored := @compress.unbrotliText(brotli)?
  zstd := @compress.zstdText(text)?
  zstdRestored := @compress.unzstdText(zstd)?
  @io.println(restored + " / " + brotliRestored + " / " + zstdRestored)
  @fs.remove(path)?
}

main() => {
  demo()
}
