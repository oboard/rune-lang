main() => {
    // new signal
    count $= 0

    // computed，自动推导
    double := count * 2

    // watch
    double -> {
        @io.println(double)
    }

    // watch with old/new
    // -> is watch
    // signal -> function(old, new)
    count -> (old, new) => {
        @io.println(old)
        @io.println(new)
    }

    // update
    count = count + 1
}
