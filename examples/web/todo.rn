TodoItem: {
  name: String
  status: Bool
}

+ render() => {
  $list := [
    TodoItem {
      name: "Item 1",
      status: false
    },
    TodoItem {
      name: "Item 2",
      status: false
    },
    TodoItem {
      name: "Item 3",
      status: false
    }
  ]
  $inputValue := ""
  addTodo := () => {
    $list.push(TodoItem {
      name: $inputValue,
      status: false
    })
  }
  <div>
    <h1>Todo Example</h1>
    <ul>
      {$list.map((item, index) => (
        <li>
          <input type="checkbox" checked={item.status} @change={(e) => {
            $list[index] = {
              ..item,
              status: !item.status
            }
          }} />
          {item.name}
        </li>
      ))}
    </ul>
    <input type="text" placeholder="Add new item" @keyup={(e) => $inputValue = e.target?.value ?? ""} @keydown={(e) => e.key} />
    <button @click={addTodo}>Add Item</button>
  </div>
}
