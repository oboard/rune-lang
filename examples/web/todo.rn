TodoItem: {
  name: String
  status: Bool
}

#web.preview
+ render() => {
  $list := [
    TodoItem {
      name: "Item 1",
      status: false
    },
    TodoItem {
      name: "Item 2",
      status: false
    },
    TodoItem {
      name: "Item 3",
      status: false
    }
  ]
  $inputValue := ""
  addTodo := (e) => {
    $list.push(TodoItem {
      name: $inputValue,
      status: false
    })
    $inputValue = ""
  }
  <div>
    <h1>Todo Example</h1>
    <ul>
      {$list.map((item, index) => (
        <li>
          <input
            type="checkbox"
            checked={item.status}
            @change={(e) => {
              $list[index] = {
                ..item,
                status: e.target.checked
              }
            }}
          />
          {item.name}
        </li>
      ))}
    </ul>
    <form @submit.prevent={addTodo}>
      <input
        type="text"
        placeholder="Add new item"
        value={$inputValue}
        @keyup={(e) => $inputValue = e.target?.value ?? ""}
        @keydown={(e) => e.key}
      />
      <button type="submit">Add Item</button>
    </form>
  </div>
}
