TodoItem: {
  name: String
  status: TodoStatus
}

TodoStatus: {
  PENDING
  COMPLETED
}

#web.preview
+ render() => {
  // list is a reactive list
  $list := [TodoItem {
    name: "Item 1",
    status: TodoStatus.PENDING
  }, TodoItem {
    name: "Item 2",
    status: TodoStatus.PENDING
  }, TodoItem {
    name: "Item 3",
    status: TodoStatus.PENDING
  }]
  $inputValue := ""
  addTodo := () => {
    $list.push(TodoItem {
      name: $inputValue,
      status: TodoStatus.PENDING
    })
  }

  <div>
    <h1>Todo Example</h1>
    <ul>
      {$list.map((item, index: Int) => (
          <input value={item.name} @change={(e) => {
        $list[index] = {
          ..item,
          name: e.target?.value ?? ""
        }
      }} />
      ))}
    </ul>
    <input type={"text"} placeholder={"Add new item"} @change={(e) => $inputValue = e.target?.value ?? ""} @keydown={(e) => e.key} />
    <button @click={addTodo}>Add Item</button>
  </div>
}
