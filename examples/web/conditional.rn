// Conditional Rendering
#web.preview
+ render() => {
  $count := 0

  <div>
    <h1>Conditional Example</h1>
    <p>
      {(
        $count > 0 ? `You've clicked \($count) times.`
          : "No clicks yet."
      )}
    </p>
    <button @click={$count++}>Click Me</button>
    <button @click={$count = 0}>Reset</button>
  </div>
}
