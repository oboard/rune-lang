render() => {
  // $[] is a reactive list, ${} is a reactive object
  list $= ["Item 1", "Item 2", "Item 3"]

  <div>
    <h1>List Example</h1>
    <ul>
      {list.map((item) => (
          <li>{item}</li>
      ))}
      <button @click={list = [...list, "New Item"]}>Add Item</button>
    </ul>
  </div>
}
