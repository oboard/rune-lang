#cli.command("ship", "Ship a build artifact", "1.0.0")
Args: {
  #cli.flag("v", "enable verbose output")
  verbose: Bool
  #cli.option("o", "FILE", "write output file", "dist/app")
  output: String
  #cli.arg("target name")
  target: String
}

#cli.main
main(args: Args) => {
  @io.println(`target: \(args.target)`)
  @io.println(`output: \(args.output)`)
  @io.println(`verbose: \(args.verbose.toString())`)
}
