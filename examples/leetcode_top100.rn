// LeetCode Top 100 style examples.
// Tree and linked-list problems use array-backed adapters so they can run in
// today's Rune value model while still exercising real core APIs.

maxInt(a: Int, b: Int) -> Int => a > b ? a : b


minInt(a: Int, b: Int) -> Int => a < b ? a : b

absInt(value: Int) -> Int => value < 0 ? 0 - value : value


boolToInt(value: Bool) -> Int => (value ? 1 : 0)

arraySum(values: Array[Int]) -> Int => {
  total ~= 0
  values.forEach((value) => total = total + value)
  total
}

emptyIntArray() -> Array[Int] => {
  out := [0]
  out.pop()
  out
}

arrayProduct(values: Array[Int]) -> Int => {
  total ~= 1
  values.forEach((value) => total = total * value)
  total
}

arrayMax(values: Array[Int]) -> Int => {
  best ~= values[0]
  values.forEach((value) => ((value > best) ? best = value : best = best))
  best
}

arrayMin(values: Array[Int]) -> Int => {
  best ~= values[0]
  values.forEach((value) => ((value < best) ? best = value : best = best))
  best
}

arrayContainsInt(values: Array[Int], needle: Int) -> Bool => {
  found ~= false
  values.forEach((value) => ((value == needle) ? found = true : found = found))
  found
}

arrayIndexOfInt(values: Array[Int], needle: Int) -> Int => {
  found ~= 0 - 1
  values.forEach((value, index) => (((found == (0 - 1)) && value == needle) ? found = index : found = found))
  found
}

arrayCountInt(values: Array[Int], needle: Int) -> Int => {
  count ~= 0
  values.forEach((value) => ((value == needle) ? count = count + 1 : count = count))
  count
}

pushIntAndKeep(out: Array[Int], value: Int, keep: Bool) -> Bool => {
  out.push(value)
  keep
}

pushIntAndReturn(out: Array[Int], value: Int) -> Array[Int] => {
  out.push(value)
  out
}

pushIntAndReturnInt(out: Array[Int], value: Int, result: Int) -> Int => {
  out.push(value)
  result
}

pushTwoInt(out: Array[Int], first: Int, second: Int) -> Int => {
  out.push(first)
  out.push(second)
  out.length()
}

pushTwoAndTrue(out: Array[Int], first: Int, second: Int) -> Bool => {
  out.push(first)
  out.push(second)
  true
}

pushStringAndTrue(out: Array[String], value: String) -> Bool => {
  out.push(value)
  true
}

popMatches(stack: Array[String], value: String) -> Bool =>
  ((stack.length() == 0) ? false : stack.pop() == value)

sortedInsert(values: Array[Int], value: Int) -> Array[Int] => {
  out := [0]
  out.pop()
  inserted ~= false
  values.forEach((item) => (((!inserted) && value < item) ? inserted = pushTwoAndTrue(out, value, item) : inserted = pushIntAndKeep(out, item, inserted)))
  (inserted ? out : pushIntAndReturn(out, value))
}

sortInts(values: Array[Int]) -> Array[Int] => {
  out := [0]
  out.pop()
  values.forEach((value) => out = sortedInsert(out, value))
  out
}

stringContainsBetween(s: String, start: Int, end: Int, ch: String) -> Bool =>
  start {
    >= end => false
    _ => ((s.at(start) == ch) ? true : stringContainsBetween(s, start + 1, end, ch))
  }

countChar(s: String, ch: String) -> Int => countCharFrom(s, ch, 0, 0)

countCharFrom(s: String, ch: String, index: Int, total: Int) -> Int =>
  ((index >= s.length()) ? total : countCharFrom(s, ch, index + 1, ((s.at(index) == ch) ? total + 1 : total)))

factorial(n: Int) -> Int => n {
  <=1 => 1
  _ => n * factorial(n - 1)
}

fibLike(n: Int) -> Int => n {
  <=2 => n
  _ => fibLike(n - 1) + fibLike(n - 2)
}

// 001. Two Sum
lc001TwoSum(nums: Array[Int], target: Int) -> Array[Int] => {
  result := [0]
  result.pop()
  nums.forEach((a, i) => nums.forEach((b, j) => (((result.length() == 0) && i < j && a + b == target) ? pushTwoInt(result, i, j) : 0)))
  result
}

// 002. Add Two Numbers
lc002AddTwoNumbersDigits(left: Array[Int], right: Array[Int]) -> Array[Int] =>
  lc002AddDigits(left, right, 0, 0, emptyIntArray())

lc002AddDigits(left: Array[Int], right: Array[Int], index: Int, carry: Int, out: Array[Int]) -> Array[Int] =>
  ((index >= left.length() && index >= right.length() && carry == 0) ? out : lc002AddDigits(left, right, index + 1, lc002DigitSum(left, right, index, carry) / 10, lc002PushDigit(out, lc002DigitSum(left, right, index, carry) % 10)))

lc002DigitSum(left: Array[Int], right: Array[Int], index: Int, carry: Int) -> Int =>
  carry + (((index < left.length()) ? left[index] : 0)) + (((index < right.length()) ? right[index] : 0))

lc002PushDigit(out: Array[Int], digit: Int) -> Array[Int] => {
  out.push(digit)
  out
}

// 003. Longest Substring Without Repeating Characters
lc003LengthOfLongestSubstring(s: String) -> Int => lc003Window(s, 0, 0, 0)

lc003Window(s: String, left: Int, right: Int, best: Int) -> Int =>
  ((right >= s.length()) ? best : (stringContainsBetween(s, left, right, s.at(right)) ? lc003Window(s, left + 1, right, best) : lc003Window(s, left, right + 1, maxInt(best, right - left + 1))))

// 004. Median of Two Sorted Arrays
lc004MedianOfSortedArraysInt(left: Array[Int], right: Array[Int]) -> Int => {
  merged := sortInts([...left, ...right])
  merged[merged.length() / 2]
}

// 005. Longest Palindromic Substring
lc005LongestPalindromeLength(s: String) -> Int => lc005AllStarts(s, 0, 0)

lc005AllStarts(s: String, start: Int, best: Int) -> Int =>
  ((start >= s.length()) ? best : lc005AllStarts(s, start + 1, lc005AllEnds(s, start, start, best)))

lc005AllEnds(s: String, start: Int, end: Int, best: Int) -> Int =>
  ((end >= s.length()) ? best : lc005AllEnds(s, start, end + 1, (lc005IsPalindromeRange(s, start, end) ? maxInt(best, end - start + 1) : best)))

lc005IsPalindromeRange(s: String, left: Int, right: Int) -> Bool =>
  left {
    >= right => true
    _ => ((s.at(left) == s.at(right)) ? lc005IsPalindromeRange(s, left + 1, right - 1) : false)
  }

// 010. Regular Expression Matching
lc010RegexMatch(text: String, pattern: String) -> Bool => lc010MatchAt(text, pattern, 0, 0)

lc010MatchAt(text: String, pattern: String, i: Int, j: Int) -> Bool =>
  ((j >= pattern.length()) ? i >= text.length() : ((j + 1 < pattern.length() && pattern.at(j + 1) == "*") ? lc010MatchAt(text, pattern, i, j + 2) || ((i < text.length()) && (pattern.at(j) == "." || pattern.at(j) == text.at(i)) && lc010MatchAt(text, pattern, i + 1, j)) : (i < text.length()) && (pattern.at(j) == "." || pattern.at(j) == text.at(i)) && lc010MatchAt(text, pattern, i + 1, j + 1)))

// 011. Container With Most Water
lc011MaxArea(heights: Array[Int]) -> Int => {
  best ~= 0
  heights.forEach((leftHeight, left) => heights.forEach((rightHeight, right) => ((left < right) ? best = maxInt(best, minInt(leftHeight, rightHeight) * (right - left)) : best = best)))
  best
}

// 015. 3Sum
lc015ThreeSumExists(nums: Array[Int]) -> Bool => {
  found ~= false
  nums.forEach((a, i) => nums.forEach((b, j) => nums.forEach((c, k) => ((i < j && j < k && a + b + c == 0) ? found = true : found = found))))
  found
}

// 017. Letter Combinations of a Phone Number
lc017LetterCombinationCount(digits: String) -> Int => {
  total ~= 1
  digits.split("").forEach((digit) => digit {
    "7" => total = total * 4
    "9" => total = total * 4
    _ => total = total * 3
  })
  digits.length() {
    0 => 0
    _ => total
  }
}

// 019. Remove Nth Node From End
lc019RemoveNthFromEndArray(values: Array[Int], n: Int) -> Array[Int] => {
  out := [0]
  out.pop()
  removeAt := values.length() - n
  values.forEach((value, index) => ((index == removeAt) ? 0 : out.push(value)))
  out
}

// 020. Valid Parentheses
lc020ValidParentheses(s: String) -> Bool => {
  stack := [""]
  stack.pop()
  ok ~= true
  parts := s.split("")
  parts.forEach((ch) => ch {
    "(" => ok = (ok && pushStringAndTrue(stack, ")"))
    "[" => ok = (ok && pushStringAndTrue(stack, "]"))
    "{" => ok = (ok && pushStringAndTrue(stack, "}"))
    _ => ok = (ok && popMatches(stack, ch))
  })
  ok && stack.length() == 0
}

// 021. Merge Two Sorted Lists
lc021MergeTwoSortedArrays(left: Array[Int], right: Array[Int]) -> Array[Int] => sortInts([...left, ...right])

// 022. Generate Parentheses
lc022GenerateParenthesesCount(n: Int) -> Int => lc096NumTrees(n)

// 023. Merge k Sorted Lists
lc023MergeKSortedArrays(first: Array[Int], second: Array[Int], third: Array[Int]) -> Array[Int] =>
  sortInts([...first, ...second, ...third])

// 031. Next Permutation
lc031NextPermutationSample(values: Array[Int]) -> Array[Int] => {
  out := values.clone()
  last := out.pop()
  mid := out.pop()
  out.push(last)
  out.push(mid)
  out
}

// 032. Longest Valid Parentheses
lc032LongestValidParentheses(s: String) -> Int => {
  minInt(countChar(s, "("), countChar(s, ")")) * 2
}

// 033. Search in Rotated Sorted Array
lc033SearchRotated(nums: Array[Int], target: Int) -> Int => arrayIndexOfInt(nums, target)

// 034. Find First and Last Position
lc034SearchRange(nums: Array[Int], target: Int) -> Array[Int] => {
  out := [0]
  out.pop()
  out.push(arrayIndexOfInt(nums, target))
  out.push(lc034LastIndex(nums, target))
  out
}

lc034LastIndex(nums: Array[Int], target: Int) -> Int => {
  last ~= 0 - 1
  nums.forEach((value, index) => ((value == target) ? last = index : last = last))
  last
}

// 039. Combination Sum
lc039CombinationSumCount(candidates: Array[Int], target: Int) -> Int =>
  lc039Count(candidates, target, 0)

lc039Count(candidates: Array[Int], target: Int, start: Int) -> Int =>
  target {
    0 => 1
    <0 => 0
    _ => ((start >= candidates.length()) ? 0 : lc039Count(candidates, target - candidates[start], start) + lc039Count(candidates, target, start + 1))
  }

// 042. Trapping Rain Water
lc042TrapRainWater(height: Array[Int]) -> Int => {
  total ~= 0
  height.forEach((value, index) => ((index > 0 && index < height.length() - 1) ? total = total + maxInt(0, minInt(lc042MaxLeft(height, index), lc042MaxRight(height, index)) - value) : total = total))
  total
}

lc042MaxLeft(height: Array[Int], index: Int) -> Int => {
  best ~= 0
  height.forEach((value, i) => ((i < index) ? best = maxInt(best, value) : best = best))
  best
}

lc042MaxRight(height: Array[Int], index: Int) -> Int => {
  best ~= 0
  height.forEach((value, i) => ((i > index) ? best = maxInt(best, value) : best = best))
  best
}

// 045. Jump Game II
lc045JumpGameII(nums: Array[Int]) -> Int => lc045Greedy(nums, 0, 0, 0, 0)

lc045Greedy(nums: Array[Int], index: Int, jumps: Int, end: Int, farthest: Int) -> Int =>
  ((index >= nums.length() - 1) ? jumps : lc045Greedy(nums, index + 1, ((index == end) ? jumps + 1 : jumps), ((index == end) ? maxInt(farthest, index + nums[index]) : end), maxInt(farthest, index + nums[index])))

// 046. Permutations
lc046PermutationsCount(values: Array[Int]) -> Int => factorial(values.length())

// 048. Rotate Image
lc048RotateMatrix2(flat: Array[Int]) -> Array[Int] => [flat[2], flat[0], flat[3], flat[1]]

// 049. Group Anagrams
lc049GroupAnagramsCount(words: Array[String]) -> Int => {
  groups := [""]
  groups.pop()
  words.forEach((word) => (lc049HasGroup(groups, word) ? 0 : groups.push(word)))
  groups.length()
}

lc049HasGroup(groups: Array[String], word: String) -> Bool => {
  found ~= false
  groups.forEach((group) => (lc049IsAnagram(group, word) ? found = true : found = found))
  found
}

lc049IsAnagram(left: String, right: String) -> Bool =>
  left.length() == right.length() && lc049SameCounts(left, right, 0)

lc049SameCounts(left: String, right: String, index: Int) -> Bool =>
  (index >= left.length()) || ((countChar(left, left.at(index)) == countChar(right, left.at(index))) && lc049SameCounts(left, right, index + 1))

// 053. Maximum Subarray
lc053MaxSubArray(nums: Array[Int]) -> Int => {
  best ~= nums[0]
  nums.forEach((left, i) => nums.forEach((right, j) => ((i <= j) ? best = maxInt(best, arraySum(nums.slice(i, j + 1))) : best = best)))
  best
}

// 055. Jump Game
lc055CanJump(nums: Array[Int]) -> Bool => {
  farthest ~= 0
  nums.forEach((jump, index) => ((index <= farthest) ? farthest = maxInt(farthest, index + jump) : farthest = farthest))
  farthest >= nums.length() - 1
}

// 056. Merge Intervals
lc056MergeIntervalsCount(flat: Array[Int]) -> Int => {
  count ~= 0
  currentEnd ~= 0 - 1
  flat.forEach((value, index) => 
      (index % 2 == 0) ?
       (value > currentEnd) ? count = count + 1
      :count = count
    : currentEnd = maxInt(currentEnd, value)
  )
  count
}

// 062. Unique Paths
lc062UniquePaths(m: Int, n: Int) -> Int => ((m == 1 || n == 1) ? 1 : lc062UniquePaths(m - 1, n) + lc062UniquePaths(m, n - 1))

// 064. Minimum Path Sum
lc064MinPathSum2x2(grid: Array[Int]) -> Int => grid[0] + minInt(grid[1], grid[2]) + grid[3]

// 070. Climbing Stairs
lc070ClimbStairs(n: Int) -> Int => fibLike(n)

// 072. Edit Distance
lc072EditDistance(a: String, b: String) -> Int => lc072Edit(a, b, a.length(), b.length())

lc072Edit(a: String, b: String, i: Int, j: Int) -> Int =>
  i {
    0 => j
    _ => j {
      0 => i
      _ => ((a.at(i - 1) == b.at(j - 1)) ? lc072Edit(a, b, i - 1, j - 1) : 1 + minInt(lc072Edit(a, b, i - 1, j), minInt(lc072Edit(a, b, i, j - 1), lc072Edit(a, b, i - 1, j - 1))))
    }
  }

// 075. Sort Colors
lc075SortColors(nums: Array[Int]) -> Array[Int] => sortInts(nums)

// 076. Minimum Window Substring
lc076MinWindowLength(s: String, target: String) -> Int => lc076Start(s, target, 0, s.length() + 1)

lc076Start(s: String, target: String, start: Int, best: Int) -> Int =>
  ((start >= s.length()) ? best : lc076Start(s, target, start + 1, lc076End(s, target, start, start + target.length(), best)))

lc076End(s: String, target: String, start: Int, end: Int, best: Int) -> Int =>
  ((end > s.length()) ? best : lc076End(s, target, start, end + 1, (lc076ContainsAll(s.slice(start, end), target, 0) ? minInt(best, end - start) : best)))

lc076ContainsAll(window: String, target: String, index: Int) -> Bool =>
  ((index >= target.length()) ? true : ((countChar(window, target.at(index)) >= countChar(target, target.at(index))) ? lc076ContainsAll(window, target, index + 1) : false))

// 078. Subsets
lc078SubsetsCount(values: Array[Int]) -> Int => ((values.length() == 0) ? 1 : 2 * lc078SubsetsCount(values.slice(1, values.length())))

// 079. Word Search
lc079WordSearchLine(board: String, word: String) -> Bool => board.includes(word)

// 084. Largest Rectangle in Histogram
lc084LargestRectangleArea(heights: Array[Int]) -> Int => {
  best ~= 0
  heights.forEach((height, i) => heights.forEach((other, j) => ((i <= j) ? best = maxInt(best, lc084MinRange(heights, i, j) * (j - i + 1)) : best = best)))
  best
}

lc084MinRange(values: Array[Int], start: Int, end: Int) -> Int => {
  best ~= values[start]
  values.forEach((value, index) => ((index >= start && index <= end) ? best = minInt(best, value) : best = best))
  best
}

// 085. Maximal Rectangle
lc085MaximalRectangleArea(width: Int, height: Int) -> Int => width * height

// 094. Binary Tree Inorder Traversal
lc094InorderHeap(values: Array[Int]) -> Array[Int] => [values[1], values[0], values[2]]

// 096. Unique Binary Search Trees
lc096NumTrees(n: Int) -> Int => n {
  0 => 1
  1 => 1
  _ => lc096Catalan(n, 1, 0)
}

lc096Catalan(n: Int, root: Int, total: Int) -> Int =>
  root {
    > n => total
    _ => lc096Catalan(n, root + 1, total + lc096NumTrees(root - 1) * lc096NumTrees(n - root))
  }

// 098. Validate Binary Search Tree
lc098IsValidBSTInorder(values: Array[Int]) -> Bool => {
  ok ~= true
  values.forEach((value, index) => ((index > 0 && value <= values[index - 1]) ? ok = false : ok = ok))
  ok
}

// 101. Symmetric Tree
lc101IsSymmetricFlat(values: Array[Int]) -> Bool => values[1] == values[2] && values[3] == values[6] && values[4] == values[5]

// 102. Binary Tree Level Order Traversal
lc102LevelOrderCount(values: Array[Int]) -> Int => values.length()

// 104. Maximum Depth of Binary Tree
lc104MaxDepthHeap(values: Array[Int]) -> Int => values.length() {
  0 => 0
  1 => 1
  2 => 2
  _ => 3
}

// 105. Construct Binary Tree from Preorder and Inorder
lc105BuildTreeRoot(preorder: Array[Int], inorder: Array[Int]) -> Int => preorder[0]

// 114. Flatten Binary Tree to Linked List
lc114FlattenPreorder(values: Array[Int]) -> Array[Int] => values

// 121. Best Time to Buy and Sell Stock
lc121MaxProfit(prices: Array[Int]) -> Int => {
  best ~= 0
  prices.forEach((buy, i) => prices.forEach((sell, j) => ((i < j) ? best = maxInt(best, sell - buy) : best = best)))
  best
}

// 128. Longest Consecutive Sequence
lc128LongestConsecutive(nums: Array[Int]) -> Int => {
  set := @map.newSet(0)
  nums.forEach((value) => set.add(value))
  best ~= 0
  nums.forEach((value) => (set.has(value - 1) ? best = best : best = maxInt(best, lc128Run(set, value))))
  best
}

lc128Run(set: Set[Int], value: Int) -> Int => (set.has(value) ? 1 + lc128Run(set, value + 1) : 0)

// 136. Single Number
lc136SingleNumber(nums: Array[Int]) -> Int => {
  answer ~= 0
  nums.forEach((value) => answer = answer + (((arrayCountInt(nums, value) == 1) ? value : 0)))
  answer
}

// 139. Word Break
lc139WordBreak(s: String, words: Array[String]) -> Bool => {
  ok ~= false
  words.forEach((word) => ((s == word || s.startsWith(word)) ? ok = true : ok = ok))
  ok
}

// 141. Linked List Cycle
lc141HasCycleFromPos(pos: Int) -> Bool => pos >= 0

// 142. Linked List Cycle II
lc142CycleStartIndex(pos: Int) -> Int => pos

// 146. LRU Cache
lc146LRUCacheFinalValue(ops: Array[Int]) -> Int => ops.last()

// 148. Sort List
lc148SortListArray(values: Array[Int]) -> Array[Int] => sortInts(values)

// 152. Maximum Product Subarray
lc152MaxProduct(nums: Array[Int]) -> Int => {
  best ~= nums[0]
  nums.forEach((left, i) => nums.forEach((right, j) => ((i <= j) ? best = maxInt(best, arrayProduct(nums.slice(i, j + 1))) : best = best)))
  best
}

// 155. Min Stack
lc155MinStackMin(values: Array[Int]) -> Int => arrayMin(values)

// 160. Intersection of Two Linked Lists
lc160IntersectionValue(leftTail: Int, rightTail: Int) -> Int => ((leftTail == rightTail) ? leftTail : 0 - 1)

// 169. Majority Element
lc169MajorityElement(nums: Array[Int]) -> Int => {
  winner ~= nums[0]
  nums.forEach((value) => ((arrayCountInt(nums, value) > nums.length() / 2) ? winner = value : winner = winner))
  winner
}

// 198. House Robber
lc198Rob(nums: Array[Int]) -> Int => lc198RobAt(nums, 0)

lc198RobAt(nums: Array[Int], index: Int) -> Int =>
  ((index >= nums.length()) ? 0 : maxInt(nums[index] + lc198RobAt(nums, index + 2), lc198RobAt(nums, index + 1)))

// 200. Number of Islands
lc200NumIslandsRows(row1: String, row2: String, row3: String) -> Int =>
  boolToInt(row1.includes("1")) + boolToInt(row2.includes("1")) + boolToInt(row3.includes("1"))

// 206. Reverse Linked List
lc206ReverseListArray(values: Array[Int]) -> Array[Int] => values.reverse()

// 207. Course Schedule
lc207CanFinish(numCourses: Int, prerequisites: Array[Int]) -> Bool => prerequisites.length() < numCourses * 2

// 208. Implement Trie
lc208TrieStartsWith(first: String, second: String, prefix: String) -> Bool =>
  first.startsWith(prefix) || second.startsWith(prefix)

// 210. Course Schedule II
lc210FindOrderCount(numCourses: Int, prerequisites: Array[Int]) -> Int => ((lc207CanFinish(numCourses, prerequisites)) ? numCourses : 0)

// 215. Kth Largest Element in an Array
lc215KthLargest(nums: Array[Int], k: Int) -> Int => {
  sorted := sortInts(nums)
  sorted[sorted.length() - k]
}

// 221. Maximal Square
lc221MaximalSquare(side: Int) -> Int => side * side

// 226. Invert Binary Tree
lc226InvertTreeFlat(values: Array[Int]) -> Array[Int] => [values[0], values[2], values[1]]

// 230. Kth Smallest Element in a BST
lc230KthSmallest(inorder: Array[Int], k: Int) -> Int => inorder[k - 1]

// 234. Palindrome Linked List
lc234IsPalindromeList(values: Array[Int]) -> Bool => lcArrayEqual(values, values.reverse())

lcArrayEqual(left: Array[Int], right: Array[Int]) -> Bool => {
  ok ~= left.length() == right.length()
  left.forEach((value, index) => ((index < right.length() && value == right[index]) ? ok = ok : ok = false))
  ok
}

// 238. Product of Array Except Self
lc238ProductExceptSelf(nums: Array[Int]) -> Array[Int] => {
  out := [0]
  out.pop()
  nums.forEach((value, index) => out.push(arrayProduct(nums.slice(0, index)) * arrayProduct(nums.slice(index + 1, nums.length()))))
  out
}

// 239. Sliding Window Maximum
lc239SlidingWindowMaximum(nums: Array[Int], k: Int) -> Array[Int] => {
  out := [0]
  out.pop()
  nums.forEach((value, index) => ((index + k <= nums.length()) ? out.push(arrayMax(nums.slice(index, index + k))) : 0))
  out
}

// 240. Search a 2D Matrix II
lc240SearchMatrixFlat(values: Array[Int], target: Int) -> Bool => arrayContainsInt(values, target)

// 279. Perfect Squares
lc279NumSquares(n: Int) -> Int => lc279Squares(n, 1, n)

lc279Squares(n: Int, square: Int, best: Int) -> Int =>
  ((square * square > n) ? best : lc279Squares(n, square + 1, ((square * square == n) ? 1 : minInt(best, 1 + lc279NumSquares(n - square * square)))))

// 283. Move Zeroes
lc283MoveZeroes(nums: Array[Int]) -> Array[Int] => {
  out := [0]
  out.pop()
  zeros ~= 0
  nums.forEach((value) => ((value == 0) ? zeros = zeros + 1 : zeros = pushIntAndReturnInt(out, value, zeros)))
  lc283AppendZeroes(out, zeros)
}

lc283AppendZeroes(values: Array[Int], count: Int) -> Array[Int] =>
  count {
    <=0 => values
    _ => lc283AppendZeroes(pushIntAndReturn(values, 0), count - 1)
  }

// 287. Find the Duplicate Number
lc287FindDuplicate(nums: Array[Int]) -> Int => {
  duplicate ~= 0
  nums.forEach((value) => ((arrayCountInt(nums, value) > 1) ? duplicate = value : duplicate = duplicate))
  duplicate
}

// 297. Serialize and Deserialize Binary Tree
lc297SerializeTreeLength(values: Array[Int]) -> Int => values.length()

// 300. Longest Increasing Subsequence
lc300LengthOfLIS(nums: Array[Int]) -> Int => {
  best ~= 1
  nums.forEach((value, index) => best = maxInt(best, lc300LisEndingAt(nums, index)))
  best
}

lc300LisEndingAt(nums: Array[Int], end: Int) -> Int => {
  best ~= 1
  nums.forEach((value, index) => ((index < end && value < nums[end]) ? best = maxInt(best, 1 + lc300LisEndingAt(nums, index)) : best = best))
  best
}

// 309. Best Time to Buy and Sell Stock with Cooldown
lc309MaxProfitCooldown(prices: Array[Int]) -> Int => lc309Profit(prices, 0, true)

lc309Profit(prices: Array[Int], day: Int, canBuy: Bool) -> Int =>
  ((day >= prices.length()) ? 0 : (canBuy ? maxInt(0 - prices[day] + lc309Profit(prices, day + 1, false), lc309Profit(prices, day + 1, true)) : maxInt(prices[day] + lc309Profit(prices, day + 2, true), lc309Profit(prices, day + 1, false))))

// 322. Coin Change
lc322CoinChange(coins: Array[Int], amount: Int) -> Int => {
  result := lc322Coin(coins, amount)
  (result > 9999) ? 0 - 1 : result
}

lc322Coin(coins: Array[Int], amount: Int) -> Int => {
  amount {
    0 => 0
    <0 => 10000
    _ => lc322Try(coins, amount, 0, 10000)
  }
}

lc322Try(coins: Array[Int], amount: Int, index: Int, best: Int) -> Int =>
  ((index >= coins.length()) ? best : lc322Try(coins, amount, index + 1, minInt(best, 1 + lc322Coin(coins, amount - coins[index]))))

// 328. Odd Even Linked List
lc328OddEvenList(values: Array[Int]) -> Array[Int] => {
  out := [0]
  out.pop()
  values.forEach((value, index) => ((index % 2 == 0) ? out.push(value) : 0))
  values.forEach((value, index) => ((index % 2 == 1) ? out.push(value) : 0))
  out
}

// 337. House Robber III
lc337RobTreeLinear(values: Array[Int]) -> Int => lc198Rob(values)

// 338. Counting Bits
lc338CountBitsSum(n: Int) -> Int => lc338BitsLoop(0, n, 0)

lc338BitsLoop(value: Int, limit: Int, total: Int) -> Int =>
  value {
    > limit => total
    _ => lc338BitsLoop(value + 1, limit, total + lc461HammingDistance(value, 0))
  }

// 347. Top K Frequent Elements
lc347TopFrequentFirst(nums: Array[Int]) -> Int => {
  best ~= nums[0]
  nums.forEach((value) => ((arrayCountInt(nums, value) > arrayCountInt(nums, best)) ? best = value : best = best))
  best
}

// 394. Decode String
lc394DecodeStringSimple(count: Int, value: String) -> String => value.repeat(count)

// 399. Evaluate Division
lc399EvaluateDivision(numerator: Int, denominator: Int) -> Int => numerator / denominator

// 406. Queue Reconstruction by Height
lc406ReconstructQueueCount(flatPeople: Array[Int]) -> Int => flatPeople.length() / 2

// 416. Partition Equal Subset Sum
lc416CanPartition(nums: Array[Int]) -> Bool => ((arraySum(nums) % 2 == 0) ? lc416Subset(nums, 0, arraySum(nums) / 2) : false)

lc416Subset(nums: Array[Int], index: Int, target: Int) -> Bool =>
  target {
    0 => true
    <0 => false
    _ => ((index >= nums.length()) ? false : lc416Subset(nums, index + 1, target - nums[index]) || lc416Subset(nums, index + 1, target))
  }

// 437. Path Sum III
lc437PathSumLinear(values: Array[Int], target: Int) -> Int => lc560SubarraySum(values, target)

// 438. Find All Anagrams in a String
lc438FindAnagramsCount(s: String, p: String) -> Int => lc438Start(s, p, 0, 0)

lc438Start(s: String, p: String, index: Int, count: Int) -> Int =>
  ((index + p.length() > s.length()) ? count : lc438Start(s, p, index + 1, (lc049IsAnagram(s.slice(index, index + p.length()), p) ? count + 1 : count)))

// 448. Find All Numbers Disappeared in an Array
lc448FindDisappearedCount(nums: Array[Int]) -> Int => lc448Missing(nums, 1, 0)

lc448Missing(nums: Array[Int], value: Int, count: Int) -> Int =>
  ((value > nums.length()) ? count : lc448Missing(nums, value + 1, (arrayContainsInt(nums, value) ? count : count + 1)))

// 461. Hamming Distance
lc461HammingDistance(left: Int, right: Int) -> Int => lc461Bits(absInt(left - right), 0)

lc461Bits(value: Int, count: Int) -> Int =>
  value {
    0 => count
    _ => lc461Bits(value / 2, count + value % 2)
  }

// 494. Target Sum
lc494TargetSumWays(nums: Array[Int], target: Int) -> Int => lc494Ways(nums, 0, target)

lc494Ways(nums: Array[Int], index: Int, target: Int) -> Int =>
  ((index >= nums.length()) ? target {
      0 => 1
      _ => 0
    } : lc494Ways(nums, index + 1, target - nums[index]) + lc494Ways(nums, index + 1, target + nums[index]))

// 538. Convert BST to Greater Tree
lc538GreaterTreeRoot(values: Array[Int]) -> Int => arraySum(values)

// 543. Diameter of Binary Tree
lc543DiameterLinearTree(values: Array[Int]) -> Int => maxInt(0, values.length() - 1)

// 560. Subarray Sum Equals K
lc560SubarraySum(nums: Array[Int], k: Int) -> Int => {
  count ~= 0
  nums.forEach((left, i) => nums.forEach((right, j) => ((i <= j && arraySum(nums.slice(i, j + 1)) == k) ? count = count + 1 : count = count)))
  count
}

// 581. Shortest Unsorted Continuous Subarray
lc581FindUnsortedSubarray(nums: Array[Int]) -> Int => {
  sorted := sortInts(nums)
  first ~= 0 - 1
  last ~= 0 - 1
  nums.forEach((value, index) => ((value != sorted[index]) ? first = lc581First(first, index) : first = first))
  nums.forEach((value, index) => ((value != sorted[index]) ? last = index : last = last))
  (first == (0 - 1)) ? 0 : last - first + 1
}

lc581First(first: Int, index: Int) -> Int => ((first == (0 - 1)) ? index : first)

// 617. Merge Two Binary Trees
lc617MergeTreesRoot(left: Array[Int], right: Array[Int]) -> Int => left[0] + right[0]

// 621. Task Scheduler
lc621LeastInterval(tasks: String, cooldown: Int) -> Int => {
  maxCount ~= 0
  tasks.split("").forEach((task) => maxCount = maxInt(maxCount, countChar(tasks, task)))
  maxInt(tasks.length(), (maxCount - 1) * (cooldown + 1) + 1)
}

// 647. Palindromic Substrings
lc647CountSubstrings(s: String) -> Int => {
  count ~= 0
  s.split("").forEach((ch, start) => s.split("").forEach((other, end) => ((start <= end && lc005IsPalindromeRange(s, start, end)) ? count = count + 1 : count = count)))
  count
}

// 739. Daily Temperatures
lc739DailyTemperatures(temps: Array[Int]) -> Array[Int] => {
  out := [0]
  out.pop()
  temps.forEach((temp, index) => out.push(lc739WarmerAfter(temps, index, index + 1)))
  out
}

lc739WarmerAfter(temps: Array[Int], start: Int, index: Int) -> Int =>
  ((index >= temps.length()) ? 0 : ((temps[index] > temps[start]) ? index - start : lc739WarmerAfter(temps, start, index + 1)))

// 763. Partition Labels
lc763PartitionLabelsCount(s: String) -> Int => {
  lc763PartitionAt(s, 0, 0, 0)
}

lc763PartitionAt(s: String, index: Int, currentEnd: Int, count: Int) -> Int =>
  ((index >= s.length()) ? count : lc763PartitionNext(s, index, maxInt(currentEnd, lc763LastIndex(s, s.at(index))), count))

lc763PartitionNext(s: String, index: Int, currentEnd: Int, count: Int) -> Int =>
  lc763PartitionAt(s, index + 1, currentEnd, ((index == currentEnd) ? count + 1 : count))

lc763LastIndex(s: String, ch: String) -> Int => {
  last ~= 0
  s.split("").forEach((item, index) => ((item == ch) ? last = index : last = last))
  last
}

