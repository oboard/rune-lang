? "128. Longest Consecutive Sequence" {
  solution := {
    maxInt(a: Int, b: Int) -> Int => a > b ? a : b

    lc128LongestConsecutive(nums: Array[Int]) -> Int => {
      set := @set.new(0)
      nums.forEach((value) => set.add(value))
      best ~= 0
      nums.forEach((value) => (set.has(value - 1) ? best = best : best = .maxInt(best, .lc128Run(set, value))))
      best
    }

    lc128Run(set: Set[Int], value: Int) -> Int => (set.has(value) ? 1 + .lc128Run(set, value + 1) : 0)
  }

  @assert.eq(solution.lc128LongestConsecutive([100, 4, 200, 1, 3, 2]), 4)
}

