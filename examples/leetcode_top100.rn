? "338. Counting Bits" {
  solution := {
    absInt(value: Int) -> Int => value < 0 ? 0 - value : value

    lc338CountBitsSum(n: Int) -> Int => .lc338BitsLoop(0, n, 0)

    lc338BitsLoop(value: Int, limit: Int, total: Int) -> Int =>
      value {
        > limit => total
        _ => .lc338BitsLoop(value + 1, limit, total + .lc461HammingDistance(value, 0))
      }

    lc461HammingDistance(left: Int, right: Int) -> Int => .lc461Bits(.absInt(left - right), 0)

    lc461Bits(value: Int, count: Int) -> Int =>
      value {
        0 => count
        _ => .lc461Bits(value / 2, count + value % 2)
      }
  }

  @assert.eq(solution.lc338CountBitsSum(5), 7)
}

