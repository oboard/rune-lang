Job: {
  status: Status
  name: String
}

Container: {
  Completed: Int
}

Status: {
  Completed = 0
  Fail = 1

  toString() -> String => . {
    Completed => "completed"
    Fail => "fail"
  }
}

statusText(status: Status) -> String => status {
  Status.Completed => "completed"
  Status.Fail => "fail"
  _ => "unknown"
}

statusMethodText(
  status: Status
) -> String => status.toString()

? "enum members and comparison" {
  @assert.eq(Status.Completed == Status.Completed, true)
  @assert.eq(Status.Completed == Status.Fail, false)
  @assert.eq(Status.Completed != Status.Fail, true)
}

? "enum typed parameter and match" {
  @assert.eq(statusText(Status.Completed), "completed")
  @assert.eq(statusText(Status.Fail), "fail")
}

? "enum methods" {
  @assert.eq(Status.Completed.toString(), "completed")
  @assert.eq(Status.Fail.toString(), "fail")
  @assert.eq(statusMethodText(Status.Completed), "completed")
}

? "enum in struct fields" {
  job := Job {
    status: Status.Completed,
    name: "build"
  }
  @assert.eq(job.status, Status.Completed)
  @assert.eq(job.name, "build")
}

? "enum type name can be shadowed by local binding" {
  Status := Container {
    Completed: 42
  }
  @assert.eq(Status.Completed, 42)
}
