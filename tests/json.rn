JsonUser: {
  name: String
  age: Int
}

#json.object
JsonAccount: {
  #json.name("display_name")
  name: String
  #json.ignore
  password: String
}

#json.object
JsonProfile: {
  label: String
  scores: Array[Int]
}

#json.object
JsonDocument: {
  #json.name("display_name")
  name: String
  profile: JsonProfile
  #json.ignore
  token: String
}

? "json stringify anonymous object" {
  user := JsonUser { name: "Ada", age: 36 }
  value := {
    name: "Rune"
    user: user
    tags: ["compiler", "json"]
    greet() => @io.println(.name)
  }

  @assert.eq(
    @json.stringify(value),
    "{\"name\":\"Rune\",\"user\":{\"name\":\"Ada\",\"age\":36},\"tags\":[\"compiler\",\"json\"]}"
  )

  @assert.eq(
    @json.stringify({
      name: "Direct"
      greet() => @io.println("skip")
    }),
    "{\"name\":\"Direct\"}"
  )
}

? "json macros configure struct fields" {
  account := JsonAccount { name: "Ada", password: "secret" }
  @assert.eq(
    @json.stringify(account),
    "{\"display_name\":\"Ada\"}"
  )
}

? "json parse uses FromJson generated by macro" {
  document := @json.parse(
    "{\"display_name\":\"Ada\",\"profile\":{\"label\":\"compiler\",\"scores\":[3,5,8]},\"token\":\"ignored\"}"
  ) : JsonDocument
  @assert.eq(document.name, "Ada")
  @assert.eq(document.profile.label, "compiler")
  @assert.eq(document.profile.scores[2], 8)
  @assert.eq(document.token, "")
}

? "json generated FromJson method delegates to parse" {
  document := JsonDocument::fromJson(
    "{\"display_name\":\"Rune\",\"profile\":{\"label\":\"language\",\"scores\":[1]}}"
  )
  @assert.eq(document.name, "Rune")
  @assert.eq(document.profile.scores[0], 1)
  @assert.eq(document.token, "")
}
