? "int literals" {
  @assert.eq(0, 0)
  @assert.eq(1, 1)
  @assert.eq(42, 42)
  @assert.eq(2147483647, 2147483647)
  @assert.eq(9007199254740991, 9007199254740991)
}

? "int arithmetic" {
  @assert.eq(1 + 2, 3)
  @assert.eq(10 - 4, 6)
  @assert.eq(6 * 7, 42)
  @assert.eq(20 / 5, 4)
  @assert.eq(22 / 7, 3)
  @assert.eq(22 % 7, 1)
  @assert.eq((2 + 3) * 4, 20)
  @assert.eq(2 + (3 * 4), 14)
  @assert.eq((100 - 25) / 5, 15)
}

? "int comparison" {
  @assert.eq(1 == 1, true)
  @assert.eq(1 == 2, false)
  @assert.eq(1 != 2, true)
  @assert.eq(1 < 2, true)
  @assert.eq(2 < 1, false)
  @assert.eq(2 <= 2, true)
  @assert.eq(3 > 2, true)
  @assert.eq(3 >= 4, false)
}

? "int negation" {
  @assert.eq(-1, 0 - 1)
  @assert.eq(-42, 0 - 42)
  @assert.eq(--7, 7)
  @assert.eq(5 + -2, 3)
  @assert.eq(-5 * -6, 30)
}

? "double literals" {
  @assert.eq(0.0, 0.0)
  @assert.eq(1.0, 1.0)
  @assert.eq(1.5, 1.5)
  @assert.eq(2.25, 2.25)
  @assert.eq(1e3, 1000.0)
  @assert.eq(6.25e-1, 0.625)
}

? "double arithmetic" {
  @assert.eq(1.5 + 2.25, 3.75)
  @assert.eq(10.5 - 4.25, 6.25)
  @assert.eq(3.5 * 2.0, 7.0)
  @assert.eq(7.5 / 2.5, 3.0)
  @assert.eq((1.25 + 2.75) * 2.0, 8.0)
  @assert.eq(9.0 / 4.0, 2.25)
}

? "double comparison" {
  @assert.eq(1.5 == 1.5, true)
  @assert.eq(1.5 == 2.5, false)
  @assert.eq(1.5 != 2.5, true)
  @assert.eq(1.5 < 2.5, true)
  @assert.eq(2.5 <= 2.5, true)
  @assert.eq(3.75 > 2.5, true)
  @assert.eq(3.75 >= 4.0, false)
}

? "double negation" {
  @assert.eq(-1.5, 0.0 - 1.5)
  @assert.eq(-42.25, 0.0 - 42.25)
  @assert.eq(--7.5, 7.5)
  @assert.eq(5.5 + -2.25, 3.25)
  @assert.eq(-2.5 * -4.0, 10.0)
}

? "bigint literals" {
  @assert.eq(0n, 0n)
  @assert.eq(1n, 1n)
  @assert.eq(42n, 42n)
  @assert.eq(9007199254740993n, 9007199254740993n)
  @assert.eq(123456789012345678901234567890n, 123456789012345678901234567890n)
}

? "bigint arithmetic" {
  @assert.eq(1n + 2n, 3n)
  @assert.eq(10n - 4n, 6n)
  @assert.eq(6n * 7n, 42n)
  @assert.eq(20n / 5n, 4n)
  @assert.eq(22n / 7n, 3n)
  @assert.eq(22n % 7n, 1n)
  @assert.eq(9007199254740993n + 7n, 9007199254741000n)
  @assert.eq((100000000000000000000n - 1n) + 1n, 100000000000000000000n)
}

? "bigint comparison" {
  @assert.eq(1n == 1n, true)
  @assert.eq(1n == 2n, false)
  @assert.eq(1n != 2n, true)
  @assert.eq(1n < 2n, true)
  @assert.eq(2n < 1n, false)
  @assert.eq(2n <= 2n, true)
  @assert.eq(3n > 2n, true)
  @assert.eq(3n >= 4n, false)
  @assert.eq(9007199254740993n > 9007199254740992n, true)
}

? "bigint negation" {
  @assert.eq(-1n, 0n - 1n)
  @assert.eq(-42n, 0n - 42n)
  @assert.eq(--7n, 7n)
  @assert.eq(5n + -2n, 3n)
  @assert.eq(-5n * -6n, 30n)
}

? "numeric module conversions" {
  @assert.eq(7.toDouble(), 7.0)
  @assert.eq(42.toString(), "42")
  @assert.eq(5.toBigInt(), 5n)
  @assert.eq(6n.toString(), "6")
  @assert.eq(7n.toDouble(), 7.0)
  @assert.eq(3.7.trunc(), 3)
  @assert.eq(3.7.floor(), 3)
  @assert.eq(3.2.ceil(), 4)
  @assert.eq(3.5.round(), 4)
  @assert.eq((0.0 - 3.7).trunc(), 0 - 3)
  @assert.eq((0.0 - 3.2).floor(), 0 - 4)
  @assert.eq((0.0 - 3.7).ceil(), 0 - 3)
}
