@"../selfhost/parser/parser.rn"

? "selfhost parser reads imports and routine functions" {
  source := "@\"./import_helper.rn\"\n~ readFile(path: String) -> Result[@io.Data, Error] => {\n  file := @fs.readFile(path)?\n  file\n}\n"
  file := parse(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.imports.length(), 1)
  @assert.eq(file.imports[0].path, "./import_helper.rn")
  @assert.eq(file.functions.length(), 1)
  @assert.eq(file.functions[0].routine, true)
  @assert.eq(file.functions[0].name, "readFile")
  @assert.eq(file.functions[0].params[0].name, "path")
  @assert.eq(file.functions[0].params[0].typeName, "String")
  @assert.eq(file.functions[0].returnType, "Result[@io.Data,Error]")
  @assert.eq(file.functions[0].body.kind, "block")
  @assert.eq(file.functions[0].body.children[0].kind, "let")
  @assert.eq(file.functions[0].body.children[0].children[0].kind, "unwrap")
}

? "selfhost parser reads structs and enums" {
  source := "Box[T]: {\n  - value: T\n  get() -> T => .value\n}\nStatus: {\n  Ready = 0\n  - Hidden = 1\n}\n"
  file := parse(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.types.length(), 2)
  @assert.eq(file.types[0].name, "Box")
  @assert.eq(file.types[0].generics[0], "T")
  @assert.eq(file.types[0].fields[0].name, "value")
  @assert.eq(file.types[0].fields[0].private, true)
  @assert.eq(file.types[0].methods[0].receiverType, "Box")
  @assert.eq(file.types[1].enum, true)
  @assert.eq(file.types[1].members[0].name, "Ready")
  @assert.eq(file.types[1].members[1].private, true)
}

? "selfhost parser reads map literals and index assignment" {
  source := "main() => {\n  map := {\n    \"a\": 1,\n    \"b\": 2\n  }\n  map[\"a\"] = map[\"b\"] + 3\n}\n"
  file := parse(source)
  block := file.functions[0].body
  mapLiteral := block.children[0].children[0]
  assignment := block.children[1]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(mapLiteral.kind, "map")
  @assert.eq(mapLiteral.children.length(), 2)
  @assert.eq(mapLiteral.children[0].children[0].value, "\"a\"")
  @assert.eq(assignment.kind, "assign")
  @assert.eq(assignment.children[0].kind, "index")
  @assert.eq(assignment.children[1].kind, "binary")
}

? "selfhost parser reads object destructuring" {
  source := "main() => {\n  { state: nextState, ch } := step\n}\n"
  file := parse(source)
  stmt := file.functions[0].body.children[0]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(stmt.kind, "objectDestructure")
  @assert.eq(stmt.params[0].typeName, "state")
  @assert.eq(stmt.params[0].name, "nextState")
  @assert.eq(stmt.params[1].typeName, "ch")
  @assert.eq(stmt.params[1].name, "ch")
}

? "selfhost parser reads char literals" {
  source := "main() => {\n  counts := {\n    'a': 1,\n    'b': 2\n  }\n  counts['a']\n}\n"
  file := parse(source)
  mapLiteral := file.functions[0].body.children[0].children[0]
  lookup := file.functions[0].body.children[1]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(mapLiteral.kind, "map")
  @assert.eq(mapLiteral.children[0].children[0].kind, "char")
  @assert.eq(mapLiteral.children[0].children[0].value, "'a'")
  @assert.eq(lookup.kind, "index")
  @assert.eq(lookup.children[1].kind, "char")
}

? "selfhost parser reads range pattern expression" {
  source := "isDigit(ch: Char) -> Bool => ('0'..='9')\n"
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, "binary")
  @assert.eq(body.op, "..=")
  @assert.eq(body.children[0].kind, "char")
  @assert.eq(body.children[1].kind, "char")
}

? "selfhost parser reads null coalesce expression" {
  source := "fallback(value: String?) -> String => value ?? \"missing\"\n"
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, "binary")
  @assert.eq(body.op, "??")
  @assert.eq(body.children[0].kind, "identifier")
  @assert.eq(body.children[1].kind, "string")
}

? "selfhost parser detects object pattern branches" {
  source := "score(point) => point {\n  { x, .. } => x\n  _ => 0\n}\n"
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, "match")
  @assert.eq(body.children[1].kind, "branch")
  @assert.eq(body.children[1].children[0].kind, "pattern")
  @assert.eq(body.children[1].children[0].text, "{x,..}")
}

? "selfhost parser reads lambdas and tests" {
  source := "? \"works\" {\n  values := [1, 2, 3]\n  values.each((value: Int) => @io.println(value))\n}\n"
  file := parse(source)
  block := file.tests[0].body
  call := block.children[1]
  lambda := call.children[1]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.tests.length(), 1)
  @assert.eq(file.tests[0].name, "works")
  @assert.eq(lambda.kind, "lambda")
  @assert.eq(lambda.params[0].name, "value")
  @assert.eq(lambda.params[0].typeName, "Int")
}
