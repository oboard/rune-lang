@"../selfhost/parser/parser.rn"

? "selfhost parser reads imports and routine functions" {
  source := `@"./import_helper.rn"
~ readFile(path: String) -> Result[@io.Data, Error] => {
  file := @fs.readFile(path)?
  file
}
`
  file := parse(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.imports.length(), 1)
  @assert.eq(file.imports[0].path, "./import_helper.rn")
  @assert.eq(file.functions.length(), 1)
  @assert.eq(file.functions[0].routine, true)
  @assert.eq(file.functions[0].name, "readFile")
  @assert.eq(file.functions[0].params[0].name, "path")
  @assert.eq(file.functions[0].params[0].typeRef.name, "String")
  @assert.eq(file.functions[0].returnType.name, "Result")
  @assert.eq(file.functions[0].returnType.args[0].module, "io")
  @assert.eq(file.functions[0].returnType.args[0].name, "Data")
  @assert.eq(file.functions[0].body.kind, ExprKind.Block)
  @assert.eq(file.functions[0].body.children[0].kind, ExprKind.Let)
  @assert.eq(file.functions[0].body.children[0].children[0].kind, ExprKind.Unwrap)
}

? "selfhost parser reads import expressions" {
  source := `main() => {
  helper := @"./import_helper.rn"
  @io.println(helper.greeting("Alice"))
}
`
  file := parse(source)
  helper := file.functions[0].body.children[0].children[0]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(helper.kind, ExprKind.At)
  @assert.eq(helper.value, "\"./import_helper.rn\"")
}

? "selfhost parser reads go imports" {
  source := `@go.import("fmt")

main() -> Int => 1
`
  file := parse(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.imports.length(), 1)
  @assert.eq(file.imports[0].path, "fmt")
  @assert.eq(file.imports[0].go, true)
}

? "selfhost parser preserves declaration annotations" {
  source := `#cli.command("ship", "Ship")
Args: {
  #cli.flag("v", "verbose")
  verbose: Bool
}

#macro.renameDeclaration("renamed")
run() => 1

Command: {
  #macro.renameDeclaration("RenamedRun")
  Run
}

#local(tree: SyntaxFile, context: MacroContext) -> SyntaxFile => tree
`
  file := parse(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.types[0].annotations.length(), 1)
  @assert.eq(file.types[0].annotations[0].marker, "#")
  @assert.eq(file.types[0].annotations[0].module, "cli")
  @assert.eq(file.types[0].annotations[0].name, "command")
  @assert.eq(file.types[0].annotations[0].args.length(), 2)
  @assert.eq(file.types[0].fields[0].annotations[0].name, "flag")
  @assert.eq(file.types[1].enum, true)
  @assert.eq(file.types[1].members[0].annotations[0].module, "macro")
  @assert.eq(file.types[1].members[0].annotations[0].name, "renameDeclaration")
  @assert.eq(file.functions[0].annotations[0].module, "macro")
  @assert.eq(file.functions[0].annotations[0].name, "renameDeclaration")
  @assert.eq(file.functions[1].macro, true)
  @assert.eq(file.functions[1].annotations.length(), 0)
}

? "selfhost parser reads static selectors" {
  file := parse(`main() => User::fromJson("{}")`)
  call := file.functions[0].body
  selector := call.children[0]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(call.kind, ExprKind.Call)
  @assert.eq(selector.kind, ExprKind.Selector)
  @assert.eq(selector.op, "::")
  @assert.eq(selector.name, "fromJson")
}

? "selfhost parser reads structs and enums" {
  source := `Box[T]: {
  value: T
  - hidden: T
  get() -> T => .value
  - secret() -> T => .hidden
}
Status[E]: {
  Ready
  Some(value: Int, name: String)
  + Hidden
}
`
  file := parse(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.types.length(), 2)
  @assert.eq(file.types[0].name, "Box")
  @assert.eq(file.types[0].generics[0], "T")
  @assert.eq(file.types[0].fields[0].name, "value")
  @assert.eq(file.types[0].fields[0].private, false)
  @assert.eq(file.types[0].fields[1].private, true)
  @assert.eq(file.types[0].methods[0].receiverType, "Box")
  @assert.eq(file.types[0].methods[0].private, false)
  @assert.eq(file.types[0].methods[1].private, true)
  @assert.eq(file.types[1].enum, true)
  @assert.eq(file.types[1].generics[0], "E")
  @assert.eq(file.types[1].members[0].name, "Ready")
  @assert.eq(file.types[1].members[0].private, false)
  @assert.eq(file.types[1].members[1].name, "Some")
  @assert.eq(file.types[1].members[1].params.length(), 2)
  @assert.eq(file.types[1].members[1].params[0].name, "value")
  @assert.eq(file.types[1].members[1].params[0].typeRef.name, "Int")
  @assert.eq(file.types[1].members[1].params[1].name, "name")
  @assert.eq(file.types[1].members[1].params[1].typeRef.name, "String")
  @assert.eq(file.types[1].members[2].private, false)
}

? "selfhost parser reads map literals and index assignment" {
  source := `main() => {
  map := {
    "a": 1,
    "b": 2
  }
  map["a"] = map["b"] + 3
}
`
  file := parse(source)
  block := file.functions[0].body
  mapLiteral := block.children[0].children[0]
  assignment := block.children[1]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(mapLiteral.kind, ExprKind.Map)
  @assert.eq(mapLiteral.children.length(), 2)
  @assert.eq(mapLiteral.children[0].children[0].value, "\"a\"")
  @assert.eq(assignment.kind, ExprKind.Assign)
  @assert.eq(assignment.children[0].kind, ExprKind.Index)
  @assert.eq(assignment.children[1].kind, ExprKind.Binary)
}

? "selfhost parser reads object expression bodies" {
  source := `make() => {
  ok: true,
  name: "Rune"
}
`
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Object)
  @assert.eq(body.children.length(), 2)
  @assert.eq(body.children[0].name, "ok")
}

? "selfhost parser reads object destructuring" {
  source := `main() => {
  { state: nextState, ch } := step
}
`
  file := parse(source)
  stmt := file.functions[0].body.children[0]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(stmt.kind, ExprKind.ObjectDestructure)
  @assert.eq(stmt.params[0].typeRef.name, "state")
  @assert.eq(stmt.params[0].name, "nextState")
  @assert.eq(stmt.params[1].typeRef.name, "ch")
  @assert.eq(stmt.params[1].name, "ch")
}

? "selfhost parser reads char literals" {
  source := `main() => {
  counts := {
    'a': 1,
    'b': 2
  }
  counts['a']
}
`
  file := parse(source)
  mapLiteral := file.functions[0].body.children[0].children[0]
  lookup := file.functions[0].body.children[1]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(mapLiteral.kind, ExprKind.Map)
  @assert.eq(mapLiteral.children[0].children[0].kind, ExprKind.Char)
  @assert.eq(mapLiteral.children[0].children[0].value, "'a'")
  @assert.eq(lookup.kind, ExprKind.Index)
  @assert.eq(lookup.children[1].kind, ExprKind.Char)
}

? "selfhost parser reads range pattern expression" {
  source := "isDigit(ch: Char) -> Bool => ('0'..='9')\n"
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Binary)
  @assert.eq(body.op, "..=")
  @assert.eq(body.children[0].kind, ExprKind.Char)
  @assert.eq(body.children[1].kind, ExprKind.Char)
}

? "selfhost parser reads null coalesce expression" {
  source := "fallback(value: String?) -> String => value ?? \"missing\"\n"
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Binary)
  @assert.eq(body.op, "??")
  @assert.eq(body.children[0].kind, ExprKind.Identifier)
  @assert.eq(body.children[1].kind, ExprKind.String)
}

? "selfhost parser reads compile-time expressions" {
  source := "main() => (1 + 2)'\n"
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.CompileTime)
  @assert.eq(body.children[0].kind, ExprKind.Binary)
}

? "selfhost parser reads conditional expression without else" {
  source := `main() => {
  handled :=: false
  isHelp ? handled = true
}
`
  file := parse(source)
  body := file.functions[0].body
  condition := body.children[1]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(condition.kind, ExprKind.Ternary)
  @assert.eq(condition.children.length(), 2)
  @assert.eq(condition.children[0].name, "isHelp")
  @assert.eq(condition.children[1].kind, ExprKind.Assign)
}

? "selfhost parser reads template literals" {
  source := "greeting(name: String) -> String => `hello, \\(name)`\n"
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Template)
  @assert.eq(body.value, "`hello, <<<RUNE_TEMPLATE_PART>>>`")
  @assert.eq(body.children.length(), 1)
  @assert.eq(body.children[0].kind, ExprKind.Identifier)
  @assert.eq(body.children[0].name, "name")
  multiline := parse(`message() -> String => \`hello
name\`
`)
  @assert.eq(multiline.errors.length(), 0)
  @assert.eq(multiline.functions[0].body.kind, ExprKind.Template)
  @assert.eq(multiline.functions[0].body.value, `\`hello
name\``)
}

? "selfhost parser detects object pattern branches" {
  source := `score(point) => point {
  { x, .. } => x
  _ => 0
}
`
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Match)
  @assert.eq(body.children[1].kind, ExprKind.Branch)
  @assert.eq(body.children[1].children[0].kind, ExprKind.Pattern)
  @assert.eq(body.children[1].children[0].text, "{x:x,..}")
}

? "selfhost parser reads or pattern branches" {
  source := `kind(typeName: String) -> String => typeName {
  "" | "Void" => "void"
  "Int" | "Double" => "number"
  _ => "other"
}
`
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Match)
  @assert.eq(body.children[1].children[0].text, "\"\"|\"Void\"")
  @assert.eq(body.children[2].children[0].text, "\"Int\"|\"Double\"")
}

? "selfhost parser reads moonbit-style pattern syntax" {
  source := `classify(values: Array[Int]) -> Int => values {
  [0, ..rest, last] @ whole => rest.length() + last + whole.length()
  _..<0 => -1
  10..<_ => 1
  [.. "yes", ..] => 2
  { "b"? : None, "a": x, .. } => x
  _ => 0
}
`
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Match)
  @assert.eq(body.children[1].children[0].text, "[0,..rest,last]@whole")
  @assert.eq(body.children[2].children[0].text, "_..<0")
  @assert.eq(body.children[3].children[0].text, "10..<_")
  @assert.eq(body.children[4].children[0].text, "[..\"yes\",..]")
  @assert.eq(body.children[5].children[0].text, "{\"b\"?:None,\"a\":x,..}")
}

? "selfhost parser rejects old as alias syntax" {
  source := `classify(values: Array[Int]) -> Int => values {
  [0] as whole => whole.length()
  _ => 0
}
`
  file := parse(source)
  @assert.eq(file.errors.length() > 0, true)
}

? "selfhost parser reads pattern branch block bodies" {
  source := `score(values: Array[Int]) -> Int => values {
  [x] => {
    y := x + 1
    y
  }
  _ => 0
}
`
  file := parse(source)
  body := file.functions[0].body
  @assert.eq(file.errors.length(), 0)
  @assert.eq(body.kind, ExprKind.Match)
  @assert.eq(body.children[1].children[1].kind, ExprKind.Block)
}

? "selfhost parser reads lambdas and tests" {
  source := `? "works" {
  values := [1, 2, 3]
  values.each((value: Int) => @io.println(value))
}
`
  file := parse(source)
  block := file.tests[0].body
  call := block.children[1]
  lambda := call.children[1]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.tests.length(), 1)
  @assert.eq(file.tests[0].name, "works")
  @assert.eq(lambda.kind, ExprKind.Lambda)
  @assert.eq(lambda.params[0].name, "value")
  @assert.eq(lambda.params[0].typeRef.name, "Int")
}
