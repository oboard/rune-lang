@"../selfhost/compiler/compiler.rn"

assertCompilesAllBackends(
  source: String
) => {
  go := compileGo(source)
  ts := compileTypeScript(source)
  mbt := compileMoonBit(source)
  @assert.eq(go.ok, true)
  @assert.eq(go.errors.length(), 0)
  @assert.eq(ts.ok, true)
  @assert.eq(ts.errors.length(), 0)
  @assert.eq(mbt.ok, true)
  @assert.eq(mbt.errors.length(), 0)
}

? "selfhost compiler compiles collection and string APIs" {
  source := `main() -> String => {
  values := [1, 2, 3]
  values.push(4)
  doubled := values.map((value, index) => value + index)
  total := doubled.reduce(0, (sum, value) => sum + value)
  words := [" rune ", "lang"]
  trimmed := words[0].trim()
  joined := trimmed.concat("-").concat(words[1].toUpperCase())
  scores := @map.new("", 0)
  scores.set("total", total)
  seen := @set.new("")
  seen.add(trimmed)
  joined + ":" + @int.toString(scores.getOr("total", 0)) + ":" + @int.toString(seen.size())
}
`
  assertCompilesAllBackends(source)
}

? "selfhost compiler resolves methods declared later" {
  source := `+ Buffer: {
  appendBytes(values: Array[Int]) -> Buffer => .appendInts(values)

  appendInts(values: Array[Int]) -> Buffer => this
}
`
  result := checkSource(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
}

? "selfhost compiler compiles binary APIs" {
  source := `main() -> String => {
  writer := @writer.new()
  writer.writeUInt8(@uint8.fromInt(7))
  writer.writeInt16(@int16.fromInt(0 - 1234), true)
  writer.writeFloat(@float.fromDouble(1.5), true)
  bytes := writer.toBytes()
  reader := @reader.new(bytes)
  first := @uint8.toInt(reader.readUInt8())
  second := @int16.toInt(reader.readInt16(true))
  third := @float.toDouble(reader.readFloat32(true))
  buffer := @buffer.fromBytes(bytes.clone())
  buffer.append(@uint8.fromInt(9))
  @int.toString(first) + ":" + @int.toString(second) + ":" + @int.toString(@double.trunc(third)) + ":" + @int.toString(buffer.length())
}
`
  assertCompilesAllBackends(source)
}

? "selfhost compiler compiles module APIs" {
  source := `main() -> String => {
  joined := @path.join(["src", "parser", "..", "lexer.rn"])
  relative := @path.relative("src/parser", "src/lexer/token.rn")
  text := @json.stringify({ name: "Rune", score: 42 })
  match := /(\\w+)-(\\d+)/.exec("id-42")
  parts := "a,b,c".split(",")
  total :=: 0
  @iter.range(1, 4).each((value) => total = total + value)
  symbol := @symbol.for("rune.key")
  @path.basename(joined) + ":" + relative + ":" + text.includes("Rune").toString() + ":" + match[1] + ":" + parts[2] + ":" + @int.toString(total) + ":" + (@symbol.keyFor(symbol) ?? "")
}
`
  assertCompilesAllBackends(source)
}

? "selfhost compiler compiles type and value APIs" {
  source := `Status: {
  Ready
  Waiting
}

User: {
  name: String
  status: Status
}

statusText(status: Status) -> String => status {
  Status.Ready => "ready"
  Status.Waiting => "waiting"
}

main() -> String => {
  user := User {
    name: "Rune",
    status: Status.Ready
  }
  scores := @map.new("", 0)
  fallback := scores["missing"] ?? 7
  first := user.name.at(0)
  label := fallback > 3 ? statusText(user.status) : "small"
  symbol := @symbol.for("type.value")
  first.toString() + ":" + label + ":" + @int.toString(fallback) + ":" + (@symbol.keyFor(symbol) ?? "")
}
`
  assertCompilesAllBackends(source)
}

? "selfhost compiler compiles result APIs" {
  source := `main() -> String => {
  @fs.mkdir("tmp")?
  @fs.writeFileText("tmp/a.txt", "hello api")?
  text := @fs.readFileText("tmp/a.txt")?
  gz := @compress.gzipText(text)?
  plain := @compress.gunzipText(gz)?
  listener := @net.listen("loop:api")?
  conn := listener.accept()?
  written := conn.write(@bytes.fromInts([1, 2, 3]))?
  read := conn.read(2)?
  plain + ":" + listener.address() + ":" + @int.toString(written) + ":" + @int.toString(read.length())
}
`
  assertCompilesAllBackends(source)
}
