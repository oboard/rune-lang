@"../selfhost/ir/ir.rn"

? "selfhost ir lowers declarations" {
  source := `@"./helper.rn"
Box[T]: {
  value: T
  get() -> T => .value
}
Status: {
  Ready = 1
}
main() -> Int => Box { value: 41 }.get() + Status.Ready
`
  file := lower(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.imports.length(), 1)
  @assert.eq(file.imports[0].path, "./helper.rn")
  @assert.eq(file.structs.length(), 1)
  @assert.eq(file.structs[0].name, "Box")
  @assert.eq(file.structs[0].generics[0], "T")
  @assert.eq(file.structs[0].methods[0].name, "get")
  @assert.eq(file.enums.length(), 1)
  @assert.eq(file.enums[0].members[0].name, "Ready")
  @assert.eq(file.functions.length(), 1)
  @assert.eq(file.functions[0].body.kind, ExprKind.Binary)
}

? "selfhost ir preserves static methods" {
  file := lower(`User: {
  name: String

  static make(name: String) -> User => User { name: name }
}
`)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.structs.length(), 1)
  @assert.eq(file.structs[0].methods.length(), 1)
  @assert.eq(file.structs[0].methods[0].name, "make")
  @assert.eq(file.structs[0].methods[0].static, true)
}

? "selfhost ir lowers nested expressions" {
  file := lower(`main() => {
  values := [1, 2, 3]
  values[0] = values[1] + 4
  values.map((value) => value * 2)
}
`)
  block := file.functions[0].body
  assign := block.children[1]
  call := block.children[2]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(block.kind, ExprKind.Block)
  @assert.eq(block.children[0].kind, ExprKind.Let)
  @assert.eq(assign.kind, ExprKind.Assign)
  @assert.eq(assign.children[0].kind, ExprKind.Index)
  @assert.eq(assign.children[1].kind, ExprKind.Binary)
  @assert.eq(call.kind, ExprKind.Call)
  @assert.eq(call.children[1].kind, ExprKind.Lambda)
}
