@"../selfhost/ir/ir.rn"

? "selfhost ir lowers declarations" {
  source := `@"./helper.rn"
Box[T]: {
  value: T
  get() -> T => .value
}
Status: {
  Ready = 1
}
main() -> Int => Box { value: 41 }.get() + Status.Ready
`
  file := lower(source)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.imports.length(), 1)
  @assert.eq(file.imports[0].path, "./helper.rn")
  @assert.eq(file.imports[0].module, false)
  @assert.eq(file.structs.length(), 1)
  @assert.eq(file.structs[0].name, "Box")
  @assert.eq(file.structs[0].generics[0], "T")
  @assert.eq(file.structs[0].methods[0].name, "get")
  @assert.eq(file.enums.length(), 1)
  @assert.eq(file.enums[0].members[0].name, "Ready")
  @assert.eq(file.functions.length(), 1)
  @assert.eq(file.functions[0].body.kind, ExprKind.Binary)
}

? "selfhost ir lowers constants" {
  file := lower(`+ const answer: Int = 42
const label: String = "Rune"
`)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.constants.length(), 2)
  @assert.eq(file.constants[0].name, "answer")
  @assert.eq(file.constants[0].private, false)
  @assert.eq(file.constants[0].typeName, "Int")
  @assert.eq(file.constants[0].value.kind, ExprKind.Int)
  @assert.eq(file.constants[1].name, "label")
  @assert.eq(file.constants[1].private, true)
  @assert.eq(file.constants[1].typeName, "String")
  @assert.eq(file.constants[1].value.kind, ExprKind.String)
}

? "selfhost ir preserves core module imports" {
  file := lower(`@syntax

main() => null
`)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.imports.length(), 1)
  @assert.eq(file.imports[0].path, "syntax")
  @assert.eq(file.imports[0].module, true)
}

? "selfhost ir preserves Go package imports" {
  file := lower(`@"go:fmt"

main() => null
`)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.imports.length(), 1)
  @assert.eq(file.imports[0].path, "fmt")
  @assert.eq(file.imports[0].go, true)
}

? "selfhost ir preserves function source paths" {
  file := lowerWithSourcePath(`helper() -> Int => 1
`, "helper.rn")
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.functions.length(), 1)
  @assert.eq(file.functions[0].sourcePath, "helper.rn")
}

? "selfhost ir preserves type source paths" {
  file := lowerWithSourcePath(`User: {
  name: String
}
Status: {
  Ready
}
`, "types.rn")
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.structs.length(), 1)
  @assert.eq(file.enums.length(), 1)
  @assert.eq(file.structs[0].sourcePath, "types.rn")
  @assert.eq(file.enums[0].sourcePath, "types.rn")
}

? "selfhost ir preserves static methods" {
  file := lower(`User: {
  name: String

  static make(name: String) -> User => User { name: name }
}
`)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.structs.length(), 1)
  @assert.eq(file.structs[0].methods.length(), 1)
  @assert.eq(file.structs[0].methods[0].name, "make")
  @assert.eq(file.structs[0].methods[0].static, true)
}

? "selfhost ir preserves json field metadata" {
  file := lower(`Account: {
  #json.name("display_name")
  name: String
  #json.ignore
  password: String
}
`)
  @assert.eq(file.errors.length(), 0)
  @assert.eq(file.structs[0].fields[0].name, "name")
  @assert.eq(file.structs[0].fields[0].jsonName, "display_name")
  @assert.eq(file.structs[0].fields[0].jsonIgnore, false)
  @assert.eq(file.structs[0].fields[1].name, "password")
  @assert.eq(file.structs[0].fields[1].jsonName, "password")
  @assert.eq(file.structs[0].fields[1].jsonIgnore, true)
}

? "selfhost ir preserves typed let bindings" {
  file := lower(`main() => {
  user := @json.parse(text) : User
}
`)
  stmt := file.functions[0].body.children[0]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(stmt.kind, ExprKind.Let)
  @assert.eq(stmt.value, "User")
}

? "selfhost ir lowers nested expressions" {
  file := lower(`main() => {
  values := [1, 2, 3]
  values[0] = values[1] + 4
  values.map((value) => value * 2)
}
`)
  block := file.functions[0].body
  assign := block.children[1]
  call := block.children[2]
  @assert.eq(file.errors.length(), 0)
  @assert.eq(block.kind, ExprKind.Block)
  @assert.eq(block.children[0].kind, ExprKind.Let)
  @assert.eq(assign.kind, ExprKind.Assign)
  @assert.eq(assign.children[0].kind, ExprKind.Index)
  @assert.eq(assign.children[1].kind, ExprKind.Binary)
  @assert.eq(call.kind, ExprKind.Call)
  @assert.eq(call.children[1].kind, ExprKind.Lambda)
}
