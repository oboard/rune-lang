@"../selfhost/format/format.rn"

? "selfhost formatter normalizes simple declarations" {
  formatted := formatSource("main()=>1")
  @assert.eq(formatted, "main() => 1\n")
}

? "selfhost formatter indents blocks" {
  formatted := formatSource("main()=>{value:=1\n@io.println(value)}")
  @assert.eq(formatted, `main() => {
  value := 1
  @io.println(value)
}
`)
}

? "selfhost formatter expands arrays onto separate lines" {
  formatted := formatSource(`render() => {
  $list := [TodoItem {
    name: "Item 1",
    status: TodoStatus.PENDING
  }, TodoItem {
    name: "Item 2",
    status: TodoStatus.PENDING
  }, TodoItem {
    name: "Item 3",
    status: TodoStatus.PENDING
  }]
}`)
  @assert.eq(formatted, `render() => {
  $list := [
    TodoItem {
      name: "Item 1",
      status: TodoStatus.PENDING
    },
    TodoItem {
      name: "Item 2",
      status: TodoStatus.PENDING
    },
    TodoItem {
      name: "Item 3",
      status: TodoStatus.PENDING
    }
  ]
}
`)
}

? "selfhost formatter ports legacy imports enums maps patterns and ternaries" {
  formatted := formatSource(`@"helper.rn"
Status:{Completed=0 Fail=1}
main()=>{values:={"a":1,"b":2}value:=flag?1:other?2:3}
classify(values:Array[Int])->Int=>values{[0,..rest]@whole=>rest.length()+whole.length() _=>0}`)
  @assert.eq(formatted, `@"helper.rn"

Status: {
  Completed = 0
  Fail = 1
}

main() => {
  values := {
    "a": 1,
    "b": 2
  }
  value := (flag ? 1 : (other ? 2 : 3))
}

classify(values: Array[Int]) -> Int => values {
  [0,..rest]@whole => rest.length() + whole.length()
  _ => 0
}
`)
}

? "selfhost formatter keeps direct XML string attributes" {
  formatted := formatSource(`render() => <input type={"checkbox"} placeholder={"Add todo"} checked={item.done} />`)
  @assert.eq(formatted, `render() => <input type="checkbox" placeholder="Add todo" checked={item.done} />
`)
}

? "selfhost formatter expands long self-closing XML attributes" {
  formatted := formatSource(`render() => {
  <input type={"text"} placeholder={"Add new item"} @keyup={(e) => $inputValue = e.target?.value ?? ""} @keydown={(e) => e.key} />
}`)
  @assert.eq(formatted, `render() => {
  <input
    type="text"
    placeholder="Add new item"
    @keyup={(e) => $inputValue = e.target?.value ?? ""}
    @keydown={(e) => e.key}
  />
}
`)
}

? "selfhost formatter formats statement assignments" {
  formatted := formatSource(`render() => {
  selected=false
}`)
  @assert.eq(formatted, `render() => {
  selected = false
}
`)
}

? "selfhost formatter indents structured XML" {
  formatted := formatSource(`render()=>{<div><h1>Hello World</h1><div style={{color:$color,backgroundColor:backgroundColor}}>Hello World</div><button @click={()=>$color="green"}>{"Change Color"}</button></div>}`)
  @assert.eq(formatted, `render() => {
  <div>
    <h1>Hello World</h1>
    <div style={{
      color: $color,
      backgroundColor: backgroundColor
    }}>Hello World</div>
    <button @click={() => $color = "green"}>
      {"Change Color"}
    </button>
  </div>
}
`)
}

? "selfhost formatter preserves end-of-line comments" {
  formatted := formatSource("main()=>{\nvalue:=1 // value\n@io.println(value) // print\n}")
  @assert.eq(formatted, `main() => {
  value := 1 // value
  @io.println(value) // print
}
`)
}

? "selfhost formatter keeps host block-comment behavior" {
  formatted := formatSource("main()=>{\nvalue:=1 /* value */\n@io.println(value)}")
  @assert.eq(formatted, `main() => {
  value := 1
  @io.println(value)
}
`)
}
// value
// print
