@"../selfhost/format/format.rn"

? "selfhost formatter normalizes simple declarations" {
  formatted := formatSource("main()=>1")
  @assert.eq(formatted, "main() => 1\n")
}

? "selfhost formatter indents blocks" {
  formatted := formatSource("main()=>{value:=1\n@io.println(value)}")
  @assert.eq(formatted, `main() => {
  value := 1
  @io.println(value)
}
`)
}

? "selfhost formatter preserves end-of-line comments" {
  formatted := formatSource("main()=>{\nvalue:=1 // value\n@io.println(value) // print\n}")
  @assert.eq(formatted, `main() => {
  value := 1 // value
  @io.println(value) // print
}
`)
}

? "selfhost formatter keeps host block-comment behavior" {
  formatted := formatSource("main()=>{\nvalue:=1 /* value */\n@io.println(value)}")
  @assert.eq(formatted, `main() => {
  value := 1
  @io.println(value)
}
`)
}
