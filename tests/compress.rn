~ gzipRoundtrip(
  value: String
) -> Result[String, Error] => {
  data := @compress.gzipText(value)?
  @compress.gunzipText(data)?
}

~ brotliRoundtrip(
  value: String
) -> Result[String, Error] => {
  data := @compress.brotliText(value)?
  @compress.unbrotliText(data)?
}

~ zstdRoundtrip(
  value: String
) -> Result[String, Error] => {
  data := @compress.zstdText(value)?
  @compress.unzstdText(data)?
}

? "compress codec routine signatures" {
  @assert.eq(1, 1)
}
