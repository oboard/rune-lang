@"../selfhost/compiler/compiler.rn"

? "selfhost compiler emits typescript functions" {
  source := `+ add(a: Int, b: Int) -> Int => a + b
+ main() -> Int => add(20, 22)
`
  result := compileTypeScript(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("function __add(__a: number, __b: number): number"), true)
  @assert.eq(result.output.includes("return __a + __b;"), true)
  @assert.eq(result.output.includes("export { __add as add, __main as main };"), true)
}

? "selfhost compiler emits go functions" {
  source := `+ add(a: Int, b: Int) -> Int => a + b
+ main() -> Int => add(20, 22)
`
  result := compileGo(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("package main"), true)
  @assert.eq(result.output.includes("func __add(__a int, __b int) int"), true)
  @assert.eq(result.output.includes("return __add(20, 22)"), true)
  @assert.eq(result.output.includes("func main()"), true)
}

? "selfhost compiler emits go pattern blocks" {
  source := `fib(n) => {
  0 => 0
  1 => 1
  _ => fib(n - 1) + fib(n - 2)
}

main() => {
  @io.println(fib(10))
}
`
  result := compileGo(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("func __fib(__n int) int"), true)
  @assert.eq(result.output.includes("} else if __n == 1 {"), true)
  @assert.eq(result.output.includes("return __fib(__n - 1) + __fib(__n - 2)"), true)
}

? "selfhost compiler merges source file imports" {
  files := [
    SourceFile {
      path: "main.rn",
      source: `@"helper.rn"

main() -> Int => importedAnswer()
`
    },
    SourceFile {
      path: "helper.rn",
      source: `ImportedUser: {
  name: String
}

importedAnswer() -> Int => 42
`
    }
  ]
  go := compileGoFiles(files)
  ts := compileTypeScriptFiles(files)
  mbt := compileMoonBitFiles(files)
  @assert.eq(go.ok, true)
  @assert.eq(ts.ok, true)
  @assert.eq(mbt.ok, true)
  @assert.eq(go.output.includes("type __ImportedUser struct"), true)
  @assert.eq(go.output.includes("func __importedAnswer() int"), true)
  @assert.eq(ts.output.includes("type __ImportedUser = {"), true)
  @assert.eq(mbt.output.includes("struct RuneImportedUser"), true)
}

? "selfhost compiler keeps unimported files private" {
  files := [
    SourceFile {
      path: "main.rn",
      source: `main() -> Int => hiddenAnswer()
`
    },
    SourceFile {
      path: "hidden.rn",
      source: `hiddenAnswer() -> Int => 42
`
    }
  ]
  go := compileGoFiles(files)
  @assert.eq(go.ok, false)
  @assert.eq(go.errors.length(), 1)
  @assert.eq(go.errors[0], "undefined function hiddenAnswer")
}

? "selfhost compiler reads TypeScript import exports" {
  files := [
    SourceFile {
      path: "main.rn",
      source: `@"./greet.ts"

main() => @io.println(greet("Rune"))
`
    },
    SourceFile {
      path: "greet.ts",
      source: `export function greet(name: string): string { return name }
export const version: string = "1"
`
    }
  ]
  ts := compileTypeScriptFiles(files)
  go := compileGoFiles(files)
  @assert.eq(ts.ok, true)
  @assert.eq(go.ok, true)
  @assert.eq(ts.errors.length(), 0)
  @assert.eq(go.errors.length(), 0)
  @assert.eq(ts.output.includes(`import { greet as __greet, version as __version } from "./greet.ts";`), true)
  @assert.eq(ts.output.includes(`console.log(__greet("Rune"))`), true)
}

? "selfhost compiler omits macro functions from runtime" {
  source := `#tag(tree: SyntaxFile, context: MacroContext) -> SyntaxFile => CallExpr(IdentifierExpr("x"), [])

main() -> Int => 1
`
  go := compileGo(source)
  ts := compileTypeScript(source)
  mbt := compileMoonBit(source)
  @assert.eq(go.ok, true)
  @assert.eq(ts.ok, true)
  @assert.eq(mbt.ok, true)
  @assert.eq(go.errors.length(), 0)
  @assert.eq(ts.errors.length(), 0)
  @assert.eq(mbt.errors.length(), 0)
  @assert.eq(go.output.includes("__tag"), false)
  @assert.eq(ts.output.includes("__tag"), false)
  @assert.eq(mbt.output.includes("__tag"), false)
}

? "selfhost compiler omits syntax helpers from runtime" {
  source := `helper(name: String) -> SyntaxExpr => CallExpr(IdentifierExpr(name), [])

main() -> Int => 1
`
  result := compileGo(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("__helper"), false)
  @assert.eq(result.output.includes("CallExpr"), false)
}

? "selfhost compiler emits moonbit functions" {
  source := `+ add(a: Int, b: Int) -> Int => a + b
+ main() -> Int => add(20, 22)
`
  result := compileMoonBit(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("fn __add(__a : Int, __b : Int) -> Int"), true)
  @assert.eq(result.output.includes("__a + __b"), true)
  @assert.eq(result.output.includes("fn main {"), true)
  @assert.eq(result.output.includes("__add(20, 22)"), true)
}

? "selfhost compiler emits declarations and println" {
  source := `Status: {
  Ready = 1
}
User: {
  name: String
}
main() => {
  user := User { name: "Rune" }
  @io.println(user.name, Status.Ready)
}
`
  ts := compileTypeScript(source)
  go := compileGo(source)
  mbt := compileMoonBit(source)
  @assert.eq(ts.ok, true)
  @assert.eq(go.ok, true)
  @assert.eq(mbt.ok, true)
  @assert.eq(ts.output.includes("type __User = {"), true)
  @assert.eq(ts.output.includes("const __Status = {"), true)
  @assert.eq(ts.output.includes("console.log(__user.name, __Status.Ready);"), true)
  @assert.eq(go.output.includes("\"fmt\""), true)
  @assert.eq(go.output.includes("type __User struct"), true)
  @assert.eq(go.output.includes("fmt.Println(__user.__name, __Status_Ready)"), true)
  @assert.eq(mbt.output.includes("enum RuneStatus"), true)
  @assert.eq(mbt.output.includes("struct RuneUser"), true)
  @assert.eq(mbt.output.includes("RuneUser::{ __name: \"Rune\" }"), true)
  @assert.eq(mbt.output.includes("println((__user.__name).to_string() + \" \" + (RuneStatus::RuneReady).to_string())"), true)
}

? "selfhost compiler emits go payload enums" {
  source := `MaybeInt: {
  None
  Some(value: Int)
}
main() -> MaybeInt => Some(42)
`
  result := compileGo(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("type __MaybeInt struct"), true)
  @assert.eq(result.output.includes("__tag int"), true)
  @assert.eq(result.output.includes("__payload []any"), true)
  @assert.eq(result.output.includes("__MaybeInt_Some_tag = 1"), true)
  @assert.eq(result.output.includes("func __Some(__value int) __MaybeInt"), true)
  @assert.eq(result.output.includes("return __MaybeInt{__tag: __MaybeInt_Some_tag, __payload: []any{__value}}"), true)
}

? "selfhost compiler emits result unwrap helpers" {
  source := `Result[T, E]: {
  Ok(value: T)
  Err(error: E)
}

read() -> Result[Int, String] => Ok(41)

main() -> Int => {
  value := read()?
  value + 1
}
`
  go := compileGo(source)
  ts := compileTypeScript(source)
  mbt := compileMoonBit(source)
  @assert.eq(go.ok, true)
  @assert.eq(ts.ok, true)
  @assert.eq(mbt.ok, true)
  @assert.eq(go.output.includes("import ("), true)
  @assert.eq(go.output.includes("\"reflect\""), true)
  @assert.eq(go.output.includes("type __Result[__T any, __E any] struct"), true)
  @assert.eq(go.output.includes("func __Ok[__T any, __E any](__value __T) __Result[__T, __E]"), true)
  @assert.eq(go.output.includes("func __runeUnwrap(value any) any"), true)
  @assert.eq(go.output.includes("__value := __runeUnwrap(__read()).(int)"), true)
  @assert.eq(ts.output.includes("function __runeUnwrap(value: any): any"), true)
  @assert.eq(ts.output.includes("type __Result<__T, __E> ="), true)
  @assert.eq(ts.output.includes("function __Ok<__T, __E>(__value: __T): __Result<__T, __E>"), true)
  @assert.eq(ts.output.includes("const __value = __runeUnwrap(__read());"), true)
  @assert.eq(mbt.output.includes("enum RuneResult[T, E]"), true)
  @assert.eq(mbt.output.includes("fn[T, E] rune_unwrap(value : RuneResult[T, E]) -> T"), true)
  @assert.eq(mbt.output.includes("let __value = rune_unwrap(__read())"), true)
}

? "selfhost compiler reports parser errors" {
  result := compileGo("main( => 1\n")
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length() > 0, true)
}

? "selfhost compiler reports undefined function calls" {
  result := compileGo("main() -> Int => missing()\n")
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "undefined function missing")
}

? "selfhost compiler reports function call arity errors" {
  result := compileGo(`add(a: Int, b: Int) -> Int => a + b
main() -> Int => add(1)
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"add\" expects 2 args, got 1")
}

? "selfhost compiler reports imported call arity errors" {
  files := [
    SourceFile {
      path: "main.rn",
      source: `@"helper.rn"

main() -> Int => importedAnswer()
`
    },
    SourceFile {
      path: "helper.rn",
      source: `importedAnswer(offset: Int) -> Int => offset + 42
`
    }
  ]
  result := compileGoFiles(files)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"importedAnswer\" expects 1 args, got 0")
}

? "selfhost compiler reports enum constructor arity errors" {
  result := compileGo(`MaybeInt: {
  None
  Some(value: Int)
}

main() -> MaybeInt => Some()
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"Some\" expects 1 args, got 0")
}
