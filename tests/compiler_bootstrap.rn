? "selfhost compiler checks anonymous object methods with this and parameters" {
  result := compileGo(`main() => {
  account := {
    name: "Rune",
    label(prefix: String) -> String => prefix + .name
  }
  account.label("hello ")
}
`)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
}

? "selfhost compiler rejects implicit this outside methods" {
  result := compileGo(`main() -> String => .name
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "implicit this selector can only be used inside a method")
}

? "selfhost compiler reports imported argument type errors" {
  files := [
    SourceFile {
      path: "main.rn",
      source: `@"helper.rn"

main() -> Int => importedAnswer(1)
`
    },
    SourceFile {
      path: "helper.rn",
      source: `+ importedAnswer(label: String) -> Int => 42
`
    }
  ]
  result := compileGoFiles(files)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "argument 1 to \"importedAnswer\" has type Int, expected String")
}

