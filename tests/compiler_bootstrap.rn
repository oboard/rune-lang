? "selfhost compiler expands rename declaration macro" {
  source := `#macro.renameDeclaration("RenamedArgs")
Args: {
  #macro.renameDeclaration("renamedField")
  value: Int

  #macro.renameDeclaration("renamedMethod")
  read() -> Int => 1
}

#macro.renameDeclaration("RenamedCommand")
Command: {
  #macro.renameDeclaration("RenamedRun")
  Run
}

#macro.renameDeclaration("renamedFunction")
execute() -> Int => 1
`
  result := compileGo(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("type __RenamedArgs struct"), true)
  @assert.eq(result.output.includes("__renamedField int"), true)
  @assert.eq(result.output.includes("func (__this __RenamedArgs) __renamedMethod() int"), true)
  @assert.eq(result.output.includes("type __RenamedCommand int"), true)
  @assert.eq(result.output.includes("__RenamedCommand_RenamedRun __RenamedCommand"), true)
  @assert.eq(result.output.includes("func __renamedFunction() int"), true)
}

? "selfhost compiler expands json object macro" {
  source := `#json.object
Document: {
  name: String
}
`
  go := compileGo(source)
  ts := compileTypeScript(source)
  mbt := compileMoonBit(source)
  @assert.eq(go.ok, true)
  @assert.eq(ts.ok, true)
  @assert.eq(mbt.ok, true)
  @assert.eq(go.errors.length(), 0)
  @assert.eq(ts.errors.length(), 0)
  @assert.eq(mbt.errors.length(), 0)
  @assert.eq(go.output.includes("func __Document_fromJson(__text string) __Document"), true)
  @assert.eq(go.output.includes("\"encoding/json\""), true)
  @assert.eq(go.output.includes("json.Unmarshal([]byte(__text), &__raw)"), true)
  @assert.eq(go.output.includes("__out.__name = __raw.F0"), true)
  @assert.eq(go.output.includes("json.parse(__text)"), false)
  @assert.eq(ts.output.includes("function __Document_fromJson(__text: string): __Document"), true)
  @assert.eq(ts.output.includes("JSON.parse(__text)"), true)
  @assert.eq(ts.output.includes("@json.parse(__text)"), false)
  @assert.eq(mbt.output.includes("fn __Document_fromJson(__text : String) -> RuneDocument"), true)
  @assert.eq(mbt.output.includes("@json.parse(__text)"), true)
}

? "selfhost compiler keeps existing json fromJson method" {
  source := `#json.object
Document: {
  name: String

  static fromJson(text: String) -> Document => Document { name: text }
}
`
  result := compileGo(source)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("func __Document_fromJson(__text string) __Document"), true)
  @assert.eq(result.output.includes("json.parse(__text)"), false)
}

? "selfhost compiler checks json parse expected type" {
  result := compileGo(`main() => @json.parse("{}")
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "@json.parse target type cannot be inferred; add ': Type' to the binding")
}

? "selfhost compiler requires json parse FromJson target" {
  result := compileGo(`Plain: {
  name: String
}

main(text: String) => {
  value := @json.parse(text) : Plain
  value
}
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "@json.parse target type Plain does not implement &FromJson")
}

? "selfhost compiler accepts json object parse target" {
