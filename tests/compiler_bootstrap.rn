? "selfhost compiler emits declarations and println" {
  source := `Status: {
  Ready = 1
}
User: {
  name: String
}
main() => {
  user := User { name: "Rune" }
  @io.println(user.name, Status.Ready)
}
`
  ts := compileTypeScript(source)
  go := compileGo(source)
  mbt := compileMoonBit(source)
  @assert.eq(ts.ok, true)
  @assert.eq(go.ok, true)
  @assert.eq(mbt.ok, true)
  @assert.eq(ts.output.includes("type __User = {"), true)
  @assert.eq(ts.output.includes("const __Status = {"), true)
  @assert.eq(ts.output.includes("console.log(__user.name, __Status.Ready);"), true)
  @assert.eq(go.output.includes("\"fmt\""), true)
  @assert.eq(go.output.includes("type __User struct"), true)
  @assert.eq(go.output.includes("fmt.Println(__user.__name, __Status_Ready)"), true)
  @assert.eq(mbt.output.includes("enum RuneStatus"), true)
  @assert.eq(mbt.output.includes("struct RuneUser"), true)
  @assert.eq(mbt.output.includes("RuneUser::{ __name: \"Rune\" }"), true)
  @assert.eq(mbt.output.includes("println((__user.__name).to_string() + \" \" + (RuneStatus::RuneReady).to_string())"), true)
}

? "selfhost compiler emits static methods" {
  source := `User: {
  name: String

  static make(name: String) -> User => User { name: name }
}

main() => @io.println(User::make("Rune").name)
`
  ts := compileTypeScript(source)
  go := compileGo(source)
  mbt := compileMoonBit(source)
  @assert.eq(ts.ok, true)
  @assert.eq(go.ok, true)
  @assert.eq(mbt.ok, true)
  @assert.eq(go.output.includes("func __User_make(__name string) __User"), true)
  @assert.eq(go.output.includes("func (__this __User) __make"), false)
  @assert.eq(go.output.includes("__User_make(\"Rune\")"), true)
  @assert.eq(ts.output.includes("function __User_make(__name: string): __User"), true)
  @assert.eq(ts.output.includes("function __User_make(__this"), false)
  @assert.eq(ts.output.includes("__User_make(\"Rune\")"), true)
  @assert.eq(mbt.output.includes("fn __User_make(__name : String) -> RuneUser"), true)
  @assert.eq(mbt.output.includes("fn __User_make(__this"), false)
  @assert.eq(mbt.output.includes("__User_make(\"Rune\")"), true)
}

