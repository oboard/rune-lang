    SourceFile {
      path: "main.rn",
      source: `main() -> Int => @"helper.rn".importedAnswer("bad")
`
    },
    SourceFile {
      path: "helper.rn",
      source: `+ importedAnswer(offset: Int) -> Int => offset + 42
`
