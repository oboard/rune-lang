`
    },
    SourceFile {
      path: "values.ts",
      source: `export const version: string = "1"
`
    }
  ]
  result := compileTypeScriptFiles(files)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes(`import { version as __version } from "./values.ts";`), true)
  @assert.eq(result.output.includes("console.log(__version)"), true)
}

