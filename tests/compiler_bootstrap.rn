? "selfhost compiler emits Go imports" {
  source := `@"go:fmt"

main() => @io.println("ok")
`
  go := compileGo(source)
  @assert.eq(go.ok, true)
  @assert.eq(go.errors.length(), 0)
  @assert.eq(go.output.includes("\t\"fmt\"\n"), true)
  @assert.eq(go.output.includes("\t\"fmt\"\n\t\"fmt\"\n"), false)
}

? "selfhost compiler emits Go package namespace calls" {
  source := `isNaN(value: Double) -> Bool => @"go:math".IsNaN(value)

main() => {
  fmt := @"go:fmt"
  fmt.Println("hello")
  @io.println(isNaN(0.0))
}
`
  go := compileGo(source)
  @assert.eq(go.ok, true)
  @assert.eq(go.errors.length(), 0)
  @assert.eq(go.output.includes("\t\"fmt\"\n"), true)
  @assert.eq(go.output.includes("\t\"math\"\n"), true)
  @assert.eq(go.output.includes("return math.IsNaN(__value)"), true)
  @assert.eq(go.output.includes("fmt.Println(\"hello\")"), true)
  @assert.eq(go.output.includes("__fmt :="), false)
}

? "selfhost compiler checks Go FFI arguments" {
  expr := compileGo(`main() -> Bool => @go.expr(1)
`)
  stmt := compileGo(`main() => @go.stmt(1)
`)
  arity := compileGo(`main() -> Bool => @go.expr()
`)
  @assert.eq(expr.ok, false)
  @assert.eq(expr.errors.length(), 1)
  @assert.eq(expr.errors[0], "@go.expr body must be a string literal")
  @assert.eq(stmt.ok, false)
  @assert.eq(stmt.errors.length(), 1)
  @assert.eq(stmt.errors[0], "@go.stmt argument must be a string literal")
  @assert.eq(arity.ok, false)
  @assert.eq(arity.errors.length(), 1)
  @assert.eq(arity.errors[0], "@go.expr expects 1 args, got 0")
}

? "selfhost compiler omits macro functions from runtime" {
