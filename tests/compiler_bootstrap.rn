  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "@json.parse target type Wrong does not implement &FromJson")
}

? "selfhost compiler emits typed json parse let" {
  result := compileGo(`#json.object
Document: {
  name: String
}

main(text: String) => {
  value := @json.parse(text) : Document
  @io.println(value.name)
}
`)
