  @assert.eq(result.errors.length(), 0)
  @assert.eq(result.output.includes("func() __Document {"), true)
  @assert.eq(result.output.includes("var __raw __rune_json_Document"), true)
}

? "selfhost compiler rejects wrong json fromJson override" {
