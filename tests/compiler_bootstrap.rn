? "selfhost compiler resolves TypeScript imports relative to source file" {
  files := [
    SourceFile {
      path: "app/main.rn",
      source: `@"./helper.ts"

main() => @io.println(greet("Rune"))
`
    },
    SourceFile {
      path: "other/helper.ts",
      source: `export function hidden(): string { return "wrong" }
`
    },
    SourceFile {
      path: "app/helper.ts",
      source: `export function greet(name: string): string { return name }
`
    }
  ]
  ts := compileTypeScriptFiles(files)
  @assert.eq(ts.ok, true)
  @assert.eq(ts.errors.length(), 0)
  @assert.eq(ts.output.includes(`import { greet as __greet } from "./helper.ts";`), true)
  @assert.eq(ts.output.includes("__hidden"), false)
  @assert.eq(ts.output.includes(`console.log(__greet("Rune"))`), true)
}

? "selfhost compiler resolves Rune namespace aliases" {
  files := [
    SourceFile {
      path: "main.rn",
      source: `main() => {
  io := @io
  helper := @"./helper.rn"
  io.println(helper.greeting("Alice"))
}
`
    },
    SourceFile {
      path: "helper.rn",
      source: `+ greeting(name: String) -> String => "hello, " + name
`
    }
  ]
  go := compileGoFiles(files)
  ts := compileTypeScriptFiles(files)
  @assert.eq(go.ok, true)
  @assert.eq(ts.ok, true)
  @assert.eq(go.errors.length(), 0)
  @assert.eq(ts.errors.length(), 0)
  @assert.eq(go.output.includes(`fmt.Println(__greeting("Alice"))`), true)
  @assert.eq(go.output.includes("__helper :="), false)
  @assert.eq(go.output.includes("__io :="), false)
  @assert.eq(ts.output.includes(`console.log(__greeting("Alice"))`), true)
  @assert.eq(ts.output.includes("__helper ="), false)
  @assert.eq(ts.output.includes("__io ="), false)
}

? "selfhost compiler resolves TypeScript namespace aliases" {
  files := [
    SourceFile {
      path: "main.rn",
      source: `main() => {
  io := @io
  helper := @"./greet.ts"
  io.println(helper.greet("Rune"))
  io.println(helper.version)
}
`
    },
    SourceFile {
      path: "greet.ts",
      source: `export function greet(name: string): string { return name }
export const version: string = "1"
`
    }
