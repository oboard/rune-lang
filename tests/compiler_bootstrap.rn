    SourceFile {
      path: "main.rn",
      source: `@"user.rn"

main() => {
  user := User { name: "Rune", token: "secret" }
  @io.println(user.token)
  @io.println(user.secret())
}
`
    },
    SourceFile {
      path: "user.rn",
      source: `+ User: {
  name: String
  - token: String

  - secret() -> String => .token
}
`
    }
