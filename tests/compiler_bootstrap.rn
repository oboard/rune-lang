  @assert.eq(ts.output.includes(`import { greet as __greet, version as __version } from "./greet.ts";`), true)
  @assert.eq(ts.output.includes(`console.log(__greet("Rune"))`), true)
  @assert.eq(ts.output.includes("console.log(__version)"), true)
  @assert.eq(ts.output.includes("__helper ="), false)
  @assert.eq(ts.output.includes("__io ="), false)
}

