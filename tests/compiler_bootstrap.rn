  @assert.eq(result.errors[0], "array index expects Int, got String")
}

? "selfhost compiler reports non-indexable type errors" {
  result := compileGo(`main(value: Int) -> Int => value[0]
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "type Int is not indexable")
}

? "selfhost compiler reports call return type errors" {
  result := compileGo(`label() -> String => "rune"
main() -> Int => label()
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"main\" returns String, expected Int")
}

? "selfhost compiler reports parameter return type errors" {
  result := compileGo(`identity(value: Int) -> String => value
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"identity\" returns Int, expected String")
}

? "selfhost compiler infers parameter binary return types" {
  result := compileGo(`add(a: Int, b: Int) -> String => a + b
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"add\" returns Int, expected String")
}

? "selfhost compiler reports call argument type errors" {
  result := compileGo(`takesString(name: String) -> Int => 1
main() -> Int => takesString(1)
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "argument 1 to \"takesString\" has type Int, expected String")
}

? "selfhost compiler accepts nullable null arguments" {
  result := compileGo(`fallback(value: String?) -> String => "ok"
main() -> String => fallback(null)
`)
  @assert.eq(result.ok, true)
  @assert.eq(result.errors.length(), 0)
}

? "selfhost compiler reports parameter argument type errors" {
  result := compileGo(`takesInt(value: Int) -> Int => value
main(flag: Bool) -> Int => takesInt(flag)
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "argument 1 to \"takesInt\" has type Bool, expected Int")
}

? "selfhost compiler reports local argument type errors" {
  result := compileGo(`takesString(value: String) -> Int => 1
main() -> Int => {
  value := 1
  takesString(value)
}
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "argument 1 to \"takesString\" has type Int, expected String")
}

? "selfhost compiler reports local return type errors" {
  result := compileGo(`main() -> String => {
  value := 1
  value
}
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"main\" returns Int, expected String")
}

? "selfhost compiler binds object destructure field types" {
  result := compileGo(`Advanced: {
  state: Int
  ch: Char
}

main(step: Advanced) -> String => {
  { state, ch } := step
  ch == 'a' ? state + 1 : state
}
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "function \"main\" returns Int, expected String")
}

? "selfhost compiler reports missing destructured fields" {
  result := compileGo(`Advanced: {
  state: Int
}

main(step: Advanced) -> Int => {
  { ch } := step
  0
}
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "type Advanced has no field \"ch\"")
}

? "selfhost compiler rejects destructuring fieldless types" {
  result := compileGo(`main() -> Int => {
  { value } := 1
  0
}
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "type Int has no fields")
}

? "selfhost compiler reports duplicate destructured fields" {
  result := compileGo(`Advanced: {
  state: Int
}

main(step: Advanced) -> Int => {
  { state, state: next } := step
  state + next
}
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "duplicate destructured field \"state\"")
}

? "selfhost compiler reports struct field type errors" {
  result := compileGo(`User: {
  name: String
}

main() -> User => User { name: 1 }
`)
  @assert.eq(result.ok, false)
  @assert.eq(result.errors.length(), 1)
  @assert.eq(result.errors[0], "field User.name has type Int, expected String")
}

