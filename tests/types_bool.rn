? "bool literals and equality" {
  @assert.eq(true, true)
  @assert.eq(false, false)
  @assert.eq(true == true, true)
  @assert.eq(false == false, true)
  @assert.eq(true == false, false)
  @assert.eq(true != false, true)
  @assert.eq(false != false, false)
}

? "bool unary not" {
  @assert.eq(!true, false)
  @assert.eq(!false, true)
  @assert.eq(!!true, true)
  @assert.eq(!!false, false)
  @assert.eq(!(true && false), true)
  @assert.eq(!(true || false), false)
}

? "bool conjunction truth table" {
  @assert.eq(true && true, true)
  @assert.eq(true && false, false)
  @assert.eq(false && true, false)
  @assert.eq(false && false, false)
  @assert.eq(true && !false, true)
  @assert.eq(!true && true, false)
}

? "bool disjunction truth table" {
  @assert.eq(true || true, true)
  @assert.eq(true || false, true)
  @assert.eq(false || true, true)
  @assert.eq(false || false, false)
  @assert.eq(false || !false, true)
  @assert.eq(!true || false, false)
}

? "bool and short circuits false left" {
  calls := [0]
  @assert.eq(false && (calls.push(1) == 2), false)
  @assert.eq(calls.length(), 1)
  @assert.eq((false && (calls.push(1) == 2)) && (calls.push(1) == 3), false)
  @assert.eq(calls.length(), 1)
}

? "bool and evaluates true left" {
  calls := [0]
  @assert.eq(true && (calls.push(1) == 2), true)
  @assert.eq(calls.length(), 2)
  @assert.eq(true && (calls.push(1) == 4), false)
  @assert.eq(calls.length(), 3)
}

? "bool or short circuits true left" {
  calls := [0]
  @assert.eq(true || (calls.push(1) == 2), true)
  @assert.eq(calls.length(), 1)
  @assert.eq((true || (calls.push(1) == 2)) || (calls.push(1) == 3), true)
  @assert.eq(calls.length(), 1)
}

? "bool or evaluates false left" {
  calls := [0]
  @assert.eq(false || (calls.push(1) == 2), true)
  @assert.eq(calls.length(), 2)
  @assert.eq(false || (calls.push(1) == 4), false)
  @assert.eq(calls.length(), 3)
}

? "bool receiver methods" {
  @assert.eq(true.not(), false)
  @assert.eq(false.not(), true)
  @assert.eq(true.xor(true), false)
  @assert.eq(true.xor(false), true)
  @assert.eq(false.xor(true), true)
  @assert.eq(false.xor(false), false)
  @assert.eq(true.toString(), "true")
  @assert.eq(false.toString(), "false")
}

? "bool comparison expressions" {
  a := true
  b := false
  c := true
  @assert.eq(a == c, true)
  @assert.eq(a == b, false)
  @assert.eq(a != b, true)
  @assert.eq(b != false, false)
  @assert.eq(a.not() == b, true)
  @assert.eq(a.xor(b) == c, true)
}

? "bool composed expressions" {
  a := true
  b := false
  c := true
  @assert.eq((a && !b) || false, true)
  @assert.eq(false || (a && b), false)
  @assert.eq((a || b) && c, true)
  @assert.eq((a && b).not() && (b || c), true)
  @assert.eq(a.xor(b) && c.not().not(), true)
  @assert.eq(((a && b) || (!b && c)).toString(), "true")
}
