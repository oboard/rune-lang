? "map core methods" {
  scores := @map.newMap("", 0)
  @assert.eq(scores.size(), 0)
  @assert.eq(scores.has("rune"), false)
  scores.set("rune", 10)
  scores.set("core", 20)
  @assert.eq(scores.size(), 2)
  @assert.eq(scores.has("rune"), true)
  @assert.eq(scores.getOr("rune", 0), 10)
  @assert.eq(scores.getOr("missing", 7), 7)

  total ~= 0
  scores.forEach((value, key) => total = total + value + key.length())
  @assert.eq(total, 38)

  keys := scores.keys()
  values := scores.values()
  @assert.eq(keys.length(), 2)
  @assert.eq(values.length(), 2)
  @assert.eq(scores.delete("rune"), true)
  @assert.eq(scores.delete("rune"), false)
  @assert.eq(scores.size(), 1)
  scores.clear()
  @assert.eq(scores.size(), 0)
}

? "set core methods" {
  seen := @map.newSet("")
  @assert.eq(seen.size(), 0)
  @assert.eq(seen.has("a"), false)
  seen.add("a")
  seen.add("b")
  seen.add("a")
  @assert.eq(seen.size(), 2)
  @assert.eq(seen.has("a"), true)

  chars := seen.values()
  @assert.eq(chars.length(), 2)

  total ~= 0
  seen.forEach((value) => total = total + value.length())
  @assert.eq(total, 2)

  @assert.eq(seen.delete("a"), true)
  @assert.eq(seen.delete("a"), false)
  @assert.eq(seen.size(), 1)
  seen.clear()
  @assert.eq(seen.size(), 0)
}
