? "map core methods" {
  scores := @map.new("", 0)
  @assert.eq(scores.size(), 0)
  @assert.eq(scores.has("rune"), false)
  scores.set("rune", 10)
  scores.set("core", 20)
  @assert.eq(scores.size(), 2)
  @assert.eq(scores.has("rune"), true)
  @assert.eq(scores.getOr("rune", 0), 10)
  @assert.eq(scores.getOr("missing", 7), 7)

  total ~= 0
  scores.each((value, key) => total = total + value + key.length())
  @assert.eq(total, 38)

  keys := scores.keys()
  values := scores.values()
  @assert.eq(keys.length(), 2)
  @assert.eq(values.length(), 2)
  @assert.eq(scores.delete("rune"), true)
  @assert.eq(scores.delete("rune"), false)
  @assert.eq(scores.size(), 1)
  scores.clear()
  @assert.eq(scores.size(), 0)
}

? "map literal string keys" {
  scores := {
    "rune": 10,
    "core": 20
  }
  @assert.eq(scores.size(), 2)
  @assert.eq(scores.has("rune"), true)
  @assert.eq(scores["rune"], 10)
  @assert.eq(scores["core"], 20)
  @assert.eq(scores.getOr("missing", 7), 7)

  scores["core"] = 25
  scores["new"] = 30
  @assert.eq(scores.size(), 3)
  @assert.eq(scores["core"], 25)
  @assert.eq(scores["new"], 30)

  total ~= 0
  scores.each((value) => total = total + value)
  @assert.eq(total, 65)
}

? "map literal integer keys" {
  doubled := {
    1: 2,
    2: 4,
    3: 6
  }
  @assert.eq(doubled.size(), 3)
  @assert.eq(doubled[1], 2)
  @assert.eq(doubled[2], 4)
  @assert.eq(doubled[3], 6)

  doubled[4] = 8
  @assert.eq(doubled.size(), 4)
  @assert.eq(doubled[4], 8)
  @assert.eq(doubled.has(4), true)
}

? "map literal bool and float keys" {
  flags := {
    true: "enabled",
    false: "disabled"
  }
  @assert.eq(flags[true], "enabled")
  @assert.eq(flags[false], "disabled")
  flags[false] = "off"
  @assert.eq(flags[false], "off")

  weights := {
    1.5: "light",
    2.5: "heavy"
  }
  @assert.eq(weights[1.5], "light")
  @assert.eq(weights[2.5], "heavy")
  weights[3.5] = "extra"
  @assert.eq(weights[3.5], "extra")
}

? "set core methods" {
  seen := @set.new("")
  @assert.eq(seen.size(), 0)
  @assert.eq(seen.has("a"), false)
  seen.add("a")
  seen.add("b")
  seen.add("a")
  @assert.eq(seen.size(), 2)
  @assert.eq(seen.has("a"), true)

  chars := seen.values()
  @assert.eq(chars.length(), 2)

  total ~= 0
  seen.each((value) => total = total + value.length())
  @assert.eq(total, 2)

  @assert.eq(seen.delete("a"), true)
  @assert.eq(seen.delete("a"), false)
  @assert.eq(seen.size(), 1)
  seen.clear()
  @assert.eq(seen.size(), 0)
}
