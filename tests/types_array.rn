? "array literals and index" {
  empty := []
  @assert.eq(empty.length(), 0)
  @assert.eq(empty.isEmpty(), true)

  ints := [1, 2, 3]
  @assert.eq(ints.length(), 3)
  @assert.eq(ints.isEmpty(), false)
  @assert.eq(ints[0], 1)
  @assert.eq(ints[1], 2)
  @assert.eq(ints[2], 3)

  words := ["rune", "array", "core"]
  @assert.eq(words.length(), 3)
  @assert.eq(words[0], "rune")
  @assert.eq(words[2], "core")
}

? "array spread literal" {
  middle := [2, 3]
  values := [1, ...middle, 4]
  @assert.eq(values.length(), 4)
  @assert.eq(values[0], 1)
  @assert.eq(values[1], 2)
  @assert.eq(values[2], 3)
  @assert.eq(values[3], 4)
}

? "array push and at" {
  values := [10]
  @assert.eq(values.push(20), 2)
  @assert.eq(values.push(30), 3)
  @assert.eq(values.length(), 3)
  @assert.eq(values[0], 10)
  @assert.eq(values.at(1), 20)
  @assert.eq(values.at(2), 30)
}

? "array mutation and slices" {
  values := [1, 2, 3, 4]
  @assert.eq(values.set(1, 20), 20)
  @assert.eq(values[1], 20)
  @assert.eq(values.first(), 1)
  @assert.eq(values.last(), 4)
  @assert.eq(values.contains(20), true)
  @assert.eq(values.contains(2), false)

  middle := values.slice(1, 3)
  @assert.eq(middle.length(), 2)
  @assert.eq(middle[0], 20)
  @assert.eq(middle[1], 3)

  reversed := values.reverse()
  @assert.eq(reversed[0], 4)
  @assert.eq(reversed[3], 1)

  cloned := values.clone()
  @assert.eq(cloned.length(), 4)
  @assert.eq(cloned.pop(), 4)
  @assert.eq(cloned.length(), 3)
  @assert.eq(values.length(), 4)
}

? "array each" {
  values := [1, 2, 3, 4]

  sum ~= 0
  values.each((value) => sum = sum + value)
  @assert.eq(sum, 10)

  indexed ~= 0
  values.each((value, index) => indexed = indexed + value * index)
  @assert.eq(indexed, 20)

  product ~= 1
  values.each((value) => product = product * value)
  @assert.eq(product, 24)
}

? "array map" {
  values := [1, 2, 3]
  doubled := values.map((value) => value * 2)
  @assert.eq(doubled.length(), 3)
  @assert.eq(doubled[0], 2)
  @assert.eq(doubled[1], 4)
  @assert.eq(doubled[2], 6)

  words := ["r", "ru", "run", "rune"]
  copied := words.map((word) => word)
  @assert.eq(copied.length(), 4)
  @assert.eq(copied[0], "r")
  @assert.eq(copied[1], "ru")
  @assert.eq(copied[2], "run")
  @assert.eq(copied[3], "rune")

  shifted := values.map((value, index) => value + index)
  @assert.eq(shifted[0], 1)
  @assert.eq(shifted[1], 3)
  @assert.eq(shifted[2], 5)
}

? "array reduce and folds" {
  values := [1, 2, 3, 4]
  sum := values.reduce(0, (accumulator, value) => accumulator + value)
  @assert.eq(sum, 10)

  weighted := values.reduce(0, (accumulator, value, index) => accumulator + (value * index))
  @assert.eq(weighted, 20)

  fromArrayArg := values.reduce(0, (accumulator, value, index, array) => accumulator + array[index])
  @assert.eq(fromArrayArg, 10)

  words := ["a", "b", "c"]
  left := words.foldl("", (accumulator, value) => accumulator + value)
  @assert.eq(left, "abc")

  right := words.foldr("", (accumulator, value) => accumulator + value)
  @assert.eq(right, "cba")
}

? "nested arrays" {
  matrix := [[1, 2], [3, 4]]
  @assert.eq(matrix.length(), 2)
  @assert.eq(matrix[0].length(), 2)
  @assert.eq(matrix[1].length(), 2)
  @assert.eq(matrix[0][0], 1)
  @assert.eq(matrix[0][1], 2)
  @assert.eq(matrix[1][0], 3)
  @assert.eq(matrix[1][1], 4)
  @assert.eq(matrix.at(0).at(1), 2)

  @assert.eq(matrix.push([5, 6]), 3)
  @assert.eq(matrix.length(), 3)
  @assert.eq(matrix[2][0], 5)
  @assert.eq(matrix[2][1], 6)

  rowSums := matrix.map((row) => row[0] + row[1])
  @assert.eq(rowSums.length(), 3)
  @assert.eq(rowSums[0], 3)
  @assert.eq(rowSums[1], 7)
  @assert.eq(rowSums[2], 11)
}

? "array nullable elements" {
  maybeInts := [1, null, 3]
  @assert.eq(maybeInts.length(), 3)
  @assert.eq(maybeInts[0], 1)
  @assert.eq(maybeInts[1], null)
  @assert.eq(maybeInts[2], 3)

  maybeWords := ["rune", null, "core"]
  @assert.eq(maybeWords.length(), 3)
  @assert.eq(maybeWords[0], "rune")
  @assert.eq(maybeWords[1], null)
  @assert.eq(maybeWords[2], "core")

  nested := [[1, null], [2, 3]]
  @assert.eq(nested.length(), 2)
  @assert.eq(nested[0][0], 1)
  @assert.eq(nested[0][1], null)
  @assert.eq(nested[1][0], 2)
  @assert.eq(nested[1][1], 3)
}
