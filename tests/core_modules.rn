? "iter module helpers" {
  values := @iter.range(2, 5)
  first := values.next()
  @assert.eq(first[1], true)
  @assert.eq(first[0], 2)
  second := values.next()
  @assert.eq(second[1], true)
  @assert.eq(second[0], 3)
  third := values.next()
  @assert.eq(third[1], true)
  @assert.eq(third[0], 4)
  done := values.next()
  @assert.eq(done[1], false)

  stepped := @iter.rangeStep(6, 0, 0 - 2)
  step1 := stepped.next()
  @assert.eq(step1[1], true)
  @assert.eq(step1[0], 6)
  step2 := stepped.next()
  @assert.eq(step2[1], true)
  @assert.eq(step2[0], 4)
  step3 := stepped.next()
  @assert.eq(step3[1], true)
  @assert.eq(step3[0], 2)
  @assert.eq(stepped.next()[1], false)

  repeated := @iter.repeat("x", 3)
  repeat1 := repeated.next()
  @assert.eq(repeat1[1], true)
  @assert.eq(repeat1[0], "x")
  repeat2 := repeated.next()
  @assert.eq(repeat2[1], true)
  @assert.eq(repeat2[0], "x")
  repeat3 := repeated.next()
  @assert.eq(repeat3[1], true)
  @assert.eq(repeat3[0], "x")
  @assert.eq(repeated.next()[1], false)

  fromArray := @iter.fromArray(["a", "b"])
  array1 := fromArray.next()
  @assert.eq(array1[1], true)
  @assert.eq(array1[0], "a")
  array2 := fromArray.next()
  @assert.eq(array2[1], true)
  @assert.eq(array2[0], "b")
  @assert.eq(fromArray.next()[1], false)

  source := @iter.fromArray([7])
  wrapped := @iter.new(source.next)
  wrapped1 := wrapped.next()
  @assert.eq(wrapped1[1], true)
  @assert.eq(wrapped1[0], 7)
  @assert.eq(wrapped.next()[1], false)

  empty := @iter.empty(0)
  @assert.eq(empty.next()[1], false)

  array := @iter.range(2, 5).toArray()
  @assert.eq(array.length(), 3)
  @assert.eq(array[0], 2)
  @assert.eq(array[1], 3)
  @assert.eq(array[2], 4)

  sum ~= 0
  @iter.range(1, 4).each((value) => sum = sum + value)
  @assert.eq(sum, 6)

  indexed ~= 0
  @iter.range(2, 5).each((value, index) => indexed = indexed + value * index)
  @assert.eq(indexed, 11)

  mapped := @iter.range(1, 4).map((value) => value * 10)
  @assert.eq(mapped.length(), 3)
  @assert.eq(mapped[0], 10)
  @assert.eq(mapped[1], 20)
  @assert.eq(mapped[2], 30)
}

? "stringbuffer module helpers" {
  buffer := @stringbuffer.new()
  @assert.eq(buffer.isEmpty(), true)
  buffer.append("Rune")
  buffer.append("Lang")
  @assert.eq(buffer.toString(), "RuneLang")
  @assert.eq(buffer.length(), 8)
  buffer.clear()
  @assert.eq(buffer.length(), 0)

  from := @stringbuffer.from("core")
  from.appendLine(" module")
  @assert.eq(from.toString(), "core module\n")
}

? "path module helpers" {
  @assert.eq(@path.basename("src/lexer.rn"), "lexer.rn")
  @assert.eq(@path.extname("src/lexer.rn"), ".rn")
  @assert.eq(@path.dirname("src/lexer.rn"), "src")
  @assert.eq(@path.isAbsolute("src/lexer.rn"), false)
}

? "process module helpers" {
  @assert.eq(@process.platform().isEmpty(), false)
  @assert.eq(@process.cwd().isEmpty(), false)
  @assert.eq(@process.env("__RUNE_TEST_MISSING_ENV__"), null)
}
