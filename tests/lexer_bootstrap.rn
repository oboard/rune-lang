@"../selfhost/lexer/lexer.rn"

? "selfhost lexer tokenizes declarations" {
  tokens := lex(`main() => 1
`)
  @assert.eq(tokens[0].kind, TokenKind.Ident)
  @assert.eq(tokens[0].lexeme, "main")
  @assert.eq(tokens[0].line, 1)
  @assert.eq(tokens[0].column, 1)
  @assert.eq(tokens[1].kind, TokenKind.LParen)
  @assert.eq(tokens[2].kind, TokenKind.RParen)
  @assert.eq(tokens[3].kind, TokenKind.FatArrow)
  @assert.eq(tokens[4].kind, TokenKind.Int)
  @assert.eq(tokens[5].kind, TokenKind.Newline)
  @assert.eq(tokens[6].kind, TokenKind.EOF)
}

? "selfhost lexer skips comments and reads strings" {
  tokens := lex(`// comment
name := "Rune\\nLang"`)
  @assert.eq(tokens[0].kind, TokenKind.Newline)
  @assert.eq(tokens[1].kind, TokenKind.Ident)
  @assert.eq(tokens[1].lexeme, "name")
  @assert.eq(tokens[2].kind, TokenKind.Declare)
  @assert.eq(tokens[3].kind, TokenKind.String)
  @assert.eq(tokens[3].lexeme, "\"Rune\\nLang\"")
}

? "selfhost lexer reads template strings" {
  tokens := lex("name := `hello, \\(user)`")
  @assert.eq(tokens[0].kind, TokenKind.Ident)
  @assert.eq(tokens[1].kind, TokenKind.Declare)
  @assert.eq(tokens[2].kind, TokenKind.TemplateString)
  @assert.eq(tokens[2].lexeme, "`hello, \\(user)`")
  multiline := lex(`name := \`hello
user\``)
  @assert.eq(multiline[2].kind, TokenKind.TemplateString)
  @assert.eq(multiline[2].lexeme, `\`hello
user\``)
}

? "selfhost lexer separates regex from slash" {
  regexTokens := lex("value := /a[bc]+/gi")
  @assert.eq(regexTokens[2].kind, TokenKind.Regex)
  @assert.eq(regexTokens[2].lexeme, "/a[bc]+/gi")
  slashTokens := lex("value / count")
  @assert.eq(slashTokens[0].kind, TokenKind.Ident)
  @assert.eq(slashTokens[1].kind, TokenKind.Slash)
  @assert.eq(slashTokens[2].kind, TokenKind.Ident)
}

? "selfhost lexer reads numeric variants" {
  tokens := lex("1 2.5 3e4 5n")
  @assert.eq(tokens[0].kind, TokenKind.Int)
  @assert.eq(tokens[1].kind, TokenKind.Double)
  @assert.eq(tokens[2].kind, TokenKind.Double)
  @assert.eq(tokens[3].kind, TokenKind.BigInt)
}

? "selfhost lexer reads char literals" {
  tokens := lex(`ch := 'x'
newline := '\\n'`)
  @assert.eq(tokens[0].kind, TokenKind.Ident)
  @assert.eq(tokens[1].kind, TokenKind.Declare)
  @assert.eq(tokens[2].kind, TokenKind.Char)
  @assert.eq(tokens[2].lexeme, "'x'")
  @assert.eq(tokens[6].kind, TokenKind.Char)
  @assert.eq(tokens[6].lexeme, "'\\n'")
}

? "selfhost lexer reads range pattern operator" {
  tokens := lex("'0'..='9' .. ... ??")
  @assert.eq(tokens[0].kind, TokenKind.Char)
  @assert.eq(tokens[1].kind, TokenKind.DotDotEqual)
  @assert.eq(tokens[2].kind, TokenKind.Char)
  @assert.eq(tokens[3].kind, TokenKind.DotDot)
  @assert.eq(tokens[4].kind, TokenKind.DotDotDot)
  @assert.eq(tokens[5].kind, TokenKind.QuestionQuestion)
}

? "selfhost lexer reads static selector" {
  tokens := lex("User::fromJson(text)")
  @assert.eq(tokens[0].kind, TokenKind.Ident)
  @assert.eq(tokens[1].kind, TokenKind.DoubleColon)
  @assert.eq(tokens[1].lexeme, "::")
  @assert.eq(tokens[2].kind, TokenKind.Ident)
}

? "selfhost lexer reads unicode identifiers" {
  tokens := lex(`变量💡 := 1
用户👩‍💻 := 2
姓名·字段 := 4`)
  @assert.eq(tokens[0].kind, TokenKind.Ident)
  @assert.eq(tokens[0].lexeme, "变量💡")
  @assert.eq(tokens[1].kind, TokenKind.Declare)
  @assert.eq(tokens[2].kind, TokenKind.Int)
  @assert.eq(tokens[4].kind, TokenKind.Ident)
  @assert.eq(tokens[4].lexeme, "用户👩\u200d💻")
  @assert.eq(tokens[5].kind, TokenKind.Declare)
  @assert.eq(tokens[6].kind, TokenKind.Int)
  @assert.eq(tokens[8].kind, TokenKind.Ident)
  @assert.eq(tokens[8].lexeme, "姓名·字段")
  @assert.eq(tokens[9].kind, TokenKind.Declare)
  @assert.eq(tokens[10].kind, TokenKind.Int)
}
