+ UInt16: {
  add(other: UInt16) -> UInt16 => "%uint16.add"

  sub(other: UInt16) -> UInt16 => "%uint16.sub"

  mul(other: UInt16) -> UInt16 => "%uint16.mul"

  div(other: UInt16) -> UInt16 => "%uint16.div"
}

+ fromInt(value: Int) -> UInt16 => "%uint16.fromInt"

+ toInt(value: UInt16) -> Int => "%uint16.toInt"
