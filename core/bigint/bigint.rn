+ BigInt: {
  add(other: BigInt) -> BigInt => "%bigint.add"

  sub(other: BigInt) -> BigInt => "%bigint.sub"

  mul(other: BigInt) -> BigInt => "%bigint.mul"

  div(other: BigInt) -> BigInt => "%bigint.div"
}

+ fromInt(value: Int) -> BigInt => "%bigint.fromInt"

+ toDouble(value: BigInt) -> Double => "%bigint.toDouble"

+ toString(value: BigInt) -> String => "%bigint.toString"
