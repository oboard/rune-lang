Array[T]: {
  length() -> Int => "%array.len"

  isEmpty() -> Bool => .length() == 0

  push(value: T) -> Int => "%array.push"

  set(index: Int, value: T) -> T => "%array.set"

  pop() -> T => "%array.pop"

  first() -> T => "%array.first"

  last() -> T => "%array.last"

  slice(start: Int, end: Int) -> Array[T] => "%array.slice"

  clone() -> Array[T] => "%array.clone"

  reverse() -> Array[T] => "%array.reverse"

  contains(value: T) -> Bool => "%array.contains"

  forEach[U](
    callbackfn: (
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> Any
  ) => "%array.forEach"

  each(
    callbackfn: (
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> Any
  ) => .forEach(callbackfn)

  map[U](
    callbackfn: (
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> U
  ) -> Array[U] => "%array.map"

  @alias("_[_]")
  at(index: Int) -> T => "%array.at"
}
