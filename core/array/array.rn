Array[T] {

    length[T]() -> Int => "%array.len"

    isEmpty[T]() -> Bool => .length() == 0

    push[T](value: T) => "%array.push"

    each[T](f: (T) -> Void) => "%array.each"

    map[T, U](f: (T) -> U) -> Array[U] => "%array.map"

    @alias("_[_]")
    at[T](index: Int) -> T => "%array.get"

}