Array[T]: {
  length() -> Int => "%array.len"

  isEmpty() -> Bool => .length() == 0

  push(value: T) -> Int => "%array.push"

  set(index: Int, value: T) -> T => "%array.set"

  pop() -> T => "%array.pop"

  first() -> T => "%array.first"

  last() -> T => "%array.last"

  slice(
    start: Int,
    end: Int
  ) -> Array[T] => "%array.slice"

  clone() -> Array[T] => "%array.clone"

  reverse() -> Array[T] => "%array.reverse"

  contains(value: T) -> Bool => "%array.contains"

  each[R](
    callbackfn: (
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> R
  ) -> Void => "%array.each"

  map[U](
    callbackfn: (
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> U
  ) -> Array[U] => "%array.map"

  reduce[U](
    initial: U,
    callbackfn: (
      accumulator: U,
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> U
  ) -> U => "%array.reduce"

  foldl[U](
    initial: U,
    callbackfn: (
      accumulator: U,
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> U
  ) -> U => "%array.foldl"

  foldr[U](
    initial: U,
    callbackfn: (
      accumulator: U,
      value: T,
      index?: Int,
      array?: Array[T]
    ) -> U
  ) -> U => "%array.foldr"

  @alias("_[_]")
  at(index: Int) -> T => "%array.at"
}
