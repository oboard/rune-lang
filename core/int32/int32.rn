+ Int32: {
  toString() -> String => "%int32.toString"

  toDouble() -> Double => "%int32.toDouble"

  toBigInt() -> BigInt => "%int32.toBigInt"

  add(other: Int32) -> Int32 => "%int32.add"

  sub(other: Int32) -> Int32 => "%int32.sub"

  mul(other: Int32) -> Int32 => "%int32.mul"

  div(other: Int32) -> Int32 => "%int32.div"
}
