+ TCPConnection: {
  ~ read(
    length: Int
  ) -> Result[Bytes, Error] => "%netConnection.read"

  ~ write(
    data: Bytes
  ) -> Result[Int, Error] => "%netConnection.write"

  ~ close() -> Result[Void, Error] => "%netConnection.close"
}

+ TCPListener: {
  address() -> String => "%netListener.address"

  ~ accept(
  ) -> Result[TCPConnection, Error] => "%netListener.accept"

  ~ close() -> Result[Void, Error] => "%netListener.close"
}

+ ~ connect(
  address: String
) -> Result[TCPConnection, Error] => "%net.connect"

+ ~ listen(
  address: String
) -> Result[TCPListener, Error] => "%net.listen"
