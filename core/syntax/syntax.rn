+ SyntaxFile: {
  types: Array[SyntaxStruct]
  enums: Array[SyntaxEnum]
  functions: Array[SyntaxFunction]
}

+ MacroContext: {
  targetID: String
  sourcePath: String
}

+ SyntaxAnnotation: {
  id: String
  module: String
  name: String
  hasParens: Bool
  args: Array[SyntaxValue]
}

+ SyntaxValue: {
  kind: String
  stringValue: String
  intValue: Int
  boolValue: Bool
}

+ SyntaxExprField: {
  name: String
  value: SyntaxExpr
}

+ SyntaxStatement: {
  kind: String
  name: String
  value: SyntaxExpr
}

+ SyntaxExpr: {
  + IdentifierExpr(name: String)
  + ModuleExpr(name: String)
  + StringExpr(value: String)
  + BoolExpr(value: Bool)
  + NullExpr
  + SelectorExpr(receiver: SyntaxExpr, name: String)
  + StaticSelectorExpr(receiver: SyntaxExpr, name: String)
  + CallExpr(callee: SyntaxExpr, args: Array[SyntaxExpr])
  + StructExpr(name: String, fields: Array[SyntaxExprField])
  + BlockExpr(statements: Array[SyntaxStatement])
}

+ SyntaxType: {
  kind: Int
  name: String
  module: String
  nullable: Bool
  args: Array[SyntaxType]
  params: Array[SyntaxTypeParam]
  returnType: SyntaxType?
  element: SyntaxType?
  raw: String
  displayText: String
}

+ SyntaxTypeParam: {
  name: String
  optional: Bool
  type: SyntaxType
}

+ SyntaxParam: {
  id: String
  name: String
  type: SyntaxType
}

+ SyntaxField: {
  id: String
  name: String
  private: Bool
  annotations: Array[SyntaxAnnotation]
  type: SyntaxType
}

+ SyntaxStruct: {
  id: String
  name: String
  private: Bool
  generics: Array[String]
  annotations: Array[SyntaxAnnotation]
  fields: Array[SyntaxField]
  methods: Array[SyntaxFunction]
  sourcePath: String
}

+ SyntaxEnumMember: {
  id: String
  name: String
  private: Bool
  annotations: Array[SyntaxAnnotation]
  value: Int
  hasValue: Bool
  params: Array[SyntaxParam]
}

+ SyntaxEnum: {
  id: String
  name: String
  private: Bool
  generics: Array[String]
  annotations: Array[SyntaxAnnotation]
  members: Array[SyntaxEnumMember]
  sourcePath: String
}

+ SyntaxFunction: {
  id: String
  name: String
  private: Bool
  static: Bool
  routine: Bool
  generics: Array[String]
  annotations: Array[SyntaxAnnotation]
  receiverType: String
  params: Array[SyntaxParam]
  returnType: SyntaxType
  bodyID: String
  generatedBody: SyntaxExpr?
  sourcePath: String
}
