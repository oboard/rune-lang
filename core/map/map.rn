+ Map[K, V]: {
  size() -> Int => "%map.size"

  has(key: K) -> Bool => "%map.has"

  getOr(key: K, fallback: V) -> V => "%map.getOr"

  set(key: K, value: V) -> Map[K, V] => "%map.set"

  delete(key: K) -> Bool => "%map.delete"

  clear() -> Void => "%map.clear"

  keys() -> Array[K] => "%map.keys"

  values() -> Array[V] => "%map.values"

  each[R](
    callbackfn: (
      value: V,
      key?: K,
      map?: Map[K, V]
    ) -> R
  ) -> Void => "%map.each"
}

+ WeakMap[K, V]: {
  has(key: K) -> Bool => "%weakMap.has"

  getOr(key: K, fallback: V) -> V => "%weakMap.getOr"

  set(key: K, value: V) -> WeakMap[K, V] => "%weakMap.set"

  delete(key: K) -> Bool => "%weakMap.delete"
}

+ new[K, V](
  keyType: K,
  valueType: V
) -> Map[K, V] => "%map.new"
