new[K, V](keyType: K, valueType: V) -> Map[K, V] => "%map.new"

Map[K, V]: {
    size() -> Int => "%map.size"

    has(key: K) -> Bool => "%map.has"

    getOr(key: K, fallback: V) -> V => "%map.getOr"

    set(key: K, value: V) -> Map[K, V] => "%map.set"

    delete(key: K) -> Bool => "%map.delete"

    clear() -> Void => "%map.clear"

    keys() -> Array[K] => "%map.keys"

    values() -> Array[V] => "%map.values"

    forEach(callbackfn: (value: V, key?: K, map?: Map[K, V]) -> Any) => "%map.forEach"
}

Set[T]: {
    size() -> Int => "%set.size"

    has(value: T) -> Bool => "%set.has"

    add(value: T) -> Set[T] => "%set.add"

    delete(value: T) -> Bool => "%set.delete"

    clear() -> Void => "%set.clear"

    values() -> Array[T] => "%set.values"

    forEach(callbackfn: (value: T, value2?: T, set?: Set[T]) -> Any) => "%set.forEach"
}

WeakMap[K, V]: {
    has(key: K) -> Bool => "%weakMap.has"

    getOr(key: K, fallback: V) -> V => "%weakMap.getOr"

    set(key: K, value: V) -> WeakMap[K, V] => "%weakMap.set"

    delete(key: K) -> Bool => "%weakMap.delete"
}
