+ Buffer: {
  values: Array[Int]

  length() -> Int => .values.length()

  byteLength() -> Int => .length()

  isEmpty() -> Bool => .values.isEmpty()

  clear() -> Void => .values = []

  clone() -> Buffer => {
    values: .values.clone()
  }

  toBytes() -> Bytes => @bytes.fromInts(.values.clone())

  toInts() -> Array[Int] => .values.clone()

  append(value: UInt8) -> Buffer => .appendInt(@uint8.toInt(value))

  appendInt(value: Int) -> Buffer => {
    .values.push(value)
    this
  }

  appendBytes(value: Bytes) -> Buffer => {
    value.toInts().each((byte) => .appendInt(byte))
    this
  }

  reader() -> Reader => @reader.new(.toBytes())

  writer() -> Writer => @writer.new().writeBytes(.toBytes())
}

+ new() -> Buffer => {
  values: []
}

+ fromBytes(value: Bytes) -> Buffer => {
  values: value.toInts()
}
