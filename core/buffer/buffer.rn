Buffer: {
  length() -> Int => "%buffer.length"

  byteLength() -> Int => "%buffer.length"

  isEmpty() -> Bool => .length() == 0

  clear() -> Void => "%buffer.clear"

  clone() -> Buffer => "%buffer.clone"

  toBytes() -> Bytes => "%buffer.toBytes"

  toInts() -> Array[Int] => "%buffer.toInts"

  append(value: UInt8) -> Buffer => "%buffer.append"

  appendInt(value: Int) -> Buffer => "%buffer.appendInt"

  appendBytes(value: Bytes) -> Buffer => "%buffer.appendBytes"

  reader() -> Reader => "%buffer.reader"

  writer() -> Writer => "%buffer.writer"
}

new() -> Buffer => "%buffer.new"

fromBytes(value: Bytes) -> Buffer => "%buffer.fromBytes"
