UInt64: {
  add(other: UInt64) -> UInt64 => "%uint64.add"

  sub(other: UInt64) -> UInt64 => "%uint64.sub"

  mul(other: UInt64) -> UInt64 => "%uint64.mul"

  div(other: UInt64) -> UInt64 => "%uint64.div"
}

fromInt(value: Int) -> UInt64 => "%uint64.fromInt"

toInt(value: UInt64) -> Int => "%uint64.toInt"
