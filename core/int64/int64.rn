+ Int64: {
  add(other: Int64) -> Int64 => "%int64.add"

  sub(other: Int64) -> Int64 => "%int64.sub"

  mul(other: Int64) -> Int64 => "%int64.mul"

  div(other: Int64) -> Int64 => "%int64.div"
}

+ fromInt(value: Int32) -> Int64 => "%int64.fromInt"

+ toInt(value: Int64) -> Int32 => "%int64.toInt"
