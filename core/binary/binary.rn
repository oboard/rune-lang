  getUInt64(offset: Int, littleEndian: Bool) -> UInt64 => "%binary.getUInt64"

  getUint64(offset: Int, littleEndian: Bool) -> UInt64 => "%binary.getUInt64"

  getBigUInt64(offset: Int, littleEndian: Bool) -> UInt64 => "%binary.getUInt64"

