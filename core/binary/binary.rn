  getUInt(offset: Int, littleEndian: Bool) -> UInt => "%binary.getUInt"

  getUint(offset: Int, littleEndian: Bool) -> UInt => "%binary.getUInt"

  getUInt32(offset: Int, littleEndian: Bool) -> UInt => "%binary.getUInt"

  getUint32(offset: Int, littleEndian: Bool) -> UInt => "%binary.getUInt"

  setUInt(offset: Int, value: UInt, littleEndian: Bool) -> UInt => "%binary.setUInt"

