+ String: {
  length() -> Int32 => "%string.length"

  isEmpty() -> Bool => .length() == 0

  toString() -> String => "%string.toString"

  at(index: Int32) -> Char => "%string.at"

  charAt(index: Int32) -> Char => "%string.at"

  chars() -> Array[Char] => "%string.chars"

  slice(start: Int32, end: Int32) -> String => "%string.slice"

  concat(value: String) -> String => "%string.concat"

  includes(searchString: String) -> Bool => "%string.includes"

  startsWith(
    searchString: String
  ) -> Bool => "%string.startsWith"

  endsWith(searchString: String) -> Bool => "%string.endsWith"

  indexOf(searchString: String) -> Int32 => "%string.indexOf"

  lastIndexOf(
    searchString: String
  ) -> Int32 => "%string.lastIndexOf"

  toLowerCase() -> String => "%string.toLowerCase"

  toUpperCase() -> String => "%string.toUpperCase"

  trim() -> String => "%string.trim"

  trimStart() -> String => "%string.trimStart"

  trimEnd() -> String => "%string.trimEnd"

  repeat(count: Int32) -> String => "%string.repeat"

  replace(
    searchValue: String,
    replaceValue: String
  ) -> String => "%string.replace"

  replaceAll(
    searchValue: String,
    replaceValue: String
  ) -> String => "%string.replaceAll"

  split(
    separator: String
  ) -> Array[String] => "%string.split"
}

+ fromChars(chars: Array[Char]) -> String => "%string.fromChars"
