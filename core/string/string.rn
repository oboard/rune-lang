String: {
    length() -> Int => "%string.length"

    isEmpty() -> Bool => .length() == 0

    toString() -> String => "%string.toString"

    at(index: Int) -> String => "%string.at"

    charAt(index: Int) -> String => "%string.at"

    slice(start: Int, end: Int) -> String => "%string.slice"

    concat(value: String) -> String => "%string.concat"

    includes(searchString: String) -> Bool => "%string.includes"

    startsWith(searchString: String) -> Bool => "%string.startsWith"

    endsWith(searchString: String) -> Bool => "%string.endsWith"

    indexOf(searchString: String) -> Int => "%string.indexOf"

    lastIndexOf(searchString: String) -> Int => "%string.lastIndexOf"

    toLowerCase() -> String => "%string.toLowerCase"

    toUpperCase() -> String => "%string.toUpperCase"

    trim() -> String => "%string.trim"

    trimStart() -> String => "%string.trimStart"

    trimEnd() -> String => "%string.trimEnd"

    repeat(count: Int) -> String => "%string.repeat"

    replace(searchValue: String, replaceValue: String) -> String => "%string.replace"

    replaceAll(searchValue: String, replaceValue: String) -> String => "%string.replaceAll"

    split(separator: String) -> Array[String] => "%string.split"
}
