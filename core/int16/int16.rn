+ Int16: {
  add(other: Int16) -> Int16 => "%int16.add"

  sub(other: Int16) -> Int16 => "%int16.sub"

  mul(other: Int16) -> Int16 => "%int16.mul"

  div(other: Int16) -> Int16 => "%int16.div"
}

+ fromInt(value: Int32) -> Int16 => "%int16.fromInt"

+ toInt(value: Int16) -> Int32 => "%int16.toInt"
