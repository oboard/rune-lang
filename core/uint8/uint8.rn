+ UInt8: {
  add(other: UInt8) -> UInt8 => "%uint8.add"

  sub(other: UInt8) -> UInt8 => "%uint8.sub"

  mul(other: UInt8) -> UInt8 => "%uint8.mul"

  div(other: UInt8) -> UInt8 => "%uint8.div"
}

+ fromInt(value: Int32) -> UInt8 => "%uint8.fromInt"

+ toInt(value: UInt8) -> Int32 => "%uint8.toInt"
