@syntax

+ CliCommand: {
  name: String
  version: String?
  about: String
  options: Array[CliOption]
  arguments: Array[CliArgument]
  commands: Array[CliCommand]
  aliases: Array[CliCommandAlias]
}

+ CliOption: {
  name: String
  short: String
  valueName: String
  help: String
  required: Bool
  defaultValue: String?
}

+ CliArgument: {
  name: String
  help: String
  required: Bool
}

+ CliParseResult: {
  command: CliCommand
  values: Map[String, String]
  flags: Map[String, Bool]
  positionals: Map[String, String]
  explicitOptions: Array[String]
  args: Array[String]
  rest: Array[String]
  help: Bool
  error: String?
}

+ CliCommandAlias: {
  from: String
  to: String
}

+ CliCommandParseResult: {
  root: CliParseResult
  command: CliParseResult
  commandName: String
  commandArgs: Array[String]
  error: String?
}

CliCommandArgs: {
  rootArgs: Array[String]
  commandName: String
  commandArgs: Array[String]
}

CliCommandLookup: {
  command: CliCommand
  found: Bool
}

moduleCall(
  name: String,
  args: Array[SyntaxExpr]
) -> SyntaxExpr => CallExpr(SelectorExpr(ModuleExpr("cli"), name), args)

methodCall(
  receiver: SyntaxExpr,
  name: String,
  args: Array[SyntaxExpr]
) -> SyntaxExpr => CallExpr(SelectorExpr(receiver, name), args)

annotationNamed(
  annotations: Array[SyntaxAnnotation],
  name: String
) -> SyntaxAnnotation => annotations.foldl(annotations[0], (found, annotation) => (
  annotation.name == name ? annotation
    : found
))

annotationString(
  annotation: SyntaxAnnotation,
  index: Int,
  fallback: String
) -> String => (
  index < annotation.args.length() ? annotation.args[index].stringValue
    : fallback
)

commandAnnotation(
  structure: SyntaxStruct
) -> SyntaxAnnotation => @cli.annotationNamed(structure.annotations, "command")

fieldAnnotation(
  field: SyntaxField
) -> SyntaxAnnotation => field.annotations[0]

commandFromStruct(
  structure: SyntaxStruct
) -> SyntaxExpr => {
  annotation := @cli.commandAnnotation(structure)
  name := @cli.annotationString(annotation, 0, structure.name)
  about := @cli.annotationString(annotation, 1, "")
  version := @cli.annotationString(annotation, 2, "")
  base := @cli.moduleCall("command", [StringExpr(name), StringExpr(about)])
  initial := (
    version.isEmpty() ? base
      : @cli.moduleCall("withVersion", [base, StringExpr(version)])
  )
  structure.fields.foldl(initial, (current, field) => @cli.commandWithField(current, field))
}

commandWithField(
  command: SyntaxExpr,
  field: SyntaxField
) -> SyntaxExpr => {
  annotation := @cli.fieldAnnotation(field)
  (
    annotation.name == "flag" ? @cli.moduleCall("withOption", [command, @cli.moduleCall("flag", [StringExpr(field.name), StringExpr(@cli.annotationString(annotation, 0, "")), StringExpr(@cli.annotationString(annotation, 1, ""))])])
      : (
        annotation.name == "option" ? @cli.moduleCall("withOption", [command, @cli.moduleCall("option", [StringExpr(field.name), StringExpr(@cli.annotationString(annotation, 0, "")), StringExpr(@cli.annotationString(annotation, 1, field.name)), StringExpr(@cli.annotationString(annotation, 2, "")), BoolExpr(false), StringExpr(@cli.annotationString(annotation, 3, ""))])])
          : @cli.moduleCall("withArgument", [command, @cli.moduleCall("argument", [StringExpr(field.name), StringExpr(@cli.annotationString(annotation, 0, "")), BoolExpr(true)])])
      )
  )
}

parsedField(
  field: SyntaxField
) -> SyntaxExpr => {
  annotation := @cli.fieldAnnotation(field)
  result := IdentifierExpr("result")
  (
    annotation.name == "flag" ? @cli.methodCall(SelectorExpr(result, "flags"), "getOr", [StringExpr(field.name), BoolExpr(false)])
      : (
        annotation.name == "option" ? @cli.methodCall(SelectorExpr(result, "values"), "getOr", [StringExpr(field.name), StringExpr(@cli.annotationString(annotation, 3, ""))])
          : @cli.methodCall(SelectorExpr(result, "positionals"), "getOr", [StringExpr(field.name), StringExpr("")])
      )
  )
}

argsExpr(
  structure: SyntaxStruct
) -> SyntaxExpr => StructExpr(structure.name, structure.fields.map((field) => SyntaxExprField {
  name: field.name,
  value: @cli.parsedField(field)
}))

mainBody(
  structure: SyntaxStruct
) -> SyntaxExpr => BlockExpr([SyntaxStatement {
  kind: "let",
  name: "result",
  value: @cli.moduleCall("parseOrExit", [@cli.commandFromStruct(structure)])
}, SyntaxStatement {
  kind: "expr",
  name: "",
  value: CallExpr(IdentifierExpr("__cliMain"), [@cli.argsExpr(structure)])
}])

parserBody(
  target: SyntaxFunction,
  rootName: String,
  commandsName: String,
  aliasesName: String,
  trailingRestName: String,
  handlerName: String
) -> SyntaxExpr => {
  argsName := target.params[0].name
  root := CallExpr(IdentifierExpr(rootName), [])
  commands := CallExpr(IdentifierExpr(commandsName), [])
  aliases := CallExpr(IdentifierExpr(aliasesName), [])
  trailingRest := CallExpr(IdentifierExpr(trailingRestName), [])
  parsed := @cli.moduleCall("parseCommandArgs", [root, commands, aliases, trailingRest, IdentifierExpr(argsName)])
  BlockExpr([SyntaxStatement {
    kind: "let",
    name: "parsed",
    value: parsed
  }, SyntaxStatement {
    kind: "expr",
    name: "",
    value: CallExpr(IdentifierExpr(handlerName), [IdentifierExpr("parsed"), root, commands])
  }])
}

#command(
  tree: SyntaxFile,
  context: MacroContext,
  name: String,
  about: String,
  version: String
) -> SyntaxFile => tree

#flag(
  tree: SyntaxFile,
  context: MacroContext,
  short: String,
  help: String
) -> SyntaxFile => tree

#option(
  tree: SyntaxFile,
  context: MacroContext,
  short: String,
  valueName: String,
  help: String,
  defaultValue: String
) -> SyntaxFile => tree

#arg(
  tree: SyntaxFile,
  context: MacroContext,
  help: String
) -> SyntaxFile => tree

#parser(
  tree: SyntaxFile,
  context: MacroContext,
  rootName: String,
  commandsName: String,
  aliasesName: String,
  trailingRestName: String,
  handlerName: String
) -> SyntaxFile => {
  target := tree.functions.foldl(tree.functions[0], (found, function) => (
    function.id == context.targetID ? function
      : found
  ))
  generated := SyntaxFunction {
    id: target.id,
    name: target.name,
    private: target.private,
    static: target.static,
    routine: target.routine,
    generics: target.generics,
    annotations: [],
    receiverType: target.receiverType,
    params: target.params,
    returnType: target.returnType,
    bodyID: target.bodyID,
    generatedBody: @cli.parserBody(target, rootName, commandsName, aliasesName, trailingRestName, handlerName),
    sourcePath: target.sourcePath
  }
  SyntaxFile {
    types: tree.types,
    enums: tree.enums,
    functions: tree.functions.map((function) => (
      function.id == target.id ? generated
        : function
    ))
  }
}

#main(
  tree: SyntaxFile,
  context: MacroContext
) -> SyntaxFile => {
  target := tree.functions.foldl(tree.functions[0], (found, function) => (
    function.id == context.targetID ? function
      : found
  ))
  argsName := target.params[0].type.name
  structure := tree.types.foldl(tree.types[0], (found, candidate) => (
    candidate.name == argsName ? candidate
      : found
  ))
  handler := SyntaxFunction {
    id: target.id,
    name: "__cliMain",
    private: true,
    static: false,
    routine: target.routine,
    generics: target.generics,
    annotations: [],
    receiverType: target.receiverType,
    params: target.params,
    returnType: target.returnType,
    bodyID: target.bodyID,
    generatedBody: target.generatedBody,
    sourcePath: target.sourcePath
  }
  entry := SyntaxFunction {
    id: "",
    name: "main",
    private: true,
    static: false,
    routine: target.routine,
    generics: [],
    annotations: [],
    receiverType: "",
    params: [],
    returnType: target.returnType,
    bodyID: "",
    generatedBody: @cli.mainBody(structure),
    sourcePath: target.sourcePath
  }
  SyntaxFile {
    types: tree.types,
    enums: tree.enums,
    functions: [..tree.functions.map((function) => (
      function.id == target.id ? handler
        : function
    )), entry]
  }
}

+ command(
  name: String,
  about: String
) -> CliCommand => {
  name: name,
  version: null,
  about: about,
  options: [],
  arguments: [],
  commands: [],
  aliases: []
}

+ withVersion(
  command: CliCommand,
  version: String
) => CliCommand {
  ..command,
  version: version
}

+ withOption(
  command: CliCommand,
  option: CliOption
) => CliCommand {
  ..command,
  options: [..command.options, option]
}

+ withArgument(
  command: CliCommand,
  argument: CliArgument
) => CliCommand {
  ..command,
  arguments: [..command.arguments, argument]
}

+ withCommands(
  command: CliCommand,
  commands: Array[CliCommand]
) => CliCommand {
  ..command,
  commands: commands
}

+ withAliases(
  command: CliCommand,
  aliases: Array[CliCommandAlias]
) => CliCommand {
  ..command,
  aliases: aliases
}

+ flag(
  name: String,
  short: String,
  help: String
) -> CliOption => {
  name: name,
  short: short,
  valueName: "",
  help: help,
  required: false,
  defaultValue: null
}

+ option(
  name: String,
  short: String,
  valueName: String,
  help: String,
  required: Bool,
  defaultValue: String?
) -> CliOption => {
  name: name,
  short: short,
  valueName: valueName,
  help: help,
  required: required,
  defaultValue: defaultValue
}

+ argument(
  name: String,
  help: String,
  required: Bool
) -> CliArgument => {
  name: name,
  help: help,
  required: required
}

+ alias(
  from: String,
  to: String
) -> CliCommandAlias => {
  from: from,
  to: to
}

+ contains(
  values: Array[String],
  value: String
) -> Bool => containsAt(values, value, 0)

containsAt(
  values: Array[String],
  value: String,
  index: Int
) -> Bool => (
  index >= values.length() ? false
    : (
      values[index] == value ? true
        : containsAt(values, value, index + 1)
    )
)

+ parse(
  command: CliCommand
) -> CliParseResult => {
  argv := @process.argv()
  rawArgs := argv.slice(1, argv.length())
  args :=: rawArgs
  skipScript := (args.length() > 0) && (args[0].endsWith(".ts") || args[0].endsWith(".js"))
  (
    skipScript ? args = args.slice(1, args.length())
      : args = args
  )
  parseArgs(command, args)
}

+ exitHelp(command: CliCommand) -> Never => {
  @io.print(@cli.help(command))
  @process.exit(0)
}

+ exitError(
  command: CliCommand,
  message: String
) -> Never => {
  @io.println(message)
  @io.print(@cli.help(command))
  @process.exit(2)
}

+ parseOrExit(
  command: CliCommand
) -> CliParseResult => {
  result := @cli.parse(command)
  (
    result.help ? @cli.exitHelp(command)
      : null
  )
  errorMessage := result.error ?? ""
  (
    errorMessage.isEmpty() ? null
      : @cli.exitError(command, errorMessage)
  )
  result
}

+ parseArgs(
  command: CliCommand,
  args: Array[String]
) -> CliParseResult => {
  values := @map.new("", "")
  flags := @map.new("", false)
  positionals := @map.new("", "")
  rest := args.slice(0, 0)
  explicitOptions := args.slice(0, 0)
  positionalValues := args.slice(0, 0)
  helpValue :=: false
  parseError :=: ""
  afterDoubleDash :=: false
  skipNext :=: false
  command.options.each((option) => {
    useDefault := !option.valueName.isEmpty() && (option.defaultValue != null)
    (
      useDefault ? values.set(option.name, option.defaultValue ?? "")
        : values
    )
  })
  args.each((arg, index) => {
    handled :=: false
    (
      skipNext ? handled = true
        : handled = handled
    )
    (
      skipNext ? skipNext = false
        : skipNext = skipNext
    )
    appendRest := !handled && afterDoubleDash
    (
      appendRest ? rest.push(arg)
        : 0
    )
    (
      appendRest ? handled = true
        : handled = handled
    )
    isSeparator := (!handled && parseError.isEmpty()) && (arg == "--")
    (
      isSeparator ? afterDoubleDash = true
        : afterDoubleDash = afterDoubleDash
    )
    (
      isSeparator ? handled = true
        : handled = handled
    )
    isHelp := (!handled && parseError.isEmpty()) && ((arg == "--help") || (arg == "-h"))
    (
      isHelp ? helpValue = true
        : helpValue = helpValue
    )
    (
      isHelp ? handled = true
        : handled = handled
    )
    isLong := ((!handled && parseError.isEmpty()) && arg.startsWith("--")) && (arg.length() > 2)
    longName :=: (
      isLong ? arg.slice(2, arg.length())
        : ""
    )
    longValue :=: ""
    longHasValue :=: false
    eqIndex := longName.indexOf("=")
    hasEquals := isLong && (eqIndex >= 0)
    (
      hasEquals ? longValue = longName.slice(eqIndex + 1, longName.length())
        : longValue = longValue
    )
    (
      hasEquals ? longName = longName.slice(0, eqIndex)
        : longName = longName
    )
    (
      hasEquals ? longHasValue = true
        : longHasValue = longHasValue
    )
    noName := (
      longName.startsWith("no-") ? longName.slice(3, longName.length())
        : ""
    )
    noFound :=: false
    noTakesValue :=: false
    command.options.each((option) => {
      match := ((isLong && !handled) && !noName.isEmpty()) && (option.name == noName)
      (
        match ? noFound = true
          : noFound = noFound
      )
      (
        match ? noTakesValue = !option.valueName.isEmpty()
          : noTakesValue = noTakesValue
      )
    })
    useNoFlag := (((isLong && !handled) && !noName.isEmpty()) && noFound) && !noTakesValue
    (
      useNoFlag ? flags.set(noName, false)
        : flags
    )
    (
      useNoFlag ? explicitOptions.push(noName)
        : 0
    )
    (
      useNoFlag ? handled = true
        : handled = handled
    )
    longFound :=: false
    longTakesValue :=: false
    longOptionName :=: ""
    command.options.each((option) => {
      match := (isLong && !handled) && (option.name == longName)
      (
        match ? longFound = true
          : longFound = longFound
      )
      (
        match ? longTakesValue = !option.valueName.isEmpty()
          : longTakesValue = longTakesValue
      )
      (
        match ? longOptionName = option.name
          : longOptionName = longOptionName
      )
    })
    unknownLong := (isLong && !handled) && !longFound
    (
      unknownLong ? parseError = "unknown option --" + longName
        : parseError = parseError
    )
    (
      unknownLong ? handled = true
        : handled = handled
    )
    missingLongValue := ((((isLong && !handled) && longFound) && longTakesValue) && !longHasValue) && ((index + 1) >= args.length())
    (
      missingLongValue ? parseError = "missing value for --" + longName
        : parseError = parseError
    )
    (
      missingLongValue ? handled = true
        : handled = handled
    )
    useLongNext := (((isLong && !handled) && longFound) && longTakesValue) && !longHasValue
    (
      useLongNext ? longValue = args[index + 1]
        : longValue = longValue
    )
    (
      useLongNext ? skipNext = true
        : skipNext = skipNext
    )
    (
      useLongNext ? longHasValue = true
        : longHasValue = longHasValue
    )
    storeLongValue := ((isLong && !handled) && longFound) && longTakesValue
    (
      storeLongValue ? values.set(longOptionName, longValue)
        : values
    )
    (
      storeLongValue ? explicitOptions.push(longOptionName)
        : 0
    )
    (
      storeLongValue ? handled = true
        : handled = handled
    )
    storeLongFlag := ((isLong && !handled) && longFound) && !longTakesValue
    (
      storeLongFlag ? flags.set(longOptionName, !longHasValue || (longValue != "false"))
        : flags
    )
    (
      storeLongFlag ? explicitOptions.push(longOptionName)
        : 0
    )
    (
      storeLongFlag ? handled = true
        : handled = handled
    )
    isShort := ((!handled && parseError.isEmpty()) && arg.startsWith("-")) && (arg != "-")
    clusterDone :=: false
    arg.slice(1, arg.length()).split("").each((short, shortIndex) => {
      active := (isShort && !clusterDone) && parseError.isEmpty()
      shortHelp := active && (short == "h")
      (
        shortHelp ? helpValue = true
          : helpValue = helpValue
      )
      shortFound :=: false
      shortTakesValue :=: false
      shortOptionName :=: ""
      command.options.each((option) => {
        match := (active && !shortHelp) && (option.short == short)
        (
          match ? shortFound = true
            : shortFound = shortFound
        )
        (
          match ? shortTakesValue = !option.valueName.isEmpty()
            : shortTakesValue = shortTakesValue
        )
        (
          match ? shortOptionName = option.name
            : shortOptionName = shortOptionName
        )
      })
      unknownShort := (active && !shortHelp) && !shortFound
      (
        unknownShort ? parseError = "unknown option -" + short
          : parseError = parseError
      )
      (
        unknownShort ? clusterDone = true
          : clusterDone = clusterDone
      )
      shortValue :=: arg.slice(shortIndex + 2, arg.length())
      missingShortValue := ((((active && !shortHelp) && shortFound) && shortTakesValue) && shortValue.isEmpty()) && ((index + 1) >= args.length())
      (
        missingShortValue ? parseError = "missing value for -" + short
          : parseError = parseError
      )
      (
        missingShortValue ? clusterDone = true
          : clusterDone = clusterDone
      )
      useShortNext := ((((active && !shortHelp) && shortFound) && shortTakesValue) && shortValue.isEmpty()) && parseError.isEmpty()
      (
        useShortNext ? shortValue = args[index + 1]
          : shortValue = shortValue
      )
      (
        useShortNext ? skipNext = true
          : skipNext = skipNext
      )
      storeShortValue := (((active && !shortHelp) && shortFound) && shortTakesValue) && parseError.isEmpty()
      (
        storeShortValue ? values.set(shortOptionName, shortValue)
          : values
      )
      (
        storeShortValue ? explicitOptions.push(shortOptionName)
          : 0
      )
      (
        storeShortValue ? clusterDone = true
          : clusterDone = clusterDone
      )
      storeShortFlag := (((active && !shortHelp) && shortFound) && !shortTakesValue) && parseError.isEmpty()
      (
        storeShortFlag ? flags.set(shortOptionName, true)
          : flags
      )
      (
        storeShortFlag ? explicitOptions.push(shortOptionName)
          : 0
      )
    })
    (
      isShort ? handled = true
        : handled = handled
    )
    positional := !handled && parseError.isEmpty()
    (
      positional ? positionalValues.push(arg)
        : 0
    )
  })
  command.options.each((option) => {
    missing := (((parseError.isEmpty() && !helpValue) && option.required) && !option.valueName.isEmpty()) && !values.has(option.name)
    (
      missing ? parseError = "missing required option --" + option.name
        : parseError = parseError
    )
  })
  positionIndex :=: 0
  command.arguments.each((argument) => {
    hasValue := positionIndex < positionalValues.length()
    (
      hasValue ? positionals.set(argument.name, positionalValues[positionIndex])
        : positionals
    )
    positionIndex = positionIndex + 1
  })
  command.arguments.each((argument) => {
    missing := ((parseError.isEmpty() && !helpValue) && argument.required) && !positionals.has(argument.name)
    (
      missing ? parseError = "missing required argument " + argument.name
        : parseError = parseError
    )
  })
  unexpected := (parseError.isEmpty() && !helpValue) && (positionalValues.length() > command.arguments.length())
  (
    unexpected ? parseError = "unexpected argument " + positionalValues[command.arguments.length()]
      : parseError = parseError
  )
  CliParseResult {
    command: command,
    values: values,
    flags: flags,
    positionals: positionals,
    explicitOptions: explicitOptions,
    args: args,
    rest: rest,
    help: helpValue,
    error: (
      parseError.isEmpty() ? null
        : parseError
    )
  }
}

+ parseCommandArgs(
  root: CliCommand,
  commands: Array[CliCommand],
  aliases: Array[CliCommandAlias],
  trailingRest: Array[String],
  args: Array[String]
) -> CliCommandParseResult => {
  split := splitCommandArgs(root, aliases, args, 0, [], "", [], false)
  rootResult := parseArgs(root, split.rootArgs)
  split.commandName.isEmpty() {
    true => CliCommandParseResult {
      root: rootResult,
      command: rootResult,
      commandName: "",
      commandArgs: [],
      error: null
    }
    _ => parseNamedCommandArgs(rootResult, commands, trailingRest, split)
  }
}

parseNamedCommandArgs(
  rootResult: CliParseResult,
  commands: Array[CliCommand],
  trailingRest: Array[String],
  split: CliCommandArgs
) -> CliCommandParseResult => {
  lookup := findCommand(commands, split.commandName, 0)
  lookup.found {
    true => parseKnownCommandArgs(rootResult, lookup.command, trailingRest, split)
    _ => CliCommandParseResult {
      root: rootResult,
      command: rootResult,
      commandName: split.commandName,
      commandArgs: split.commandArgs,
      error: "unknown command " + split.commandName
    }
  }
}

parseKnownCommandArgs(
  rootResult: CliParseResult,
  command: CliCommand,
  trailingRest: Array[String],
  split: CliCommandArgs
) -> CliCommandParseResult => {
  args := contains(trailingRest, split.commandName) {
    true => normalizeTrailingRestArgs(command, split.commandArgs)
    _ => split.commandArgs
  }
  parsed := withReportedArgs(parseArgs(command, args), split.commandArgs)
  CliCommandParseResult {
    root: rootResult,
    command: parsed,
    commandName: split.commandName,
    commandArgs: split.commandArgs,
    error: null
  }
}

withReportedArgs(
  result: CliParseResult,
  args: Array[String]
) -> CliParseResult => {
  command: result.command,
  values: result.values,
  flags: result.flags,
  positionals: result.positionals,
  explicitOptions: result.explicitOptions,
  args: args,
  rest: result.rest,
  help: result.help,
  error: result.error
}

splitCommandArgs(
  root: CliCommand,
  aliases: Array[CliCommandAlias],
  args: Array[String],
  index: Int,
  rootArgs: Array[String],
  commandName: String,
  commandArgs: Array[String],
  skipNext: Bool
) -> CliCommandArgs => (index >= args.length()) {
  true => CliCommandArgs {
    rootArgs: rootArgs,
    commandName: commandName,
    commandArgs: commandArgs
  }
  _ => splitCommandArg(root, aliases, args, index, rootArgs, commandName, commandArgs, skipNext)
}

splitCommandArg(
  root: CliCommand,
  aliases: Array[CliCommandAlias],
  args: Array[String],
  index: Int,
  rootArgs: Array[String],
  commandName: String,
  commandArgs: Array[String],
  skipNext: Bool
) -> CliCommandArgs => skipNext {
  true => splitCommandArgs(root, aliases, args, index + 1, rootArgs, commandName, commandArgs, false)
  _ => splitCommandArgValue(root, aliases, args, index, rootArgs, commandName, commandArgs)
}

splitCommandArgValue(
  root: CliCommand,
  aliases: Array[CliCommandAlias],
  args: Array[String],
  index: Int,
  rootArgs: Array[String],
  commandName: String,
  commandArgs: Array[String]
) -> CliCommandArgs => {
  arg := args[index]
  isRootHelp := (commandName == "") && ((arg == "--help") || (arg == "-h"))
  isRootOption := rootOptionArg(root, arg)
  isRootHelp {
    true => splitCommandArgs(root, aliases, args, index + 1, [..rootArgs, arg], commandName, commandArgs, false)
    _ => isRootOption {
      true => splitRootOptionArg(root, aliases, args, index, rootArgs, commandName, commandArgs, rootOptionConsumesNext(root, arg))
      _ => commandName.isEmpty() {
        true => splitCommandArgs(root, aliases, args, index + 1, rootArgs, resolveAlias(aliases, arg, 0), commandArgs, false)
        _ => splitCommandArgs(root, aliases, args, index + 1, rootArgs, commandName, [..commandArgs, arg], false)
      }
    }
  }
}

splitRootOptionArg(
  root: CliCommand,
  aliases: Array[CliCommandAlias],
  args: Array[String],
  index: Int,
  rootArgs: Array[String],
  commandName: String,
  commandArgs: Array[String],
  consumesNext: Bool
) -> CliCommandArgs => splitCommandArgs(root, aliases, args, index + 1, appendRootOptionArgs(rootArgs, args, index, consumesNext), commandName, commandArgs, consumesNext)

appendRootOptionArgs(
  rootArgs: Array[String],
  args: Array[String],
  index: Int,
  consumesNext: Bool
) -> Array[String] => (consumesNext && ((index + 1) < args.length())) {
  true => [..rootArgs, args[index], args[index + 1]]
  _ => [..rootArgs, args[index]]
}

rootOptionArg(
  root: CliCommand,
  arg: String
) -> Bool => optionFound(rootOption(root, arg))

rootOptionConsumesNext(
  root: CliCommand,
  arg: String
) -> Bool => {
  option := rootOption(root, arg)
  hasInline := arg.includes("=") || ((arg.startsWith("-") && !arg.startsWith("--")) && (arg.length() > 2))
  optionFound(option) && ((option.valueName != "") && !hasInline)
}

rootOption(
  root: CliCommand,
  arg: String
) -> CliOption => (arg.startsWith("--") && (arg.length() > 2)) {
  true => findOptionByName(root.options, longOptionName(arg), 0)
  _ => (arg.startsWith("-") && (arg != "-")) {
    true => findOptionByShort(root.options, arg.slice(1, 2), 0)
    _ => emptyOption()
  }
}

longOptionName(arg: String) -> String => {
  raw := arg.slice(2, arg.length())
  equal := raw.indexOf("=")
  (equal >= 0) {
    true => raw.slice(0, equal)
    _ => raw
  }
}

findOptionByName(
  options: Array[CliOption],
  name: String,
  index: Int
) -> CliOption => (index >= options.length()) {
  true => emptyOption()
  _ => (options[index].name == name) {
    true => options[index]
    _ => findOptionByName(options, name, index + 1)
  }
}

findOptionByShort(
  options: Array[CliOption],
  short: String,
  index: Int
) -> CliOption => (index >= options.length()) {
  true => emptyOption()
  _ => (options[index].short == short) {
    true => options[index]
    _ => findOptionByShort(options, short, index + 1)
  }
}

emptyOption() -> CliOption => {
  name: "",
  short: "",
  valueName: "",
  help: "",
  required: false,
  defaultValue: null
}

optionFound(option: CliOption) -> Bool => option.name != ""

findCommand(
  commands: Array[CliCommand],
  name: String,
  index: Int
) -> CliCommandLookup => (name.isEmpty() || (index >= commands.length())) {
  true => CliCommandLookup {
    command: emptyCommand(),
    found: false
  }
  _ => (commands[index].name == name) {
    true => CliCommandLookup {
      command: commands[index],
      found: true
    }
    _ => findCommand(commands, name, index + 1)
  }
}

emptyCommand() -> CliCommand => {
  name: "",
  version: null,
  about: "",
  options: [],
  arguments: [],
  commands: [],
  aliases: []
}

aliasesForCommand(
  aliases: Array[CliCommandAlias],
  commandName: String,
  index: Int
) -> Array[String] => (index >= aliases.length()) {
  true => []
  _ => (aliases[index].to == commandName) {
    true => [aliases[index].from, ..aliasesForCommand(aliases, commandName, index + 1)]
    _ => aliasesForCommand(aliases, commandName, index + 1)
  }
}

resolveAlias(
  aliases: Array[CliCommandAlias],
  name: String,
  index: Int
) -> String => (index >= aliases.length()) {
  true => name
  _ => (aliases[index].from == name) {
    true => aliases[index].to
    _ => resolveAlias(aliases, name, index + 1)
  }
}

normalizeTrailingRestArgs(
  command: CliCommand,
  args: Array[String]
) -> Array[String] => normalizeTrailingRestArgsAt(command, args, 0, [], 0, false)

normalizeTrailingRestArgsAt(
  command: CliCommand,
  args: Array[String],
  index: Int,
  out: Array[String],
  positionalCount: Int,
  skipNext: Bool
) -> Array[String] => (index >= args.length()) {
  true => out
  _ => normalizeTrailingRestArg(command, args, index, out, positionalCount, skipNext)
}

normalizeTrailingRestArg(
  command: CliCommand,
  args: Array[String],
  index: Int,
  out: Array[String],
  positionalCount: Int,
  skipNext: Bool
) -> Array[String] => {
  arg := args[index]
  (positionalCount >= command.arguments.length()) {
    true => appendRestSeparator(args, index, out)
    _ => skipNext {
      true => normalizeTrailingRestArgsAt(command, args, index + 1, [..out, arg], positionalCount, false)
      _ => commandOptionConsumesNext(command, arg) {
        true => normalizeTrailingRestArgsAt(command, args, index + 1, [..out, arg], positionalCount, true)
        _ => normalizeTrailingRestArgsAt(command, args, index + 1, [..out, arg], positionalCount + positionalIncrement(arg), false)
      }
    }
  }
}

commandOptionConsumesNext(
  command: CliCommand,
  arg: String
) -> Bool => rootOptionConsumesNext(command, arg)

positionalIncrement(arg: String) -> Int => (arg.startsWith("-")) {
  true => 0
  _ => 1
}

appendRestSeparator(
  args: Array[String],
  index: Int,
  out: Array[String]
) -> Array[String] => (args[index] == "--") {
  true => appendRuntimeRest(args, index, out)
  _ => appendRuntimeRest(args, index, [..out, "--"])
}

appendRuntimeRest(
  args: Array[String],
  index: Int,
  out: Array[String]
) -> Array[String] => (index >= args.length()) {
  true => out
  _ => appendRuntimeRest(args, index + 1, [..out, args[index]])
}

+ help(command: CliCommand) -> String => {
  text :=: "Usage: " + command.name
  (
    command.options.isEmpty() ? text = text
      : text = text + " [options]"
  )
  command.arguments.each((argument) => {
    text = text + " "
    text = text + (
      argument.required ? ("<" + argument.name) + ">"
        : ("[" + argument.name) + "]"
    )
  })
  text = text + "\n"
  (
    command.commands.isEmpty() ? text = text
      : text = text + "\nCommands:\n"
  )
  command.commands.each((child) => {
    text = (text + "  ") + child.name
    text = (
      child.about.isEmpty() ? text
        : (text + "\t") + child.about
    )
    aliasesForCommand(command.aliases, child.name, 0).each((aliasName) => {
      text = ((text + " (alias: ") + aliasName) + ")"
    })
    text = text + "\n"
  })
  versionText := command.version ?? ""
  (
    versionText.isEmpty() ? text = text
      : text = ((text + "Version: ") + versionText) + "\n"
  )
  (
    command.about.isEmpty() ? text = text
      : text = ((text + "\n") + command.about) + "\n"
  )
  (
    command.arguments.isEmpty() ? text = text
      : text = text + "\nArguments:\n"
  )
  command.arguments.each((argument) => {
    text = (text + "  ") + argument.name
    text = (
      argument.help.isEmpty() ? text
        : (text + "\t") + argument.help
    )
    text = text + "\n"
  })
  text = text + "\nOptions:\n"
  command.options.each((option) => {
    text = text + "  "
    text = (
      option.short.isEmpty() ? text
        : ((text + "-") + option.short) + ", "
    )
    text = (text + "--") + option.name
    text = (
      option.valueName.isEmpty() ? text
        : ((text + " <") + option.valueName) + ">"
    )
    text = (
      option.help.isEmpty() ? text
        : (text + "\t") + option.help
    )
    text = (
      option.required ? text + " (required)"
        : text
    )
    defaultValue := option.defaultValue ?? ""
    text = (
      defaultValue.isEmpty() ? text
        : ((text + " (default: ") + defaultValue) + ")"
    )
    text = text + "\n"
  })
  text + "  -h, --help\tShow help\n"
}
