@"../lexer/lexer.rn"
@"ast.rn"

ParserState: {
  tokens: Array[Token]
  current: Int
  errors: Array[ParseError]
}

TokenStep: {
  state: ParserState
  token: Token
}

BoolStep: {
  state: ParserState
  ok: Bool
}

StringStep: {
  state: ParserState
  value: String
}

TypeRefStep: {
  state: ParserState
  typeRef: ParsedTypeRef
}

TypeRefListStep: {
  state: ParserState
  refs: Array[ParsedTypeRef]
}

TypeParamStep: {
  state: ParserState
  param: ParsedTypeParam
}

TypeParamListStep: {
  state: ParserState
  params: Array[ParsedTypeParam]
}

StringListStep: {
  state: ParserState
  values: Array[String]
}

ParamListStep: {
  state: ParserState
  params: Array[ParsedParam]
}

ExprStep: {
  state: ParserState
  expr: ParsedExpr
}

FileStep: {
  state: ParserState
  file: ParsedFile
}

ImportStep: {
  state: ParserState
  importDecl: ParsedImport
}

FunctionStep: {
  state: ParserState
  function: ParsedFunction
}

TypeStep: {
  state: ParserState
  typeDecl: ParsedType
}

TestStep: {
  state: ParserState
  testDecl: ParsedTest
}

FieldStep: {
  state: ParserState
  field: ParsedField
}

EnumMemberStep: {
  state: ParserState
  member: ParsedEnumMember
}

+ parse(source: String) -> ParsedFile => parseTokens(lex(source))

+ parseTokens(
  tokens: Array[Token]
) -> ParsedFile => {
  errors := emptyParseErrors()
  parseFileLoop(parserSkipNewlines(ParserState {
    tokens: tokens
    current: 0
    errors: errors
  }), emptyFile(errors)).file
}

emptyFile(
  errors: Array[ParseError]
) -> ParsedFile => ParsedFile {
  imports: []
  types: []
  functions: []
  tests: []
  errors: errors
}

emptyParseErrors() -> Array[ParseError] => [ParseError {
  message: ""
  line: 0
  column: 0
}].slice(0, 0)

emptyToken() -> Token => Token {
  kind: TokenKind.EOF
  lexeme: ""
  offset: 0
  line: 0
  column: 0
}

emptyExpr() -> ParsedExpr => ParsedExpr {
  kind: ExprKind.Unknown
  text: ""
  name: ""
  value: ""
  op: ""
  params: []
  children: []
  line: 0
  column: 0
}

emptyFunction() -> ParsedFunction => ParsedFunction {
  name: ""
  private: true
  routine: false
  receiverType: ""
  generics: []
  params: []
  returnType: emptyParsedTypeRef()
  body: emptyExpr()
  line: 0
  column: 0
}

emptyType() -> ParsedType => ParsedType {
  name: ""
  private: true
  enum: false
  generics: []
  fields: []
  methods: []
  members: []
  line: 0
  column: 0
}

emptyImport() -> ParsedImport => ParsedImport {
  path: ""
  go: false
  line: 0
  column: 0
}

emptyTest() -> ParsedTest => ParsedTest {
  name: ""
  body: emptyExpr()
  line: 0
  column: 0
}

emptyField() -> ParsedField => ParsedField {
  name: ""
  private: true
  typeRef: emptyParsedTypeRef()
  line: 0
  column: 0
}

emptyMember() -> ParsedEnumMember => ParsedEnumMember {
  name: ""
  private: true
  value: ""
  line: 0
  column: 0
}

makeExpr(
  kind: ExprKind,
  text: String,
  name: String,
  value: String,
  op: String,
  params: Array[ParsedParam],
  children: Array[ParsedExpr],
  line: Int,
  column: Int
) -> ParsedExpr => ParsedExpr {
  kind: kind
  text: text
  name: name
  value: value
  op: op
  params: params
  children: children
  line: line
  column: column
}

node(
  kind: ExprKind,
  token: Token
) -> ParsedExpr => makeExpr(kind, token.lexeme, "", "", "", [], [], token.line, token.column)

namedNode(
  kind: ExprKind,
  name: String,
  token: Token
) -> ParsedExpr => makeExpr(kind, token.lexeme, name, "", "", [], [], token.line, token.column)

valueNode(
  kind: ExprKind,
  value: String,
  token: Token
) -> ParsedExpr => makeExpr(kind, token.lexeme, "", value, "", [], [], token.line, token.column)

opNode(
  kind: ExprKind,
  op: String,
  token: Token,
  children: Array[ParsedExpr]
) -> ParsedExpr => makeExpr(kind, token.lexeme, "", "", op, [], children, token.line, token.column)

withChildren(
  expr: ParsedExpr,
  children: Array[ParsedExpr]
) -> ParsedExpr => makeExpr(expr.kind, expr.text, expr.name, expr.value, expr.op, expr.params, children, expr.line, expr.column)

withParams(
  expr: ParsedExpr,
  params: Array[ParsedParam]
) -> ParsedExpr => makeExpr(expr.kind, expr.text, expr.name, expr.value, expr.op, params, expr.children, expr.line, expr.column)

withText(
  expr: ParsedExpr,
  text: String
) -> ParsedExpr => makeExpr(expr.kind, text, expr.name, expr.value, expr.op, expr.params, expr.children, expr.line, expr.column)

appendChild(
  expr: ParsedExpr,
  child: ParsedExpr
) -> ParsedExpr => {
  expr.children.push(child)
  expr
}

appendParam(
  params: Array[ParsedParam],
  param: ParsedParam
) -> Array[ParsedParam] => {
  params.push(param)
  params
}

appendString(
  values: Array[String],
  value: String
) -> Array[String] => {
  values.push(value)
  values
}

parserPeek(state: ParserState) -> Token => state.current >= state.tokens.length() ? emptyToken() : state.tokens[state.current]

parserPrevious(
  state: ParserState
) -> Token => state.current <= 0 ? emptyToken() : state.tokens[state.current - 1]

parserTokenAt(
  state: ParserState,
  index: Int
) -> Token => index >= state.tokens.length() ? emptyToken() : state.tokens[index]

parserKindAt(
  state: ParserState,
  index: Int
) -> TokenKind => parserTokenAt(state, index).kind

parserCheck(
  state: ParserState,
  kind: TokenKind
) -> Bool => parserPeek(state).kind == kind

parserCheckNext(
  state: ParserState,
  kind: TokenKind
) -> Bool => parserKindAt(state, state.current + 1) == kind

stateAt(
  state: ParserState,
  current: Int
) -> ParserState => ParserState {
  tokens: state.tokens
  current: current
  errors: state.errors
}

parserAdvance(
  state: ParserState
) -> TokenStep => parserCheck(state, TokenKind.EOF) ? TokenStep {
  state: state
  token: parserPeek(state)
} : TokenStep {
  state: stateAt(state, state.current + 1)
  token: parserPeek(state)
}

parserMatch(
  state: ParserState,
  kind: TokenKind
) -> BoolStep => parserCheck(state, kind) ? BoolStep {
  state: parserAdvance(state).state
  ok: true
} : BoolStep {
  state: state
  ok: false
}

parserConsume(
  state: ParserState,
  kind: TokenKind,
  message: String
) -> TokenStep => parserCheck(state, kind) ? parserAdvance(state) : parserConsumeMissing(parserErrorAt(state, parserPeek(state), message))

parserConsumeMissing(
  state: ParserState
) -> TokenStep => parserCheck(state, TokenKind.EOF) ? TokenStep {
  state: state
  token: parserPeek(state)
} : parserAdvance(state)

parserErrorAt(
  state: ParserState,
  token: Token,
  message: String
) -> ParserState => {
  state.errors.push(ParseError {
    message: message
    line: token.line
    column: token.column
  })
  state
}

parserSkipNewlines(
  state: ParserState
) -> ParserState => parserCheck(state, TokenKind.Newline) ? parserSkipNewlines(parserAdvance(state).state) : state

consumeStatementEnd(
  state: ParserState
) -> ParserState => parserMatch(state, TokenKind.Newline).ok ? parserSkipNewlines(parserAdvance(state).state) : state

unquote(raw: String) -> String => raw.length() >= 2 ? raw.slice(1, raw.length() - 1) : raw

parseFileLoop(
  state: ParserState,
  file: ParsedFile
) -> FileStep => parserCheck(state, TokenKind.EOF) ? FileStep {
  state: state
  file: file
} : parseTopLevel(state, file)

parseTopLevel(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  publicStep := parsePublicModifier(state)
  current ~= publicStep.state
  private := publicStep.ok == false
  current = publicStep.ok && (parserCheck(current, TokenKind.At) || parserCheck(current, TokenKind.Question)) ? parserErrorAt(current, parserPeek(current), "expected public declaration after '+'") : current
  result := !publicStep.ok && parserCheck(current, TokenKind.At) ? parseTopLevelImport(current, file) : !publicStep.ok && parserCheck(current, TokenKind.Question) ? parseTopLevelTest(current, file) : looksLikeTypeDecl(current) ? parseTopLevelType(current, file, private) : looksLikeFunctionDecl(current) ? parseTopLevelFunction(current, file, private) : parseTopLevelError(current, file)
  parseFileLoop(parserSkipNewlines(result.state), result.file)
}

parseTopLevelImport(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  step := parserCheckNext(state, TokenKind.String) ? parseImportDecl(state) : parseGoImportDecl(state)
  file.imports.push(step.importDecl)
  FileStep {
    state: step.state
    file: file
  }
}

parseTopLevelTest(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  step := parseTestDecl(state)
  file.tests.push(step.testDecl)
  FileStep {
    state: step.state
    file: file
  }
}

parseTopLevelType(
  state: ParserState,
  file: ParsedFile,
  private: Bool
) -> FileStep => {
  step := parseTypeDecl(state, private)
  file.types.push(step.typeDecl)
  FileStep {
    state: step.state
    file: file
  }
}

parseTopLevelFunction(
  state: ParserState,
  file: ParsedFile,
  private: Bool
) -> FileStep => {
  step := parseFunctionWithReceiver(state, "", private)
  file.functions.push(step.function)
  FileStep {
    state: step.state
    file: file
  }
}

parseTopLevelError(
  state: ParserState,
  file: ParsedFile
) -> FileStep => FileStep {
  state: parserAdvance(parserErrorAt(state, parserPeek(state), "expected declaration")).state
  file: file
}

parsePublicModifier(
  state: ParserState
) -> BoolStep => {
  step := parserMatch(state, TokenKind.Plus)
  BoolStep {
    state: step.ok ? parserSkipNewlines(step.state) : state
    ok: step.ok
  }
}

parseObjectPrivateModifier(
  state: ParserState
) -> BoolStep => {
  step := parserMatch(state, TokenKind.Minus)
  BoolStep {
    state: step.ok ? parserSkipNewlines(step.state) : state
    ok: step.ok
  }
}

parseImportDecl(
  state: ParserState
) -> ImportStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  path := parserConsume(at.state, TokenKind.String, "expected import path string after '@'")
  ImportStep {
    state: path.state
    importDecl: ParsedImport {
      path: unquote(path.token.lexeme)
      go: false
      line: at.token.line
      column: at.token.column
    }
  }
}

parseGoImportDecl(
  state: ParserState
) -> ImportStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  module := parserConsume(at.state, TokenKind.Ident, "expected module name after '@'")
  checked := module.token.lexeme == "go" ? module.state : parserErrorAt(module.state, module.token, "only @go.import can appear at the top level")
  dot := parserConsume(checked, TokenKind.Dot, "expected '.' after @go")
  name := parserConsume(dot.state, TokenKind.Ident, "expected import after @go.")
  checkedName := name.token.lexeme == "import" ? name.state : parserErrorAt(name.state, name.token, "only @go.import can appear at the top level")
  open := parserConsume(checkedName, TokenKind.LParen, "expected '(' after @go.import")
  path := parserConsume(open.state, TokenKind.String, "expected Go import path string")
  close := parserConsume(path.state, TokenKind.RParen, "expected ')' after @go.import")
  ImportStep {
    state: close.state
    importDecl: ParsedImport {
      path: unquote(path.token.lexeme)
      go: true
      line: at.token.line
      column: at.token.column
    }
  }
}

parseTestDecl(
  state: ParserState
) -> TestStep => {
  start := parserConsume(state, TokenKind.Question, "expected '?'")
  name := parserConsume(start.state, TokenKind.String, "expected test name string after '?'")
  bodyStart := parserSkipNewlines(name.state)
  body := parserCheck(bodyStart, TokenKind.LBrace) ? parseBlock(bodyStart) : ExprStep {
    state: parserErrorAt(bodyStart, parserPeek(bodyStart), "expected test body block")
    expr: emptyExpr()
  }
  TestStep {
    state: body.state
    testDecl: ParsedTest {
      name: unquote(name.token.lexeme)
      body: body.expr
      line: start.token.line
      column: start.token.column
    }
  }
}

parseTypeDecl(
  state: ParserState,
  private: Bool
) -> TypeStep => {
  name := parserConsume(state, TokenKind.Ident, "expected type name")
  generics := parseGenericNames(name.state)
  colon := parserConsume(generics.state, TokenKind.Colon, "expected ':' after type name")
  openStart := parserSkipNewlines(colon.state)
  open := parserConsume(openStart, TokenKind.LBrace, "expected '{' after type declaration")
  bodyStart := parserSkipNewlines(open.state)
  looksLikeEnumMember(bodyStart) ? parseEnumTypeBody(bodyStart, name.token, private) : parseStructTypeBody(bodyStart, name.token, private, generics.values)
}

parseStructTypeBody(
  state: ParserState,
  name: Token,
  private: Bool,
  generics: Array[String]
) -> TypeStep => parseStructTypeLoop(state, ParsedType {
  name: name.lexeme
  private: private
  enum: false
  generics: generics
  fields: []
  methods: []
  members: []
  line: name.line
  column: name.column
})

parseStructTypeLoop(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishType(current, typeDecl, "expected '}' after type declaration") : parseStructTypeMember(current, typeDecl)
}

parseStructTypeMember(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  current := skipAnnotations(state)
  privateStep := parseObjectPrivateModifier(current)
  memberState := privateStep.state
  private := privateStep.ok
  parsed := looksLikeFunctionDecl(memberState) ? parseStructMethod(memberState, typeDecl, private) : parseStructField(memberState, typeDecl, private)
  next := parserSkipNewlines(parserMatch(consumeStatementEnd(parsed.state), TokenKind.Comma).state)
  parseStructTypeLoop(next, parsed.typeDecl)
}

parseStructMethod(
  state: ParserState,
  typeDecl: ParsedType,
  private: Bool
) -> TypeStep => {
  step := parseFunctionWithReceiver(state, typeDecl.name, private)
  typeDecl.methods.push(step.function)
  TypeStep {
    state: step.state
    typeDecl: typeDecl
  }
}

parseStructField(
  state: ParserState,
  typeDecl: ParsedType,
  private: Bool
) -> TypeStep => {
  field := parseFieldDecl(state, private)
  typeDecl.fields.push(field.field)
  TypeStep {
    state: field.state
    typeDecl: typeDecl
  }
}

parseFieldDecl(
  state: ParserState,
  private: Bool
) -> FieldStep => {
  name := parserConsume(state, TokenKind.Ident, "expected field name")
  colon := parserConsume(name.state, TokenKind.Colon, "expected ':' after field name")
  typeRef := parseTypeRef(colon.state)
  FieldStep {
    state: typeRef.state
    field: ParsedField {
      name: name.token.lexeme
      private: private
      typeRef: typeRef.typeRef
      line: name.token.line
      column: name.token.column
    }
  }
}

finishType(
  state: ParserState,
  typeDecl: ParsedType,
  message: String
) -> TypeStep => {
  close := parserConsume(state, TokenKind.RBrace, message)
  TypeStep {
    state: close.state
    typeDecl: typeDecl
  }
}

parseEnumTypeBody(
  state: ParserState,
  name: Token,
  private: Bool
) -> TypeStep => parseEnumTypeLoop(state, ParsedType {
  name: name.lexeme
  private: private
  enum: true
  generics: []
  fields: []
  methods: []
  members: []
  line: name.line
  column: name.column
})

parseEnumTypeLoop(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishType(current, typeDecl, "expected '}' after enum declaration") : parseEnumTypeMember(current, typeDecl)
}

parseEnumTypeMember(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  member := parseEnumMember(state)
  typeDecl.members.push(member.member)
  next := parserSkipNewlines(parserMatch(consumeStatementEnd(member.state), TokenKind.Comma).state)
  parseEnumTypeLoop(next, typeDecl)
}

parseEnumMember(
  state: ParserState
) -> EnumMemberStep => {
  publicStep := parsePublicModifier(state)
  name := parserConsume(publicStep.state, TokenKind.Ident, "expected enum member name")
  current := parserSkipNewlines(name.state)
  assign := parserMatch(current, TokenKind.Assign)
  value := assign.ok ? parseEnumValue(parserSkipNewlines(assign.state)) : StringStep {
    state: current
    value: ""
  }
  EnumMemberStep {
    state: value.state
    member: ParsedEnumMember {
      name: name.token.lexeme
      private: publicStep.ok == false
      value: value.value
      line: name.token.line
      column: name.token.column
    }
  }
}

parseEnumValue(
  state: ParserState
) -> StringStep => parserCheck(state, TokenKind.Minus) ? parseNegativeEnumValue(state) : parsePositiveEnumValue(state)

parseNegativeEnumValue(
  state: ParserState
) -> StringStep => {
  minus := parserAdvance(state)
  value := parserConsume(minus.state, TokenKind.Int, "expected integer enum value")
  StringStep {
    state: value.state
    value: "-" + value.token.lexeme
  }
}

parsePositiveEnumValue(
  state: ParserState
) -> StringStep => {
  value := parserConsume(state, TokenKind.Int, "expected integer enum value")
  StringStep {
    state: value.state
    value: value.token.lexeme
  }
}

parseFunctionWithReceiver(
  state: ParserState,
  receiverType: String,
  private: Bool
) -> FunctionStep => {
  routineStep := parserMatch(state, TokenKind.Tilde)
  afterRoutine := routineStep.ok ? parserSkipNewlines(routineStep.state) : state
  name := parserConsume(afterRoutine, TokenKind.Ident, "expected function name")
  generics := parseGenericNames(name.state)
  open := parserConsume(generics.state, TokenKind.LParen, "expected '(' after function name")
  params := parseParamList(parserSkipNewlines(open.state))
  close := parserConsume(params.state, TokenKind.RParen, "expected ')' after parameter list")
  afterClose := parserSkipNewlines(close.state)
  ret := parserMatch(afterClose, TokenKind.Arrow)
  returnType := ret.ok ? parseTypeRef(parserSkipNewlines(ret.state)) : TypeRefStep {
    state: afterClose
    typeRef: emptyParsedTypeRef()
  }
  arrow := parserConsume(parserSkipNewlines(returnType.state), TokenKind.FatArrow, "expected '=>' after function signature")
  body := parseBody(parserSkipNewlines(arrow.state))
  FunctionStep {
    state: body.state
    function: ParsedFunction {
      name: name.token.lexeme
      private: private
      routine: routineStep.ok
      receiverType: receiverType
      generics: generics.values
      params: params.params
      returnType: returnType.typeRef
      body: body.expr
      line: name.token.line
      column: name.token.column
    }
  }
}

parseParamList(
  state: ParserState
) -> ParamListStep => parseParamListLoop(state, [])

parseParamListLoop(
  state: ParserState,
  params: Array[ParsedParam]
) -> ParamListStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RParen) || parserCheck(current, TokenKind.EOF) ? ParamListStep {
    state: current
    params: params
  } : parseOneParam(current, params)
}

parseOneParam(
  state: ParserState,
  params: Array[ParsedParam]
) -> ParamListStep => {
  name := parserConsume(state, TokenKind.Ident, "expected parameter name")
  optional := parserMatch(name.state, TokenKind.Question)
  colon := parserMatch(optional.state, TokenKind.Colon)
  typeRef := colon.ok ? parseTypeRef(colon.state) : TypeRefStep {
    state: optional.state
    typeRef: emptyParsedTypeRef()
  }
  paramName := optional.ok ? name.token.lexeme + "?" : name.token.lexeme
  params.push(ParsedParam {
    name: paramName
    typeRef: typeRef.typeRef
    line: name.token.line
    column: name.token.column
  })
  comma := parserMatch(parserSkipNewlines(typeRef.state), TokenKind.Comma)
  parseParamListLoop(comma.state, params)
}

parseGenericNames(
  state: ParserState
) -> StringListStep => {
  open := parserMatch(state, TokenKind.LBracket)
  open.ok ? parseGenericNameLoop(parserSkipNewlines(open.state), []) : StringListStep {
    state: state
    values: []
  }
}

parseGenericNameLoop(
  state: ParserState,
  values: Array[String]
) -> StringListStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBracket) || parserCheck(current, TokenKind.EOF) ? finishGenericNames(current, values) : parseGenericNameValue(current, values)
}

finishGenericNames(
  state: ParserState,
  values: Array[String]
) -> StringListStep => {
  close := parserConsume(state, TokenKind.RBracket, "expected ']' after generic parameters")
  StringListStep {
    state: close.state
    values: values
  }
}

parseGenericNameValue(
  state: ParserState,
  values: Array[String]
) -> StringListStep => {
  afterName := parserCheck(state, TokenKind.Ident) ? appendGenericName(state, values) : parserAdvance(state).state
  colon := parserMatch(parserSkipNewlines(afterName), TokenKind.Colon)
  current := colon.ok ? parseTypeRef(parserSkipNewlines(colon.state)).state : afterName
  comma := parserMatch(parserSkipNewlines(current), TokenKind.Comma)
  parseGenericNameLoop(comma.state, values)
}

appendGenericName(
  state: ParserState,
  values: Array[String]
) -> ParserState => {
  step := parserAdvance(state)
  values.push(step.token.lexeme)
  step.state
}

parseTypeRef(
  state: ParserState
) -> TypeRefStep => parseTypeRefPostfix(parseTypeRefAtom(parserSkipNewlines(state)))

parseTypeRefAtom(
  state: ParserState
) -> TypeRefStep =>
  parserCheck(state, TokenKind.LParen) ? parseParenTypeRef(state)
  : parserCheck(state, TokenKind.At) ? parseQualifiedTypeRef(state)
  : parserCheck(state, TokenKind.Ident) ? parseNamedTypeRef(state)
  : parseTypeRefError(state)

parseNamedTypeRef(
  state: ParserState
) -> TypeRefStep => {
  name := parserConsume(state, TokenKind.Ident, "expected type name")
  TypeRefStep {
    state: name.state
    typeRef: namedParsedTypeRef(name.token)
  }
}

parseQualifiedTypeRef(
  state: ParserState
) -> TypeRefStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  module := parserConsume(at.state, TokenKind.Ident, "expected module name after '@'")
  dot := parserConsume(module.state, TokenKind.Dot, "expected '.' after module name")
  name := parserConsume(dot.state, TokenKind.Ident, "expected type name after module qualifier")
  TypeRefStep {
    state: name.state
    typeRef: qualifiedParsedTypeRef(module.token, name.token)
  }
}

parseParenTypeRef(
  state: ParserState
) -> TypeRefStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '(' before type")
  params := parseTypeParamList(parserSkipNewlines(open.state), [])
  close := parserConsume(params.state, TokenKind.RParen, "expected ')' after type")
  afterClose := parserSkipNewlines(close.state)
  arrow := parserMatch(afterClose, TokenKind.Arrow)
  arrow.ok ? finishFunctionTypeRef(parserSkipNewlines(arrow.state), open.token, params.params) : finishParenTypeRef(close.state, open.token, params.params)
}

finishFunctionTypeRef(
  state: ParserState,
  token: Token,
  params: Array[ParsedTypeParam]
) -> TypeRefStep => {
  ret := parseTypeRef(state)
  TypeRefStep {
    state: ret.state
    typeRef: functionTypeRef(params, ret.typeRef, token)
  }
}

finishParenTypeRef(
  state: ParserState,
  token: Token,
  params: Array[ParsedTypeParam]
) -> TypeRefStep => TypeRefStep {
  state: state
  typeRef: (params.length() == 1) && (params[0].name == "") ? groupedTypeRef(params[0].typeRef, token) : tupleTypeRef(params, token)
}

parseTypeRefPostfix(
  step: TypeRefStep
) -> TypeRefStep => {
  current := parserSkipNewlines(step.state)
  parserCheck(current, TokenKind.LBracket) ? parseTypeRefPostfix(parseTypeRefArgs(current, step.typeRef))
  : parserCheck(current, TokenKind.Question) ? parseTypeRefPostfix(parseNullableTypeRef(current, step.typeRef))
  : TypeRefStep {
      state: step.state
      typeRef: step.typeRef
    }
}

parseTypeRefArgs(
  state: ParserState,
  typeRef: ParsedTypeRef
) -> TypeRefStep => {
  open := parserConsume(state, TokenKind.LBracket, "expected '[' after type name")
  args := parseTypeRefList(parserSkipNewlines(open.state), [])
  close := parserConsume(args.state, TokenKind.RBracket, "expected ']' after type arguments")
  TypeRefStep {
    state: close.state
    typeRef: typeRefWithArgs(typeRef, args.refs)
  }
}

parseNullableTypeRef(
  state: ParserState,
  typeRef: ParsedTypeRef
) -> TypeRefStep => {
  question := parserConsume(state, TokenKind.Question, "expected '?' after type")
  TypeRefStep {
    state: question.state
    typeRef: nullableTypeRef(typeRef)
  }
}

parseTypeRefList(
  state: ParserState,
  refs: Array[ParsedTypeRef]
) -> TypeRefListStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBracket) || parserCheck(current, TokenKind.EOF) ? TypeRefListStep {
    state: current
    refs: refs
  } : parseOneTypeRefListValue(current, refs)
}

parseOneTypeRefListValue(
  state: ParserState,
  refs: Array[ParsedTypeRef]
) -> TypeRefListStep => {
  typeRef := parseTypeRef(state)
  refs.push(typeRef.typeRef)
  comma := parserMatch(parserSkipNewlines(typeRef.state), TokenKind.Comma)
  parseTypeRefList(comma.state, refs)
}

parseTypeParamList(
  state: ParserState,
  params: Array[ParsedTypeParam]
) -> TypeParamListStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RParen) || parserCheck(current, TokenKind.EOF) ? TypeParamListStep {
    state: current
    params: params
  } : parseOneTypeParam(current, params)
}

parseOneTypeParam(
  state: ParserState,
  params: Array[ParsedTypeParam]
) -> TypeParamListStep => {
  param := parseTypeParam(state)
  params.push(param.param)
  comma := parserMatch(parserSkipNewlines(param.state), TokenKind.Comma)
  parseTypeParamList(comma.state, params)
}

parseTypeParam(
  state: ParserState
) -> TypeParamStep => {
  named := parserCheck(state, TokenKind.Ident) && typeParamHasName(state)
  named ? parseNamedTypeParam(state) : parseUnnamedTypeParam(state)
}

parseNamedTypeParam(
  state: ParserState
) -> TypeParamStep => {
  name := parserConsume(state, TokenKind.Ident, "expected type parameter name")
  optional := parserMatch(name.state, TokenKind.Question)
  colon := parserConsume(optional.state, TokenKind.Colon, "expected ':' after type parameter name")
  typeRef := parseTypeRef(parserSkipNewlines(colon.state))
  TypeParamStep {
    state: typeRef.state
    param: ParsedTypeParam {
      name: name.token.lexeme
      optional: optional.ok
      typeRef: typeRef.typeRef
    }
  }
}

parseUnnamedTypeParam(
  state: ParserState
) -> TypeParamStep => {
  typeRef := parseTypeRef(state)
  TypeParamStep {
    state: typeRef.state
    param: ParsedTypeParam {
      name: ""
      optional: false
      typeRef: typeRef.typeRef
    }
  }
}

typeParamHasName(
  state: ParserState
) -> Bool => parserKindAt(state, state.current + 1) == TokenKind.Colon || ((parserKindAt(state, state.current + 1) == TokenKind.Question) && (parserKindAt(state, state.current + 2) == TokenKind.Colon))

parseTypeRefError(
  state: ParserState
) -> TypeRefStep => TypeRefStep {
  state: parserErrorAt(state, parserPeek(state), "expected type name")
  typeRef: emptyParsedTypeRef()
}

parseBody(
  state: ParserState
) -> ExprStep => parserCheck(state, TokenKind.LBrace) ? parseBraceBody(state) : parseExpression(state, 1)

parseBraceBody(
  state: ParserState
) -> ExprStep => (looksLikePatternBranch(state) == false) && looksLikeMapLiteralBody(state) ? parseMapLiteral(state) : parseBlock(state)

parseBlock(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{'")
  bodyStart := parserSkipNewlines(open.state)
  parserCheck(bodyStart, TokenKind.RBrace) ? finishBlock(bodyStart, node(ExprKind.Block, open.token)) : looksLikePatternBranch(bodyStart) ? parsePatternBlock(bodyStart, node(ExprKind.PatternBlock, open.token)) : parseBlockLoop(bodyStart, node(ExprKind.Block, open.token))
}

finishBlock(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after block")
  ExprStep {
    state: close.state
    expr: block
  }
}

parseBlockLoop(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishBlock(current, block) : parseBlockStatement(current, block)
}

parseBlockStatement(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  stmt := parseStatement(state)
  nextBlock := appendChild(block, stmt.expr)
  parseBlockLoop(consumeStatementEnd(stmt.state), nextBlock)
}

parseStatement(
  state: ParserState
) -> ExprStep => parserCheck(state, TokenKind.LBrace) && looksLikeObjectDestructureDecl(state) ? parseObjectDestructureStatement(state) : parserCheck(state, TokenKind.Ident) && ((parserCheckNext(state, TokenKind.Declare) || parserCheckNext(state, TokenKind.MutDeclare)) || parserCheckNext(state, TokenKind.SignalDeclare)) ? parseLetStatement(state) : parserCheck(state, TokenKind.Ident) && parserCheckNext(state, TokenKind.Assign) ? parseAssignStatement(state) : parseExpression(state, 1)

parseLetStatement(
  state: ParserState
) -> ExprStep => {
  name := parserAdvance(state)
  op := parserAdvance(name.state)
  value := parseExpression(parserSkipNewlines(op.state), 1)
  ExprStep {
    state: value.state
    expr: makeExpr(ExprKind.Let, name.token.lexeme, name.token.lexeme, "", op.token.lexeme, [], [value.expr], name.token.line, name.token.column)
  }
}

parseObjectDestructureStatement(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{' before object destructuring")
  fields := parseObjectBindingList(parserSkipNewlines(open.state))
  close := parserConsume(fields.state, TokenKind.RBrace, "expected '}' after object destructuring")
  op := parserAdvance(parserSkipNewlines(close.state))
  value := parseExpression(parserSkipNewlines(op.state), 1)
  ExprStep {
    state: value.state
    expr: makeExpr(ExprKind.ObjectDestructure, "", "", "", op.token.lexeme, fields.params, [value.expr], open.token.line, open.token.column)
  }
}

parseObjectBindingList(
  state: ParserState
) -> ParamListStep => parseObjectBindingListLoop(state, [])

parseObjectBindingListLoop(
  state: ParserState,
  fields: Array[ParsedParam]
) -> ParamListStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? ParamListStep {
    state: current
    params: fields
  } : parseOneObjectBinding(current, fields)
}

parseOneObjectBinding(
  state: ParserState,
  fields: Array[ParsedParam]
) -> ParamListStep => {
  field := parserConsume(state, TokenKind.Ident, "expected field name in object destructuring")
  aliasStart := parserMatch(field.state, TokenKind.Colon)
  name := aliasStart.ok ? parserConsume(parserSkipNewlines(aliasStart.state), TokenKind.Ident, "expected binding name after ':'") : field
  fields.push(ParsedParam {
    name: name.token.lexeme
    typeRef: namedParsedTypeRef(field.token)
    line: name.token.line
    column: name.token.column
  })
  comma := parserMatch(parserSkipNewlines(name.state), TokenKind.Comma)
  comma.ok ? parseObjectBindingListLoop(comma.state, fields) : ParamListStep {
    state: name.state
    params: fields
  }
}

parseAssignStatement(
  state: ParserState
) -> ExprStep => {
  name := parserAdvance(state)
  op := parserAdvance(name.state)
  value := parseExpression(parserSkipNewlines(op.state), 1)
  ExprStep {
    state: value.state
    expr: makeExpr(ExprKind.Assign, name.token.lexeme, name.token.lexeme, "", op.token.lexeme, [], [value.expr], name.token.line, name.token.column)
  }
}

parseExpression(
  state: ParserState,
  minPrec: Int
) -> ExprStep => ((minPrec <= 1) && parserCheck(state, TokenKind.LParen)) && looksLikeLambda(state) ? parseLambda(state) : parseExpressionLoop(parseUnary(state), minPrec)

parseExpressionLoop(
  left: ExprStep,
  minPrec: Int
) -> ExprStep => {
  state := left.state
  expr := left.expr
  parserCheck(state, TokenKind.LBrace) ? parseAfterBraceExpression(state, expr, minPrec) : parserCheck(state, TokenKind.LParen) ? parseCallExpression(state, expr, minPrec) : parserCheck(state, TokenKind.LBracket) ? parseIndexExpression(state, expr, minPrec) : (parserCheck(state, TokenKind.Dot) || parserCheck(state, TokenKind.DoubleColon)) ? parseSelectorExpression(state, expr, minPrec) : parserCheck(state, TokenKind.PlusPlus) ? parsePostfixExpression(state, expr, minPrec) : (minPrec <= 1) && parserCheck(state, TokenKind.Arrow) ? parseWatchExpression(state, expr, minPrec) : (minPrec <= 1) && parserCheck(state, TokenKind.Assign) ? parseAssignmentExpression(state, expr, minPrec) : (minPrec <= 1) && parserCheck(state, TokenKind.Question) ? parseQuestionExpression(state, expr, minPrec) : parseBinaryExpression(state, expr, minPrec)
}

parseAfterBraceExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => looksLikePatternBlockAfterSubject(state) ? parseExpressionLoop(parseMatchExpression(state, expr), minPrec) : expr.kind == ExprKind.Identifier ? parseExpressionLoop(parseStructLiteral(state, expr), minPrec) : ExprStep {
  state: state
  expr: expr
}

parseCallExpression(
  state: ParserState,
  callee: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '(' after callee")
  args := parseArgumentList(parserSkipNewlines(open.state), [callee], TokenKind.RParen)
  close := parserConsume(args.state, TokenKind.RParen, "expected ')' after arguments")
  call := makeExpr(ExprKind.Call, calleeText(callee), "", "", "", [], args.expr.children, callee.line, callee.column)
  parseExpressionLoop(ExprStep {
    state: close.state
    expr: call
  }, minPrec)
}

parseArgumentList(
  state: ParserState,
  holderChildren: Array[ParsedExpr],
  endKind: TokenKind
) -> ExprStep => {
  holder := makeExpr(ExprKind.Args, "", "", "", "", [], holderChildren, 0, 0)
  parseArgumentListLoop(state, holder, endKind)
}

parseArgumentListLoop(
  state: ParserState,
  holder: ParsedExpr,
  endKind: TokenKind
) -> ExprStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, endKind) || parserCheck(current, TokenKind.EOF) ? ExprStep {
    state: current
    expr: holder
  } : parseOneArgument(current, holder, endKind)
}

parseOneArgument(
  state: ParserState,
  holder: ParsedExpr,
  endKind: TokenKind
) -> ExprStep => {
  spread := parserMatch(state, TokenKind.DotDotDot)
  value := parseExpression(spread.ok ? spread.state : state, 1)
  arg := spread.ok ? opNode(ExprKind.Spread, "...", parserPrevious(spread.state), [value.expr]) : value.expr
  nextHolder := appendChild(holder, arg)
  comma := parserMatch(parserSkipNewlines(value.state), TokenKind.Comma)
  parseArgumentListLoop(comma.state, nextHolder, endKind)
}

parseIndexExpression(
  state: ParserState,
  receiver: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBracket, "expected '[' after receiver")
  index := parseExpression(parserSkipNewlines(open.state), 1)
  close := parserConsume(index.state, TokenKind.RBracket, "expected ']' after index")
  parseExpressionLoop(ExprStep {
    state: close.state
    expr: makeExpr(ExprKind.Index, receiver.text, "", "", "", [], [receiver, index.expr], receiver.line, receiver.column)
  }, minPrec)
}

parseSelectorExpression(
  state: ParserState,
  receiver: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  operator := parserCheck(state, TokenKind.DoubleColon) ? parserConsume(state, TokenKind.DoubleColon, "expected '::'") : parserConsume(state, TokenKind.Dot, "expected '.'")
  name := parserConsume(operator.state, TokenKind.Ident, "expected selector name")
  parseExpressionLoop(ExprStep {
    state: name.state
    expr: makeExpr(ExprKind.Selector, name.token.lexeme, name.token.lexeme, "", operator.token.lexeme, [], [receiver], operator.token.line, operator.token.column)
  }, minPrec)
}

parsePostfixExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  parseExpressionLoop(ExprStep {
    state: op.state
    expr: opNode(ExprKind.Postfix, op.token.lexeme, op.token, [expr])
  }, minPrec)
}

parseWatchExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  arrow := parserAdvance(state)
  handler := parseWatchHandler(parserSkipNewlines(arrow.state))
  parseExpressionLoop(ExprStep {
    state: handler.state
    expr: opNode(ExprKind.Watch, arrow.token.lexeme, arrow.token, [expr, handler.expr])
  }, minPrec)
}

parseWatchHandler(
  state: ParserState
) -> ExprStep => parserCheck(state, TokenKind.LParen) && looksLikeLambda(state) ? parseLambda(state) : parserCheck(state, TokenKind.LBrace) ? parseBody(state) : parseExpression(state, 1)

parseAssignmentExpression(
  state: ParserState,
  target: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  value := parseExpression(parserSkipNewlines(op.state), 1)
  parseExpressionLoop(ExprStep {
    state: value.state
    expr: opNode(ExprKind.Assign, op.token.lexeme, op.token, [target, value.expr])
  }, minPrec)
}

parseQuestionExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => questionIsPostfixUnwrap(state) ? parseExpressionLoop(parseResultUnwrapExpression(state, expr), minPrec) : parseTernaryExpression(state, expr, minPrec)

parseResultUnwrapExpression(
  state: ParserState,
  expr: ParsedExpr
) -> ExprStep => {
  question := parserAdvance(state)
  ExprStep {
    state: question.state
    expr: opNode(ExprKind.Unwrap, "?", question.token, [expr])
  }
}

parseTernaryExpression(
  state: ParserState,
  condition: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  question := parserAdvance(state)
  consequence := parseExpression(parserSkipNewlines(question.state), 1)
  afterConsequence := parserSkipNewlines(consequence.state)
  colon := parserMatch(afterConsequence, TokenKind.Colon)
  colon.ok ? parseTernaryAlternative(colon.state, question.token, condition, consequence.expr, minPrec) : parseExpressionLoop(ExprStep {
    state: afterConsequence
    expr: opNode(ExprKind.Ternary, "?:", question.token, [condition, consequence.expr])
  }, minPrec)
}

parseTernaryAlternative(
  state: ParserState,
  token: Token,
  condition: ParsedExpr,
  consequence: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  alternative := parseExpression(parserSkipNewlines(state), 1)
  parseExpressionLoop(ExprStep {
    state: alternative.state
    expr: opNode(ExprKind.Ternary, "?:", token, [condition, consequence, alternative.expr])
  }, minPrec)
}

parseBinaryExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  prec := precedence(parserPeek(state).kind)
  prec < minPrec ? ExprStep {
    state: state
    expr: expr
  } : parseBinaryExpressionAtPrec(state, expr, minPrec, prec)
}

parseBinaryExpressionAtPrec(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int,
  prec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  right := parseExpression(op.state, prec + 1)
  parseExpressionLoop(ExprStep {
    state: right.state
    expr: opNode(ExprKind.Binary, op.token.lexeme, op.token, [expr, right.expr])
  }, minPrec)
}

parseUnary(
  state: ParserState
) -> ExprStep => (parserCheck(state, TokenKind.Minus) || parserCheck(state, TokenKind.Bang)) || parserCheck(state, TokenKind.Tilde) ? parseUnaryOperator(state) : parsePrimary(state)

parseUnaryOperator(
  state: ParserState
) -> ExprStep => {
  op := parserAdvance(state)
  right := parseExpression(op.state, 11)
  ExprStep {
    state: right.state
    expr: opNode(ExprKind.Unary, op.token.lexeme, op.token, [right.expr])
  }
}

parsePrimary(
  state: ParserState
) -> ExprStep => {
  token := parserPeek(state)
  token.kind == TokenKind.Int ? parseLiteral(state, ExprKind.Int) : token.kind == TokenKind.Double ? parseLiteral(state, ExprKind.Double) : token.kind == TokenKind.BigInt ? parseLiteral(state, ExprKind.BigInt) : token.kind == TokenKind.String ? parseLiteral(state, ExprKind.String) : token.kind == TokenKind.TemplateString ? parseLiteral(state, ExprKind.Template) : token.kind == TokenKind.Char ? parseLiteral(state, ExprKind.Char) : token.kind == TokenKind.Regex ? parseLiteral(state, ExprKind.Regex) : token.kind == TokenKind.XMLText ? parseLiteral(state, ExprKind.XMLText) : token.kind == TokenKind.Ident ? parseIdentifierPrimary(state) : token.kind == TokenKind.At ? parseAtExpression(state) : token.kind == TokenKind.Dot ? parseThisSelector(state) : token.kind == TokenKind.LBracket ? parseArrayLiteral(state) : token.kind == TokenKind.Dollar ? parseReactiveLiteral(state) : token.kind == TokenKind.LBrace ? parseBraceLiteral(state) : token.kind == TokenKind.LParen ? parseParenOrTuple(state) : parsePrimaryError(state)
}

parseLiteral(
  state: ParserState,
  kind: ExprKind
) -> ExprStep => {
  step := parserAdvance(state)
  ExprStep {
    state: step.state
    expr: valueNode(kind, step.token.lexeme, step.token)
  }
}

parseIdentifierPrimary(
  state: ParserState
) -> ExprStep => {
  step := parserAdvance(state)
  kind := (step.token.lexeme == "true") || (step.token.lexeme == "false") ? ExprKind.Bool : step.token.lexeme == "null" ? ExprKind.Null : ExprKind.Identifier
  ExprStep {
    state: step.state
    expr: kind == ExprKind.Identifier ? namedNode(kind, step.token.lexeme, step.token) : valueNode(kind, step.token.lexeme, step.token)
  }
}

parseAtExpression(
  state: ParserState
) -> ExprStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  parserCheck(at.state, TokenKind.String) ? parseAtImportExpression(at) : parseAtModuleExpression(at)
}

parseAtImportExpression(
  at: TokenStep
) -> ExprStep => {
  path := parserAdvance(at.state)
  ExprStep {
    state: path.state
    expr: valueNode(ExprKind.At, path.token.lexeme, at.token)
  }
}

parseAtModuleExpression(
  at: TokenStep
) -> ExprStep => {
  name := parserConsume(at.state, TokenKind.Ident, "expected module name after '@'")
  ExprStep {
    state: name.state
    expr: namedNode(ExprKind.At, name.token.lexeme, at.token)
  }
}

parseThisSelector(
  state: ParserState
) -> ExprStep => {
  dot := parserConsume(state, TokenKind.Dot, "expected '.'")
  name := parserConsume(dot.state, TokenKind.Ident, "expected field name after '.'")
  ExprStep {
    state: name.state
    expr: makeExpr(ExprKind.Selector, name.token.lexeme, name.token.lexeme, "", ".", [], [node(ExprKind.This, dot.token)], dot.token.line, dot.token.column)
  }
}

parseArrayLiteral(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBracket, "expected '['")
  args := parseArgumentList(parserSkipNewlines(open.state), [], TokenKind.RBracket)
  close := parserConsume(args.state, TokenKind.RBracket, "expected ']' after array literal")
  ExprStep {
    state: close.state
    expr: makeExpr(ExprKind.Array, "[]", "", "", "", [], args.expr.children, open.token.line, open.token.column)
  }
}

parseReactiveLiteral(
  state: ParserState
) -> ExprStep => {
  start := parserConsume(state, TokenKind.Dollar, "expected '$'")
  value := parserCheck(start.state, TokenKind.LBracket) ? parseArrayLiteral(start.state) : parserCheck(start.state, TokenKind.LBrace) ? parseBraceLiteral(start.state) : ExprStep {
    state: parserErrorAt(start.state, parserPeek(start.state), "expected '[' or '{' after '$'")
    expr: emptyExpr()
  }
  ExprStep {
    state: value.state
    expr: opNode(ExprKind.Reactive, "$", start.token, [value.expr])
  }
}

parseBraceLiteral(
  state: ParserState
) -> ExprStep => looksLikeMapLiteralBody(state) ? parseMapLiteral(state) : parseObjectLiteral(state)

parseMapLiteral(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{'")
  parseMapLiteralLoop(parserSkipNewlines(open.state), node(ExprKind.Map, open.token))
}

parseMapLiteralLoop(
  state: ParserState,
  mapExpr: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishMapLiteral(current, mapExpr) : parseMapLiteralEntry(current, mapExpr)
}

parseMapLiteralEntry(
  state: ParserState,
  mapExpr: ParsedExpr
) -> ExprStep => {
  key := parseExpression(state, 1)
  colon := parserConsume(key.state, TokenKind.Colon, "expected ':' after map key")
  value := parseExpression(parserSkipNewlines(colon.state), 1)
  entry := makeExpr(ExprKind.Entry, "", "", "", ":", [], [key.expr, value.expr], key.expr.line, key.expr.column)
  nextMap := appendChild(mapExpr, entry)
  comma := parserMatch(parserSkipNewlines(consumeStatementEnd(value.state)), TokenKind.Comma)
  parseMapLiteralLoop(comma.state, nextMap)
}

finishMapLiteral(
  state: ParserState,
  mapExpr: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after map literal")
  ExprStep {
    state: close.state
    expr: mapExpr
  }
}

parseObjectLiteral(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{'")
  parseObjectLiteralLoop(parserSkipNewlines(open.state), node(ExprKind.Object, open.token))
}

parseObjectLiteralLoop(
  state: ParserState,
  object: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishObjectLiteral(current, object) : parseObjectLiteralMember(current, object)
}

parseObjectLiteralMember(
  state: ParserState,
  object: ParsedExpr
) -> ExprStep => {
  privateStep := parseObjectPrivateModifier(state)
  memberState := privateStep.state
  member := looksLikeFunctionDecl(memberState) ? parseObjectMethod(memberState, privateStep.ok) : parseObjectField(memberState, privateStep.ok)
  nextObject := appendChild(object, member.expr)
  comma := parserMatch(parserSkipNewlines(consumeStatementEnd(member.state)), TokenKind.Comma)
  parseObjectLiteralLoop(comma.state, nextObject)
}

parseObjectMethod(
  state: ParserState,
  private: Bool
) -> ExprStep => {
  fn := parseFunctionWithReceiver(state, "", private)
  ExprStep {
    state: fn.state
    expr: functionToExpr(fn.function)
  }
}

parseObjectField(
  state: ParserState,
  private: Bool
) -> ExprStep => {
  name := parserConsume(state, TokenKind.Ident, "expected field name")
  colon := parserConsume(name.state, TokenKind.Colon, "expected ':' after field name")
  value := parseExpression(parserSkipNewlines(colon.state), 1)
  ExprStep {
    state: value.state
    expr: makeExpr(private ? ExprKind.PrivateField : ExprKind.Field, name.token.lexeme, name.token.lexeme, "", ":", [], [value.expr], name.token.line, name.token.column)
  }
}

finishObjectLiteral(
  state: ParserState,
  object: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after object literal")
  ExprStep {
    state: close.state
    expr: object
  }
}

parseStructLiteral(
  state: ParserState,
  typeExpr: ParsedExpr
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{' after type name")
  parseStructLiteralLoop(parserSkipNewlines(open.state), namedNode(ExprKind.Struct, typeExpr.name, open.token))
}

parseStructLiteralLoop(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishStructLiteral(current, structExpr) : parseStructLiteralField(current, structExpr)
}

parseStructLiteralField(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => {
  name := parserConsume(state, TokenKind.Ident, "expected field name")
  colon := parserConsume(name.state, TokenKind.Colon, "expected ':' after field name")
  value := parseExpression(parserSkipNewlines(colon.state), 1)
  field := makeExpr(ExprKind.Field, name.token.lexeme, name.token.lexeme, "", ":", [], [value.expr], name.token.line, name.token.column)
  nextStruct := appendChild(structExpr, field)
  comma := parserMatch(parserSkipNewlines(consumeStatementEnd(value.state)), TokenKind.Comma)
  parseStructLiteralLoop(comma.state, nextStruct)
}

finishStructLiteral(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after struct literal")
  ExprStep {
    state: close.state
    expr: structExpr
  }
}

parseParenOrTuple(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '('")
  expr := parseExpression(parserSkipNewlines(open.state), 1)
  afterExpr := parserSkipNewlines(expr.state)
  parserCheck(afterExpr, TokenKind.Comma) ? parseTupleAfterFirst(afterExpr, open.token, expr.expr) : finishParenExpression(afterExpr, expr.expr)
}

finishParenExpression(
  state: ParserState,
  expr: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RParen, "expected ')' after expression")
  ExprStep {
    state: close.state
    expr: expr
  }
}

parseTupleAfterFirst(
  state: ParserState,
  open: Token,
  first: ParsedExpr
) -> ExprStep => {
  comma := parserConsume(state, TokenKind.Comma, "expected ','")
  holder := appendChild(node(ExprKind.Tuple, open), first)
  values := parseArgumentListLoop(parserSkipNewlines(comma.state), holder, TokenKind.RParen)
  close := parserConsume(values.state, TokenKind.RParen, "expected ')' after tuple literal")
  ExprStep {
    state: close.state
    expr: values.expr
  }
}

parsePrimaryError(
  state: ParserState
) -> ExprStep => {
  token := parserPeek(state)
  step := parserAdvance(parserErrorAt(state, token, "expected expression, got " + tokenKindName(token.kind)))
  ExprStep {
    state: step.state
    expr: namedNode(ExprKind.Error, "<error>", token)
  }
}

parseLambda(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '(' before lambda parameters")
  params := parseParamList(parserSkipNewlines(open.state))
  close := parserConsume(params.state, TokenKind.RParen, "expected ')' after lambda parameters")
  afterParams := parserSkipNewlines(close.state)
  ret := parserMatch(afterParams, TokenKind.Arrow)
  returnType := ret.ok ? parseTypeRef(parserSkipNewlines(ret.state)) : TypeRefStep {
    state: afterParams
    typeRef: emptyParsedTypeRef()
  }
  arrow := parserConsume(parserSkipNewlines(returnType.state), TokenKind.FatArrow, "expected '=>' after lambda parameter")
  body := parseBody(parserSkipNewlines(arrow.state))
  ExprStep {
    state: body.state
    expr: withChildren(withParams(withText(node(ExprKind.Lambda, open.token), typeRefToString(returnType.typeRef)), params.params), [body.expr])
  }
}

parseMatchExpression(
  state: ParserState,
  subject: ParsedExpr
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{' after match subject")
  block := appendChild(node(ExprKind.Match, open.token), subject)
  parsePatternBlock(parserSkipNewlines(open.state), block)
}

parsePatternBlock(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishPatternBlock(current, block) : parsePatternBranch(current, block)
}

parsePatternBranch(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  pattern := parsePatternText(state)
  arrow := parserConsume(pattern.state, TokenKind.FatArrow, "expected '=>' after pattern")
  value := parseExpression(parserSkipNewlines(arrow.state), 1)
  branch := makeExpr(ExprKind.Branch, pattern.expr.text, "", "", "=>", [], [pattern.expr, value.expr], pattern.expr.line, pattern.expr.column)
  nextBlock := appendChild(block, branch)
  parsePatternBlock(consumeStatementEnd(value.state), nextBlock)
}

finishPatternBlock(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after pattern block")
  ExprStep {
    state: close.state
    expr: block
  }
}

parsePatternText(
  state: ParserState
) -> ExprStep => parsePatternTextLoop(state, "", parserPeek(state), 0, false)

parsePatternTextLoop(
  state: ParserState,
  text: String,
  start: Token,
  depth: Int,
  consumed: Bool
) -> ExprStep => (depth == 0) && (parserCheck(state, TokenKind.FatArrow) || parserCheck(state, TokenKind.EOF)) ? ExprStep {
  state: consumed ? state : parserErrorAt(state, parserPeek(state), "expected pattern")
  expr: withText(node(ExprKind.Pattern, start), text)
} : parsePatternTextToken(state, text, start, depth)

parsePatternTextToken(
  state: ParserState,
  text: String,
  start: Token,
  depth: Int
) -> ExprStep => {
  token := parserPeek(state)
  step := parserAdvance(state)
  parsePatternTextLoop(step.state, text + token.lexeme, start, patternNextDepth(depth, token.kind), true)
}

patternNextDepth(
  depth: Int,
  kind: TokenKind
) -> Int => ((kind == TokenKind.LParen) || (kind == TokenKind.LBracket)) || (kind == TokenKind.LBrace) ? depth + 1 : (((kind == TokenKind.RParen) || (kind == TokenKind.RBracket)) || (kind == TokenKind.RBrace)) && (depth > 0) ? depth - 1 : depth

functionToExpr(
  fn: ParsedFunction
) -> ParsedExpr => makeExpr(fn.private ? ExprKind.PrivateMethod : ExprKind.Method, typeRefToString(fn.returnType), fn.name, "", "=>", fn.params, [fn.body], fn.line, fn.column)

calleeText(expr: ParsedExpr) -> String => expr.name != "" ? expr.name : expr.value != "" ? expr.value : expr.text

precedence(kind: TokenKind) -> Int => (kind == TokenKind.QuestionQuestion) || (kind == TokenKind.OrOr) ? 1 : kind == TokenKind.AndAnd ? 2 : kind == TokenKind.BitOr ? 3 : kind == TokenKind.BitXor ? 4 : kind == TokenKind.BitAnd ? 5 : (kind == TokenKind.EqualEqual) || (kind == TokenKind.BangEqual) ? 6 : ((((kind == TokenKind.DotDotEqual) || (kind == TokenKind.Less)) || (kind == TokenKind.LessEqual)) || (kind == TokenKind.Greater)) || (kind == TokenKind.GreaterEqual) ? 7 : ((kind == TokenKind.ShiftLeft) || (kind == TokenKind.ShiftRight)) || (kind == TokenKind.UnsignedShiftRight) ? 8 : (kind == TokenKind.Plus) || (kind == TokenKind.Minus) ? 9 : ((kind == TokenKind.Star) || (kind == TokenKind.Slash)) || (kind == TokenKind.Percent) ? 10 : 0

skipAnnotations(
  state: ParserState
) -> ParserState => parserCheck(state, TokenKind.At) ? skipAnnotations(skipAnnotation(state)) : state

skipAnnotation(
  state: ParserState
) -> ParserState => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  name := parserConsume(at.state, TokenKind.Ident, "expected annotation name")
  withArgs := parserMatch(name.state, TokenKind.LParen)
  parserSkipNewlines(withArgs.ok ? skipBalanced(withArgs.state, TokenKind.LParen, TokenKind.RParen, 1) : name.state)
}

skipBalanced(
  state: ParserState,
  openKind: TokenKind,
  closeKind: TokenKind,
  depth: Int
) -> ParserState => parserCheck(state, TokenKind.EOF) || (depth <= 0) ? state : skipBalancedStep(state, openKind, closeKind, depth)

skipBalancedStep(
  state: ParserState,
  openKind: TokenKind,
  closeKind: TokenKind,
  depth: Int
) -> ParserState => {
  token := parserPeek(state)
  step := parserAdvance(state)
  nextDepth := token.kind == openKind ? depth + 1 : token.kind == closeKind ? depth - 1 : depth
  skipBalanced(step.state, openKind, closeKind, nextDepth)
}

questionIsPostfixUnwrap(
  state: ParserState
) -> Bool => {
  next := parserKindAt(state, state.current + 1)
  (((((next == TokenKind.EOF) || (next == TokenKind.Newline)) || (next == TokenKind.RParen)) || (next == TokenKind.RBracket)) || (next == TokenKind.RBrace)) || (next == TokenKind.Comma)
}

looksLikeTypeDecl(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.Ident) && (parserKindAt(state, skipNewlinesAt(state, skipGenericNamesAt(state, state.current + 1))) == TokenKind.Colon)

looksLikeFunctionDecl(
  state: ParserState
) -> Bool => {
  start := parserCheck(state, TokenKind.Tilde) ? skipNewlinesAt(state, state.current + 1) : state.current
  (parserKindAt(state, start) == TokenKind.Ident) && looksLikeFunctionAfterName(state, skipGenericNamesAt(state, start + 1))
}

looksLikeFunctionAfterName(
  state: ParserState,
  index: Int
) -> Bool => (parserKindAt(state, index) == TokenKind.LParen) && looksLikeFunctionAfterParams(state, skipBalancedAt(state, index, TokenKind.LParen, TokenKind.RParen))

looksLikeFunctionAfterParams(
  state: ParserState,
  index: Int
) -> Bool => {
  afterParams := skipNewlinesAt(state, index)
  afterReturn := parserKindAt(state, afterParams) == TokenKind.Arrow ? skipTypeNameTokensAt(state, afterParams + 1) : afterParams
  parserKindAt(state, skipNewlinesAt(state, afterReturn)) == TokenKind.FatArrow
}

looksLikeLambda(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.LParen) && looksLikeLambdaAfterParams(state, skipBalancedAt(state, state.current, TokenKind.LParen, TokenKind.RParen))

looksLikeLambdaAfterParams(
  state: ParserState,
  index: Int
) -> Bool => {
  afterParams := skipNewlinesAt(state, index)
  afterReturn := parserKindAt(state, afterParams) == TokenKind.Arrow ? skipTypeNameTokensAt(state, afterParams + 1) : afterParams
  parserKindAt(state, skipNewlinesAt(state, afterReturn)) == TokenKind.FatArrow
}

looksLikeEnumMember(
  state: ParserState
) -> Bool => {
  start := parserCheck(state, TokenKind.Plus) ? skipNewlinesAt(state, state.current + 1) : state.current
  next := parserKindAt(state, skipNewlinesAt(state, start + 1))
  (parserKindAt(state, start) == TokenKind.Ident) && ((next == TokenKind.Assign) || ((next != TokenKind.Colon) && (next != TokenKind.LParen)))
}

looksLikeObjectDestructureDecl(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.LBrace) && scanObjectDestructureDecl(state, skipNewlinesAt(state, state.current + 1))

scanObjectDestructureDecl(
  state: ParserState,
  index: Int
) -> Bool => parserKindAt(state, index) == TokenKind.RBrace ? false : scanObjectDestructureField(state, index)

scanObjectDestructureField(
  state: ParserState,
  index: Int
) -> Bool => parserKindAt(state, index) != TokenKind.Ident ? false : scanObjectDestructureAfterField(state, index + 1)

scanObjectDestructureAfterField(
  state: ParserState,
  index: Int
) -> Bool => parserKindAt(state, index) == TokenKind.Colon ? (parserKindAt(state, skipNewlinesAt(state, index + 1)) == TokenKind.Ident) && scanObjectDestructureAfterName(state, skipNewlinesAt(state, index + 1) + 1) : scanObjectDestructureAfterName(state, index)

scanObjectDestructureAfterName(
  state: ParserState,
  index: Int
) -> Bool => {
  current := skipNewlinesAt(state, index)
  kind := parserKindAt(state, current)
  kind == TokenKind.Comma ? scanObjectDestructureAfterComma(state, skipNewlinesAt(state, current + 1)) : kind == TokenKind.RBrace ? scanObjectDestructureAfterClose(state, current + 1) : false
}

scanObjectDestructureAfterComma(
  state: ParserState,
  index: Int
) -> Bool => parserKindAt(state, index) == TokenKind.RBrace ? scanObjectDestructureAfterClose(state, index + 1) : scanObjectDestructureField(state, index)

scanObjectDestructureAfterClose(
  state: ParserState,
  index: Int
) -> Bool => {
  afterClose := skipNewlinesAt(state, index)
  ((parserKindAt(state, afterClose) == TokenKind.Declare) || (parserKindAt(state, afterClose) == TokenKind.MutDeclare)) || (parserKindAt(state, afterClose) == TokenKind.SignalDeclare)
}

looksLikePatternBranch(
  state: ParserState
) -> Bool => tokensLookLikePatternBranch(state, skipNewlinesAt(state, state.current))

looksLikePatternBlockAfterSubject(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.LBrace) && tokensLookLikePatternBranch(state, skipNewlinesAt(state, state.current + 1))

tokensLookLikePatternBranch(
  state: ParserState,
  index: Int
) -> Bool => {
  afterPattern := skipPatternLookahead(state, index)
  (afterPattern >= 0) && (parserKindAt(state, skipNewlinesAt(state, afterPattern)) == TokenKind.FatArrow)
}

skipPatternLookahead(
  state: ParserState,
  index: Int
) -> Int => skipOrPatternLookahead(state, skipSinglePatternLookahead(state, index))

skipOrPatternLookahead(
  state: ParserState,
  index: Int
) -> Int => (index >= 0) && (parserKindAt(state, index) == TokenKind.BitOr) ? skipOrPatternLookahead(state, skipSinglePatternLookahead(state, index + 1)) : index

skipSinglePatternLookahead(
  state: ParserState,
  index: Int
) -> Int => {
  kind := parserKindAt(state, index)
  after := (((((kind == TokenKind.Underscore) || (kind == TokenKind.Int)) || (kind == TokenKind.Double)) || (kind == TokenKind.BigInt)) || (kind == TokenKind.String)) || (kind == TokenKind.Char) ? index + 1 : kind == TokenKind.Ident ? skipIdentifierPatternLookahead(state, index) : (((kind == TokenKind.Less) || (kind == TokenKind.LessEqual)) || (kind == TokenKind.Greater)) || (kind == TokenKind.GreaterEqual) ? skipComparePatternLookahead(state, index + 1) : kind == TokenKind.LParen ? skipBalancedAt(state, index, TokenKind.LParen, TokenKind.RParen) : kind == TokenKind.LBrace ? skipBalancedAt(state, index, TokenKind.LBrace, TokenKind.RBrace) : -1
  skipRangePatternLookahead(state, after)
}

skipRangePatternLookahead(
  state: ParserState,
  index: Int
) -> Int => (index >= 0) && (parserKindAt(state, index) == TokenKind.DotDotEqual) ? skipRangePatternEnd(state, index + 1) : index

skipRangePatternEnd(
  state: ParserState,
  index: Int
) -> Int => {
  kind := parserKindAt(state, index)
  (((((kind == TokenKind.Int) || (kind == TokenKind.Double)) || (kind == TokenKind.BigInt)) || (kind == TokenKind.String)) || (kind == TokenKind.Char)) || (kind == TokenKind.Ident) ? index + 1 : -1
}

skipIdentifierPatternLookahead(
  state: ParserState,
  index: Int
) -> Int => parserKindAt(state, index + 1) == TokenKind.LParen ? skipBalancedAt(state, index + 1, TokenKind.LParen, TokenKind.RParen) : (parserKindAt(state, index + 1) == TokenKind.Dot) && (parserKindAt(state, index + 2) == TokenKind.Ident) ? index + 3 : isLiteralIdentifier(parserTokenAt(state, index).lexeme) ? index + 1 : -1

skipComparePatternLookahead(
  state: ParserState,
  index: Int
) -> Int => {
  kind := parserKindAt(state, index)
  (((((kind == TokenKind.Int) || (kind == TokenKind.Double)) || (kind == TokenKind.BigInt)) || (kind == TokenKind.String)) || (kind == TokenKind.Char)) || (kind == TokenKind.Ident) ? index + 1 : -1
}

looksLikeMapLiteralBody(
  state: ParserState
) -> Bool => {
  start := skipNewlinesAt(state, state.current + 1)
  first := parserTokenAt(state, start)
  (first.kind == TokenKind.EOF) || (first.kind == TokenKind.RBrace) ? false : (first.kind == TokenKind.Ident) && (isLiteralIdentifier(first.lexeme) == false) ? false : scanMapLiteralColon(state, start, 0)
}

scanMapLiteralColon(
  state: ParserState,
  index: Int,
  depth: Int
) -> Bool => {
  kind := parserKindAt(state, index)
  kind == TokenKind.EOF ? false : ((kind == TokenKind.LParen) || (kind == TokenKind.LBracket)) || (kind == TokenKind.LBrace) ? scanMapLiteralColon(state, index + 1, depth + 1) : (kind == TokenKind.RParen) || (kind == TokenKind.RBracket) ? scanMapLiteralColon(state, index + 1, depth > 0 ? depth - 1 : depth) : kind == TokenKind.RBrace ? depth == 0 ? false : scanMapLiteralColon(state, index + 1, depth - 1) : (((kind == TokenKind.Newline) || (kind == TokenKind.Question)) || (kind == TokenKind.FatArrow)) && (depth == 0) ? false : (kind == TokenKind.Colon) && (depth == 0) ? true : scanMapLiteralColon(state, index + 1, depth)
}

isLiteralIdentifier(
  name: String
) -> Bool => ((name == "true") || (name == "false")) || (name == "null")

skipNewlinesAt(
  state: ParserState,
  index: Int
) -> Int => parserKindAt(state, index) == TokenKind.Newline ? skipNewlinesAt(state, index + 1) : index

skipGenericNamesAt(
  state: ParserState,
  index: Int
) -> Int => parserKindAt(state, index) == TokenKind.LBracket ? skipBalancedAt(state, index, TokenKind.LBracket, TokenKind.RBracket) : index

skipBalancedAt(
  state: ParserState,
  index: Int,
  openKind: TokenKind,
  closeKind: TokenKind
) -> Int => skipBalancedAtLoop(state, index, openKind, closeKind, 0)

skipBalancedAtLoop(
  state: ParserState,
  index: Int,
  openKind: TokenKind,
  closeKind: TokenKind,
  depth: Int
) -> Int => {
  kind := parserKindAt(state, index)
  kind == TokenKind.EOF ? index : kind == openKind ? skipBalancedAtLoop(state, index + 1, openKind, closeKind, depth + 1) : kind == closeKind ? depth <= 1 ? index + 1 : skipBalancedAtLoop(state, index + 1, openKind, closeKind, depth - 1) : skipBalancedAtLoop(state, index + 1, openKind, closeKind, depth)
}

skipTypeNameTokensAt(
  state: ParserState,
  index: Int
) -> Int => skipTypeNameTokensAtLoop(state, index, 0)

skipTypeNameTokensAtLoop(
  state: ParserState,
  index: Int,
  depth: Int
) -> Int => {
  kind := parserKindAt(state, index)
  ((((((kind == TokenKind.Ident) || (kind == TokenKind.Comma)) || (kind == TokenKind.Colon)) || (kind == TokenKind.Question)) || (kind == TokenKind.Arrow)) || (kind == TokenKind.At)) || (kind == TokenKind.Dot) ? skipTypeNameTokensAtLoop(state, index + 1, depth) : (kind == TokenKind.LBracket) || (kind == TokenKind.LParen) ? skipTypeNameTokensAtLoop(state, index + 1, depth + 1) : (kind == TokenKind.RBracket) || (kind == TokenKind.RParen) ? depth == 0 ? index : skipTypeNameTokensAtLoop(state, index + 1, depth - 1) : index
}
