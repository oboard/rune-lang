@"../lexer/lexer.rn"
@"ast.rn"

ParserState: {
  tokens: Array[Token]
  current: Int
  errors: Array[ParseError]
}

TokenStep: {
  state: ParserState
  token: Token
}

BoolStep: {
  state: ParserState
  ok: Bool
}

StringStep: {
  state: ParserState
  value: String
}

TypeRefStep: {
  state: ParserState
  typeRef: ParsedTypeRef
}

TypeRefListStep: {
  state: ParserState
  refs: Array[ParsedTypeRef]
}

TypeParamStep: {
  state: ParserState
  param: ParsedTypeParam
}

TypeParamListStep: {
  state: ParserState
  params: Array[ParsedTypeParam]
}

StringListStep: {
  state: ParserState
  values: Array[String]
}

AnnotationListStep: {
  state: ParserState
  annotations: Array[ParsedAnnotation]
}

ParamListStep: {
  state: ParserState
  params: Array[ParsedParam]
}

ExprStep: {
  state: ParserState
  expr: ParsedExpr
}

TemplateParse: {
  text: String
  children: Array[ParsedExpr]
}

FileStep: {
  state: ParserState
  file: ParsedFile
}

ImportStep: {
  state: ParserState
  importDecl: ParsedImport
}

FunctionStep: {
  state: ParserState
  function: ParsedFunction
}

TypeStep: {
  state: ParserState
  typeDecl: ParsedType
}

TestStep: {
  state: ParserState
  testDecl: ParsedTest
}

FieldStep: {
  state: ParserState
  field: ParsedField
}

EnumMemberStep: {
  state: ParserState
  member: ParsedEnumMember
}

+ parse(source: String) -> ParsedFile => parseTokens(lex(source))

+ parseTokens(
  tokens: Array[Token]
) -> ParsedFile => {
  errors := emptyParseErrors()
  parseFileLoop(parserSkipNewlines(ParserState {
    tokens: tokens,
    current: 0,
    errors: errors
  }), emptyFile(errors)).file
}

emptyFile(
  errors: Array[ParseError]
) -> ParsedFile => {
  imports: [],
  types: [],
  functions: [],
  tests: [],
  errors: errors
}

emptyParseErrors() -> Array[ParseError] => [ParseError {
  message: "",
  line: 0,
  column: 0
}].slice(0, 0)

emptyToken() -> Token => {
  kind: TokenKind.EOF,
  lexeme: "",
  offset: 0,
  line: 0,
  column: 0
}

emptyExpr() -> ParsedExpr => {
  kind: ExprKind.Unknown,
  text: "",
  name: "",
  value: "",
  op: "",
  params: [],
  children: [],
  line: 0,
  column: 0
}

emptyAnnotations() -> Array[ParsedAnnotation] => [ParsedAnnotation {
  marker: "",
  module: "",
  name: "",
  args: [],
  line: 0,
  column: 0
}].slice(0, 0)

emptyFunction() -> ParsedFunction => {
  name: "",
  private: true,
  static: false,
  routine: false,
  macro: false,
  annotations: emptyAnnotations(),
  receiverType: "",
  generics: [],
  params: [],
  returnType: emptyParsedTypeRef(),
  body: emptyExpr(),
  line: 0,
  column: 0
}

emptyType() -> ParsedType => {
  name: "",
  private: true,
  enum: false,
  annotations: emptyAnnotations(),
  generics: [],
  fields: [],
  methods: [],
  members: [],
  line: 0,
  column: 0
}

emptyImport() -> ParsedImport => {
  path: "",
  go: false,
  line: 0,
  column: 0
}

emptyTest() -> ParsedTest => {
  name: "",
  body: emptyExpr(),
  line: 0,
  column: 0
}

emptyField() -> ParsedField => {
  name: "",
  private: true,
  annotations: emptyAnnotations(),
  typeRef: emptyParsedTypeRef(),
  line: 0,
  column: 0
}

emptyMember() -> ParsedEnumMember => {
  name: "",
  private: true,
  annotations: emptyAnnotations(),
  value: "",
  params: [],
  line: 0,
  column: 0
}

makeExpr(
  kind: ExprKind,
  text: String,
  name: String,
  value: String,
  op: String,
  params: Array[ParsedParam],
  children: Array[ParsedExpr],
  line: Int,
  column: Int
) -> ParsedExpr => {
  kind: kind,
  text: text,
  name: name,
  value: value,
  op: op,
  params: params,
  children: children,
  line: line,
  column: column
}

node(
  kind: ExprKind,
  token: Token
) -> ParsedExpr => makeExpr(kind, token.lexeme, "", "", "", [], [], token.line, token.column)

namedNode(
  kind: ExprKind,
  name: String,
  token: Token
) -> ParsedExpr => makeExpr(kind, token.lexeme, name, "", "", [], [], token.line, token.column)

valueNode(
  kind: ExprKind,
  value: String,
  token: Token
) -> ParsedExpr => makeExpr(kind, token.lexeme, "", value, "", [], [], token.line, token.column)

opNode(
  kind: ExprKind,
  op: String,
  token: Token,
  children: Array[ParsedExpr]
) -> ParsedExpr => makeExpr(kind, token.lexeme, "", "", op, [], children, token.line, token.column)

withChildren(
  expr: ParsedExpr,
  children: Array[ParsedExpr]
) -> ParsedExpr => makeExpr(expr.kind, expr.text, expr.name, expr.value, expr.op, expr.params, children, expr.line, expr.column)

withParams(
  expr: ParsedExpr,
  params: Array[ParsedParam]
) -> ParsedExpr => makeExpr(expr.kind, expr.text, expr.name, expr.value, expr.op, params, expr.children, expr.line, expr.column)

withText(
  expr: ParsedExpr,
  text: String
) -> ParsedExpr => makeExpr(expr.kind, text, expr.name, expr.value, expr.op, expr.params, expr.children, expr.line, expr.column)

appendChild(
  expr: ParsedExpr,
  child: ParsedExpr
) -> ParsedExpr => {
  expr.children.push(child)
  expr
}

appendParam(
  params: Array[ParsedParam],
  param: ParsedParam
) -> Array[ParsedParam] => {
  params.push(param)
  params
}

appendString(
  values: Array[String],
  value: String
) -> Array[String] => {
  values.push(value)
  values
}

parserPeek(state: ParserState) -> Token => (
  state.current >= state.tokens.length() ? emptyToken()
    : state.tokens[state.current]
)

parserPrevious(
  state: ParserState
) -> Token => (
  state.current <= 0 ? emptyToken()
    : state.tokens[state.current - 1]
)

parserTokenAt(
  state: ParserState,
  index: Int
) -> Token => (
  index >= state.tokens.length() ? emptyToken()
    : state.tokens[index]
)

parserKindAt(
  state: ParserState,
  index: Int
) -> TokenKind => parserTokenAt(state, index).kind

parserCheck(
  state: ParserState,
  kind: TokenKind
) -> Bool => parserPeek(state).kind == kind

parserCheckNext(
  state: ParserState,
  kind: TokenKind
) -> Bool => parserKindAt(state, state.current + 1) == kind

stateAt(
  state: ParserState,
  current: Int
) -> ParserState => {
  tokens: state.tokens,
  current: current,
  errors: state.errors
}

parserAdvance(
  state: ParserState
) -> TokenStep => (
  parserCheck(state, TokenKind.EOF) ? TokenStep {
    state: state,
    token: parserPeek(state)
  }
    : TokenStep {
      state: stateAt(state, state.current + 1),
      token: parserPeek(state)
    }
)

parserMatch(
  state: ParserState,
  kind: TokenKind
) -> BoolStep => (
  parserCheck(state, kind) ? BoolStep {
    state: parserAdvance(state).state,
    ok: true
  }
    : BoolStep {
      state: state,
      ok: false
    }
)

parserConsume(
  state: ParserState,
  kind: TokenKind,
  message: String
) -> TokenStep => (
  parserCheck(state, kind) ? parserAdvance(state)
    : parserConsumeMissing(parserErrorAt(state, parserPeek(state), message))
)

parserConsumeMissing(
  state: ParserState
) -> TokenStep => (
  parserCheck(state, TokenKind.EOF) ? TokenStep {
    state: state,
    token: parserPeek(state)
  }
    : parserAdvance(state)
)

parserErrorAt(
  state: ParserState,
  token: Token,
  message: String
) -> ParserState => {
  tokens: state.tokens,
  current: state.current,
  errors: appendParseError(state.errors, ParseError {
    message: message,
    line: token.line,
    column: token.column
  })
}

appendParseError(
  errors: Array[ParseError],
  error: ParseError
) -> Array[ParseError] => {
  out := errors
  out.push(error)
  out
}

parserSkipNewlines(
  state: ParserState
) -> ParserState => (
  parserCheck(state, TokenKind.Newline) ? parserSkipNewlines(parserAdvance(state).state)
    : state
)

consumeStatementEnd(
  state: ParserState
) -> ParserState => (
  parserMatch(state, TokenKind.Newline).ok ? parserSkipNewlines(parserAdvance(state).state)
    : state
)

consumeFieldSeparator(
  state: ParserState,
  close: TokenKind,
  message: String
) -> ParserState => {
  current := consumeStatementEnd(state)
  comma := parserMatch(current, TokenKind.Comma)
  (
    parserCheck(current, close) || parserCheck(current, TokenKind.EOF) ? current
      : (
        comma.ok ? parserSkipNewlines(comma.state)
          : parserErrorAt(current, parserPeek(current), message)
      )
  )
}

unquote(raw: String) -> String => (
  raw.length() >= 2 ? raw.slice(1, raw.length() - 1)
    : raw
)

parseFileLoop(
  state: ParserState,
  file: ParsedFile
) -> FileStep => (
  parserCheck(state, TokenKind.EOF) ? FileStep {
    state: state,
    file: withFileErrors(file, state.errors)
  }
    : parseTopLevel(state, file)
)

withFileErrors(
  file: ParsedFile,
  errors: Array[ParseError]
) -> ParsedFile => {
  imports: file.imports,
  types: file.types,
  functions: file.functions,
  tests: file.tests,
  errors: errors
}

parseTopLevel(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  (
    looksLikeMacroFunctionDecl(state) ? parseTopLevelAfterResult(parseMacroFunction(state, file))
      : parseTopLevelAfterMacro(state, file)
  )
}

parseTopLevelAfterResult(
  result: FileStep
) -> FileStep => parseFileLoop(parserSkipNewlines(result.state), result.file)

parseTopLevelAfterMacro(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  annotationStep := parseAnnotations(state)
  publicStep := parsePublicModifier(annotationStep.state)
  current :=: publicStep.state
  private := publicStep.ok == false
  current = (
    publicStep.ok && (parserCheck(current, TokenKind.At) || parserCheck(current, TokenKind.Question)) ? parserErrorAt(current, parserPeek(current), "expected public declaration after '+'")
      : current
  )
  result := (
    !publicStep.ok && parserCheck(current, TokenKind.At) ? parseTopLevelImport(current, file)
      : (
        !publicStep.ok && parserCheck(current, TokenKind.Question) ? parseTopLevelTest(current, file)
          : (
            looksLikeTypeDecl(current) ? parseTopLevelType(current, file, private, annotationStep.annotations)
              : (
                looksLikeFunctionDecl(current) ? parseTopLevelFunction(current, file, private, annotationStep.annotations)
                  : parseTopLevelError(current, file)
              )
          )
      )
  )
  parseFileLoop(parserSkipNewlines(result.state), result.file)
}

parseMacroFunction(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  marker := parserConsume(state, TokenKind.Hash, "expected '#' before macro function")
  step := parseFunctionWithReceiver(marker.state, "", false, false, true, emptyAnnotations())
  file.functions.push(step.function)
  FileStep {
    state: step.state,
    file: file
  }
}

parseTopLevelImport(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  step := (
    parserCheckNext(state, TokenKind.String) ? parseImportDecl(state)
      : parseGoImportDecl(state)
  )
  file.imports.push(step.importDecl)
  FileStep {
    state: step.state,
    file: file
  }
}

parseTopLevelTest(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  step := parseTestDecl(state)
  file.tests.push(step.testDecl)
  FileStep {
    state: step.state,
    file: file
  }
}

parseTopLevelType(
  state: ParserState,
  file: ParsedFile,
  private: Bool,
  annotations: Array[ParsedAnnotation]
) -> FileStep => {
  step := parseTypeDecl(state, private, annotations)
  file.types.push(step.typeDecl)
  FileStep {
    state: step.state,
    file: file
  }
}

parseTopLevelFunction(
  state: ParserState,
  file: ParsedFile,
  private: Bool,
  annotations: Array[ParsedAnnotation]
) -> FileStep => {
  step := parseFunctionWithReceiver(state, "", private, false, false, annotations)
  file.functions.push(step.function)
  FileStep {
    state: step.state,
    file: file
  }
}

parseTopLevelError(
  state: ParserState,
  file: ParsedFile
) -> FileStep => {
  state: parserAdvance(parserErrorAt(state, parserPeek(state), "expected declaration")).state,
  file: file
}

parsePublicModifier(
  state: ParserState
) -> BoolStep => {
  step := parserMatch(state, TokenKind.Plus)
  BoolStep {
    state: (
      step.ok ? parserSkipNewlines(step.state)
        : state
    ),
    ok: step.ok
  }
}

parseObjectPrivateModifier(
  state: ParserState
) -> BoolStep => {
  step := parserMatch(state, TokenKind.Minus)
  BoolStep {
    state: (
      step.ok ? parserSkipNewlines(step.state)
        : state
    ),
    ok: step.ok
  }
}

parseStaticMethodMarker(
  state: ParserState
) -> BoolStep => {
  marker := (
    parserCheck(state, TokenKind.DoubleColon) ? parserMatch(state, TokenKind.DoubleColon)
      : (
        parserCheck(state, TokenKind.Ident) && (parserPeek(state).lexeme == "static") ? BoolStep {
          state: parserAdvance(state).state,
          ok: true
        }
          : BoolStep {
            state: state,
            ok: false
          }
      )
  )
  BoolStep {
    state: (
      marker.ok ? parserSkipNewlines(marker.state)
        : state
    ),
    ok: marker.ok
  }
}

parseImportDecl(
  state: ParserState
) -> ImportStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  path := parserConsume(at.state, TokenKind.String, "expected import path string after '@'")
  ImportStep {
    state: path.state,
    importDecl: ParsedImport {
      path: unquote(path.token.lexeme),
      go: false,
      line: at.token.line,
      column: at.token.column
    }
  }
}

parseGoImportDecl(
  state: ParserState
) -> ImportStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  module := parserConsume(at.state, TokenKind.Ident, "expected module name after '@'")
  checked := (
    module.token.lexeme == "go" ? module.state
      : parserErrorAt(module.state, module.token, "only @go.import can appear at the top level")
  )
  dot := parserConsume(checked, TokenKind.Dot, "expected '.' after @go")
  name := parserConsume(dot.state, TokenKind.Ident, "expected import after @go.")
  checkedName := (
    name.token.lexeme == "import" ? name.state
      : parserErrorAt(name.state, name.token, "only @go.import can appear at the top level")
  )
  open := parserConsume(checkedName, TokenKind.LParen, "expected '(' after @go.import")
  path := parserConsume(open.state, TokenKind.String, "expected Go import path string")
  close := parserConsume(path.state, TokenKind.RParen, "expected ')' after @go.import")
  ImportStep {
    state: close.state,
    importDecl: ParsedImport {
      path: unquote(path.token.lexeme),
      go: true,
      line: at.token.line,
      column: at.token.column
    }
  }
}

parseTestDecl(
  state: ParserState
) -> TestStep => {
  start := parserConsume(state, TokenKind.Question, "expected '?'")
  name := parserConsume(start.state, TokenKind.String, "expected test name string after '?'")
  bodyStart := parserSkipNewlines(name.state)
  body := (
    parserCheck(bodyStart, TokenKind.LBrace) ? parseBlock(bodyStart)
      : ExprStep {
        state: parserErrorAt(bodyStart, parserPeek(bodyStart), "expected test body block"),
        expr: emptyExpr()
      }
  )
  TestStep {
    state: body.state,
    testDecl: ParsedTest {
      name: unquote(name.token.lexeme),
      body: body.expr,
      line: start.token.line,
      column: start.token.column
    }
  }
}

parseTypeDecl(
  state: ParserState,
  private: Bool,
  annotations: Array[ParsedAnnotation]
) -> TypeStep => {
  name := parserConsume(state, TokenKind.Ident, "expected type name")
  generics := parseGenericNames(name.state)
  colon := parserConsume(generics.state, TokenKind.Colon, "expected ':' after type name")
  openStart := parserSkipNewlines(colon.state)
  open := parserConsume(openStart, TokenKind.LBrace, "expected '{' after type declaration")
  bodyStart := parserSkipNewlines(open.state)
  (
    looksLikeEnumMember(bodyStart) ? parseEnumTypeBody(bodyStart, name.token, private, annotations, generics.values)
      : parseStructTypeBody(bodyStart, name.token, private, annotations, generics.values)
  )
}

parseStructTypeBody(
  state: ParserState,
  name: Token,
  private: Bool,
  annotations: Array[ParsedAnnotation],
  generics: Array[String]
) -> TypeStep => parseStructTypeLoop(state, ParsedType {
  name: name.lexeme,
  private: private,
  enum: false,
  annotations: annotations,
  generics: generics,
  fields: [],
  methods: [],
  members: [],
  line: name.line,
  column: name.column
})

parseStructTypeLoop(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishType(current, typeDecl, "expected '}' after type declaration")
      : parseStructTypeMember(current, typeDecl)
  )
}

parseStructTypeMember(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  annotationStep := parseAnnotations(state)
  current := annotationStep.state
  privateStep := parseObjectPrivateModifier(current)
  memberState := privateStep.state
  private := privateStep.ok
  staticStep := (
    looksLikeStaticFunctionDecl(memberState) ? parseStaticMethodMarker(memberState)
      : BoolStep {
        state: memberState,
        ok: false
      }
  )
  parsed := (
    looksLikeFunctionDecl(staticStep.state) ? parseStructMethod(staticStep.state, typeDecl, private, staticStep.ok, annotationStep.annotations)
      : parseStructField(staticStep.state, typeDecl, private, annotationStep.annotations)
  )
  next := parserSkipNewlines(parserMatch(consumeStatementEnd(parsed.state), TokenKind.Comma).state)
  parseStructTypeLoop(next, parsed.typeDecl)
}

parseStructMethod(
  state: ParserState,
  typeDecl: ParsedType,
  private: Bool,
  static: Bool,
  annotations: Array[ParsedAnnotation]
) -> TypeStep => {
  step := parseFunctionWithReceiver(state, typeDecl.name, private, static, false, annotations)
  typeDecl.methods.push(step.function)
  TypeStep {
    state: step.state,
    typeDecl: typeDecl
  }
}

parseStructField(
  state: ParserState,
  typeDecl: ParsedType,
  private: Bool,
  annotations: Array[ParsedAnnotation]
) -> TypeStep => {
  field := parseFieldDecl(state, private, annotations)
  typeDecl.fields.push(field.field)
  TypeStep {
    state: field.state,
    typeDecl: typeDecl
  }
}

parseFieldDecl(
  state: ParserState,
  private: Bool,
  annotations: Array[ParsedAnnotation]
) -> FieldStep => {
  name := parserConsume(state, TokenKind.Ident, "expected field name")
  colon := parserConsume(name.state, TokenKind.Colon, "expected ':' after field name")
  typeRef := parseTypeRef(colon.state)
  FieldStep {
    state: typeRef.state,
    field: ParsedField {
      name: name.token.lexeme,
      private: private,
      annotations: annotations,
      typeRef: typeRef.typeRef,
      line: name.token.line,
      column: name.token.column
    }
  }
}

finishType(
  state: ParserState,
  typeDecl: ParsedType,
  message: String
) -> TypeStep => {
  close := parserConsume(state, TokenKind.RBrace, message)
  TypeStep {
    state: close.state,
    typeDecl: typeDecl
  }
}

parseEnumTypeBody(
  state: ParserState,
  name: Token,
  private: Bool,
  annotations: Array[ParsedAnnotation],
  generics: Array[String]
) -> TypeStep => parseEnumTypeLoop(state, ParsedType {
  name: name.lexeme,
  private: private,
  enum: true,
  annotations: annotations,
  generics: generics,
  fields: [],
  methods: [],
  members: [],
  line: name.line,
  column: name.column
})

parseEnumTypeLoop(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishType(current, typeDecl, "expected '}' after enum declaration")
      : parseEnumTypeMember(current, typeDecl)
  )
}

parseEnumTypeMember(
  state: ParserState,
  typeDecl: ParsedType
) -> TypeStep => {
  annotationStep := parseAnnotations(state)
  current := annotationStep.state
  privateStep := parseObjectPrivateModifier(current)
  memberState := privateStep.state
  staticStep := (
    looksLikeStaticFunctionDecl(memberState) ? parseStaticMethodMarker(memberState)
      : BoolStep {
        state: memberState,
        ok: false
      }
  )
  parsed := (
    looksLikeFunctionDecl(staticStep.state) ? parseEnumMethod(staticStep.state, typeDecl, privateStep.ok, staticStep.ok, annotationStep.annotations)
      : parseEnumTypeMemberValue(current, typeDecl, annotationStep.annotations)
  )
  next := parserSkipNewlines(parserMatch(consumeStatementEnd(parsed.state), TokenKind.Comma).state)
  parseEnumTypeLoop(next, parsed.typeDecl)
}

parseEnumMethod(
  state: ParserState,
  typeDecl: ParsedType,
  private: Bool,
  static: Bool,
  annotations: Array[ParsedAnnotation]
) -> TypeStep => {
  step := parseFunctionWithReceiver(state, typeDecl.name, private, static, false, annotations)
  typeDecl.methods.push(step.function)
  TypeStep {
    state: step.state,
    typeDecl: typeDecl
  }
}

parseEnumTypeMemberValue(
  state: ParserState,
  typeDecl: ParsedType,
  annotations: Array[ParsedAnnotation]
) -> TypeStep => {
  member := parseEnumMember(state, annotations)
  typeDecl.members.push(member.member)
  TypeStep {
    state: member.state,
    typeDecl: typeDecl
  }
}

parseEnumMember(
  state: ParserState,
  annotations: Array[ParsedAnnotation]
) -> EnumMemberStep => {
  publicStep := parsePublicModifier(state)
  name := parserConsume(publicStep.state, TokenKind.Ident, "expected enum member name")
  current := parserSkipNewlines(name.state)
  parsed := parseEnumMemberPayload(current)
  EnumMemberStep {
    state: parsed.state,
    member: ParsedEnumMember {
      name: name.token.lexeme,
      private: false,
      annotations: annotations,
      value: parsed.value,
      params: parsed.params,
      line: name.token.line,
      column: name.token.column
    }
  }
}

parseEnumMemberPayload(
  state: ParserState
) -> EnumMemberPayloadStep => {
  assign := parserMatch(state, TokenKind.Assign)
  (
    assign.ok ? parseEnumMemberValue(parserSkipNewlines(assign.state))
      : parseEnumMemberParams(state)
  )
}

EnumMemberPayloadStep: {
  state: ParserState
  value: String
  params: Array[ParsedParam]
}

parseEnumMemberValue(
  state: ParserState
) -> EnumMemberPayloadStep => {
  value := parseEnumValue(state)
  EnumMemberPayloadStep {
    state: value.state,
    value: value.value,
    params: []
  }
}

parseEnumMemberParams(
  state: ParserState
) -> EnumMemberPayloadStep => {
  open := parserMatch(state, TokenKind.LParen)
  (
    open.ok ? parseEnumMemberParamList(parserSkipNewlines(open.state))
      : EnumMemberPayloadStep {
        state: state,
        value: "",
        params: []
      }
  )
}

parseEnumMemberParamList(
  state: ParserState
) -> EnumMemberPayloadStep => {
  params := parseParamList(state)
  close := parserConsume(params.state, TokenKind.RParen, "expected ')' after enum constructor parameters")
  EnumMemberPayloadStep {
    state: close.state,
    value: "",
    params: params.params
  }
}

parseEnumValue(
  state: ParserState
) -> StringStep => (
  parserCheck(state, TokenKind.Minus) ? parseNegativeEnumValue(state)
    : parsePositiveEnumValue(state)
)

parseNegativeEnumValue(
  state: ParserState
) -> StringStep => {
  minus := parserAdvance(state)
  value := parserConsume(minus.state, TokenKind.Int, "expected integer enum value")
  StringStep {
    state: value.state,
    value: "-" + value.token.lexeme
  }
}

parsePositiveEnumValue(
  state: ParserState
) -> StringStep => {
  value := parserConsume(state, TokenKind.Int, "expected integer enum value")
  StringStep {
    state: value.state,
    value: value.token.lexeme
  }
}

parseFunctionWithReceiver(
  state: ParserState,
  receiverType: String,
  private: Bool,
  static: Bool,
  macro: Bool,
  annotations: Array[ParsedAnnotation]
) -> FunctionStep => {
  routineStep := parserMatch(state, TokenKind.Tilde)
  afterRoutine := (
    routineStep.ok ? parserSkipNewlines(routineStep.state)
      : state
  )
  name := parserConsume(afterRoutine, TokenKind.Ident, "expected function name")
  generics := parseGenericNames(name.state)
  open := parserConsume(generics.state, TokenKind.LParen, "expected '(' after function name")
  params := parseParamList(parserSkipNewlines(open.state))
  close := parserConsume(params.state, TokenKind.RParen, "expected ')' after parameter list")
  afterClose := parserSkipNewlines(close.state)
  ret := parserMatch(afterClose, TokenKind.Arrow)
  returnType := (
    ret.ok ? parseTypeRef(parserSkipNewlines(ret.state))
      : TypeRefStep {
        state: afterClose,
        typeRef: emptyParsedTypeRef()
      }
  )
  arrow := parserConsume(parserSkipNewlines(returnType.state), TokenKind.FatArrow, "expected '=>' after function signature")
  body := parseBody(parserSkipNewlines(arrow.state))
  FunctionStep {
    state: body.state,
    function: ParsedFunction {
      name: name.token.lexeme,
      private: private,
      static: static,
      routine: routineStep.ok,
      macro: macro,
      annotations: annotations,
      receiverType: receiverType,
      generics: generics.values,
      params: params.params,
      returnType: returnType.typeRef,
      body: body.expr,
      line: name.token.line,
      column: name.token.column
    }
  }
}

parseParamList(
  state: ParserState
) -> ParamListStep => parseParamListLoop(state, [])

parseParamListLoop(
  state: ParserState,
  params: Array[ParsedParam]
) -> ParamListStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RParen) || parserCheck(current, TokenKind.EOF) ? ParamListStep {
      state: current,
      params: params
    }
      : parseOneParam(current, params)
  )
}

parseOneParam(
  state: ParserState,
  params: Array[ParsedParam]
) -> ParamListStep => {
  name := parserConsume(state, TokenKind.Ident, "expected parameter name")
  optional := parserMatch(name.state, TokenKind.Question)
  colon := parserMatch(optional.state, TokenKind.Colon)
  typeRef := (
    colon.ok ? parseTypeRef(colon.state)
      : TypeRefStep {
        state: optional.state,
        typeRef: emptyParsedTypeRef()
      }
  )
  paramName := (
    optional.ok ? name.token.lexeme + "?"
      : name.token.lexeme
  )
  params.push(ParsedParam {
    name: paramName,
    typeRef: typeRef.typeRef,
    line: name.token.line,
    column: name.token.column
  })
  comma := parserMatch(parserSkipNewlines(typeRef.state), TokenKind.Comma)
  parseParamListLoop(comma.state, params)
}

parseGenericNames(
  state: ParserState
) -> StringListStep => {
  open := parserMatch(state, TokenKind.LBracket)
  (
    open.ok ? parseGenericNameLoop(parserSkipNewlines(open.state), [])
      : StringListStep {
        state: state,
        values: []
      }
  )
}

parseGenericNameLoop(
  state: ParserState,
  values: Array[String]
) -> StringListStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBracket) || parserCheck(current, TokenKind.EOF) ? finishGenericNames(current, values)
      : parseGenericNameValue(current, values)
  )
}

finishGenericNames(
  state: ParserState,
  values: Array[String]
) -> StringListStep => {
  close := parserConsume(state, TokenKind.RBracket, "expected ']' after generic parameters")
  StringListStep {
    state: close.state,
    values: values
  }
}

parseGenericNameValue(
  state: ParserState,
  values: Array[String]
) -> StringListStep => {
  nameStep := (
    parserCheck(state, TokenKind.Ident) ? appendGenericName(state, values)
      : StringListStep {
        state: parserAdvance(state).state,
        values: values
      }
  )
  colon := parserMatch(parserSkipNewlines(nameStep.state), TokenKind.Colon)
  current := (
    colon.ok ? parseTypeRef(parserSkipNewlines(colon.state)).state
      : nameStep.state
  )
  comma := parserMatch(parserSkipNewlines(current), TokenKind.Comma)
  parseGenericNameLoop(comma.state, nameStep.values)
}

appendGenericName(
  state: ParserState,
  values: Array[String]
) -> StringListStep => {
  step := parserAdvance(state)
  StringListStep {
    state: step.state,
    values: appendString(values, step.token.lexeme)
  }
}

parseTypeRef(
  state: ParserState
) -> TypeRefStep => parseTypeRefPostfix(parseTypeRefAtom(parserSkipNewlines(state)))

parseTypeRefAtom(
  state: ParserState
) -> TypeRefStep => (
  parserCheck(state, TokenKind.LParen) ? parseParenTypeRef(state)
    : (
      parserCheck(state, TokenKind.At) ? parseQualifiedTypeRef(state)
        : (
          parserCheck(state, TokenKind.Ident) ? parseNamedTypeRef(state)
            : parseTypeRefError(state)
        )
    )
)

parseNamedTypeRef(
  state: ParserState
) -> TypeRefStep => {
  name := parserConsume(state, TokenKind.Ident, "expected type name")
  TypeRefStep {
    state: name.state,
    typeRef: namedParsedTypeRef(name.token)
  }
}

parseQualifiedTypeRef(
  state: ParserState
) -> TypeRefStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  module := parserConsume(at.state, TokenKind.Ident, "expected module name after '@'")
  dot := parserConsume(module.state, TokenKind.Dot, "expected '.' after module name")
  name := parserConsume(dot.state, TokenKind.Ident, "expected type name after module qualifier")
  TypeRefStep {
    state: name.state,
    typeRef: qualifiedParsedTypeRef(module.token, name.token)
  }
}

parseParenTypeRef(
  state: ParserState
) -> TypeRefStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '(' before type")
  params := parseTypeParamList(parserSkipNewlines(open.state), [])
  close := parserConsume(params.state, TokenKind.RParen, "expected ')' after type")
  afterClose := parserSkipNewlines(close.state)
  arrow := parserMatch(afterClose, TokenKind.Arrow)
  (
    arrow.ok ? finishFunctionTypeRef(parserSkipNewlines(arrow.state), open.token, params.params)
      : finishParenTypeRef(close.state, open.token, params.params)
  )
}

finishFunctionTypeRef(
  state: ParserState,
  token: Token,
  params: Array[ParsedTypeParam]
) -> TypeRefStep => {
  ret := parseTypeRef(state)
  TypeRefStep {
    state: ret.state,
    typeRef: functionTypeRef(params, ret.typeRef, token)
  }
}

finishParenTypeRef(
  state: ParserState,
  token: Token,
  params: Array[ParsedTypeParam]
) -> TypeRefStep => {
  state: state,
  typeRef: (
    (params.length() == 1) && (params[0].name == "") ? groupedTypeRef(params[0].typeRef, token)
      : tupleTypeRef(params, token)
  )
}

parseTypeRefPostfix(
  step: TypeRefStep
) -> TypeRefStep => {
  current := parserSkipNewlines(step.state)
  (
    parserCheck(current, TokenKind.LBracket) ? parseTypeRefPostfix(parseTypeRefArgs(current, step.typeRef))
      : (
        parserCheck(current, TokenKind.Question) ? parseTypeRefPostfix(parseNullableTypeRef(current, step.typeRef))
          : TypeRefStep {
            state: step.state,
            typeRef: step.typeRef
          }
      )
  )
}

parseTypeRefArgs(
  state: ParserState,
  typeRef: ParsedTypeRef
) -> TypeRefStep => {
  open := parserConsume(state, TokenKind.LBracket, "expected '[' after type name")
  args := parseTypeRefList(parserSkipNewlines(open.state), [])
  close := parserConsume(args.state, TokenKind.RBracket, "expected ']' after type arguments")
  TypeRefStep {
    state: close.state,
    typeRef: typeRefWithArgs(typeRef, args.refs)
  }
}

parseNullableTypeRef(
  state: ParserState,
  typeRef: ParsedTypeRef
) -> TypeRefStep => {
  question := parserConsume(state, TokenKind.Question, "expected '?' after type")
  TypeRefStep {
    state: question.state,
    typeRef: nullableTypeRef(typeRef)
  }
}

parseTypeRefList(
  state: ParserState,
  refs: Array[ParsedTypeRef]
) -> TypeRefListStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBracket) || parserCheck(current, TokenKind.EOF) ? TypeRefListStep {
      state: current,
      refs: refs
    }
      : parseOneTypeRefListValue(current, refs)
  )
}

parseOneTypeRefListValue(
  state: ParserState,
  refs: Array[ParsedTypeRef]
) -> TypeRefListStep => {
  typeRef := parseTypeRef(state)
  refs.push(typeRef.typeRef)
  comma := parserMatch(parserSkipNewlines(typeRef.state), TokenKind.Comma)
  comma.ok {
    true => parseTypeRefList(comma.state, refs)
    _ => TypeRefListStep {
      state: typeRef.state,
      refs: refs
    }
  }
}

parseTypeParamList(
  state: ParserState,
  params: Array[ParsedTypeParam]
) -> TypeParamListStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RParen) || parserCheck(current, TokenKind.EOF) ? TypeParamListStep {
      state: current,
      params: params
    }
      : parseOneTypeParam(current, params)
  )
}

parseOneTypeParam(
  state: ParserState,
  params: Array[ParsedTypeParam]
) -> TypeParamListStep => {
  param := parseTypeParam(state)
  params.push(param.param)
  comma := parserMatch(parserSkipNewlines(param.state), TokenKind.Comma)
  comma.ok {
    true => parseTypeParamList(comma.state, params)
    _ => TypeParamListStep {
      state: param.state,
      params: params
    }
  }
}

parseTypeParam(
  state: ParserState
) -> TypeParamStep => {
  named := parserCheck(state, TokenKind.Ident) && typeParamHasName(state)
  (
    named ? parseNamedTypeParam(state)
      : parseUnnamedTypeParam(state)
  )
}

parseNamedTypeParam(
  state: ParserState
) -> TypeParamStep => {
  name := parserConsume(state, TokenKind.Ident, "expected type parameter name")
  optional := parserMatch(name.state, TokenKind.Question)
  colon := parserConsume(optional.state, TokenKind.Colon, "expected ':' after type parameter name")
  typeRef := parseTypeRef(parserSkipNewlines(colon.state))
  TypeParamStep {
    state: typeRef.state,
    param: ParsedTypeParam {
      name: name.token.lexeme,
      optional: optional.ok,
      typeRef: typeRef.typeRef
    }
  }
}

parseUnnamedTypeParam(
  state: ParserState
) -> TypeParamStep => {
  typeRef := parseTypeRef(state)
  TypeParamStep {
    state: typeRef.state,
    param: ParsedTypeParam {
      name: "",
      optional: false,
      typeRef: typeRef.typeRef
    }
  }
}

typeParamHasName(
  state: ParserState
) -> Bool => (parserKindAt(state, state.current + 1) == TokenKind.Colon) || ((parserKindAt(state, state.current + 1) == TokenKind.Question) && (parserKindAt(state, state.current + 2) == TokenKind.Colon))

parseTypeRefError(
  state: ParserState
) -> TypeRefStep => {
  state: parserErrorAt(state, parserPeek(state), "expected type name"),
  typeRef: emptyParsedTypeRef()
}

parseBody(
  state: ParserState
) -> ExprStep => (
  parserCheck(state, TokenKind.LBrace) ? parseBraceBody(state)
    : parseExpression(state, 1)
)

parseBraceBody(
  state: ParserState
) -> ExprStep => (
  (looksLikePatternBranch(state) == false) && looksLikeMapLiteralBody(state) ? parseMapLiteral(state)
    : parseBlock(state)
)

parseBlock(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{'")
  bodyStart := parserSkipNewlines(open.state)
  (
    parserCheck(bodyStart, TokenKind.RBrace) ? finishBlock(bodyStart, node(ExprKind.Block, open.token))
      : (
        looksLikePatternBranch(bodyStart) ? parsePatternBlock(bodyStart, node(ExprKind.PatternBlock, open.token))
          : parseBlockLoop(bodyStart, node(ExprKind.Block, open.token))
      )
  )
}

finishBlock(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after block")
  ExprStep {
    state: close.state,
    expr: block
  }
}

parseBlockLoop(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishBlock(current, block)
      : parseBlockStatement(current, block)
  )
}

parseBlockStatement(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  stmt := parseStatement(state)
  nextBlock := appendChild(block, stmt.expr)
  parseBlockLoop(consumeStatementEnd(stmt.state), nextBlock)
}

parseStatement(
  state: ParserState
) -> ExprStep => (
  parserCheck(state, TokenKind.LBrace) && looksLikeObjectDestructureDecl(state) ? parseObjectDestructureStatement(state)
    : (
      parserCheck(state, TokenKind.LBrace) ? parseBlock(state)
        : (
          parserCheck(state, TokenKind.Dollar) && parserCheckNext(state, TokenKind.Ident) ? parseDollarStatement(state)
            : (
              parserCheck(state, TokenKind.Ident) && (parserCheckNext(state, TokenKind.Declare) || parserCheckNext(state, TokenKind.MutDeclare)) ? parseLetStatement(state)
                : (
                  parserCheck(state, TokenKind.Ident) && parserCheckNext(state, TokenKind.Assign) ? parseAssignStatement(state)
                    : parseExpression(state, 1)
                )
            )
        )
    )
)

parseDollarStatement(
  state: ParserState
) -> ExprStep => (
  parserKindAt(state, state.current + 2) == TokenKind.Declare ? parseSignalPrefixLetStatement(state)
    : parseExpression(state, 1)
)

parseSignalPrefixLetStatement(
  state: ParserState
) -> ExprStep => {
  dollar := parserAdvance(state)
  name := parserAdvance(dollar.state)
  op := parserAdvance(name.state)
  value := parseExpression(parserSkipNewlines(op.state), 1)
  ExprStep {
    state: value.state,
    expr: makeExpr(ExprKind.Let, "$" + name.token.lexeme, name.token.lexeme, "", op.token.lexeme, [], [value.expr], name.token.line, name.token.column)
  }
}

parseLetStatement(
  state: ParserState
) -> ExprStep => {
  name := parserAdvance(state)
  op := parserAdvance(name.state)
  value := parseExpression(parserSkipNewlines(op.state), 1)
  ExprStep {
    state: value.state,
    expr: makeExpr(ExprKind.Let, name.token.lexeme, name.token.lexeme, "", op.token.lexeme, [], [value.expr], name.token.line, name.token.column)
  }
}

parseObjectDestructureStatement(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{' before object destructuring")
  fields := parseObjectBindingList(parserSkipNewlines(open.state))
  close := parserConsume(fields.state, TokenKind.RBrace, "expected '}' after object destructuring")
  op := parserAdvance(parserSkipNewlines(close.state))
  value := parseExpression(parserSkipNewlines(op.state), 1)
  ExprStep {
    state: value.state,
    expr: makeExpr(ExprKind.ObjectDestructure, "", "", "", op.token.lexeme, fields.params, [value.expr], open.token.line, open.token.column)
  }
}

parseObjectBindingList(
  state: ParserState
) -> ParamListStep => parseObjectBindingListLoop(state, [])

parseObjectBindingListLoop(
  state: ParserState,
  fields: Array[ParsedParam]
) -> ParamListStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? ParamListStep {
      state: current,
      params: fields
    }
      : parseOneObjectBinding(current, fields)
  )
}

parseOneObjectBinding(
  state: ParserState,
  fields: Array[ParsedParam]
) -> ParamListStep => {
  field := parserConsume(state, TokenKind.Ident, "expected field name in object destructuring")
  aliasStart := parserMatch(field.state, TokenKind.Colon)
  name := (
    aliasStart.ok ? parserConsume(parserSkipNewlines(aliasStart.state), TokenKind.Ident, "expected binding name after ':'")
      : field
  )
  fields.push(ParsedParam {
    name: name.token.lexeme,
    typeRef: namedParsedTypeRef(field.token),
    line: name.token.line,
    column: name.token.column
  })
  comma := parserMatch(parserSkipNewlines(name.state), TokenKind.Comma)
  (
    comma.ok ? parseObjectBindingListLoop(comma.state, fields)
      : ParamListStep {
        state: name.state,
        params: fields
      }
  )
}

parseAssignStatement(
  state: ParserState
) -> ExprStep => {
  name := parserAdvance(state)
  op := parserAdvance(name.state)
  value := parseExpression(parserSkipNewlines(op.state), 1)
  ExprStep {
    state: value.state,
    expr: makeExpr(ExprKind.Assign, name.token.lexeme, name.token.lexeme, "", op.token.lexeme, [], [value.expr], name.token.line, name.token.column)
  }
}

parseExpression(
  state: ParserState,
  minPrec: Int
) -> ExprStep => (
  ((minPrec <= 1) && parserCheck(state, TokenKind.LParen)) && looksLikeLambda(state) ? parseLambda(state)
    : parseExpressionLoop(parseUnary(state), minPrec)
)

parseExpressionLoop(
  left: ExprStep,
  minPrec: Int
) -> ExprStep => {
  state := left.state
  expr := left.expr
  (
    parserCheck(state, TokenKind.LBrace) ? parseAfterBraceExpression(state, expr, minPrec)
      : (
        parserCheck(state, TokenKind.LParen) ? parseCallExpression(state, expr, minPrec)
          : (
            parserCheck(state, TokenKind.LBracket) ? parseIndexExpression(state, expr, minPrec)
              : (
                parserCheck(state, TokenKind.Dot) || parserCheck(state, TokenKind.DoubleColon) ? parseSelectorExpression(state, expr, minPrec)
                  : (
                    parserCheck(state, TokenKind.PlusPlus) ? parsePostfixExpression(state, expr, minPrec)
                      : (
                        parserCheck(state, TokenKind.Apostrophe) ? parseCompileTimePostfixExpression(state, expr, minPrec)
                          : (
                            (minPrec <= 1) && parserCheck(state, TokenKind.Arrow) ? parseWatchExpression(state, expr, minPrec)
                              : (
                                (minPrec <= 1) && parserCheck(state, TokenKind.Assign) ? parseAssignmentExpression(state, expr, minPrec)
                                  : (
                                    (minPrec <= 1) && parserCheck(state, TokenKind.Tilde) ? parsePatternPredicateExpression(state, expr, minPrec)
                                      : (
                                        (minPrec <= 1) && parserCheck(state, TokenKind.Question) ? parseQuestionExpression(state, expr, minPrec)
                                          : parseBinaryExpression(state, expr, minPrec)
                                      )
                                  )
                              )
                          )
                      )
                  )
              )
          )
      )
  )
}

parseAfterBraceExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => (
  looksLikePatternBlockAfterSubject(state) ? parseExpressionLoop(parseMatchExpression(state, expr), minPrec)
    : (
      expr.kind == ExprKind.Identifier ? parseExpressionLoop(parseStructLiteral(state, expr), minPrec)
        : ExprStep {
          state: state,
          expr: expr
        }
    )
)

parseCallExpression(
  state: ParserState,
  callee: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '(' after callee")
  args := parseArgumentList(parserSkipNewlines(open.state), [callee], TokenKind.RParen)
  close := parserConsume(args.state, TokenKind.RParen, "expected ')' after arguments")
  call := makeExpr(ExprKind.Call, calleeText(callee), "", "", "", [], args.expr.children, callee.line, callee.column)
  parseExpressionLoop(ExprStep {
    state: close.state,
    expr: call
  }, minPrec)
}

parseArgumentList(
  state: ParserState,
  holderChildren: Array[ParsedExpr],
  endKind: TokenKind
) -> ExprStep => {
  holder := makeExpr(ExprKind.Args, "", "", "", "", [], holderChildren, 0, 0)
  parseArgumentListLoop(state, holder, endKind)
}

parseArgumentListLoop(
  state: ParserState,
  holder: ParsedExpr,
  endKind: TokenKind
) -> ExprStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, endKind) || parserCheck(current, TokenKind.EOF) ? ExprStep {
      state: current,
      expr: holder
    }
      : parseOneArgument(current, holder, endKind)
  )
}

parseOneArgument(
  state: ParserState,
  holder: ParsedExpr,
  endKind: TokenKind
) -> ExprStep => {
  spread := parserMatch(state, TokenKind.DotDot)
  value := parseExpression((
    spread.ok ? spread.state
      : state
  ), 1)
  arg := (
    spread.ok ? opNode(ExprKind.Spread, "..", parserPrevious(spread.state), [value.expr])
      : value.expr
  )
  nextHolder := appendChild(holder, arg)
  comma := parserMatch(parserSkipNewlines(value.state), TokenKind.Comma)
  parseArgumentListLoop(comma.state, nextHolder, endKind)
}

parseIndexExpression(
  state: ParserState,
  receiver: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBracket, "expected '[' after receiver")
  index := parseExpression(parserSkipNewlines(open.state), 1)
  close := parserConsume(index.state, TokenKind.RBracket, "expected ']' after index")
  parseExpressionLoop(ExprStep {
    state: close.state,
    expr: makeExpr(ExprKind.Index, receiver.text, "", "", "", [], [receiver, index.expr], receiver.line, receiver.column)
  }, minPrec)
}

parseSelectorExpression(
  state: ParserState,
  receiver: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  operator := (
    parserCheck(state, TokenKind.DoubleColon) ? parserConsume(state, TokenKind.DoubleColon, "expected '::'")
      : parserConsume(state, TokenKind.Dot, "expected '.'")
  )
  name := parserConsume(operator.state, TokenKind.Ident, "expected selector name")
  parseExpressionLoop(ExprStep {
    state: name.state,
    expr: makeExpr(ExprKind.Selector, name.token.lexeme, name.token.lexeme, "", operator.token.lexeme, [], [receiver], operator.token.line, operator.token.column)
  }, minPrec)
}

parsePostfixExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  parseExpressionLoop(ExprStep {
    state: op.state,
    expr: opNode(ExprKind.Postfix, op.token.lexeme, op.token, [expr])
  }, minPrec)
}

parseCompileTimePostfixExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  parseExpressionLoop(ExprStep {
    state: op.state,
    expr: opNode(ExprKind.CompileTime, op.token.lexeme, op.token, [expr])
  }, minPrec)
}

parseWatchExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  arrow := parserAdvance(state)
  handler := parseWatchHandler(parserSkipNewlines(arrow.state))
  parseExpressionLoop(ExprStep {
    state: handler.state,
    expr: opNode(ExprKind.Watch, arrow.token.lexeme, arrow.token, [expr, handler.expr])
  }, minPrec)
}

parseWatchHandler(
  state: ParserState
) -> ExprStep => (
  parserCheck(state, TokenKind.LParen) && looksLikeLambda(state) ? parseLambda(state)
    : (
      parserCheck(state, TokenKind.LBrace) ? parseBody(state)
        : parseExpression(state, 1)
    )
)

parseAssignmentExpression(
  state: ParserState,
  target: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  value := parseExpression(parserSkipNewlines(op.state), 1)
  parseExpressionLoop(ExprStep {
    state: value.state,
    expr: opNode(ExprKind.Assign, op.token.lexeme, op.token, [target, value.expr])
  }, minPrec)
}

parsePatternPredicateExpression(
  state: ParserState,
  subject: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  pattern := parsePredicatePatternText(parserSkipNewlines(op.state))
  trueExpr := valueNode(ExprKind.Bool, "true", op.token)
  falseExpr := valueNode(ExprKind.Bool, "false", op.token)
  patternBranch := makeExpr(ExprKind.Branch, pattern.expr.text, "", "", "=>", [], [pattern.expr, trueExpr], pattern.expr.line, pattern.expr.column)
  wildcardPattern := makeExpr(ExprKind.Pattern, "_", "", "", "", [], [], pattern.expr.line, pattern.expr.column)
  wildcardBranch := makeExpr(ExprKind.Branch, "_", "", "", "=>", [], [wildcardPattern, falseExpr], pattern.expr.line, pattern.expr.column)
  matchExpr := appendChild(appendChild(appendChild(node(ExprKind.Match, op.token), subject), patternBranch), wildcardBranch)
  parseExpressionLoop(ExprStep {
    state: pattern.state,
    expr: matchExpr
  }, minPrec)
}

parseQuestionExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => (
  questionIsPostfixUnwrap(state) ? parseExpressionLoop(parseResultUnwrapExpression(state, expr), minPrec)
    : parseTernaryExpression(state, expr, minPrec)
)

parseResultUnwrapExpression(
  state: ParserState,
  expr: ParsedExpr
) -> ExprStep => {
  question := parserAdvance(state)
  ExprStep {
    state: question.state,
    expr: opNode(ExprKind.Unwrap, "?", question.token, [expr])
  }
}

parseTernaryExpression(
  state: ParserState,
  condition: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  question := parserAdvance(state)
  consequence := parseExpression(parserSkipNewlines(question.state), 1)
  afterConsequence := parserSkipNewlines(consequence.state)
  colon := parserMatch(afterConsequence, TokenKind.Colon)
  (
    colon.ok ? parseTernaryAlternative(colon.state, question.token, condition, consequence.expr, minPrec)
      : parseExpressionLoop(ExprStep {
        state: afterConsequence,
        expr: opNode(ExprKind.Ternary, "?:", question.token, [condition, consequence.expr])
      }, minPrec)
  )
}

parseTernaryAlternative(
  state: ParserState,
  token: Token,
  condition: ParsedExpr,
  consequence: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  alternative := parseExpression(parserSkipNewlines(state), 1)
  parseExpressionLoop(ExprStep {
    state: alternative.state,
    expr: opNode(ExprKind.Ternary, "?:", token, [condition, consequence, alternative.expr])
  }, minPrec)
}

parseBinaryExpression(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int
) -> ExprStep => {
  prec := precedence(parserPeek(state).kind)
  (
    prec < minPrec ? ExprStep {
      state: state,
      expr: expr
    }
      : parseBinaryExpressionAtPrec(state, expr, minPrec, prec)
  )
}

parseBinaryExpressionAtPrec(
  state: ParserState,
  expr: ParsedExpr,
  minPrec: Int,
  prec: Int
) -> ExprStep => {
  op := parserAdvance(state)
  right := parseExpression(op.state, prec + 1)
  parseExpressionLoop(ExprStep {
    state: right.state,
    expr: opNode(ExprKind.Binary, op.token.lexeme, op.token, [expr, right.expr])
  }, minPrec)
}

parseUnary(
  state: ParserState
) -> ExprStep => (
  (parserCheck(state, TokenKind.Minus) || parserCheck(state, TokenKind.Bang)) || parserCheck(state, TokenKind.Tilde) ? parseUnaryOperator(state)
    : parsePrimary(state)
)

parseUnaryOperator(
  state: ParserState
) -> ExprStep => {
  op := parserAdvance(state)
  right := parseExpression(op.state, 11)
  ExprStep {
    state: right.state,
    expr: opNode(ExprKind.Unary, op.token.lexeme, op.token, [right.expr])
  }
}

parsePrimary(
  state: ParserState
) -> ExprStep => {
  token := parserPeek(state)
  token.kind {
    TokenKind.Int => parseLiteral(state, ExprKind.Int)
    TokenKind.Double => parseLiteral(state, ExprKind.Double)
    TokenKind.BigInt => parseLiteral(state, ExprKind.BigInt)
    TokenKind.String => parseLiteral(state, ExprKind.String)
    TokenKind.TemplateString => parseTemplateLiteral(state)
    TokenKind.Char => parseLiteral(state, ExprKind.Char)
    TokenKind.Regex => parseLiteral(state, ExprKind.Regex)
    TokenKind.XMLText => parseLiteral(state, ExprKind.XMLText)
    TokenKind.Ident => parseIdentifierPrimary(state)
    TokenKind.At => parseAtExpression(state)
    TokenKind.Dot => parseThisSelector(state)
    TokenKind.LBracket => parseArrayLiteral(state)
    TokenKind.Dollar => parseDollarExpression(state)
    TokenKind.LBrace => parseBraceLiteral(state)
    TokenKind.LParen => parseParenOrTuple(state)
    _ => parsePrimaryError(state)
  }
}

parseTemplateLiteral(
  state: ParserState
) -> ExprStep => {
  step := parserAdvance(state)
  parsed := parseTemplateParts(templateInner(step.token.lexeme), 0, 0, "", [])
  ExprStep {
    state: step.state,
    expr: makeExpr(ExprKind.Template, step.token.lexeme, "", ("`" + parsed.text) + "`", "", [], parsed.children, step.token.line, step.token.column)
  }
}

templateInner(raw: String) -> String => (
  raw.length() >= 2 ? raw.slice(1, raw.length() - 1)
    : raw
)

parseTemplateParts(
  inner: String,
  index: Int,
  textStart: Int,
  out: String,
  children: Array[ParsedExpr]
) -> TemplateParse => (
  index >= inner.length() ? TemplateParse {
    text: out + inner.slice(textStart, inner.length()),
    children: children
  }
    : parseTemplatePartAt(inner, index, textStart, out, children)
)

parseTemplatePartAt(
  inner: String,
  index: Int,
  textStart: Int,
  out: String,
  children: Array[ParsedExpr]
) -> TemplateParse => {
  ch := inner.at(index)
  (
    (ch == '\\') && ((index + 1) < inner.length()) && (inner.at(index + 1) == '(') ? parseTemplateExprPart(inner, index, textStart, out, children)
      : parseTemplateParts(inner, index + 1, textStart, out, children)
  )
}

parseTemplateExprPart(
  inner: String,
  index: Int,
  textStart: Int,
  out: String,
  children: Array[ParsedExpr]
) -> TemplateParse => {
  exprStart := index + 2
  exprEnd := scanTemplateExprEnd(inner, exprStart, 1)
  (
    exprEnd < 0 ? TemplateParse {
      text: out + inner.slice(textStart, inner.length()),
      children: children
    }
      : parseTemplateParts(inner, exprEnd + 1, exprEnd + 1, (out + inner.slice(textStart, index)) + "<<<RUNE_TEMPLATE_PART>>>", pushTemplateExpr(children, inner.slice(exprStart, exprEnd)))
  )
}

scanTemplateExprEnd(
  inner: String,
  index: Int,
  depth: Int
) -> Int => (
  index >= inner.length() ? -1
    : scanTemplateExprEndAt(inner, index, depth)
)

scanTemplateExprEndAt(
  inner: String,
  index: Int,
  depth: Int
) -> Int => {
  ch := inner.at(index)
  ch {
    '"' => scanTemplateExprEnd(inner, skipTemplateQuoted(inner, index + 1, '"'), depth)
    '\'' => scanTemplateExprEnd(inner, skipTemplateQuoted(inner, index + 1, '\''), depth)
    '`' => scanTemplateExprEnd(inner, skipTemplateQuoted(inner, index + 1, '`'), depth)
    '(' => scanTemplateExprEnd(inner, index + 1, depth + 1)
    ')' => (
      depth == 1 ? index
        : scanTemplateExprEnd(inner, index + 1, depth - 1)
    )
    _ => scanTemplateExprEnd(inner, index + 1, depth)
  }
}

skipTemplateQuoted(
  text: String,
  index: Int,
  quote: Char
) -> Int => (
  index >= text.length() ? index
    : skipTemplateQuotedAt(text, index, quote)
)

skipTemplateQuotedAt(
  text: String,
  index: Int,
  quote: Char
) -> Int => {
  ch := text.at(index)
  (
    ch == '\\' ? skipTemplateQuoted(text, index + 2, quote)
      : (
        ch == quote ? index + 1
          : skipTemplateQuoted(text, index + 1, quote)
      )
  )
}

pushTemplateExpr(
  children: Array[ParsedExpr],
  source: String
) -> Array[ParsedExpr] => {
  parsed := parseTemplateExpression(source.trim())
  [..children, parsed]
}

parseTemplateExpression(
  source: String
) -> ParsedExpr => (
  source == "" ? emptyExpr()
    : parseExpression(ParserState {
      tokens: lex(source),
      current: 0,
      errors: []
    }, 1).expr
)

parseLiteral(
  state: ParserState,
  kind: ExprKind
) -> ExprStep => {
  step := parserAdvance(state)
  ExprStep {
    state: step.state,
    expr: valueNode(kind, step.token.lexeme, step.token)
  }
}

parseIdentifierPrimary(
  state: ParserState
) -> ExprStep => {
  step := parserAdvance(state)
  kind := (
    (step.token.lexeme == "true") || (step.token.lexeme == "false") ? ExprKind.Bool
      : (
        step.token.lexeme == "null" ? ExprKind.Null
          : ExprKind.Identifier
      )
  )
  ExprStep {
    state: step.state,
    expr: (
      kind == ExprKind.Identifier ? namedNode(kind, step.token.lexeme, step.token)
        : valueNode(kind, step.token.lexeme, step.token)
    )
  }
}

parseAtExpression(
  state: ParserState
) -> ExprStep => {
  at := parserConsume(state, TokenKind.At, "expected '@'")
  (
    parserCheck(at.state, TokenKind.String) ? parseAtImportExpression(at)
      : parseAtModuleExpression(at)
  )
}

parseAtImportExpression(
  at: TokenStep
) -> ExprStep => {
  path := parserAdvance(at.state)
  ExprStep {
    state: path.state,
    expr: valueNode(ExprKind.At, path.token.lexeme, at.token)
  }
}

parseAtModuleExpression(
  at: TokenStep
) -> ExprStep => {
  name := parserConsume(at.state, TokenKind.Ident, "expected module name after '@'")
  ExprStep {
    state: name.state,
    expr: namedNode(ExprKind.At, name.token.lexeme, at.token)
  }
}

parseThisSelector(
  state: ParserState
) -> ExprStep => {
  dot := parserConsume(state, TokenKind.Dot, "expected '.'")
  parserCheck(dot.state, TokenKind.Ident) ? parseThisFieldSelector(dot.state, dot.token)
    : ExprStep {
      state: dot.state,
      expr: node(ExprKind.This, dot.token)
    }
}

parseThisFieldSelector(
  state: ParserState,
  dot: Token
) -> ExprStep => {
  name := parserConsume(state, TokenKind.Ident, "expected field name after '.'")
  ExprStep {
    state: name.state,
    expr: makeExpr(ExprKind.Selector, name.token.lexeme, name.token.lexeme, "", ".", [], [node(ExprKind.This, dot)], dot.line, dot.column)
  }
}

parseArrayLiteral(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBracket, "expected '['")
  args := parseArgumentList(parserSkipNewlines(open.state), [], TokenKind.RBracket)
  close := parserConsume(args.state, TokenKind.RBracket, "expected ']' after array literal")
  ExprStep {
    state: close.state,
    expr: makeExpr(ExprKind.Array, "[]", "", "", "", [], args.expr.children, open.token.line, open.token.column)
  }
}

parseReactiveLiteral(
  state: ParserState
) -> ExprStep => {
  start := parserConsume(state, TokenKind.Dollar, "expected '$'")
  parseReactiveLiteralAfterDollar(start)
}

parseDollarExpression(
  state: ParserState
) -> ExprStep => {
  start := parserConsume(state, TokenKind.Dollar, "expected '$'")
  (
    parserCheck(start.state, TokenKind.Ident) ? parseSignalPrefixIdentifier(start)
      : ExprStep {
        state: parserErrorAt(start.state, parserPeek(start.state), "expected signal name after '$'"),
        expr: emptyExpr()
      }
  )
}

parseSignalPrefixIdentifier(
  start: TokenStep
) -> ExprStep => {
  name := parserAdvance(start.state)
  ExprStep {
    state: name.state,
    expr: namedNode(ExprKind.Identifier, name.token.lexeme, name.token)
  }
}

parseReactiveLiteralAfterDollar(
  start: TokenStep
) -> ExprStep => {
  value := (
    parserCheck(start.state, TokenKind.LBracket) ? parseArrayLiteral(start.state)
      : (
        parserCheck(start.state, TokenKind.LBrace) ? parseBraceLiteral(start.state)
          : ExprStep {
            state: parserErrorAt(start.state, parserPeek(start.state), "expected '[' or '{' after '$'"),
            expr: emptyExpr()
          }
      )
  )
  ExprStep {
    state: value.state,
    expr: opNode(ExprKind.Reactive, "$", start.token, [value.expr])
  }
}

parseBraceLiteral(
  state: ParserState
) -> ExprStep => (
  looksLikeMapLiteralBody(state) ? parseMapLiteral(state)
    : parseObjectLiteral(state)
)

parseMapLiteral(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{'")
  parseMapLiteralLoop(parserSkipNewlines(open.state), node(ExprKind.Map, open.token))
}

parseMapLiteralLoop(
  state: ParserState,
  mapExpr: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishMapLiteral(current, mapExpr)
      : parseMapLiteralEntry(current, mapExpr)
  )
}

parseMapLiteralEntry(
  state: ParserState,
  mapExpr: ParsedExpr
) -> ExprStep => {
  key := parseExpression(state, 1)
  colon := parserConsume(key.state, TokenKind.Colon, "expected ':' after map key")
  value := parseExpression(parserSkipNewlines(colon.state), 1)
  entry := makeExpr(ExprKind.Entry, "", "", "", ":", [], [key.expr, value.expr], key.expr.line, key.expr.column)
  nextMap := appendChild(mapExpr, entry)
  comma := parserMatch(parserSkipNewlines(consumeStatementEnd(value.state)), TokenKind.Comma)
  parseMapLiteralLoop(comma.state, nextMap)
}

finishMapLiteral(
  state: ParserState,
  mapExpr: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after map literal")
  ExprStep {
    state: close.state,
    expr: mapExpr
  }
}

parseObjectLiteral(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{'")
  parseObjectLiteralLoop(parserSkipNewlines(open.state), node(ExprKind.Object, open.token))
}

parseObjectLiteralLoop(
  state: ParserState,
  object: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishObjectLiteral(current, object)
      : parseObjectLiteralMember(current, object)
  )
}

parseObjectLiteralMember(
  state: ParserState,
  object: ParsedExpr
) -> ExprStep => {
  privateStep := parseObjectPrivateModifier(state)
  memberState := privateStep.state
  member := (
    looksLikeFunctionDecl(memberState) ? parseObjectMethod(memberState, privateStep.ok)
      : parseObjectField(memberState, privateStep.ok)
  )
  nextObject := appendChild(object, member.expr)
  parseObjectLiteralLoop(consumeFieldSeparator(member.state, TokenKind.RBrace, "expected ',' between object literal fields"), nextObject)
}

parseObjectMethod(
  state: ParserState,
  private: Bool
) -> ExprStep => {
  fn := parseFunctionWithReceiver(state, "", private, false, false, emptyAnnotations())
  ExprStep {
    state: fn.state,
    expr: functionToExpr(fn.function)
  }
}

parseObjectField(
  state: ParserState,
  private: Bool
) -> ExprStep => {
  name := parserConsume(state, TokenKind.Ident, "expected field name")
  colon := parserConsume(name.state, TokenKind.Colon, "expected ':' after field name")
  value := parseExpression(parserSkipNewlines(colon.state), 1)
  ExprStep {
    state: value.state,
    expr: makeExpr((
      private ? ExprKind.PrivateField
        : ExprKind.Field
    ), name.token.lexeme, name.token.lexeme, "", ":", [], [value.expr], name.token.line, name.token.column)
  }
}

finishObjectLiteral(
  state: ParserState,
  object: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after object literal")
  ExprStep {
    state: close.state,
    expr: object
  }
}

parseStructLiteral(
  state: ParserState,
  typeExpr: ParsedExpr
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{' after type name")
  parseStructLiteralLoop(parserSkipNewlines(open.state), namedNode(ExprKind.Struct, typeExpr.name, open.token))
}

parseStructLiteralLoop(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishStructLiteral(current, structExpr)
      : parseStructLiteralField(current, structExpr)
  )
}

parseStructLiteralField(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => (
  parserCheck(state, TokenKind.DotDot) ? parseStructLiteralSpreadField(state, structExpr)
    : parseStructLiteralNamedField(state, structExpr)
)

parseStructLiteralNamedField(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => {
  name := parserConsume(state, TokenKind.Ident, "expected field name")
  colon := parserConsume(name.state, TokenKind.Colon, "expected ':' after field name")
  value := parseExpression(parserSkipNewlines(colon.state), 1)
  field := makeExpr(ExprKind.Field, name.token.lexeme, name.token.lexeme, "", ":", [], [value.expr], name.token.line, name.token.column)
  nextStruct := appendChild(structExpr, field)
  parseStructLiteralLoop(consumeFieldSeparator(value.state, TokenKind.RBrace, "expected ',' between struct literal fields"), nextStruct)
}

parseStructLiteralSpreadField(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => {
  spread := parserConsume(state, TokenKind.DotDot, "expected '..'")
  value := parseExpression(spread.state, 1)
  field := opNode(ExprKind.Spread, "..", spread.token, [value.expr])
  nextStruct := appendChild(structExpr, field)
  parseStructLiteralLoop(consumeFieldSeparator(value.state, TokenKind.RBrace, "expected ',' between struct literal fields"), nextStruct)
}

finishStructLiteral(
  state: ParserState,
  structExpr: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after struct literal")
  ExprStep {
    state: close.state,
    expr: structExpr
  }
}

parseParenOrTuple(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '('")
  afterOpen := parserSkipNewlines(open.state)
  parseParenOrTupleAfterOpen(afterOpen, open.token)
}

parseParenOrTupleAfterOpen(
  state: ParserState,
  open: Token
) -> ExprStep => {
  expr := parseExpression(state, 1)
  afterExpr := parserSkipNewlines(expr.state)
  (
    parserCheck(afterExpr, TokenKind.Comma) ? parseTupleAfterFirst(afterExpr, open, expr.expr)
      : finishParenExpression(afterExpr, expr.expr)
  )
}

finishParenExpression(
  state: ParserState,
  expr: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RParen, "expected ')' after expression")
  ExprStep {
    state: close.state,
    expr: expr
  }
}

parseTupleAfterFirst(
  state: ParserState,
  open: Token,
  first: ParsedExpr
) -> ExprStep => {
  comma := parserConsume(state, TokenKind.Comma, "expected ','")
  holder := appendChild(node(ExprKind.Tuple, open), first)
  values := parseArgumentListLoop(parserSkipNewlines(comma.state), holder, TokenKind.RParen)
  close := parserConsume(values.state, TokenKind.RParen, "expected ')' after tuple literal")
  ExprStep {
    state: close.state,
    expr: values.expr
  }
}

parsePrimaryError(
  state: ParserState
) -> ExprStep => {
  token := parserPeek(state)
  step := parserAdvance(parserErrorAt(state, token, "expected expression, got " + tokenKindName(token.kind)))
  ExprStep {
    state: step.state,
    expr: namedNode(ExprKind.Error, "<error>", token)
  }
}

parseLambda(
  state: ParserState
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LParen, "expected '(' before lambda parameters")
  params := parseParamList(parserSkipNewlines(open.state))
  close := parserConsume(params.state, TokenKind.RParen, "expected ')' after lambda parameters")
  afterParams := parserSkipNewlines(close.state)
  ret := parserMatch(afterParams, TokenKind.Arrow)
  returnType := (
    ret.ok ? parseTypeRef(parserSkipNewlines(ret.state))
      : TypeRefStep {
        state: afterParams,
        typeRef: emptyParsedTypeRef()
      }
  )
  arrow := parserConsume(parserSkipNewlines(returnType.state), TokenKind.FatArrow, "expected '=>' after lambda parameter")
  body := parseBody(parserSkipNewlines(arrow.state))
  ExprStep {
    state: body.state,
    expr: withChildren(withParams(withText(node(ExprKind.Lambda, open.token), typeRefToString(returnType.typeRef)), params.params), [body.expr])
  }
}

parseMatchExpression(
  state: ParserState,
  subject: ParsedExpr
) -> ExprStep => {
  open := parserConsume(state, TokenKind.LBrace, "expected '{' after match subject")
  block := appendChild(node(ExprKind.Match, open.token), subject)
  parsePatternBlock(parserSkipNewlines(open.state), block)
}

parsePatternBlock(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  current := parserSkipNewlines(state)
  (
    parserCheck(current, TokenKind.RBrace) || parserCheck(current, TokenKind.EOF) ? finishPatternBlock(current, block)
      : parsePatternBranch(current, block)
  )
}

parsePatternBranch(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  pattern := parsePatternText(state)
  arrow := parserConsume(pattern.state, TokenKind.FatArrow, "expected '=>' after pattern")
  value := parseExpression(parserSkipNewlines(arrow.state), 1)
  branch := makeExpr(ExprKind.Branch, pattern.expr.text, "", "", "=>", [], [pattern.expr, value.expr], pattern.expr.line, pattern.expr.column)
  nextBlock := appendChild(block, branch)
  parsePatternBlock(consumeStatementEnd(value.state), nextBlock)
}

finishPatternBlock(
  state: ParserState,
  block: ParsedExpr
) -> ExprStep => {
  close := parserConsume(state, TokenKind.RBrace, "expected '}' after pattern block")
  ExprStep {
    state: close.state,
    expr: block
  }
}

parsePatternText(
  state: ParserState
) -> ExprStep => parsePatternTextLoop(state, "", parserPeek(state), 0, false)

parsePredicatePatternText(
  state: ParserState
) -> ExprStep => parsePredicatePatternTextLoop(state, "", parserPeek(state), 0, false)

parsePredicatePatternTextLoop(
  state: ParserState,
  text: String,
  start: Token,
  depth: Int,
  consumed: Bool
) -> ExprStep => (
  (depth == 0) && predicatePatternEnd(parserPeek(state).kind) ? ExprStep {
    state: (
      consumed ? state
        : parserErrorAt(state, parserPeek(state), "expected pattern")
    ),
    expr: withText(node(ExprKind.Pattern, start), text)
  }
    : parsePredicatePatternTextToken(state, text, start, depth)
)

parsePredicatePatternTextToken(
  state: ParserState,
  text: String,
  start: Token,
  depth: Int
) -> ExprStep => {
  token := parserPeek(state)
  step := parserAdvance(state)
  parsePredicatePatternTextLoop(step.state, text + token.lexeme, start, patternNextDepth(depth, token.kind), true)
}

predicatePatternEnd(kind: TokenKind) -> Bool => (((((kind == TokenKind.EOF) || (kind == TokenKind.Newline)) || (kind == TokenKind.Comma)) || (kind == TokenKind.RParen)) || (kind == TokenKind.RBracket)) || (kind == TokenKind.RBrace)

parsePatternTextLoop(
  state: ParserState,
  text: String,
  start: Token,
  depth: Int,
  consumed: Bool
) -> ExprStep => (
  (depth == 0) && (parserCheck(state, TokenKind.FatArrow) || parserCheck(state, TokenKind.EOF)) ? ExprStep {
    state: (
      consumed ? state
        : parserErrorAt(state, parserPeek(state), "expected pattern")
    ),
    expr: withText(node(ExprKind.Pattern, start), text)
  }
    : parsePatternTextToken(state, text, start, depth)
)

parsePatternTextToken(
  state: ParserState,
  text: String,
  start: Token,
  depth: Int
) -> ExprStep => {
  token := parserPeek(state)
  step := parserAdvance(state)
  parsePatternTextLoop(step.state, text + token.lexeme, start, patternNextDepth(depth, token.kind), true)
}

patternNextDepth(
  depth: Int,
  kind: TokenKind
) -> Int => (
  ((kind == TokenKind.LParen) || (kind == TokenKind.LBracket)) || (kind == TokenKind.LBrace) ? depth + 1
    : (
      (((kind == TokenKind.RParen) || (kind == TokenKind.RBracket)) || (kind == TokenKind.RBrace)) && (depth > 0) ? depth - 1
        : depth
    )
)

functionToExpr(
  fn: ParsedFunction
) -> ParsedExpr => makeExpr((
  fn.private ? ExprKind.PrivateMethod
    : ExprKind.Method
), typeRefToString(fn.returnType), fn.name, "", "=>", fn.params, [fn.body], fn.line, fn.column)

calleeText(expr: ParsedExpr) -> String => (
  expr.name != "" ? expr.name
    : (
      expr.value != "" ? expr.value
        : expr.text
    )
)

precedence(kind: TokenKind) -> Int => (
  (kind == TokenKind.QuestionQuestion) || (kind == TokenKind.OrOr) ? 1
    : (
      kind == TokenKind.AndAnd ? 2
        : (
          kind == TokenKind.BitOr ? 3
            : (
              kind == TokenKind.BitXor ? 4
                : (
                  kind == TokenKind.BitAnd ? 5
                    : (
                      (kind == TokenKind.EqualEqual) || (kind == TokenKind.BangEqual) ? 6
                        : (
                          ((((kind == TokenKind.DotDotEqual) || (kind == TokenKind.Less)) || (kind == TokenKind.LessEqual)) || (kind == TokenKind.Greater)) || (kind == TokenKind.GreaterEqual) ? 7
                            : (
                              ((kind == TokenKind.ShiftLeft) || (kind == TokenKind.ShiftRight)) || (kind == TokenKind.UnsignedShiftRight) ? 8
                                : (
                                  (kind == TokenKind.Plus) || (kind == TokenKind.Minus) ? 9
                                    : (
                                      ((kind == TokenKind.Star) || (kind == TokenKind.Slash)) || (kind == TokenKind.Percent) ? 10
                                        : 0
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

parseAnnotations(
  state: ParserState
) -> AnnotationListStep => parseAnnotationsLoop(state, emptyAnnotations())

parseAnnotationsLoop(
  state: ParserState,
  annotations: Array[ParsedAnnotation]
) -> AnnotationListStep => {
  current := parserSkipNewlines(state)
  (
    looksLikeAnnotation(current) ? parseAnnotationsNext(current, annotations)
      : AnnotationListStep {
        state: current,
        annotations: annotations
      }
  )
}

parseAnnotationsNext(
  state: ParserState,
  annotations: Array[ParsedAnnotation]
) -> AnnotationListStep => {
  step := parseAnnotation(state)
  parseAnnotationsLoop(step.state, [..annotations, step.annotation])
}

AnnotationStep: {
  state: ParserState
  annotation: ParsedAnnotation
}

looksLikeAnnotation(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.Hash) || (parserCheck(state, TokenKind.At) && parserCheckNext(state, TokenKind.Ident))

parseAnnotation(
  state: ParserState
) -> AnnotationStep => {
  marker := parserAdvance(state)
  first := parserConsume(marker.state, TokenKind.Ident, "expected annotation name")
  dot := parserMatch(first.state, TokenKind.Dot)
  name := (
    dot.ok ? parserConsume(dot.state, TokenKind.Ident, "expected annotation function name after '.'")
      : first
  )
  open := parserMatch(name.state, TokenKind.LParen)
  args := (
    open.ok ? parseArgumentList(parserSkipNewlines(open.state), [emptyExpr()].slice(0, 0), TokenKind.RParen)
      : ExprStep {
        state: name.state,
        expr: makeExpr(ExprKind.Args, "", "", "", "", [], [], 0, 0)
      }
  )
  close := (
    open.ok ? parserConsume(args.state, TokenKind.RParen, "expected ')' after annotation arguments")
      : TokenStep {
        state: args.state,
        token: name.token
      }
  )
  AnnotationStep {
    state: close.state,
    annotation: ParsedAnnotation {
      marker: marker.token.lexeme,
      module: (
        dot.ok ? first.token.lexeme
          : ""
      ),
      name: name.token.lexeme,
      args: args.expr.children,
      line: marker.token.line,
      column: marker.token.column
    }
  }
}

skipBalanced(
  state: ParserState,
  openKind: TokenKind,
  closeKind: TokenKind,
  depth: Int
) -> ParserState => (
  parserCheck(state, TokenKind.EOF) || (depth <= 0) ? state
    : skipBalancedStep(state, openKind, closeKind, depth)
)

skipBalancedStep(
  state: ParserState,
  openKind: TokenKind,
  closeKind: TokenKind,
  depth: Int
) -> ParserState => {
  token := parserPeek(state)
  step := parserAdvance(state)
  nextDepth := (
    token.kind == openKind ? depth + 1
      : (
        token.kind == closeKind ? depth - 1
          : depth
      )
  )
  skipBalanced(step.state, openKind, closeKind, nextDepth)
}

questionIsPostfixUnwrap(
  state: ParserState
) -> Bool => {
  next := parserKindAt(state, state.current + 1)
  (((((next == TokenKind.EOF) || (next == TokenKind.Newline)) || (next == TokenKind.RParen)) || (next == TokenKind.RBracket)) || (next == TokenKind.RBrace)) || (next == TokenKind.Comma)
}

looksLikeTypeDecl(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.Ident) && (parserKindAt(state, skipNewlinesAt(state, skipGenericNamesAt(state, state.current + 1))) == TokenKind.Colon)

looksLikeFunctionDecl(
  state: ParserState
) -> Bool => {
  start := (
    parserCheck(state, TokenKind.Tilde) ? skipNewlinesAt(state, state.current + 1)
      : state.current
  )
  (parserKindAt(state, start) == TokenKind.Ident) && looksLikeFunctionAfterName(state, skipGenericNamesAt(state, start + 1))
}

looksLikeMacroFunctionDecl(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.Hash) && looksLikeFunctionDecl(stateAt(state, state.current + 1))

looksLikeStaticFunctionDecl(
  state: ParserState
) -> Bool => {
  markerState := (
    parserCheck(state, TokenKind.DoubleColon) ? stateAt(state, state.current + 1)
      : (
        parserCheck(state, TokenKind.Ident) && (parserPeek(state).lexeme == "static") ? stateAt(state, state.current + 1)
          : state
      )
  )
  (markerState.current != state.current) && looksLikeFunctionDecl(parserSkipNewlines(markerState))
}

looksLikeFunctionAfterName(
  state: ParserState,
  index: Int
) -> Bool => (parserKindAt(state, index) == TokenKind.LParen) && looksLikeFunctionAfterParams(state, skipBalancedAt(state, index, TokenKind.LParen, TokenKind.RParen))

looksLikeFunctionAfterParams(
  state: ParserState,
  index: Int
) -> Bool => {
  afterParams := skipNewlinesAt(state, index)
  afterReturn := (
    parserKindAt(state, afterParams) == TokenKind.Arrow ? skipTypeNameTokensAt(state, afterParams + 1)
      : afterParams
  )
  parserKindAt(state, skipNewlinesAt(state, afterReturn)) == TokenKind.FatArrow
}

looksLikeLambda(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.LParen) && looksLikeLambdaAfterParams(state, skipBalancedAt(state, state.current, TokenKind.LParen, TokenKind.RParen))

looksLikeLambdaAfterParams(
  state: ParserState,
  index: Int
) -> Bool => {
  afterParams := skipNewlinesAt(state, index)
  afterReturn := (
    parserKindAt(state, afterParams) == TokenKind.Arrow ? skipTypeNameTokensAt(state, afterParams + 1)
      : afterParams
  )
  parserKindAt(state, skipNewlinesAt(state, afterReturn)) == TokenKind.FatArrow
}

looksLikeEnumMember(
  state: ParserState
) -> Bool => {
  start := (
    parserCheck(state, TokenKind.Plus) ? skipNewlinesAt(state, state.current + 1)
      : state.current
  )
  token := parserTokenAt(state, start)
  next := parserKindAt(state, skipNewlinesAt(state, start + 1))
  (token.kind == TokenKind.Ident) && ((next == TokenKind.Assign) || ((next == TokenKind.LParen) && startsWithUpper(token.lexeme)) || ((next != TokenKind.Colon) && (next != TokenKind.LParen)))
}

startsWithUpper(name: String) -> Bool => (
  name.length() > 0 ? (name.at(0) >= 'A') && (name.at(0) <= 'Z')
    : false
)

looksLikeObjectDestructureDecl(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.LBrace) && scanObjectDestructureDecl(state, skipNewlinesAt(state, state.current + 1))

scanObjectDestructureDecl(
  state: ParserState,
  index: Int
) -> Bool => (
  parserKindAt(state, index) == TokenKind.RBrace ? false
    : scanObjectDestructureField(state, index)
)

scanObjectDestructureField(
  state: ParserState,
  index: Int
) -> Bool => (
  parserKindAt(state, index) != TokenKind.Ident ? false
    : scanObjectDestructureAfterField(state, index + 1)
)

scanObjectDestructureAfterField(
  state: ParserState,
  index: Int
) -> Bool => (
  parserKindAt(state, index) == TokenKind.Colon ? (parserKindAt(state, skipNewlinesAt(state, index + 1)) == TokenKind.Ident) && scanObjectDestructureAfterName(state, skipNewlinesAt(state, index + 1) + 1)
    : scanObjectDestructureAfterName(state, index)
)

scanObjectDestructureAfterName(
  state: ParserState,
  index: Int
) -> Bool => {
  current := skipNewlinesAt(state, index)
  kind := parserKindAt(state, current)
  (
    kind == TokenKind.Comma ? scanObjectDestructureAfterComma(state, skipNewlinesAt(state, current + 1))
      : (
        kind == TokenKind.RBrace ? scanObjectDestructureAfterClose(state, current + 1)
          : false
      )
  )
}

scanObjectDestructureAfterComma(
  state: ParserState,
  index: Int
) -> Bool => (
  parserKindAt(state, index) == TokenKind.RBrace ? scanObjectDestructureAfterClose(state, index + 1)
    : scanObjectDestructureField(state, index)
)

scanObjectDestructureAfterClose(
  state: ParserState,
  index: Int
) -> Bool => {
  afterClose := skipNewlinesAt(state, index)
  (parserKindAt(state, afterClose) == TokenKind.Declare) || (parserKindAt(state, afterClose) == TokenKind.MutDeclare)
}

looksLikePatternBranch(
  state: ParserState
) -> Bool => tokensLookLikePatternBranch(state, skipNewlinesAt(state, state.current))

looksLikePatternBlockAfterSubject(
  state: ParserState
) -> Bool => parserCheck(state, TokenKind.LBrace) && tokensLookLikePatternBranch(state, skipNewlinesAt(state, state.current + 1))

tokensLookLikePatternBranch(
  state: ParserState,
  index: Int
) -> Bool => {
  afterPattern := skipPatternLookahead(state, index)
  (afterPattern >= 0) && (parserKindAt(state, skipNewlinesAt(state, afterPattern)) == TokenKind.FatArrow)
}

skipPatternLookahead(
  state: ParserState,
  index: Int
) -> Int => skipOrPatternLookahead(state, skipSinglePatternLookahead(state, index))

skipOrPatternLookahead(
  state: ParserState,
  index: Int
) -> Int => (
  (index >= 0) && (parserKindAt(state, skipNewlinesAt(state, index)) == TokenKind.BitOr) ? skipOrPatternLookahead(state, skipSinglePatternLookahead(state, skipNewlinesAt(state, index) + 1))
    : index
)

skipSinglePatternLookahead(
  state: ParserState,
  index: Int
) -> Int => {
  kind := parserKindAt(state, index)
  after := (
    (((((kind == TokenKind.Underscore) || (kind == TokenKind.Int)) || (kind == TokenKind.Double)) || (kind == TokenKind.BigInt)) || (kind == TokenKind.String)) || (kind == TokenKind.Char) ? index + 1
      : (
        kind == TokenKind.Ident ? skipIdentifierPatternLookahead(state, index)
          : (
            (((kind == TokenKind.Less) || (kind == TokenKind.LessEqual)) || (kind == TokenKind.Greater)) || (kind == TokenKind.GreaterEqual) ? skipComparePatternLookahead(state, index + 1)
              : (
                kind == TokenKind.LParen ? skipBalancedAt(state, index, TokenKind.LParen, TokenKind.RParen)
                  : (
                    kind == TokenKind.LBracket ? skipBalancedAt(state, index, TokenKind.LBracket, TokenKind.RBracket)
                      : (
                        kind == TokenKind.LBrace ? skipBalancedAt(state, index, TokenKind.LBrace, TokenKind.RBrace)
                          : -1
                      )
                  )
              )
          )
      )
  )
  skipRangePatternLookahead(state, after)
}

skipRangePatternLookahead(
  state: ParserState,
  index: Int
) -> Int => (
  (index >= 0) && (parserKindAt(state, index) == TokenKind.DotDotEqual) ? skipRangePatternEnd(state, index + 1)
    : (
      (index >= 0) && (parserKindAt(state, index) == TokenKind.DotDotLess) ? skipRangePatternEnd(state, index + 1)
        : (
          (index >= 0) && (parserKindAt(state, index) == TokenKind.DotDot) && (parserKindAt(state, index + 1) == TokenKind.Less) ? skipRangePatternEnd(state, index + 2)
            : index
        )
    )
)

skipRangePatternEnd(
  state: ParserState,
  index: Int
) -> Int => {
  kind := parserKindAt(state, index)
  (
    kind == TokenKind.Underscore ? index + 1
      : (
        (((((kind == TokenKind.Int) || (kind == TokenKind.Double)) || (kind == TokenKind.BigInt)) || (kind == TokenKind.String)) || (kind == TokenKind.Char)) || (kind == TokenKind.Ident) ? skipIdentifierRangeEnd(state, index)
          : -1
      )
  )
}

skipIdentifierRangeEnd(
  state: ParserState,
  index: Int
) -> Int => (
  (parserKindAt(state, index) == TokenKind.Ident) && (parserKindAt(state, index + 1) == TokenKind.Dot) && (parserKindAt(state, index + 2) == TokenKind.Ident) ? index + 3
    : index + 1
)

skipIdentifierPatternLookahead(
  state: ParserState,
  index: Int
) -> Int => (
  parserKindAt(state, index + 1) == TokenKind.LParen ? skipBalancedAt(state, index + 1, TokenKind.LParen, TokenKind.RParen)
    : (
      (parserKindAt(state, index + 1) == TokenKind.Dot) && (parserKindAt(state, index + 2) == TokenKind.Ident) ? index + 3
        : (
          isLiteralIdentifier(parserTokenAt(state, index).lexeme) ? index + 1
            : -1
        )
    )
)

skipComparePatternLookahead(
  state: ParserState,
  index: Int
) -> Int => {
  kind := parserKindAt(state, index)
  (
    (((((kind == TokenKind.Int) || (kind == TokenKind.Double)) || (kind == TokenKind.BigInt)) || (kind == TokenKind.String)) || (kind == TokenKind.Char)) || (kind == TokenKind.Ident) ? index + 1
      : -1
  )
}

looksLikeMapLiteralBody(
  state: ParserState
) -> Bool => {
  start := skipNewlinesAt(state, state.current + 1)
  first := parserTokenAt(state, start)
  (
    (first.kind == TokenKind.EOF) || (first.kind == TokenKind.RBrace) ? false
      : (
        (first.kind == TokenKind.Ident) && (isLiteralIdentifier(first.lexeme) == false) ? false
          : scanMapLiteralColon(state, start, 0)
      )
  )
}

scanMapLiteralColon(
  state: ParserState,
  index: Int,
  depth: Int
) -> Bool => {
  kind := parserKindAt(state, index)
  (
    kind == TokenKind.EOF ? false
      : (
        ((kind == TokenKind.LParen) || (kind == TokenKind.LBracket)) || (kind == TokenKind.LBrace) ? scanMapLiteralColon(state, index + 1, depth + 1)
          : (
            (kind == TokenKind.RParen) || (kind == TokenKind.RBracket) ? scanMapLiteralColon(state, index + 1, (
              depth > 0 ? depth - 1
                : depth
            ))
              : (
                kind == TokenKind.RBrace ? (
                  depth == 0 ? false
                    : scanMapLiteralColon(state, index + 1, depth - 1)
                )
                  : (
                    (((kind == TokenKind.Newline) || (kind == TokenKind.Question)) || (kind == TokenKind.FatArrow)) && (depth == 0) ? false
                      : (
                        (kind == TokenKind.Colon) && (depth == 0) ? true
                          : scanMapLiteralColon(state, index + 1, depth)
                      )
                  )
              )
          )
      )
  )
}

isLiteralIdentifier(
  name: String
) -> Bool => ((name == "true") || (name == "false")) || (name == "null")

skipNewlinesAt(
  state: ParserState,
  index: Int
) -> Int => (
  parserKindAt(state, index) == TokenKind.Newline ? skipNewlinesAt(state, index + 1)
    : index
)

skipGenericNamesAt(
  state: ParserState,
  index: Int
) -> Int => (
  parserKindAt(state, index) == TokenKind.LBracket ? skipBalancedAt(state, index, TokenKind.LBracket, TokenKind.RBracket)
    : index
)

skipBalancedAt(
  state: ParserState,
  index: Int,
  openKind: TokenKind,
  closeKind: TokenKind
) -> Int => skipBalancedAtLoop(state, index, openKind, closeKind, 0)

skipBalancedAtLoop(
  state: ParserState,
  index: Int,
  openKind: TokenKind,
  closeKind: TokenKind,
  depth: Int
) -> Int => {
  kind := parserKindAt(state, index)
  (
    kind == TokenKind.EOF ? index
      : (
        kind == openKind ? skipBalancedAtLoop(state, index + 1, openKind, closeKind, depth + 1)
          : (
            kind == closeKind ? (
              depth <= 1 ? index + 1
                : skipBalancedAtLoop(state, index + 1, openKind, closeKind, depth - 1)
            )
              : skipBalancedAtLoop(state, index + 1, openKind, closeKind, depth)
          )
      )
  )
}

skipTypeNameTokensAt(
  state: ParserState,
  index: Int
) -> Int => skipTypeNameTokensAtLoop(state, index, 0)

skipTypeNameTokensAtLoop(
  state: ParserState,
  index: Int,
  depth: Int
) -> Int => {
  kind := parserKindAt(state, index)
  (
    ((((((kind == TokenKind.Ident) || (kind == TokenKind.Comma)) || (kind == TokenKind.Colon)) || (kind == TokenKind.Question)) || (kind == TokenKind.Arrow)) || (kind == TokenKind.At)) || (kind == TokenKind.Dot) ? skipTypeNameTokensAtLoop(state, index + 1, depth)
      : (
        (kind == TokenKind.LBracket) || (kind == TokenKind.LParen) ? skipTypeNameTokensAtLoop(state, index + 1, depth + 1)
          : (
            (kind == TokenKind.RBracket) || (kind == TokenKind.RParen) ? (
              depth == 0 ? index
                : skipTypeNameTokensAtLoop(state, index + 1, depth - 1)
            )
              : index
          )
      )
  )
}
