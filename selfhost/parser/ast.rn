@"../lexer/lexer.rn"

+ ParsedTypeParam: {
  name: String
  optional: Bool
  typeRef: ParsedTypeRef
}

+ ParsedTypeRef: {
  kind: TypeRefKind
  name: String
  module: String
  nullable: Bool
  args: Array[ParsedTypeRef]
  params: Array[ParsedTypeParam]
  returnTypes: Array[ParsedTypeRef]
  line: Int
  column: Int
}

+ ParseError: {
  message: String
  line: Int
  column: Int
}

+ ParsedImport: {
  path: String
  go: Bool
  line: Int
  column: Int
}

+ ParsedAnnotation: {
  marker: String
  module: String
  name: String
  args: Array[ParsedExpr]
  line: Int
  column: Int
}

+ ParsedParam: {
  name: String
  typeRef: ParsedTypeRef
  line: Int
  column: Int
}

+ ParsedExpr: {
  kind: ExprKind
  text: String
  name: String
  value: String
  op: String
  params: Array[ParsedParam]
  children: Array[ParsedExpr]
  line: Int
  column: Int
}

+ ParsedField: {
  name: String
  private: Bool
  annotations: Array[ParsedAnnotation]
  typeRef: ParsedTypeRef
  line: Int
  column: Int
}

+ ParsedEnumMember: {
  name: String
  private: Bool
  annotations: Array[ParsedAnnotation]
  value: String
  params: Array[ParsedParam]
  line: Int
  column: Int
}

+ ParsedFunction: {
  name: String
  private: Bool
  static: Bool
  routine: Bool
  macro: Bool
  annotations: Array[ParsedAnnotation]
  receiverType: String
  generics: Array[String]
  params: Array[ParsedParam]
  returnType: ParsedTypeRef
  body: ParsedExpr
  line: Int
  column: Int
}

+ ParsedType: {
  name: String
  private: Bool
  enum: Bool
  annotations: Array[ParsedAnnotation]
  generics: Array[String]
  fields: Array[ParsedField]
  methods: Array[ParsedFunction]
  members: Array[ParsedEnumMember]
  line: Int
  column: Int
}

+ ParsedTest: {
  name: String
  body: ParsedExpr
  line: Int
  column: Int
}

+ ParsedFile: {
  imports: Array[ParsedImport]
  types: Array[ParsedType]
  functions: Array[ParsedFunction]
  tests: Array[ParsedTest]
  errors: Array[ParseError]
}

+ TypeRefKind: {
  Unknown = 0
  Name = 1
  Group = 2
  Tuple = 3
  Function = 4
}

+ ExprKind: {
  Unknown = 0
  Identifier = 1
  At = 2
  This = 3
  Int = 4
  Double = 5
  BigInt = 6
  String = 7
  Template = 8
  Char = 9
  Regex = 10
  XMLText = 11
  Bool = 12
  Null = 13
  Unary = 14
  Postfix = 15
  Unwrap = 16
  CompileTime = 17
  Binary = 18
  Ternary = 19
  Assign = 20
  Call = 21
  Args = 22
  Lambda = 23
  Selector = 24
  Index = 25
  Array = 26
  Tuple = 27
  Map = 28
  Entry = 29
  Spread = 30
  Reactive = 31
  Struct = 32
  Object = 33
  Field = 34
  PrivateField = 35
  Method = 36
  PrivateMethod = 37
  Block = 38
  PatternBlock = 39
  Match = 40
  Branch = 41
  Pattern = 42
  Let = 43
  ObjectDestructure = 44
  Error = 45
  Watch = 46
}

+ emptyParsedTypeRef() -> ParsedTypeRef => {
  kind: TypeRefKind.Unknown,
  name: "",
  module: "",
  nullable: false,
  args: [],
  params: [],
  returnTypes: [],
  line: 0,
  column: 0
}

+ emptyParsedTypeParam(
) -> ParsedTypeParam => {
  name: "",
  optional: false,
  typeRef: emptyParsedTypeRef()
}

+ namedParsedTypeRef(
  token: Token
) -> ParsedTypeRef => {
  kind: TypeRefKind.Name,
  name: token.lexeme,
  module: "",
  nullable: false,
  args: [],
  params: [],
  returnTypes: [],
  line: token.line,
  column: token.column
}

+ qualifiedParsedTypeRef(
  module: Token,
  name: Token
) -> ParsedTypeRef => {
  kind: TypeRefKind.Name,
  name: name.lexeme,
  module: module.lexeme,
  nullable: false,
  args: [],
  params: [],
  returnTypes: [],
  line: module.line,
  column: module.column
}

+ typeRefWithArgs(
  typeRef: ParsedTypeRef,
  args: Array[ParsedTypeRef]
) -> ParsedTypeRef => {
  kind: typeRef.kind,
  name: typeRef.name,
  module: typeRef.module,
  nullable: typeRef.nullable,
  args: args,
  params: typeRef.params,
  returnTypes: typeRef.returnTypes,
  line: typeRef.line,
  column: typeRef.column
}

+ nullableTypeRef(
  typeRef: ParsedTypeRef
) -> ParsedTypeRef => {
  kind: typeRef.kind,
  name: typeRef.name,
  module: typeRef.module,
  nullable: true,
  args: typeRef.args,
  params: typeRef.params,
  returnTypes: typeRef.returnTypes,
  line: typeRef.line,
  column: typeRef.column
}

+ groupedTypeRef(
  typeRef: ParsedTypeRef,
  token: Token
) -> ParsedTypeRef => {
  kind: TypeRefKind.Group,
  name: "",
  module: "",
  nullable: false,
  args: [typeRef],
  params: [],
  returnTypes: [],
  line: token.line,
  column: token.column
}

+ tupleTypeRef(
  params: Array[ParsedTypeParam],
  token: Token
) -> ParsedTypeRef => {
  kind: TypeRefKind.Tuple,
  name: "",
  module: "",
  nullable: false,
  args: [],
  params: params,
  returnTypes: [],
  line: token.line,
  column: token.column
}

+ functionTypeRef(
  params: Array[ParsedTypeParam],
  returnType: ParsedTypeRef,
  token: Token
) -> ParsedTypeRef => {
  kind: TypeRefKind.Function,
  name: "",
  module: "",
  nullable: false,
  args: [],
  params: params,
  returnTypes: [returnType],
  line: token.line,
  column: token.column
}

+ typeRefToString(
  typeRef: ParsedTypeRef
) -> String => typeRef.kind {
  TypeRefKind.Name => typeNameToString(typeRef)
  TypeRefKind.Group => (
    typeRef.args.length() == 0 ? "()"
      : ("(" + typeRefToString(typeRef.args[0])) + ")"
  )
  TypeRefKind.Tuple => ("(" + typeParamsToString(typeRef.params, 0, "")) + ")"
  TypeRefKind.Function => functionTypeToString(typeRef)
  _ => ""
}

typeNameToString(
  typeRef: ParsedTypeRef
) -> String => {
  prefix := (
    typeRef.module == "" ? ""
      : ("@" + typeRef.module) + "."
  )
  args := (
    typeRef.args.length() == 0 ? ""
      : ("[" + typeRefsToString(typeRef.args, 0, "")) + "]"
  )
  nullable := (
    typeRef.nullable ? "?"
      : ""
  )
  ((prefix + typeRef.name) + args) + nullable
}

functionTypeToString(
  typeRef: ParsedTypeRef
) -> String => {
  ret := (
    typeRef.returnTypes.length() == 0 ? ""
      : typeRefToString(typeRef.returnTypes[0])
  )
  (("(" + typeParamsToString(typeRef.params, 0, "")) + ")->") + ret
}

typeParamToString(
  param: ParsedTypeParam
) -> String => {
  prefix := (
    param.name == "" ? ""
      : param.name + (
        param.optional ? "?:"
          : ":"
      )
  )
  prefix + typeRefToString(param.typeRef)
}

typeRefsToString(
  refs: Array[ParsedTypeRef],
  index: Int,
  out: String
) -> String => (
  index >= refs.length() ? out
    : typeRefsToString(refs, index + 1, (out + (
      index == 0 ? ""
        : ","
    )) + typeRefToString(refs[index]))
)

typeParamsToString(
  params: Array[ParsedTypeParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : typeParamsToString(params, index + 1, (out + (
      index == 0 ? ""
        : ","
    )) + typeParamToString(params[index]))
)

+ exprKindName(kind: ExprKind) -> String => kind {
  ExprKind.Identifier => "identifier"
  ExprKind.At => "at"
  ExprKind.This => "this"
  ExprKind.Int => "int"
  ExprKind.Double => "double"
  ExprKind.BigInt => "bigint"
  ExprKind.String => "string"
  ExprKind.Template => "template"
  ExprKind.Char => "char"
  ExprKind.Regex => "regex"
  ExprKind.XMLText => "xmlText"
  ExprKind.Bool => "bool"
  ExprKind.Null => "null"
  ExprKind.Unary => "unary"
  ExprKind.Postfix => "postfix"
  ExprKind.Unwrap => "unwrap"
  ExprKind.CompileTime => "compileTime"
  ExprKind.Binary => "binary"
  ExprKind.Ternary => "ternary"
  ExprKind.Assign => "assign"
  ExprKind.Call => "call"
  ExprKind.Args => "args"
  ExprKind.Lambda => "lambda"
  ExprKind.Selector => "selector"
  ExprKind.Index => "index"
  ExprKind.Array => "array"
  ExprKind.Tuple => "tuple"
  ExprKind.Map => "map"
  ExprKind.Entry => "entry"
  ExprKind.Spread => "spread"
  ExprKind.Reactive => "reactive"
  ExprKind.Struct => "struct"
  ExprKind.Object => "object"
  ExprKind.Field => "field"
  ExprKind.PrivateField => "privateField"
  ExprKind.Method => "method"
  ExprKind.PrivateMethod => "privateMethod"
  ExprKind.Block => "block"
  ExprKind.PatternBlock => "patternBlock"
  ExprKind.Match => "match"
  ExprKind.Branch => "branch"
  ExprKind.Pattern => "pattern"
  ExprKind.Let => "let"
  ExprKind.ObjectDestructure => "objectDestructure"
  ExprKind.Error => "error"
  ExprKind.Watch => "watch"
  _ => "unknown"
}
