@"../lexer/lexer.rn"
@"../parser/parser.rn"

FormatState: {
  text: String
  indent: Int32
  lineStart: Bool
  previous: TokenKind
}

+ formatSource(source: String) -> String => {
  parsed := parse(source)
  parsed.errors.length() > 0 ? formatTokenSource(source)
    : preserveComments(source, finishFormat(formatParsedFile(parsed)))
}

formatTokenSource(source: String) -> String => {
  tokens := lex(source)
  state := formatTokens(tokens, 0, emptyFormatState())
  preserveComments(source, finishFormat(state.text))
}

formatParsedFile(file: ParsedFile) -> String => {
  imports := formatParsedImports(file.imports, 0, "")
  types := formatParsedTypes(file.types, 0, "")
  constants := formatParsedConstants(file.constants, 0, "")
  functions := formatParsedFunctions(file.functions, 0, "")
  declarations := types + ((types != "") && ((constants != "") || (functions != "")) ? "\n" : "") + constants + ((constants != "") && (functions != "") ? "\n" : "") + functions
  imports + ((imports != "") && (declarations != "") ? "\n" : "") + declarations
}

formatParsedImports(imports: Array[ParsedImport], index: Int32, out: String) -> String => (
  index >= imports.length() ? out
    : formatParsedImports(imports, index + 1, out + (imports[index].go ? "@\"go:" + imports[index].path + "\"" : (imports[index].module ? "@" + imports[index].path : "@\"" + imports[index].path + "\"")) + "\n")
)

formatParsedTypes(
  types: Array[ParsedType],
  index: Int32,
  out: String
) -> String => (
  index >= types.length() ? out
    : formatParsedTypes(types, index + 1, out + (index == 0 ? "" : "\n") + formatParsedType(types[index]) + "\n")
)

formatParsedType(typeDecl: ParsedType) -> String => {
  header := (typeDecl.private ? "" : "+ ") + typeDecl.name + formatGenericNames(typeDecl.generics, 0, "[")
  typeDecl.enum ? formatParsedEnumType(header, typeDecl.members, 0, "")
    : formatParsedStructType(header, typeDecl.fields, typeDecl.methods, 0, "")
}

formatGenericNames(generics: Array[String], index: Int32, out: String) -> String => (
  generics.length() == 0 ? ""
    : (index >= generics.length() ? out + "]" : formatGenericNames(generics, index + 1, out + generics[index] + ((index + 1) < generics.length() ? ", " : "")))
)

formatParsedStructType(
  header: String,
  fields: Array[ParsedField],
  methods: Array[ParsedFunction],
  index: Int32,
  out: String
) -> String => (
  index < fields.length() ? formatParsedStructType(header, fields, methods, index + 1, out + indentText(1) + (fields[index].private ? "- " : "") + fields[index].name + ": " + formatTypeRef(fields[index].typeRef) + "\n")
    : header + ": {\n" + out + formatParsedTypeMethods(methods, 0, "") + "}"
)

formatParsedTypeMethods(methods: Array[ParsedFunction], index: Int32, out: String) -> String => (
  index >= methods.length() ? out
    : formatParsedTypeMethods(methods, index + 1, out + (index == 0 && out != "" ? "\n" : "") + indentMultiline(formatParsedTypeMethod(methods[index]), 1) + "\n")
)

formatParsedTypeMethod(fn: ParsedFunction) -> String => {
  prefix := fn.static ? "::"
    : (fn.private ? "- " : "")
  header := prefix + fn.name + formatParams(fn.params, 0, "(") + ")" + formatReturnType(fn.returnType)
  fn.body.kind == ExprKind.Block ? header + " => {\n" + formatBlockChildren(fn.body.children, 0, 1, "") + "}"
    : header + " => " + formatExpr(fn.body, 0)
}

indentMultiline(text: String, indent: Int32) -> String => indentText(indent) + text.replaceAll("\n", "\n" + indentText(indent))

formatParsedEnumType(
  header: String,
  members: Array[ParsedEnumMember],
  index: Int32,
  out: String
) -> String => (
  index >= members.length() ? header + ": {\n" + out + "}"
    : formatParsedEnumType(header, members, index + 1, out + indentText(1) + (members[index].private ? "- " : "") + members[index].name + (members[index].value == "" ? "" : " = " + members[index].value) + "\n")
)

formatParsedConstants(
  constants: Array[ParsedConst],
  index: Int32,
  out: String
) -> String => (
  index >= constants.length() ? out
    : formatParsedConstants(constants, index + 1, out + formatParsedConstant(constants[index]) + "\n")
)

formatParsedConstant(constant: ParsedConst) -> String => (
  constant.private ? constant.name + " := " + formatExpr(constant.value, 0)
    : "+ " + constant.name + " := " + formatExpr(constant.value, 0)
)

formatParsedFunctions(
  functions: Array[ParsedFunction],
  index: Int32,
  out: String
) -> String => (
  index >= functions.length() ? out
    : formatParsedFunctions(functions, index + 1, out + (index == 0 ? "" : "\n") + formatParsedFunction(functions[index]) + "\n")
)

formatParsedFunction(fn: ParsedFunction) -> String => formatParsedAnnotations(fn.annotations, 0, "") + (fn.private ? "" : "+ ") + (fn.body.kind == ExprKind.Block ? formatFunctionBlock(fn)
  : fn.name + formatParams(fn.params, 0, "(") + ")" + formatReturnType(fn.returnType) + " => " + formatExpr(fn.body, 0))

formatParsedAnnotations(
  annotations: Array[ParsedAnnotation],
  index: Int32,
  out: String
) -> String => (
  index >= annotations.length() ? out
    : formatParsedAnnotations(annotations, index + 1, out + annotations[index].marker + (annotations[index].module == "" ? "" : annotations[index].module + ".") + annotations[index].name + "\n")
)

formatFunctionBlock(fn: ParsedFunction) -> String => {
  header := fn.name + formatParams(fn.params, 0, "(") + ")" + formatReturnType(fn.returnType) + " => {"
  header + "\n" + formatBlockChildren(fn.body.children, 0, 1, "") + "}"
}

formatParams(
  params: Array[ParsedParam],
  index: Int32,
  out: String
) -> String => (
  index >= params.length() ? out
    : formatParams(params, index + 1, params[index].typeRef.name == "" ? out + params[index].name + paramSeparator(params, index)
      : out + params[index].name + ": " + formatTypeRef(params[index].typeRef) + paramSeparator(params, index))
)

paramSeparator(params: Array[ParsedParam], index: Int32) -> String => (
  (index + 1) < params.length() ? ", "
    : ""
)

formatReturnType(typeRef: ParsedTypeRef) -> String => (
  typeRef.name == "" ? ""
    : " -> " + formatTypeRef(typeRef)
)

formatTypeRef(typeRef: ParsedTypeRef) -> String => (
  typeRef.args.length() == 0 ? typeRef.name
    : typeRef.name + "[" + formatTypeArgs(typeRef.args, 0, "") + "]"
)

formatTypeArgs(
  args: Array[ParsedTypeRef],
  index: Int32,
  out: String
) -> String => (
  index >= args.length() ? out
    : formatTypeArgs(args, index + 1, out + formatTypeRef(args[index]) + ((index + 1) < args.length() ? ", " : ""))
)

formatBlockChildren(
  children: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= children.length() ? out
    : formatBlockChildren(children, index + 1, indent, out + indentText(indent) + formatExpr(children[index], indent) + "\n")
)

formatExpr(expr: ParsedExpr, indent: Int32) -> String => expr.kind {
  ExprKind.XMLElement => formatXMLElement(expr, indent)
  ExprKind.Object => formatObjectExpr(expr, indent)
  ExprKind.Array => formatArrayExpr(expr, indent)
  ExprKind.Struct => formatStructExpr(expr, indent)
  ExprKind.Block => formatBlockExpr(expr, indent)
  ExprKind.PatternBlock => formatBlockExpr(expr, indent)
  ExprKind.Let => formatLetExpr(expr, indent)
  ExprKind.Identifier => formatIdentifierExpr(expr)
  ExprKind.String => expr.value
  ExprKind.Int => expr.value
  ExprKind.Double => expr.value
  ExprKind.Bool => expr.value
  ExprKind.Null => "null"
  ExprKind.Reactive => "$" + formatExpr(expr.children[0], indent)
  ExprKind.This => "."
  ExprKind.Assign => formatAssignExpr(expr, indent)
  ExprKind.Unary => expr.op + formatExpr(expr.children[0], indent)
  ExprKind.Spread => ".." + formatExpr(expr.children[0], indent)
  ExprKind.Index => formatExpr(expr.children[0], indent) + "[" + formatExpr(expr.children[1], indent) + "]"
  ExprKind.Binary => formatExpr(expr.children[0], indent) + " " + expr.op + " " + formatExpr(expr.children[1], indent)
  ExprKind.Ternary => expr.name == "if" ? formatIfExpr(expr, indent) : formatTernaryExpr(expr, indent)
  ExprKind.Loop => formatWhileExpr(expr, indent)
  ExprKind.Return => expr.children.length() > 0 ? "return " + formatExpr(expr.children[0], indent) : "return"
  ExprKind.Break => "^"
  ExprKind.Continue => "^>"
  ExprKind.Tuple => "(" + formatExprArgs(expr.children, 0, indent, "") + ")"
  ExprKind.Map => formatMapExpr(expr, indent)
  ExprKind.Match => expr.name == "switch" ? formatSwitchExpr(expr, indent) : formatMatchExpr(expr, indent)
  ExprKind.ObjectDestructure => formatObjectDestructureExpr(expr, indent)
  ExprKind.Watch => formatExpr(expr.children[0], indent) + " -> " + formatExpr(expr.children[1], indent)
  ExprKind.Field => expr.name + ": " + formatExpr(expr.children[0], indent)
  ExprKind.PrivateField => "- " + expr.name + ": " + formatExpr(expr.children[0], indent)
  ExprKind.Method => formatMethodExpr(expr, indent)
  ExprKind.PrivateMethod => "- " + formatMethodExpr(expr, indent)
  ExprKind.Lambda => formatLambdaExpr(expr, indent)
  ExprKind.Call => expr.name == "for" ? formatForOfExpr(expr, indent) : formatCallExpr(expr, indent)
  ExprKind.Selector => formatSelectorExpr(expr, indent)
  ExprKind.At => "@" + expr.name
  _ => formatTokenSource(expr.text)
}

formatIdentifierExpr(expr: ParsedExpr) -> String => (
  expr.op == "$" ? "$" + expr.name
    : expr.name
)

formatObjectExpr(expr: ParsedExpr, indent: Int32) -> String => {
  expr.children.length() == 0 ? "{}"
    : "{\n" + formatObjectFields(expr.children, 0, indent + 1, "") + indentText(indent) + "}"
}

formatArrayExpr(expr: ParsedExpr, indent: Int32) -> String => {
  expr.children.length() == 0 ? "[]"
    : "[\n" + formatArrayItems(expr.children, 0, indent + 1, "") + indentText(indent) + "]"
}

formatArrayItems(
  items: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= items.length() ? out
    : formatArrayItems(items, index + 1, indent, out + indentText(indent) + formatExpr(items[index], indent) + ((index + 1) < items.length() ? "," : "") + "\n")
)

formatStructExpr(expr: ParsedExpr, indent: Int32) -> String => {
  expr.children.length() == 0 ? expr.name + " {}"
    : expr.name + " {\n" + formatObjectFields(expr.children, 0, indent + 1, "") + indentText(indent) + "}"
}

formatBlockExpr(expr: ParsedExpr, indent: Int32) -> String => "{\n" + formatBlockChildren(expr.children, 0, indent + 1, "") + indentText(indent) + "}"

formatObjectFields(
  fields: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= fields.length() ? out
    : formatObjectFields(fields, index + 1, indent, out + indentText(indent) + formatObjectField(fields[index], indent) + ((index + 1) < fields.length() ? "," : "") + "\n")
)

formatObjectField(field: ParsedExpr, indent: Int32) -> String => (
  field.kind == ExprKind.Spread ? ".." + formatExpr(field.children[0], indent)
    : formatExpr(field, indent)
)

formatLetExpr(expr: ParsedExpr, indent: Int32) -> String => {
  mutable := !((expr.op == ":=") || (expr.op == "$:="))
  op := mutable ? ":=:" : ":="
  prefix := expr.op.startsWith("$") ? "$" : ""
  prefix + expr.name + " " + op + " " + formatExpr(expr.children[0], indent)
}

formatAssignExpr(expr: ParsedExpr, indent: Int32) -> String => {
  expr.children.length() >= 2 ? formatExpr(expr.children[0], indent) + " = " + formatExpr(expr.children[1], indent)
    : expr.name + " " + expr.op + " " + formatExpr(expr.children[0], indent)
}

formatTernaryExpr(expr: ParsedExpr, indent: Int32) -> String => {
  condition := formatExpr(expr.children[0], indent)
  consequence := formatExpr(expr.children[1], indent)
  expr.children.length() < 3 ? "(" + condition + " ? " + consequence + ")"
    : "(" + condition + " ? " + consequence + " : " + formatExpr(expr.children[2], indent) + ")"
}

formatIfExpr(expr: ParsedExpr, indent: Int32) -> String => {
  condition := formatExpr(expr.children[0], indent)
  thenExpr := formatExpr(expr.children[1], indent)
  elsePart := expr.children.length() >= 3 ? " else " + formatExpr(expr.children[2], indent) : ""
  "if (" + condition + ") " + thenExpr + elsePart
}

formatMapExpr(expr: ParsedExpr, indent: Int32) -> String => {
  expr.children.length() == 0 ? "{}"
    : "{\n" + formatMapEntries(expr.children, 0, indent + 1, "") + indentText(indent) + "}"
}

formatMapEntries(entries: Array[ParsedExpr], index: Int32, indent: Int32, out: String) -> String => (
  index >= entries.length() ? out
    : formatMapEntries(entries, index + 1, indent, out + indentText(indent) + formatExpr(entries[index].children[0], indent) + ": " + formatExpr(entries[index].children[1], indent) + ((index + 1) < entries.length() ? "," : "") + "\n")
)

formatMatchExpr(expr: ParsedExpr, indent: Int32) -> String => {
  subject := formatExpr(expr.children[0], indent)
  subject + " {\n" + formatMatchBranches(expr.children, 1, indent + 1, "") + indentText(indent) + "}"
}

formatSwitchExpr(expr: ParsedExpr, indent: Int32) -> String => {
  subject := formatExpr(expr.children[0], indent)
  "switch (" + subject + ") {\n" + formatSwitchBranches(expr.children, 1, indent + 1, "") + indentText(indent) + "}"
}

formatSwitchBranches(
  children: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= children.length() ? out
    : formatSwitchBranches(children, index + 1, indent, out + formatSwitchBranch(children[index], indent))
)

formatSwitchBranch(branch: ParsedExpr, indent: Int32) -> String => {
  label := branch.text == "_" ? "default" : "case " + branch.text
  indentText(indent) + label + ": " + formatExpr(branch.children[1], indent) + "\n"
}

formatForOfExpr(expr: ParsedExpr, indent: Int32) -> String => {
  selector := expr.children[0]
  lambda := expr.children[1]
  name := lambda.params[0].name
  "for (const " + name + " of " + formatExpr(selector.children[0], indent) + ") " + formatExpr(lambda.children[0], indent)
}

formatWhileExpr(expr: ParsedExpr, indent: Int32) -> String => (
  "* (" + formatExpr(expr.children[0], indent) + ") " + formatExpr(expr.children[1], indent)
)

formatMatchBranches(children: Array[ParsedExpr], index: Int32, indent: Int32, out: String) -> String => (
  index >= children.length() ? out
    : formatMatchBranches(children, index + 1, indent, out + indentText(indent) + children[index].children[0].text + " => " + formatExpr(children[index].children[1], indent) + "\n")
)

formatObjectDestructureExpr(expr: ParsedExpr, indent: Int32) -> String => "{ " + formatObjectDestructureParams(expr.params, 0, "") + " } " + expr.op + " " + formatExpr(expr.children[0], indent)

formatObjectDestructureParams(params: Array[ParsedParam], index: Int32, out: String) -> String => (
  index >= params.length() ? out
    : formatObjectDestructureParams(params, index + 1, out + (params[index].typeRef.name == params[index].name ? params[index].name : params[index].typeRef.name + ": " + params[index].name) + ((index + 1) < params.length() ? ", " : ""))
)

formatMethodExpr(expr: ParsedExpr, indent: Int32) -> String => {
  header := expr.name + formatParams(expr.params, 0, "(") + ")" + (expr.text == "" ? "" : " -> " + expr.text) + " => "
  body := expr.children[0]
  body.kind == ExprKind.Block ? header + formatBlockExpr(body, indent)
    : header + formatExpr(body, indent)
}

formatLambdaExpr(expr: ParsedExpr, indent: Int32) -> String => {
  header := "(" + formatLambdaParams(expr.params, 0, "") + ")" + formatLambdaReturnType(expr.text) + " => "
  body := expr.children[0]
  body.kind == ExprKind.XMLElement ? header + "(\n" + indentText(indent + 1) + formatExpr(body, indent + 1) + "\n" + indentText(indent) + ")"
    : header + formatExpr(body, indent)
}

formatLambdaParams(
  params: Array[ParsedParam],
  index: Int32,
  out: String
) -> String => (
  index >= params.length() ? out
    : formatLambdaParams(params, index + 1, out + params[index].name + (params[index].typeRef.name == "" ? "" : ": " + formatTypeRef(params[index].typeRef)) + ((index + 1) < params.length() ? ", " : ""))
)

formatLambdaReturnType(typeName: String) -> String => (
  typeName == "" ? ""
    : " -> " + typeName
)

formatCallExpr(expr: ParsedExpr, indent: Int32) -> String => formatExpr(expr.children[0], indent) + "(" + formatExprArgs(expr.children, 1, indent, "") + ")"

formatExprArgs(
  children: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= children.length() ? out
    : formatExprArgs(children, index + 1, indent, out + formatExpr(children[index], indent) + ((index + 1) < children.length() ? ", " : ""))
)

formatSelectorExpr(expr: ParsedExpr, indent: Int32) -> String => (
  expr.children[0].kind == ExprKind.This ? "." + expr.name
    : formatExpr(expr.children[0], indent) + expr.op + expr.name
)

formatXMLElement(element: ParsedExpr, indent: Int32) -> String => {
  attrs := formatXMLAttributes(element.children, 0, indent, "")
  children := xmlChildren(element.children, 0, [])
  children.length() == 0 ? formatXMLSelfClosing(element, attrs, indent)
    : formatXMLElementWithChildren(element, attrs, children, indent)
}

formatXMLSelfClosing(element: ParsedExpr, attrs: String, indent: Int32) -> String => {
  singleLine := "<" + element.name + attrs + " />"
  (xmlAttributeCount(element.children, 0) <= 1) || xmlLineFits(singleLine, indent) ? singleLine
    : "<" + element.name + formatXMLAttributesMultiline(element.children, 0, indent + 1, "") + "\n" + indentText(indent) + "/>"
}

xmlAttributeCount(children: Array[ParsedExpr], index: Int32) -> Int32 => (
  index >= children.length() ? 0
    : (isXMLAttribute(children[index]) ? 1 : 0) + xmlAttributeCount(children, index + 1)
)

formatXMLAttributesMultiline(
  children: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= children.length() ? out
    : (
      isXMLAttribute(children[index]) ? formatXMLAttributesMultiline(children, index + 1, indent, out + "\n" + indentText(indent) + formatXMLAttribute(children[index], indent))
        : formatXMLAttributesMultiline(children, index + 1, indent, out)
    )
)

xmlLineFits(line: String, indent: Int32) -> Bool => (
  indentText(indent).length() + line.length() <= 80
)

formatXMLAttributes(
  children: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= children.length() ? out
    : (
      isXMLAttribute(children[index]) ? formatXMLAttributes(children, index + 1, indent, out + " " + formatXMLAttribute(children[index], indent))
        : formatXMLAttributes(children, index + 1, indent, out)
    )
)

isXMLAttribute(expr: ParsedExpr) -> Bool => (expr.op == "xmlSpread") || ((expr.kind == ExprKind.Field) && ((expr.op == "xmlAttr") || (expr.op == "xmlEvent") || (expr.op == "xmlBareAttr")))

formatXMLAttribute(attr: ParsedExpr, indent: Int32) -> String => {
  attr.op == "xmlSpread" ? "{..." + formatExpr(attr.children[0], indent) + "}"
    : formatNamedXMLAttribute(attr, indent)
}

formatNamedXMLAttribute(attr: ParsedExpr, indent: Int32) -> String => {
  name := attr.op == "xmlEvent" ? "@" + attr.name
    : attr.name
  attr.children.length() == 0 ? name
    : formatNamedXMLAttributeValue(name, attr.children[0], indent)
}

formatNamedXMLAttributeValue(
  name: String,
  value: ParsedExpr,
  indent: Int32
) -> String => (
  value.kind == ExprKind.String ? name + "=" + value.value
    : name + "={" + formatXMLAttributeValue(value, indent) + "}"
)

formatXMLAttributeValue(value: ParsedExpr, indent: Int32) -> String => value.kind {
  ExprKind.Object => formatObjectExpr(value, indent)
  _ => formatExpr(value, indent)
}

xmlChildren(
  children: Array[ParsedExpr],
  index: Int32,
  out: Array[ParsedExpr]
) -> Array[ParsedExpr] => (
  index >= children.length() ? out
    : (
      isXMLAttribute(children[index]) ? xmlChildren(children, index + 1, out)
        : xmlChildren(children, index + 1, [..out, children[index]])
    )
)

formatXMLElementWithChildren(
  element: ParsedExpr,
  attrs: String,
  children: Array[ParsedExpr],
  indent: Int32
) -> String => {
  single := children.length() == 1
  inline := single && (children[0].kind == ExprKind.XMLText)
  inline ? "<" + element.name + attrs + ">" + children[0].value + "</" + element.name + ">"
    : formatMultilineXMLElement(element, attrs, children, indent)
}

formatMultilineXMLElement(
  element: ParsedExpr,
  attrs: String,
  children: Array[ParsedExpr],
  indent: Int32
) -> String => "<" + element.name + attrs + ">\n" + formatXMLChildren(children, 0, indent + 1, "") + indentText(indent) + "</" + element.name + ">"

formatXMLChildren(
  children: Array[ParsedExpr],
  index: Int32,
  indent: Int32,
  out: String
) -> String => (
  index >= children.length() ? out
    : formatXMLChildren(children, index + 1, indent, out + indentText(indent) + formatXMLChild(children[index], indent) + "\n")
)

formatXMLChild(child: ParsedExpr, indent: Int32) -> String => child.kind {
  ExprKind.XMLElement => formatXMLElement(child, indent)
  ExprKind.XMLText => child.value
  _ => "{" + formatExpr(child, indent) + "}"
}

emptyFormatState() -> FormatState => {
  text: "",
  indent: 0,
  lineStart: true,
  previous: TokenKind.EOF
}

formatTokens(
  tokens: Array[Token],
  index: Int32,
  state: FormatState
) -> FormatState => {
  done := index >= tokens.length()
  done {
    true => state
    _ => formatTokens(tokens, index + 1, formatToken(state, tokens[index]))
  }
}

formatToken(
  state: FormatState,
  token: Token
) -> FormatState => token.kind {
  TokenKind.EOF => state
  TokenKind.Newline => formatNewline(state)
  TokenKind.LBrace => formatOpenBrace(state)
  TokenKind.RBrace => formatCloseBrace(state)
  TokenKind.Comma => formatPunctuation(state, ", ", TokenKind.Comma)
  TokenKind.Semicolon => formatNewline(state)
  TokenKind.Colon => formatPunctuation(state, ": ", TokenKind.Colon)
  TokenKind.At => formatPunctuation(state, "@", TokenKind.At)
  TokenKind.Dot => formatPunctuation(state, ".", TokenKind.Dot)
  TokenKind.DoubleColon => formatPunctuation(state, "::", TokenKind.DoubleColon)
  TokenKind.Question => formatPunctuation(state, "?", TokenKind.Question)
  TokenKind.QuestionQuestion => formatPunctuation(state, "??", TokenKind.QuestionQuestion)
  TokenKind.Apostrophe => formatPunctuation(state, "'", TokenKind.Apostrophe)
  TokenKind.LParen => formatPunctuation(state, "(", TokenKind.LParen)
  TokenKind.RParen => formatPunctuation(state, ")", TokenKind.RParen)
  TokenKind.LBracket => formatPunctuation(state, "[", TokenKind.LBracket)
  TokenKind.RBracket => formatPunctuation(state, "]", TokenKind.RBracket)
  _ => formatWord(state, token)
}

formatNewline(
  state: FormatState
) -> FormatState => (
  state.lineStart ? state
    : FormatState {
      text: trimTrailingSpace(state.text) + "\n",
      indent: state.indent,
      lineStart: true,
      previous: state.previous
    }
)

formatOpenBrace(
  state: FormatState
) -> FormatState => {
  text := ensureSpace(state.text, state.lineStart)
  FormatState {
    text: text + "{\n",
    indent: state.indent + 1,
    lineStart: true,
    previous: TokenKind.LBrace
  }
}

formatCloseBrace(
  state: FormatState
) -> FormatState => {
  indent := (
    state.indent > 0 ? state.indent - 1
      : 0
  )
  text := trimTrailingSpace(state.text)
  text = (
    text.endsWith("\n") ? text
      : text + "\n"
  )
  FormatState {
    text: (text + indentText(indent)) + "}",
    indent: indent,
    lineStart: false,
    previous: TokenKind.RBrace
  }
}

formatPunctuation(
  state: FormatState,
  text: String,
  kind: TokenKind
) -> FormatState => {
  text: prefixIndent(state.text, state.indent, state.lineStart) + text,
  indent: state.indent,
  lineStart: false,
  previous: kind
}

formatWord(
  state: FormatState,
  token: Token
) -> FormatState => {
  prefix := prefixIndent(state.text, state.indent, state.lineStart)
  separated := needsSpace(state.previous, token.kind) && !state.lineStart
  FormatState {
    text: (
      separated ? ensureSpace(prefix, false)
        : prefix
    ) + token.lexeme,
    indent: state.indent,
    lineStart: false,
    previous: token.kind
  }
}

needsSpace(
  previous: TokenKind,
  current: TokenKind
) -> Bool => (isBinaryOperator(previous) || isBinaryOperator(current)) || ((((previous != TokenKind.At) && (previous != TokenKind.Dot)) && (previous != TokenKind.DoubleColon)) && (endsWord(previous) && startsWord(current)))

endsWord(kind: TokenKind) -> Bool => isTokenIn(kind, [TokenKind.Ident, TokenKind.Int, TokenKind.Double, TokenKind.BigInt, TokenKind.String, TokenKind.Char, TokenKind.Regex, TokenKind.TemplateString, TokenKind.RParen, TokenKind.RBracket])

startsWord(kind: TokenKind) -> Bool => isTokenIn(kind, [TokenKind.Ident, TokenKind.Int, TokenKind.Double, TokenKind.BigInt, TokenKind.String, TokenKind.Char, TokenKind.Regex, TokenKind.TemplateString, TokenKind.At, TokenKind.Dollar])

isBinaryOperator(
  kind: TokenKind
) -> Bool => isTokenIn(kind, [TokenKind.FatArrow, TokenKind.Arrow, TokenKind.Assign, TokenKind.Declare, TokenKind.MutDeclare, TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.EqualEqual, TokenKind.BangEqual, TokenKind.Less, TokenKind.LessEqual, TokenKind.Greater, TokenKind.GreaterEqual, TokenKind.AndAnd, TokenKind.OrOr, TokenKind.QuestionQuestion, TokenKind.BitAnd, TokenKind.BitOr, TokenKind.BitXor, TokenKind.ShiftLeft, TokenKind.ShiftRight, TokenKind.UnsignedShiftRight])

isTokenIn(
  kind: TokenKind,
  kinds: Array[TokenKind]
) -> Bool => isTokenInAt(kind, kinds, 0)

isTokenInAt(
  kind: TokenKind,
  kinds: Array[TokenKind],
  index: Int32
) -> Bool => (
  index >= kinds.length() ? false
    : (
      kind == kinds[index] ? true
        : isTokenInAt(kind, kinds, index + 1)
    )
)

prefixIndent(
  text: String,
  indent: Int32,
  lineStart: Bool
) -> String => (
  lineStart ? text + indentText(indent)
    : text
)

ensureSpace(
  text: String,
  lineStart: Bool
) -> String => (
  ((lineStart || text.isEmpty()) || text.endsWith(" ")) || text.endsWith("\n") ? text
    : text + " "
)

trimTrailingSpace(
  text: String
) -> String => (
  text.endsWith(" ") ? trimTrailingSpace(text.slice(0, text.length() - 1))
    : text
)

indentText(indent: Int32) -> String => (
  indent <= 0 ? ""
    : "  " + indentText(indent - 1)
)

preserveComments(
  source: String,
  formatted: String
) -> String => preserveCommentLines(formatted.split("\n"), source.split("\n"), 0, "")

preserveCommentLines(
  formatted: Array[String],
  source: Array[String],
  index: Int32,
  out: String
) -> String => (
  index >= formatted.length() ? out
    : preserveCommentLines(formatted, source, index + 1, (out + preserveCommentLine(formatted[index], source, 0)) + (
      (index + 1) < formatted.length() ? "\n"
        : ""
    ))
)

preserveCommentLine(
  formatted: String,
  source: Array[String],
  index: Int32
) -> String => {
  comment := findInlineComment(source, canonicalLine(formatted), index)
  (
    comment == "" ? formatted
      : (formatted + " ") + comment
  )
}

findInlineComment(
  source: Array[String],
  formatted: String,
  index: Int32
) -> String => (
  index >= source.length() ? ""
    : inlineCommentForLine(source[index], formatted, source, index)
)

inlineCommentForLine(
  line: String,
  formatted: String,
  source: Array[String],
  index: Int32
) -> String => {
  commentStart := firstCommentStart(line)
  (
    commentStart < 0 ? findInlineComment(source, formatted, index + 1)
      : (
        canonicalLine(line.slice(0, commentStart)) == formatted ? line.slice(commentStart, line.length()).trim()
          : findInlineComment(source, formatted, index + 1)
      )
  )
}

firstCommentStart(line: String) -> Int32 => line.indexOf("//")

canonicalLine(line: String) -> String => line.trim().replaceAll(" ", "").replaceAll("\t", "").replaceAll("\r", "")

finishFormat(text: String) -> String => {
  trimmed := trimTrailingSpace(text)
  (
    trimmed.endsWith("\n") ? trimmed
      : trimmed + "\n"
  )
}
