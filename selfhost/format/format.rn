@"../lexer/lexer.rn"
@"../parser/parser.rn"

FormatState: {
  text: String
  indent: Int
  lineStart: Bool
  previous: TokenKind
}

+ formatSource(source: String) -> String => {
  parsed := parse(source)
  parsed.errors.length() > 0 ? formatTokenSource(source)
    : preserveComments(source, finishFormat(formatParsedFile(parsed)))
}

formatTokenSource(source: String) -> String => {
  tokens := lex(source)
  state := formatTokens(tokens, 0, emptyFormatState())
  preserveComments(source, finishFormat(state.text))
}

formatParsedFile(file: ParsedFile) -> String => formatParsedFunctions(file.functions, 0, "")

formatParsedFunctions(
  functions: Array[ParsedFunction],
  index: Int,
  out: String
) -> String => (
  index >= functions.length() ? out
    : formatParsedFunctions(functions, index + 1, out + formatParsedFunction(functions[index]) + "\n")
)

formatParsedFunction(fn: ParsedFunction) -> String => (
  fn.body.kind == ExprKind.Block ? formatFunctionBlock(fn)
    : fn.name + formatParams(fn.params, 0, "(") + ")" + formatReturnType(fn.returnType) + " => " + formatExpr(fn.body, 0)
)

formatFunctionBlock(fn: ParsedFunction) -> String => {
  header := fn.name + formatParams(fn.params, 0, "(") + ")" + formatReturnType(fn.returnType) + " => {"
  header + "\n" + formatBlockChildren(fn.body.children, 0, 1, "") + "}"
}

formatParams(
  params: Array[ParsedParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : formatParams(params, index + 1, params[index].typeRef.name == "" ? out + params[index].name + paramSeparator(params, index)
      : out + params[index].name + ": " + formatTypeRef(params[index].typeRef) + paramSeparator(params, index))
)

paramSeparator(params: Array[ParsedParam], index: Int) -> String => (
  (index + 1) < params.length() ? ", "
    : ""
)

formatReturnType(typeRef: ParsedTypeRef) -> String => (
  typeRef.name == "" ? ""
    : " -> " + formatTypeRef(typeRef)
)

formatTypeRef(typeRef: ParsedTypeRef) -> String => (
  typeRef.args.length() == 0 ? typeRef.name
    : typeRef.name + "[" + formatTypeArgs(typeRef.args, 0, "") + "]"
)

formatTypeArgs(
  args: Array[ParsedTypeRef],
  index: Int,
  out: String
) -> String => (
  index >= args.length() ? out
    : formatTypeArgs(args, index + 1, out + formatTypeRef(args[index]) + ((index + 1) < args.length() ? ", " : ""))
)

formatBlockChildren(
  children: Array[ParsedExpr],
  index: Int,
  indent: Int,
  out: String
) -> String => (
  index >= children.length() ? out
    : formatBlockChildren(children, index + 1, indent, out + indentText(indent) + formatExpr(children[index], indent) + "\n")
)

formatExpr(expr: ParsedExpr, indent: Int) -> String => expr.kind {
  ExprKind.XMLElement => formatXMLElement(expr, indent)
  ExprKind.Object => formatObjectExpr(expr, indent)
  ExprKind.Let => formatLetExpr(expr, indent)
  ExprKind.Identifier => formatIdentifierExpr(expr)
  ExprKind.String => expr.value
  ExprKind.Int => expr.value
  ExprKind.Double => expr.value
  ExprKind.Bool => expr.value
  ExprKind.Null => "null"
  ExprKind.Reactive => "$" + formatExpr(expr.children[0], indent)
  ExprKind.Assign => formatAssignExpr(expr, indent)
  ExprKind.Binary => formatExpr(expr.children[0], indent) + " " + expr.op + " " + formatExpr(expr.children[1], indent)
  ExprKind.Lambda => "() => " + formatExpr(expr.children[0], indent)
  ExprKind.Call => formatCallExpr(expr, indent)
  ExprKind.Selector => formatSelectorExpr(expr, indent)
  ExprKind.At => "@" + expr.name
  _ => formatTokenSource(expr.text)
}

formatIdentifierExpr(expr: ParsedExpr) -> String => (
  expr.op == "$" ? "$" + expr.name
    : expr.name
)

formatObjectExpr(expr: ParsedExpr, indent: Int) -> String => {
  expr.children.length() == 0 ? "{}"
    : "{\n" + formatObjectFields(expr.children, 0, indent + 1, "") + indentText(indent) + "}"
}

formatObjectFields(
  fields: Array[ParsedExpr],
  index: Int,
  indent: Int,
  out: String
) -> String => (
  index >= fields.length() ? out
    : formatObjectFields(fields, index + 1, indent, out + indentText(indent) + fields[index].name + ": " + formatExpr(fields[index].children[0], indent) + ((index + 1) < fields.length() ? "," : "") + "\n")
)

formatLetExpr(expr: ParsedExpr, indent: Int) -> String => expr.name + " := " + formatExpr(expr.children[0], indent)

formatAssignExpr(expr: ParsedExpr, indent: Int) -> String => formatExpr(expr.children[0], indent) + " = " + formatExpr(expr.children[1], indent)

formatCallExpr(expr: ParsedExpr, indent: Int) -> String => formatExpr(expr.children[0], indent) + "(" + formatExprArgs(expr.children, 1, indent, "") + ")"

formatExprArgs(
  children: Array[ParsedExpr],
  index: Int,
  indent: Int,
  out: String
) -> String => (
  index >= children.length() ? out
    : formatExprArgs(children, index + 1, indent, out + formatExpr(children[index], indent) + ((index + 1) < children.length() ? ", " : ""))
)

formatSelectorExpr(expr: ParsedExpr, indent: Int) -> String => formatExpr(expr.children[0], indent) + expr.op + expr.name

formatXMLElement(element: ParsedExpr, indent: Int) -> String => {
  attrs := formatXMLAttributes(element.children, 0, "")
  children := xmlChildren(element.children, 0, [])
  children.length() == 0 ? "<" + element.name + attrs + " />"
    : formatXMLElementWithChildren(element, attrs, children, indent)
}

formatXMLAttributes(
  children: Array[ParsedExpr],
  index: Int,
  out: String
) -> String => (
  index >= children.length() ? out
    : (
      isXMLAttribute(children[index]) ? formatXMLAttributes(children, index + 1, out + " " + formatXMLAttribute(children[index]))
        : formatXMLAttributes(children, index + 1, out)
    )
)

isXMLAttribute(expr: ParsedExpr) -> Bool => (expr.kind == ExprKind.Field) && ((expr.op == "xmlAttr") || (expr.op == "xmlEvent") || (expr.op == "xmlBareAttr"))

formatXMLAttribute(attr: ParsedExpr) -> String => {
  name := attr.op == "xmlEvent" ? "@" + attr.name
    : attr.name
  attr.children.length() == 0 ? name
    : name + "={" + formatExpr(attr.children[0], 2) + "}"
}

xmlChildren(
  children: Array[ParsedExpr],
  index: Int,
  out: Array[ParsedExpr]
) -> Array[ParsedExpr] => (
  index >= children.length() ? out
    : (
      isXMLAttribute(children[index]) ? xmlChildren(children, index + 1, out)
        : xmlChildren(children, index + 1, [..out, children[index]])
    )
)

formatXMLElementWithChildren(
  element: ParsedExpr,
  attrs: String,
  children: Array[ParsedExpr],
  indent: Int
) -> String => {
  single := children.length() == 1
  inline := single && (children[0].kind == ExprKind.XMLText)
  inline ? "<" + element.name + attrs + ">" + children[0].value + "</" + element.name + ">"
    : formatMultilineXMLElement(element, attrs, children, indent)
}

formatMultilineXMLElement(
  element: ParsedExpr,
  attrs: String,
  children: Array[ParsedExpr],
  indent: Int
) -> String => "<" + element.name + attrs + ">\n" + formatXMLChildren(children, 0, indent + 1, "") + indentText(indent) + "</" + element.name + ">"

formatXMLChildren(
  children: Array[ParsedExpr],
  index: Int,
  indent: Int,
  out: String
) -> String => (
  index >= children.length() ? out
    : formatXMLChildren(children, index + 1, indent, out + indentText(indent) + formatXMLChild(children[index], indent) + "\n")
)

formatXMLChild(child: ParsedExpr, indent: Int) -> String => child.kind {
  ExprKind.XMLElement => formatXMLElement(child, indent)
  ExprKind.XMLText => child.value
  _ => "{" + formatExpr(child, indent) + "}"
}

emptyFormatState() -> FormatState => {
  text: "",
  indent: 0,
  lineStart: true,
  previous: TokenKind.EOF
}

formatTokens(
  tokens: Array[Token],
  index: Int,
  state: FormatState
) -> FormatState => {
  done := index >= tokens.length()
  done {
    true => state
    _ => formatTokens(tokens, index + 1, formatToken(state, tokens[index]))
  }
}

formatToken(
  state: FormatState,
  token: Token
) -> FormatState => token.kind {
  TokenKind.EOF => state
  TokenKind.Newline => formatNewline(state)
  TokenKind.LBrace => formatOpenBrace(state)
  TokenKind.RBrace => formatCloseBrace(state)
  TokenKind.Comma => formatPunctuation(state, ", ", TokenKind.Comma)
  TokenKind.Semicolon => formatNewline(state)
  TokenKind.Colon => formatPunctuation(state, ": ", TokenKind.Colon)
  TokenKind.At => formatPunctuation(state, "@", TokenKind.At)
  TokenKind.Dot => formatPunctuation(state, ".", TokenKind.Dot)
  TokenKind.DoubleColon => formatPunctuation(state, "::", TokenKind.DoubleColon)
  TokenKind.Question => formatPunctuation(state, "?", TokenKind.Question)
  TokenKind.QuestionQuestion => formatPunctuation(state, "??", TokenKind.QuestionQuestion)
  TokenKind.Apostrophe => formatPunctuation(state, "'", TokenKind.Apostrophe)
  TokenKind.LParen => formatPunctuation(state, "(", TokenKind.LParen)
  TokenKind.RParen => formatPunctuation(state, ")", TokenKind.RParen)
  TokenKind.LBracket => formatPunctuation(state, "[", TokenKind.LBracket)
  TokenKind.RBracket => formatPunctuation(state, "]", TokenKind.RBracket)
  _ => formatWord(state, token)
}

formatNewline(
  state: FormatState
) -> FormatState => (
  state.lineStart ? state
    : FormatState {
      text: trimTrailingSpace(state.text) + "\n",
      indent: state.indent,
      lineStart: true,
      previous: state.previous
    }
)

formatOpenBrace(
  state: FormatState
) -> FormatState => {
  text := ensureSpace(state.text, state.lineStart)
  FormatState {
    text: text + "{\n",
    indent: state.indent + 1,
    lineStart: true,
    previous: TokenKind.LBrace
  }
}

formatCloseBrace(
  state: FormatState
) -> FormatState => {
  indent := (
    state.indent > 0 ? state.indent - 1
      : 0
  )
  text := trimTrailingSpace(state.text)
  text = (
    text.endsWith("\n") ? text
      : text + "\n"
  )
  FormatState {
    text: (text + indentText(indent)) + "}",
    indent: indent,
    lineStart: false,
    previous: TokenKind.RBrace
  }
}

formatPunctuation(
  state: FormatState,
  text: String,
  kind: TokenKind
) -> FormatState => {
  text: prefixIndent(state.text, state.indent, state.lineStart) + text,
  indent: state.indent,
  lineStart: false,
  previous: kind
}

formatWord(
  state: FormatState,
  token: Token
) -> FormatState => {
  prefix := prefixIndent(state.text, state.indent, state.lineStart)
  separated := needsSpace(state.previous, token.kind) && !state.lineStart
  FormatState {
    text: (
      separated ? ensureSpace(prefix, false)
        : prefix
    ) + token.lexeme,
    indent: state.indent,
    lineStart: false,
    previous: token.kind
  }
}

needsSpace(
  previous: TokenKind,
  current: TokenKind
) -> Bool => (isBinaryOperator(previous) || isBinaryOperator(current)) || ((((previous != TokenKind.At) && (previous != TokenKind.Dot)) && (previous != TokenKind.DoubleColon)) && (endsWord(previous) && startsWord(current)))

endsWord(kind: TokenKind) -> Bool => isTokenIn(kind, [TokenKind.Ident, TokenKind.Int, TokenKind.Double, TokenKind.BigInt, TokenKind.String, TokenKind.Char, TokenKind.Regex, TokenKind.TemplateString, TokenKind.RParen, TokenKind.RBracket])

startsWord(kind: TokenKind) -> Bool => isTokenIn(kind, [TokenKind.Ident, TokenKind.Int, TokenKind.Double, TokenKind.BigInt, TokenKind.String, TokenKind.Char, TokenKind.Regex, TokenKind.TemplateString, TokenKind.At, TokenKind.Dollar])

isBinaryOperator(
  kind: TokenKind
) -> Bool => isTokenIn(kind, [TokenKind.FatArrow, TokenKind.Arrow, TokenKind.Assign, TokenKind.Declare, TokenKind.MutDeclare, TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent, TokenKind.EqualEqual, TokenKind.BangEqual, TokenKind.Less, TokenKind.LessEqual, TokenKind.Greater, TokenKind.GreaterEqual, TokenKind.AndAnd, TokenKind.OrOr, TokenKind.QuestionQuestion, TokenKind.BitAnd, TokenKind.BitOr, TokenKind.BitXor, TokenKind.ShiftLeft, TokenKind.ShiftRight, TokenKind.UnsignedShiftRight])

isTokenIn(
  kind: TokenKind,
  kinds: Array[TokenKind]
) -> Bool => isTokenInAt(kind, kinds, 0)

isTokenInAt(
  kind: TokenKind,
  kinds: Array[TokenKind],
  index: Int
) -> Bool => (
  index >= kinds.length() ? false
    : (
      kind == kinds[index] ? true
        : isTokenInAt(kind, kinds, index + 1)
    )
)

prefixIndent(
  text: String,
  indent: Int,
  lineStart: Bool
) -> String => (
  lineStart ? text + indentText(indent)
    : text
)

ensureSpace(
  text: String,
  lineStart: Bool
) -> String => (
  ((lineStart || text.isEmpty()) || text.endsWith(" ")) || text.endsWith("\n") ? text
    : text + " "
)

trimTrailingSpace(
  text: String
) -> String => (
  text.endsWith(" ") ? trimTrailingSpace(text.slice(0, text.length() - 1))
    : text
)

indentText(indent: Int) -> String => (
  indent <= 0 ? ""
    : "  " + indentText(indent - 1)
)

preserveComments(
  source: String,
  formatted: String
) -> String => preserveCommentLines(formatted.split("\n"), source.split("\n"), 0, "")

preserveCommentLines(
  formatted: Array[String],
  source: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= formatted.length() ? out
    : preserveCommentLines(formatted, source, index + 1, (out + preserveCommentLine(formatted[index], source, 0)) + (
      (index + 1) < formatted.length() ? "\n"
        : ""
    ))
)

preserveCommentLine(
  formatted: String,
  source: Array[String],
  index: Int
) -> String => {
  comment := findInlineComment(source, canonicalLine(formatted), index)
  (
    comment == "" ? formatted
      : (formatted + " ") + comment
  )
}

findInlineComment(
  source: Array[String],
  formatted: String,
  index: Int
) -> String => (
  index >= source.length() ? ""
    : inlineCommentForLine(source[index], formatted, source, index)
)

inlineCommentForLine(
  line: String,
  formatted: String,
  source: Array[String],
  index: Int
) -> String => {
  commentStart := firstCommentStart(line)
  (
    commentStart < 0 ? findInlineComment(source, formatted, index + 1)
      : (
        canonicalLine(line.slice(0, commentStart)) == formatted ? line.slice(commentStart, line.length()).trim()
          : findInlineComment(source, formatted, index + 1)
      )
  )
}

firstCommentStart(line: String) -> Int => line.indexOf("//")

canonicalLine(line: String) -> String => line.trim().replaceAll(" ", "").replaceAll("\t", "").replaceAll("\r", "")

finishFormat(text: String) -> String => {
  trimmed := trimTrailingSpace(text)
  (
    trimmed.endsWith("\n") ? trimmed
      : trimmed + "\n"
  )
}
