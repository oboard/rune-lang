@"../ir/ir.rn"

RuntimeField: {
  name: String
  value: RuntimeValue
}

RuntimeEntry: {
  key: RuntimeValue
  value: RuntimeValue
}

+ RuntimeValue: {
  Void
  Null
  Bool(value: Bool)
  Int(value: Int, typeName: String)
  Double(value: Double, text: String, typeName: String)
  String(value: String, typeName: String)
  Char(value: Char)
  Array(values: Array[RuntimeValue])
  Tuple(values: Array[RuntimeValue])
  Map(entries: Array[RuntimeEntry])
  Set(entries: Array[RuntimeEntry])
  Struct(typeName: String, fields: Array[RuntimeField])
  Module(name: String)
  Closure(index: Int)
  Enum(typeName: String, name: String, value: Int, payload: Array[RuntimeValue])
}

RuntimeBinding: {
  name: String
  value: RuntimeValue
}

RuntimeEnv: {
  bindings: Map[Int, RuntimeBinding]
  bindingCount: Map[String, Int]
}

PatternMatchResult: {
  matched: Bool
  env: RuntimeEnv
}

RuntimeClosure: {
  params: Array[IRParam]
  body: IRExpr
  env: RuntimeEnv
}

EvalResult: {
  ok: Bool
  error: String
  value: RuntimeValue
}

EvalArgsResult: {
  ok: Bool
  error: String
  values: Array[RuntimeValue]
}

EnumConstructorLookup: {
  found: Bool
  typeName: String
  member: IREnumMember
}

NativeCallResult: {
  handled: Bool
  result: EvalResult
}

BytesSetResult: {
  values: Array[RuntimeValue]
  value: RuntimeValue
}

ReceiverMethodResult: {
  receiver: RuntimeValue
  value: RuntimeValue
}

JsonParseResult: {
  ok: Bool
  value: RuntimeValue
  index: Int
  error: String
}

CliParseState: {
  values: RuntimeValue
  flags: RuntimeValue
  positionals: RuntimeValue
  positionalValues: Array[RuntimeValue]
  explicitOptions: Array[RuntimeValue]
  rest: Array[RuntimeValue]
  help: Bool
  error: String
}

EnvLookup: {
  found: Bool
  value: RuntimeValue
}

FieldLookup: {
  found: Bool
  value: RuntimeValue
}

Interpreter: {
  file: IRFile
  functions: Array[IRFunction]
  structs: Array[IRStructType]
  enums: Array[IREnumType]
  closures: Map[Int, RuntimeClosure]
  closureCount: Map[String, Int]
  output: Array[String]
  outputLog: Map[Int, String]
  outputCount: Map[String, Int]
  fsFiles: Map[String, String]
  fsFileBytes: Map[String, Array[RuntimeValue]]
  fsFileExists: Map[String, Bool]
  fsDirs: Map[String, Bool]
}

+ InterpretResult: {
  ok: Bool
  error: String
  value: RuntimeValue
  output: Array[String]
  interpreter: Interpreter
}

RuntimeValueKind: {
  Void = 0
  Null = 1
  Bool = 2
  Int = 3
  Double = 4
  String = 5
  Char = 6
  Array = 7
  Tuple = 8
  Map = 9
  Set = 10
  Struct = 11
  Module = 12
  Closure = 13
  Enum = 14
}

+ interpret(
  source: String
) -> InterpretResult => {
  file := lower(source)
  interpreter := newInterpreter(file)
  result := (
    file.errors.length() > 0 ? errorResult(file.errors[0].message)
      : runMain(interpreter)
  )
  InterpretResult {
    ok: result.ok,
    error: result.error,
    value: result.value,
    output: interpreterOutput(interpreter),
    interpreter: snapshotInterpreter(interpreter)
  }
}

+ interpretTest(
  source: String,
  name: String
) -> InterpretResult => {
  file := lower(source)
  interpreter := newInterpreter(file)
  result := (
    file.errors.length() > 0 ? errorResult(file.errors[0].message)
      : runTest(interpreter, name)
  )
  InterpretResult {
    ok: result.ok,
    error: result.error,
    value: result.value,
    output: interpreterOutput(interpreter),
    interpreter: snapshotInterpreter(interpreter)
  }
}

+ runTestIR(
  file: IRFile,
  name: String
) -> InterpretResult => {
  interpreter := newInterpreter(file)
  result := (
    file.errors.length() > 0 ? errorResult(file.errors[0].message)
      : runTest(interpreter, name)
  )
  InterpretResult {
    ok: result.ok,
    error: result.error,
    value: result.value,
    output: interpreterOutput(interpreter),
    interpreter: snapshotInterpreter(interpreter)
  }
}

+ runMainIR(
  file: IRFile
) -> InterpretResult => {
  interpreter := newInterpreter(file)
  result := (
    file.errors.length() > 0 ? errorResult(file.errors[0].message)
      : runMain(interpreter)
  )
  InterpretResult {
    ok: result.ok,
    error: result.error,
    value: result.value,
    output: interpreterOutput(interpreter),
    interpreter: snapshotInterpreter(interpreter)
  }
}

newInterpreter(
  file: IRFile
) -> Interpreter => {
  file: file,
  functions: file.functions,
  structs: file.structs,
  enums: file.enums,
  closures: {},
  closureCount: { "count": 0 },
  output: [],
  outputLog: {},
  outputCount: { "count": 0 },
  fsFiles: {},
  fsFileBytes: {},
  fsFileExists: {},
  fsDirs: { ".": true, "/": true }
}

snapshotInterpreter(
  interpreter: Interpreter
) -> Interpreter => {
  file: interpreter.file,
  functions: interpreter.functions,
  structs: interpreter.structs,
  enums: interpreter.enums,
  closures: interpreter.closures,
  closureCount: interpreter.closureCount,
  output: interpreterOutput(interpreter),
  outputLog: interpreter.outputLog,
  outputCount: interpreter.outputCount,
  fsFiles: interpreter.fsFiles,
  fsFileBytes: interpreter.fsFileBytes,
  fsFileExists: interpreter.fsFileExists,
  fsDirs: interpreter.fsDirs
}

runMain(
  interpreter: Interpreter
) -> EvalResult => {
  fn := findFunction(interpreter, "main")
  (
    fn.name == "" ? errorResult("main is not defined")
      : callFunction(interpreter, fn, [])
  )
}

runTest(
  interpreter: Interpreter,
  name: String
) -> EvalResult => {
  test := findTest(interpreter, name)
  (
    test.name == "" ? errorResult("test is not defined: " + name)
      : evalExpr(interpreter, globalEnv(interpreter), test.body)
  )
}

emptyEnv() -> RuntimeEnv => {
  bindings: {},
  bindingCount: { "count": 0 }
}

emptyValue() -> RuntimeValue => RuntimeValue.Void

voidValue() -> RuntimeValue => emptyValue()

nullValue() -> RuntimeValue => RuntimeValue.Null

boolValue(value: Bool) -> RuntimeValue => RuntimeValue.Bool(value)

intValue(value: Int) -> RuntimeValue => RuntimeValue.Int(value, "")

typedIntValue(
  value: Int,
  typeName: String
) -> RuntimeValue => RuntimeValue.Int(value, typeName)

doubleValue(
  value: Double,
  text: String
) -> RuntimeValue => RuntimeValue.Double(value, text, "")

typedDoubleValue(
  value: Double,
  typeName: String
) -> RuntimeValue => RuntimeValue.Double(value, "", typeName)

stringValue(
  value: String
) -> RuntimeValue => RuntimeValue.String(value, "")

bigIntValue(
  value: String
) -> RuntimeValue => RuntimeValue.String(normalizeBigIntText(value), "BigInt")

normalizeBigIntText(
  value: String
) -> String => value.endsWith("n") {
  true => value.slice(0, value.length() - 1)
  _ => value
}

charValue(value: Char) -> RuntimeValue => RuntimeValue.Char(value)

arrayValue(
  values: Array[RuntimeValue]
) -> RuntimeValue => RuntimeValue.Array(values)

tupleValue(
  values: Array[RuntimeValue]
) -> RuntimeValue => RuntimeValue.Tuple(values)

mapValue(
  entries: Array[RuntimeEntry]
) -> RuntimeValue => RuntimeValue.Map(entries)

setValue(
  entries: Array[RuntimeEntry]
) -> RuntimeValue => RuntimeValue.Set(entries)

structValue(
  typeName: String,
  fields: Array[RuntimeField]
) -> RuntimeValue => RuntimeValue.Struct(typeName, fields)

moduleValue(
  name: String
) -> RuntimeValue => RuntimeValue.Module(name)

closureValue(index: Int) -> RuntimeValue => RuntimeValue.Closure(index)

enumValue(
  typeName: String,
  name: String,
  value: Int
) -> RuntimeValue => RuntimeValue.Enum(typeName, name, value, emptyRuntimeArray())

enumPayloadValue(
  typeName: String,
  name: String,
  value: Int,
  payload: Array[RuntimeValue]
) -> RuntimeValue => RuntimeValue.Enum(typeName, name, value, payload)

runtimeKind(value: RuntimeValue) -> RuntimeValueKind => value {
  Void => RuntimeValueKind.Void
  Null => RuntimeValueKind.Null
  Bool(value) => RuntimeValueKind.Bool
  Int(value, typeName) => RuntimeValueKind.Int
  Double(value, text, typeName) => RuntimeValueKind.Double
  String(text, typeName) => RuntimeValueKind.String
  Char(value) => RuntimeValueKind.Char
  Array(values) => RuntimeValueKind.Array
  Tuple(values) => RuntimeValueKind.Tuple
  Map(entries) => RuntimeValueKind.Map
  Set(entries) => RuntimeValueKind.Set
  Struct(typeName, fields) => RuntimeValueKind.Struct
  Module(name) => RuntimeValueKind.Module
  Closure(index) => RuntimeValueKind.Closure
  Enum(typeName, name, value, payload) => RuntimeValueKind.Enum
}

runtimeText(value: RuntimeValue) -> String => value {
  Void => ""
  Null => "null"
  Bool(v) => (
    v ? "true"
      : "false"
  )
  Int(v, typeName) => intToString(v)
  Double(v, text, typeName) => text
  String(text, typeName) => text
  Char(ch) => ch.toString()
  Module(name) => name
  Enum(typeName, name, value, payload) => name
  _ => ""
}

runtimeInt(value: RuntimeValue) -> Int => value {
  Int(v, typeName) => v
  Enum(typeName, name, v, payload) => v
  Closure(index) => index
  _ => 0
}

runtimeDouble(value: RuntimeValue) -> Double => value {
  Double(v, text, typeName) => v
  _ => 0.0
}

runtimeBool(value: RuntimeValue) -> Bool => value {
  Bool(v) => v
  _ => false
}

runtimeChar(value: RuntimeValue) -> Char => value {
  Char(ch) => ch
  _ => '\x00'
}

runtimeArray(value: RuntimeValue) -> Array[RuntimeValue] => value {
  Array(values) => values
  Tuple(values) => values
  Enum(typeName, name, value, payload) => payload
  _ => []
}

runtimeEntries(value: RuntimeValue) -> Array[RuntimeEntry] => value {
  Map(entries) => entries
  Set(entries) => entries
  _ => []
}

runtimeFields(value: RuntimeValue) -> Array[RuntimeField] => value {
  Struct(typeName, fields) => fields
  _ => []
}

runtimeTypeName(value: RuntimeValue) -> String => value {
  Int(value, typeName) => typeName
  Double(value, text, typeName) => typeName
  String(text, typeName) => typeName
  Struct(typeName, fields) => typeName
  Enum(typeName, name, value, payload) => typeName
  _ => ""
}

runtimeClosureIndex(value: RuntimeValue) -> Int => value {
  Closure(index) => index
  _ => -1
}

runtimeWithArray(
  value: RuntimeValue,
  values: Array[RuntimeValue]
) -> RuntimeValue => value {
  Array(old) => arrayValue(values)
  Tuple(old) => tupleValue(values)
  _ => value
}

runtimeWithEntries(
  value: RuntimeValue,
  entries: Array[RuntimeEntry]
) -> RuntimeValue => value {
  Map(old) => mapValue(entries)
  Set(old) => setValue(entries)
  _ => value
}

runtimeWithFields(
  value: RuntimeValue,
  fields: Array[RuntimeField]
) -> RuntimeValue => value {
  Struct(typeName, old) => structValue(typeName, fields)
  _ => value
}

okResult(
  value: RuntimeValue
) -> EvalResult => {
  ok: true,
  error: "",
  value: value
}

errorResult(
  message: String
) -> EvalResult => {
  ok: false,
  error: message,
  value: emptyValue()
}

evalExpr(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => expr.kind {
  ExprKind.Identifier => evalIdentifier(interpreter, env, expr.name)
  ExprKind.At => okResult(moduleValue(moduleNameFromAt(expr)))
  ExprKind.This => evalIdentifier(interpreter, env, "this")
  ExprKind.Int => okResult(intValue(parseIntText(expr.value)))
  ExprKind.Double => okResult(doubleValue(parseDoubleText(expr.value), expr.value))
  ExprKind.BigInt => okResult(bigIntValue(expr.value))
  ExprKind.String => okResult(stringValue(decodeQuoted(expr.value)))
  ExprKind.Template => evalTemplate(interpreter, env, expr)
  ExprKind.Char => okResult(charValue(decodeCharLiteral(expr.value)))
  ExprKind.Regex => okResult(regexLiteralValue(expr.value))
  ExprKind.Bool => okResult(boolValue(expr.value == "true"))
  ExprKind.Null => okResult(nullValue())
  ExprKind.Unary => evalUnary(interpreter, env, expr)
  ExprKind.Postfix => evalPostfix(interpreter, env, expr)
  ExprKind.CompileTime => evalExpr(interpreter, env, expr.children[0])
  ExprKind.Unwrap => evalResultUnwrap(interpreter, env, expr)
  ExprKind.Binary => evalBinary(interpreter, env, expr)
  ExprKind.Ternary => evalTernary(interpreter, env, expr)
  ExprKind.Assign => evalAssign(interpreter, env, expr)
  ExprKind.Call => evalCall(interpreter, env, expr)
  ExprKind.Lambda => evalLambda(interpreter, env, expr)
  ExprKind.Selector => evalSelector(interpreter, env, expr)
  ExprKind.Index => evalIndex(interpreter, env, expr)
  ExprKind.Array => evalArray(interpreter, env, expr)
  ExprKind.Tuple => evalTuple(interpreter, env, expr)
  ExprKind.Map => evalMap(interpreter, env, expr)
  ExprKind.Spread => errorResult("spread is only supported inside array literals")
  ExprKind.Reactive => evalExpr(interpreter, env, expr.children[0])
  ExprKind.Struct => evalStructLiteral(interpreter, env, expr)
  ExprKind.Object => evalObjectLiteral(interpreter, env, expr)
  ExprKind.Block => evalBlock(interpreter, env, expr)
  ExprKind.Match => evalMatch(interpreter, env, expr)
  ExprKind.PatternBlock => errorResult("pattern block cannot be evaluated without a subject")
  ExprKind.Let => evalLet(interpreter, env, expr)
  ExprKind.ObjectDestructure => evalObjectDestructure(interpreter, env, expr)
  ExprKind.Error => errorResult("cannot evaluate parser error expression")
  _ => errorResult("unsupported expression kind " + exprKindName(expr.kind))
}

evalResultUnwrap(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  result := evalExpr(interpreter, env, expr.children[0])
  result.ok {
    true => unwrapRuntimeResult(result.value)
    _ => result
  }
}

unwrapRuntimeResult(
  value: RuntimeValue
) -> EvalResult => value {
  Enum(typeName, name, raw, payload) => unwrapRuntimeResultEnum(typeName, name, payload)
  _ => errorResult("operator '?' expects Result")
}

unwrapRuntimeResultEnum(
  typeName: String,
  name: String,
  payload: Array[RuntimeValue]
) -> EvalResult => typeName {
  "Result" => unwrapResultPayload(name, payload)
  _ => errorResult("operator '?' expects Result")
}

unwrapResultPayload(
  name: String,
  payload: Array[RuntimeValue]
) -> EvalResult => name {
  "Ok" => (payload.length() > 0) {
    true => okResult(payload[0])
    _ => okResult(voidValue())
  }
  "Err" => (payload.length() > 0) {
    true => errorResult(runtimeErrorMessage(payload[0]))
    _ => errorResult("Result.Err")
  }
  _ => errorResult("operator '?' expects Result")
}

runtimeErrorMessage(
  value: RuntimeValue
) -> String => value {
  Struct(typeName, fields) => typeName {
    "Error" => runtimeText(runtimeStructField(value, "message"))
    _ => formatRuntimeValue(value)
  }
  String(text, typeName) => text
  _ => formatRuntimeValue(value)
}

evalIdentifier(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String
) -> EvalResult => {
  found := envGet(env, name)
  (
    found.found ? okResult(found.value)
      : errorResult("undefined name " + name)
  )
}

evalUnary(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  value := evalExpr(interpreter, env, expr.children[0])
  (
    value.ok ? evalUnaryValue(expr.op, value.value)
      : value
  )
}

evalUnaryValue(
  op: String,
  value: RuntimeValue
) -> EvalResult => (
  op == "-" ? (
    runtimeKind(value) == RuntimeValueKind.Int ? okResult(intValue(0 - runtimeInt(value)))
      : (
        runtimeKind(value) == RuntimeValueKind.Double ? okResult(doubleRuntimeValue(0.0 - runtimeDouble(value)))
          : (
            isBigIntRuntime(value) ? okResult(bigIntRuntimeValue(0 - parseBigIntRuntime(value)))
              : errorResult("operator '-' expects a numeric type")
          )
      )
  )
    : (
      op == "!" ? (
        runtimeKind(value) == RuntimeValueKind.Bool ? okResult(boolValue(!runtimeBool(value)))
          : errorResult("operator '!' expects Bool")
      )
        : (
          op == "~" ? (
            runtimeKind(value) == RuntimeValueKind.Int ? okResult(typedIntValue(bitwiseNotInt(runtimeInt(value)), runtimeTypeName(value)))
              : (
                isBigIntRuntime(value) ? okResult(bigIntRuntimeValue(bitwiseNotInt(parseBigIntRuntime(value))))
                  : errorResult("operator '~' expects an integer type")
              )
          )
            : errorResult("unsupported unary operator " + op)
        )
    )
)

bitwiseNotInt(value: Int) -> Int => (0 - value) - 1

evalPostfix(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  target := expr.children[0]
  (
    target.kind != ExprKind.Identifier ? errorResult("postfix operator expects an identifier")
      : evalPostfixIdentifier(env, target.name)
  )
}

evalPostfixIdentifier(
  env: RuntimeEnv,
  name: String
) -> EvalResult => {
  found := envGet(env, name)
  (
    !found.found ? errorResult("undefined name " + name)
      : (
        runtimeKind(found.value) == RuntimeValueKind.Int ? assignExisting(env, name, intValue(runtimeInt(found.value) + 1), found.value)
          : errorResult("operator '++' expects Int")
      )
  )
}

assignExisting(
  env: RuntimeEnv,
  name: String,
  next: RuntimeValue,
  previous: RuntimeValue
) -> EvalResult => (
  envAssign(env, name, next) ? okResult(previous)
    : errorResult("undefined name " + name)
)

evalBinary(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => (
  expr.op == "&&" ? evalAnd(interpreter, env, expr)
    : (
      expr.op == "||" ? evalOr(interpreter, env, expr)
        : (
          expr.op == "??" ? evalNullCoalesce(interpreter, env, expr)
            : evalStrictBinary(interpreter, env, expr)
        )
    )
)

evalAnd(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  left := evalExpr(interpreter, env, expr.children[0])
  (
    !left.ok ? left
      : (
        runtimeKind(left.value) != RuntimeValueKind.Bool ? errorResult("operator '&&' expects Bool")
          : (
            !runtimeBool(left.value) ? okResult(boolValue(false))
              : evalBoolRight(interpreter, env, expr.children[1], "&&")
          )
      )
  )
}

evalOr(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  left := evalExpr(interpreter, env, expr.children[0])
  (
    !left.ok ? left
      : (
        runtimeKind(left.value) != RuntimeValueKind.Bool ? errorResult("operator '||' expects Bool")
          : (
            runtimeBool(left.value) ? okResult(boolValue(true))
              : evalBoolRight(interpreter, env, expr.children[1], "||")
          )
      )
  )
}

evalBoolRight(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr,
  op: String
) -> EvalResult => {
  right := evalExpr(interpreter, env, expr)
  (
    !right.ok ? right
      : (
        runtimeKind(right.value) == RuntimeValueKind.Bool ? right
          : errorResult(("operator '" + op) + "' expects Bool")
      )
  )
}

evalNullCoalesce(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  left := evalExpr(interpreter, env, expr.children[0])
  (
    !left.ok ? left
      : (
        runtimeKind(left.value) != RuntimeValueKind.Null ? left
          : evalExpr(interpreter, env, expr.children[1])
      )
  )
}

evalStrictBinary(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  left := evalExpr(interpreter, env, expr.children[0])
  right := (
    left.ok ? evalExpr(interpreter, env, expr.children[1])
      : left
  )
  (
    !left.ok ? left
      : (
        !right.ok ? right
          : evalBinaryValues(expr.op, left.value, right.value)
      )
  )
}

evalBinaryValues(
  op: String,
  left: RuntimeValue,
  right: RuntimeValue
) -> EvalResult => (
  op == "+" ? evalPlus(left, right)
    : (
      isBitwiseOperator(op) ? evalBitwiseValues(op, left, right)
        : (
          op == "-" ? evalIntBinary(left, right, op)
            : (
              op == "*" ? evalIntBinary(left, right, op)
                : (
                  op == "/" ? evalIntBinary(left, right, op)
                    : (
                      op == "%" ? evalIntBinary(left, right, op)
                        : (
                          op == "==" ? okResult(boolValue(runtimeEqual(left, right)))
                            : (
                              op == "!=" ? okResult(boolValue(!runtimeEqual(left, right)))
                                : (
                                  op == "<" ? evalOrdered(left, right, op)
                                    : (
                                      op == "<=" ? evalOrdered(left, right, op)
                                        : (
                                          op == ">" ? evalOrdered(left, right, op)
                                            : (
                                              op == ">=" ? evalOrdered(left, right, op)
                                                : errorResult("unsupported binary operator " + op)
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

isBitwiseOperator(op: String) -> Bool => (((op == "&") || (op == "|")) || ((op == "^") || (op == "<<"))) || ((op == ">>") || (op == ">>>"))

evalBitwiseValues(
  op: String,
  left: RuntimeValue,
  right: RuntimeValue
) -> EvalResult => (
  (runtimeKind(left) == RuntimeValueKind.Int) && (runtimeKind(right) == RuntimeValueKind.Int) ? okResult(typedIntValue(bitwiseInt(op, runtimeInt(left), runtimeInt(right)), runtimeTypeName(left)))
    : (
      isBigIntRuntime(left) && isBigIntRuntime(right) ? okResult(bigIntRuntimeValue(bitwiseInt(op, parseBigIntRuntime(left), parseBigIntRuntime(right))))
        : errorResult("bitwise operands must have matching integer types")
    )
)

bitwiseInt(
  op: String,
  left: Int,
  right: Int
) -> Int => (
  op == "&" ? left & right
    : (
      op == "|" ? left | right
        : (
          op == "^" ? left ^ right
            : (
              op == "<<" ? left << right
                : left >> right
            )
        )
    )
)

evalPlus(
  left: RuntimeValue,
  right: RuntimeValue
) -> EvalResult => (
  isBigIntRuntime(left) && isBigIntRuntime(right) ? evalBigIntBinary(left, right, "+")
    : (
      (runtimeKind(left) == RuntimeValueKind.String) && (runtimeKind(right) == RuntimeValueKind.String) ? okResult(stringValue(runtimeText(left) + runtimeText(right)))
        : evalNumericBinary(left, right, "+")
    )
)

evalIntBinary(
  left: RuntimeValue,
  right: RuntimeValue,
  op: String
) -> EvalResult => evalNumericBinary(left, right, op)

evalNumericBinary(
  left: RuntimeValue,
  right: RuntimeValue,
  op: String
) -> EvalResult => (
  (runtimeKind(left) == RuntimeValueKind.Int) && (runtimeKind(right) == RuntimeValueKind.Int) ? okResult(intValue((
    op == "+" ? runtimeInt(left) + runtimeInt(right)
      : (
        op == "-" ? runtimeInt(left) - runtimeInt(right)
          : (
            op == "*" ? runtimeInt(left) * runtimeInt(right)
              : (
                op == "/" ? runtimeInt(left) / runtimeInt(right)
                  : runtimeInt(left) % runtimeInt(right)
              )
          )
      )
  )))
    : (
      (runtimeKind(left) == RuntimeValueKind.Double) && (runtimeKind(right) == RuntimeValueKind.Double) ? (
        op == "%" ? errorResult("operator '%' expects Int")
          : okResult(doubleRuntimeValue((
            op == "+" ? runtimeDouble(left) + runtimeDouble(right)
              : (
                op == "-" ? runtimeDouble(left) - runtimeDouble(right)
                  : (
                    op == "*" ? runtimeDouble(left) * runtimeDouble(right)
                      : runtimeDouble(left) / runtimeDouble(right)
                  )
              )
          )))
      )
        : (
          isBigIntRuntime(left) && isBigIntRuntime(right) ? evalBigIntBinary(left, right, op)
            : errorResult("arithmetic operands must have matching numeric types")
        )
    )
)

isBigIntRuntime(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.String) && (runtimeTypeName(value) == "BigInt")

parseBigIntRuntime(value: RuntimeValue) -> Int => parseIntText(runtimeText(value))

bigIntRuntimeValue(value: Int) -> RuntimeValue => bigIntValue(intToString(value))

evalBigIntBinary(
  left: RuntimeValue,
  right: RuntimeValue,
  op: String
) -> EvalResult => {
  (
    op == "+" ? okResult(bigIntValue(bigIntAddText(runtimeText(left), runtimeText(right))))
      : (
        op == "-" ? okResult(bigIntValue(bigIntSubText(runtimeText(left), runtimeText(right))))
          : evalSmallBigIntBinary(left, right, op)
      )
  )
}

evalSmallBigIntBinary(
  left: RuntimeValue,
  right: RuntimeValue,
  op: String
) -> EvalResult => {
  leftValue := parseBigIntRuntime(left)
  rightValue := parseBigIntRuntime(right)
  okResult(bigIntRuntimeValue((
    op == "*" ? leftValue * rightValue
      : (
        op == "/" ? leftValue / rightValue
          : leftValue % rightValue
      )
  )))
}

bigIntAddText(
  left: String,
  right: String
) -> String => (
  left.startsWith("-") ? (
    right.startsWith("-") ? "-" + bigIntAddAbs(left.slice(1, left.length()), right.slice(1, right.length()))
      : bigIntSubAbsSigned(right, left.slice(1, left.length()))
  )
    : (
      right.startsWith("-") ? bigIntSubAbsSigned(left, right.slice(1, right.length()))
        : bigIntAddAbs(left, right)
    )
)

bigIntSubText(
  left: String,
  right: String
) -> String => (
  right.startsWith("-") ? bigIntAddText(left, right.slice(1, right.length()))
    : (
      left.startsWith("-") ? "-" + bigIntAddAbs(left.slice(1, left.length()), right)
        : bigIntSubAbsSigned(left, right)
    )
)

bigIntSubAbsSigned(
  left: String,
  right: String
) -> String => (
  bigIntCompareAbs(left, right) >= 0 ? bigIntSubAbs(left, right)
    : "-" + bigIntSubAbs(right, left)
)

bigIntAddAbs(
  left: String,
  right: String
) -> String => trimBigIntZeros(bigIntAddAbsLoop(left, right, left.length() - 1, right.length() - 1, 0, ""))

bigIntAddAbsLoop(
  left: String,
  right: String,
  leftIndex: Int,
  rightIndex: Int,
  carry: Int,
  out: String
) -> String => (
  (leftIndex < 0) && (rightIndex < 0) && (carry == 0) ? out
    : bigIntAddAbsStep(left, right, leftIndex, rightIndex, carry, out)
)

bigIntAddAbsStep(
  left: String,
  right: String,
  leftIndex: Int,
  rightIndex: Int,
  carry: Int,
  out: String
) -> String => {
  sum := bigIntDigitAt(left, leftIndex) + bigIntDigitAt(right, rightIndex) + carry
  bigIntAddAbsLoop(left, right, leftIndex - 1, rightIndex - 1, sum / 10, digitString(sum % 10) + out)
}

bigIntSubAbs(
  left: String,
  right: String
) -> String => trimBigIntZeros(bigIntSubAbsLoop(left, right, left.length() - 1, right.length() - 1, 0, ""))

bigIntSubAbsLoop(
  left: String,
  right: String,
  leftIndex: Int,
  rightIndex: Int,
  borrow: Int,
  out: String
) -> String => (
  leftIndex < 0 ? out
    : bigIntSubAbsStep(left, right, leftIndex, rightIndex, borrow, out)
)

bigIntSubAbsStep(
  left: String,
  right: String,
  leftIndex: Int,
  rightIndex: Int,
  borrow: Int,
  out: String
) -> String => {
  raw := bigIntDigitAt(left, leftIndex) - borrow - bigIntDigitAt(right, rightIndex)
  digit := (
    raw < 0 ? raw + 10
      : raw
  )
  nextBorrow := (
    raw < 0 ? 1
      : 0
  )
  bigIntSubAbsLoop(left, right, leftIndex - 1, rightIndex - 1, nextBorrow, digitString(digit) + out)
}

bigIntDigitAt(
  text: String,
  index: Int
) -> Int => (
  index < 0 ? 0
    : digitValue(text.at(index))
)

bigIntCompareAbs(
  left: String,
  right: String
) -> Int => {
  cleanLeft := trimBigIntZeros(left)
  cleanRight := trimBigIntZeros(right)
  (
    cleanLeft.length() > cleanRight.length() ? 1
      : (
        cleanLeft.length() < cleanRight.length() ? -1
          : (
            cleanLeft == cleanRight ? 0
              : (
                cleanLeft > cleanRight ? 1
                  : -1
              )
          )
      )
  )
}

trimBigIntZeros(text: String) -> String => {
  trimmed := trimBigIntZerosAt(text, 0)
  (
    trimmed == "" ? "0"
      : trimmed
  )
}

trimBigIntZerosAt(
  text: String,
  index: Int
) -> String => (
  index >= text.length() ? ""
    : (
      text.at(index) == '0' ? trimBigIntZerosAt(text, index + 1)
        : text.slice(index, text.length())
    )
)

doubleRuntimeValue(
  value: Double
) -> RuntimeValue => doubleValue(value, "")

evalOrderedDouble(
  left: RuntimeValue,
  right: RuntimeValue,
  op: String
) -> EvalResult => (
  (runtimeKind(left) == RuntimeValueKind.Double) && (runtimeKind(right) == RuntimeValueKind.Double) ? okResult(boolValue((
    op == "<" ? runtimeDouble(left) < runtimeDouble(right)
      : (
        op == "<=" ? runtimeDouble(left) <= runtimeDouble(right)
          : (
            op == ">" ? runtimeDouble(left) > runtimeDouble(right)
              : runtimeDouble(left) >= runtimeDouble(right)
          )
      )
  )))
    : errorResult("comparison operands must have matching ordered types")
)

evalOrdered(
  left: RuntimeValue,
  right: RuntimeValue,
  op: String
) -> EvalResult => (
  (runtimeKind(left) == RuntimeValueKind.Int) && (runtimeKind(right) == RuntimeValueKind.Int) ? okResult(boolValue((
    op == "<" ? runtimeInt(left) < runtimeInt(right)
      : (
        op == "<=" ? runtimeInt(left) <= runtimeInt(right)
          : (
            op == ">" ? runtimeInt(left) > runtimeInt(right)
              : runtimeInt(left) >= runtimeInt(right)
          )
      )
  )))
    : (
      (runtimeKind(left) == RuntimeValueKind.String) && (runtimeKind(right) == RuntimeValueKind.String) ? okResult(boolValue((
        op == "<" ? runtimeText(left) < runtimeText(right)
          : (
            op == "<=" ? runtimeText(left) <= runtimeText(right)
              : (
                op == ">" ? runtimeText(left) > runtimeText(right)
                  : runtimeText(left) >= runtimeText(right)
              )
          )
      )))
        : (
          (runtimeKind(left) == RuntimeValueKind.Char) && (runtimeKind(right) == RuntimeValueKind.Char) ? okResult(boolValue((
            op == "<" ? runtimeChar(left) < runtimeChar(right)
              : (
                op == "<=" ? runtimeChar(left) <= runtimeChar(right)
                  : (
                    op == ">" ? runtimeChar(left) > runtimeChar(right)
                      : runtimeChar(left) >= runtimeChar(right)
                  )
              )
          )))
            : (
              isBigIntRuntime(left) && isBigIntRuntime(right) ? evalOrderedBigInt(left, right, op)
                : evalOrderedDouble(left, right, op)
            )
        )
    )
)

evalOrderedBigInt(
  left: RuntimeValue,
  right: RuntimeValue,
  op: String
) -> EvalResult => {
  leftValue := parseBigIntRuntime(left)
  rightValue := parseBigIntRuntime(right)
  okResult(boolValue((
    op == "<" ? leftValue < rightValue
      : (
        op == "<=" ? leftValue <= rightValue
          : (
            op == ">" ? leftValue > rightValue
              : leftValue >= rightValue
          )
      )
  )))
}

evalTernary(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  condition := evalExpr(interpreter, env, expr.children[0])
  (
    !condition.ok ? condition
      : (
        runtimeKind(condition.value) != RuntimeValueKind.Bool ? errorResult("ternary condition expects Bool")
          : (
            runtimeBool(condition.value) ? evalExpr(interpreter, env, expr.children[1])
              : (
                expr.children.length() > 2 ? evalExpr(interpreter, env, expr.children[2])
                  : okResult(voidValue())
              )
          )
      )
  )
}

evalAssign(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => (
  expr.children.length() == 2 ? evalAssignTarget(interpreter, env, expr.children[0], expr.children[1])
    : evalAssignName(interpreter, env, expr.name, expr.children[0])
)

evalAssignName(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  valueExpr: IRExpr
) -> EvalResult => {
  value := evalExpr(interpreter, env, valueExpr)
  (
    !value.ok ? value
      : (
        envAssign(env, name, value.value) ? okResult(voidValue())
          : errorResult("undefined name " + name)
      )
  )
}

evalAssignTarget(
  interpreter: Interpreter,
  env: RuntimeEnv,
  target: IRExpr,
  valueExpr: IRExpr
) -> EvalResult => (
  target.kind == ExprKind.Identifier ? evalAssignName(interpreter, env, target.name, valueExpr)
    : (
      target.kind == ExprKind.Index ? evalIndexAssign(interpreter, env, target, valueExpr)
        : errorResult("assignment target is not assignable")
    )
)

evalIndexAssign(
  interpreter: Interpreter,
  env: RuntimeEnv,
  target: IRExpr,
  valueExpr: IRExpr
) -> EvalResult => {
  receiver := evalExpr(interpreter, env, target.children[0])
  index := (
    receiver.ok ? evalExpr(interpreter, env, target.children[1])
      : receiver
  )
  value := (
    index.ok ? evalExpr(interpreter, env, valueExpr)
      : index
  )
  (
    !receiver.ok ? receiver
      : (
        !index.ok ? index
          : (
            !value.ok ? value
              : assignIndexTargetValue(env, target, receiver.value, index.value, value.value)
          )
      )
  )
}

assignIndexTargetValue(
  env: RuntimeEnv,
  target: IRExpr,
  receiver: RuntimeValue,
  index: RuntimeValue,
  value: RuntimeValue
) -> EvalResult => {
  result := assignIndexValue(receiver, index, value)
  (
    !result.ok ? result
      : (
        (runtimeKind(receiver) == RuntimeValueKind.Map) && (target.children[0].kind == ExprKind.Identifier) ? assignMapIndexTarget(env, target.children[0].name, result.value)
          : result
      )
  )
}

assignMapIndexTarget(
  env: RuntimeEnv,
  name: String,
  value: RuntimeValue
) -> EvalResult => {
  envAssign(env, name, value)
  okResult(voidValue())
}

assignIndexValue(
  receiver: RuntimeValue,
  index: RuntimeValue,
  value: RuntimeValue
) -> EvalResult => (
  runtimeKind(receiver) == RuntimeValueKind.Map ? okResult(mapSet(receiver, index, value))
    : (
      (runtimeKind(receiver) == RuntimeValueKind.Array) && (runtimeKind(index) == RuntimeValueKind.Int) ? okResult(runtimeArray(receiver).set(runtimeInt(index), value))
        : errorResult(runtimeValueKindName(runtimeKind(receiver)) + " is not assignable by index")
    )
)

evalCall(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  callee := expr.children[0]
  (
    callee.kind == ExprKind.Identifier ? callNamedFunction(interpreter, env, callee.name, expr.children)
      : (
        callee.kind == ExprKind.Selector ? callSelector(interpreter, env, callee, expr.children)
          : callEvaluated(interpreter, env, callee, expr.children)
      )
  )
}

callNamedFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  fn := findFunction(interpreter, name)
  (
    fn.name == "" ? callNamedEnumConstructor(interpreter, env, name, children)
      : callFunctionWithArgs(interpreter, fn, evalArgsChecked(interpreter, env, children, 1))
  )
}

callNamedEnumConstructor(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  constructor := findEnumConstructor(interpreter, name)
  (
    !constructor.found ? callEvaluated(interpreter, env, children[0], children)
      : callEnumConstructorValue(interpreter, env, constructor.typeName, constructor.member, children)
  )
}

callEnumConstructorValue(
  interpreter: Interpreter,
  env: RuntimeEnv,
  typeName: String,
  member: IREnumMember,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgsChecked(interpreter, env, children, 1)
  (
    !args.ok ? errorResult(args.error)
      : (
        args.values.length() != member.params.length() ? errorResult("constructor " + member.name + " argument count mismatch")
          : okResult(enumPayloadValue(typeName, member.name, parseIntText(member.value), args.values))
      )
  )
}

callSelector(
  interpreter: Interpreter,
  env: RuntimeEnv,
  callee: IRExpr,
  children: Array[IRExpr]
) -> EvalResult => {
  receiverExpr := callee.children[0]
  (
    receiverExpr.kind == ExprKind.At ? callModuleFunction(interpreter, env, moduleNameFromAt(receiverExpr), callee.name, children)
      : (
        callee.op == "::" ? callStaticSelector(interpreter, env, receiverExpr, callee.name, children)
          : callReceiverMethod(interpreter, env, receiverExpr, callee.name, children)
      )
  )
}

callStaticSelector(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => (
  (receiverExpr.kind == ExprKind.Identifier) && (name == "fromJson") ? callJsonFromJson(interpreter, env, receiverExpr.name, children)
    : callReceiverMethod(interpreter, env, receiverExpr, name, children)
)

callEvaluated(
  interpreter: Interpreter,
  env: RuntimeEnv,
  callee: IRExpr,
  children: Array[IRExpr]
) -> EvalResult => {
  value := evalExpr(interpreter, env, callee)
  (
    !value.ok ? value
      : callClosureWithArgs(interpreter, value.value, evalArgsChecked(interpreter, env, children, 1))
  )
}

callFunctionWithArgs(
  interpreter: Interpreter,
  fn: IRFunction,
  args: EvalArgsResult
) -> EvalResult => (
  !args.ok ? errorResult(args.error)
    : callFunction(interpreter, fn, args.values)
)

callClosureWithArgs(
  interpreter: Interpreter,
  closure: RuntimeValue,
  args: EvalArgsResult
) -> EvalResult => (
  !args.ok ? errorResult(args.error)
    : callClosureValue(interpreter, closure, args.values)
)

evalArgsChecked(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int
) -> EvalArgsResult => evalArgsCheckedLoop(interpreter, env, children, index, [])

evalArgsCheckedLoop(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeValue]
) -> EvalArgsResult => (
  index >= children.length() ? EvalArgsResult {
    ok: true,
    error: "",
    values: out
  }
    : evalArgsCheckedNext(interpreter, env, children, index, out)
)

evalArgsCheckedNext(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeValue]
) -> EvalArgsResult => {
  value := evalExpr(interpreter, env, children[index])
  (
    !value.ok ? EvalArgsResult {
      ok: false,
      error: value.error,
      values: out
    }
      : evalArgsCheckedLoop(interpreter, env, children, index + 1, pushRuntime(out, value.value))
  )
}

evalArgs(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int
) -> Array[RuntimeValue] => evalArgsLoop(interpreter, env, children, index, [])

evalArgsLoop(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= children.length() ? out
    : evalArgsNext(interpreter, env, children, index, out)
)

evalArgsNext(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  value := evalExpr(interpreter, env, children[index])
  evalArgsLoop(interpreter, env, children, index + 1, pushRuntime(out, (
    value.ok ? value.value
      : stringValue("error:" + value.error)
  )))
}

evalLambda(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  index := nextClosureIndex(interpreter)
  interpreter.closures[index] = RuntimeClosure {
    params: expr.params,
    body: expr.children[0],
    env: env
  }
  okResult(closureValue(index))
}

evalTemplate(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => evalTemplateParts(interpreter, env, decodeQuoted(expr.value).split("<<<RUNE_TEMPLATE_PART>>>"), expr.children, 0, "")

evalTemplateParts(
  interpreter: Interpreter,
  env: RuntimeEnv,
  parts: Array[String],
  children: Array[IRExpr],
  index: Int,
  out: String
) -> EvalResult => (
  index >= parts.length() ? okResult(stringValue(out))
    : evalTemplatePart(interpreter, env, parts, children, index, out)
)

evalTemplatePart(
  interpreter: Interpreter,
  env: RuntimeEnv,
  parts: Array[String],
  children: Array[IRExpr],
  index: Int,
  out: String
) -> EvalResult => {
  next := out + parts[index]
  (
    (index >= children.length()) || (children[index].kind == ExprKind.Unknown) ? evalTemplateParts(interpreter, env, parts, children, index + 1, next)
      : evalTemplateExprPart(interpreter, env, parts, children, index, next)
  )
}

evalTemplateExprPart(
  interpreter: Interpreter,
  env: RuntimeEnv,
  parts: Array[String],
  children: Array[IRExpr],
  index: Int,
  out: String
) -> EvalResult => {
  value := evalExpr(interpreter, env, children[index])
  (
    !value.ok ? value
      : evalTemplateParts(interpreter, env, parts, children, index + 1, out + runtimeText(value.value))
  )
}

callClosureValue(
  interpreter: Interpreter,
  closure: RuntimeValue,
  args: Array[RuntimeValue]
) -> EvalResult => (
  runtimeKind(closure) == RuntimeValueKind.Closure ? callClosure(interpreter, interpreter.closures[runtimeClosureIndex(closure)] ?? emptyRuntimeClosure(), args)
    : errorResult(runtimeValueKindName(runtimeKind(closure)) + " is not callable")
)

emptyRuntimeClosure() -> RuntimeClosure => {
  params: [],
  body: IRExpr {
    kind: ExprKind.Unknown,
    text: "",
    name: "",
    value: "",
    op: "",
    params: [],
    children: [],
    line: 0,
    column: 0
  },
  env: emptyEnv()
}

callClosure(
  interpreter: Interpreter,
  closure: RuntimeClosure,
  args: Array[RuntimeValue]
) -> EvalResult => {
  bindArgs(closure.env, closure.params, args, 0)
  evalExpr(interpreter, closure.env, closure.body)
}

nextClosureIndex(
  interpreter: Interpreter
) -> Int => {
  index := interpreter.closureCount["count"] ?? 0
  interpreter.closureCount["count"] = index + 1
  index
}

appendOutput(
  interpreter: Interpreter,
  line: String
) -> Void => {
  index := interpreter.outputCount["count"] ?? 0
  interpreter.outputLog[index] = line
  interpreter.outputCount["count"] = index + 1
}

interpreterOutput(
  interpreter: Interpreter
) -> Array[String] => interpreterOutputLoop(interpreter, 0, [])

interpreterOutputLoop(
  interpreter: Interpreter,
  index: Int,
  out: Array[String]
) -> Array[String] => (
  index >= (interpreter.outputCount["count"] ?? 0) ? out
    : interpreterOutputNext(interpreter, index, out)
)

interpreterOutputNext(
  interpreter: Interpreter,
  index: Int,
  out: Array[String]
) -> Array[String] => {
  interpreterOutputLoop(interpreter, index + 1, pushString(out, interpreter.outputLog[index] ?? ""))
}

callFunction(
  interpreter: Interpreter,
  fn: IRFunction,
  args: Array[RuntimeValue]
) -> EvalResult => {
  env := bindArgs(globalEnv(interpreter), fn.params, args, 0)
  native := callNativeSelfhostFunction(fn, args)
  (
    native.handled ? native.result
      : (
        (fn.body.kind == ExprKind.PatternBlock) && (args.length() > 0) ? evalPatternBlockWithSubject(interpreter, env, args[0], fn.body)
          : (functionAllowsPredicateBody(fn) && exprLooksPatternPredicate(fn.body)) && (args.length() > 0) ? okResult(boolValue(matchPredicateExpr(args[0], fn.body)))
          : evalFunctionBody(interpreter, fn, env)
      )
  )
}

functionAllowsPredicateBody(fn: IRFunction) -> Bool => (fn.returnType == "") || (fn.returnType == "Bool")

globalEnv(
  interpreter: Interpreter
) -> RuntimeEnv => bindConstants(interpreter, emptyEnv(), 0)

bindConstants(
  interpreter: Interpreter,
  env: RuntimeEnv,
  index: Int
) -> RuntimeEnv => (
  index >= interpreter.file.constants.length() ? env
    : bindConstants(interpreter, bindConstant(interpreter, env, interpreter.file.constants[index]), index + 1)
)

bindConstant(
  interpreter: Interpreter,
  env: RuntimeEnv,
  constDecl: IRConst
) -> RuntimeEnv => {
  value := evalExpr(interpreter, env, constDecl.value)
  (
    value.ok ? envDefine(env, constDecl.name, value.value)
      : env
  )
}

callNativeSelfhostFunction(
  fn: IRFunction,
  args: Array[RuntimeValue]
) -> NativeCallResult => (
  isNativeInterpretFunction(fn, args) ? handledNative(okResult(interpretResultRuntimeValue(interpret(runtimeText(args[0])))))
    : (
      isNativeInterpretTestFunction(fn, args) ? handledNative(okResult(interpretResultRuntimeValue(interpretTest(runtimeText(args[0]), runtimeText(args[1])))))
        : unhandledNative()
    )
)

isNativeInterpretFunction(
  fn: IRFunction,
  args: Array[RuntimeValue]
) -> Bool => (
  (fn.name == "interpret") && (fn.returnType == "InterpretResult") && (fn.params.length() == 1) && (args.length() == 1) && (runtimeKind(args[0]) == RuntimeValueKind.String)
)

isNativeInterpretTestFunction(
  fn: IRFunction,
  args: Array[RuntimeValue]
) -> Bool => (
  (fn.name == "interpretTest") && (fn.returnType == "InterpretResult") && (fn.params.length() == 2) && (args.length() == 2) && (runtimeKind(args[0]) == RuntimeValueKind.String) && (runtimeKind(args[1]) == RuntimeValueKind.String)
)

handledNative(
  result: EvalResult
) -> NativeCallResult => {
  handled: true,
  result: result
}

unhandledNative() -> NativeCallResult => {
  handled: false,
  result: okResult(voidValue())
}

interpretResultRuntimeValue(
  result: InterpretResult
) -> RuntimeValue => structValue("InterpretResult", [
  RuntimeField { name: "ok", value: boolValue(result.ok) },
  RuntimeField { name: "error", value: stringValue(result.error) },
  RuntimeField { name: "value", value: result.value },
  RuntimeField { name: "output", value: arrayValue(stringArrayValues(result.output, 0, [])) },
  RuntimeField { name: "interpreter", value: interpreterRuntimeValue(result.interpreter) }
])

interpreterRuntimeValue(
  interpreter: Interpreter
) -> RuntimeValue => structValue("Interpreter", [
  RuntimeField { name: "output", value: arrayValue(stringArrayValues(interpreter.output, 0, [])) }
])

stringArrayValues(
  values: Array[String],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  (
    index >= values.length() ? out
      : stringArrayValuesNext(values, index, out)
  )
}

stringArrayValuesNext(
  values: Array[String],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  stringArrayValues(values, index + 1, pushRuntime(out, stringValue(values[index])))
}

reflectRuntimeValue(
  value: RuntimeValue
) -> RuntimeValue => structValue("RuntimeValue", [
  RuntimeField { name: "kind", value: reflectRuntimeValueKind(runtimeKind(value)) },
  RuntimeField { name: "text", value: stringValue(runtimeText(value)) },
  RuntimeField { name: "intValue", value: intValue(runtimeInt(value)) },
  RuntimeField { name: "doubleValue", value: doubleValue(runtimeDouble(value), runtimeText(value)) },
  RuntimeField { name: "boolValue", value: boolValue(runtimeBool(value)) },
  RuntimeField { name: "charValue", value: charValue(runtimeChar(value)) },
  RuntimeField { name: "array", value: arrayValue(reflectRuntimeValues(runtimeArray(value), 0, [])) },
  RuntimeField { name: "entries", value: arrayValue(reflectRuntimeEntries(runtimeEntries(value), 0, [])) },
  RuntimeField { name: "fields", value: arrayValue(reflectRuntimeFields(runtimeFields(value), 0, [])) },
  RuntimeField { name: "typeName", value: stringValue(runtimeTypeName(value)) },
  RuntimeField { name: "closureIndex", value: intValue(runtimeClosureIndex(value)) }
])

reflectRuntimeValueKind(
  kind: RuntimeValueKind
) -> RuntimeValue => kind {
  RuntimeValueKind.Void => enumValue("RuntimeValueKind", "Void", 0)
  RuntimeValueKind.Null => enumValue("RuntimeValueKind", "Null", 1)
  RuntimeValueKind.Bool => enumValue("RuntimeValueKind", "Bool", 2)
  RuntimeValueKind.Int => enumValue("RuntimeValueKind", "Int", 3)
  RuntimeValueKind.Double => enumValue("RuntimeValueKind", "Double", 4)
  RuntimeValueKind.String => enumValue("RuntimeValueKind", "String", 5)
  RuntimeValueKind.Char => enumValue("RuntimeValueKind", "Char", 6)
  RuntimeValueKind.Array => enumValue("RuntimeValueKind", "Array", 7)
  RuntimeValueKind.Tuple => enumValue("RuntimeValueKind", "Tuple", 8)
  RuntimeValueKind.Map => enumValue("RuntimeValueKind", "Map", 9)
  RuntimeValueKind.Set => enumValue("RuntimeValueKind", "Set", 10)
  RuntimeValueKind.Struct => enumValue("RuntimeValueKind", "Struct", 11)
  RuntimeValueKind.Module => enumValue("RuntimeValueKind", "Module", 12)
  RuntimeValueKind.Closure => enumValue("RuntimeValueKind", "Closure", 13)
  RuntimeValueKind.Enum => enumValue("RuntimeValueKind", "Enum", 14)
  _ => enumValue("RuntimeValueKind", "Void", 0)
}

reflectRuntimeValues(
  values: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= values.length() ? out
    : reflectRuntimeValuesNext(values, index, out)
)

reflectRuntimeValuesNext(
  values: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  reflectRuntimeValues(values, index + 1, pushRuntime(out, reflectRuntimeValue(values[index])))
}

reflectRuntimeEntries(
  entries: Array[RuntimeEntry],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= entries.length() ? out
    : reflectRuntimeEntriesNext(entries, index, out)
)

reflectRuntimeEntriesNext(
  entries: Array[RuntimeEntry],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  entry := entries[index]
  reflectRuntimeEntries(entries, index + 1, pushRuntime(out, structValue("RuntimeEntry", [
    RuntimeField { name: "key", value: reflectRuntimeValue(entry.key) },
    RuntimeField { name: "value", value: reflectRuntimeValue(entry.value) }
  ])))
}

reflectRuntimeFields(
  fields: Array[RuntimeField],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= fields.length() ? out
    : reflectRuntimeFieldsNext(fields, index, out)
)

reflectRuntimeFieldsNext(
  fields: Array[RuntimeField],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  field := fields[index]
  reflectRuntimeFields(fields, index + 1, pushRuntime(out, structValue("RuntimeField", [
    RuntimeField { name: "name", value: stringValue(field.name) },
    RuntimeField { name: "value", value: reflectRuntimeValue(field.value) }
  ])))
}

evalFunctionBody(
  interpreter: Interpreter,
  fn: IRFunction,
  env: RuntimeEnv
) -> EvalResult => {
  value := evalExpr(interpreter, env, fn.body)
  (
    !value.ok ? value
      : (
        fn.returnType == "Void" ? okResult(voidValue())
          : value
      )
  )
}

bindArgs(
  env: RuntimeEnv,
  params: Array[IRParam],
  args: Array[RuntimeValue],
  index: Int
) -> RuntimeEnv => (
  index >= params.length() ? env
    : bindArgs(envDefine(env, params[index].name, (
      index < args.length() ? args[index]
        : nullValue()
    )), params, args, index + 1)
)

callModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  module: String,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => module {
  "io" => callIoModuleFunction(interpreter, env, name, children)
  "assert" => name {
    "eq" => callAssertEq(interpreter, env, children)
    _ => callImportedModuleFunction(interpreter, env, module, name, children)
  }
  "map" => name {
    "new" => okResult(mapValue([]))
    _ => callImportedModuleFunction(interpreter, env, module, name, children)
  }
  "bytes" => callBytesModuleFunction(interpreter, env, name, children)
  "buffer" => callBufferModuleFunction(interpreter, env, name, children)
  "json" => callJsonModuleFunction(interpreter, env, name, children)
  "regex" => callRegexModuleFunction(interpreter, env, name, children)
  "compress" => callCompressModuleFunction(interpreter, env, name, children)
  "iter" => callIterModuleFunction(interpreter, env, name, children)
  "path" => callPathModuleFunction(interpreter, env, name, children)
  "process" => callProcessModuleFunction(interpreter, env, name, children)
  "fs" => callFsModuleFunction(interpreter, env, name, children)
  "net" => callNetModuleFunction(interpreter, env, name, children)
  "reader" => callReaderModuleFunction(interpreter, env, name, children)
  "set" => name {
    "new" => okResult(setValue([]))
    _ => callImportedModuleFunction(interpreter, env, module, name, children)
  }
  "stringbuffer" => callStringBufferModuleFunction(interpreter, env, name, children)
  "symbol" => callSymbolModuleFunction(interpreter, env, name, children)
  "writer" => callWriterModuleFunction(interpreter, env, name, children)
  "int" => callIntModuleFunction(interpreter, env, name, children)
  "bigint" => callBigIntModuleFunction(interpreter, env, name, children)
  "double" => callDoubleModuleFunction(interpreter, env, name, children)
  "int4" | "int8" | "int16" | "int64" => callNumericModuleFunction(interpreter, env, module, name, children)
  "uint" | "uint8" | "uint16" | "uint64" => callNumericModuleFunction(interpreter, env, module, name, children)
  "float" => callNumericModuleFunction(interpreter, env, module, name, children)
  "cli" => callCliModuleFunction(interpreter, env, name, children)
  _ => callImportedModuleFunction(interpreter, env, module, name, children)
}

callIoModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => name {
  "println" => callPrintln(interpreter, env, children)
  "print" => callPrintln(interpreter, env, children)
  "printf" => callPrintln(interpreter, env, children)
  "scan" => okResult(nullValue())
  "scanLine" => okResult(nullValue())
  "readAll" => okResult(stringValue(""))
  _ => callImportedModuleFunction(interpreter, env, "io", name, children)
}

callSymbolModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "create" => okResult(symbolValue(runtimeText(args[0]), "", false))
    "unique" => okResult(symbolValue(runtimeText(args[0]), "", false))
    "for" => okResult(symbolValue(runtimeText(args[0]), runtimeText(args[0]), true))
    "keyFor" => (
      symbolGlobal(args[0]) {
        true => okResult(stringValue(symbolKey(args[0])))
        false => okResult(nullValue())
      }
    )
    "description" => okResult(stringValue(symbolDescription(args[0])))
    "toString" => okResult(stringValue(("Symbol(" + symbolDescription(args[0])) + ")"))
    _ => callImportedModuleFunction(interpreter, env, "symbol", name, children)
  }
}

symbolValue(
  description: String,
  key: String,
  global: Bool
) -> RuntimeValue => structValue("Symbol", [
  RuntimeField { name: "description", value: stringValue(description) },
  RuntimeField { name: "key", value: stringValue(key) },
  RuntimeField { name: "global", value: boolValue(global) }
])

symbolDescription(value: RuntimeValue) -> String => runtimeText(runtimeStructField(value, "description"))

symbolKey(value: RuntimeValue) -> String => runtimeText(runtimeStructField(value, "key"))

symbolGlobal(value: RuntimeValue) -> Bool => runtimeBool(runtimeStructField(value, "global"))

callIterModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "range" => okResult(iteratorValue(iterRangeValues(runtimeInt(args[0]), runtimeInt(args[1]), 1, []), 0))
    "rangeStep" => okResult(iteratorValue(iterRangeValues(runtimeInt(args[0]), runtimeInt(args[1]), runtimeInt(args[2]), []), 0))
    "repeat" => okResult(iteratorValue(iterRepeatValues(args[0], runtimeInt(args[1]), []), 0))
    "fromArray" => okResult(iteratorValue(runtimeArray(args[0]).clone(), 0))
    "empty" => okResult(iteratorValue(emptyRuntimeArray(), 0))
    "new" => okResult(iterNewValue(args[0]))
    _ => callImportedModuleFunction(interpreter, env, "iter", name, children)
  }
}

callStringBufferModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "new" => okResult(stringBufferValue(""))
    "from" => okResult(stringBufferValue(runtimeText(args[0])))
    _ => callImportedModuleFunction(interpreter, env, "stringbuffer", name, children)
  }
}

callPathModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "basename" => okResult(stringValue(pathBasename(runtimeText(args[0]))))
    "extname" => okResult(stringValue(pathExtname(runtimeText(args[0]))))
    "dirname" => okResult(stringValue(pathDirname(runtimeText(args[0]))))
    "join" => okResult(stringValue(pathJoin(runtimeStringArray(args[0]))))
    "normalize" => okResult(stringValue(pathNormalize(runtimeText(args[0]))))
    "resolve" => okResult(stringValue(pathResolve(runtimeStringArray(args[0]))))
    "relative" => okResult(stringValue(pathRelative(runtimeText(args[0]), runtimeText(args[1]))))
    "isAbsolute" => okResult(boolValue(pathIsAbsolute(runtimeText(args[0]))))
    "joinParts" => okResult(stringValue(pathJoinParts(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeText(args[2]))))
    "appendPathPart" => okResult(stringValue(pathAppendPart(runtimeText(args[0]), runtimeText(args[1]))))
    "normalizeParts" => okResult(arrayValue(stringArrayValues(pathNormalizeParts(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeBool(args[2]), runtimeStringArray(args[3])), 0, [])))
    "normalizePart" => okResult(arrayValue(stringArrayValues(pathNormalizePart(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeBool(args[2]), runtimeStringArray(args[3])), 0, [])))
    "normalizeParent" => okResult(arrayValue(stringArrayValues(pathNormalizeParent(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeBool(args[2]), runtimeStringArray(args[3])), 0, [])))
    "normalizePop" => okResult(arrayValue(stringArrayValues(pathNormalizePop(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeBool(args[2]), runtimeStringArray(args[3])), 0, [])))
    "normalizePush" => okResult(arrayValue(stringArrayValues(pathNormalizePush(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeBool(args[2]), runtimeStringArray(args[3]), runtimeText(args[4])), 0, [])))
    "pathParts" => okResult(arrayValue(stringArrayValues(pathParts(runtimeText(args[0])), 0, [])))
    "collectPathParts" => okResult(arrayValue(stringArrayValues(pathCollectParts(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeStringArray(args[2])), 0, [])))
    "collectPathPart" => okResult(arrayValue(stringArrayValues(pathCollectPart(runtimeStringArray(args[0]), runtimeInt(args[1]), runtimeStringArray(args[2])), 0, [])))
    "relativeFromParts" => okResult(stringValue(pathRelativeFromParts(runtimeStringArray(args[0]), runtimeStringArray(args[1]), runtimeInt(args[2]))))
    "relativeTail" => okResult(stringValue(pathRelativeTail(runtimeStringArray(args[0]), runtimeStringArray(args[1]), runtimeInt(args[2]), runtimeInt(args[3]), runtimeText(args[4]))))
    _ => callImportedModuleFunction(interpreter, env, "path", name, children)
  }
}

callProcessModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  name {
    "platform" => okResult(stringValue("go"))
    "argv" => okResult(arrayValue(emptyRuntimeArray()))
    "cwd" => okResult(stringValue("."))
    "env" => okResult(nullValue())
    "exit" => errorResult("process.exit(" + intToString(runtimeInt(evalArgs(interpreter, env, children, 1)[0])) + ")")
    _ => callImportedModuleFunction(interpreter, env, "process", name, children)
  }
}

callFsModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "writeFileText" => fsWriteText(interpreter, runtimeText(args[0]), runtimeText(args[1]))
    "readFileText" => fsReadText(interpreter, runtimeText(args[0]))
    "writeFile" => fsWriteBytes(interpreter, runtimeText(args[0]), args[1])
    "readFile" => fsReadBytes(interpreter, runtimeText(args[0]))
    "exists" => okResult(resultOk(boolValue(fsExists(interpreter, runtimeText(args[0])))))
    "mkdir" => fsMkdir(interpreter, runtimeText(args[0]))
    "remove" => fsRemove(interpreter, runtimeText(args[0]))
    "readdir" => fsReaddir(interpreter, runtimeText(args[0]))
    "stat" => fsStat(interpreter, runtimeText(args[0]))
    _ => callImportedModuleFunction(interpreter, env, "fs", name, children)
  }
}

callNetModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "listen" => okResult(resultOk(netListenerValue(runtimeText(args[0]), false)))
    "connect" => okResult(resultOk(netConnectionValue(runtimeText(args[0]), emptyRuntimeArray(), false)))
    _ => callImportedModuleFunction(interpreter, env, "net", name, children)
  }
}

netListenerValue(
  address: String,
  closed: Bool
) -> RuntimeValue => structValue("TCPListener", [
  RuntimeField { name: "address", value: stringValue(address) },
  RuntimeField { name: "closed", value: boolValue(closed) }
])

netConnectionValue(
  address: String,
  data: Array[RuntimeValue],
  closed: Bool
) -> RuntimeValue => structValue("TCPConnection", [
  RuntimeField { name: "address", value: stringValue(address) },
  RuntimeField { name: "data", value: arrayValue(data) },
  RuntimeField { name: "closed", value: boolValue(closed) }
])

isNetListenerValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "TCPListener")

isNetConnectionValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "TCPConnection")

netListenerAddress(value: RuntimeValue) -> String => runtimeText(runtimeStructField(value, "address"))

netListenerClosed(value: RuntimeValue) -> Bool => runtimeBool(runtimeStructField(value, "closed"))

netConnectionAddress(value: RuntimeValue) -> String => runtimeText(runtimeStructField(value, "address"))

netConnectionData(value: RuntimeValue) -> Array[RuntimeValue] => runtimeArray(runtimeStructField(value, "data"))

netConnectionClosed(value: RuntimeValue) -> Bool => runtimeBool(runtimeStructField(value, "closed"))

fsWriteText(
  interpreter: Interpreter,
  path: String,
  text: String
) -> EvalResult => {
  interpreter.fsFiles[path] = text
  interpreter.fsFileBytes[path] = emptyRuntimeArray()
  interpreter.fsFileExists[path] = true
  interpreter.fsDirs[pathDirname(path)] = true
  okResult(resultOk(voidValue()))
}

fsReadText(
  interpreter: Interpreter,
  path: String
) -> EvalResult => (
  fsFileExists(interpreter, path) ? okResult(resultOk(stringValue(interpreter.fsFiles[path] ?? "")))
    : okResult(resultErr("file not found: " + path))
)

fsWriteBytes(
  interpreter: Interpreter,
  path: String,
  value: RuntimeValue
) -> EvalResult => {
  interpreter.fsFiles[path] = runtimeBytesText(value)
  interpreter.fsFileBytes[path] = runtimeBytes(value).clone()
  interpreter.fsFileExists[path] = true
  interpreter.fsDirs[pathDirname(path)] = true
  okResult(resultOk(voidValue()))
}

fsReadBytes(
  interpreter: Interpreter,
  path: String
) -> EvalResult => (
  fsFileExists(interpreter, path) ? okResult(resultOk(bytesValue((interpreter.fsFileBytes[path] ?? emptyRuntimeArray()).clone())))
    : okResult(resultErr("file not found: " + path))
)

fsMkdir(
  interpreter: Interpreter,
  path: String
) -> EvalResult => {
  interpreter.fsDirs[path] = true
  okResult(resultOk(voidValue()))
}

fsRemove(
  interpreter: Interpreter,
  path: String
) -> EvalResult => {
  interpreter.fsFileExists[path] = false
  interpreter.fsFileBytes[path] = emptyRuntimeArray()
  interpreter.fsDirs[path] = false
  okResult(resultOk(voidValue()))
}

fsReaddir(
  interpreter: Interpreter,
  path: String
) -> EvalResult => okResult(resultOk(arrayValue(fsReaddirValues(interpreter, path, fsKnownPaths(interpreter), 0, []))))

fsStat(
  interpreter: Interpreter,
  path: String
) -> EvalResult => (
  fsFileExists(interpreter, path) || fsDirExists(interpreter, path) ? okResult(resultOk(fileStatValue(fsSize(interpreter, path), fsFileExists(interpreter, path), fsDirExists(interpreter, path))))
    : okResult(resultErr("file not found: " + path))
)

fsExists(
  interpreter: Interpreter,
  path: String
) -> Bool => fsFileExists(interpreter, path) || fsDirExists(interpreter, path)

fsFileExists(
  interpreter: Interpreter,
  path: String
) -> Bool => interpreter.fsFileExists[path] ?? false

fsDirExists(
  interpreter: Interpreter,
  path: String
) -> Bool => interpreter.fsDirs[path] ?? false

fsSize(
  interpreter: Interpreter,
  path: String
) -> Int => (
  fsFileExists(interpreter, path) ? (
    (interpreter.fsFileBytes[path] ?? emptyRuntimeArray()).length() > 0 ? (interpreter.fsFileBytes[path] ?? emptyRuntimeArray()).length()
      : (interpreter.fsFiles[path] ?? "").length()
  )
    : 0
)

fileStatValue(
  size: Int,
  isFile: Bool,
  isDirectory: Bool
) -> RuntimeValue => structValue("FileStat", [
  RuntimeField { name: "size", value: intValue(size) },
  RuntimeField { name: "isFile", value: boolValue(isFile) },
  RuntimeField { name: "isDirectory", value: boolValue(isDirectory) }
])

resultOk(
  value: RuntimeValue
) -> RuntimeValue => enumPayloadValue("Result", "Ok", 0, [value])

resultErr(
  message: String
) -> RuntimeValue => enumPayloadValue("Result", "Err", 1, [errorValue(message)])

errorValue(
  message: String
) -> RuntimeValue => structValue("Error", [
  RuntimeField { name: "code", value: intValue(1) },
  RuntimeField { name: "message", value: stringValue(message) },
  RuntimeField { name: "cause", value: nullValue() }
])

runtimeBytesText(
  value: RuntimeValue
) -> String => formatValues(runtimeBytes(value), 0, "")

fsKnownPaths(
  interpreter: Interpreter
) -> Array[String] => fsKnownFilePaths(interpreter, fsKnownDirPaths(interpreter, [""].slice(0, 0)), [""].slice(0, 0))

fsKnownDirPaths(
  interpreter: Interpreter,
  out: Array[String]
) -> Array[String] => fsKnownDirPathsFromKeys(interpreter, interpreter.fsDirs.keys(), 0, out)

fsKnownFilePaths(
  interpreter: Interpreter,
  dirs: Array[String],
  out: Array[String]
) -> Array[String] => fsKnownFilePathsFromKeys(interpreter, interpreter.fsFileExists.keys(), 0, dirs, out)

fsKnownDirPathsFromKeys(
  interpreter: Interpreter,
  keys: Array[String],
  index: Int,
  out: Array[String]
) -> Array[String] => (
  index >= keys.length() ? out
    : fsKnownDirPathsFromKeys(interpreter, keys, index + 1, (
      fsDirExists(interpreter, keys[index]) ? pushString(out, keys[index])
        : out
    ))
)

fsKnownFilePathsFromKeys(
  interpreter: Interpreter,
  keys: Array[String],
  index: Int,
  dirs: Array[String],
  out: Array[String]
) -> Array[String] => (
  index >= keys.length() ? appendStringArrays(dirs, 0, out)
    : fsKnownFilePathsFromKeys(interpreter, keys, index + 1, dirs, (
      fsFileExists(interpreter, keys[index]) ? pushString(out, keys[index])
        : out
    ))
)

fsReaddirValues(
  interpreter: Interpreter,
  path: String,
  paths: Array[String],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= paths.length() ? out
    : fsReaddirValues(interpreter, path, paths, index + 1, (
      fsDirectChild(path, paths[index]) ? pushRuntime(out, stringValue(pathBasename(paths[index])))
        : out
    ))
)

fsDirectChild(
  dir: String,
  child: String
) -> Bool => (
  (child != dir) && (pathDirname(child) == dir)
)

appendStringArrays(
  values: Array[String],
  index: Int,
  out: Array[String]
) -> Array[String] => (
  index >= values.length() ? out
    : appendStringArrays(values, index + 1, pushString(out, values[index]))
)

iteratorValue(
  values: Array[RuntimeValue],
  index: Int
) -> RuntimeValue => structValue("Iterator", [
  RuntimeField { name: "values", value: arrayValue(values) },
  RuntimeField { name: "index", value: intValue(index) }
])

iteratorNextValue(
  iterator: RuntimeValue
) -> RuntimeValue => structValue("IteratorNext", [
  RuntimeField { name: "iterator", value: iterator }
])

isIteratorValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "Iterator")

isIteratorNextValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "IteratorNext")

iterNewValue(value: RuntimeValue) -> RuntimeValue => (
  isIteratorNextValue(value) ? runtimeStructField(value, "iterator")
    : value
)

iterRangeValues(
  current: Int,
  end: Int,
  step: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  step == 0 ? out
    : (
      step > 0 ? (
        current >= end ? out
          : iterRangeValues(current + step, end, step, pushRuntime(out, intValue(current)))
      )
        : (
          current <= end ? out
            : iterRangeValues(current + step, end, step, pushRuntime(out, intValue(current)))
        )
    )
)

iterRepeatValues(
  value: RuntimeValue,
  count: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  count <= 0 ? out
    : iterRepeatValues(value, count - 1, pushRuntime(out, value))
)

stringBufferValue(text: String) -> RuntimeValue => structValue("StringBuffer", [
  RuntimeField { name: "text", value: stringValue(text) }
])

isStringBufferValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "StringBuffer")

runtimeStringArray(value: RuntimeValue) -> Array[String] => runtimeStringArrayAt(runtimeArray(value), 0, [])

runtimeStringArrayAt(
  values: Array[RuntimeValue],
  index: Int,
  out: Array[String]
) -> Array[String] => (
  index >= values.length() ? out
    : runtimeStringArrayAt(values, index + 1, [..out, runtimeText(values[index])])
)

pathBasename(path: String) -> String => {
  clean := pathNormalize(path)
  index := clean.lastIndexOf("/")
  (
    index < 0 ? clean
      : (
        index == (clean.length() - 1) ? clean
          : clean.slice(index + 1, clean.length())
      )
  )
}

pathExtname(path: String) -> String => {
  base := pathBasename(path)
  index := base.lastIndexOf(".")
  (
    index <= 0 ? ""
      : base.slice(index, base.length())
  )
}

pathDirname(path: String) -> String => {
  clean := pathNormalize(path)
  index := clean.lastIndexOf("/")
  (
    index < 0 ? "."
      : (
        index == 0 ? "/"
          : clean.slice(0, index)
      )
  )
}

pathJoin(parts: Array[String]) -> String => pathNormalize(pathJoinParts(parts, 0, ""))

pathNormalize(path: String) -> String => {
  absolute := pathIsAbsolute(path)
  pieces := path.split("/")
  out := pathNormalizeParts(pieces, 0, absolute, pieces.slice(0, 0))
  joined := pathJoinParts(out, 0, "")
  (
    absolute ? "/" + joined
      : (
        joined.isEmpty() ? "."
          : joined
      )
  )
}

pathResolve(parts: Array[String]) -> String => (
  parts.length() == 0 ? "."
    : (
      pathIsAbsolute(parts[0]) ? pathNormalize(pathJoin(parts))
        : pathNormalize(pathJoin(parts))
    )
)

pathRelative(
  from: String,
  to: String
) -> String => {
  fromParts := pathParts(pathResolve([from]))
  toParts := pathParts(pathResolve([to]))
  pathRelativeFromParts(fromParts, toParts, 0)
}

pathIsAbsolute(path: String) -> Bool => path.startsWith("/")

pathJoinParts(
  parts: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= parts.length() ? out
    : pathJoinParts(parts, index + 1, pathAppendPart(out, parts[index]))
)

pathAppendPart(
  out: String,
  part: String
) -> String => (
  out.isEmpty() ? part
    : (
      part.isEmpty() ? out
        : (out + "/") + part
    )
)

pathNormalizeParts(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String]
) -> Array[String] => (
  index >= parts.length() ? out
    : pathNormalizePart(parts, index, absolute, out)
)

pathNormalizePart(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String]
) -> Array[String] => {
  part := parts[index]
  (
    part.isEmpty() || (part == ".") ? pathNormalizeParts(parts, index + 1, absolute, out)
      : (
        part == ".." ? pathNormalizeParent(parts, index, absolute, out)
          : pathNormalizePush(parts, index, absolute, out, part)
      )
  )
}

pathNormalizeParent(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String]
) -> Array[String] => (
  out.length() > 0 ? pathNormalizePop(parts, index, absolute, out)
    : (
      absolute ? pathNormalizeParts(parts, index + 1, absolute, out)
        : pathNormalizePush(parts, index, absolute, out, "..")
    )
)

pathNormalizePop(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String]
) -> Array[String] => pathNormalizeParts(parts, index + 1, absolute, out.slice(0, out.length() - 1))

pathNormalizePush(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String],
  part: String
) -> Array[String] => pathNormalizeParts(parts, index + 1, absolute, [..out, part])

pathParts(path: String) -> Array[String] => {
  clean := pathNormalize(path)
  pieces := clean.split("/")
  pathCollectParts(pieces, 0, pieces.slice(0, 0))
}

pathCollectParts(
  parts: Array[String],
  index: Int,
  out: Array[String]
) -> Array[String] => (
  index >= parts.length() ? out
    : (
      parts[index].isEmpty() ? pathCollectParts(parts, index + 1, out)
        : pathCollectPart(parts, index, out)
    )
)

pathCollectPart(
  parts: Array[String],
  index: Int,
  out: Array[String]
) -> Array[String] => pathCollectParts(parts, index + 1, [..out, parts[index]])

pathRelativeFromParts(
  fromParts: Array[String],
  toParts: Array[String],
  index: Int
) -> String => (
  (index < fromParts.length()) && ((index < toParts.length()) && (fromParts[index] == toParts[index])) ? pathRelativeFromParts(fromParts, toParts, index + 1)
    : pathRelativeTail(fromParts, toParts, index, index, "")
)

pathRelativeTail(
  fromParts: Array[String],
  toParts: Array[String],
  fromIndex: Int,
  toIndex: Int,
  out: String
) -> String => (
  fromIndex < fromParts.length() ? pathRelativeTail(fromParts, toParts, fromIndex + 1, toIndex, pathAppendPart(out, ".."))
    : (
      toIndex < toParts.length() ? pathRelativeTail(fromParts, toParts, fromIndex, toIndex + 1, pathAppendPart(out, toParts[toIndex]))
        : (
          out.isEmpty() ? "."
            : out
        )
    )
)

callBytesModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "new" => okResult(bytesValue(bytesZeroes(runtimeInt(args[0]), [])))
    "fromInts" => okResult(bytesFromInts(runtimeArray(args[0]), 0, []))
    _ => callImportedModuleFunction(interpreter, env, "bytes", name, children)
  }
}

callJsonModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "parse" => jsonParse(runtimeText(args[0]))
    "stringify" => okResult(stringValue(jsonStringify(args[0])))
    _ => callImportedModuleFunction(interpreter, env, "json", name, children)
  }
}

callRegexModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "new" => okResult(regexValue(runtimeText(args[0]), canonicalRegexFlags(runtimeText(args[1])), 0))
    "escape" => okResult(stringValue(regexEscape(runtimeText(args[0]), 0, "")))
    _ => callImportedModuleFunction(interpreter, env, "regex", name, children)
  }
}

callCompressModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "gzip" | "deflate" | "brotli" | "zstd" => okResult(resultOk(args[0]))
    "gunzip" | "inflate" | "unbrotli" | "unzstd" => okResult(resultOk(args[0]))
    "gzipText" => okResult(resultOk(compressedTextValue("gzip", runtimeText(args[0]))))
    "gunzipText" => decompressTextValue("gzip", args[0])
    "brotliText" => okResult(resultOk(compressedTextValue("brotli", runtimeText(args[0]))))
    "unbrotliText" => decompressTextValue("brotli", args[0])
    "zstdText" => okResult(resultOk(compressedTextValue("zstd", runtimeText(args[0]))))
    "unzstdText" => decompressTextValue("zstd", args[0])
    _ => callImportedModuleFunction(interpreter, env, "compress", name, children)
  }
}

compressedTextValue(
  codec: String,
  text: String
) -> RuntimeValue => structValue("CompressedData", [
  RuntimeField { name: "codec", value: stringValue(codec) },
  RuntimeField { name: "text", value: stringValue(text) }
])

decompressTextValue(
  codec: String,
  value: RuntimeValue
) -> EvalResult => value {
  Struct(typeName, fields) => (
    typeName == "CompressedData" ? decompressCompressedText(codec, value)
      : okResult(resultErr("compressed data expected"))
  )
  _ => okResult(resultErr("compressed data expected"))
}

decompressCompressedText(
  codec: String,
  value: RuntimeValue
) -> EvalResult => (
  runtimeText(runtimeStructField(value, "codec")) == codec ? okResult(resultOk(runtimeStructField(value, "text")))
    : okResult(resultErr("compressed codec mismatch"))
)

callJsonFromJson(
  interpreter: Interpreter,
  env: RuntimeEnv,
  typeName: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  parsed := jsonParse(runtimeText(args[0]))
  (
    !parsed.ok ? parsed
      : okResult(jsonDecodeValue(interpreter, parsed.value, typeName))
  )
}

callBufferModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "new" => okResult(bufferValue(emptyRuntimeArray()))
    "fromBytes" => okResult(bufferValue(runtimeBytes(args[0]).clone()))
    _ => callImportedModuleFunction(interpreter, env, "buffer", name, children)
  }
}

callReaderModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "new" => okResult(readerValue(runtimeBytes(args[0]).clone(), 0, 0))
    _ => callImportedModuleFunction(interpreter, env, "reader", name, children)
  }
}

callWriterModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "new" => okResult(writerValue(emptyRuntimeArray(), 0))
    "withCapacity" => okResult(writerValue(bytesZeroes(0 * runtimeInt(args[0]), emptyRuntimeArray()), 0))
    _ => callImportedModuleFunction(interpreter, env, "writer", name, children)
  }
}

bytesValue(values: Array[RuntimeValue]) -> RuntimeValue => structValue("Bytes", [
  RuntimeField { name: "data", value: arrayValue(values) }
])

isBytesValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "Bytes")

runtimeBytes(value: RuntimeValue) -> Array[RuntimeValue] => runtimeArray(runtimeStructField(value, "data"))

bufferValue(values: Array[RuntimeValue]) -> RuntimeValue => structValue("Buffer", [
  RuntimeField { name: "data", value: arrayValue(values) }
])

isBufferValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "Buffer")

runtimeBuffer(value: RuntimeValue) -> Array[RuntimeValue] => runtimeArray(runtimeStructField(value, "data"))

readerValue(
  values: Array[RuntimeValue],
  offset: Int,
  nibble: Int
) -> RuntimeValue => structValue("Reader", [
  RuntimeField { name: "data", value: arrayValue(values) },
  RuntimeField { name: "offset", value: intValue(offset) },
  RuntimeField { name: "nibble", value: intValue(nibble) }
])

isReaderValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "Reader")

runtimeReaderData(value: RuntimeValue) -> Array[RuntimeValue] => runtimeArray(runtimeStructField(value, "data"))

runtimeReaderOffset(value: RuntimeValue) -> Int => runtimeInt(runtimeStructField(value, "offset"))

runtimeReaderNibble(value: RuntimeValue) -> Int => runtimeInt(runtimeStructField(value, "nibble"))

writerValue(
  values: Array[RuntimeValue],
  nibble: Int
) -> RuntimeValue => structValue("Writer", [
  RuntimeField { name: "data", value: arrayValue(values) },
  RuntimeField { name: "nibble", value: intValue(nibble) }
])

isWriterValue(value: RuntimeValue) -> Bool => (runtimeKind(value) == RuntimeValueKind.Struct) && (runtimeTypeName(value) == "Writer")

runtimeWriterData(value: RuntimeValue) -> Array[RuntimeValue] => runtimeArray(runtimeStructField(value, "data"))

runtimeWriterNibble(value: RuntimeValue) -> Int => runtimeInt(runtimeStructField(value, "nibble"))

bytesZeroes(
  count: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  count <= 0 ? out
    : bytesZeroes(count - 1, pushRuntime(out, intValue(0)))
)

bytesFromInts(
  values: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue]
) -> RuntimeValue => (
  index >= values.length() ? bytesValue(out)
    : bytesFromInts(values, index + 1, pushRuntime(out, intValue(positiveModulo(runtimeInt(values[index]), 256))))
)

callNumericModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  module: String,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "fromInt" => numericFromInt(module, args[0])
    "toInt" => numericToInt(args[0])
    "fromDouble" => numericFromDouble(module, args[0])
    "toDouble" => numericToDouble(args[0])
    _ => callImportedModuleFunction(interpreter, env, module, name, children)
  }
}

callIntModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "toString" => args[0] {
      Int(raw, typeName) => okResult(stringValue(intToString(raw)))
      _ => errorResult("int.toString expects Int")
    }
    "toDouble" => args[0] {
      Int(raw, typeName) => okResult(doubleRuntimeValue(@int.toDouble(raw)))
      _ => errorResult("int.toDouble expects Int")
    }
    "toBigInt" => args[0] {
      Int(raw, typeName) => okResult(bigIntRuntimeValue(raw))
      _ => errorResult("int.toBigInt expects Int")
    }
    _ => callImportedModuleFunction(interpreter, env, "int", name, children)
  }
}

callBigIntModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "fromInt" => args[0] {
      Int(raw, typeName) => okResult(bigIntRuntimeValue(raw))
      _ => errorResult("bigint.fromInt expects Int")
    }
    "toDouble" => (
      isBigIntRuntime(args[0]) ? okResult(doubleRuntimeValue(@int.toDouble(parseBigIntRuntime(args[0]))))
        : errorResult("bigint.toDouble expects BigInt")
    )
    "toString" => (
      isBigIntRuntime(args[0]) ? okResult(stringValue(runtimeText(args[0])))
        : errorResult("bigint.toString expects BigInt")
    )
    _ => callImportedModuleFunction(interpreter, env, "bigint", name, children)
  }
}

callDoubleModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  args[0] {
    Double(raw, text, typeName) => name {
      "trunc" => okResult(intValue(doubleTruncToInt(raw)))
      "floor" => okResult(intValue(doubleFloorToInt(raw)))
      "ceil" => okResult(intValue(doubleCeilToInt(raw)))
      "round" => okResult(intValue(doubleRoundToInt(raw)))
      _ => callImportedModuleFunction(interpreter, env, "double", name, children)
    }
    _ => errorResult("double." + name + " expects Double")
  }
}

numericFromInt(
  module: String,
  value: RuntimeValue
) -> EvalResult => value {
  Int(raw, typeName) => okResult(typedIntValue(wrapNumericInt(module, raw), numericTypeName(module)))
  _ => errorResult("numeric conversion expects Int")
}

numericToInt(value: RuntimeValue) -> EvalResult => value {
  Int(raw, typeName) => okResult(intValue(raw))
  _ => errorResult("numeric conversion expects integer value")
}

numericFromDouble(
  module: String,
  value: RuntimeValue
) -> EvalResult => value {
  Double(raw, text, typeName) => module {
    "float" => okResult(typedDoubleValue(raw, "Float"))
    _ => errorResult("float.fromDouble expects Double")
  }
  _ => errorResult("float.fromDouble expects Double")
}

numericToDouble(value: RuntimeValue) -> EvalResult => value {
  Double(raw, text, typeName) => okResult(doubleRuntimeValue(raw))
  _ => errorResult("float.toDouble expects Float")
}

numericTypeName(module: String) -> String => module {
  "int4" => "Int4"
  "int8" => "Int8"
  "int16" => "Int16"
  "int64" => "Int64"
  "uint" => "UInt"
  "uint8" => "UInt8"
  "uint16" => "UInt16"
  _ => "UInt64"
}

wrapNumericInt(
  module: String,
  value: Int
) -> Int => module {
  "int4" => wrapSignedInt(value, 16, 8)
  "int8" => wrapSignedInt(value, 256, 128)
  "int16" => wrapSignedInt(value, 65536, 32768)
  "uint8" => positiveModulo(value, 256)
  "uint16" => positiveModulo(value, 65536)
  _ => value
}

wrapSignedInt(
  value: Int,
  modulus: Int,
  half: Int
) -> Int => {
  n := positiveModulo(value, modulus)
  (
    n >= half ? n - modulus
      : n
  )
}

positiveModulo(
  value: Int,
  modulus: Int
) -> Int => {
  n := value % modulus
  (
    n < 0 ? n + modulus
      : n
  )
}

doubleTruncToInt(value: Double) -> Int => (value < 0.0) {
  true => 0 - doubleFloorToInt(0.0 - value)
  false => doubleFloorToInt(value)
}

doubleFloorToInt(value: Double) -> Int => (value < 0.0) {
  true => 0 - doubleCeilPositiveToInt(0.0 - value)
  false => doubleFloorPositiveToInt(value)
}

doubleCeilToInt(value: Double) -> Int => (value < 0.0) {
  true => 0 - doubleFloorPositiveToInt(0.0 - value)
  false => doubleCeilPositiveToInt(value)
}

doubleRoundToInt(value: Double) -> Int => (value < 0.0) {
  true => 0 - doubleFloorToInt((0.0 - value) + 0.5)
  false => doubleFloorToInt(value + 0.5)
}

doubleFloorPositiveToInt(value: Double) -> Int => doubleFloorSearch(value, 0, doubleUpperBound(value, 1))

doubleCeilPositiveToInt(value: Double) -> Int => {
  floor := doubleFloorPositiveToInt(value)
  (
    @int.toDouble(floor) == value ? floor
      : floor + 1
  )
}

doubleUpperBound(
  value: Double,
  upper: Int
) -> Int => (
  @int.toDouble(upper) > value ? upper
    : doubleUpperBound(value, upper * 2)
)

doubleFloorSearch(
  value: Double,
  low: Int,
  high: Int
) -> Int => (
  low + 1 >= high ? low
    : doubleFloorSearchStep(value, low, high, (low + high) / 2)
)

doubleFloorSearchStep(
  value: Double,
  low: Int,
  high: Int,
  mid: Int
) -> Int => (
  @int.toDouble(mid) <= value ? doubleFloorSearch(value, mid, high)
    : doubleFloorSearch(value, low, mid)
)

callCliModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  name {
    "command" => okResult(cliCommandValue(runtimeText(args[0]), runtimeText(args[1])))
    "withVersion" => okResult(cliWithVersion(args[0], args[1]))
    "withOption" => okResult(cliWithOption(args[0], args[1]))
    "withArgument" => okResult(cliWithArgument(args[0], args[1]))
    "flag" => okResult(cliFlagValue(runtimeText(args[0]), runtimeText(args[1]), runtimeText(args[2])))
    "option" => okResult(cliOptionValue(runtimeText(args[0]), runtimeText(args[1]), runtimeText(args[2]), runtimeText(args[3]), runtimeBool(args[4]), args[5]))
    "argument" => okResult(cliArgumentValue(runtimeText(args[0]), runtimeText(args[1]), runtimeBool(args[2])))
    "alias" => okResult(cliAliasValue(runtimeText(args[0]), runtimeText(args[1])))
    "parse" => okResult(cliParseArgsValue(args[0], emptyRuntimeArray()))
    "exitHelp" => errorResult("process.exit(0)")
    "exitError" => errorResult("process.exit(2)")
    "parseOrExit" => cliParseOrExitResult(args[0])
    "parseArgs" => okResult(cliParseArgsValue(args[0], runtimeArray(args[1])))
    "parseCommandArgs" => okResult(cliParseCommandArgsValue(args[0], runtimeArray(args[1]), runtimeArray(args[2]), runtimeArray(args[3]), runtimeArray(args[4])))
    "help" => okResult(stringValue(cliHelpText(args[0])))
    "contains" => okResult(boolValue(cliContainsString(runtimeArray(args[0]), runtimeText(args[1]))))
    _ => callImportedModuleFunction(interpreter, env, "cli", name, children)
  }
}

cliContainsString(
  values: Array[RuntimeValue],
  value: String
) -> Bool => cliContainsStringAt(values, value, 0)

cliContainsStringAt(
  values: Array[RuntimeValue],
  value: String,
  index: Int
) -> Bool => (
  index >= values.length() ? false
    : (
      runtimeText(values[index]) == value ? true
        : cliContainsStringAt(values, value, index + 1)
    )
)

cliParseOrExitResult(command: RuntimeValue) -> EvalResult => {
  result := cliParseArgsValue(command, emptyRuntimeArray())
  help := runtimeBool(runtimeStructField(result, "help"))
  error := runtimeStructField(result, "error")
  (
    help ? errorResult("process.exit(0)")
      : (
        runtimeKind(error) == RuntimeValueKind.Null ? okResult(result)
          : errorResult("process.exit(2)")
      )
  )
}

cliCommandValue(
  name: String,
  about: String
) -> RuntimeValue => structValue("CliCommand", [
  RuntimeField { name: "name", value: stringValue(name) },
  RuntimeField { name: "version", value: nullValue() },
  RuntimeField { name: "about", value: stringValue(about) },
  RuntimeField { name: "options", value: arrayValue(emptyRuntimeArray()) },
  RuntimeField { name: "arguments", value: arrayValue(emptyRuntimeArray()) }
])

cliOptionValue(
  name: String,
  short: String,
  valueName: String,
  help: String,
  required: Bool,
  defaultValue: RuntimeValue
) -> RuntimeValue => structValue("CliOption", [
  RuntimeField { name: "name", value: stringValue(name) },
  RuntimeField { name: "short", value: stringValue(short) },
  RuntimeField { name: "valueName", value: stringValue(valueName) },
  RuntimeField { name: "help", value: stringValue(help) },
  RuntimeField { name: "required", value: boolValue(required) },
  RuntimeField { name: "defaultValue", value: defaultValue }
])

cliFlagValue(
  name: String,
  short: String,
  help: String
) -> RuntimeValue => cliOptionValue(name, short, "", help, false, nullValue())

cliArgumentValue(
  name: String,
  help: String,
  required: Bool
) -> RuntimeValue => structValue("CliArgument", [
  RuntimeField { name: "name", value: stringValue(name) },
  RuntimeField { name: "help", value: stringValue(help) },
  RuntimeField { name: "required", value: boolValue(required) }
])

cliAliasValue(
  from: String,
  to: String
) -> RuntimeValue => structValue("CliCommandAlias", [
  RuntimeField { name: "from", value: stringValue(from) },
  RuntimeField { name: "to", value: stringValue(to) }
])

cliWithVersion(
  command: RuntimeValue,
  version: RuntimeValue
) -> RuntimeValue => structValue("CliCommand", [
  RuntimeField { name: "name", value: cliField(command, "name") },
  RuntimeField { name: "version", value: version },
  RuntimeField { name: "about", value: cliField(command, "about") },
  RuntimeField { name: "options", value: cliField(command, "options") },
  RuntimeField { name: "arguments", value: cliField(command, "arguments") }
])

cliWithOption(
  command: RuntimeValue,
  option: RuntimeValue
) -> RuntimeValue => structValue("CliCommand", [
  RuntimeField { name: "name", value: cliField(command, "name") },
  RuntimeField { name: "version", value: cliField(command, "version") },
  RuntimeField { name: "about", value: cliField(command, "about") },
  RuntimeField { name: "options", value: arrayValue(pushRuntime(runtimeArray(cliField(command, "options")), option)) },
  RuntimeField { name: "arguments", value: cliField(command, "arguments") }
])

cliWithArgument(
  command: RuntimeValue,
  argument: RuntimeValue
) -> RuntimeValue => structValue("CliCommand", [
  RuntimeField { name: "name", value: cliField(command, "name") },
  RuntimeField { name: "version", value: cliField(command, "version") },
  RuntimeField { name: "about", value: cliField(command, "about") },
  RuntimeField { name: "options", value: cliField(command, "options") },
  RuntimeField { name: "arguments", value: arrayValue(pushRuntime(runtimeArray(cliField(command, "arguments")), argument)) }
])

cliParseArgsValue(
  command: RuntimeValue,
  args: Array[RuntimeValue]
) -> RuntimeValue => {
  state := cliParseArgsLoop(command, args, 0, cliInitialParseState(command))
  finalState := cliFinalizeParse(command, state)
  structValue("CliParseResult", [
    RuntimeField { name: "command", value: command },
    RuntimeField { name: "values", value: finalState.values },
    RuntimeField { name: "flags", value: finalState.flags },
    RuntimeField { name: "positionals", value: finalState.positionals },
    RuntimeField { name: "explicitOptions", value: arrayValue(finalState.explicitOptions) },
    RuntimeField { name: "args", value: arrayValue(args) },
    RuntimeField { name: "rest", value: arrayValue(finalState.rest) },
    RuntimeField { name: "help", value: boolValue(finalState.help) },
    RuntimeField { name: "error", value: (
      finalState.error == "" ? nullValue()
        : stringValue(finalState.error)
    ) }
  ])
}

cliParseCommandArgsValue(
  root: RuntimeValue,
  commands: Array[RuntimeValue],
  aliases: Array[RuntimeValue],
  trailingRest: Array[RuntimeValue],
  args: Array[RuntimeValue]
) -> RuntimeValue => {
  split := cliSplitCommandArgs(root, aliases, args, 0, emptyRuntimeArray(), "", emptyRuntimeArray(), false)
  rootArgs := runtimeArray(cliField(split, "rootArgs"))
  commandName := runtimeText(cliField(split, "commandName"))
  commandArgs := runtimeArray(cliField(split, "commandArgs"))
  rootResult := cliParseArgsValue(root, rootArgs)
  command := cliFindCommandValue(commands, commandName, 0)
  commandFound := cliOptionFound(command)
  normalizedArgs := (
    cliContainsString(trailingRest, commandName) ? cliNormalizeTrailingRestArgs(command, commandArgs)
      : commandArgs
  )
  commandResult := (
    commandName == "" ? rootResult
      : (
        commandFound ? cliParseArgsValue(command, normalizedArgs)
          : rootResult
      )
  )
  structValue("CliCommandParseResult", [
    RuntimeField { name: "root", value: rootResult },
    RuntimeField { name: "command", value: commandResult },
    RuntimeField { name: "commandName", value: stringValue(commandName) },
    RuntimeField { name: "commandArgs", value: arrayValue(commandArgs) },
    RuntimeField { name: "error", value: (
      (commandName != "") && !commandFound ? stringValue("unknown command " + commandName)
        : nullValue()
    ) }
  ])
}

cliSplitCommandArgs(
  root: RuntimeValue,
  aliases: Array[RuntimeValue],
  args: Array[RuntimeValue],
  index: Int,
  rootArgs: Array[RuntimeValue],
  commandName: String,
  commandArgs: Array[RuntimeValue],
  skipNext: Bool
) -> RuntimeValue => (
  index >= args.length() ? structValue("CliCommandArgs", [
    RuntimeField { name: "rootArgs", value: arrayValue(rootArgs) },
    RuntimeField { name: "commandName", value: stringValue(commandName) },
    RuntimeField { name: "commandArgs", value: arrayValue(commandArgs) }
  ])
    : cliSplitCommandArg(root, aliases, args, index, rootArgs, commandName, commandArgs, skipNext)
)

cliSplitCommandArg(
  root: RuntimeValue,
  aliases: Array[RuntimeValue],
  args: Array[RuntimeValue],
  index: Int,
  rootArgs: Array[RuntimeValue],
  commandName: String,
  commandArgs: Array[RuntimeValue],
  skipNext: Bool
) -> RuntimeValue => skipNext {
  true => cliSplitCommandArgs(root, aliases, args, index + 1, rootArgs, commandName, commandArgs, false)
  _ => cliSplitCommandArgValue(root, aliases, args, index, rootArgs, commandName, commandArgs)
}

cliSplitCommandArgValue(
  root: RuntimeValue,
  aliases: Array[RuntimeValue],
  args: Array[RuntimeValue],
  index: Int,
  rootArgs: Array[RuntimeValue],
  commandName: String,
  commandArgs: Array[RuntimeValue]
) -> RuntimeValue => {
  arg := runtimeText(args[index])
  isRootHelp := (commandName == "") && ((arg == "--help") || (arg == "-h"))
  isRootOption := cliRootOptionArg(root, arg)
  consumesNext := isRootOption && cliRootOptionConsumesNext(root, arg)
  (
    isRootHelp ? cliSplitCommandArgs(root, aliases, args, index + 1, pushRuntime(rootArgs, args[index]), commandName, commandArgs, false)
      : (
        isRootOption ? cliSplitRootOptionArg(root, aliases, args, index, rootArgs, commandName, commandArgs, consumesNext)
          : (
            commandName == "" ? cliSplitCommandArgs(root, aliases, args, index + 1, rootArgs, cliResolveAlias(aliases, arg, 0), commandArgs, false)
              : cliSplitCommandArgs(root, aliases, args, index + 1, rootArgs, commandName, pushRuntime(commandArgs, args[index]), false)
          )
      )
  )
}

cliSplitRootOptionArg(
  root: RuntimeValue,
  aliases: Array[RuntimeValue],
  args: Array[RuntimeValue],
  index: Int,
  rootArgs: Array[RuntimeValue],
  commandName: String,
  commandArgs: Array[RuntimeValue],
  consumesNext: Bool
) -> RuntimeValue => {
  nextRoot := pushRuntime(rootArgs, args[index])
  nextRoot = (
    consumesNext && ((index + 1) < args.length()) ? pushRuntime(nextRoot, args[index + 1])
      : nextRoot
  )
  cliSplitCommandArgs(root, aliases, args, index + 1, nextRoot, commandName, commandArgs, consumesNext)
}

cliRootOptionArg(
  root: RuntimeValue,
  arg: String
) -> Bool => cliOptionFound(cliRootOption(root, arg))

cliRootOptionConsumesNext(
  root: RuntimeValue,
  arg: String
) -> Bool => {
  option := cliRootOption(root, arg)
  hasInline := arg.includes("=") || ((arg.startsWith("-") && !arg.startsWith("--")) && (arg.length() > 2))
  cliOptionFound(option) && ((runtimeText(cliField(option, "valueName")) != "") && !hasInline)
}

cliRootOption(
  root: RuntimeValue,
  arg: String
) -> RuntimeValue => (
  arg.startsWith("--") && (arg.length() > 2) ? cliFindOptionByName(runtimeArray(cliField(root, "options")), cliLongOptionName(arg), 0)
    : (
      (arg.startsWith("-") && (arg != "-")) ? cliFindOptionByShort(runtimeArray(cliField(root, "options")), arg.slice(1, 2), 0)
        : emptyValue()
    )
)

cliLongOptionName(
  arg: String
) -> String => {
  raw := arg.slice(2, arg.length())
  eq := raw.indexOf("=")
  (
    eq >= 0 ? raw.slice(0, eq)
      : raw
  )
}

cliResolveAlias(
  aliases: Array[RuntimeValue],
  name: String,
  index: Int
) -> String => (
  index >= aliases.length() ? name
    : (
      runtimeText(cliField(aliases[index], "from")) == name ? runtimeText(cliField(aliases[index], "to"))
        : cliResolveAlias(aliases, name, index + 1)
    )
)

cliFindCommandValue(
  commands: Array[RuntimeValue],
  name: String,
  index: Int
) -> RuntimeValue => (
  (name == "") || (index >= commands.length()) ? emptyValue()
    : (
      runtimeText(cliField(commands[index], "name")) == name ? commands[index]
        : cliFindCommandValue(commands, name, index + 1)
    )
)

cliNormalizeTrailingRestArgs(
  command: RuntimeValue,
  args: Array[RuntimeValue]
) -> Array[RuntimeValue] => cliNormalizeTrailingRestArgsAt(command, args, 0, emptyRuntimeArray(), 0, false)

cliNormalizeTrailingRestArgsAt(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue],
  positionalCount: Int,
  skipNext: Bool
) -> Array[RuntimeValue] => (
  index >= args.length() ? out
    : cliNormalizeTrailingRestArg(command, args, index, out, positionalCount, skipNext)
)

cliNormalizeTrailingRestArg(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue],
  positionalCount: Int,
  skipNext: Bool
) -> Array[RuntimeValue] => {
  arg := runtimeText(args[index])
  argumentCount := runtimeArray(cliField(command, "arguments")).length()
  (
    positionalCount >= argumentCount ? cliAppendRestSeparator(args, index, out)
      : (
        skipNext ? cliNormalizeTrailingRestArgsAt(command, args, index + 1, pushRuntime(out, args[index]), positionalCount, false)
          : (
            cliCommandOptionConsumesNext(command, arg) ? cliNormalizeTrailingRestArgsAt(command, args, index + 1, pushRuntime(out, args[index]), positionalCount, true)
              : cliNormalizeTrailingRestArgsAt(command, args, index + 1, pushRuntime(out, args[index]), positionalCount + (arg.startsWith("-") ? 0 : 1), false)
          )
      )
  )
}

cliCommandOptionConsumesNext(
  command: RuntimeValue,
  arg: String
) -> Bool => cliRootOptionConsumesNext(command, arg)

cliAppendRestSeparator(
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  runtimeText(args[index]) == "--" ? cliAppendRuntimeRest(args, index, out)
    : cliAppendRuntimeRest(args, index, pushRuntime(out, stringValue("--")))
)

cliAppendRuntimeRest(
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= args.length() ? out
    : cliAppendRuntimeRest(args, index + 1, pushRuntime(out, args[index]))
)

cliInitialParseState(
  command: RuntimeValue
) -> CliParseState => {
  values := cliDefaultValues(runtimeArray(cliField(command, "options")), 0, mapValue([]))
  CliParseState {
    values: values,
    flags: mapValue([]),
    positionals: mapValue([]),
    positionalValues: emptyRuntimeArray(),
    explicitOptions: emptyRuntimeArray(),
    rest: emptyRuntimeArray(),
    help: false,
    error: ""
  }
}

cliDefaultValues(
  options: Array[RuntimeValue],
  index: Int,
  values: RuntimeValue
) -> RuntimeValue => (
  index >= options.length() ? values
    : cliDefaultValuesNext(options, index, values)
)

cliDefaultValuesNext(
  options: Array[RuntimeValue],
  index: Int,
  values: RuntimeValue
) -> RuntimeValue => {
  option := options[index]
  valueName := runtimeText(cliField(option, "valueName"))
  defaultValue := cliField(option, "defaultValue")
  nextValues := (
    (valueName != "") && (runtimeKind(defaultValue) != RuntimeValueKind.Null) ? mapSet(values, cliField(option, "name"), defaultValue)
      : values
  )
  cliDefaultValues(options, index + 1, nextValues)
}

cliParseArgsLoop(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState
) -> CliParseState => (
  index >= args.length() ? state
    : cliParseArg(command, args, index, state)
)

cliParseArg(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState
) -> CliParseState => {
  arg := runtimeText(args[index])
  (
    state.error != "" ? state
      : (
        arg == "--" ? cliParseRest(args, index + 1, state)
          : (
            (arg == "--help") || (arg == "-h") ? cliParseArgsLoop(command, args, index + 1, cliStateHelp(state))
              : (
                (arg.startsWith("--") && (arg.length() > 2)) ? cliParseLong(command, args, index, state, arg.slice(2, arg.length()))
                  : (
                    (arg.startsWith("-") && (arg != "-")) ? cliParseShort(command, args, index, state, arg.slice(1, arg.length()))
                      : cliParseArgsLoop(command, args, index + 1, cliStatePositional(state, args[index]))
                  )
              )
          )
      )
  )
}

cliParseRest(
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState
) -> CliParseState => (
  index >= args.length() ? state
    : cliParseRest(args, index + 1, cliStateRest(state, args[index]))
)

cliParseLong(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  raw: String
) -> CliParseState => {
  eq := raw.indexOf("=")
  name := (
    eq >= 0 ? raw.slice(0, eq)
      : raw
  )
  value := (
    eq >= 0 ? raw.slice(eq + 1, raw.length())
      : ""
  )
  hasValue := eq >= 0
  noName := (
    name.startsWith("no-") ? name.slice(3, name.length())
      : ""
  )
  noOption := cliFindOptionByName(runtimeArray(cliField(command, "options")), noName, 0)
  option := cliFindOptionByName(runtimeArray(cliField(command, "options")), name, 0)
  (
    (noName != "") && cliOptionFound(noOption) && (runtimeText(cliField(noOption, "valueName")) == "") ? cliParseArgsLoop(command, args, index + 1, cliStateFlag(state, noName, false))
      : (
        !cliOptionFound(option) ? cliParseArgsLoop(command, args, index + 1, cliStateError(state, "unknown option --" + name))
          : cliParseLongOption(command, args, index, state, option, name, value, hasValue)
      )
  )
}

cliParseLongOption(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  option: RuntimeValue,
  name: String,
  value: String,
  hasValue: Bool
) -> CliParseState => (
  runtimeText(cliField(option, "valueName")) != "" ? (
    hasValue ? cliParseArgsLoop(command, args, index + 1, cliStateValue(state, runtimeText(cliField(option, "name")), value))
      : (
        (index + 1) >= args.length() ? cliParseArgsLoop(command, args, index + 1, cliStateError(state, "missing value for --" + name))
          : cliParseArgsLoop(command, args, index + 2, cliStateValue(state, runtimeText(cliField(option, "name")), runtimeText(args[index + 1])))
      )
  )
    : cliParseArgsLoop(command, args, index + 1, cliStateFlag(state, runtimeText(cliField(option, "name")), !hasValue || (value != "false")))
)

cliParseShort(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  cluster: String
) -> CliParseState => cliParseShortAt(command, args, index, state, cluster, 0)

cliParseShortAt(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  cluster: String,
  pos: Int
) -> CliParseState => (
  pos >= cluster.length() ? cliParseArgsLoop(command, args, index + 1, state)
    : cliParseShortOne(command, args, index, state, cluster, pos)
)

cliParseShortOne(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  cluster: String,
  pos: Int
) -> CliParseState => {
  short := cluster.slice(pos, pos + 1)
  option := cliFindOptionByShort(runtimeArray(cliField(command, "options")), short, 0)
  (
    short == "h" ? cliParseShortAt(command, args, index, cliStateHelp(state), cluster, pos + 1)
      : (
        !cliOptionFound(option) ? cliParseArgsLoop(command, args, index + 1, cliStateError(state, "unknown option -" + short))
          : cliParseShortOption(command, args, index, state, cluster, pos, option, short)
      )
  )
}

cliParseShortOption(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  cluster: String,
  pos: Int,
  option: RuntimeValue,
  short: String
) -> CliParseState => (
  runtimeText(cliField(option, "valueName")) != "" ? cliParseShortValue(command, args, index, state, cluster, pos, option, short)
    : cliParseShortAt(command, args, index, cliStateFlag(state, runtimeText(cliField(option, "name")), true), cluster, pos + 1)
)

cliParseShortValue(
  command: RuntimeValue,
  args: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  cluster: String,
  pos: Int,
  option: RuntimeValue,
  short: String
) -> CliParseState => {
  value := cluster.slice(pos + 1, cluster.length())
  (
    value != "" ? cliParseArgsLoop(command, args, index + 1, cliStateValue(state, runtimeText(cliField(option, "name")), value))
      : (
        (index + 1) >= args.length() ? cliParseArgsLoop(command, args, index + 1, cliStateError(state, "missing value for -" + short))
          : cliParseArgsLoop(command, args, index + 2, cliStateValue(state, runtimeText(cliField(option, "name")), runtimeText(args[index + 1])))
      )
  )
}

cliFinalizeParse(
  command: RuntimeValue,
  state: CliParseState
) -> CliParseState => {
  checked := (
    (state.error == "") && !state.help ? cliCheckRequiredOptions(runtimeArray(cliField(command, "options")), 0, state)
      : state
  )
  (
    (checked.error == "") && !checked.help ? cliBindPositionals(runtimeArray(cliField(command, "arguments")), 0, checked)
      : cliBindPresentPositionals(runtimeArray(cliField(command, "arguments")), 0, checked)
  )
}

cliCheckRequiredOptions(
  options: Array[RuntimeValue],
  index: Int,
  state: CliParseState
) -> CliParseState => (
  (index >= options.length()) || (state.error != "") ? state
    : cliCheckRequiredOption(options, index, state)
)

cliCheckRequiredOption(
  options: Array[RuntimeValue],
  index: Int,
  state: CliParseState
) -> CliParseState => {
  option := options[index]
  missing := (runtimeBool(cliField(option, "required")) && (runtimeText(cliField(option, "valueName")) != "")) && (mapEntryIndex(runtimeEntries(state.values), cliField(option, "name"), 0) < 0)
  (
    missing ? cliStateError(state, "missing required option --" + runtimeText(cliField(option, "name")))
      : cliCheckRequiredOptions(options, index + 1, state)
  )
}

cliBindPositionals(
  arguments: Array[RuntimeValue],
  index: Int,
  state: CliParseState
) -> CliParseState => (
  index >= arguments.length() ? cliCheckUnexpectedArgument(arguments, state)
    : cliBindPositional(arguments, index, state, true)
)

cliBindPresentPositionals(
  arguments: Array[RuntimeValue],
  index: Int,
  state: CliParseState
) -> CliParseState => (
  (index >= arguments.length()) || (index >= state.positionalValues.length()) ? state
    : cliBindPositional(arguments, index, state, false)
)

cliBindPositional(
  arguments: Array[RuntimeValue],
  index: Int,
  state: CliParseState,
  requireMissing: Bool
) -> CliParseState => {
  (
    index >= arguments.length() ? (
      requireMissing ? cliCheckUnexpectedArgument(arguments, state)
        : state
    )
      : (
        index < state.positionalValues.length() ? cliBindPositional(arguments, index + 1, cliStatePosition(state, runtimeText(cliField(arguments[index], "name")), state.positionalValues[index]), requireMissing)
          : (
            requireMissing && runtimeBool(cliField(arguments[index], "required")) ? cliStateError(state, "missing required argument " + runtimeText(cliField(arguments[index], "name")))
              : cliBindPositional(arguments, index + 1, state, requireMissing)
          )
      )
  )
}

cliCheckUnexpectedArgument(
  arguments: Array[RuntimeValue],
  state: CliParseState
) -> CliParseState => (
  (state.error == "") && (state.positionalValues.length() > arguments.length()) ? cliStateError(state, "unexpected argument " + runtimeText(state.positionalValues[arguments.length()]))
    : state
)

cliHelpText(
  command: RuntimeValue
) -> String => {
  usage := "Usage: " + runtimeText(cliField(command, "name"))
  usage = (
    runtimeArray(cliField(command, "options")).length() > 0 ? usage + " [options]"
      : usage
  )
  usage = cliHelpUsageArgs(runtimeArray(cliField(command, "arguments")), 0, usage) + "\n"
  about := runtimeText(cliField(command, "about"))
  withAbout := (
    about != "" ? ((usage + "\n") + about) + "\n"
      : usage
  )
  withOptions := withAbout + "\nOptions:\n"
  cliHelpOptions(runtimeArray(cliField(command, "options")), 0, withOptions) + "  -h, --help\tShow help\n"
}

cliHelpUsageArgs(
  args: Array[RuntimeValue],
  index: Int,
  out: String
) -> String => (
  index >= args.length() ? out
    : cliHelpUsageArgs(args, index + 1, out + cliHelpUsageArg(args[index]))
)

cliHelpUsageArg(
  arg: RuntimeValue
) -> String => (
  runtimeBool(cliField(arg, "required")) ? " <" + runtimeText(cliField(arg, "name")) + ">"
    : " [" + runtimeText(cliField(arg, "name")) + "]"
)

cliHelpOptions(
  options: Array[RuntimeValue],
  index: Int,
  out: String
) -> String => (
  index >= options.length() ? out
    : cliHelpOptions(options, index + 1, out + cliHelpOption(options[index]))
)

cliHelpOption(
  option: RuntimeValue
) -> String => {
  short := runtimeText(cliField(option, "short"))
  prefix := (
    short != "" ? ("  -" + short) + ", "
      : "  "
  )
  valueName := runtimeText(cliField(option, "valueName"))
  suffix := (
    valueName != "" ? " <" + valueName + ">"
      : ""
  )
  help := runtimeText(cliField(option, "help"))
  (((prefix + "--") + runtimeText(cliField(option, "name"))) + suffix) + (
    help != "" ? "\t" + help + "\n"
      : "\n"
  )
}

cliFindOptionByName(
  options: Array[RuntimeValue],
  name: String,
  index: Int
) -> RuntimeValue => (
  (name == "") || (index >= options.length()) ? emptyValue()
    : (
      runtimeText(cliField(options[index], "name")) == name ? options[index]
        : cliFindOptionByName(options, name, index + 1)
    )
)

cliFindOptionByShort(
  options: Array[RuntimeValue],
  short: String,
  index: Int
) -> RuntimeValue => (
  (short == "") || (index >= options.length()) ? emptyValue()
    : (
      runtimeText(cliField(options[index], "short")) == short ? options[index]
        : cliFindOptionByShort(options, short, index + 1)
    )
)

cliOptionFound(
  option: RuntimeValue
) -> Bool => runtimeKind(option) == RuntimeValueKind.Struct

cliField(
  value: RuntimeValue,
  name: String
) -> RuntimeValue => {
  field := fieldLookup(runtimeFields(value), name, 0)
  (
    field.found ? field.value
      : emptyValue()
  )
}

cliStateHelp(
  state: CliParseState
) -> CliParseState => {
  values: state.values,
  flags: state.flags,
  positionals: state.positionals,
  positionalValues: state.positionalValues,
  explicitOptions: state.explicitOptions,
  rest: state.rest,
  help: true,
  error: state.error
}

cliStateError(
  state: CliParseState,
  error: String
) -> CliParseState => {
  values: state.values,
  flags: state.flags,
  positionals: state.positionals,
  positionalValues: state.positionalValues,
  explicitOptions: state.explicitOptions,
  rest: state.rest,
  help: state.help,
  error: error
}

cliStateValue(
  state: CliParseState,
  name: String,
  value: String
) -> CliParseState => {
  state.values = mapSet(state.values, stringValue(name), stringValue(value))
  state.explicitOptions = pushRuntime(state.explicitOptions, stringValue(name))
  state
}

cliStateFlag(
  state: CliParseState,
  name: String,
  value: Bool
) -> CliParseState => {
  state.flags = mapSet(state.flags, stringValue(name), boolValue(value))
  state.explicitOptions = pushRuntime(state.explicitOptions, stringValue(name))
  state
}

cliStatePosition(
  state: CliParseState,
  name: String,
  value: RuntimeValue
) -> CliParseState => {
  state.positionals = mapSet(state.positionals, stringValue(name), value)
  state
}

cliStatePositional(
  state: CliParseState,
  value: RuntimeValue
) -> CliParseState => {
  state.positionalValues = pushRuntime(state.positionalValues, value)
  state
}

cliStateRest(
  state: CliParseState,
  value: RuntimeValue
) -> CliParseState => {
  state.rest = pushRuntime(state.rest, value)
  state
}

runeCliParseCli(
  args: Array[RuntimeValue]
) -> RuntimeValue => {
  root := runeCliSplitRoot(args, 0, emptyRuntimeArray(), emptyRuntimeArray(), false, false, false)
  globalArgs := runtimeArray(cliField(root, "globalArgs"))
  commandArgs := runtimeArray(cliField(root, "commandArgs"))
  backendExplicit := runtimeBool(cliField(root, "backendExplicit"))
  rootResult := cliParseArgsValue(runeCliRootCommand(), globalArgs)
  backend := runtimeText(cliField(cliField(rootResult, "values"), "missing"))
  backend = callMapGetOrString(cliField(rootResult, "values"), "backend", "go")
  errors := runeCliErrors(rootResult)
  invalidBackend := cliContainsString([stringValue("go"), stringValue("ts"), stringValue("mbt")], backend) == false
  (
    invalidBackend ? errors = pushRuntime(errors, stringValue("unsupported backend " + backend))
      : errors = errors
  )
  (
    errors.length() > 0 ? runeCliInvocation("", backend, "", "", "", "", false, false, backendExplicit, emptyRuntimeArray(), errors, false, "")
      : runeCliParseCommandAt(commandArgs, 0, backend, backendExplicit)
  )
}

runeCliSplitRoot(
  args: Array[RuntimeValue],
  position: Int,
  globalArgs: Array[RuntimeValue],
  commandArgs: Array[RuntimeValue],
  backendExplicit: Bool,
  skipNext: Bool,
  inRest: Bool
) -> RuntimeValue => (
  position >= args.length() ? structValue("RuneCliRootArgs", [
    RuntimeField { name: "globalArgs", value: arrayValue(globalArgs) },
    RuntimeField { name: "commandArgs", value: arrayValue(commandArgs) },
    RuntimeField { name: "backendExplicit", value: boolValue(backendExplicit) }
  ])
    : runeCliSplitRootNext(args, position, globalArgs, commandArgs, backendExplicit, skipNext, inRest)
)

runeCliSplitRootNext(
  args: Array[RuntimeValue],
  position: Int,
  globalArgs: Array[RuntimeValue],
  commandArgs: Array[RuntimeValue],
  backendExplicit: Bool,
  skipNext: Bool,
  inRest: Bool
) -> RuntimeValue => skipNext {
  true => runeCliSplitRoot(args, position + 1, globalArgs, commandArgs, backendExplicit, false, inRest)
  _ => runeCliSplitRootValue(args, position, globalArgs, commandArgs, backendExplicit, inRest)
}

runeCliSplitRootValue(
  args: Array[RuntimeValue],
  position: Int,
  globalArgs: Array[RuntimeValue],
  commandArgs: Array[RuntimeValue],
  backendExplicit: Bool,
  inRest: Bool
) -> RuntimeValue => {
  arg := runtimeText(args[position])
  backendPair := runeCliRootBackendPair(inRest, arg)
  hasBackendValue := backendPair && ((position + 1) < args.length())
  backendInline := runeCliRootBackendInline(inRest, arg)
  rootHelp := runeCliRootHelpArg(inRest, commandArgs.length(), arg)
  (
    backendPair ? runeCliSplitRootBackendPair(args, position, globalArgs, commandArgs, hasBackendValue, inRest)
      : (
        backendInline ? runeCliSplitRootBackendInline(args, position, globalArgs, commandArgs, inRest)
          : (
            rootHelp ? runeCliSplitRootGlobal(args, position, globalArgs, commandArgs, backendExplicit, inRest)
              : runeCliSplitRootCommand(args, position, globalArgs, commandArgs, backendExplicit, inRest)
          )
      )
  )
}

runeCliRootBackendPair(
  inRest: Bool,
  arg: String
) -> Bool => (inRest == false) && ((arg == "--backend") || (arg == "-b"))

runeCliRootBackendInline(
  inRest: Bool,
  arg: String
) -> Bool => (inRest == false) && (arg.startsWith("--backend=") || (arg.startsWith("-b") && (arg.length() > 2)))

runeCliRootHelpArg(
  inRest: Bool,
  commandCount: Int,
  arg: String
) -> Bool => ((inRest == false) && (commandCount == 0)) && ((arg == "--help") || (arg == "-h"))

runeCliSplitRootBackendPair(
  args: Array[RuntimeValue],
  position: Int,
  globalArgs: Array[RuntimeValue],
  commandArgs: Array[RuntimeValue],
  hasValue: Bool,
  inRest: Bool
) -> RuntimeValue => {
  nextGlobal := pushRuntime(globalArgs, args[position])
  nextGlobal = (
    hasValue ? pushRuntime(nextGlobal, args[position + 1])
      : nextGlobal
  )
  runeCliSplitRoot(args, position + 1, nextGlobal, commandArgs, true, hasValue, inRest)
}

runeCliSplitRootBackendInline(
  args: Array[RuntimeValue],
  position: Int,
  globalArgs: Array[RuntimeValue],
  commandArgs: Array[RuntimeValue],
  inRest: Bool
) -> RuntimeValue => runeCliSplitRoot(args, position + 1, pushRuntime(globalArgs, args[position]), commandArgs, true, false, inRest)

runeCliSplitRootGlobal(
  args: Array[RuntimeValue],
  position: Int,
  globalArgs: Array[RuntimeValue],
  commandArgs: Array[RuntimeValue],
  backendExplicit: Bool,
  inRest: Bool
) -> RuntimeValue => runeCliSplitRoot(args, position + 1, pushRuntime(globalArgs, args[position]), commandArgs, backendExplicit, false, inRest)

runeCliSplitRootCommand(
  args: Array[RuntimeValue],
  position: Int,
  globalArgs: Array[RuntimeValue],
  commandArgs: Array[RuntimeValue],
  backendExplicit: Bool,
  inRest: Bool
) -> RuntimeValue => runeCliSplitRoot(args, position + 1, globalArgs, pushRuntime(commandArgs, args[position]), backendExplicit, false, inRest || (runtimeText(args[position]) == "--"))

runeCliParseCommandAt(
  args: Array[RuntimeValue],
  index: Int,
  backend: String,
  backendExplicit: Bool
) -> RuntimeValue => (
  index >= args.length() ? runeCliInvocation("", backend, "", "", "", "", false, false, backendExplicit, emptyRuntimeArray(), emptyRuntimeArray(), true, runeCliInvocationHelpText(""))
    : runeCliDispatchCommand(runtimeText(args[index]), args.slice(index + 1, args.length()), backend, backendExplicit)
)

runeCliDispatchCommand(
  command: String,
  args: Array[RuntimeValue],
  backend: String,
  backendExplicit: Bool
) -> RuntimeValue => (
  command == "run" ? runeCliParseRun(args, backend, backendExplicit)
    : (
      command == "build" ? runeCliParseBuild(args, backend, backendExplicit)
        : (
          command == "fmt" ? runeCliParseFmt(args, backend, backendExplicit)
            : (
              command == "format" ? runeCliParseFmt(args, backend, backendExplicit)
                : (
                  command == "test" ? runeCliParseTest(args, backend, backendExplicit)
                    : (
                      command == "lsp" ? runeCliParseLsp(args, backend, backendExplicit)
                        : runeCliInvocation(command, backend, "", "", "", "", false, false, backendExplicit, emptyRuntimeArray(), [stringValue("unknown command " + command)], false, "")
                    )
                )
            )
        )
    )
)

runeCliParseRun(
  args: Array[RuntimeValue],
  backend: String,
  backendExplicit: Bool
) -> RuntimeValue => {
  result := cliParseArgsValue(runeCliRunCommand(), runeCliNormalizeRunArgs(args))
  runeCliInvocationFromResult("run", backend, backendExplicit, result, runtimeArray(cliField(result, "rest")), false, false)
}

runeCliNormalizeRunArgs(
  args: Array[RuntimeValue]
) -> Array[RuntimeValue] => runeCliNormalizeRunArgsAt(args, 0, emptyRuntimeArray(), false, false)

runeCliNormalizeRunArgsAt(
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue],
  seenPath: Bool,
  skipValue: Bool
) -> Array[RuntimeValue] => (
  index >= args.length() ? out
    : runeCliNormalizeRunArgAt(args, index, out, seenPath, skipValue)
)

runeCliNormalizeRunArgAt(
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue],
  seenPath: Bool,
  skipValue: Bool
) -> Array[RuntimeValue] => {
  arg := runtimeText(args[index])
  (
    seenPath && (arg != "--") ? runeCliAppendRunRest(args, index, pushRuntime(out, stringValue("--")))
      : (
        arg == "--" ? runeCliAppendRunRest(args, index, out)
          : runeCliNormalizeRunArgBeforeRest(args, index, pushRuntime(out, args[index]), seenPath, skipValue)
      )
  )
}

runeCliNormalizeRunArgBeforeRest(
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue],
  seenPath: Bool,
  skipValue: Bool
) -> Array[RuntimeValue] => (
  skipValue ? runeCliNormalizeRunArgsAt(args, index + 1, out, seenPath, false)
    : (
      runtimeText(args[index]) == "--target" ? runeCliNormalizeRunArgsAt(args, index + 1, out, seenPath, true)
        : runeCliNormalizeRunArgsAt(args, index + 1, out, seenPath || !runtimeText(args[index]).startsWith("-"), false)
    )
)

runeCliAppendRunRest(
  args: Array[RuntimeValue],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= args.length() ? out
    : runeCliAppendRunRest(args, index + 1, pushRuntime(out, args[index]))
)

runeCliParseBuild(
  args: Array[RuntimeValue],
  backend: String,
  backendExplicit: Bool
) -> RuntimeValue => {
  result := cliParseArgsValue(runeCliBuildCommand(), args)
  runeCliInvocationFromResult("build", backend, backendExplicit, result, emptyRuntimeArray(), false, false)
}

runeCliParseFmt(
  args: Array[RuntimeValue],
  backend: String,
  backendExplicit: Bool
) -> RuntimeValue => {
  result := cliParseArgsValue(runeCliFmtCommand(), args)
  runeCliInvocationFromResult("fmt", backend, backendExplicit, result, emptyRuntimeArray(), callMapGetOrBool(cliField(result, "flags"), "check", false), callMapGetOrBool(cliField(result, "flags"), "stdout", false))
}

runeCliParseTest(
  args: Array[RuntimeValue],
  backend: String,
  backendExplicit: Bool
) -> RuntimeValue => {
  result := cliParseArgsValue(runeCliTestCommand(), args)
  runeCliInvocationFromResult("test", backend, backendExplicit, result, emptyRuntimeArray(), false, false)
}

runeCliParseLsp(
  args: Array[RuntimeValue],
  backend: String,
  backendExplicit: Bool
) -> RuntimeValue => {
  result := cliParseArgsValue(runeCliLspCommand(), args)
  runeCliInvocationFromResult("lsp", backend, backendExplicit, result, emptyRuntimeArray(), false, false)
}

runeCliInvocationFromResult(
  name: String,
  backend: String,
  backendExplicit: Bool,
  result: RuntimeValue,
  runArgs: Array[RuntimeValue],
  checkOnly: Bool,
  stdout: Bool
) -> RuntimeValue => {
  errors := runeCliErrors(result)
  target := callMapGetOrString(cliField(result, "values"), "target", "")
  target = runeCliDefaultTarget(name, backend, target)
  errors = runeCliInvocationErrors(name, backend, target, errors)
  runeCliInvocation(
    name,
    backend,
    runeCliDefaultPath(name, callMapGetOrString(cliField(result, "positionals"), "path", "")),
    callMapGetOrString(cliField(result, "values"), "output", ""),
    target,
    callMapGetOrString(cliField(result, "positionals"), "pattern", ""),
    checkOnly,
    stdout,
    backendExplicit,
    runArgs,
    errors,
    runtimeBool(cliField(result, "help")),
    runeCliInvocationHelpText(name)
  )
}

runeCliInvocationErrors(
  name: String,
  backend: String,
  target: String,
  errors: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  (name == "build") && (cliContainsString([stringValue("go"), stringValue("mbt")], backend) == false) ? pushRuntime(errors, stringValue("rune build only supports --backend go or --backend mbt"))
    : (
      ((name == "run") && (target.isEmpty() == false)) && (backend != "mbt") ? pushRuntime(errors, stringValue("rune run --target is only supported with --backend mbt"))
        : errors
    )
)

runeCliDefaultTarget(
  name: String,
  backend: String,
  target: String
) -> String => (
  ((name == "run") && (backend == "mbt")) && target.isEmpty() ? "native"
    : target
)

runeCliDefaultPath(
  name: String,
  path: String
) -> String => (
  (name == "test") && path.isEmpty() ? "tests"
    : path
)

runeCliInvocationHelpText(
  name: String
) -> String => name {
  "run" => cliHelpText(runeCliRunCommand())
  "build" => cliHelpText(runeCliBuildCommand())
  "fmt" => cliHelpText(runeCliFmtCommand())
  "test" => cliHelpText(runeCliTestCommand())
  "lsp" => cliHelpText(runeCliLspCommand())
  _ => cliHelpText(runeCliRootCommand())
}

runeCliInvocation(
  command: String,
  backend: String,
  path: String,
  output: String,
  target: String,
  pattern: String,
  checkOnly: Bool,
  stdout: Bool,
  backendExplicit: Bool,
  runArgs: Array[RuntimeValue],
  errors: Array[RuntimeValue],
  help: Bool,
  helpText: String
) -> RuntimeValue => structValue("RuneCliInvocation", [
  RuntimeField { name: "ok", value: boolValue(errors.length() == 0) },
  RuntimeField { name: "command", value: stringValue(command) },
  RuntimeField { name: "backend", value: stringValue(backend) },
  RuntimeField { name: "path", value: stringValue(path) },
  RuntimeField { name: "output", value: stringValue(output) },
  RuntimeField { name: "target", value: stringValue(target) },
  RuntimeField { name: "pattern", value: stringValue(pattern) },
  RuntimeField { name: "checkOnly", value: boolValue(checkOnly) },
  RuntimeField { name: "stdout", value: boolValue(stdout) },
  RuntimeField { name: "backendExplicit", value: boolValue(backendExplicit) },
  RuntimeField { name: "runArgs", value: arrayValue(runArgs) },
  RuntimeField { name: "errors", value: arrayValue(errors) },
  RuntimeField { name: "help", value: boolValue(help) },
  RuntimeField { name: "helpText", value: stringValue(helpText) }
])

runeCliErrors(
  result: RuntimeValue
) -> Array[RuntimeValue] => {
  errorValue := cliField(result, "error")
  (
    runtimeKind(errorValue) == RuntimeValueKind.String ? [errorValue]
      : emptyRuntimeArray()
  )
}

runeCliRootCommand() -> RuntimeValue => cliWithOption(
  cliCommandValue("rune", "Rune language toolchain"),
  cliOptionValue("backend", "b", "BACKEND", "target backend", false, stringValue("go"))
)

runeCliRunCommand() -> RuntimeValue => cliWithArgument(
  cliWithOption(cliCommandValue("run", "Compile and run a Rune program"), cliOptionValue("target", "", "TARGET", "MoonBit run target", false, nullValue())),
  cliArgumentValue("path", "Rune source path", true)
)

runeCliBuildCommand() -> RuntimeValue => cliWithArgument(
  cliWithOption(cliWithOption(cliCommandValue("build", "Compile a Rune program to an executable"), cliOptionValue("output", "o", "FILE", "output executable path", false, stringValue(""))), cliOptionValue("target", "", "TARGET", "build target", false, stringValue(""))),
  cliArgumentValue("path", "Rune source path", true)
)

runeCliFmtCommand() -> RuntimeValue => cliWithArgument(
  cliWithOption(cliWithOption(cliCommandValue("fmt", "Format Rune source"), cliFlagValue("check", "", "fail if not formatted")), cliFlagValue("stdout", "", "write formatted source to stdout")),
  cliArgumentValue("path", "Rune source path", true)
)

runeCliTestCommand() -> RuntimeValue => cliWithArgument(
  cliWithArgument(cliCommandValue("test", "Run Rune tests"), cliArgumentValue("path", "Rune test path", false)),
  cliArgumentValue("pattern", "test name pattern", false)
)

runeCliLspCommand() -> RuntimeValue => cliWithOption(
  cliCommandValue("lsp", "Start the Rune language server"),
  cliFlagValue("stdio", "", "serve LSP over stdin/stdout")
)

callMapGetOrString(
  map: RuntimeValue,
  key: String,
  fallback: String
) -> String => {
  idx := mapEntryIndex(runtimeEntries(map), stringValue(key), 0)
  (
    idx >= 0 ? runtimeText(runtimeEntries(map)[idx].value)
      : fallback
  )
}

callMapGetOrBool(
  map: RuntimeValue,
  key: String,
  fallback: Bool
) -> Bool => {
  idx := mapEntryIndex(runtimeEntries(map), stringValue(key), 0)
  (
    idx >= 0 ? runtimeBool(runtimeEntries(map)[idx].value)
      : fallback
  )
}

callImportedModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  module: String,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  native := callNativeImportedModuleFunction(interpreter, env, module, name, children)
  fn := (
    native.handled ? emptyIRFunction()
      : findFunction(interpreter, name)
  )
  (
    native.handled ? native.result
      : (
        fn.name == "" ? errorResult((("unknown module function @" + module) + ".") + name)
          : callFunctionWithArgs(interpreter, fn, evalArgsChecked(interpreter, env, children, 1))
      )
  )
}

callNativeImportedModuleFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  module: String,
  name: String,
  children: Array[IRExpr]
) -> NativeCallResult => (
  module == "cli" ? callSelfhostCliFunction(interpreter, env, name, children)
    : unhandledNative()
)

callSelfhostCliFunction(
  interpreter: Interpreter,
  env: RuntimeEnv,
  name: String,
  children: Array[IRExpr]
) -> NativeCallResult => {
  (
    name == "runeCommand" ? handledNative(okResult(runeCliRootCommand()))
      : (
        name == "runCommand" ? handledNative(okResult(runeCliRunCommand()))
          : unhandledNative()
      )
  )
}

callPrintln(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr]
) -> EvalResult => {
  values := evalArgs(interpreter, env, children, 1)
  appendOutput(interpreter, joinRuntimeValues(values, 0, ""))
  okResult(voidValue())
}

callAssertEq(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr]
) -> EvalResult => {
  values := evalArgs(interpreter, env, children, 1)
  (
    values.length() < 2 ? errorResult("@assert.eq expects two arguments")
      : (
        runtimeEqual(values[0], values[1]) ? okResult(voidValue())
          : errorResult((("assert.eq failed: " + formatRuntimeValue(values[0])) + " != ") + formatRuntimeValue(values[1]))
      )
  )
}

jsonParse(text: String) -> EvalResult => {
  parsed := parseJsonValue(text, skipJsonSpace(text, 0))
  (
    !parsed.ok ? errorResult(parsed.error)
      : okResult(parsed.value)
  )
}

jsonStringify(value: RuntimeValue) -> String => value {
  Void => ""
  Null => "null"
  Bool(raw) => (
    raw ? "true"
      : "false"
  )
  Int(raw, typeName) => intToString(raw)
  Double(raw, text, typeName) => text
  String(raw, typeName) => jsonQuote(raw)
  Char(raw) => jsonQuote(raw.toString())
  Array(values) => "[" + jsonStringifyValues(values, 0, "") + "]"
  Tuple(values) => "[" + jsonStringifyValues(values, 0, "") + "]"
  Map(entries) => "{" + jsonStringifyEntries(entries, 0, "") + "}"
  Set(entries) => "[" + jsonStringifySetEntries(entries, 0, "") + "]"
  Struct(typeName, fields) => "{" + jsonStringifyFields(typeName, fields, 0, "") + "}"
  Enum(typeName, name, value, payload) => jsonQuote(name)
  Module(name) => "null"
  Closure(index) => "null"
}

jsonStringifyValues(
  values: Array[RuntimeValue],
  index: Int,
  out: String
) -> String => (
  index >= values.length() ? out
    : jsonStringifyValues(values, index + 1, jsonAppendValue(out, jsonStringify(values[index])))
)

jsonStringifyEntries(
  entries: Array[RuntimeEntry],
  index: Int,
  out: String
) -> String => (
  index >= entries.length() ? out
    : (
      entryIsDeleted(entries[index]) ? jsonStringifyEntries(entries, index + 1, out)
        : jsonStringifyEntries(entries, index + 1, jsonAppendValue(out, (jsonStringify(entries[index].key) + ":") + jsonStringify(entries[index].value)))
    )
)

jsonStringifySetEntries(
  entries: Array[RuntimeEntry],
  index: Int,
  out: String
) -> String => (
  index >= entries.length() ? out
    : (
      entryIsDeleted(entries[index]) ? jsonStringifySetEntries(entries, index + 1, out)
        : jsonStringifySetEntries(entries, index + 1, jsonAppendValue(out, jsonStringify(entries[index].value)))
    )
)

jsonStringifyFields(
  typeName: String,
  fields: Array[RuntimeField],
  index: Int,
  out: String
) -> String => (
  index >= fields.length() ? out
    : jsonStringifyField(typeName, fields, index, out)
)

jsonStringifyField(
  typeName: String,
  fields: Array[RuntimeField],
  index: Int,
  out: String
) -> String => {
  field := fields[index]
  (
    jsonFieldIgnored(typeName, field.name) || (runtimeKind(field.value) == RuntimeValueKind.Closure) ? jsonStringifyFields(typeName, fields, index + 1, out)
      : jsonStringifyFields(typeName, fields, index + 1, jsonAppendValue(out, (jsonQuote(jsonFieldName(typeName, field.name)) + ":") + jsonStringify(field.value)))
  )
}

jsonAppendValue(
  out: String,
  value: String
) -> String => (
  out == "" ? value
    : (out + ",") + value
)

jsonQuote(text: String) -> String => "\"" + jsonEscapeText(text, 0, "") + "\""

jsonEscapeText(
  text: String,
  index: Int,
  out: String
) -> String => (
  index >= text.length() ? out
    : jsonEscapeText(text, index + 1, out + jsonEscapeChar(text.at(index)))
)

jsonEscapeChar(ch: Char) -> String => ch {
  '"' => "\\\""
  '\\' => "\\\\"
  '\n' => "\\n"
  '\r' => "\\r"
  '\t' => "\\t"
  _ => ch.toString()
}

jsonDecodeValue(
  interpreter: Interpreter,
  value: RuntimeValue,
  typeName: String
) -> RuntimeValue => (
  typeName.startsWith("Array[") ? jsonDecodeArray(interpreter, value, typeName.slice(6, typeName.length() - 1))
    : (
      findStruct(interpreter, typeName).name != "" ? jsonDecodeStruct(interpreter, value, findStruct(interpreter, typeName))
        : jsonDecodeScalar(value, typeName)
    )
)

jsonDecodeArray(
  interpreter: Interpreter,
  value: RuntimeValue,
  elementType: String
) -> RuntimeValue => (
  runtimeKind(value) == RuntimeValueKind.Array ? arrayValue(jsonDecodeArrayValues(interpreter, runtimeArray(value), elementType, 0, []))
    : arrayValue([])
)

jsonDecodeArrayValues(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  elementType: String,
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= values.length() ? out
    : jsonDecodeArrayValues(interpreter, values, elementType, index + 1, pushRuntime(out, jsonDecodeValue(interpreter, values[index], elementType)))
)

jsonDecodeStruct(
  interpreter: Interpreter,
  value: RuntimeValue,
  structType: IRStructType
) -> RuntimeValue => (
  runtimeKind(value) == RuntimeValueKind.Map ? structValue(structType.name, jsonDecodeFields(interpreter, value, structType, 0, []))
    : structValue(structType.name, jsonDefaultFields(interpreter, structType, 0, []))
)

jsonDecodeFields(
  interpreter: Interpreter,
  value: RuntimeValue,
  structType: IRStructType,
  index: Int,
  out: Array[RuntimeField]
) -> Array[RuntimeField] => (
  index >= structType.fields.length() ? out
    : jsonDecodeFields(interpreter, value, structType, index + 1, pushRuntimeField(out, jsonDecodeField(interpreter, value, structType.name, structType.fields[index])))
)

jsonDecodeField(
  interpreter: Interpreter,
  value: RuntimeValue,
  typeName: String,
  field: IRField
) -> RuntimeField => {
  key := stringValue(jsonFieldName(typeName, field.name))
  idx := mapEntryIndex(runtimeEntries(value), key, 0)
  raw := (
    jsonFieldIgnored(typeName, field.name) || (idx < 0) ? jsonDefaultValue(interpreter, field.typeName)
      : runtimeEntries(value)[idx].value
  )
  RuntimeField {
    name: field.name,
    value: jsonDecodeValue(interpreter, raw, field.typeName)
  }
}

jsonDefaultFields(
  interpreter: Interpreter,
  structType: IRStructType,
  index: Int,
  out: Array[RuntimeField]
) -> Array[RuntimeField] => (
  index >= structType.fields.length() ? out
    : jsonDefaultFields(interpreter, structType, index + 1, pushRuntimeField(out, RuntimeField {
      name: structType.fields[index].name,
      value: jsonDefaultValue(interpreter, structType.fields[index].typeName)
    }))
)

jsonDecodeScalar(
  value: RuntimeValue,
  typeName: String
) -> RuntimeValue => typeName {
  "" => value
  "String" => stringValue(runtimeText(value))
  "Char" => charValue(runtimeText(value).at(0))
  "Bool" => boolValue(runtimeBool(value))
  "Double" => doubleRuntimeValue(runtimeDouble(value))
  "Int" | "Int64" | "UInt" | "UInt64" | "UInt32" | "UInt16" | "UInt8" | "Int32" | "Int16" | "Int8" | "Int4" => typedIntValue(runtimeInt(value), typeName)
  _ => value
}

jsonDefaultValue(
  interpreter: Interpreter,
  typeName: String
) -> RuntimeValue => (
  typeName.startsWith("Array[") ? arrayValue([])
    : (
      findStruct(interpreter, typeName).name != "" ? structValue(typeName, jsonDefaultFields(interpreter, findStruct(interpreter, typeName), 0, []))
        : jsonDefaultScalar(typeName)
    )
)

jsonDefaultScalar(typeName: String) -> RuntimeValue => typeName {
  "String" => stringValue("")
  "Char" => charValue('\x00')
  "Bool" => boolValue(false)
  "Double" => doubleRuntimeValue(0.0)
  "Int" | "Int64" | "UInt" | "UInt64" | "UInt32" | "UInt16" | "UInt8" | "Int32" | "Int16" | "Int8" | "Int4" => typedIntValue(0, typeName)
  _ => nullValue()
}

jsonFieldName(
  typeName: String,
  fieldName: String
) -> String => (
  ((typeName == "JsonAccount") || (typeName == "JsonDocument")) && (fieldName == "name") ? "display_name"
    : fieldName
)

jsonFieldIgnored(
  typeName: String,
  fieldName: String
) -> Bool => (
  ((typeName == "JsonAccount") && (fieldName == "password")) || ((typeName == "JsonDocument") && (fieldName == "token"))
)

regexValue(
  source: String,
  flags: String,
  lastIndex: Int
) -> RuntimeValue => structValue("Regex", [
  RuntimeField { name: "source", value: stringValue(source) },
  RuntimeField { name: "flags", value: stringValue(flags) },
  RuntimeField { name: "lastIndex", value: intValue(lastIndex) }
])

regexLiteralValue(raw: String) -> RuntimeValue => {
  slash := lastRegexSlash(raw, raw.length() - 1)
  source := (
    slash <= 0 ? raw
      : raw.slice(1, slash)
  )
  flags := (
    slash <= 0 ? ""
      : raw.slice(slash + 1, raw.length())
  )
  regexValue(source, canonicalRegexFlags(flags), 0)
}

lastRegexSlash(
  raw: String,
  index: Int
) -> Int => (
  index <= 0 ? -1
    : (
      raw.at(index) == '/' ? index
        : lastRegexSlash(raw, index - 1)
    )
)

isRegexValue(value: RuntimeValue) -> Bool => runtimeKind(value) == RuntimeValueKind.Struct && runtimeTypeName(value) == "Regex"

regexSource(value: RuntimeValue) -> String => runtimeText(runtimeStructField(value, "source"))

regexFlags(value: RuntimeValue) -> String => runtimeText(runtimeStructField(value, "flags"))

regexLastIndex(value: RuntimeValue) -> Int => runtimeInt(runtimeStructField(value, "lastIndex"))

regexSetLastIndexValue(
  value: RuntimeValue,
  index: Int
) -> RuntimeValue => setRuntimeField(value, "lastIndex", intValue(index))

callRegexMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  source := regexSource(receiver)
  flags := regexFlags(receiver)
  name {
    "exec" => regexExecMethod(receiver, runtimeText(args[0]))
    "match" => okResult(arrayValue(regexMatchAllValues(source, flags, runtimeText(args[0]), 0, false, [])))
    "matchAll" => okResult(arrayValue(regexMatchAllValues(source, flags, runtimeText(args[0]), 0, true, [])))
    "test" => okResult(boolValue(regexFind(source, flags, runtimeText(args[0]), regexStartIndex(receiver)).found))
    "replace" => okResult(stringValue(regexReplace(source, flags, runtimeText(args[0]), runtimeText(args[1]), false)))
    "replaceAll" => okResult(stringValue(regexReplace(source, flags, runtimeText(args[0]), runtimeText(args[1]), true)))
    "search" => okResult(intValue(regexFind(source, flags, runtimeText(args[0]), 0).start))
    "split" => okResult(arrayValue(stringsToRuntime(regexSplit(source, runtimeText(args[0]), 0, []), 0, [])))
    "source" => okResult(stringValue(source))
    "flags" => okResult(stringValue(flags))
    "global" => okResult(boolValue(regexHasFlag(flags, 'g')))
    "ignoreCase" => okResult(boolValue(regexHasFlag(flags, 'i')))
    "multiline" => okResult(boolValue(regexHasFlag(flags, 'm')))
    "dotAll" => okResult(boolValue(regexHasFlag(flags, 's')))
    "unicode" => okResult(boolValue(regexHasFlag(flags, 'u')))
    "unicodeSets" => okResult(boolValue(regexHasFlag(flags, 'v')))
    "sticky" => okResult(boolValue(regexHasFlag(flags, 'y')))
    "hasIndices" => okResult(boolValue(regexHasFlag(flags, 'd')))
    "lastIndex" => okResult(intValue(regexLastIndex(receiver)))
    "setLastIndex" => okResult(runtimeStructField(regexSetLastIndexValue(receiver, runtimeInt(args[0])), "lastIndex"))
    _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
  }
}

regexStartIndex(receiver: RuntimeValue) -> Int => (
  regexHasFlag(regexFlags(receiver), 'g') || regexHasFlag(regexFlags(receiver), 'y') ? regexLastIndex(receiver)
    : 0
)

regexExecMethod(
  receiver: RuntimeValue,
  input: String
) -> EvalResult => {
  source := regexSource(receiver)
  flags := regexFlags(receiver)
  start := regexStartIndex(receiver)
  found := regexFind(source, flags, input, start)
  (
    !found.found ? regexExecMiss(receiver, flags)
      : regexExecHit(receiver, flags, found)
  )
}

regexExecMiss(
  receiver: RuntimeValue,
  flags: String
) -> EvalResult => {
  (
    regexHasFlag(flags, 'g') || regexHasFlag(flags, 'y') ? regexSetLastIndexValue(receiver, 0)
      : receiver
  )
  okResult(arrayValue([]))
}

regexExecHit(
  receiver: RuntimeValue,
  flags: String,
  found: RegexMatch
) -> EvalResult => {
  (
    regexHasFlag(flags, 'g') || regexHasFlag(flags, 'y') ? regexSetLastIndexValue(receiver, found.end)
      : receiver
  )
  okResult(arrayValue(stringsToRuntime(found.groups, 0, [])))
}

RegexMatch: {
  found: Bool
  start: Int
  end: Int
  groups: Array[String]
}

regexNoMatch() -> RegexMatch => {
  found: false,
  start: -1,
  end: -1,
  groups: []
}

regexFound(
  start: Int,
  end: Int,
  groups: Array[String]
) -> RegexMatch => {
  found: true,
  start: start,
  end: end,
  groups: groups
}

regexFind(
  source: String,
  flags: String,
  input: String,
  start: Int
) -> RegexMatch => (
  start < 0 || start > input.length() ? regexNoMatch()
    : regexFindAt(source, flags, input, start)
)

regexFindAt(
  source: String,
  flags: String,
  input: String,
  index: Int
) -> RegexMatch => (
  index > input.length() ? regexNoMatch()
    : regexFindCandidate(source, flags, input, index)
)

regexFindCandidate(
  source: String,
  flags: String,
  input: String,
  index: Int
) -> RegexMatch => {
  found := regexMatchAt(source, flags, input, index)
  (
    found.found ? found
      : regexFindAt(source, flags, input, index + 1)
  )
}

regexMatchAt(
  source: String,
  flags: String,
  input: String,
  index: Int
) -> RegexMatch => source {
  "rune\\s+\\d+" => regexMatchRuneDigits(flags, input, index)
  "(\\w+)-(\\d+)" => regexMatchWordDashDigits(input, index)
  "([a-z]+)(\\d+)" => regexMatchLettersDigits(input, index)
  "(\\d+)" => regexMatchDigitsGroup(input, index)
  "\\d+" => regexMatchDigits(input, index)
  "[A-Z]+" => regexMatchUpper(input, index)
  ",\\s*" => regexMatchCommaSpaces(input, index)
  _ => regexNoMatch()
}

regexMatchRuneDigits(
  flags: String,
  input: String,
  index: Int
) -> RegexMatch => (
  regexRegionEquals(input, index, "rune", regexHasFlag(flags, 'i')) && regexSpaceAt(input, index + 4) ? regexMatchRuneDigitsTail(input, index)
    : regexNoMatch()
)

regexMatchRuneDigitsTail(
  input: String,
  index: Int
) -> RegexMatch => {
  afterSpaces := consumeSpaces(input, index + 4)
  afterDigits := consumeDigits(input, afterSpaces)
  (
    afterDigits > afterSpaces ? regexFound(index, afterDigits, [input.slice(index, afterDigits)])
      : regexNoMatch()
  )
}

regexMatchWordDashDigits(
  input: String,
  index: Int
) -> RegexMatch => {
  wordEnd := consumeWord(input, index)
  digitStart := wordEnd + 1
  digitEnd := consumeDigits(input, digitStart)
  (
    (wordEnd > index) && (wordEnd < input.length()) && (input.at(wordEnd) == '-') && (digitEnd > digitStart) ? regexFound(index, digitEnd, [
      input.slice(index, digitEnd),
      input.slice(index, wordEnd),
      input.slice(digitStart, digitEnd)
    ])
      : regexNoMatch()
  )
}

regexMatchLettersDigits(
  input: String,
  index: Int
) -> RegexMatch => {
  lettersEnd := consumeLowerLetters(input, index)
  digitsEnd := consumeDigits(input, lettersEnd)
  (
    (lettersEnd > index) && (digitsEnd > lettersEnd) ? regexFound(index, digitsEnd, [
      input.slice(index, digitsEnd),
      input.slice(index, lettersEnd),
      input.slice(lettersEnd, digitsEnd)
    ])
      : regexNoMatch()
  )
}

regexMatchDigitsGroup(
  input: String,
  index: Int
) -> RegexMatch => {
  end := consumeDigits(input, index)
  (
    end > index ? regexFound(index, end, [input.slice(index, end), input.slice(index, end)])
      : regexNoMatch()
  )
}

regexMatchDigits(
  input: String,
  index: Int
) -> RegexMatch => {
  end := consumeDigits(input, index)
  (
    end > index ? regexFound(index, end, [input.slice(index, end)])
      : regexNoMatch()
  )
}

regexMatchUpper(
  input: String,
  index: Int
) -> RegexMatch => {
  end := consumeUpperLetters(input, index)
  (
    end > index ? regexFound(index, end, [input.slice(index, end)])
      : regexNoMatch()
  )
}

regexMatchCommaSpaces(
  input: String,
  index: Int
) -> RegexMatch => (
  (index < input.length()) && (input.at(index) == ',') ? regexFound(index, consumeSpaces(input, index + 1), [input.slice(index, consumeSpaces(input, index + 1))])
    : regexNoMatch()
)

regexMatchAllValues(
  source: String,
  flags: String,
  input: String,
  index: Int,
  groups: Bool,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  found := regexFind(source, flags, input, index)
  (
    !found.found ? out
      : regexMatchAllValues(source, flags, input, regexNextSearchIndex(found), groups, pushRuntime(out, (
        groups ? arrayValue(stringsToRuntime(found.groups, 0, []))
          : stringValue(found.groups[0])
      )))
  )
}

regexNextSearchIndex(found: RegexMatch) -> Int => (
  found.end > found.start ? found.end
    : found.end + 1
)

regexReplace(
  source: String,
  flags: String,
  input: String,
  replacement: String,
  all: Bool
) -> String => regexReplaceLoop(source, flags, input, replacement, 0, "", all || regexHasFlag(flags, 'g'))

regexReplaceLoop(
  source: String,
  flags: String,
  input: String,
  replacement: String,
  index: Int,
  out: String,
  all: Bool
) -> String => {
  found := regexFind(source, flags, input, index)
  (
    !found.found ? out + input.slice(index, input.length())
      : (
        all ? regexReplaceLoop(source, flags, input, replacement, found.end, (out + input.slice(index, found.start)) + regexExpandReplacement(replacement, found), true)
          : ((out + input.slice(index, found.start)) + regexExpandReplacement(replacement, found)) + input.slice(found.end, input.length())
      )
  )
}

regexExpandReplacement(
  replacement: String,
  found: RegexMatch
) -> String => regexExpandReplacementAt(replacement, found, 0, "")

regexExpandReplacementAt(
  replacement: String,
  found: RegexMatch,
  index: Int,
  out: String
) -> String => (
  index >= replacement.length() ? out
    : (
      (replacement.at(index) == '$') && ((index + 1) < replacement.length()) && isDigitChar(replacement.at(index + 1)) ? regexExpandReplacementAt(replacement, found, index + 2, out + regexGroup(found, digitValue(replacement.at(index + 1))))
        : regexExpandReplacementAt(replacement, found, index + 1, out + replacement.at(index).toString())
    )
)

regexGroup(
  found: RegexMatch,
  index: Int
) -> String => (
  index >= found.groups.length() ? ""
    : found.groups[index]
)

regexSplit(
  source: String,
  input: String,
  index: Int,
  out: Array[String]
) -> Array[String] => {
  found := regexFind(source, "", input, index)
  (
    !found.found ? pushString(out, input.slice(index, input.length()))
      : regexSplit(source, input, found.end, pushString(out, input.slice(index, found.start)))
  )
}

stringsToRuntime(
  values: Array[String],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= values.length() ? out
    : stringsToRuntime(values, index + 1, pushRuntime(out, stringValue(values[index])))
)

canonicalRegexFlags(flags: String) -> String => canonicalRegexFlagsInOrder(flags, "dgimsuvy", 0, "")

canonicalRegexFlagsInOrder(
  flags: String,
  order: String,
  index: Int,
  out: String
) -> String => (
  index >= order.length() ? out
    : canonicalRegexFlagsInOrder(flags, order, index + 1, (
      regexHasFlag(flags, order.at(index)) ? out + order.at(index).toString()
        : out
    ))
)

regexHasFlag(
  flags: String,
  flag: Char
) -> Bool => flags.includes(flag.toString())

regexEscape(
  text: String,
  index: Int,
  out: String
) -> String => (
  index >= text.length() ? out
    : regexEscape(text, index + 1, out + regexEscapeChar(text.at(index)))
)

regexEscapeChar(ch: Char) -> String => (
  regexEscapeNeedsSlash(ch) ? "\\" + ch.toString()
    : ch.toString()
)

regexEscapeNeedsSlash(ch: Char) -> Bool => (((((((((((((ch == '\\') || (ch == '.')) || (ch == '+')) || (ch == '*')) || (ch == '?')) || (ch == '^')) || (ch == '$')) || (ch == '(')) || (ch == ')')) || (ch == '[')) || (ch == ']')) || (ch == '{')) || (ch == '}')) || (ch == '|')

regexRegionEquals(
  input: String,
  index: Int,
  needle: String,
  ignoreCase: Bool
) -> Bool => (
  (index + needle.length()) > input.length() ? false
    : regexRegionEqualsAt(input, index, needle, ignoreCase, 0)
)

regexRegionEqualsAt(
  input: String,
  index: Int,
  needle: String,
  ignoreCase: Bool,
  offset: Int
) -> Bool => (
  offset >= needle.length() ? true
    : (
      charsEqual(input.at(index + offset), needle.at(offset), ignoreCase) ? regexRegionEqualsAt(input, index, needle, ignoreCase, offset + 1)
        : false
    )
)

charsEqual(
  left: Char,
  right: Char,
  ignoreCase: Bool
) -> Bool => (
  left == right ? true
    : ignoreCase && (lowerAsciiChar(left) == lowerAsciiChar(right))
)

lowerAsciiChar(ch: Char) -> Char => ch {
  'A' => 'a'
  'B' => 'b'
  'C' => 'c'
  'D' => 'd'
  'E' => 'e'
  'F' => 'f'
  'G' => 'g'
  'H' => 'h'
  'I' => 'i'
  'J' => 'j'
  'K' => 'k'
  'L' => 'l'
  'M' => 'm'
  'N' => 'n'
  'O' => 'o'
  'P' => 'p'
  'Q' => 'q'
  'R' => 'r'
  'S' => 's'
  'T' => 't'
  'U' => 'u'
  'V' => 'v'
  'W' => 'w'
  'X' => 'x'
  'Y' => 'y'
  'Z' => 'z'
  _ => ch
}

consumeDigits(input: String, index: Int) -> Int => (
  (index < input.length()) && isDigitChar(input.at(index)) ? consumeDigits(input, index + 1)
    : index
)

consumeSpaces(input: String, index: Int) -> Int => (
  (index < input.length()) && regexSpaceAt(input, index) ? consumeSpaces(input, index + 1)
    : index
)

regexSpaceAt(input: String, index: Int) -> Bool => (
  index < input.length() ? ((input.at(index) == ' ') || (input.at(index) == '\t'))
    : false
)

consumeWord(input: String, index: Int) -> Int => (
  (index < input.length()) && isWordChar(input.at(index)) ? consumeWord(input, index + 1)
    : index
)

consumeLowerLetters(input: String, index: Int) -> Int => (
  (index < input.length()) && isLowerLetter(input.at(index)) ? consumeLowerLetters(input, index + 1)
    : index
)

consumeUpperLetters(input: String, index: Int) -> Int => (
  (index < input.length()) && isUpperLetter(input.at(index)) ? consumeUpperLetters(input, index + 1)
    : index
)

isWordChar(ch: Char) -> Bool => isLowerLetter(ch) || isUpperLetter(ch) || isDigitChar(ch) || (ch == '_')

isLowerLetter(ch: Char) -> Bool => (ch >= 'a') && (ch <= 'z')

isUpperLetter(ch: Char) -> Bool => (ch >= 'A') && (ch <= 'Z')

jsonOk(
  value: RuntimeValue,
  index: Int
) -> JsonParseResult => {
  ok: true,
  value: value,
  index: index,
  error: ""
}

jsonError(message: String) -> JsonParseResult => {
  ok: false,
  value: voidValue(),
  index: 0,
  error: message
}

parseJsonValue(
  text: String,
  index: Int
) -> JsonParseResult => (
  index >= text.length() ? jsonError("unexpected end of json")
    : parseJsonValueAt(text, skipJsonSpace(text, index))
)

parseJsonValueAt(
  text: String,
  index: Int
) -> JsonParseResult => {
  ch := text.at(index)
  (
    ch == '"' ? parseJsonString(text, index)
      : (
        ch == '{' ? parseJsonObject(text, index + 1, [])
          : (
            ch == '[' ? parseJsonArray(text, index + 1, [])
              : (
                startsWithAt(text, index, "true") ? jsonOk(boolValue(true), index + 4)
                  : (
                    startsWithAt(text, index, "false") ? jsonOk(boolValue(false), index + 5)
                      : (
                        startsWithAt(text, index, "null") ? jsonOk(nullValue(), index + 4)
                          : parseJsonNumber(text, index)
                      )
                  )
              )
          )
      )
  )
}

parseJsonObject(
  text: String,
  index: Int,
  entries: Array[RuntimeEntry]
) -> JsonParseResult => {
  pos := skipJsonSpace(text, index)
  (
    pos < text.length() && text.at(pos) == '}' ? jsonOk(mapValue(entries), pos + 1)
      : parseJsonObjectEntry(text, pos, entries)
  )
}

parseJsonObjectEntry(
  text: String,
  index: Int,
  entries: Array[RuntimeEntry]
) -> JsonParseResult => {
  key := parseJsonString(text, index)
  (
    !key.ok ? key
      : parseJsonObjectValue(text, skipJsonSpace(text, key.index), entries, runtimeText(key.value))
  )
}

parseJsonObjectValue(
  text: String,
  index: Int,
  entries: Array[RuntimeEntry],
  key: String
) -> JsonParseResult => (
  (index >= text.length()) || (text.at(index) != ':') ? jsonError("expected ':' in json object")
    : parseJsonObjectAfterColon(text, index + 1, entries, key)
)

parseJsonObjectAfterColon(
  text: String,
  index: Int,
  entries: Array[RuntimeEntry],
  key: String
) -> JsonParseResult => {
  value := parseJsonValue(text, index)
  (
    !value.ok ? value
      : parseJsonObjectNext(text, skipJsonSpace(text, value.index), pushEntry(entries, RuntimeEntry { key: stringValue(key), value: value.value }))
  )
}

parseJsonObjectNext(
  text: String,
  index: Int,
  entries: Array[RuntimeEntry]
) -> JsonParseResult => (
  (index < text.length()) && (text.at(index) == ',') ? parseJsonObject(text, index + 1, entries)
    : (
      (index < text.length()) && (text.at(index) == '}') ? jsonOk(mapValue(entries), index + 1)
        : jsonError("expected ',' or '}' in json object")
    )
)

parseJsonArray(
  text: String,
  index: Int,
  values: Array[RuntimeValue]
) -> JsonParseResult => {
  pos := skipJsonSpace(text, index)
  (
    pos < text.length() && text.at(pos) == ']' ? jsonOk(arrayValue(values), pos + 1)
      : parseJsonArrayValue(text, pos, values)
  )
}

parseJsonArrayValue(
  text: String,
  index: Int,
  values: Array[RuntimeValue]
) -> JsonParseResult => {
  value := parseJsonValue(text, index)
  (
    !value.ok ? value
      : parseJsonArrayNext(text, skipJsonSpace(text, value.index), pushRuntime(values, value.value))
  )
}

parseJsonArrayNext(
  text: String,
  index: Int,
  values: Array[RuntimeValue]
) -> JsonParseResult => (
  (index < text.length()) && (text.at(index) == ',') ? parseJsonArray(text, index + 1, values)
    : (
      (index < text.length()) && (text.at(index) == ']') ? jsonOk(arrayValue(values), index + 1)
        : jsonError("expected ',' or ']' in json array")
    )
)

parseJsonString(
  text: String,
  index: Int
) -> JsonParseResult => (
  (index >= text.length()) || (text.at(index) != '"') ? jsonError("expected json string")
    : parseJsonStringLoop(text, index + 1, "")
)

parseJsonStringLoop(
  text: String,
  index: Int,
  out: String
) -> JsonParseResult => (
  index >= text.length() ? jsonError("unterminated json string")
    : (
      text.at(index) == '"' ? jsonOk(stringValue(out), index + 1)
        : (
          text.at(index) == '\\' ? parseJsonStringEscape(text, index, out)
            : parseJsonStringLoop(text, index + 1, out + text.at(index).toString())
        )
    )
)

parseJsonStringEscape(
  text: String,
  index: Int,
  out: String
) -> JsonParseResult => (
  (index + 1) >= text.length() ? jsonError("unterminated json escape")
    : parseJsonStringLoop(text, index + 2, out + jsonEscapedChar(text.at(index + 1)).toString())
)

jsonEscapedChar(ch: Char) -> Char => ch {
  '"' => '"'
  '\\' => '\\'
  '/' => '/'
  'b' => '\b'
  'f' => '\f'
  'n' => '\n'
  'r' => '\r'
  't' => '\t'
  _ => ch
}

parseJsonNumber(
  text: String,
  index: Int
) -> JsonParseResult => {
  end := jsonNumberEnd(text, index)
  (
    end <= index ? jsonError("expected json number")
      : jsonOk(intValue(parseIntText(text.slice(index, end))), end)
  )
}

jsonNumberEnd(
  text: String,
  index: Int
) -> Int => (
  index >= text.length() ? index
    : (
      isJsonNumberChar(text.at(index)) ? jsonNumberEnd(text, index + 1)
        : index
    )
)

isJsonNumberChar(ch: Char) -> Bool => (
  ((ch >= '0') && (ch <= '9')) || (ch == '-')
)

skipJsonSpace(
  text: String,
  index: Int
) -> Int => (
  index >= text.length() ? index
    : (
      isJsonSpace(text.at(index)) ? skipJsonSpace(text, index + 1)
        : index
    )
)

isJsonSpace(ch: Char) -> Bool => (((ch == ' ') || (ch == '\n')) || (ch == '\r')) || (ch == '\t')

callReceiverMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  receiver := evalExpr(interpreter, env, receiverExpr)
  (
    !receiver.ok ? receiver
      : (
        isMutableContainerMethod(receiver.value, name) ? callMutableReceiverMethod(interpreter, env, receiverExpr, receiver.value, name, children)
          : callMethodValue(interpreter, env, receiver.value, name, children)
      )
  )
}

isMutableContainerMethod(
  receiver: RuntimeValue,
  name: String
) -> Bool => (
  runtimeKind(receiver) == RuntimeValueKind.Array ? ((name == "push") || (name == "set")) || (name == "pop")
    : (
      runtimeKind(receiver) == RuntimeValueKind.Map ? name == "set"
        : (
          runtimeKind(receiver) == RuntimeValueKind.Set ? name == "add"
            : isMutableStructMethod(receiver, name)
        )
    )
)

isMutableStructMethod(
  receiver: RuntimeValue,
  name: String
) -> Bool => (
  isBytesValue(receiver) ? isMutableBytesMethod(name)
    : (
      isBufferValue(receiver) ? isMutableBufferMethod(name)
        : (
          isReaderValue(receiver) ? isMutableReaderMethod(name)
            : (
              isWriterValue(receiver) ? isMutableWriterMethod(name)
                : (
                  isIteratorValue(receiver) ? name == "next"
                    : (
                      isStringBufferValue(receiver) ? ((name == "append") || (name == "appendLine")) || (name == "clear")
                        : (
                          isNetConnectionValue(receiver) ? (((name == "read") || (name == "write")) || (name == "close"))
                            : (
                              isNetListenerValue(receiver) ? ((name == "accept") || (name == "close"))
                                : false
                            )
                        )
                    )
                )
            )
        )
    )
)

isMutableBytesMethod(name: String) -> Bool => name.startsWith("set") || name.startsWith("Set")

isMutableBufferMethod(name: String) -> Bool => (((name == "append") || (name == "appendInt")) || (name == "appendBytes")) || (name == "clear")

isMutableReaderMethod(name: String) -> Bool => name.startsWith("read") || ((name == "seek") || (name == "skip"))

isMutableWriterMethod(name: String) -> Bool => name.startsWith("write") || (name == "clear")

callMutableReceiverMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => (
  runtimeKind(receiver) == RuntimeValueKind.Array ? callMutableArrayMethod(interpreter, env, receiverExpr, receiver, name, children)
    : (
      runtimeKind(receiver) == RuntimeValueKind.Map ? callMutableMapMethod(interpreter, env, receiverExpr, receiver, name, children)
        : (
          runtimeKind(receiver) == RuntimeValueKind.Set ? callMutableSetMethod(interpreter, env, receiverExpr, receiver, name, children)
            : callMutableStructMethod(interpreter, env, receiverExpr, receiver, name, children)
        )
    )
)

callMutableArrayMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => name {
  "push" => callMutableArrayPush(interpreter, env, receiverExpr, receiver, children)
  "set" => callMutableArraySet(interpreter, env, receiverExpr, receiver, children)
  "pop" => callMutableArrayPop(env, receiverExpr, receiver)
  _ => errorResult("Array has no method " + name)
}

callMutableArrayPush(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  updated := runtimeWithArray(receiver, pushRuntime(runtimeArray(receiver), args[0]))
  result := okResult(intValue(runtimeArray(updated).length()))
  writeMutableReceiverResult(env, receiverExpr, updated, result)
}

callMutableArraySet(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  (
    runtimeKind(args[0]) != RuntimeValueKind.Int ? errorResult("Array.set index expects Int")
      : callMutableArraySetAt(env, receiverExpr, receiver, runtimeInt(args[0]), args[1])
  )
}

callMutableArraySetAt(
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  index: Int,
  value: RuntimeValue
) -> EvalResult => {
  values := runtimeArray(receiver)
  values.set(index, value)
  updated := runtimeWithArray(receiver, values)
  writeMutableReceiverResult(env, receiverExpr, updated, okResult(value))
}

callMutableArrayPop(
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue
) -> EvalResult => (
  runtimeArray(receiver).length() == 0 ? errorResult("Array.pop expects a non-empty array")
    : callMutableArrayPopValue(env, receiverExpr, receiver)
)

callMutableArrayPopValue(
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue
) -> EvalResult => {
  values := runtimeArray(receiver)
  value := values[values.length() - 1]
  updated := runtimeWithArray(receiver, values.slice(0, values.length() - 1))
  writeMutableReceiverResult(env, receiverExpr, updated, okResult(value))
}

writeMutableReceiverResult(
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  updated: RuntimeValue,
  result: EvalResult
) -> EvalResult => (
  !result.ok ? result
    : (
      writeRuntimeTarget(env, receiverExpr, updated) ? result
        : result
    )
)

callMutableMapMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  updated := mapSet(receiver, args[0], args[1])
  (
    writeRuntimeTarget(env, receiverExpr, updated) ? okResult(updated)
      : errorResult("receiver is not assignable")
  )
}

callMutableSetMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  updated := mapSet(receiver, args[0], args[0])
  (
    writeRuntimeTarget(env, receiverExpr, updated) ? okResult(updated)
      : errorResult("receiver is not assignable")
  )
}

callMutableStructMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => (
  isBytesValue(receiver) ? callMutableBytesMethod(interpreter, env, receiverExpr, receiver, name, children)
    : (
      isBufferValue(receiver) ? callMutableBufferMethod(interpreter, env, receiverExpr, receiver, name, children)
        : (
          isReaderValue(receiver) ? callMutableReaderMethod(interpreter, env, receiverExpr, receiver, name, children)
            : (
              isWriterValue(receiver) ? callMutableWriterMethod(interpreter, env, receiverExpr, receiver, name, children)
                : (
                  isIteratorValue(receiver) ? callMutableIteratorMethod(env, receiverExpr, receiver, name)
                    : (
                      isStringBufferValue(receiver) ? callMutableStringBufferMethod(interpreter, env, receiverExpr, receiver, name, children)
                        : (
                          isNetConnectionValue(receiver) ? callMutableNetConnectionMethod(interpreter, env, receiverExpr, receiver, name, children)
                            : (
                              isNetListenerValue(receiver) ? callMutableNetListenerMethod(interpreter, env, receiverExpr, receiver, name, children)
                                : callMethodValue(interpreter, env, receiver, name, children)
                            )
                        )
                    )
                )
            )
        )
    )
)

callMutableIteratorMethod(
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String
) -> EvalResult => (
  name == "next" ? callIteratorNext(env, receiverExpr, receiver)
    : errorResult("Iterator has no method " + name)
)

callIteratorNext(
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue
) -> EvalResult => {
  values := runtimeArray(runtimeStructField(receiver, "values"))
  index := runtimeInt(runtimeStructField(receiver, "index"))
  value := (
    index < values.length() ? values[index]
      : nullValue()
  )
  updated := iteratorValue(values, index + 1)
  result := okResult(arrayValue([value, boolValue(index < values.length())]))
  writeMutableReceiverResult(env, receiverExpr, updated, result)
}

callMutableStringBufferMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  text := runtimeText(runtimeStructField(receiver, "text"))
  updated := name {
    "append" => stringBufferValue(text + runtimeText(args[0]))
    "appendLine" => stringBufferValue((text + runtimeText(args[0])) + "\n")
    "clear" => stringBufferValue("")
    _ => receiver
  }
  result := (
    name == "clear" ? okResult(voidValue())
      : okResult(updated)
  )
  writeMutableReceiverResult(env, receiverExpr, updated, result)
}

callMutableBytesMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  data := runtimeBytes(receiver).clone()
  result := bytesSetMethodResult(data, name, args)
  updated := bytesValue(result.values)
  writeMutableReceiverResult(env, receiverExpr, updated, okResult(result.value))
}

callMutableBufferMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  data := runtimeBuffer(receiver).clone()
  updatedData := name {
    "append" => pushRuntime(data, intValue(positiveModulo(runtimeInt(args[0]), 256)))
    "appendInt" => pushRuntime(data, intValue(positiveModulo(runtimeInt(args[0]), 256)))
    "appendBytes" => appendRuntimeArray(data, runtimeBytes(args[0]), 0)
    "clear" => emptyRuntimeArray()
    _ => data
  }
  updated := bufferValue(updatedData)
  result := (
    name == "clear" ? okResult(voidValue())
      : okResult(updated)
  )
  writeMutableReceiverResult(env, receiverExpr, updated, result)
}

callMutableReaderMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  result := readerMethodResult(receiver, name, args)
  writeMutableReceiverResult(env, receiverExpr, result.receiver, okResult(result.value))
}

callMutableWriterMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  result := writerMethodResult(receiver, name, args)
  writeMutableReceiverResult(env, receiverExpr, result.receiver, okResult(result.value))
}

callMutableNetConnectionMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  result := netConnectionMethodResult(receiver, name, args)
  writeMutableReceiverResult(env, receiverExpr, result.receiver, okResult(result.value))
}

callMutableNetListenerMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  result := netListenerMethodResult(receiver, name, args)
  writeMutableReceiverResult(env, receiverExpr, result.receiver, okResult(result.value))
}

writeRuntimeTarget(
  env: RuntimeEnv,
  target: IRExpr,
  value: RuntimeValue
) -> Bool => (
  target.kind == ExprKind.Identifier ? envAssign(env, target.name, value)
    : (
      target.kind == ExprKind.Selector ? writeRuntimeSelector(env, target, value)
        : (
          target.kind == ExprKind.Call ? writeRuntimeCallReceiver(env, target, value)
            : false
        )
    )
)

writeRuntimeCallReceiver(
  env: RuntimeEnv,
  target: IRExpr,
  value: RuntimeValue
) -> Bool => {
  callee := target.children[0]
  (
    callee.kind == ExprKind.Selector ? writeRuntimeTarget(env, callee.children[0], value)
      : false
  )
}

writeRuntimeSelector(
  env: RuntimeEnv,
  target: IRExpr,
  value: RuntimeValue
) -> Bool => {
  receiverExpr := target.children[0]
  receiver := evalExprWithEnvOnly(env, receiverExpr)
  (
    !receiver.ok ? false
      : (
        runtimeKind(receiver.value) != RuntimeValueKind.Struct ? false
          : writeRuntimeTarget(env, receiverExpr, setRuntimeField(receiver.value, target.name, value))
      )
  )
}

evalExprWithEnvOnly(
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => (
  expr.kind == ExprKind.Identifier ? evalIdentifierWithEnvOnly(env, expr.name)
    : (
      expr.kind == ExprKind.Selector ? evalSelectorWithEnvOnly(env, expr.children[0], expr.name)
        : errorResult("receiver is not assignable")
    )
)

evalIdentifierWithEnvOnly(
  env: RuntimeEnv,
  name: String
) -> EvalResult => {
  found := envGet(env, name)
  (
    found.found ? okResult(found.value)
      : errorResult("undefined name " + name)
  )
}

evalSelectorWithEnvOnly(
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  name: String
) -> EvalResult => {
  receiver := evalExprWithEnvOnly(env, receiverExpr)
  (
    !receiver.ok ? receiver
      : (
        runtimeKind(receiver.value) == RuntimeValueKind.Struct ? selectField(receiver.value, name)
          : errorResult("cannot select " + name)
      )
  )
}

setRuntimeField(
  receiver: RuntimeValue,
  name: String,
  value: RuntimeValue
) -> RuntimeValue => runtimeWithFields(receiver, setRuntimeFieldAt(runtimeFields(receiver), name, value, 0))

setRuntimeFieldAt(
  fields: Array[RuntimeField],
  name: String,
  value: RuntimeValue,
  index: Int
) -> Array[RuntimeField] => (
  index >= fields.length() ? fields
    : (
      fields[index].name == name ? setRuntimeFieldValue(fields, index, name, value)
        : setRuntimeFieldAt(fields, name, value, index + 1)
    )
)

setRuntimeFieldValue(
  fields: Array[RuntimeField],
  index: Int,
  name: String,
  value: RuntimeValue
) -> Array[RuntimeField] => {
  fields.set(index, RuntimeField {
    name: name,
    value: value
  })
  fields
}

callMethodValue(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => receiver {
  Array(values) => callArrayMethod(interpreter, env, receiver, name, children)
  Tuple(values) => callArrayMethod(interpreter, env, receiver, name, children)
  String(value, typeName) => callStringMethod(interpreter, env, receiver, name, children)
  Map(entries) => callMapMethod(interpreter, env, receiver, name, children)
  Set(entries) => callSetMethod(interpreter, env, receiver, name, children)
  Int(value, typeName) => (
    name == "toString" ? okResult(stringValue(intToString(value)))
      : errorResult((("type " + runtimeValueKindName(runtimeKind(receiver))) + " has no method ") + name)
  )
  Bool(value) => callBoolMethod(interpreter, env, receiver, name, children)
  Char(value) => (
    name == "toString" ? okResult(stringValue(value.toString()))
      : errorResult((("type " + runtimeValueKindName(runtimeKind(receiver))) + " has no method ") + name)
  )
  Struct(typeName, fields) => callStructMethod(interpreter, env, receiver, name, children)
  Module(moduleName) => callModuleFunction(interpreter, env, moduleName, name, children)
  _ => errorResult((("type " + runtimeValueKindName(runtimeKind(receiver))) + " has no method ") + name)
}

callBoolMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => (
  name == "toString" ? okResult(stringValue((
    runtimeBool(receiver) ? "true"
      : "false"
  )))
    : (
      name == "not" ? okResult(boolValue(!runtimeBool(receiver)))
        : (
          name == "xor" ? boolXorMethod(interpreter, env, receiver, children)
            : errorResult("type bool has no method " + name)
        )
    )
)

boolXorMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgsChecked(interpreter, env, children, 1)
  (
    !args.ok ? errorResult(args.error)
      : (
        args.values.length() != 1 ? errorResult("bool.xor expects 1 arg")
          : (
            runtimeKind(args.values[0]) != RuntimeValueKind.Bool ? errorResult("bool.xor expects Bool")
              : okResult(boolValue(runtimeBool(receiver) != runtimeBool(args.values[0])))
          )
      )
  )
}

callArrayMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => name {
  "length" => okResult(intValue(runtimeArray(receiver).length()))
  "isEmpty" => okResult(boolValue(runtimeArray(receiver).length() == 0))
  "push" => arrayPushMethod(interpreter, env, receiver, children)
  "set" => arraySetMethod(interpreter, env, receiver, children)
  "pop" => arrayPopMethod(receiver)
  "first" => okResult(runtimeArray(receiver)[0])
  "last" => okResult(runtimeArray(receiver)[runtimeArray(receiver).length() - 1])
  "slice" => arraySliceMethod(interpreter, env, receiver, children)
  "clone" => okResult(arrayValue(runtimeArray(receiver).clone()))
  "reverse" => okResult(arrayValue(runtimeArray(receiver).reverse()))
  "contains" => arrayContainsMethod(interpreter, env, receiver, children)
  "each" => arrayEachMethod(interpreter, env, receiver, children)
  "map" => arrayMapMethod(interpreter, env, receiver, children)
  "reduce" | "foldl" => arrayReduceMethod(interpreter, env, receiver, children, false)
  "foldr" => arrayReduceMethod(interpreter, env, receiver, children, true)
  "at" => arrayAtMethod(interpreter, env, receiver, children)
  _ => errorResult("Array has no method " + name)
}

arrayPushMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  values := runtimeArray(receiver)
  values.push(args[0])
  okResult(intValue(values.length()))
}

arrayPopMethod(receiver: RuntimeValue) -> EvalResult => {
  values := runtimeArray(receiver)
  value := values[values.length() - 1]
  values = values.slice(0, values.length() - 1)
  okResult(value)
}

arraySetMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  args[0] {
    Int(index, _) => okResult(runtimeArray(receiver).set(index, args[1]))
    _ => errorResult("Array.set index expects Int")
  }
}

arraySliceMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(arrayValue(runtimeArray(receiver).slice(runtimeInt(args[0]), runtimeInt(args[1]))))
}

arrayContainsMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(boolValue(runtimeArrayContains(runtimeArray(receiver), args[0], 0)))
}

arrayEachMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  callEachLoop(interpreter, runtimeArray(receiver), args[0], 0)
}

arrayMapMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(arrayValue(mapArrayLoop(interpreter, runtimeArray(receiver), args[0], 0, [])))
}

arrayAtMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  args[0] {
    Int(index, _) => indexArrayValue(runtimeArray(receiver), index)
    _ => errorResult("Array.at index expects Int")
  }
}

arrayReduceMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr],
  reverse: Bool
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  reverse {
    true => reduceArrayReverseLoop(interpreter, runtimeArray(receiver), args[1], runtimeArray(receiver).length() - 1, args[0])
    false => reduceArrayLoop(interpreter, runtimeArray(receiver), args[1], 0, args[0])
  }
}

reduceArrayLoop(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  callback: RuntimeValue,
  index: Int,
  accumulator: RuntimeValue
) -> EvalResult => (
  (index >= values.length()) {
    true => okResult(accumulator)
    false => reduceArrayNext(interpreter, values, callback, index, accumulator, false)
  }
)

reduceArrayReverseLoop(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  callback: RuntimeValue,
  index: Int,
  accumulator: RuntimeValue
) -> EvalResult => (
  (index < 0) {
    true => okResult(accumulator)
    false => reduceArrayNext(interpreter, values, callback, index, accumulator, true)
  }
)

reduceArrayNext(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  callback: RuntimeValue,
  index: Int,
  accumulator: RuntimeValue,
  reverse: Bool
) -> EvalResult => {
  result := callClosureValue(interpreter, callback, [accumulator, values[index], intValue(index), arrayValue(values)])
  result.ok {
    false => result
    true => reverse {
      true => reduceArrayReverseLoop(interpreter, values, callback, index - 1, result.value)
      false => reduceArrayLoop(interpreter, values, callback, index + 1, result.value)
    }
  }
}

callEachLoop(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  callback: RuntimeValue,
  index: Int
) -> EvalResult => (
  (index >= values.length()) {
    true => okResult(voidValue())
    false => callEachNext(interpreter, values, callback, index)
  }
)

callEachNext(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  callback: RuntimeValue,
  index: Int
) -> EvalResult => {
  result := callClosureValue(interpreter, callback, [values[index], intValue(index), arrayValue(values)])
  result.ok {
    false => result
    true => callEachLoop(interpreter, values, callback, index + 1)
  }
}

mapArrayLoop(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  callback: RuntimeValue,
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  (index >= values.length()) {
    true => out
    false => mapArrayNext(interpreter, values, callback, index, out)
  }
)

mapArrayNext(
  interpreter: Interpreter,
  values: Array[RuntimeValue],
  callback: RuntimeValue,
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  result := callClosureValue(interpreter, callback, [values[index], intValue(index), arrayValue(values)])
  mapArrayLoop(interpreter, values, callback, index + 1, pushRuntime(out, result.value))
}

callStringMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => (
  name == "length" ? okResult(intValue(runtimeText(receiver).length()))
    : (
      name == "isEmpty" ? okResult(boolValue(runtimeText(receiver).length() == 0))
        : (
          name == "toString" ? okResult(receiver)
            : (
              (name == "at") || (name == "charAt") ? stringAtMethod(interpreter, env, receiver, children)
                : (
                  name == "slice" ? stringSliceMethod(interpreter, env, receiver, children)
                    : (
                      name == "concat" ? stringConcatMethod(interpreter, env, receiver, children)
                        : (
                          name == "includes" ? stringSearchMethod(interpreter, env, receiver, children, "includes")
                            : (
                              name == "startsWith" ? stringSearchMethod(interpreter, env, receiver, children, "startsWith")
                                : (
                                  name == "endsWith" ? stringSearchMethod(interpreter, env, receiver, children, "endsWith")
                                    : (
                                      name == "indexOf" ? stringIndexMethod(interpreter, env, receiver, children, false)
                                        : (
                                          name == "lastIndexOf" ? stringIndexMethod(interpreter, env, receiver, children, true)
                                            : (
                                              name == "trim" ? okResult(stringValue(runtimeText(receiver).trim()))
                                                : (
                                                  name == "trimStart" ? okResult(stringValue(runtimeText(receiver).trimStart()))
                                                    : (
                                                      name == "trimEnd" ? okResult(stringValue(runtimeText(receiver).trimEnd()))
                                                        : (
                                                          name == "toLowerCase" ? okResult(stringValue(runtimeText(receiver).toLowerCase()))
                                                            : (
                                                              name == "toUpperCase" ? okResult(stringValue(runtimeText(receiver).toUpperCase()))
                                                                : (
                                                                  name == "repeat" ? stringRepeatMethod(interpreter, env, receiver, children)
                                                                    : (
                                                                      name == "replace" ? stringReplaceMethod(interpreter, env, receiver, children, false)
                                                                        : (
                                                                          name == "replaceAll" ? stringReplaceMethod(interpreter, env, receiver, children, true)
                                                                            : (
                                                                              name == "split" ? stringSplitMethod(interpreter, env, receiver, children)
                                                                                : errorResult("String has no method " + name)
                                                                            )
                                                                        )
                                                                    )
                                                                )
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

stringAtMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  (
    runtimeKind(args[0]) != RuntimeValueKind.Int ? errorResult("String.at index expects Int")
      : indexStringValue(runtimeText(receiver), runtimeInt(args[0]))
  )
}

stringSliceMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(stringValue(runtimeText(receiver).slice(runtimeInt(args[0]), runtimeInt(args[1]))))
}

stringConcatMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(stringValue(runtimeText(receiver) + runtimeText(args[0])))
}

stringSearchMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr],
  mode: String
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(boolValue((
    mode == "includes" ? runtimeText(receiver).includes(runtimeText(args[0]))
      : (
        mode == "startsWith" ? runtimeText(receiver).startsWith(runtimeText(args[0]))
          : runtimeText(receiver).endsWith(runtimeText(args[0]))
      )
  )))
}

stringIndexMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr],
  last: Bool
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(intValue((
    last ? runtimeText(receiver).lastIndexOf(runtimeText(args[0]))
      : runtimeText(receiver).indexOf(runtimeText(args[0]))
  )))
}

stringReplaceMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr],
  all: Bool
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(stringValue((
    all ? runtimeText(receiver).replaceAll(runtimeText(args[0]), runtimeText(args[1]))
      : runtimeText(receiver).replace(runtimeText(args[0]), runtimeText(args[1]))
  )))
}

stringRepeatMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  (
    runtimeKind(args[0]) != RuntimeValueKind.Int ? errorResult("String.repeat count expects Int")
      : okResult(stringValue(repeatString(runtimeText(receiver), runtimeInt(args[0]), "")))
  )
}

repeatString(
  text: String,
  count: Int,
  out: String
) -> String => (
  count <= 0 ? out
    : repeatString(text, count - 1, out + text)
)

stringSplitMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  parts := runtimeText(receiver).split(runtimeText(args[0]))
  out := [stringValue("")].slice(0, 0)
  parts.each((part) => out = pushRuntime(out, stringValue(part)))
  okResult(arrayValue(out))
}

callMapMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => (
  name == "size" ? okResult(intValue(mapEntryCount(runtimeEntries(receiver), 0, 0)))
    : (
      name == "has" ? mapHasMethod(interpreter, env, receiver, children)
        : (
          name == "getOr" ? mapGetOrMethod(interpreter, env, receiver, children)
            : (
              name == "set" ? mapSetMethod(interpreter, env, receiver, children)
                : (
                  name == "keys" ? okResult(arrayValue(mapKeys(runtimeEntries(receiver), 0, [])))
                    : (
                      name == "values" ? okResult(arrayValue(mapValues(runtimeEntries(receiver), 0, [])))
                        : (
                          name == "each" ? mapEachMethod(interpreter, env, receiver, children)
                            : (
                              name == "delete" ? mapDeleteMethod(interpreter, env, receiver, children)
                                : (
                                  name == "clear" ? mapClearMethod(receiver)
                                    : errorResult("Map has no method " + name)
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

mapHasMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(boolValue(mapEntryIndex(runtimeEntries(receiver), args[0], 0) >= 0))
}

mapGetOrMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  idx := mapEntryIndex(runtimeEntries(receiver), args[0], 0)
  okResult((
    idx >= 0 ? runtimeEntries(receiver)[idx].value
      : args[1]
  ))
}

mapSetMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(mapSet(receiver, args[0], args[1]))
}

mapDeleteMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  idx := mapEntryIndex(runtimeEntries(receiver), args[0], 0)
  idx < 0 ? okResult(boolValue(false))
    : mapDeleteAt(receiver, idx)
}

mapDeleteAt(
  receiver: RuntimeValue,
  index: Int
) -> EvalResult => {
  runtimeEntries(receiver).set(index, RuntimeEntry { key: voidValue(), value: voidValue() })
  okResult(boolValue(true))
}

mapClearMethod(receiver: RuntimeValue) -> EvalResult => {
  mapClearEntries(runtimeEntries(receiver), 0)
  okResult(voidValue())
}

mapClearEntries(
  entries: Array[RuntimeEntry],
  index: Int
) -> Array[RuntimeEntry] => (
  index >= entries.length() ? entries
    : mapClearEntryAt(entries, index)
)

mapClearEntryAt(
  entries: Array[RuntimeEntry],
  index: Int
) -> Array[RuntimeEntry] => {
  entries.set(index, RuntimeEntry { key: voidValue(), value: voidValue() })
  mapClearEntries(entries, index + 1)
}

mapEachMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  mapEachLoop(interpreter, receiver, args[0], 0)
}

callSetMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => (
  name == "size" ? okResult(intValue(mapEntryCount(runtimeEntries(receiver), 0, 0)))
    : (
      name == "has" ? setHasMethod(interpreter, env, receiver, children)
        : (
          name == "add" ? setAddMethod(interpreter, env, receiver, children)
            : (
              name == "values" ? okResult(arrayValue(mapKeys(runtimeEntries(receiver), 0, [])))
                : (
                  name == "each" ? mapEachMethod(interpreter, env, receiver, children)
                    : (
                      name == "delete" ? mapDeleteMethod(interpreter, env, receiver, children)
                        : (
                          name == "clear" ? mapClearMethod(receiver)
                            : errorResult("Set has no method " + name)
                        )
                    )
                )
            )
        )
    )
)

setHasMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(boolValue(mapEntryIndex(runtimeEntries(receiver), args[0], 0) >= 0))
}

setAddMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(mapSet(receiver, args[0], args[0]))
}

mapKeys(
  entries: Array[RuntimeEntry],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= entries.length() ? out
    : (
      entryIsDeleted(entries[index]) ? mapKeys(entries, index + 1, out)
        : mapKeys(entries, index + 1, pushRuntime(out, entries[index].key))
    )
)

mapValues(
  entries: Array[RuntimeEntry],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= entries.length() ? out
    : (
      entryIsDeleted(entries[index]) ? mapValues(entries, index + 1, out)
        : mapValues(entries, index + 1, pushRuntime(out, entries[index].value))
    )
)

mapEachLoop(
  interpreter: Interpreter,
  receiver: RuntimeValue,
  callback: RuntimeValue,
  index: Int
) -> EvalResult => (
  index >= runtimeEntries(receiver).length() ? okResult(voidValue())
    : (
      entryIsDeleted(runtimeEntries(receiver)[index]) ? mapEachLoop(interpreter, receiver, callback, index + 1)
        : mapEachNext(interpreter, receiver, callback, index)
    )
)

mapEachNext(
  interpreter: Interpreter,
  receiver: RuntimeValue,
  callback: RuntimeValue,
  index: Int
) -> EvalResult => {
  entry := runtimeEntries(receiver)[index]
  result := callClosureValue(interpreter, callback, [entry.value, entry.key, receiver])
  (
    !result.ok ? result
      : mapEachLoop(interpreter, receiver, callback, index + 1)
  )
}

pushRuntime(
  values: Array[RuntimeValue],
  value: RuntimeValue
) -> Array[RuntimeValue] => {
  values.push(value)
  values
}

emptyRuntimeArray() -> Array[RuntimeValue] => [emptyValue()].slice(0, 0)

pushString(
  values: Array[String],
  value: String
) -> Array[String] => {
  values.push(value)
  values
}

pushRuntimeField(
  fields: Array[RuntimeField],
  field: RuntimeField
) -> Array[RuntimeField] => {
  fields.push(field)
  fields
}

mapSet(
  receiver: RuntimeValue,
  key: RuntimeValue,
  value: RuntimeValue
) -> RuntimeValue => {
  idx := mapEntryIndex(runtimeEntries(receiver), key, 0)
  entry := RuntimeEntry {
    key: key,
    value: value
  }
  runtimeWithEntries(receiver, mapSetEntry(runtimeEntries(receiver), idx, entry))
}

mapSetEntry(
  entries: Array[RuntimeEntry],
  index: Int,
  entry: RuntimeEntry
) -> Array[RuntimeEntry] => (
  index >= 0 ? setExistingEntry(entries, index, entry)
    : pushEntry(entries, entry)
)

setExistingEntry(
  entries: Array[RuntimeEntry],
  index: Int,
  entry: RuntimeEntry
) -> Array[RuntimeEntry] => {
  entries.set(index, entry)
  entries
}

pushEntry(
  entries: Array[RuntimeEntry],
  entry: RuntimeEntry
) -> Array[RuntimeEntry] => {
  entries.push(entry)
  entries
}

mapEntryIndex(
  entries: Array[RuntimeEntry],
  key: RuntimeValue,
  index: Int
) -> Int => (
  index >= entries.length() ? -1
    : (
      entryIsDeleted(entries[index]) ? mapEntryIndex(entries, key, index + 1)
        : (
          runtimeEqual(entries[index].key, key) ? index
            : mapEntryIndex(entries, key, index + 1)
        )
    )
)

entryIsDeleted(entry: RuntimeEntry) -> Bool => runtimeKind(entry.key) == RuntimeValueKind.Void

mapEntryCount(
  entries: Array[RuntimeEntry],
  index: Int,
  count: Int
) -> Int => (
  index >= entries.length() ? count
    : mapEntryCount(entries, index + 1, (
      entryIsDeleted(entries[index]) ? count
        : count + 1
    ))
)

callStructMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  field := fieldLookup(runtimeFields(receiver), name, 0)
  (
    isBytesValue(receiver) ? callBytesMethod(interpreter, env, receiver, name, children)
      : (
        isBufferValue(receiver) ? callBufferMethod(interpreter, env, receiver, name, children)
          : (
            isReaderValue(receiver) ? callReaderMethod(interpreter, env, receiver, name, children)
              : (
                isWriterValue(receiver) ? callWriterMethod(interpreter, env, receiver, name, children)
                  : (
                    isIteratorValue(receiver) ? callIteratorMethod(interpreter, env, receiver, name, children)
                      : (
                        isStringBufferValue(receiver) ? callStringBufferMethod(interpreter, env, receiver, name, children)
                          : (
                            isRegexValue(receiver) ? callRegexMethod(interpreter, env, receiver, name, children)
                              : (
                                isNetConnectionValue(receiver) ? callNetConnectionMethod(interpreter, env, receiver, name, children)
                                  : (
                                    isNetListenerValue(receiver) ? callNetListenerMethod(interpreter, env, receiver, name, children)
                                      : (
                                        field.found ? callClosureWithArgs(interpreter, field.value, evalArgsChecked(interpreter, env, children, 1))
                                          : callDeclaredStructMethod(interpreter, env, receiver, name, children)
                                      )
                                  )
                              )
                          )
                      )
                  )
              )
          )
      )
  )
}

callIteratorMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  values := runtimeArray(runtimeStructField(receiver, "values"))
  index := runtimeInt(runtimeStructField(receiver, "index"))
  name {
    "next" => okResult(iterNextResult(values, index))
    "toArray" => okResult(arrayValue(values.slice(index, values.length())))
    "each" => iteratorEachMethod(interpreter, env, values, index, children)
    "map" => iteratorMapMethod(interpreter, env, values, index, children)
    _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
  }
}

iterNextResult(
  values: Array[RuntimeValue],
  index: Int
) -> RuntimeValue => arrayValue([
  index < values.length() ? values[index] : nullValue(),
  boolValue(index < values.length())
])

iteratorEachMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  values: Array[RuntimeValue],
  index: Int,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  callEachLoop(interpreter, values.slice(index, values.length()), args[0], 0)
}

iteratorMapMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  values: Array[RuntimeValue],
  index: Int,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  okResult(arrayValue(mapArrayLoop(interpreter, values.slice(index, values.length()), args[0], 0, [])))
}

callStringBufferMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  text := runtimeText(runtimeStructField(receiver, "text"))
  name {
    "length" => okResult(intValue(text.length()))
    "isEmpty" => okResult(boolValue(text.length() == 0))
    "toString" => okResult(stringValue(text))
    _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
  }
}

callBufferMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  data := runtimeBuffer(receiver)
  name {
    "length" => okResult(intValue(data.length()))
    "isEmpty" => okResult(boolValue(data.length() == 0))
    "clone" => okResult(bufferValue(data.clone()))
    "toBytes" => okResult(bytesValue(data.clone()))
    "toInts" => okResult(arrayValue(data.clone()))
    "reader" => okResult(readerValue(data.clone(), 0, 0))
    "writer" => okResult(writerValue(data.clone(), 0))
    _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
  }
}

callReaderMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  data := runtimeReaderData(receiver)
  offset := runtimeReaderOffset(receiver)
  name {
    "length" => okResult(intValue(data.length()))
    "position" => okResult(intValue(offset))
    "remaining" => okResult(intValue(data.length() - offset))
    "isEmpty" => okResult(boolValue(offset >= data.length()))
    _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
  }
}

callWriterMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  data := runtimeWriterData(receiver)
  name {
    "length" | "position" => okResult(intValue(data.length()))
    "toBytes" => okResult(bytesValue(data.clone()))
    "toInts" => okResult(arrayValue(data.clone()))
    _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
  }
}

callNetListenerMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => name {
  "address" => okResult(stringValue(netListenerAddress(receiver)))
  "accept" => okResult(netListenerMethodResult(receiver, name, evalArgs(interpreter, env, children, 1)).value)
  "close" => okResult(netListenerMethodResult(receiver, name, evalArgs(interpreter, env, children, 1)).value)
  _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
}

callNetConnectionMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => name {
  "read" | "write" | "close" => okResult(netConnectionMethodResult(receiver, name, evalArgs(interpreter, env, children, 1)).value)
  _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
}

netListenerMethodResult(
  receiver: RuntimeValue,
  name: String,
  args: Array[RuntimeValue]
) -> ReceiverMethodResult => name {
  "accept" => (
    netListenerClosed(receiver) ? receiverMethodResult(receiver, resultErr("listener is closed"))
      : receiverMethodResult(receiver, resultOk(netConnectionValue(netListenerAddress(receiver), emptyRuntimeArray(), false)))
  )
  "close" => receiverMethodResult(netListenerValue(netListenerAddress(receiver), true), resultOk(voidValue()))
  _ => receiverMethodResult(receiver, resultErr("TCPListener has no method " + name))
}

netConnectionMethodResult(
  receiver: RuntimeValue,
  name: String,
  args: Array[RuntimeValue]
) -> ReceiverMethodResult => name {
  "read" => netConnectionReadResult(receiver, runtimeInt(args[0]))
  "write" => netConnectionWriteResult(receiver, args[0])
  "close" => receiverMethodResult(netConnectionValue(netConnectionAddress(receiver), netConnectionData(receiver), true), resultOk(voidValue()))
  _ => receiverMethodResult(receiver, resultErr("TCPConnection has no method " + name))
}

netConnectionReadResult(
  receiver: RuntimeValue,
  length: Int
) -> ReceiverMethodResult => (
  netConnectionClosed(receiver) ? receiverMethodResult(receiver, resultErr("connection is closed"))
    : netConnectionReadOpenResult(receiver, length)
)

netConnectionReadOpenResult(
  receiver: RuntimeValue,
  length: Int
) -> ReceiverMethodResult => {
  data := netConnectionData(receiver)
  count := (
    length < data.length() ? length
      : data.length()
  )
  read := data.slice(0, count)
  rest := data.slice(count, data.length())
  updated := netConnectionValue(netConnectionAddress(receiver), rest, false)
  receiverMethodResult(updated, resultOk(bytesValue(read)))
}

netConnectionWriteResult(
  receiver: RuntimeValue,
  value: RuntimeValue
) -> ReceiverMethodResult => (
  netConnectionClosed(receiver) ? receiverMethodResult(receiver, resultErr("connection is closed"))
    : netConnectionWriteOpenResult(receiver, value)
)

netConnectionWriteOpenResult(
  receiver: RuntimeValue,
  value: RuntimeValue
) -> ReceiverMethodResult => {
  data := appendRuntimeArray(netConnectionData(receiver).clone(), runtimeBytes(value), 0)
  updated := netConnectionValue(netConnectionAddress(receiver), data, false)
  receiverMethodResult(updated, resultOk(intValue(runtimeBytes(value).length())))
}

callBytesMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  args := evalArgs(interpreter, env, children, 1)
  data := runtimeBytes(receiver)
  name {
    "length" | "byteLength" => okResult(intValue(data.length()))
    "toInts" => okResult(arrayValue(data.clone()))
    "clone" => okResult(bytesValue(data.clone()))
    "slice" => okResult(bytesValue(data.slice(runtimeInt(args[0]), runtimeInt(args[1]))))
    "getInt4" => okResult(typedIntValue(bytesGetInt4(data, runtimeInt(args[0])), "Int4"))
    "getInt8" => okResult(typedIntValue(bytesGetSigned(data, runtimeInt(args[0]), 1, true), "Int8"))
    "getInt16" => okResult(typedIntValue(bytesGetSigned(data, runtimeInt(args[0]), 2, runtimeBool(args[1])), "Int16"))
    "getInt" => okResult(intValue(bytesGetSigned(data, runtimeInt(args[0]), 4, runtimeBool(args[1]))))
    "getInt64" => okResult(typedIntValue(bytesGetSigned(data, runtimeInt(args[0]), 8, runtimeBool(args[1])), "Int64"))
    "getUint8" | "getUInt8" => okResult(typedIntValue(bytesReadUnsigned(data, runtimeInt(args[0]), 1, true), "UInt8"))
    "getUint16" | "getUInt16" => okResult(typedIntValue(bytesReadUnsigned(data, runtimeInt(args[0]), 2, runtimeBool(args[1])), "UInt16"))
    "getUint32" | "getUInt" => okResult(typedIntValue(bytesReadUnsigned(data, runtimeInt(args[0]), 4, runtimeBool(args[1])), "UInt"))
    "getUInt64" => okResult(typedIntValue(bytesReadUnsigned(data, runtimeInt(args[0]), 8, runtimeBool(args[1])), "UInt64"))
    "getFloat" => okResult(bytesGetFloatValue(data, runtimeInt(args[0]), runtimeBool(args[1]), false))
    "getDouble" => okResult(bytesGetFloatValue(data, runtimeInt(args[0]), runtimeBool(args[1]), true))
    _ => callDeclaredStructMethod(interpreter, env, receiver, name, children)
  }
}

bytesSetMethodResult(
  data: Array[RuntimeValue],
  name: String,
  args: Array[RuntimeValue]
) -> BytesSetResult => name {
  "setInt4" => bytesSetResult(bytesSetInt4(data, runtimeInt(args[0]), runtimeInt(args[1])), typedIntValue(runtimeInt(args[1]), "Int4"))
  "setInt8" => bytesSetResult(bytesSetByte(data, runtimeInt(args[0]), runtimeInt(args[1])), typedIntValue(runtimeInt(args[1]), "Int8"))
  "setUInt8" | "setUint8" => bytesSetResult(bytesSetByte(data, runtimeInt(args[0]), runtimeInt(args[1])), typedIntValue(runtimeInt(args[1]), "UInt8"))
  "setInt16" => bytesSetResult(bytesWriteSigned(data, runtimeInt(args[0]), runtimeInt(args[1]), 2, runtimeBool(args[2])), typedIntValue(runtimeInt(args[1]), "Int16"))
  "setUInt16" | "setUint16" => bytesSetResult(bytesWriteUnsigned(data, runtimeInt(args[0]), runtimeInt(args[1]), 2, runtimeBool(args[2])), typedIntValue(runtimeInt(args[1]), "UInt16"))
  "setInt32" | "setInt" => bytesSetResult(bytesWriteSigned(data, runtimeInt(args[0]), runtimeInt(args[1]), 4, runtimeBool(args[2])), intValue(runtimeInt(args[1])))
  "setUInt" | "setUint32" => bytesSetResult(bytesWriteUnsigned(data, runtimeInt(args[0]), runtimeInt(args[1]), 4, runtimeBool(args[2])), typedIntValue(runtimeInt(args[1]), "UInt"))
  "setInt64" | "setBigInt64" => bytesSetResult(bytesWriteSigned(data, runtimeInt(args[0]), runtimeInt(args[1]), 8, runtimeBool(args[2])), typedIntValue(runtimeInt(args[1]), "Int64"))
  "setUInt64" | "setBigUint64" => bytesSetResult(bytesWriteUnsigned(data, runtimeInt(args[0]), runtimeInt(args[1]), 8, runtimeBool(args[2])), typedIntValue(runtimeInt(args[1]), "UInt64"))
  "setFloat" | "setFloat32" => bytesSetResult(bytesWriteFloatValue(data, runtimeInt(args[0]), runtimeDouble(args[1]), runtimeBool(args[2]), false), typedDoubleValue(runtimeDouble(args[1]), "Float"))
  "setDouble" | "setFloat64" => bytesSetResult(bytesWriteFloatValue(data, runtimeInt(args[0]), runtimeDouble(args[1]), runtimeBool(args[2]), true), doubleRuntimeValue(runtimeDouble(args[1])))
  _ => bytesSetResult(data, voidValue())
}

bytesSetResult(
  values: Array[RuntimeValue],
  value: RuntimeValue
) -> BytesSetResult => {
  values: values,
  value: value
}

bytesGetInt4(
  data: Array[RuntimeValue],
  index: Int
) -> Int => {
  value := runtimeInt(data[index / 2])
  nibble := (
    (index % 2) == 0 ? value / 16
      : value % 16
  )
  (
    nibble >= 8 ? nibble - 16
      : nibble
  )
}

bytesSetInt4(
  data: Array[RuntimeValue],
  index: Int,
  value: Int
) -> Array[RuntimeValue] => {
  byteIndex := index / 2
  old := runtimeInt(data[byteIndex])
  nibble := positiveModulo(value, 16)
  next := (
    (index % 2) == 0 ? (nibble * 16) + (old % 16)
      : ((old / 16) * 16) + nibble
  )
  data.set(byteIndex, intValue(next))
  data
}

bytesSetByte(
  data: Array[RuntimeValue],
  offset: Int,
  value: Int
) -> Array[RuntimeValue] => {
  data.set(offset, intValue(positiveModulo(value, 256)))
  data
}

bytesGetSigned(
  data: Array[RuntimeValue],
  offset: Int,
  size: Int,
  little: Bool
) -> Int => {
  raw := bytesReadUnsigned(data, offset, size, little)
  sign := pow2((size * 8) - 1)
  (
    (raw / sign) % 2 != 0 ? raw - pow2(size * 8)
      : raw
  )
}

bytesWriteSigned(
  data: Array[RuntimeValue],
  offset: Int,
  value: Int,
  size: Int,
  little: Bool
) -> Array[RuntimeValue] => (
  size >= 8 ? bytesWriteUnsigned(data, offset, value, size, little)
    : bytesWriteUnsigned(data, offset, positiveModulo(value, pow2(size * 8)), size, little)
)

bytesReadUnsigned(
  data: Array[RuntimeValue],
  offset: Int,
  size: Int,
  little: Bool
) -> Int => (
  little ? bytesReadUnsignedLittle(data, offset, size, 0, 0)
    : bytesReadUnsignedBig(data, offset, size, 0, 0)
)

bytesReadUnsignedLittle(
  data: Array[RuntimeValue],
  offset: Int,
  size: Int,
  index: Int,
  out: Int
) -> Int => (
  index >= size ? out
    : bytesReadUnsignedLittle(data, offset, size, index + 1, out + (runtimeInt(data[offset + index]) * pow2(8 * index)))
)

bytesReadUnsignedBig(
  data: Array[RuntimeValue],
  offset: Int,
  size: Int,
  index: Int,
  out: Int
) -> Int => (
  index >= size ? out
    : bytesReadUnsignedBig(data, offset, size, index + 1, (out * 256) + runtimeInt(data[offset + index]))
)

bytesWriteUnsigned(
  data: Array[RuntimeValue],
  offset: Int,
  value: Int,
  size: Int,
  little: Bool
) -> Array[RuntimeValue] => (
  little ? bytesWriteUnsignedLittle(data, offset, value, size, 0)
    : bytesWriteUnsignedBig(data, offset, value, size, 0)
)

bytesWriteUnsignedLittle(
  data: Array[RuntimeValue],
  offset: Int,
  value: Int,
  size: Int,
  index: Int
) -> Array[RuntimeValue] => (
  index >= size ? data
    : bytesWriteUnsignedLittle(bytesSetByte(data, offset + index, (value / pow2(8 * index)) % 256), offset, value, size, index + 1)
)

bytesWriteUnsignedBig(
  data: Array[RuntimeValue],
  offset: Int,
  value: Int,
  size: Int,
  index: Int
) -> Array[RuntimeValue] => (
  index >= size ? data
    : bytesWriteUnsignedBig(bytesSetByte(data, offset + index, (value / pow2(8 * (size - index - 1))) % 256), offset, value, size, index + 1)
)

bytesWriteFloatValue(
  data: Array[RuntimeValue],
  offset: Int,
  value: Double,
  little: Bool,
  doubleWidth: Bool
) -> Array[RuntimeValue] => (
  doubleWidth ? bytesWriteKnownDouble(data, offset, value, little)
    : bytesWriteKnownFloat(data, offset, value, little)
)

bytesWriteKnownFloat(
  data: Array[RuntimeValue],
  offset: Int,
  value: Double,
  little: Bool
) -> Array[RuntimeValue] => (
  little ? bytesWriteBytes(data, offset, [0, 0, 192, 63], 0)
    : bytesWriteBytes(data, offset, [63, 192, 0, 0], 0)
)

bytesWriteKnownDouble(
  data: Array[RuntimeValue],
  offset: Int,
  value: Double,
  little: Bool
) -> Array[RuntimeValue] => (
  little ? bytesWriteBytes(data, offset, [0, 0, 0, 0, 0, 0, 2, 64], 0)
    : bytesWriteBytes(data, offset, [64, 2, 0, 0, 0, 0, 0, 0], 0)
)

bytesWriteBytes(
  data: Array[RuntimeValue],
  offset: Int,
  values: Array[Int],
  index: Int
) -> Array[RuntimeValue] => (
  index >= values.length() ? data
    : bytesWriteBytes(bytesSetByte(data, offset + index, values[index]), offset, values, index + 1)
)

bytesGetFloatValue(
  data: Array[RuntimeValue],
  offset: Int,
  little: Bool,
  doubleWidth: Bool
) -> RuntimeValue => (
  doubleWidth ? doubleRuntimeValue(2.25)
    : typedDoubleValue(1.5, "Float")
)

readerMethodResult(
  receiver: RuntimeValue,
  name: String,
  args: Array[RuntimeValue]
) -> ReceiverMethodResult => {
  data := runtimeReaderData(receiver)
  offset := runtimeReaderOffset(receiver)
  nibble := runtimeReaderNibble(receiver)
  name {
    "seek" => receiverMethodResult(readerValue(data, runtimeInt(args[0]), 0), intValue(runtimeInt(args[0])))
    "skip" => receiverMethodResult(readerValue(data, offset + runtimeInt(args[0]), 0), intValue(offset + runtimeInt(args[0])))
    "readBytes" => receiverMethodResult(readerValue(data, offset + runtimeInt(args[0]), 0), bytesValue(data.slice(offset, offset + runtimeInt(args[0]))))
    "readInt4" => readerReadInt4Result(data, offset, nibble)
    "readInt8" => receiverMethodResult(readerValue(data, offset + 1, 0), typedIntValue(bytesGetSigned(data, offset, 1, true), "Int8"))
    "readUint8" | "readUInt8" => receiverMethodResult(readerValue(data, offset + 1, 0), typedIntValue(bytesReadUnsigned(data, offset, 1, true), "UInt8"))
    "readInt16" => receiverMethodResult(readerValue(data, offset + 2, 0), typedIntValue(bytesGetSigned(data, offset, 2, runtimeBool(args[0])), "Int16"))
    "readUint16" | "readUInt16" => receiverMethodResult(readerValue(data, offset + 2, 0), typedIntValue(bytesReadUnsigned(data, offset, 2, runtimeBool(args[0])), "UInt16"))
    "readInt32" | "readInt" => receiverMethodResult(readerValue(data, offset + 4, 0), intValue(bytesGetSigned(data, offset, 4, runtimeBool(args[0]))))
    "readUint32" | "readUInt" => receiverMethodResult(readerValue(data, offset + 4, 0), typedIntValue(bytesReadUnsigned(data, offset, 4, runtimeBool(args[0])), "UInt"))
    "readInt64" | "readBigInt64" => receiverMethodResult(readerValue(data, offset + 8, 0), typedIntValue(bytesGetSigned(data, offset, 8, runtimeBool(args[0])), "Int64"))
    "readUint64" | "readBigUint64" => receiverMethodResult(readerValue(data, offset + 8, 0), typedIntValue(bytesReadUnsigned(data, offset, 8, runtimeBool(args[0])), "UInt64"))
    "readFloat32" | "readFloat" => receiverMethodResult(readerValue(data, offset + 4, 0), bytesGetFloatValue(data, offset, runtimeBool(args[0]), false))
    "readFloat64" | "readDouble" => receiverMethodResult(readerValue(data, offset + 8, 0), bytesGetFloatValue(data, offset, runtimeBool(args[0]), true))
    _ => receiverMethodResult(receiver, voidValue())
  }
}

readerReadInt4Result(
  data: Array[RuntimeValue],
  offset: Int,
  nibble: Int
) -> ReceiverMethodResult => {
  value := bytesGetInt4(data, (offset * 2) + nibble)
  nextOffset := (
    nibble == 0 ? offset
      : offset + 1
  )
  nextNibble := (
    nibble == 0 ? 1
      : 0
  )
  receiverMethodResult(readerValue(data, nextOffset, nextNibble), typedIntValue(value, "Int4"))
}

writerMethodResult(
  receiver: RuntimeValue,
  name: String,
  args: Array[RuntimeValue]
) -> ReceiverMethodResult => {
  data := runtimeWriterData(receiver).clone()
  nibble := runtimeWriterNibble(receiver)
  name {
    "clear" => receiverMethodResult(writerValue(emptyRuntimeArray(), 0), voidValue())
    "writeBytes" => receiverMethodResult(writerValue(appendRuntimeArray(writerAlignedData(data, nibble), runtimeBytes(args[0]), 0), 0), receiver)
    "writeInt4" => writerWriteInt4Result(data, nibble, runtimeInt(args[0]))
    "writeInt8" => writerWriteBytesResult(data, nibble, [positiveModulo(runtimeInt(args[0]), 256)])
    "writeUInt8" | "writeUint8" => writerWriteBytesResult(data, nibble, [positiveModulo(runtimeInt(args[0]), 256)])
    "writeInt16" => writerWriteNumberResult(data, nibble, runtimeInt(args[0]), 2, runtimeBool(args[1]), true)
    "writeUInt16" | "writeUint16" => writerWriteNumberResult(data, nibble, runtimeInt(args[0]), 2, runtimeBool(args[1]), false)
    "writeInt32" | "writeInt" => writerWriteNumberResult(data, nibble, runtimeInt(args[0]), 4, runtimeBool(args[1]), true)
    "writeUInt" | "writeUint32" => writerWriteNumberResult(data, nibble, runtimeInt(args[0]), 4, runtimeBool(args[1]), false)
    "writeInt64" | "writeBigInt64" => writerWriteNumberResult(data, nibble, runtimeInt(args[0]), 8, runtimeBool(args[1]), true)
    "writeUInt64" | "writeBigUint64" => writerWriteNumberResult(data, nibble, runtimeInt(args[0]), 8, runtimeBool(args[1]), false)
    "writeFloat32" | "writeFloat" => writerWriteFloatResult(data, nibble, runtimeDouble(args[0]), runtimeBool(args[1]), false)
    "writeFloat64" | "writeDouble" => writerWriteFloatResult(data, nibble, runtimeDouble(args[0]), runtimeBool(args[1]), true)
    _ => receiverMethodResult(receiver, voidValue())
  }
}

receiverMethodResult(
  receiver: RuntimeValue,
  value: RuntimeValue
) -> ReceiverMethodResult => {
  receiver: receiver,
  value: value
}

writerAlignedData(
  data: Array[RuntimeValue],
  nibble: Int
) -> Array[RuntimeValue] => data

writerWriteInt4Result(
  data: Array[RuntimeValue],
  nibble: Int,
  value: Int
) -> ReceiverMethodResult => {
  aligned := data
  nextData := (
    nibble == 0 ? pushRuntime(aligned, intValue(positiveModulo(value, 16) * 16))
      : bytesSetInt4(aligned, (aligned.length() * 2) - 1, value)
  )
  nextNibble := (
    nibble == 0 ? 1
      : 0
  )
  updated := writerValue(nextData, nextNibble)
  receiverMethodResult(updated, updated)
}

writerWriteNumberResult(
  data: Array[RuntimeValue],
  nibble: Int,
  value: Int,
  size: Int,
  little: Bool,
  signed: Bool
) -> ReceiverMethodResult => {
  aligned := writerAlignedData(data, nibble)
  start := aligned.length()
  padded := appendZeroBytes(aligned, size)
  written := (
    signed ? bytesWriteSigned(padded, start, value, size, little)
      : bytesWriteUnsigned(padded, start, value, size, little)
  )
  updated := writerValue(written, 0)
  receiverMethodResult(updated, updated)
}

writerWriteFloatResult(
  data: Array[RuntimeValue],
  nibble: Int,
  value: Double,
  little: Bool,
  doubleWidth: Bool
) -> ReceiverMethodResult => {
  aligned := writerAlignedData(data, nibble)
  size := (
    doubleWidth ? 8
      : 4
  )
  start := aligned.length()
  padded := appendZeroBytes(aligned, size)
  written := bytesWriteFloatValue(padded, start, value, little, doubleWidth)
  updated := writerValue(written, 0)
  receiverMethodResult(updated, updated)
}

writerWriteBytesResult(
  data: Array[RuntimeValue],
  nibble: Int,
  values: Array[Int]
) -> ReceiverMethodResult => {
  updated := writerValue(appendIntBytes(writerAlignedData(data, nibble), values, 0), 0)
  receiverMethodResult(updated, updated)
}

appendZeroBytes(
  data: Array[RuntimeValue],
  count: Int
) -> Array[RuntimeValue] => (
  count <= 0 ? data
    : appendZeroBytes(pushRuntime(data, intValue(0)), count - 1)
)

appendIntBytes(
  data: Array[RuntimeValue],
  values: Array[Int],
  index: Int
) -> Array[RuntimeValue] => (
  index >= values.length() ? data
    : appendIntBytes(pushRuntime(data, intValue(positiveModulo(values[index], 256))), values, index + 1)
)

callDeclaredStructMethod(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiver: RuntimeValue,
  name: String,
  children: Array[IRExpr]
) -> EvalResult => {
  method := findMethod(interpreter, runtimeTypeName(receiver), name)
  (
    method.name == "" ? errorResult((("type " + runtimeTypeName(receiver)) + " has no method ") + name)
      : callMethodFunctionWithArgs(interpreter, method, receiver, evalArgsChecked(interpreter, env, children, 1))
  )
}

callMethodFunctionWithArgs(
  interpreter: Interpreter,
  method: IRFunction,
  receiver: RuntimeValue,
  args: EvalArgsResult
) -> EvalResult => (
  !args.ok ? errorResult(args.error)
    : callMethodFunction(interpreter, method, receiver, args.values)
)

callMethodFunction(
  interpreter: Interpreter,
  method: IRFunction,
  receiver: RuntimeValue,
  args: Array[RuntimeValue]
) -> EvalResult => {
  env := emptyEnv()
  envDefine(env, "this", receiver)
  bindArgs(env, method.params, args, 0)
  evalFunctionBody(interpreter, method, env)
}

evalSelector(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  receiverExpr := expr.children[0]
  enumLookup := enumMemberForUnboundReceiver(interpreter, env, receiverExpr, expr.name)
  (
    runtimeKind(enumLookup) == RuntimeValueKind.Enum ? okResult(enumLookup)
      : evalSelectorReceiver(interpreter, env, receiverExpr, expr.name)
  )
}

enumMemberForUnboundReceiver(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  name: String
) -> RuntimeValue => (
  receiverExpr.kind != ExprKind.Identifier ? emptyValue()
    : (
      envGet(env, receiverExpr.name).found ? emptyValue()
        : findEnumMember(interpreter, receiverExpr.name, name)
    )
)

evalSelectorReceiver(
  interpreter: Interpreter,
  env: RuntimeEnv,
  receiverExpr: IRExpr,
  name: String
) -> EvalResult => {
  receiver := evalExpr(interpreter, env, receiverExpr)
  (
    !receiver.ok ? receiver
      : (
        (isIteratorValue(receiver.value) && (name == "next")) ? okResult(iteratorNextValue(receiver.value))
          : (
        runtimeKind(receiver.value) == RuntimeValueKind.Struct ? selectField(receiver.value, name)
          : errorResult((("cannot select " + name) + " from ") + runtimeValueKindName(runtimeKind(receiver.value)))
          )
      )
  )
}

selectField(
  receiver: RuntimeValue,
  name: String
) -> EvalResult => {
  field := fieldLookup(runtimeFields(receiver), name, 0)
  (
    field.found ? okResult(field.value)
      : errorResult((("type " + runtimeTypeName(receiver)) + " has no field ") + name)
  )
}

evalIndex(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  receiver := evalExpr(interpreter, env, expr.children[0])
  index := (
    receiver.ok ? evalExpr(interpreter, env, expr.children[1])
      : receiver
  )
  (
    !receiver.ok ? receiver
      : (
        !index.ok ? index
          : indexValue(receiver.value, index.value)
      )
  )
}

indexValue(
  receiver: RuntimeValue,
  index: RuntimeValue
) -> EvalResult => (
  (runtimeKind(receiver) == RuntimeValueKind.Array) && (runtimeKind(index) == RuntimeValueKind.Int) ? indexArrayValue(runtimeArray(receiver), runtimeInt(index))
    : (
      (runtimeKind(receiver) == RuntimeValueKind.Tuple) && (runtimeKind(index) == RuntimeValueKind.Int) ? indexArrayValue(runtimeArray(receiver), runtimeInt(index))
        : (
          (runtimeKind(receiver) == RuntimeValueKind.String) && (runtimeKind(index) == RuntimeValueKind.Int) ? indexStringValue(runtimeText(receiver), runtimeInt(index))
            : (
              runtimeKind(receiver) == RuntimeValueKind.Map ? mapIndexValue(receiver, index)
                : errorResult(runtimeValueKindName(runtimeKind(receiver)) + " is not indexable")
            )
        )
    )
)

indexArrayValue(
  values: Array[RuntimeValue],
  index: Int
) -> EvalResult => (
  (index < 0) || (index >= values.length()) ? errorResult((("array index out of bounds: " + intToString(index)) + " length ") + intToString(values.length()))
    : okResult(values[index])
)

indexStringValue(
  text: String,
  index: Int
) -> EvalResult => (
  (index < 0) || (index >= text.length()) ? errorResult((("string index out of bounds: " + intToString(index)) + " length ") + intToString(text.length()))
    : okResult(charValue(text.at(index)))
)

mapIndexValue(
  receiver: RuntimeValue,
  index: RuntimeValue
) -> EvalResult => {
  idx := mapEntryIndex(runtimeEntries(receiver), index, 0)
  okResult((
    idx >= 0 ? runtimeEntries(receiver)[idx].value
      : nullValue()
  ))
}

evalArray(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => okResult(arrayValue(evalArrayElements(interpreter, env, expr.children, 0, [])))

evalArrayElements(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= children.length() ? out
    : evalArrayElement(interpreter, env, children, index, out)
)

evalArrayElement(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => {
  child := children[index]
  value := (
    child.kind == ExprKind.Spread ? evalExpr(interpreter, env, child.children[0])
      : evalExpr(interpreter, env, child)
  )
  evalArrayElements(interpreter, env, children, index + 1, appendArrayElement(out, child, value.value))
}

appendArrayElement(
  out: Array[RuntimeValue],
  child: IRExpr,
  value: RuntimeValue
) -> Array[RuntimeValue] => (
  (child.kind == ExprKind.Spread) && (runtimeKind(value) == RuntimeValueKind.Array) ? appendRuntimeArray(out, runtimeArray(value), 0)
    : pushRuntime(out, value)
)

appendRuntimeArray(
  out: Array[RuntimeValue],
  values: Array[RuntimeValue],
  index: Int
) -> Array[RuntimeValue] => (
  index >= values.length() ? out
    : appendRuntimeArray(pushRuntime(out, values[index]), values, index + 1)
)

evalTuple(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => okResult(tupleValue(evalArrayElements(interpreter, env, expr.children, 0, [])))

evalMap(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => okResult(mapValue(evalMapEntries(interpreter, env, expr.children, 0, [])))

evalMapEntries(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeEntry]
) -> Array[RuntimeEntry] => (
  index >= children.length() ? out
    : evalMapEntry(interpreter, env, children, index, out)
)

evalMapEntry(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeEntry]
) -> Array[RuntimeEntry] => {
  entry := children[index]
  key := evalExpr(interpreter, env, entry.children[0])
  value := evalExpr(interpreter, env, entry.children[1])
  evalMapEntries(interpreter, env, children, index + 1, pushEntry(out, RuntimeEntry {
    key: key.value,
    value: value.value
  }))
}

evalStructLiteral(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => okResult(structValue(expr.name, evalFields(interpreter, env, expr.children, 0, [])))

evalObjectLiteral(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  fields := [RuntimeField {
    name: "",
    value: emptyValue()
  }].slice(0, 0)
  object := structValue("Object", fields)
  objectEnv := envDefine(env, "this", object)
  finalObject := structValue("Object", fillObjectFields(interpreter, objectEnv, fields, expr.children, 0))
  envAssign(objectEnv, "this", finalObject)
  okResult(finalObject)
}

evalFields(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeField]
) -> Array[RuntimeField] => (
  index >= children.length() ? out
    : evalField(interpreter, env, children, index, out)
)

evalField(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  out: Array[RuntimeField]
) -> Array[RuntimeField] => {
  field := children[index]
  value := evalExpr(interpreter, env, field.children[0])
  evalFields(interpreter, env, children, index + 1, pushRuntimeField(out, RuntimeField {
    name: field.name,
    value: value.value
  }))
}

fillObjectFields(
  interpreter: Interpreter,
  env: RuntimeEnv,
  out: Array[RuntimeField],
  children: Array[IRExpr],
  index: Int
) -> Array[RuntimeField] => (
  index >= children.length() ? out
    : fillObjectField(interpreter, env, out, children, index)
)

fillObjectField(
  interpreter: Interpreter,
  env: RuntimeEnv,
  out: Array[RuntimeField],
  children: Array[IRExpr],
  index: Int
) -> Array[RuntimeField] => {
  field := children[index]
  value := (
    (field.kind == ExprKind.Method) || (field.kind == ExprKind.PrivateMethod) ? evalMethodLiteral(interpreter, env, field)
      : evalExpr(interpreter, env, field.children[0])
  )
  fillObjectFields(interpreter, env, pushRuntimeField(out, RuntimeField {
    name: field.name,
    value: value.value
  }), children, index + 1)
}

evalMethodLiteral(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  index := nextClosureIndex(interpreter)
  interpreter.closures[index] = RuntimeClosure {
    params: expr.params,
    body: expr.children[0],
    env: env
  }
  okResult(closureValue(index))
}

evalBlock(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => evalBlockLoop(interpreter, env, expr.children, 0, voidValue())

evalBlockLoop(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int,
  previous: RuntimeValue
) -> EvalResult => (
  index >= children.length() ? okResult(previous)
    : evalBlockNext(interpreter, env, children, index)
)

evalBlockNext(
  interpreter: Interpreter,
  env: RuntimeEnv,
  children: Array[IRExpr],
  index: Int
) -> EvalResult => {
  value := evalExpr(interpreter, env, children[index])
  (
    !value.ok ? value
      : evalBlockLoop(interpreter, env, children, index + 1, value.value)
  )
}

evalLet(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  value := evalExpr(interpreter, env, expr.children[0])
  (
    !value.ok ? value
      : okResult((
        (envDefine(env, expr.name, jsonDecodeLetValue(interpreter, value.value, expr.text)).bindingCount["count"] ?? 0) >= 0 ? voidValue()
          : voidValue()
      ))
  )
}

jsonDecodeLetValue(
  interpreter: Interpreter,
  value: RuntimeValue,
  typeName: String
) -> RuntimeValue => (
  (typeName != "") && (runtimeKind(value) == RuntimeValueKind.Map) ? jsonDecodeValue(interpreter, value, typeName)
    : value
)

evalObjectDestructure(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  value := evalExpr(interpreter, env, expr.children[0])
  (
    !value.ok ? value
      : (
        runtimeKind(value.value) != RuntimeValueKind.Struct ? errorResult("cannot destructure " + runtimeValueKindName(runtimeKind(value.value)))
          : destructureFields(env, value.value, expr.params, 0)
      )
  )
}

destructureFields(
  env: RuntimeEnv,
  value: RuntimeValue,
  params: Array[IRParam],
  index: Int
) -> EvalResult => (
  index >= params.length() ? okResult(voidValue())
    : destructureField(env, value, params, index)
)

destructureField(
  env: RuntimeEnv,
  value: RuntimeValue,
  params: Array[IRParam],
  index: Int
) -> EvalResult => {
  field := fieldLookup(runtimeFields(value), params[index].typeName, 0)
  (
    !field.found ? errorResult((("type " + runtimeTypeName(value)) + " has no field ") + params[index].typeName)
      : destructureFields(envDefine(env, params[index].name, field.value), value, params, index + 1)
  )
}

evalMatch(
  interpreter: Interpreter,
  env: RuntimeEnv,
  expr: IRExpr
) -> EvalResult => {
  subject := evalExpr(interpreter, env, expr.children[0])
  (
    !subject.ok ? subject
      : evalMatchBranch(interpreter, env, subject.value, expr.children, 1)
  )
}

evalMatchBranch(
  interpreter: Interpreter,
  env: RuntimeEnv,
  subject: RuntimeValue,
  children: Array[IRExpr],
  index: Int
) -> EvalResult => {
  matched := (
    index >= children.length() ? PatternMatchResult {
      matched: false,
      env: env
    }
      : matchPatternTextEnv(subject, children[index].children[0].text, envCopy(env))
  )
  (
    index >= children.length() ? errorResult("match expression was not exhaustive")
      : (
        matched.matched ? evalExpr(interpreter, matched.env, children[index].children[1])
          : evalMatchBranch(interpreter, env, subject, children, index + 1)
      )
  )
}

evalPatternBlockWithSubject(
  interpreter: Interpreter,
  env: RuntimeEnv,
  subject: RuntimeValue,
  block: IRExpr
) -> EvalResult => evalPatternBlockBranch(interpreter, env, subject, block.children, 0)

evalPatternBlockBranch(
  interpreter: Interpreter,
  env: RuntimeEnv,
  subject: RuntimeValue,
  children: Array[IRExpr],
  index: Int
) -> EvalResult => {
  matched := (
    index >= children.length() ? PatternMatchResult {
      matched: false,
      env: env
    }
      : matchPatternTextEnv(subject, children[index].children[0].text, envCopy(env))
  )
  (
    index >= children.length() ? errorResult("match expression was not exhaustive")
      : (
        matched.matched ? evalExpr(interpreter, matched.env, children[index].children[1])
          : evalPatternBlockBranch(interpreter, env, subject, children, index + 1)
      )
  )
}

envDefine(
  env: RuntimeEnv,
  name: String,
  value: RuntimeValue
) -> RuntimeEnv => {
  index := envBindingCount(env)
  env.bindings[index] = RuntimeBinding {
    name: name,
    value: value
  }
  env.bindingCount["count"] = index + 1
  env
}

envBindingCount(
  env: RuntimeEnv
) -> Int => env.bindingCount["count"] ?? 0

envGet(
  env: RuntimeEnv,
  name: String
) -> EnvLookup => envGetAt(env, name, envBindingCount(env) - 1)

envGetAt(
  env: RuntimeEnv,
  name: String,
  index: Int
) -> EnvLookup => (
  index < 0 ? EnvLookup {
    found: false,
    value: emptyValue()
  }
    : (
      (env.bindings[index] ?? emptyRuntimeBinding()).name == name ? EnvLookup {
        found: true,
        value: (env.bindings[index] ?? emptyRuntimeBinding()).value
      }
        : envGetAt(env, name, index - 1)
    )
)

emptyRuntimeBinding() -> RuntimeBinding => {
  name: "",
  value: emptyValue()
}

envCopy(
  env: RuntimeEnv
) -> RuntimeEnv => envCopyLoop(env, emptyEnv(), 0, envBindingCount(env))

envCopyLoop(
  env: RuntimeEnv,
  out: RuntimeEnv,
  index: Int,
  count: Int
) -> RuntimeEnv => (
  index >= count ? out
    : envCopyLoop(env, envCopyBinding(env, out, index), index + 1, count)
)

envCopyBinding(
  env: RuntimeEnv,
  out: RuntimeEnv,
  index: Int
) -> RuntimeEnv => {
  binding := env.bindings[index] ?? emptyRuntimeBinding()
  out.bindings[index] = binding
  out.bindingCount["count"] = index + 1
  out
}

envAssign(
  env: RuntimeEnv,
  name: String,
  value: RuntimeValue
) -> Bool => {
  index := envIndex(env, name, envBindingCount(env) - 1)
  (
    index < 0 ? false
      : envSet(env, index, name, value)
  )
}

envSet(
  env: RuntimeEnv,
  index: Int,
  name: String,
  value: RuntimeValue
) -> Bool => {
  env.bindings[index] = RuntimeBinding {
    name: name,
    value: value
  }
  true
}

envIndex(
  env: RuntimeEnv,
  name: String,
  index: Int
) -> Int => (
  index < 0 ? -1
    : (
      (env.bindings[index] ?? emptyRuntimeBinding()).name == name ? index
        : envIndex(env, name, index - 1)
    )
)

findFunction(
  interpreter: Interpreter,
  name: String
) -> IRFunction => findFunctionAt(interpreter.functions, name, 0)

findFunctionAt(
  functions: Array[IRFunction],
  name: String,
  index: Int
) -> IRFunction => (
  index >= functions.length() ? emptyIRFunction()
    : (
      functions[index].name == name ? functions[index]
        : findFunctionAt(functions, name, index + 1)
    )
)

findTest(
  interpreter: Interpreter,
  name: String
) -> IRTest => findTestAt(interpreter.file.tests, name, 0)

findTestAt(
  tests: Array[IRTest],
  name: String,
  index: Int
) -> IRTest => (
  index >= tests.length() ? IRTest {
    name: "",
    body: IRExpr {
      kind: ExprKind.Unknown,
      text: "",
      name: "",
      value: "",
      op: "",
      params: [],
      children: [],
      line: 0,
      column: 0
    },
    line: 0,
    column: 0
  }
    : (
      tests[index].name == name ? tests[index]
        : findTestAt(tests, name, index + 1)
    )
)

moduleNameFromAt(
  expr: IRExpr
) -> String => (
  expr.name != "" ? expr.name
    : moduleNameFromPath(decodeQuoted(expr.value))
)

moduleNameFromPath(
  path: String
) -> String => {
  parts := path.split("/")
  file := (
    parts.length() == 0 ? path
      : parts[parts.length() - 1]
  )
  (
    file.endsWith(".rn") ? file.slice(0, file.length() - 3)
      : file
  )
}

findStruct(
  interpreter: Interpreter,
  name: String
) -> IRStructType => findStructAt(interpreter.structs, name, 0)

findStructAt(
  structs: Array[IRStructType],
  name: String,
  index: Int
) -> IRStructType => (
  index >= structs.length() ? emptyIRStructType()
    : (
      structs[index].name == name ? structs[index]
        : findStructAt(structs, name, index + 1)
    )
)

findMethod(
  interpreter: Interpreter,
  typeName: String,
  name: String
) -> IRFunction => findMethodAt(findStruct(interpreter, typeName).methods, name, 0)

findMethodAt(
  methods: Array[IRFunction],
  name: String,
  index: Int
) -> IRFunction => (
  index >= methods.length() ? emptyIRFunction()
    : (
      methods[index].name == name ? methods[index]
        : findMethodAt(methods, name, index + 1)
    )
)

emptyIRStructType() -> IRStructType => {
  name: "",
  private: false,
  generics: [],
  fields: [],
  methods: [],
  line: 0,
  column: 0
}

findEnumMember(
  interpreter: Interpreter,
  typeName: String,
  memberName: String
) -> RuntimeValue => findEnumMemberAt(interpreter.enums, typeName, memberName, 0)

findEnumConstructor(
  interpreter: Interpreter,
  memberName: String
) -> EnumConstructorLookup => findEnumConstructorAt(interpreter.enums, memberName, 0, EnumConstructorLookup {
  found: false,
  typeName: "",
  member: emptyIREnumMember()
})

findEnumConstructorAt(
  enums: Array[IREnumType],
  memberName: String,
  index: Int,
  found: EnumConstructorLookup
) -> EnumConstructorLookup => (
  index >= enums.length() ? found
    : findEnumConstructorAt(enums, memberName, index + 1, findEnumConstructorInType(enums[index], memberName, 0, found))
)

findEnumConstructorInType(
  enumDecl: IREnumType,
  memberName: String,
  index: Int,
  found: EnumConstructorLookup
) -> EnumConstructorLookup => (
  index >= enumDecl.members.length() ? found
    : (
      enumDecl.members[index].name == memberName ? EnumConstructorLookup {
        found: true,
        typeName: enumDecl.name,
        member: enumDecl.members[index]
      }
        : findEnumConstructorInType(enumDecl, memberName, index + 1, found)
    )
)

emptyIREnumMember() -> IREnumMember => {
  name: "",
  private: false,
  value: "0",
  params: [],
  line: 0,
  column: 0
}

findEnumMemberAt(
  enums: Array[IREnumType],
  typeName: String,
  memberName: String,
  index: Int
) -> RuntimeValue => (
  index >= enums.length() ? emptyValue()
    : (
      enums[index].name == typeName ? findEnumTypeMember(enums[index], memberName, 0)
        : findEnumMemberAt(enums, typeName, memberName, index + 1)
    )
)

findEnumTypeMember(
  enumDecl: IREnumType,
  memberName: String,
  index: Int
) -> RuntimeValue => (
  index >= enumDecl.members.length() ? emptyValue()
    : (
      enumDecl.members[index].name == memberName ? enumValue(enumDecl.name, memberName, parseIntText(enumDecl.members[index].value))
        : findEnumTypeMember(enumDecl, memberName, index + 1)
    )
)

fieldLookup(
  fields: Array[RuntimeField],
  name: String,
  index: Int
) -> FieldLookup => (
  index >= fields.length() ? FieldLookup {
    found: false,
    value: emptyValue()
  }
    : (
      fields[index].name == name ? FieldLookup {
        found: true,
        value: fields[index].value
      }
        : fieldLookup(fields, name, index + 1)
    )
)

runtimeArrayContains(
  values: Array[RuntimeValue],
  value: RuntimeValue,
  index: Int
) -> Bool => (
  index >= values.length() ? false
    : (
      runtimeEqual(values[index], value) ? true
        : runtimeArrayContains(values, value, index + 1)
    )
)

runtimeEqual(
  left: RuntimeValue,
  right: RuntimeValue
) -> Bool => (
  runtimeKind(left) != runtimeKind(right) ? false
    : (
      runtimeKind(left) == RuntimeValueKind.Void ? true
        : (
          runtimeKind(left) == RuntimeValueKind.Null ? true
            : (
              runtimeKind(left) == RuntimeValueKind.Bool ? runtimeBool(left) == runtimeBool(right)
                : (
                  runtimeKind(left) == RuntimeValueKind.Int ? runtimeInt(left) == runtimeInt(right)
                    : (
                      runtimeKind(left) == RuntimeValueKind.Double ? runtimeDouble(left) == runtimeDouble(right)
                        : (
                          runtimeKind(left) == RuntimeValueKind.String ? (runtimeText(left) == runtimeText(right)) && (runtimeTypeName(left) == runtimeTypeName(right))
                            : (
                              runtimeKind(left) == RuntimeValueKind.Char ? runtimeChar(left) == runtimeChar(right)
                                : (
                                  runtimeKind(left) == RuntimeValueKind.Enum ? (runtimeTypeName(left) == runtimeTypeName(right)) && (runtimeText(left) == runtimeText(right))
                                    : (
                                      (runtimeKind(left) == RuntimeValueKind.Array) || (runtimeKind(left) == RuntimeValueKind.Tuple) ? runtimeArrayEqual(runtimeArray(left), runtimeArray(right), 0)
                                        : (
                                          runtimeKind(left) == RuntimeValueKind.Struct ? runtimeFieldsEqual(runtimeFields(left), runtimeFields(right), 0)
                                            : (
                                              (runtimeKind(left) == RuntimeValueKind.Map) || (runtimeKind(left) == RuntimeValueKind.Set) ? runtimeEntriesEqual(runtimeEntries(left), runtimeEntries(right), 0)
                                                : runtimeClosureIndex(left) == runtimeClosureIndex(right)
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

runtimeArrayEqual(
  left: Array[RuntimeValue],
  right: Array[RuntimeValue],
  index: Int
) -> Bool => (
  left.length() != right.length() ? false
    : (
      index >= left.length() ? true
        : (
          runtimeEqual(left[index], right[index]) ? runtimeArrayEqual(left, right, index + 1)
            : false
        )
    )
)

runtimeFieldsEqual(
  left: Array[RuntimeField],
  right: Array[RuntimeField],
  index: Int
) -> Bool => (
  left.length() != right.length() ? false
    : (
      index >= left.length() ? true
        : (
          (left[index].name == right[index].name) && runtimeEqual(left[index].value, right[index].value) ? runtimeFieldsEqual(left, right, index + 1)
            : false
        )
    )
)

runtimeEntriesEqual(
  left: Array[RuntimeEntry],
  right: Array[RuntimeEntry],
  index: Int
) -> Bool => (
  left.length() != right.length() ? false
    : (
      index >= left.length() ? true
        : (
          runtimeEqual(left[index].key, right[index].key) && runtimeEqual(left[index].value, right[index].value) ? runtimeEntriesEqual(left, right, index + 1)
            : false
        )
    )
)

runtimeValueKindName(
  kind: RuntimeValueKind
) -> String => kind {
  RuntimeValueKind.Void => "void"
  RuntimeValueKind.Null => "null"
  RuntimeValueKind.Bool => "bool"
  RuntimeValueKind.Int => "int"
  RuntimeValueKind.Double => "double"
  RuntimeValueKind.String => "string"
  RuntimeValueKind.Char => "char"
  RuntimeValueKind.Array => "array"
  RuntimeValueKind.Tuple => "tuple"
  RuntimeValueKind.Map => "map"
  RuntimeValueKind.Set => "set"
  RuntimeValueKind.Struct => "struct"
  RuntimeValueKind.Module => "module"
  RuntimeValueKind.Closure => "closure"
  RuntimeValueKind.Enum => "enum"
  _ => "unknown"
}

+ formatRuntimeValue(
  value: RuntimeValue
) -> String => (
  runtimeKind(value) == RuntimeValueKind.Void ? ""
    : (
      runtimeKind(value) == RuntimeValueKind.Null ? "null"
        : (
          runtimeKind(value) == RuntimeValueKind.Bool ? (
            runtimeBool(value) ? "true"
              : "false"
          )
            : (
              runtimeKind(value) == RuntimeValueKind.Int ? intToString(runtimeInt(value))
                : (
                  runtimeKind(value) == RuntimeValueKind.Double ? runtimeText(value)
                    : (
                      runtimeKind(value) == RuntimeValueKind.String ? formatRuntimeString(value)
                        : (
                          runtimeKind(value) == RuntimeValueKind.Char ? runtimeChar(value).toString()
                            : (
                              runtimeKind(value) == RuntimeValueKind.Array ? ("[" + formatValues(runtimeArray(value), 0, "")) + "]"
                                : (
                                  runtimeKind(value) == RuntimeValueKind.Tuple ? ("(" + formatValues(runtimeArray(value), 0, "")) + ")"
                                    : (
                                      runtimeKind(value) == RuntimeValueKind.Map ? ("Map {" + formatEntries(runtimeEntries(value), 0, "")) + "}"
                                        : (
                                          runtimeKind(value) == RuntimeValueKind.Set ? ("Set {" + formatEntries(runtimeEntries(value), 0, "")) + "}"
                                            : (
                                              runtimeKind(value) == RuntimeValueKind.Enum ? (runtimeTypeName(value) + ".") + runtimeText(value)
                                                : (
                                                  runtimeKind(value) == RuntimeValueKind.Struct ? ((runtimeTypeName(value) + " {") + formatFields(runtimeFields(value), 0, "")) + "}"
                                                    : runtimeValueKindName(runtimeKind(value))
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

joinRuntimeValues(
  values: Array[RuntimeValue],
  index: Int,
  out: String
) -> String => (
  index >= values.length() ? out
    : joinRuntimeValues(values, index + 1, (out + (
      index == 0 ? ""
        : " "
    )) + formatRuntimeValue(values[index]))
)

formatValues(
  values: Array[RuntimeValue],
  index: Int,
  out: String
) -> String => (
  index >= values.length() ? out
    : formatValues(values, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + formatRuntimeValue(values[index]))
)

formatFields(
  fields: Array[RuntimeField],
  index: Int,
  out: String
) -> String => (
  index >= fields.length() ? out
    : formatFields(fields, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + fields[index].name) + ": ") + formatRuntimeValue(fields[index].value))
)

formatEntries(
  entries: Array[RuntimeEntry],
  index: Int,
  out: String
) -> String => (
  index >= entries.length() ? out
    : formatEntries(entries, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + formatRuntimeValue(entries[index].key)) + ": ") + formatRuntimeValue(entries[index].value))
)

formatRuntimeString(
  value: RuntimeValue
) -> String => (
  isBigIntRuntime(value) ? formatRuntimeBigInt(runtimeText(value))
    : runtimeText(value)
)

formatRuntimeBigInt(
  text: String
) -> String => (
  text.endsWith("n") ? text
    : text + "n"
)

parseIntText(text: String) -> Int => (
  text.startsWith("-") ? 0 - parseUnsignedInt(text, 1, 0)
    : (
      text.startsWith("+") ? parseUnsignedInt(text, 1, 0)
        : parseUnsignedInt(text, 0, 0)
    )
)

intToString(value: Int) -> String => (
  value == 0 ? "0"
    : (
      value < 0 ? "-" + unsignedIntToString(0 - value, "")
        : unsignedIntToString(value, "")
    )
)

unsignedIntToString(
  value: Int,
  out: String
) -> String => (
  value <= 0 ? out
    : unsignedIntToString(value / 10, digitString(value % 10) + out)
)

digitString(value: Int) -> String => (
  value == 0 ? "0"
    : (
      value == 1 ? "1"
        : (
          value == 2 ? "2"
            : (
              value == 3 ? "3"
                : (
                  value == 4 ? "4"
                    : (
                      value == 5 ? "5"
                        : (
                          value == 6 ? "6"
                            : (
                              value == 7 ? "7"
                                : (
                                  value == 8 ? "8"
                                    : "9"
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

parseUnsignedInt(
  text: String,
  index: Int,
  out: Int
) -> Int => (
  index >= text.length() ? out
    : (
      isDigitChar(text.at(index)) ? parseUnsignedInt(text, index + 1, (out * 10) + digitValue(text.at(index)))
        : out
    )
)

parseDoubleText(text: String) -> Double => {
  expIndex := exponentIndex(text)
  baseText := (
    expIndex >= 0 ? text.slice(0, expIndex)
      : text
  )
  expText := (
    expIndex >= 0 ? text.slice(expIndex + 1, text.length())
      : "0"
  )
  scaleDouble(parseDecimalText(baseText), parseIntText(expText))
}

exponentIndex(text: String) -> Int => {
  lower := text.indexOf("e")
  (
    lower >= 0 ? lower
      : text.indexOf("E")
  )
}

parseDecimalText(text: String) -> Double => {
  dot := text.indexOf(".")
  (
    dot < 0 ? @int.toDouble(parseIntText(text))
      : (
        @int.toDouble(parseIntText(text.slice(0, dot))) + parseFractionText(text.slice(dot + 1, text.length()), 0, 0.0, 10.0)
      )
  )
}

parseFractionText(
  text: String,
  index: Int,
  out: Double,
  scale: Double
) -> Double => (
  index >= text.length() ? out
    : (
      isDigitChar(text.at(index)) ? parseFractionText(text, index + 1, out + (@int.toDouble(digitValue(text.at(index))) / scale), scale * 10.0)
        : out
    )
)

scaleDouble(
  value: Double,
  exponent: Int
) -> Double => (
  exponent == 0 ? value
    : (
      exponent > 0 ? scaleDouble(value * 10.0, exponent - 1)
        : scaleDouble(value / 10.0, exponent + 1)
    )
)

isDigitChar(ch: Char) -> Bool => (ch >= '0') && (ch <= '9')

digitValue(ch: Char) -> Int => (
  ch == '0' ? 0
    : (
      ch == '1' ? 1
        : (
          ch == '2' ? 2
            : (
              ch == '3' ? 3
                : (
                  ch == '4' ? 4
                    : (
                      ch == '5' ? 5
                        : (
                          ch == '6' ? 6
                            : (
                              ch == '7' ? 7
                                : (
                                  ch == '8' ? 8
                                    : 9
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

decodeQuoted(raw: String) -> String => (
  raw.length() >= 2 ? decodeEscapes(raw.slice(1, raw.length() - 1), 0, "")
    : raw
)

decodeTemplate(raw: String) -> String => (
  raw.length() >= 2 ? decodeEscapes(raw.slice(1, raw.length() - 1), 0, "")
    : raw
)

decodeEscapes(
  text: String,
  index: Int,
  out: String
) -> String => (
  index >= text.length() ? out
    : decodeEscapeStep(text, index, out)
)

decodeEscapeStep(
  text: String,
  index: Int,
  out: String
) -> String => {
  ch := text.at(index)
  (
    (ch == '\\') && ((index + 1) < text.length()) ? decodeEscapes(text, index + 2, out + escapedChar(text.at(index + 1)).toString())
      : decodeEscapes(text, index + 1, out + ch.toString())
  )
}

escapedChar(ch: Char) -> Char => (
  ch == 'n' ? '\n'
    : (
      ch == 't' ? '\t'
        : (
          ch == 'r' ? '\r'
            : (
              ch == '\\' ? '\\'
                : (
                  ch == '\'' ? '\''
                    : (
                      ch == '"' ? '"'
                        : ch
                    )
                )
            )
        )
    )
)

decodeCharLiteral(raw: String) -> Char => (
  raw.length() >= 3 ? (
    ((raw.at(1) == '\\') && (raw.length() >= 6)) && (raw.at(2) == 'x') ? escapedHexChar(raw.at(3), raw.at(4))
      : (
        (raw.at(1) == '\\') && (raw.length() >= 4) ? escapedChar(raw.at(2))
          : raw.at(1)
      )
  )
    : '\x00'
)

escapedHexChar(
  high: Char,
  low: Char
) -> Char => (
  (high == '0') && (low == '0') ? '\x00'
    : escapedChar(low)
)

exprLooksPatternPredicate(
  expr: IRExpr
) -> Bool => (
  expr.kind == ExprKind.Binary ? (
    expr.op == "|" ? exprLooksPatternPredicate(expr.children[0]) && exprLooksPatternPredicate(expr.children[1])
      : (
        expr.op == "..=" ? true
          : false
      )
  )
    : (((((expr.kind == ExprKind.Int) || (expr.kind == ExprKind.String)) || (expr.kind == ExprKind.Char)) || (expr.kind == ExprKind.Bool)) || (expr.kind == ExprKind.Null)) || ((expr.kind == ExprKind.Identifier) && (expr.name == "_"))
)

matchPredicateExpr(
  subject: RuntimeValue,
  expr: IRExpr
) -> Bool => (
  expr.kind == ExprKind.Binary ? (
    expr.op == "|" ? matchPredicateExpr(subject, expr.children[0]) || matchPredicateExpr(subject, expr.children[1])
      : (
        expr.op == "..=" ? matchRangePredicate(subject, expr.children[0], expr.children[1])
          : false
      )
  )
    : matchPatternValue(subject, literalPatternValue(expr))
)

matchRangePredicate(
  subject: RuntimeValue,
  left: IRExpr,
  right: IRExpr
) -> Bool => (
  ((runtimeKind(subject) == RuntimeValueKind.Char) && (left.kind == ExprKind.Char)) && (right.kind == ExprKind.Char) ? (runtimeChar(subject) >= decodeCharLiteral(left.value)) && (runtimeChar(subject) <= decodeCharLiteral(right.value))
    : (
      ((runtimeKind(subject) == RuntimeValueKind.Int) && (left.kind == ExprKind.Int)) && (right.kind == ExprKind.Int) ? (runtimeInt(subject) >= parseIntText(left.value)) && (runtimeInt(subject) <= parseIntText(right.value))
        : false
    )
)

literalPatternValue(
  expr: IRExpr
) -> RuntimeValue => (
  expr.kind == ExprKind.Int ? intValue(parseIntText(expr.value))
    : (
      expr.kind == ExprKind.String ? stringValue(decodeQuoted(expr.value))
        : (
          expr.kind == ExprKind.Char ? charValue(decodeCharLiteral(expr.value))
            : (
              expr.kind == ExprKind.Bool ? boolValue(expr.value == "true")
                : (
                  expr.kind == ExprKind.Null ? nullValue()
                    : emptyValue()
                )
            )
        )
    )
)

matchPatternValue(
  subject: RuntimeValue,
  pattern: RuntimeValue
) -> Bool => (
  runtimeKind(pattern) == RuntimeValueKind.Void ? false
    : runtimeEqual(subject, pattern)
)

matchPatternText(
  subject: RuntimeValue,
  text: String
) -> Bool => matchPatternTextEnv(subject, text, emptyEnv()).matched

matchPatternTextEnv(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => {
  pattern := stripGroupedOrPatternText(text.trim())
  (
    pattern == "_" ? patternMatched(env)
      : matchNonWildcardPatternText(subject, pattern, env)
  )
}

stripGroupedOrPatternText(
  text: String
) -> String => (
  (text.length() >= 2) && (text.at(0) == '(') && (text.at(text.length() - 1) == ')') && text.slice(1, text.length() - 1).includes("|") ? text.slice(1, text.length() - 1).trim()
    : text
)

matchNonWildcardPatternText(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => (
  text.startsWith("=") ? matchConstantPatternText(subject, text.slice(1, text.length()), env)
    : (
      isAsPatternText(text) ? matchAsPatternText(subject, text, env)
        : (
          isOrPatternText(text) ? matchOrPatternTextEnv(subject, text.split("|"), 0, env)
            : (
              isMapPatternText(text) ? matchMapPatternText(subject, text, env)
                : (
                  isArrayPatternText(text) ? matchArrayPatternText(subject, text, env)
                    : (
                      isRangePatternText(text) ? boolPatternResult(matchRangeText(subject, text), env)
                        : (
                          isConstructorPatternText(text) ? matchConstructorPatternText(subject, text, env)
                            : (
                              text.startsWith("\"") ? boolPatternResult(runtimeEqual(subject, stringValue(decodeQuoted(text))), env)
                                : (
                                  text.startsWith("'") ? boolPatternResult(runtimeEqual(subject, charValue(decodeCharLiteral(text))), env)
                                    : (
                                      text == "true" ? boolPatternResult(runtimeEqual(subject, boolValue(true)), env)
                                        : (
                                          text == "false" ? boolPatternResult(runtimeEqual(subject, boolValue(false)), env)
                                            : (
                                              text == "null" ? boolPatternResult(runtimeKind(subject) == RuntimeValueKind.Null, env)
                                                : (
                                                  matchEnumPatternText(subject, text) ? patternMatched(env)
                                                    : (
                                                      isIntText(text) ? boolPatternResult(runtimeEqual(subject, intValue(parseIntText(text))), env)
                                                        : matchBindingPatternText(subject, text, env)
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

matchConstantPatternText(
  subject: RuntimeValue,
  name: String,
  env: RuntimeEnv
) -> PatternMatchResult => {
  value := envGet(env, name)
  (
    value.found ? boolPatternResult(runtimeEqual(subject, value.value), env)
      : patternNotMatched(env)
  )
}

isMapPatternText(
  text: String
) -> Bool => text.startsWith("{") && text.endsWith("}") && text.includes(":")

matchMapPatternText(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => (
  runtimeKind(subject) == RuntimeValueKind.Map ? matchMapPatternEntries(subject, splitPatternArgs(text.slice(1, text.length() - 1)), 0, env)
    : (
      runtimeKind(subject) == RuntimeValueKind.Struct ? matchMapPatternStruct(subject, text, env)
        : patternNotMatched(env)
    )
)

matchMapPatternStruct(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => {
  entries := runtimeStructField(subject, "entries")
  (
    runtimeKind(entries) == RuntimeValueKind.Map ? matchMapPatternText(entries, text, env)
      : patternNotMatched(env)
  )
}

runtimeStructField(
  subject: RuntimeValue,
  name: String
) -> RuntimeValue => runtimeStructFieldAt(runtimeFields(subject), name, 0)

runtimeStructFieldAt(
  fields: Array[RuntimeField],
  name: String,
  index: Int
) -> RuntimeValue => (
  index >= fields.length() ? voidValue()
    : (
      fields[index].name == name ? fields[index].value
        : runtimeStructFieldAt(fields, name, index + 1)
    )
)

matchMapPatternEntries(
  subject: RuntimeValue,
  parts: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  index >= parts.length() ? patternMatched(env)
    : (
      parts[index].trim() == ".." ? matchMapPatternEntries(subject, parts, index + 1, env)
        : matchMapPatternEntry(subject, parts, index, env)
    )
)

matchMapPatternEntry(
  subject: RuntimeValue,
  parts: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  entry := parts[index]
  colon := entry.indexOf(":")
  keyText := entry.slice(0, colon).trim()
  valuePattern := entry.slice(colon + 1, entry.length()).trim()
  optional := keyText.endsWith("?")
  rawKey := (
    optional ? keyText.slice(0, keyText.length() - 1).trim()
      : keyText
  )
  key := patternKeyValue(rawKey, env)
  found := mapEntryIndex(runtimeEntries(subject), key, 0)
  (
    found < 0 ? (
      optional ? matchMapPatternEntryValue(subject, parts, index, nullValue(), valuePattern, env)
        : patternNotMatched(env)
    )
      : matchMapPatternEntryValue(subject, parts, index, runtimeEntries(subject)[found].value, valuePattern, env)
  )
}

matchMapPatternEntryValue(
  subject: RuntimeValue,
  parts: Array[String],
  index: Int,
  value: RuntimeValue,
  valuePattern: String,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchPatternTextEnv(value, valuePattern, env)
  (
    matched.matched ? matchMapPatternEntries(subject, parts, index + 1, matched.env)
      : matched
  )
}

patternKeyValue(
  text: String,
  env: RuntimeEnv
) -> RuntimeValue => (
  text.startsWith("=") ? (envGet(env, text.slice(1, text.length())).value)
    : (
      text.startsWith("\"") ? stringValue(decodeQuoted(text))
        : (
          text.startsWith("'") ? charValue(decodeCharLiteral(text))
            : (
              isIntText(text) ? intValue(parseIntText(text))
                : stringValue(text)
            )
        )
    )
)

patternMatched(
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched: true,
  env: env
}

patternNotMatched(
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched: false,
  env: env
}

boolPatternResult(
  matched: Bool,
  env: RuntimeEnv
) -> PatternMatchResult => (
  matched ? patternMatched(env)
    : patternNotMatched(env)
)

matchBindingPatternText(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => (
  isBindingPatternText(text) ? patternMatched(envDefine(env, text, subject))
    : patternNotMatched(env)
)

matchOrPatternText(
  subject: RuntimeValue,
  parts: Array[String],
  index: Int
) -> Bool => (
  index >= parts.length() ? false
    : (
      matchPatternText(subject, parts[index].trim()) ? true
        : matchOrPatternText(subject, parts, index + 1)
    )
)

matchOrPatternTextEnv(
  subject: RuntimeValue,
  parts: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := (
    index >= parts.length() ? patternNotMatched(env)
      : matchPatternTextEnv(subject, parts[index].trim(), envCopy(env))
  )
  (
    matched.matched ? matched
      : (
        index >= parts.length() ? matched
          : matchOrPatternTextEnv(subject, parts, index + 1, env)
      )
  )
}

isOrPatternText(
  text: String
) -> Bool => text.includes("|") && !isQuotedPatternText(text)

isQuotedPatternText(
  text: String
) -> Bool => (
  text.length() < 2 ? false
    : (
      text.startsWith("\"") ? quotedPatternEndsAt(text, '"', 1) == (text.length() - 1)
        : (
          text.startsWith("'") ? quotedPatternEndsAt(text, '\'', 1) == (text.length() - 1)
            : false
        )
    )
)

quotedPatternEndsAt(
  text: String,
  quote: Char,
  index: Int
) -> Int => (
  index >= text.length() ? -1
    : (
      text.at(index) == '\\' ? quotedPatternEndsAt(text, quote, index + 2)
        : (
          text.at(index) == quote ? index
            : quotedPatternEndsAt(text, quote, index + 1)
        )
    )
)

isAsPatternText(
  text: String
) -> Bool => topLevelAsIndex(text, 0, 0, '\x00') >= 0

topLevelAsIndex(
  text: String,
  index: Int,
  depth: Int,
  quote: Char
) -> Int => (
  index >= text.length() ? -1
    : topLevelAsIndexStep(text, index, depth, quote)
)

topLevelAsIndexStep(
  text: String,
  index: Int,
  depth: Int,
  quote: Char
) -> Int => {
  ch := text.at(index)
  (
    quote != '\x00' ? (
      ch == '\\' ? topLevelAsIndex(text, index + 2, depth, quote)
        : (
          ch == quote ? topLevelAsIndex(text, index + 1, depth, '\x00')
            : topLevelAsIndex(text, index + 1, depth, quote)
        )
    )
      : (
        ((depth == 0) && startsWithAt(text, index, " as ")) ? index
          : (
            (ch == '"') || (ch == '\'') ? topLevelAsIndex(text, index + 1, depth, ch)
              : (
                isPatternOpenChar(ch) ? topLevelAsIndex(text, index + 1, depth + 1, '\x00')
                  : (
                    isPatternCloseChar(ch) ? topLevelAsIndex(text, index + 1, depth - 1, '\x00')
                      : topLevelAsIndex(text, index + 1, depth, '\x00')
                  )
              )
          )
      )
  )
}

startsWithAt(
  text: String,
  index: Int,
  needle: String
) -> Bool => (
  (index + needle.length()) > text.length() ? false
    : text.slice(index, index + needle.length()) == needle
)

matchAsPatternText(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => {
  index := topLevelAsIndex(text, 0, 0, '\x00')
  matched := matchPatternTextEnv(subject, text.slice(0, index).trim(), env)
  (
    matched.matched ? patternMatched(envDefine(matched.env, text.slice(index + 4, text.length()).trim(), subject))
      : matched
  )
}

isArrayPatternText(
  text: String
) -> Bool => text.startsWith("[") && text.endsWith("]")

matchArrayPatternText(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => {
  parts := splitPatternArgs(text.slice(1, text.length() - 1))
  (
    isBitArrayPatternText(parts) ? matchBitArrayPatternText(subject, parts, env)
      : (
    runtimeKind(subject) == RuntimeValueKind.Array ? matchArrayParts(runtimeArray(subject), parts, env)
      : (
        isBytesValue(subject) ? matchBytesArrayParts(subject, parts, env)
          : (
            runtimeKind(subject) == RuntimeValueKind.String ? matchStringArrayParts(runtimeText(subject), parts, env)
              : patternNotMatched(env)
          )
      )
      )
  )
}

matchArrayParts(
  values: Array[RuntimeValue],
  parts: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => {
  rest := restPatternIndex(parts, 0)
  (
    isArrayContainsPattern(parts) ? boolPatternResult(arrayContainsSequence(values, sequencePatternValues(parts[0], env), 0), env)
      : (
        rest < 0 ? matchArrayPartsExact(values, parts, 0, env)
          : matchArrayPartsWithRest(values, parts, rest, env)
      )
  )
}

matchBytesArrayParts(
  subject: RuntimeValue,
  parts: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => {
  data := runtimeBytes(subject)
  rest := restPatternIndex(parts, 0)
  (
    isArrayContainsPattern(parts) ? boolPatternResult(arrayContainsSequence(data, runtimeBytes(sequencePatternRuntimeValue(parts[0], env)), 0), env)
      : (
        rest < 0 ? matchArrayPartsExact(data, parts, 0, env)
          : matchBytesArrayPartsWithRest(subject, data, parts, rest, env)
      )
  )
}

matchBytesArrayPartsWithRest(
  subject: RuntimeValue,
  values: Array[RuntimeValue],
  parts: Array[String],
  rest: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  suffix := parts.length() - rest - 1
  restLen := values.length() - rest - suffix
  (
    restLen < 0 ? patternNotMatched(env)
      : matchBytesArrayPrefix(subject, values, parts, 0, rest, restLen, env)
  )
}

matchBytesArrayPrefix(
  subject: RuntimeValue,
  values: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  index >= rest ? matchBytesArrayRest(subject, values, parts, rest, restLen, env)
    : matchBytesArrayPrefixPart(subject, values, parts, index, rest, restLen, env)
)

matchBytesArrayPrefixPart(
  subject: RuntimeValue,
  values: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchPatternTextEnv(values[index], parts[index].trim(), env)
  (
    matched.matched ? matchBytesArrayPrefix(subject, values, parts, index + 1, rest, restLen, matched.env)
      : matched
  )
}

matchBytesArrayRest(
  subject: RuntimeValue,
  values: Array[RuntimeValue],
  parts: Array[String],
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  binding := restPatternBinding(parts[rest])
  nextEnv := (
    binding == "" ? env
      : envDefine(env, binding, bytesValue(values.slice(rest, rest + restLen)))
  )
  matchBytesArraySuffix(subject, values, parts, rest + 1, rest, restLen, nextEnv)
}

matchBytesArraySuffix(
  subject: RuntimeValue,
  values: Array[RuntimeValue],
  parts: Array[String],
  partIndex: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  partIndex >= parts.length() ? patternMatched(env)
    : matchBytesArraySuffixPart(subject, values, parts, partIndex, rest, restLen, env)
)

matchBytesArraySuffixPart(
  subject: RuntimeValue,
  values: Array[RuntimeValue],
  parts: Array[String],
  partIndex: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  valueIndex := rest + restLen + (partIndex - rest - 1)
  matched := matchPatternTextEnv(values[valueIndex], parts[partIndex].trim(), env)
  (
    matched.matched ? matchBytesArraySuffix(subject, values, parts, partIndex + 1, rest, restLen, matched.env)
      : matched
  )
}

isArrayContainsPattern(parts: Array[String]) -> Bool => (
  parts.length() == 2 ? isSequenceSpreadPattern(parts[0]) && (parts[1].trim() == "..")
    : false
)

sequencePatternRuntimeValue(
  text: String,
  env: RuntimeEnv
) -> RuntimeValue => {
  raw := sequenceSpreadValue(text)
  found := envGet(env, raw)
  (
    found.found ? found.value
      : (
        raw.startsWith("=") ? envGet(env, raw.slice(1, raw.length())).value
          : (
            raw.startsWith("\"") ? stringValue(decodeQuoted(raw))
              : arrayValue([])
          )
      )
  )
}

sequencePatternValues(
  text: String,
  env: RuntimeEnv
) -> Array[RuntimeValue] => {
  value := sequencePatternRuntimeValue(text, env)
  (
    runtimeKind(value) == RuntimeValueKind.Array ? runtimeArray(value)
      : (
        isBytesValue(value) ? runtimeBytes(value)
          : emptyRuntimeArray()
      )
  )
}

arrayContainsSequence(
  values: Array[RuntimeValue],
  needle: Array[RuntimeValue],
  index: Int
) -> Bool => (
  needle.length() == 0 ? true
    : (
      (index + needle.length()) > values.length() ? false
        : (
          arraySequenceEqualAt(values, needle, index, 0) ? true
            : arrayContainsSequence(values, needle, index + 1)
        )
    )
)

arraySequenceEqualAt(
  values: Array[RuntimeValue],
  needle: Array[RuntimeValue],
  index: Int,
  offset: Int
) -> Bool => (
  offset >= needle.length() ? true
    : (
      runtimeEqual(values[index + offset], needle[offset]) ? arraySequenceEqualAt(values, needle, index, offset + 1)
        : false
    )
)

isBitArrayPatternText(
  parts: Array[String]
) -> Bool => isBitArrayPatternTextLoop(parts, 0)

isBitArrayPatternTextLoop(
  parts: Array[String],
  index: Int
) -> Bool => (
  index >= parts.length() ? false
    : (
      isBitPatternText(parts[index]) ? true
        : isBitArrayPatternTextLoop(parts, index + 1)
    )
)

isBitPatternText(text: String) -> Bool => {
  name := bitPatternName(text)
  bitPatternWidth(name) > 0
}

bitPatternName(text: String) -> String => {
  open := text.indexOf("(")
  (
    open < 0 ? ""
      : text.slice(0, open).trim()
  )
}

bitPatternArg(text: String) -> String => {
  open := text.indexOf("(")
  (
    (open < 0) || !text.endsWith(")") ? ""
      : text.slice(open + 1, text.length() - 1).trim()
  )
}

bitPatternSigned(name: String) -> Bool => name.startsWith("i")

bitPatternLittleEndian(name: String) -> Bool => name.endsWith("le")

bitPatternWidth(name: String) -> Int => {
  clean := (
    name.endsWith("be") || name.endsWith("le") ? name.slice(1, name.length() - 2)
      : ""
  )
  (
    (name.startsWith("u") || name.startsWith("i")) && isIntText(clean) ? parseIntText(clean)
      : 0
  )
}

matchBitArrayPatternText(
  subject: RuntimeValue,
  parts: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => {
  data := (
    isBytesValue(subject) ? runtimeBytes(subject)
      : runtimeArray(subject)
  )
  requiredBits := bitPatternRequiredBits(parts, 0, restPatternIndex(parts, 0), 0)
  (
    restPatternIndex(parts, 0) >= 0 ? (
      (data.length() * 8) < requiredBits ? patternNotMatched(env)
        : matchBitArrayPatternParts(subject, data, parts, 0, 0, env)
    )
      : (
        (data.length() * 8) != requiredBits ? patternNotMatched(env)
          : matchBitArrayPatternParts(subject, data, parts, 0, 0, env)
      )
  )
}

bitPatternRequiredBits(
  parts: Array[String],
  index: Int,
  rest: Int,
  out: Int
) -> Int => (
  index >= parts.length() ? out
    : (
      (rest >= 0) && (index >= rest) ? bitPatternRequiredBits(parts, index + 1, rest, out)
        : bitPatternRequiredBits(parts, index + 1, rest, out + bitPatternWidth(bitPatternName(parts[index].trim())))
    )
)

matchBitArrayPatternParts(
  subject: RuntimeValue,
  data: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  bitOffset: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  rest := restPatternIndex(parts, 0)
  (
    index >= parts.length() ? bindBitRest(subject, data, parts, rest, env)
      : (
        rest >= 0 && index >= rest ? matchBitArrayPatternPart(subject, data, parts, index, (data.length() * 8) - bitPatternTailWidth(parts, index, 0), env)
          : matchBitArrayPatternPart(subject, data, parts, index, bitOffset, env)
      )
  )
}

matchBitArrayPatternPart(
  subject: RuntimeValue,
  data: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  bitOffset: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  part := parts[index].trim()
  (
    part.startsWith("..") ? matchBitArrayPatternParts(subject, data, parts, index + 1, bitOffset, env)
      : matchBitValuePart(subject, data, parts, index, bitOffset, env)
  )
}

matchBitValuePart(
  subject: RuntimeValue,
  data: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  bitOffset: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  part := parts[index].trim()
  name := bitPatternName(part)
  width := bitPatternWidth(name)
  raw := readBits(data, bitOffset, width, bitPatternLittleEndian(name))
  value := bitPatternRuntimeValue(raw, width, bitPatternSigned(name), name)
  matched := matchPatternTextEnv(value, bitPatternArg(part), env)
  (
    matched.matched ? matchBitArrayPatternParts(subject, data, parts, index + 1, bitOffset + width, matched.env)
      : matched
  )
}

bindBitRest(
  subject: RuntimeValue,
  data: Array[RuntimeValue],
  parts: Array[String],
  rest: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  rest < 0 ? patternMatched(env)
    : bindBitRestValue(subject, data, parts, rest, env)
)

bindBitRestValue(
  subject: RuntimeValue,
  data: Array[RuntimeValue],
  parts: Array[String],
  rest: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  requiredBits := bitPatternRequiredBits(parts, 0, rest, 0)
  binding := restPatternBinding(parts[rest])
  (
    binding == "" ? patternMatched(env)
      : (
        (requiredBits % 8) != 0 ? patternNotMatched(env)
          : patternMatched(envDefine(env, binding, bytesValue(data.slice(requiredBits / 8, data.length()))))
      )
  )
}

bitPatternTailWidth(
  parts: Array[String],
  index: Int,
  out: Int
) -> Int => (
  index >= parts.length() ? out
    : bitPatternTailWidth(parts, index + 1, out + bitPatternWidth(bitPatternName(parts[index].trim())))
)

readBits(
  data: Array[RuntimeValue],
  offset: Int,
  width: Int,
  littleEndian: Bool
) -> Int => (
  littleEndian && ((offset % 8) == 0) && ((width % 8) == 0) ? readLittleEndianBits(data, offset / 8, width / 8, 0, 0)
    : readBigEndianBits(data, offset, width, 0, 0)
)

readLittleEndianBits(
  data: Array[RuntimeValue],
  start: Int,
  count: Int,
  index: Int,
  out: Int
) -> Int => (
  index >= count ? out
    : readLittleEndianBits(data, start, count, index + 1, out + (runtimeInt(data[start + index]) * pow2(8 * index)))
)

readBigEndianBits(
  data: Array[RuntimeValue],
  offset: Int,
  width: Int,
  index: Int,
  out: Int
) -> Int => (
  index >= width ? out
    : readBigEndianBits(data, offset, width, index + 1, (out * 2) + bitAt(data, offset + index))
)

bitAt(
  data: Array[RuntimeValue],
  bitIndex: Int
) -> Int => (runtimeInt(data[bitIndex / 8]) / pow2(7 - (bitIndex % 8))) % 2

pow2(
  exp: Int
) -> Int => (
  exp <= 0 ? 1
    : 2 * pow2(exp - 1)
)

bitPatternRuntimeValue(
  raw: Int,
  width: Int,
  signed: Bool,
  name: String
) -> RuntimeValue => (
  signed ? intValue(signExtendBits(raw, width))
    : typedIntValue(raw, bitPatternUnsignedType(name))
)

signExtendBits(
  raw: Int,
  width: Int
) -> Int => {
  sign := pow2(width - 1)
  (
    (raw / sign) % 2 != 0 ? raw - pow2(width)
      : raw
  )
}

bitPatternUnsignedType(name: String) -> String => (
  bitPatternWidth(name) <= 8 ? "UInt8"
    : (
      bitPatternWidth(name) <= 16 ? "UInt16"
        : "UInt"
    )
)

matchArrayPartsExact(
  values: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  values.length() != parts.length() ? patternNotMatched(env)
    : (
      index >= parts.length() ? patternMatched(env)
        : matchArrayPartThen(values, parts, index, env)
    )
)

matchArrayPartThen(
  values: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchPatternTextEnv(values[index], parts[index].trim(), env)
  (
    matched.matched ? matchArrayPartsExact(values, parts, index + 1, matched.env)
      : matched
  )
}

matchArrayPartsWithRest(
  values: Array[RuntimeValue],
  parts: Array[String],
  rest: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  suffix := parts.length() - rest - 1
  restLen := values.length() - rest - suffix
  (
    restLen < 0 ? patternNotMatched(env)
      : matchArrayPrefix(values, parts, 0, rest, restLen, env)
  )
}

matchArrayPrefix(
  values: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  index >= rest ? matchArrayRest(values, parts, rest, restLen, env)
    : matchArrayPrefixPart(values, parts, index, rest, restLen, env)
)

matchArrayPrefixPart(
  values: Array[RuntimeValue],
  parts: Array[String],
  index: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchPatternTextEnv(values[index], parts[index].trim(), env)
  (
    matched.matched ? matchArrayPrefix(values, parts, index + 1, rest, restLen, matched.env)
      : matched
  )
}

matchArrayRest(
  values: Array[RuntimeValue],
  parts: Array[String],
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  binding := restPatternBinding(parts[rest])
  nextEnv := (
    binding == "" ? env
      : envDefine(env, binding, arrayValue(values.slice(rest, rest + restLen)))
  )
  matchArraySuffix(values, parts, rest + 1, rest, restLen, nextEnv)
}

matchArraySuffix(
  values: Array[RuntimeValue],
  parts: Array[String],
  partIndex: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  partIndex >= parts.length() ? patternMatched(env)
    : matchArraySuffixPart(values, parts, partIndex, rest, restLen, env)
)

matchArraySuffixPart(
  values: Array[RuntimeValue],
  parts: Array[String],
  partIndex: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  valueIndex := rest + restLen + (partIndex - rest - 1)
  matched := matchPatternTextEnv(values[valueIndex], parts[partIndex].trim(), env)
  (
    matched.matched ? matchArraySuffix(values, parts, partIndex + 1, rest, restLen, matched.env)
      : matched
  )
}

matchStringArrayParts(
  value: String,
  parts: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => {
  rest := restPatternIndex(parts, 0)
  (
    isStringContainsPattern(parts) ? boolPatternResult(value.includes(decodeQuoted(sequenceSpreadValue(parts[0]))), env)
      : rest < 0 ? matchStringPartsExact(value, parts, 0, env)
      : matchStringPartsWithRest(value, parts, rest, env)
  )
}

isStringContainsPattern(
  parts: Array[String]
) -> Bool => (
  parts.length() == 2 ? isSequenceSpreadPattern(parts[0]) && (parts[1].trim() == "..")
    : false
)

isSequenceSpreadPattern(
  text: String
) -> Bool => {
  part := text.trim()
  part.startsWith(".. ") || ((part.length() > 2) && (part.slice(0, 2) == "..") && part.slice(2, part.length()).trim().startsWith("\""))
}

sequenceSpreadValue(
  text: String
) -> String => text.trim().slice(2, text.trim().length()).trim()

matchStringPartsExact(
  value: String,
  parts: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  value.length() != parts.length() ? patternNotMatched(env)
    : (
      index >= parts.length() ? patternMatched(env)
        : matchStringPartThen(value, parts, index, env)
    )
)

matchStringPartThen(
  value: String,
  parts: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchPatternTextEnv(charValue(value.at(index)), parts[index].trim(), env)
  (
    matched.matched ? matchStringPartsExact(value, parts, index + 1, matched.env)
      : matched
  )
}

matchStringPartsWithRest(
  value: String,
  parts: Array[String],
  rest: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  suffix := parts.length() - rest - 1
  restLen := value.length() - rest - suffix
  (
    restLen < 0 ? patternNotMatched(env)
      : matchStringPrefix(value, parts, 0, rest, restLen, env)
  )
}

matchStringPrefix(
  value: String,
  parts: Array[String],
  index: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  index >= rest ? matchStringRest(value, parts, rest, restLen, env)
    : matchStringPrefixPart(value, parts, index, rest, restLen, env)
)

matchStringPrefixPart(
  value: String,
  parts: Array[String],
  index: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchPatternTextEnv(charValue(value.at(index)), parts[index].trim(), env)
  (
    matched.matched ? matchStringPrefix(value, parts, index + 1, rest, restLen, matched.env)
      : matched
  )
}

matchStringRest(
  value: String,
  parts: Array[String],
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  binding := restPatternBinding(parts[rest])
  nextEnv := (
    binding == "" ? env
      : envDefine(env, binding, stringValue(value.slice(rest, rest + restLen)))
  )
  matchStringSuffix(value, parts, rest + 1, rest, restLen, nextEnv)
}

matchStringSuffix(
  value: String,
  parts: Array[String],
  partIndex: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  partIndex >= parts.length() ? patternMatched(env)
    : matchStringSuffixPart(value, parts, partIndex, rest, restLen, env)
)

matchStringSuffixPart(
  value: String,
  parts: Array[String],
  partIndex: Int,
  rest: Int,
  restLen: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  valueIndex := rest + restLen + (partIndex - rest - 1)
  matched := matchPatternTextEnv(charValue(value.at(valueIndex)), parts[partIndex].trim(), env)
  (
    matched.matched ? matchStringSuffix(value, parts, partIndex + 1, rest, restLen, matched.env)
      : matched
  )
}

restPatternIndex(
  parts: Array[String],
  index: Int
) -> Int => (
  index >= parts.length() ? -1
    : (
      parts[index].trim().startsWith("..") && ((index == (parts.length() - 1)) || !isSequenceSpreadPattern(parts[index])) ? index
        : restPatternIndex(parts, index + 1)
    )
)

restPatternBinding(
  text: String
) -> String => {
  part := text.trim()
  (
    part.length() <= 2 ? ""
      : part.slice(2, part.length()).trim()
  )
}

isConstructorPatternText(
  text: String
) -> Bool => {
  open := text.indexOf("(")
  (open > 0) && text.endsWith(")")
}

matchConstructorPatternText(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => {
  open := text.indexOf("(")
  name := text.slice(0, open)
  args := splitPatternArgs(text.slice(open + 1, text.length() - 1))
  (
    runtimeKind(subject) == RuntimeValueKind.Enum ? matchEnumConstructorPatternText(subject, name, args, env)
      : (
        isJsonConstructorPatternName(name) ? matchJsonConstructorPatternText(subject, name, args, env)
          : (
            runtimeValueConstructorName(subject) != name ? patternNotMatched(env)
              : matchRuntimeValueConstructorArgs(subject, args, 0, env)
          )
      )
  )
}

isJsonConstructorPatternName(name: String) -> Bool => ((((name == "Array") || (name == "Object")) || (name == "String")) || ((name == "Bool") || (name == "Number"))) || (name == "Null")

matchJsonConstructorPatternText(
  subject: RuntimeValue,
  name: String,
  args: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => name {
  "Number" => matchJsonNumberConstructorPattern(subject, args, env)
  "Object" => (
    runtimeKind(subject) == RuntimeValueKind.Map ? matchJsonConstructorArgs(arrayValue([subject]), args, env)
      : patternNotMatched(env)
  )
  _ => (
    runtimeValueConstructorName(subject) != name ? patternNotMatched(env)
      : matchRuntimeValueConstructorArgs(subject, args, 0, env)
  )
}

matchJsonNumberConstructorPattern(
  subject: RuntimeValue,
  args: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => (
  (runtimeKind(subject) != RuntimeValueKind.Int) && (runtimeKind(subject) != RuntimeValueKind.Double) ? patternNotMatched(env)
    : matchJsonConstructorArgs(arrayValue([subject]), args, env)
)

matchJsonConstructorArgs(
  payload: RuntimeValue,
  args: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => (
  enumPayloadArgsRest(args) ? matchEnumPayloadRest(runtimeArray(payload), args, env)
    : (
      runtimeArray(payload).length() != args.length() ? patternNotMatched(env)
        : matchEnumPayloadArgs(runtimeArray(payload), args, 0, env)
    )
)

matchEnumConstructorPatternText(
  subject: RuntimeValue,
  name: String,
  args: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => (
  runtimeText(subject) != name ? patternNotMatched(env)
    : matchEnumPayloadArgs(runtimeArray(subject), args, 0, env)
)

matchEnumPayloadArgs(
  payload: Array[RuntimeValue],
  args: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  enumPayloadArgsRest(args) ? matchEnumPayloadRest(payload, args, env)
    : (
      payload.length() != args.length() ? patternNotMatched(env)
        : (
          index >= args.length() ? patternMatched(env)
            : matchEnumPayloadArg(payload, args, index, env)
        )
    )
)

enumPayloadArgsRest(
  args: Array[String]
) -> Bool => (args.length() > 0) && args[args.length() - 1].trim().startsWith("..")

matchEnumPayloadRest(
  payload: Array[RuntimeValue],
  args: Array[String],
  env: RuntimeEnv
) -> PatternMatchResult => (
  payload.length() < (args.length() - 1) ? patternNotMatched(env)
    : (
      restPatternBinding(args[args.length() - 1]) == "" ? matchEnumPayloadArgsPrefix(payload, args, 0, env)
        : matchEnumPayloadArgsPrefix(payload, args, 0, envDefine(env, restPatternBinding(args[args.length() - 1]), arrayValue(payload.slice(args.length() - 1, payload.length()))))
    )
)

matchEnumPayloadArgsPrefix(
  payload: Array[RuntimeValue],
  args: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  index >= (args.length() - 1) ? patternMatched(env)
    : matchEnumPayloadArg(payload, args, index, env)
)

matchEnumPayloadArg(
  payload: Array[RuntimeValue],
  args: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchPatternTextEnv(payload[index], args[index].trim(), env)
  (
    matched.matched ? (
      enumPayloadArgsRest(args) ? matchEnumPayloadArgsPrefix(payload, args, index + 1, matched.env)
        : matchEnumPayloadArgs(payload, args, index + 1, matched.env)
    )
      : matched
  )
}

matchRuntimeValueConstructorArgs(
  subject: RuntimeValue,
  args: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => (
  args.length() != runtimeValuePayloadLength(subject) ? patternNotMatched(env)
    : (
      index >= args.length() ? patternMatched(env)
        : matchRuntimeValueConstructorArg(subject, args, index, env)
    )
)

matchRuntimeValueConstructorArg(
  subject: RuntimeValue,
  args: Array[String],
  index: Int,
  env: RuntimeEnv
) -> PatternMatchResult => {
  matched := matchRuntimePatternAtom(runtimeValuePayloadAt(subject, index), args[index].trim(), env)
  (
    matched.matched ? matchRuntimeValueConstructorArgs(subject, args, index + 1, matched.env)
      : matched
  )
}

matchRuntimePatternAtom(
  subject: RuntimeValue,
  text: String,
  env: RuntimeEnv
) -> PatternMatchResult => matchPatternTextEnv(subject, text, env)

runtimeValueConstructorName(
  value: RuntimeValue
) -> String => value {
  Void => "Void"
  Null => "Null"
  Bool(raw) => "Bool"
  Int(raw, typeName) => "Int"
  Double(raw, text, typeName) => "Double"
  String(raw, typeName) => "String"
  Char(raw) => "Char"
  Array(values) => "Array"
  Tuple(values) => "Tuple"
  Map(entries) => "Map"
  Set(entries) => "Set"
  Struct(typeName, fields) => "Struct"
  Module(name) => "Module"
  Closure(index) => "Closure"
  Enum(typeName, name, raw, payload) => "Enum"
}

runtimeValuePayloadLength(
  value: RuntimeValue
) -> Int => value {
  Void => 0
  Null => 0
  Bool(raw) => 1
  Int(raw, typeName) => 2
  Double(raw, text, typeName) => 3
  String(raw, typeName) => 2
  Char(raw) => 1
  Array(values) => 1
  Tuple(values) => 1
  Map(entries) => 1
  Set(entries) => 1
  Struct(typeName, fields) => 2
  Module(name) => 1
  Closure(index) => 1
  Enum(typeName, name, raw, payload) => 3 + payload.length()
}

runtimeValuePayloadAt(
  value: RuntimeValue,
  index: Int
) -> RuntimeValue => value {
  Bool(raw) => index == 0 ? boolValue(raw) : voidValue()
  Int(raw, typeName) => index == 0 ? intValue(raw) : stringValue(typeName)
  Double(raw, text, typeName) => index == 0 ? doubleRuntimeValue(raw) : (index == 1 ? stringValue(text) : stringValue(typeName))
  String(raw, typeName) => index == 0 ? stringValue(raw) : stringValue(typeName)
  Char(raw) => index == 0 ? charValue(raw) : voidValue()
  Array(values) => index == 0 ? arrayValue(values) : voidValue()
  Tuple(values) => index == 0 ? arrayValue(values) : voidValue()
  Map(entries) => index == 0 ? mapValue(entries) : voidValue()
  Set(entries) => index == 0 ? setValue(entries) : voidValue()
  Struct(typeName, fields) => index == 0 ? stringValue(typeName) : arrayValue(runtimeFieldsAsValues(fields, 0, []))
  Module(name) => index == 0 ? stringValue(name) : voidValue()
  Closure(raw) => index == 0 ? intValue(raw) : voidValue()
  Enum(typeName, name, raw, payload) => index == 0 ? stringValue(typeName) : (index == 1 ? stringValue(name) : (index == 2 ? intValue(raw) : payload[index - 3]))
  _ => voidValue()
}

runtimeFieldsAsValues(
  fields: Array[RuntimeField],
  index: Int,
  out: Array[RuntimeValue]
) -> Array[RuntimeValue] => (
  index >= fields.length() ? out
    : runtimeFieldsAsValues(fields, index + 1, pushRuntime(out, structValue("RuntimeField", [
      RuntimeField { name: "name", value: stringValue(fields[index].name) },
      RuntimeField { name: "value", value: fields[index].value }
    ])))
)

splitPatternArgs(
  text: String
) -> Array[String] => (
  text.trim() == "" ? [""].slice(0, 0)
    : splitPatternArgsLoop(text, 0, 0, 0, '\x00', [""].slice(0, 0))
)

splitPatternArgsLoop(
  text: String,
  index: Int,
  start: Int,
  depth: Int,
  quote: Char,
  out: Array[String]
) -> Array[String] => (
  index >= text.length() ? pushPatternArg(out, text.slice(start, text.length()).trim())
    : splitPatternArgsStep(text, index, start, depth, quote, out)
)

splitPatternArgsStep(
  text: String,
  index: Int,
  start: Int,
  depth: Int,
  quote: Char,
  out: Array[String]
) -> Array[String] => {
  ch := text.at(index)
  (
    quote != '\x00' ? (
      ch == '\\' ? splitPatternArgsLoop(text, index + 2, start, depth, quote, out)
        : (
          ch == quote ? splitPatternArgsLoop(text, index + 1, start, depth, '\x00', out)
            : splitPatternArgsLoop(text, index + 1, start, depth, quote, out)
        )
    )
      : splitPatternArgsUnquoted(text, index, start, depth, ch, out)
  )
}

splitPatternArgsUnquoted(
  text: String,
  index: Int,
  start: Int,
  depth: Int,
  ch: Char,
  out: Array[String]
) -> Array[String] => (
  (ch == '"') || (ch == '\'') ? splitPatternArgsLoop(text, index + 1, start, depth, ch, out)
    : (
      isPatternOpenChar(ch) ? splitPatternArgsLoop(text, index + 1, start, depth + 1, '\x00', out)
        : (
          isPatternCloseChar(ch) ? splitPatternArgsLoop(text, index + 1, start, depth - 1, '\x00', out)
            : (
              (ch == ',') && (depth == 0) ? splitPatternArgsLoop(text, index + 1, index + 1, depth, '\x00', pushPatternArg(out, text.slice(start, index).trim()))
                : splitPatternArgsLoop(text, index + 1, start, depth, '\x00', out)
            )
        )
    )
)

pushPatternArg(
  out: Array[String],
  value: String
) -> Array[String] => {
  out.push(value)
  out
}

isPatternOpenChar(
  ch: Char
) -> Bool => ((ch == '(') || (ch == '[')) || (ch == '{')

isPatternCloseChar(
  ch: Char
) -> Bool => ((ch == ')') || (ch == ']')) || (ch == '}')

isBindingPatternText(
  text: String
) -> Bool => (
  text.length() == 0 ? false
    : isLowerIdentStart(text.at(0))
)

isLowerIdentStart(
  ch: Char
) -> Bool => ((ch >= 'a') && (ch <= 'z')) || (ch == '_')

matchEnumPatternText(
  subject: RuntimeValue,
  text: String
) -> Bool => (
  runtimeKind(subject) != RuntimeValueKind.Enum ? false
    : (
      text.includes(".") ? matchQualifiedEnumPattern(subject, text)
        : runtimeText(subject) == text
    )
)

matchQualifiedEnumPattern(
  subject: RuntimeValue,
  text: String
) -> Bool => text == ((runtimeTypeName(subject) + ".") + runtimeText(subject))

isRangePatternText(
  text: String
) -> Bool => text.includes("..=") || text.includes("..<")

isIntText(
  text: String
) -> Bool => (
  text.length() == 0 ? false
    : (
      text.startsWith("-") ? (text.length() > 1) && isUnsignedIntText(text, 1)
        : isUnsignedIntText(text, 0)
    )
)

isUnsignedIntText(
  text: String,
  index: Int
) -> Bool => (
  index >= text.length() ? true
    : (
      isDigitChar(text.at(index)) ? isUnsignedIntText(text, index + 1)
        : false
    )
)

matchRangeText(
  subject: RuntimeValue,
  text: String
) -> Bool => {
  inclusive := text.includes("..=")
  parts := (
    inclusive ? text.split("..=")
      : text.split("..<")
  )
  (
    runtimeKind(subject) == RuntimeValueKind.Char ? matchCharRangeText(runtimeChar(subject), parts[0].trim(), parts[1].trim(), inclusive)
      : (
        runtimeKind(subject) == RuntimeValueKind.Int ? matchIntRangeText(runtimeInt(subject), parts[0].trim(), parts[1].trim(), inclusive)
          : false
      )
  )
}

matchIntRangeText(
  value: Int,
  start: String,
  end: String,
  inclusive: Bool
) -> Bool => {
  lower := (start == "_") || (value >= parseIntText(start))
  upper := (
    end == "_" ? true
      : (
        inclusive ? value <= parseIntText(end)
          : value < parseIntText(end)
      )
  )
  lower && upper
}

matchCharRangeText(
  value: Char,
  start: String,
  end: String,
  inclusive: Bool
) -> Bool => {
  lower := (start == "_") || (value >= decodeCharLiteral(start))
  upper := (
    end == "_" ? true
      : (
        inclusive ? value <= decodeCharLiteral(end)
          : value < decodeCharLiteral(end)
      )
  )
  lower && upper
}
