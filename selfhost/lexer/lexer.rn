Token: {
  kind: String
  lexeme: String
  offset: Int
  line: Int
  column: Int
}

LexState: {
  source: String
  start: Int
  current: Int
  line: Int
  column: Int
  startLine: Int
  startColumn: Int
  canStartRegex: Bool
}

Advanced: {
  state: LexState
  ch: Char
}

Lexed: {
  state: LexState
  kind: String
}

ScannedString: {
  state: LexState
  ok: Bool
}

lex(source: String) -> Array[Token] => scan(LexState {
  source: source
  start: 0
  current: 0
  line: 1
  column: 1
  startLine: 1
  startColumn: 1
  canStartRegex: true
}, emptyTokens())

emptyTokens() -> Array[Token] => [Token {
  kind: ""
  lexeme: ""
  offset: 0
  line: 0
  column: 0
}].slice(0, 0)

scan(
  state: LexState,
  tokens: Array[Token]
) -> Array[Token] => {
  skipped := skipIgnored(state)
  started := markStart(skipped)
  atEnd(started) ? appendToken(tokens, makeToken(started, "EOF")) : scanLexed(scanToken(advance(started)), tokens)
}

scanLexed(
  lexed: Lexed,
  tokens: Array[Token]
) -> Array[Token] => {
  nextTokens := appendToken(tokens, makeToken(lexed.state, lexed.kind))
  scan(finishToken(lexed.state, lexed.kind), nextTokens)
}

appendToken(
  tokens: Array[Token],
  token: Token
) -> Array[Token] => {
  tokens.push(token)
  tokens
}

makeToken(
  state: LexState,
  kind: String
) -> Token => Token {
  kind: kind
  lexeme: state.source.slice(state.start, state.current)
  offset: state.start
  line: state.startLine
  column: state.startColumn
}

finishToken(
  state: LexState,
  kind: String
) -> LexState => LexState {
  source: state.source
  start: state.start
  current: state.current
  line: state.line
  column: state.column
  startLine: state.startLine
  startColumn: state.startColumn
  canStartRegex: !canEndExpression(kind)
}

canEndExpression(kind) => "Ident" | "Int" | "Double" | "BigInt" | "String" | "TemplateString" | "Char" | "Regex" | "XMLText" | "Less" | "RParen" | "RBracket" | "RBrace"

markStart(state: LexState) -> LexState => LexState {
  source: state.source
  start: state.current
  current: state.current
  line: state.line
  column: state.column
  startLine: state.line
  startColumn: state.column
  canStartRegex: state.canStartRegex
}

atEnd(state: LexState) -> Bool => state.current >= state.source.length()

charAt(
  source: String,
  index: Int
) -> Char => (index < 0) || (index >= source.length()) ? '\x00' : source.at(index)

peek(state: LexState) -> Char => charAt(state.source, state.current)

peekNext(state: LexState) -> Char => charAt(state.source, state.current + 1)

advanceState(
  state: LexState
) -> LexState => advance(state).state

advance(state: LexState) -> Advanced => atEnd(state) ? advanced(state, '\x00') : advanceChar(state, state.source.at(state.current))

advanced(
  state: LexState,
  ch: Char
) -> Advanced => Advanced {
  state: state
  ch: ch
}

advanceChar(
  state: LexState,
  ch: Char
) -> Advanced => Advanced {
  state: LexState {
    source: state.source
    start: state.start
    current: state.current + 1
    line: ch == '\n' ? state.line + 1 : state.line
    column: ch == '\n' ? 1 : state.column + 1
    startLine: state.startLine
    startColumn: state.startColumn
    canStartRegex: state.canStartRegex
  }
  ch: ch
}

skipIgnored(state: LexState) -> LexState => atEnd(state) ? state : isSpace(peek(state)) ? skipIgnored(advanceState(state)) : startsWith(state, '/', '/') ? skipIgnored(skipLineComment(advanceState(advanceState(state)))) : startsWith(state, '/', '*') ? skipIgnored(skipBlockComment(advanceState(advanceState(state)))) : state

startsWith(
  state: LexState,
  first: Char,
  second: Char
) -> Bool => (peek(state) == first) && (peekNext(state) == second)

skipLineComment(state) => atEnd(state) || (peek(state) == '\n') ? state : skipLineComment(advanceState(state))

skipBlockComment(state) => atEnd(state) ? state : startsWith(state, '*', '/') ? advanceState(advanceState(state)) : skipBlockComment(advanceState(state))

isSpace(ch) => ' ' | '\t' | '\r'

scanToken(step) => {
  { state, ch } := step
  ch {
    '\n' => lexed(state, "Newline")
    '@' => lexed(state, "At")
    '$' => lexDollar(state)
    '.' => lexDot(state)
    ',' => lexed(state, "Comma")
    ':' => lexColon(state)
    '(' => lexed(state, "LParen")
    ')' => lexed(state, "RParen")
    '[' => lexed(state, "LBracket")
    ']' => lexed(state, "RBracket")
    '{' => lexed(state, "LBrace")
    '}' => lexed(state, "RBrace")
    '?' => lexQuestion(state)
    '+' => lexPlus(state)
    '-' => lexMinus(state)
    '*' => lexed(state, "Star")
    '/' => state.canStartRegex ? lexRegexToken(state) : lexed(state, "Slash")
    '%' => lexed(state, "Percent")
    '!' => lexBang(state)
    '~' => lexTilde(state)
    '&' => lexAmp(state)
    '|' => lexPipe(state)
    '^' => lexed(state, "BitXor")
    '=' => lexEqual(state)
    '<' => lexLess(state)
    '>' => lexGreater(state)
    '"' => lexStringToken(state)
    '`' => lexTemplateStringToken(state)
    '\'' => lexCharToken(state)
    '_' => isIdentContinue(peek(state)) ? lexIdentifierToken(state) : lexed(state, "Underscore")
    _ => isDigit(ch) ? lexNumberToken(state) : isIdentStart(ch) ? lexIdentifierToken(state) : lexed(state, "Illegal")
  }
}

lexed(
  state: LexState,
  kind: String
) -> Lexed => Lexed {
  state: state
  kind: kind
}

lexDot(state: LexState) -> Lexed => peek(state) {
  '.' => lexDotDot(advanceState(state))
  _ => lexed(state, "Dot")
}

lexDotDot(state: LexState) -> Lexed => peek(state) {
  '.' => lexed(advanceState(state), "DotDotDot")
  '=' => lexed(advanceState(state), "DotDotEqual")
  _ => lexed(state, "DotDot")
}

lexColon(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), "Declare")
  _ => lexed(state, "Colon")
}

lexQuestion(state: LexState) -> Lexed => peek(state) {
  '?' => lexed(advanceState(state), "QuestionQuestion")
  _ => lexed(state, "Question")
}

lexPlus(state: LexState) -> Lexed => peek(state) {
  '+' => lexed(advanceState(state), "PlusPlus")
  _ => lexed(state, "Plus")
}

lexMinus(state: LexState) -> Lexed => peek(state) {
  '>' => lexed(advanceState(state), "Arrow")
  _ => lexed(state, "Minus")
}

lexBang(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), "BangEqual")
  _ => lexed(state, "Bang")
}

lexTilde(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), "MutDeclare")
  _ => lexed(state, "Tilde")
}

lexDollar(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), "SignalDeclare")
  _ => lexed(state, "Dollar")
}

lexAmp(state: LexState) -> Lexed => peek(state) {
  '&' => lexed(advanceState(state), "AndAnd")
  _ => lexed(state, "BitAnd")
}

lexPipe(state: LexState) -> Lexed => peek(state) {
  '|' => lexed(advanceState(state), "OrOr")
  _ => lexed(state, "BitOr")
}

lexEqual(state: LexState) -> Lexed => peek(state) {
  '>' => lexed(advanceState(state), "FatArrow")
  '=' => lexed(advanceState(state), "EqualEqual")
  _ => lexed(state, "Assign")
}

lexLess(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), "LessEqual")
  '<' => lexed(advanceState(state), "ShiftLeft")
  _ => lexed(state, "Less")
}

lexGreater(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), "GreaterEqual")
  '>' => startsWith(state, '>', '>') ? lexed(advanceState(advanceState(state)), "UnsignedShiftRight") : lexed(advanceState(state), "ShiftRight")
  _ => lexed(state, "Greater")
}

lexStringToken(state: LexState) -> Lexed => {
  scanned := scanString(state, false)
  lexed(scanned.state, scanned.ok ? "String" : "Illegal")
}

lexTemplateStringToken(state: LexState) -> Lexed => {
  scanned := scanTemplateString(state, false)
  lexed(scanned.state, scanned.ok ? "TemplateString" : "Illegal")
}

scanString(
  state: LexState,
  escaped: Bool
) -> ScannedString => atEnd(state) ? scannedString(state, false) : scanStringStep(advance(state), escaped)

scanTemplateString(
  state: LexState,
  escaped: Bool
) -> ScannedString => atEnd(state) ? scannedString(state, false) : scanTemplateStringStep(advance(state), escaped)

scannedString(
  state: LexState,
  ok: Bool
) -> ScannedString => ScannedString {
  state: state
  ok: ok
}

scanStringStep(
  step: Advanced,
  escaped: Bool
) -> ScannedString => escaped ? scanString(step.state, false) : step.ch {
  '\\' => scanString(step.state, true)
  '"' => scannedString(step.state, true)
  _ => scanString(step.state, false)
}

scanTemplateStringStep(
  step: Advanced,
  escaped: Bool
) -> ScannedString => escaped ? scanTemplateString(step.state, false) : step.ch {
  '\\' => scanTemplateString(step.state, true)
  '`' => scannedString(step.state, true)
  _ => scanTemplateString(step.state, false)
}

lexCharToken(state: LexState) -> Lexed => {
  scanned := scanChar(state, false)
  lexed(scanned.state, scanned.ok ? "Char" : "Illegal")
}

scanChar(
  state: LexState,
  escaped: Bool
) -> ScannedString => atEnd(state) ? scannedString(state, false) : scanCharStep(advance(state), escaped)

scanCharStep(
  step: Advanced,
  escaped: Bool
) -> ScannedString => step.ch {
  '\n' => scannedString(step.state, false)
  _ => escaped ? scanChar(step.state, false) : step.ch {
    '\\' => scanChar(step.state, true)
    '\'' => scannedString(step.state, true)
    _ => scanChar(step.state, false)
  }
}

lexRegexToken(state: LexState) -> Lexed => {
  scanned := scanRegex(state, false, false)
  lexed(scanned.state, scanned.ok ? "Regex" : "Illegal")
}

scanRegex(
  state: LexState,
  escaped: Bool,
  inClass: Bool
) -> ScannedString => atEnd(state) ? scannedString(state, false) : scanRegexStep(advance(state), escaped, inClass)

scanRegexStep(
  step: Advanced,
  escaped: Bool,
  inClass: Bool
) -> ScannedString => step.ch {
  '\n' => scannedString(step.state, false)
  _ => escaped ? scanRegex(step.state, false, inClass) : step.ch {
    '\\' => scanRegex(step.state, true, inClass)
    '[' => scanRegex(step.state, false, true)
    ']' => scanRegex(step.state, false, false)
    '/' => inClass ? scanRegex(step.state, false, inClass) : scannedString(scanRegexFlags(step.state), true)
    _ => scanRegex(step.state, false, inClass)
  }
}

scanRegexFlags(
  state: LexState
) -> LexState => isRegexFlag(peek(state)) ? scanRegexFlags(advanceState(state)) : state

lexNumberToken(state: LexState) -> Lexed => lexNumberAfterDigits(scanDigits(state), false)

scanDigits(state: LexState) -> LexState => isDigit(peek(state)) ? scanDigits(advanceState(state)) : state

lexNumberAfterDigits(
  state: LexState,
  isDouble: Bool
) -> Lexed => peek(state) {
  'n' => lexed(advanceState(state), "BigInt")
  '.' => isDigit(peekNext(state)) ? lexNumberAfterDot(advanceState(state)) : lexed(state, isDouble ? "Double" : "Int")
  _ => isExponentMarker(peek(state)) ? lexNumberAfterExponent(advanceState(state)) : lexed(state, isDouble ? "Double" : "Int")
}

lexNumberAfterDot(
  state: LexState
) -> Lexed => lexNumberAfterDigits(scanDigits(state), true)

lexNumberAfterExponent(
  state: LexState
) -> Lexed => isExponentSign(peek(state)) ? lexNumberExponentDigits(advanceState(state)) : lexNumberExponentDigits(state)

lexNumberExponentDigits(
  state: LexState
) -> Lexed => lexed(scanDigits(state), "Double")

lexIdentifierToken(
  state: LexState
) -> Lexed => lexed(scanIdentifier(state), "Ident")

scanIdentifier(
  state: LexState
) -> LexState => isIdentContinue(peek(state)) ? scanIdentifier(advanceState(state)) : state

isDigit(ch: Char) -> Bool => '0'..='9'

isAlpha(ch: Char) -> Bool => ('a'..='z') | ('A'..='Z')

isIdentStart(ch: Char) -> Bool => {
  '_' => true
  _ => isIdentText(ch) && (isDigit(ch) == false)
}

isIdentContinue(ch: Char) -> Bool => isIdentStart(ch) || isDigit(ch)

isIdentText(ch: Char) -> Bool => ((isIdentBoundary(ch) == false) && (isAsciiPunctuation(ch) == false))

isIdentBoundary(ch: Char) -> Bool => {
  '\x00' => true
  ' ' => true
  '\t' => true
  '\r' => true
  '\n' => true
  _ => false
}

isAsciiPunctuation(ch: Char) -> Bool => {
  '!'..='/' => true
  ':'..='@' => true
  '['..='^' => true
  '`' => true
  '{'..='~' => true
  _ => false
}

isRegexFlag(ch: Char) -> Bool => isAlpha(ch)

isExponentMarker(ch) => 'e' | 'E'

isExponentSign(ch) => '+' | '-'
