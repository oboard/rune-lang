+ Token: {
  kind: TokenKind
  lexeme: String
  offset: Int
  line: Int
  column: Int
}

LexState: {
  source: String
  start: Int
  current: Int
  line: Int
  column: Int
  startLine: Int
  startColumn: Int
  canStartRegex: Bool
  mode: Int
  xmlDepth: Int
  xmlClosing: Bool
  xmlSelfClosed: Bool
  xmlExprMode: Int
  xmlExprDepth: Int
  xmlAfterMode: Int
  xmlAfterDepth: Int
}

Advanced: {
  state: LexState
  ch: Char
}

Lexed: {
  state: LexState
  kind: TokenKind
}

ScannedString: {
  state: LexState
  ok: Bool
}

+ TokenKind: {
  EOF
  Illegal
  Newline
  Ident
  Int
  Double
  BigInt
  String
  TemplateString
  Char
  Regex
  XMLText
  Hash
  At
  Dollar
  Dot
  DotDot
  DotDotLess
  DotDotEqual
  DotDotDot
  Comma
  Colon
  DoubleColon
  LParen
  RParen
  LBracket
  RBracket
  LBrace
  RBrace
  Question
  QuestionQuestion
  Apostrophe
  FatArrow
  Assign
  Declare
  MutDeclare
  Arrow
  Plus
  PlusPlus
  Minus
  Star
  Slash
  Percent
  Bang
  Tilde
  BitAnd
  BitOr
  BitXor
  ShiftLeft
  ShiftRight
  UnsignedShiftRight
  AndAnd
  OrOr
  EqualEqual
  BangEqual
  Less
  LessEqual
  Greater
  GreaterEqual
  Underscore
}

xmlModeCode() -> Int => 0

xmlModeTag() -> Int => 1

xmlModeText() -> Int => 2

xmlModeExpr() -> Int => 3

+ lex(source: String) -> Array[Token] => scan(LexState {
  source: source,
  start: 0,
  current: 0,
  line: 1,
  column: 1,
  startLine: 1,
  startColumn: 1,
  canStartRegex: true,
  mode: xmlModeCode(),
  xmlDepth: 0,
  xmlClosing: false,
  xmlSelfClosed: false,
  xmlExprMode: xmlModeCode(),
  xmlExprDepth: 0,
  xmlAfterMode: xmlModeCode(),
  xmlAfterDepth: 0
}, emptyTokens())

emptyTokens() -> Array[Token] => []

scan(
  state: LexState,
  tokens: Array[Token]
) -> Array[Token] => {
  prepared := prepareLexState(state)
  started := markStart(prepared)
  (
    atEnd(started) ? appendToken(tokens, makeToken(started, TokenKind.EOF))
      : scanLexed(scanModeToken(started), tokens)
  )
}

prepareLexState(
  state: LexState
) -> LexState => ((state.mode == xmlModeCode()) || (state.mode == xmlModeExpr())) {
  true => skipIgnored(state)
  _ => skipXMLSpaces(state)
}

scanModeToken(state: LexState) -> Lexed => state.mode {
  1 => scanXMLTagToken(advance(state))
  2 => scanXMLTextToken(state)
  3 => scanXMLExprToken(advance(state))
  _ => scanToken(advance(state))
}

scanLexed(
  lexed: Lexed,
  tokens: Array[Token]
) -> Array[Token] => {
  nextTokens := appendToken(tokens, makeToken(lexed.state, lexed.kind))
  scan(finishToken(lexed.state, lexed.kind), nextTokens)
}

appendToken(
  tokens: Array[Token],
  token: Token
) -> Array[Token] => {
  tokens.push(token)
  tokens
}

makeToken(
  state: LexState,
  kind: TokenKind
) -> Token => {
  kind: kind,
  lexeme: state.source.slice(state.start, state.current),
  offset: state.start,
  line: state.startLine,
  column: state.startColumn
}

finishToken(
  state: LexState,
  kind: TokenKind
) -> LexState => {
  ..state,
  canStartRegex: !canEndExpression(state, kind)
}

lexStateXML(
  state: LexState,
  mode: Int,
  depth: Int,
  closing: Bool,
  selfClosed: Bool,
  exprMode: Int,
  exprDepth: Int
) -> LexState => {
  ..state,
  mode: mode,
  xmlDepth: depth,
  xmlClosing: closing,
  xmlSelfClosed: selfClosed,
  xmlExprMode: exprMode,
  xmlExprDepth: exprDepth
}

enterXMLTagState(
  state: LexState
) -> LexState => {
  depth := (
    state.mode == xmlModeExpr() ? 0
      : state.xmlDepth
  )
  lexStateXMLAfterMode(lexStateXML(state, xmlModeTag(), depth, false, false, state.xmlExprMode, state.xmlExprDepth), state.mode, state.xmlDepth)
}

lexStateXMLAfterMode(
  state: LexState,
  afterMode: Int,
  afterDepth: Int
) -> LexState => {
  ..state,
  xmlAfterMode: afterMode,
  xmlAfterDepth: afterDepth
}

canEndExpression(
  state: LexState,
  kind: TokenKind
) => canEndValueToken(kind) || canEndXmlLess(state, kind)

canEndValueToken(kind: TokenKind) => kind ~ (Ident | Int | Double | BigInt | String | TemplateString | Char | Regex | XMLText | RParen | RBracket | RBrace)

canEndXmlLess(
  state: LexState,
  kind: TokenKind
) => (kind == TokenKind.Less) && ((peek(state) == '/') || isIdentStart(peek(state)))

+ tokenKindName(
  kind: TokenKind
) -> String => kind {
  TokenKind.EOF => "EOF"
  TokenKind.Illegal => "Illegal"
  TokenKind.Newline => "Newline"
  TokenKind.Ident => "Ident"
  TokenKind.Int => "Int"
  TokenKind.Double => "Double"
  TokenKind.BigInt => "BigInt"
  TokenKind.String => "String"
  TokenKind.TemplateString => "TemplateString"
  TokenKind.Char => "Char"
  TokenKind.Regex => "Regex"
  TokenKind.XMLText => "XMLText"
  TokenKind.Hash => "Hash"
  TokenKind.At => "At"
  TokenKind.Dollar => "Dollar"
  TokenKind.Dot => "Dot"
  TokenKind.DotDot => "DotDot"
  TokenKind.DotDotLess => "DotDotLess"
  TokenKind.DotDotEqual => "DotDotEqual"
  TokenKind.DotDotDot => "DotDotDot"
  TokenKind.Comma => "Comma"
  TokenKind.Colon => "Colon"
  TokenKind.DoubleColon => "DoubleColon"
  TokenKind.LParen => "LParen"
  TokenKind.RParen => "RParen"
  TokenKind.LBracket => "LBracket"
  TokenKind.RBracket => "RBracket"
  TokenKind.LBrace => "LBrace"
  TokenKind.RBrace => "RBrace"
  TokenKind.Question => "Question"
  TokenKind.QuestionQuestion => "QuestionQuestion"
  TokenKind.Apostrophe => "Apostrophe"
  TokenKind.FatArrow => "FatArrow"
  TokenKind.Assign => "Assign"
  TokenKind.Declare => "Declare"
  TokenKind.MutDeclare => "MutDeclare"
  TokenKind.Arrow => "Arrow"
  TokenKind.Plus => "Plus"
  TokenKind.PlusPlus => "PlusPlus"
  TokenKind.Minus => "Minus"
  TokenKind.Star => "Star"
  TokenKind.Slash => "Slash"
  TokenKind.Percent => "Percent"
  TokenKind.Bang => "Bang"
  TokenKind.Tilde => "Tilde"
  TokenKind.BitAnd => "BitAnd"
  TokenKind.BitOr => "BitOr"
  TokenKind.BitXor => "BitXor"
  TokenKind.ShiftLeft => "ShiftLeft"
  TokenKind.ShiftRight => "ShiftRight"
  TokenKind.UnsignedShiftRight => "UnsignedShiftRight"
  TokenKind.AndAnd => "AndAnd"
  TokenKind.OrOr => "OrOr"
  TokenKind.EqualEqual => "EqualEqual"
  TokenKind.BangEqual => "BangEqual"
  TokenKind.Less => "Less"
  TokenKind.LessEqual => "LessEqual"
  TokenKind.Greater => "Greater"
  TokenKind.GreaterEqual => "GreaterEqual"
  TokenKind.Underscore => "Underscore"
  _ => "Unknown"
}

markStart(state: LexState) -> LexState => {
  ..state,
  start: state.current,
  startLine: state.line,
  startColumn: state.column
}

atEnd(state: LexState) -> Bool => state.current >= state.source.length()

charAt(
  source: String,
  index: Int
) -> Char => (
  (index < 0) || (index >= source.length()) ? ' '
    : source.at(index)
)

peek(state: LexState) -> Char => charAt(state.source, state.current)

peekNext(state: LexState) -> Char => charAt(state.source, state.current + 1)

advanceState(
  state: LexState
) -> LexState => advance(state).state

advance(state: LexState) -> Advanced => (
  atEnd(state) ? advanced(state, ' ')
    : advanceChar(state, state.source.at(state.current))
)

advanced(
  state: LexState,
  ch: Char
) -> Advanced => {
  state: state,
  ch: ch
}

advanceChar(
  state: LexState,
  ch: Char
) -> Advanced => {
  state: LexState {
    source: state.source,
    start: state.start,
    current: state.current + 1,
    line: (
      ch == '\n' ? state.line + 1
        : state.line
    ),
    column: (
      ch == '\n' ? 1
        : state.column + 1
    ),
    startLine: state.startLine,
    startColumn: state.startColumn,
    canStartRegex: state.canStartRegex,
    mode: state.mode,
    xmlDepth: state.xmlDepth,
    xmlClosing: state.xmlClosing,
    xmlSelfClosed: state.xmlSelfClosed,
    xmlExprMode: state.xmlExprMode,
    xmlExprDepth: state.xmlExprDepth,
    xmlAfterMode: state.xmlAfterMode,
    xmlAfterDepth: state.xmlAfterDepth
  },
  ch: ch
}

skipIgnored(state: LexState) -> LexState => (
  atEnd(state) ? state
    : (
      isSpace(peek(state)) ? skipIgnored(advanceState(state))
        : (
          startsWith(state, '/', '/') ? skipIgnored(skipLineComment(advanceState(advanceState(state))))
            : (
              startsWith(state, '/', '*') ? skipIgnored(skipBlockComment(advanceState(advanceState(state))))
                : state
            )
        )
    )
)

startsWith(
  state: LexState,
  first: Char,
  second: Char
) -> Bool => (peek(state) == first) && (peekNext(state) == second)

skipLineComment(state) => (
  atEnd(state) || (peek(state) == '\n') ? state
    : skipLineComment(advanceState(state))
)

skipBlockComment(state) => (
  atEnd(state) ? state
    : (
      startsWith(state, '*', '/') ? advanceState(advanceState(state))
        : skipBlockComment(advanceState(state))
    )
)

isSpace(ch: Char) -> Bool => ((ch == ' ') || (ch == '\t')) || (ch == '\r')

isXMLSpace(ch: Char) -> Bool => (((ch == ' ') || (ch == '\t')) || (ch == '\r')) || (ch == '\n')

skipXMLSpaces(
  state: LexState
) -> LexState => (
  atEnd(state) ? state
    : (
      isXMLSpace(peek(state)) ? skipXMLSpaces(advanceState(state))
        : state
    )
)

scanToken(step: Advanced) => {
  { state, ch } := step
  ch {
    '\n' => lexed(state, TokenKind.Newline)
    '#' => lexed(state, TokenKind.Hash)
    '@' => lexed(state, TokenKind.At)
    '$' => lexDollar(state)
    '.' => lexDot(state)
    ',' => lexed(state, TokenKind.Comma)
    ':' => lexColon(state)
    '(' => lexed(state, TokenKind.LParen)
    ')' => lexed(state, TokenKind.RParen)
    '[' => lexed(state, TokenKind.LBracket)
    ']' => lexed(state, TokenKind.RBracket)
    '{' => lexed(state, TokenKind.LBrace)
    '}' => lexed(state, TokenKind.RBrace)
    '?' => lexQuestion(state)
    '+' => lexPlus(state)
    '-' => lexMinus(state)
    '*' => lexed(state, TokenKind.Star)
    '/' => (
      state.canStartRegex ? lexRegexToken(state)
        : lexed(state, TokenKind.Slash)
    )
    '%' => lexed(state, TokenKind.Percent)
    '!' => lexBang(state)
    '~' => lexTilde(state)
    '&' => lexAmp(state)
    '|' => lexPipe(state)
    '^' => lexed(state, TokenKind.BitXor)
    '=' => lexEqual(state)
    '<' => lexLess(state)
    '>' => lexGreater(state)
    '"' => lexStringToken(state)
    '`' => lexTemplateStringToken(state)
    '\'' => (
      state.canStartRegex ? lexCharToken(state)
        : lexed(state, TokenKind.Apostrophe)
    )
    '_' => (
      isIdentContinue(peek(state)) ? lexIdentifierToken(state)
        : lexed(state, TokenKind.Underscore)
    )
    _ => (
      isDigit(ch) ? lexNumberToken(state)
        : (
          isIdentStart(ch) ? lexIdentifierToken(state)
            : lexed(state, TokenKind.Illegal)
        )
    )
  }
}

scanXMLTagToken(step: Advanced) -> Lexed => {
  { state, ch } := step
  ch {
    '@' => lexed(state, TokenKind.At)
    '=' => lexed(state, TokenKind.Assign)
    '{' => lexed(lexStateXML(state, xmlModeExpr(), state.xmlDepth, state.xmlClosing, state.xmlSelfClosed, xmlModeTag(), 1), TokenKind.LBrace)
    '/' => lexed(lexStateXML(state, state.mode, state.xmlDepth, peek(state) != '>', peek(state) == '>', state.xmlExprMode, state.xmlExprDepth), TokenKind.Slash)
    '>' => lexed(xmlStateAfterTagEnd(state), TokenKind.Greater)
    '"' => lexStringToken(state)
    _ => (
      isIdentStart(ch) ? lexXMLIdentifierToken(state)
        : lexed(state, TokenKind.Illegal)
    )
  }
}

xmlStateAfterTagEnd(
  state: LexState
) -> LexState => {
  nextDepth := (
    state.xmlClosing ? state.xmlDepth - 1
      : (
        state.xmlSelfClosed ? state.xmlDepth
          : state.xmlDepth + 1
      )
  )
  nextMode := (
    nextDepth > 0 ? xmlModeText()
      : state.xmlAfterMode
  )
  restoredDepth := (
    nextDepth > 0 ? nextDepth
      : state.xmlAfterDepth
  )
  lexStateXML(state, nextMode, restoredDepth, false, false, state.xmlExprMode, state.xmlExprDepth)
}

scanXMLTextToken(
  state: LexState
) -> Lexed => peek(state) {
  '<' => scanXMLTextLess(advanceState(state))
  '{' => lexed(lexStateXML(advanceState(state), xmlModeExpr(), state.xmlDepth, state.xmlClosing, state.xmlSelfClosed, xmlModeText(), 1), TokenKind.LBrace)
  _ => lexed(scanXMLTextContent(state), TokenKind.XMLText)
}

scanXMLTextLess(
  state: LexState
) -> Lexed => lexed(lexStateXML(state, xmlModeTag(), state.xmlDepth, peek(state) == '/', false, state.xmlExprMode, state.xmlExprDepth), TokenKind.Less)

scanXMLTextContent(
  state: LexState
) -> LexState => (
  (atEnd(state) || (peek(state) == '<')) || (peek(state) == '{') ? state
    : scanXMLTextContent(advanceState(state))
)

scanXMLExprToken(
  step: Advanced
) -> Lexed => {
  { state, ch } := step
  ch {
    '{' => lexed(lexStateXML(state, xmlModeExpr(), state.xmlDepth, state.xmlClosing, state.xmlSelfClosed, state.xmlExprMode, state.xmlExprDepth + 1), TokenKind.LBrace)
    '}' => lexed(xmlStateAfterExprBrace(state), TokenKind.RBrace)
    _ => scanToken(step)
  }
}

xmlStateAfterExprBrace(
  state: LexState
) -> LexState => {
  nextDepth := state.xmlExprDepth - 1
  nextMode := (
    nextDepth <= 0 ? state.xmlExprMode
      : xmlModeExpr()
  )
  lexStateXMLAfterMode(lexStateXML(state, nextMode, state.xmlDepth, state.xmlClosing, state.xmlSelfClosed, xmlModeCode(), nextDepth), xmlModeCode(), 0)
}

lexed(
  state: LexState,
  kind: TokenKind
) -> Lexed => {
  state: state,
  kind: kind
}

lexDot(state: LexState) -> Lexed => peek(state) {
  '.' => lexDotDot(advanceState(state))
  _ => lexed(state, TokenKind.Dot)
}

lexDotDot(state: LexState) -> Lexed => peek(state) {
  '.' => lexed(advanceState(state), TokenKind.DotDotDot)
  '<' => lexed(advanceState(state), TokenKind.DotDotLess)
  '=' => lexed(advanceState(state), TokenKind.DotDotEqual)
  _ => lexed(state, TokenKind.DotDot)
}

lexColon(state: LexState) -> Lexed => peek(state) {
  '=' => (
    peek(advanceState(state)) == ':' ? lexed(advanceState(advanceState(state)), TokenKind.MutDeclare)
      : lexed(advanceState(state), TokenKind.Declare)
  )
  ':' => lexed(advanceState(state), TokenKind.DoubleColon)
  _ => lexed(state, TokenKind.Colon)
}

lexQuestion(state: LexState) -> Lexed => peek(state) {
  '?' => lexed(advanceState(state), TokenKind.QuestionQuestion)
  _ => lexed(state, TokenKind.Question)
}

lexPlus(state: LexState) -> Lexed => peek(state) {
  '+' => lexed(advanceState(state), TokenKind.PlusPlus)
  _ => lexed(state, TokenKind.Plus)
}

lexMinus(state: LexState) -> Lexed => peek(state) {
  '>' => lexed(advanceState(state), TokenKind.Arrow)
  _ => lexed(state, TokenKind.Minus)
}

lexBang(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), TokenKind.BangEqual)
  _ => lexed(state, TokenKind.Bang)
}

lexTilde(state: LexState) -> Lexed => peek(state) {
  _ => lexed(state, TokenKind.Tilde)
}

lexDollar(state: LexState) -> Lexed => peek(state) {
  _ => lexed(state, TokenKind.Dollar)
}

lexAmp(state: LexState) -> Lexed => peek(state) {
  '&' => lexed(advanceState(state), TokenKind.AndAnd)
  _ => lexed(state, TokenKind.BitAnd)
}

lexPipe(state: LexState) -> Lexed => peek(state) {
  '|' => lexed(advanceState(state), TokenKind.OrOr)
  _ => lexed(state, TokenKind.BitOr)
}

lexEqual(state: LexState) -> Lexed => peek(state) {
  '>' => lexed(advanceState(state), TokenKind.FatArrow)
  '=' => lexed(advanceState(state), TokenKind.EqualEqual)
  _ => lexed(state, TokenKind.Assign)
}

lexLess(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), TokenKind.LessEqual)
  '<' => lexed(advanceState(state), TokenKind.ShiftLeft)
  '/' => lexed(enterXMLTagState(state), TokenKind.Less)
  _ => (
    isIdentStart(peek(state)) ? lexed(enterXMLTagState(state), TokenKind.Less)
      : lexed(state, TokenKind.Less)
  )
}

lexGreater(state: LexState) -> Lexed => peek(state) {
  '=' => lexed(advanceState(state), TokenKind.GreaterEqual)
  '>' => (
    startsWith(state, '>', '>') ? lexed(advanceState(advanceState(state)), TokenKind.UnsignedShiftRight)
      : lexed(advanceState(state), TokenKind.ShiftRight)
  )
  _ => lexed(state, TokenKind.Greater)
}

lexStringToken(state: LexState) -> Lexed => {
  scanned := scanString(state, false)
  lexed(scanned.state, (
    scanned.ok ? TokenKind.String
      : TokenKind.Illegal
  ))
}

lexTemplateStringToken(
  state: LexState
) -> Lexed => {
  scanned := scanTemplateString(state, false)
  lexed(scanned.state, (
    scanned.ok ? TokenKind.TemplateString
      : TokenKind.Illegal
  ))
}

scanString(
  state: LexState,
  escaped: Bool
) -> ScannedString => (
  atEnd(state) ? scannedString(state, false)
    : scanStringStep(advance(state), escaped)
)

scanTemplateString(
  state: LexState,
  escaped: Bool
) -> ScannedString => (
  atEnd(state) ? scannedString(state, false)
    : scanTemplateStringStep(advance(state), escaped)
)

scannedString(
  state: LexState,
  ok: Bool
) -> ScannedString => {
  state: state,
  ok: ok
}

scanStringStep(
  step: Advanced,
  escaped: Bool
) -> ScannedString => (
  escaped ? scanString(step.state, false)
    : step.ch {
      '\\' => scanString(step.state, true)
      '"' => scannedString(step.state, true)
      _ => scanString(step.state, false)
    }
)

scanTemplateStringStep(
  step: Advanced,
  escaped: Bool
) -> ScannedString => (
  escaped ? scanTemplateString(step.state, false)
    : step.ch {
      '\\' => scanTemplateString(step.state, true)
      '`' => scannedString(step.state, true)
      _ => scanTemplateString(step.state, false)
    }
)

lexCharToken(state: LexState) -> Lexed => {
  scanned := scanChar(state, false)
  lexed(scanned.state, (
    scanned.ok ? TokenKind.Char
      : TokenKind.Illegal
  ))
}

scanChar(
  state: LexState,
  escaped: Bool
) -> ScannedString => (
  atEnd(state) ? scannedString(state, false)
    : scanCharStep(advance(state), escaped)
)

scanCharStep(
  step: Advanced,
  escaped: Bool
) -> ScannedString => step.ch {
  '\n' => scannedString(step.state, false)
  _ => (
    escaped ? scanChar(step.state, false)
      : step.ch {
        '\\' => scanChar(step.state, true)
        '\'' => scannedString(step.state, true)
        _ => scanChar(step.state, false)
      }
  )
}

lexRegexToken(state: LexState) -> Lexed => {
  scanned := scanRegex(state, false, false)
  lexed(scanned.state, (
    scanned.ok ? TokenKind.Regex
      : TokenKind.Illegal
  ))
}

scanRegex(
  state: LexState,
  escaped: Bool,
  inClass: Bool
) -> ScannedString => (
  atEnd(state) ? scannedString(state, false)
    : scanRegexStep(advance(state), escaped, inClass)
)

scanRegexStep(
  step: Advanced,
  escaped: Bool,
  inClass: Bool
) -> ScannedString => step.ch {
  '\n' => scannedString(step.state, false)
  _ => (
    escaped ? scanRegex(step.state, false, inClass)
      : step.ch {
        '\\' => scanRegex(step.state, true, inClass)
        '[' => scanRegex(step.state, false, true)
        ']' => scanRegex(step.state, false, false)
        '/' => (
          inClass ? scanRegex(step.state, false, inClass)
            : scannedString(scanRegexFlags(step.state), true)
        )
        _ => scanRegex(step.state, false, inClass)
      }
  )
}

scanRegexFlags(
  state: LexState
) -> LexState => (
  isRegexFlag(peek(state)) ? scanRegexFlags(advanceState(state))
    : state
)

lexNumberToken(state: LexState) -> Lexed => lexNumberAfterDigits(scanDigits(state), false)

scanDigits(state: LexState) -> LexState => (
  isDigit(peek(state)) ? scanDigits(advanceState(state))
    : state
)

lexNumberAfterDigits(
  state: LexState,
  isDouble: Bool
) -> Lexed => peek(state) {
  'n' => lexed(advanceState(state), TokenKind.BigInt)
  '.' => (
    isDigit(peekNext(state)) ? lexNumberAfterDot(advanceState(state))
      : lexed(state, (
        isDouble ? TokenKind.Double
          : TokenKind.Int
      ))
  )
  _ => (
    isExponentMarker(peek(state)) ? lexNumberAfterExponent(advanceState(state))
      : lexed(state, (
        isDouble ? TokenKind.Double
          : TokenKind.Int
      ))
  )
}

lexNumberAfterDot(
  state: LexState
) -> Lexed => lexNumberAfterDigits(scanDigits(state), true)

lexNumberAfterExponent(
  state: LexState
) -> Lexed => (
  isExponentSign(peek(state)) ? lexNumberExponentDigits(advanceState(state))
    : lexNumberExponentDigits(state)
)

lexNumberExponentDigits(
  state: LexState
) -> Lexed => lexed(scanDigits(state), TokenKind.Double)

lexIdentifierToken(
  state: LexState
) -> Lexed => lexed(scanIdentifier(state), TokenKind.Ident)

lexXMLIdentifierToken(
  state: LexState
) -> Lexed => lexed(scanXMLIdentifier(state), TokenKind.Ident)

scanIdentifier(
  state: LexState
) -> LexState => (
  isIdentContinue(peek(state)) ? scanIdentifier(advanceState(state))
    : state
)

scanXMLIdentifier(
  state: LexState
) -> LexState => (
  (isIdentContinue(peek(state)) || (peek(state) == '-')) || (peek(state) == ':') ? scanXMLIdentifier(advanceState(state))
    : state
)

isDigit(ch: Char) -> Bool => (ch >= '0') && (ch <= '9')

isAlpha(ch: Char) -> Bool => ((ch >= 'a') && (ch <= 'z')) || ((ch >= 'A') && (ch <= 'Z'))

isIdentStart(ch: Char) -> Bool => (ch == '_') || (isIdentText(ch) && (isDigit(ch) == false))

isIdentContinue(ch: Char) -> Bool => isIdentStart(ch) || isDigit(ch)

isIdentText(ch: Char) -> Bool => (isIdentBoundary(ch) == false) && (isAsciiPunctuation(ch) == false)

isIdentBoundary(ch: Char) -> Bool => ((((ch == '\x00') || (ch == ' ')) || (ch == '\t')) || (ch == '\r')) || (ch == '\n')

isAsciiPunctuation(ch: Char) -> Bool => (((((ch >= '!') && (ch <= '/')) || ((ch >= ':') && (ch <= '@'))) || ((ch >= '[') && (ch <= '^'))) || (ch == '`')) || ((ch >= '{') && (ch <= '~'))

isRegexFlag(ch: Char) -> Bool => isAlpha(ch)

isExponentMarker(ch: Char) -> Bool => (ch == 'e') || (ch == 'E')

isExponentSign(ch: Char) -> Bool => (ch == '+') || (ch == '-')
