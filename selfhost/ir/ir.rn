@"../parser/parser.rn"

+ IRImport: {
  path: String
  go: Bool
  module: Bool
  line: Int
  column: Int
}

+ IRTSImport: {
  path: String
  specifier: String
  functions: Array[IRFunction]
  values: Array[IRConst]
  line: Int
  column: Int
}

+ IRParam: {
  name: String
  typeName: String
  line: Int
  column: Int
}

+ IRExpr: {
  kind: ExprKind
  text: String
  name: String
  value: String
  op: String
  params: Array[IRParam]
  children: Array[IRExpr]
  line: Int
  column: Int
}

+ IRField: {
  name: String
  private: Bool
  typeName: String
  jsonName: String
  jsonIgnore: Bool
  line: Int
  column: Int
}

+ IREnumMember: {
  name: String
  private: Bool
  value: String
  params: Array[IRParam]
  line: Int
  column: Int
}

+ IRFunction: {
  name: String
  private: Bool
  static: Bool
  routine: Bool
  macro: Bool
  receiverType: String
  generics: Array[String]
  params: Array[IRParam]
  returnType: String
  body: IRExpr
  tailLoop: Bool
  tailLoopName: String
  tailLoopGroup: String
  sourcePath: String
  line: Int
  column: Int
}

+ IRConst: {
  name: String
  private: Bool
  typeName: String
  value: IRExpr
  line: Int
  column: Int
}

+ IRStructType: {
  name: String
  private: Bool
  generics: Array[String]
  fields: Array[IRField]
  methods: Array[IRFunction]
  sourcePath: String
  line: Int
  column: Int
}

+ IREnumType: {
  name: String
  private: Bool
  generics: Array[String]
  members: Array[IREnumMember]
  methods: Array[IRFunction]
  sourcePath: String
  line: Int
  column: Int
}

+ IRTest: {
  name: String
  body: IRExpr
  line: Int
  column: Int
}

+ IRFile: {
  imports: Array[IRImport]
  tsImports: Array[IRTSImport]
  structs: Array[IRStructType]
  enums: Array[IREnumType]
  constants: Array[IRConst]
  functions: Array[IRFunction]
  tests: Array[IRTest]
  errors: Array[ParseError]
}

+ lower(source: String) -> IRFile => lowerParsed(parse(source))

+ lowerWithSourcePath(
  source: String,
  sourcePath: String
) -> IRFile => withIRFileSourcePath(lower(source), sourcePath)

+ lowerParsed(
  file: ParsedFile
) -> IRFile => {
  out :=: IRFile {
    imports: [],
    tsImports: [],
    structs: [],
    enums: [],
    constants: [],
    functions: [],
    tests: [],
    errors: file.errors
  }
  file.imports.each((importDecl) => out.imports.push(lowerImport(importDecl)))
  file.constants.each((constant) => out.constants.push(lowerConst(constant)))
  file.types.each((typeDecl) => out = lowerTypeInto(out, typeDecl))
  file.functions.each((fn) => out.functions.push(lowerFunction(fn)))
  file.tests.each((testDecl) => out.tests.push(lowerTest(testDecl)))
  out
}

lowerTypeInto(
  file: IRFile,
  typeDecl: ParsedType
) -> IRFile => (
  typeDecl.enum ? pushEnumType(file, typeDecl)
    : pushStructType(file, typeDecl)
)

pushStructType(
  file: IRFile,
  typeDecl: ParsedType
) -> IRFile => {
  file.structs.push(lowerStructType(typeDecl))
  file
}

pushEnumType(
  file: IRFile,
  typeDecl: ParsedType
) -> IRFile => {
  file.enums.push(lowerEnumType(typeDecl))
  file
}

+ emptyIRExpr() -> IRExpr => {
  kind: ExprKind.Unknown,
  text: "",
  name: "",
  value: "",
  op: "",
  params: [],
  children: [],
  line: 0,
  column: 0
}

+ emptyIRFunction() -> IRFunction => {
  name: "",
  private: false,
  static: false,
  routine: false,
  macro: false,
  receiverType: "",
  generics: [],
  params: [],
  returnType: "",
  body: emptyIRExpr(),
  tailLoop: false,
  tailLoopName: "",
  tailLoopGroup: "",
  sourcePath: "",
  line: 0,
  column: 0
}

lowerImport(
  importDecl: ParsedImport
) -> IRImport => {
  path: importDecl.path,
  go: importDecl.go,
  module: importDecl.module,
  line: importDecl.line,
  column: importDecl.column
}

lowerConst(
  constDecl: ParsedConst
) -> IRConst => {
  name: constDecl.name,
  private: constDecl.private,
  typeName: typeRefToString(constDecl.typeRef),
  value: lowerExpr(constDecl.value),
  line: constDecl.line,
  column: constDecl.column
}

lowerParam(
  param: ParsedParam
) -> IRParam => {
  name: param.name,
  typeName: typeRefToString(param.typeRef),
  line: param.line,
  column: param.column
}

lowerField(
  field: ParsedField
) -> IRField => {
  name: field.name,
  private: field.private,
  typeName: typeRefToString(field.typeRef),
  jsonName: lowerJsonFieldName(field),
  jsonIgnore: lowerHasAnnotation(field.annotations, "#", "json", "ignore", 0),
  line: field.line,
  column: field.column
}

lowerJsonFieldName(
  field: ParsedField
) -> String => lowerJsonFieldNameAt(field.annotations, field.name, 0)

lowerJsonFieldNameAt(
  annotations: Array[ParsedAnnotation],
  fallback: String,
  index: Int
) -> String => {
  done := index >= annotations.length()
  (
    done ? fallback
      : lowerJsonFieldNameStep(annotations, fallback, index)
  )
}

lowerJsonFieldNameStep(
  annotations: Array[ParsedAnnotation],
  fallback: String,
  index: Int
) -> String => {
  annotation := annotations[index]
  matched := (((annotation.marker == "#") && (annotation.module == "json")) && (annotation.name == "name")) && (annotation.args.length() > 0)
  (
    matched ? lowerAnnotationStringArg(annotation, 0, fallback)
      : lowerJsonFieldNameAt(annotations, fallback, index + 1)
  )
}

lowerHasAnnotation(
  annotations: Array[ParsedAnnotation],
  marker: String,
  module: String,
  name: String,
  index: Int
) -> Bool => {
  done := index >= annotations.length()
  (
    done ? false
      : lowerHasAnnotationStep(annotations, marker, module, name, index)
  )
}

lowerHasAnnotationStep(
  annotations: Array[ParsedAnnotation],
  marker: String,
  module: String,
  name: String,
  index: Int
) -> Bool => {
  annotation := annotations[index]
  matched := ((annotation.marker == marker) && (annotation.module == module)) && (annotation.name == name)
  (
    matched ? true
      : lowerHasAnnotation(annotations, marker, module, name, index + 1)
  )
}

lowerAnnotationStringArg(
  annotation: ParsedAnnotation,
  index: Int,
  fallback: String
) -> String => {
  valid := (index < annotation.args.length()) && (annotation.args[index].kind == ExprKind.String)
  (
    valid ? lowerUnquoteString(annotation.args[index].value)
      : fallback
  )
}

lowerUnquoteString(
  raw: String
) -> String => {
  quoted := raw.length() >= 2
  (
    quoted ? raw.slice(1, raw.length() - 1)
      : raw
  )
}

lowerEnumMember(
  member: ParsedEnumMember
) -> IREnumMember => {
  name: member.name,
  private: member.private,
  value: member.value,
  params: lowerParams(member.params),
  line: member.line,
  column: member.column
}

lowerFunction(
  fn: ParsedFunction
) -> IRFunction => {
  name: fn.name,
  private: fn.private,
  static: fn.static,
  routine: fn.routine,
  macro: parsedFunctionCompileTimeOnly(fn),
  receiverType: fn.receiverType,
  generics: fn.generics,
  params: lowerParams(fn.params),
  returnType: typeRefToString(fn.returnType),
  body: lowerExpr(fn.body),
  tailLoop: false,
  tailLoopName: "",
  tailLoopGroup: "",
  sourcePath: "",
  line: fn.line,
  column: fn.column
}

/// Normalize direct self-tail-recursive top-level functions into loop-marked IR.
/// A unique declaration name is required because call IR has not yet retained
/// resolved callable identity; ambiguous imported names remain recursive calls.
+ eliminateSelfTailCalls(
  file: IRFile
) -> IRFile => {
  ..file,
  functions: eliminateMutualTailCalls(eliminateSelfTailCallsInFunctions(file.functions))
}

eliminateSelfTailCallsInFunctions(
  functions: Array[IRFunction]
) -> Array[IRFunction] => {
  out := []
  functions.each((fn) => out.push(markSelfTailLoop(fn, irFunctionNameCount(functions, fn.name, 0))))
  out
}

/// The first mutual-recursion lowering target is the lexer driver pair. Both
/// members have compatible result types but distinct parameter shapes, so the
/// backend emits wrappers and one typed state-machine dispatcher.
eliminateMutualTailCalls(
  functions: Array[IRFunction]
) -> Array[IRFunction] => {
  out := []
  functions.each((fn) => out.push(markScanTailLoopGroup(fn, functions)))
  out
}

markScanTailLoopGroup(
  fn: IRFunction,
  functions: Array[IRFunction]
) -> IRFunction => {
  group := "lexer.scan"
  eligible := (scanTailLoopIsScanName(fn.name) || scanTailLoopIsScanLexedName(fn.name)) && (scanTailLoopNameCount(functions, true, 0) == 1) && (scanTailLoopNameCount(functions, false, 0) == 1) && scanTailLoopGroupIsSafe(fn.body)
  IRFunction {
    ..fn,
    tailLoopGroup: (
      eligible ? group
        : ""
    )
  }
}

scanTailLoopNameCount(
  functions: Array[IRFunction],
  scan: Bool,
  index: Int
) -> Int => (
  index >= functions.length() ? 0
    : ((scan ? scanTailLoopIsScanName(functions[index].name) : scanTailLoopIsScanLexedName(functions[index].name)) ? 1 : 0) + scanTailLoopNameCount(functions, scan, index + 1)
)

scanTailLoopIsScanName(name: String) -> Bool => name.endsWith("_scan") || (name == "scan")

scanTailLoopIsScanLexedName(name: String) -> Bool => name.endsWith("_scanLexed") || (name == "scanLexed")

scanTailLoopLexerSignatureIsSafe(
  functions: Array[IRFunction]
) -> Bool => scanTailLoopFindScanFunction(functions, 0).returnType == "Array[Token]"

scanTailLoopFindScanFunction(
  functions: Array[IRFunction],
  index: Int
) -> IRFunction => (
  index >= functions.length() ? emptyIRFunction()
    : scanTailLoopIsScanName(functions[index].name) ? functions[index]
      : scanTailLoopFindScanFunction(functions, index + 1)
)

scanTailLoopGroupIsSafe(
  expr: IRExpr
) -> Bool => expr.kind {
  ExprKind.Block => scanTailLoopBlockIsSafe(expr.children, 0)
  ExprKind.Ternary => (
    expr.children.length() == 3 ? (!scanTailLoopContainsCall(expr.children[0]) && scanTailLoopGroupIsSafe(expr.children[1])) && scanTailLoopGroupIsSafe(expr.children[2])
      : false
  )
  ExprKind.Call => (
    scanTailLoopIsMemberCall(expr) ? true
      : !scanTailLoopContainsCall(expr)
  )
  _ => !scanTailLoopContainsCall(expr)
}

scanTailLoopBlockIsSafe(
  children: Array[IRExpr],
  index: Int
) -> Bool => (
  children.length() == 0 ? false
    : index >= (children.length() - 1) ? scanTailLoopGroupIsSafe(children[children.length() - 1])
      : !scanTailLoopContainsCall(children[index]) && scanTailLoopBlockIsSafe(children, index + 1)
)

scanTailLoopContainsCall(
  expr: IRExpr
) -> Bool => (
  scanTailLoopIsMemberCall(expr) ? true
    : scanTailLoopChildrenContainCall(expr.children, 0)
)

scanTailLoopChildrenContainCall(
  children: Array[IRExpr],
  index: Int
) -> Bool => (
  index >= children.length() ? false
    : scanTailLoopContainsCall(children[index]) || scanTailLoopChildrenContainCall(children, index + 1)
)

scanTailLoopIsMemberCall(
  expr: IRExpr
) -> Bool => (
  ((expr.kind == ExprKind.Call) && (expr.children.length() > 0)) && (expr.children[0].kind == ExprKind.Identifier) ? scanTailLoopIsScanName(expr.children[0].name) || scanTailLoopIsScanLexedName(expr.children[0].name)
    : false
)

irFunctionNameCount(
  functions: Array[IRFunction],
  name: String,
  index: Int
) -> Int => (
  index >= functions.length() ? 0
    : (functions[index].name == name ? 1 : 0) + irFunctionNameCount(functions, name, index + 1)
)

markSelfTailLoop(
  fn: IRFunction,
  nameCount: Int
) -> IRFunction => {
  eligible := (((((((fn.returnType != "") && (fn.returnType != "Void")) && !fn.routine) && !fn.macro) && (fn.receiverType == "")) && ((fn.generics.length() == 0) && (fn.params.length() > 0))) && (nameCount == 1)) && (irExprContainsSelfCall(fn.body, fn.name) && tailLoopExprIsSafe(fn.body, fn.name, fn.params.length()))
  IRFunction {
    ..fn,
    tailLoop: eligible,
    tailLoopName: (
      eligible ? fn.name
        : ""
    )
  }
}

irExprContainsSelfCall(
  expr: IRExpr,
  name: String
) -> Bool => (
  isDirectSelfCall(expr, name, -1) ? true
    : irExprChildrenContainSelfCall(expr.children, name, 0)
)

irExprChildrenContainSelfCall(
  children: Array[IRExpr],
  name: String,
  index: Int
) -> Bool => (
  index >= children.length() ? false
    : irExprContainsSelfCall(children[index], name) || irExprChildrenContainSelfCall(children, name, index + 1)
)

isDirectSelfCall(
  expr: IRExpr,
  name: String,
  arity: Int
) -> Bool => (
  ((expr.kind == ExprKind.Call) && (expr.children.length() > 0)) && (expr.children[0].kind == ExprKind.Identifier) ? ((expr.children[0].name == name) && ((arity < 0) || ((expr.children.length() - 1) == arity)))
    : false
)

/// Only ternary branches are considered tail contexts. Any self call in a
/// condition or ordinary expression subtree disables the transformation.
tailLoopExprIsSafe(
  expr: IRExpr,
  name: String,
  arity: Int
) -> Bool => expr.kind {
  ExprKind.Ternary => (
    expr.children.length() == 3 ? (!irExprContainsSelfCall(expr.children[0], name) && tailLoopExprIsSafe(expr.children[1], name, arity)) && tailLoopExprIsSafe(expr.children[2], name, arity)
      : false
  )
  ExprKind.Call => (
    isDirectSelfCall(expr, name, arity) ? true
      : !irExprContainsSelfCall(expr, name)
  )
  _ => !irExprContainsSelfCall(expr, name)
}

+ withIRFileSourcePath(
  file: IRFile,
  sourcePath: String
) -> IRFile => {
  ..file,
  structs: withIRStructSourcePaths(file.structs, sourcePath),
  enums: withIREnumSourcePaths(file.enums, sourcePath),
  functions: withIRFunctionSourcePaths(file.functions, sourcePath)
}

withIRFunctionSourcePath(
  fn: IRFunction,
  sourcePath: String
) -> IRFunction => {
  ..fn,
  sourcePath: sourcePath
}

withIRFunctionSourcePaths(
  functions: Array[IRFunction],
  sourcePath: String
) -> Array[IRFunction] => {
  out := []
  functions.each((fn) => out.push(withIRFunctionSourcePath(fn, sourcePath)))
  out
}

withIRStructSourcePath(
  typeDecl: IRStructType,
  sourcePath: String
) -> IRStructType => {
  ..typeDecl,
  methods: withIRFunctionSourcePaths(typeDecl.methods, sourcePath),
  sourcePath: sourcePath
}

withIRStructSourcePaths(
  structs: Array[IRStructType],
  sourcePath: String
) -> Array[IRStructType] => {
  out := []
  structs.each((typeDecl) => out.push(withIRStructSourcePath(typeDecl, sourcePath)))
  out
}

withIREnumSourcePath(
  typeDecl: IREnumType,
  sourcePath: String
) -> IREnumType => {
  ..typeDecl,
  methods: withIRFunctionSourcePaths(typeDecl.methods, sourcePath),
  sourcePath: sourcePath
}

withIREnumSourcePaths(
  enums: Array[IREnumType],
  sourcePath: String
) -> Array[IREnumType] => {
  out := []
  enums.each((typeDecl) => out.push(withIREnumSourcePath(typeDecl, sourcePath)))
  out
}

parsedFunctionCompileTimeOnly(
  fn: ParsedFunction
) -> Bool => (fn.macro || typeRefIsSyntaxOnly(fn.returnType)) || paramsUseSyntaxOnly(fn.params, 0)

paramsUseSyntaxOnly(
  params: Array[ParsedParam],
  index: Int
) -> Bool => (
  index >= params.length() ? false
    : typeRefIsSyntaxOnly(params[index].typeRef) || paramsUseSyntaxOnly(params, index + 1)
)

typeRefIsSyntaxOnly(
  typeRef: ParsedTypeRef
) -> Bool => {
  name := typeRefToString(typeRef)
  name.startsWith("Syntax") || (name == "MacroContext")
}

lowerStructType(
  typeDecl: ParsedType
) -> IRStructType => {
  name: typeDecl.name,
  private: typeDecl.private,
  generics: typeDecl.generics,
  fields: lowerFields(typeDecl.fields),
  methods: lowerFunctions(typeDecl.methods),
  sourcePath: "",
  line: typeDecl.line,
  column: typeDecl.column
}

lowerEnumType(
  typeDecl: ParsedType
) -> IREnumType => {
  name: typeDecl.name,
  private: typeDecl.private,
  generics: typeDecl.generics,
  members: lowerEnumMembers(typeDecl.members),
  methods: lowerFunctions(typeDecl.methods),
  sourcePath: "",
  line: typeDecl.line,
  column: typeDecl.column
}

lowerTest(
  testDecl: ParsedTest
) -> IRTest => {
  name: testDecl.name,
  body: lowerExpr(testDecl.body),
  line: testDecl.line,
  column: testDecl.column
}

lowerExpr(expr: ParsedExpr) -> IRExpr => {
  children := lowerExprs(expr.children)
  IRExpr {
    kind: expr.kind,
    text: inferIRExprText(expr, children),
    name: expr.name,
    value: expr.value,
    op: expr.op,
    params: lowerParams(expr.params),
    children: children,
    line: expr.line,
    column: expr.column
  }
}

inferIRExprText(
  expr: ParsedExpr,
  children: Array[IRExpr]
) -> String => expr.kind {
  ExprKind.Let => expr.value
  ExprKind.Binary => inferIRBinaryText(expr, children)
  ExprKind.Call => inferIRCallText(children)
  ExprKind.String => "String"
  ExprKind.Template => "String"
  ExprKind.XMLText => "String"
  ExprKind.XMLElement => "HTMLElement"
  ExprKind.Int => "Int"
  ExprKind.Double => "Double"
  ExprKind.BigInt => "BigInt"
  ExprKind.Char => "Char"
  ExprKind.Bool => "Bool"
  ExprKind.Null => "Null"
  _ => (
    expr.text != "" ? expr.text
      : ""
  )
}

inferIRBinaryText(
  expr: ParsedExpr,
  children: Array[IRExpr]
) -> String => (
  expr.op == "??" ? inferIRCoalesceText(children)
    : ""
)

inferIRCoalesceText(
  children: Array[IRExpr]
) -> String => (
  children.length() < 2 ? ""
    : (
      (children[1].text != "") && (children[1].text != "Null") ? children[1].text
        : children[0].text
    )
)

inferIRCallText(
  children: Array[IRExpr]
) -> String => (
  children.length() == 0 ? ""
    : (
      children[0].kind == ExprKind.Selector ? inferIRSelectorCallText(children[0], children)
        : ""
    )
)

inferIRSelectorCallText(
  selector: IRExpr,
  children: Array[IRExpr]
) -> String => selector.name {
  "getOr" => (
    children.length() > 2 ? children[2].text
      : ""
  )
  "isEmpty" => "Bool"
  "length" | "byteLength" | "size" | "push" => "Int"
  "includes" | "contains" | "startsWith" | "endsWith" => "Bool"
  "toString" | "trim" | "toUpperCase" | "toLowerCase" => "String"
  _ => ""
}

lowerParams(
  params: Array[ParsedParam]
) -> Array[IRParam] => {
  out := []
  params.each((param) => out.push(lowerParam(param)))
  out
}

lowerFields(
  fields: Array[ParsedField]
) -> Array[IRField] => {
  out := []
  fields.each((field) => out.push(lowerField(field)))
  out
}

lowerEnumMembers(
  members: Array[ParsedEnumMember]
) -> Array[IREnumMember] => {
  out := []
  members.each((member) => out.push(lowerEnumMember(member)))
  out
}

lowerFunctions(
  functions: Array[ParsedFunction]
) -> Array[IRFunction] => {
  out := []
  functions.each((fn) => out.push(lowerFunction(fn)))
  out
}

lowerExprs(
  exprs: Array[ParsedExpr]
) -> Array[IRExpr] => {
  out := []
  exprs.each((expr) => out.push(lowerExpr(expr)))
  out
}
