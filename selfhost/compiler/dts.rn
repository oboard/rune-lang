@"../ir/ir.rn"
@"../lexer/lexer.rn"
@"../parser/ast.rn"
@"./common.rn"

/// Generate a `.d.ts` declaration file describing the public surface of a
/// compiled Rune module.  Keep this byte-for-byte compatible with the host
/// TypeScript declaration generator where the self-host IR retains the data.
+ generateDeclarations(
  file: IRFile
) -> String => {
  out :=: dtsPreamble()
  out = out + dtsStructs(file.structs, 0)
  out = out + dtsEnums(file.enums, 0)
  out = out + dtsConsts(file.constants, 0)
  out = out + dtsFunctions(file.functions, 0)
  out + dtsExports(file)
}

dtsPreamble() -> String => `type RuneResult<T, E> = { ok: true; value: T } | { ok: false; error: E };
type RuneError = { code: number; message: string; cause: RuneError | null };
type RuneIter<T> = { next: () => [T, boolean] };
type RuneFileStat = { size: number; isFile: boolean; isDirectory: boolean };
type RuneTCPConnection = { socket: unknown };
type RuneTCPListener = { server: unknown; address: string };
declare class RuneStringBuffer {}
declare class RuneBuffer {}
declare class RuneReader {}
declare class RuneWriter {}

`

dtsStructs(
  structs: Array[IRStructType],
  index: Int
) -> String => (
  index >= structs.length() ? ""
    : (
      structs[index].private ? dtsStructs(structs, index + 1)
        : dtsStruct(structs[index]) + dtsStructs(structs, index + 1)
    )
)

dtsStruct(
  typeDecl: IRStructType
) -> String => {
  generics := dtsGenerics(typeDecl.generics)
  out :=: (("type " + mangleIdent(typeDecl.name)) + generics) + " = {\n"
  out = out + dtsStructFields(typeDecl.fields, 0)
  (out + "};\n") + "\n"
}

dtsStructFields(
  fields: Array[IRField],
  index: Int
) -> String => (
  index >= fields.length() ? ""
    : (
      fields[index].private ? dtsStructFields(fields, index + 1)
        : ((((indent(1) + dtsPropertyName(fields[index].name)) + ": ") + dtsType(fields[index].typeName)) + ";\n") + dtsStructFields(fields, index + 1)
    )
)

dtsEnums(
  enums: Array[IREnumType],
  index: Int
) -> String => (
  index >= enums.length() ? ""
    : (
      enums[index].private ? dtsEnums(enums, index + 1)
        : dtsEnum(enums[index]) + dtsEnums(enums, index + 1)
    )
)

dtsEnum(enumDecl: IREnumType) -> String => {
  name := mangleIdent(enumDecl.name)
  generics := dtsGenerics(enumDecl.generics)
  shape := dtsEnumHasPayload(enumDecl.members, 0) {
    true => "{ tag: number; payload: any[] }"
    false => "number"
  }
  out :=: (((("type " + name) + generics) + " = ") + shape) + ";\n"
  out = ((out + "declare const ") + name) + ": {\n"
  out = out + dtsEnumMembers(enumDecl.members, 0)
  (out + "};\n") + "\n"
}

dtsEnumHasPayload(
  members: Array[IREnumMember],
  index: Int
) -> Bool => (
  index >= members.length() ? false
    : (
      members[index].params.length() > 0 ? true
        : dtsEnumHasPayload(members, index + 1)
    )
)

dtsEnumMembers(
  members: Array[IREnumMember],
  index: Int
) -> String => (
  index >= members.length() ? ""
    : dtsEnumMembersAt(members, index)
)

dtsEnumMembersAt(
  members: Array[IREnumMember],
  index: Int
) -> String => (
  members[index].private ? dtsEnumMembers(members, index + 1)
    : (((((indent(1) + "readonly ") + dtsPropertyName(members[index].name)) + ": ") + enumValue(members[index], index)) + ";\n") + dtsEnumMembers(members, index + 1)
)

dtsConsts(
  constants: Array[IRConst],
  index: Int
) -> String => (
  index >= constants.length() ? ""
    : dtsConstsAt(constants, index)
)

dtsConstsAt(
  constants: Array[IRConst],
  index: Int
) -> String => (
  constants[index].private ? dtsConsts(constants, index + 1)
    : (((("declare const " + mangleIdent(constants[index].name)) + ": ") + dtsType(constants[index].typeName)) + ";\n") + dtsConsts(constants, index + 1)
)

dtsFunctions(
  functions: Array[IRFunction],
  index: Int
) -> String => (
  index >= functions.length() ? ""
    : dtsFunctionAt(functions, index) + dtsFunctions(functions, index + 1)
)

dtsFunctionAt(
  functions: Array[IRFunction],
  index: Int
) -> String => (
  functions[index].macro || functions[index].private ? ""
    : dtsFunction(functions[index])
)

dtsFunction(fn: IRFunction) -> String => {
  returnType := dtsType(fn.returnType)
  wrapped := fn.routine {
    true => ("Promise<" + returnType) + ">"
    false => returnType
  }
  (((((("declare function " + mangleIdent(fn.name)) + dtsGenerics(fn.generics)) + "(") + dtsParams(fn.params, 0, "")) + "): ") + wrapped) + ";\n"
}

dtsGenerics(
  generics: Array[String]
) -> String => (
  generics.length() == 0 ? ""
    : ("<" + dtsGenericNames(generics, 0, "")) + ">"
)

dtsGenericNames(
  generics: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= generics.length() ? out
    : dtsGenericNames(generics, index + 1, ((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(generics[index])) + " extends unknown")
)

dtsParams(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : dtsParams(params, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(params[index].name)) + ": ") + dtsType(params[index].typeName))
)

dtsType(typeName: String) -> String => dtsTypeRef(parseDtsTypeRef(typeName))

parseDtsTypeRef(typeName: String) -> ParsedTypeRef => dtsTypeRefPostfix(lex(typeName), 0, dtsTypeRoot(typeName))

dtsTypeRoot(typeName: String) -> ParsedTypeRef => {
  first := dtsFirstTypeToken(lex(typeName), 0)
  first.kind {
    TokenKind.BitAnd => namedParsedTypeRef(dtsTypeToken("Dynamic"))
    TokenKind.At => dtsQualifiedTypeRef(lex(typeName), first)
    TokenKind.LParen => dtsParenTypeRef(typeName, first)
    TokenKind.Ident => namedParsedTypeRef(first)
    _ => namedParsedTypeRef(dtsTypeToken(typeName))
  }
}

dtsFirstTypeToken(
  tokens: Array[Token],
  index: Int
) -> Token => (
  index >= tokens.length() ? dtsTypeToken("Dynamic")
    : (
      tokens[index].kind == TokenKind.EOF ? dtsTypeToken("Dynamic")
        : tokens[index]
    )
)

dtsQualifiedTypeRef(
  tokens: Array[Token],
  at: Token
) -> ParsedTypeRef => {
  module := dtsTokenAt(tokens, 1)
  name := dtsTokenAt(tokens, 3)
  (module.kind == TokenKind.Ident) && (name.kind == TokenKind.Ident) ? qualifiedParsedTypeRef(module, name)
    : namedParsedTypeRef(dtsTypeToken("Dynamic"))
}

dtsParenTypeRef(
  typeName: String,
  open: Token
) -> ParsedTypeRef => {
  close := typeName.lastIndexOf(")")
  inner := (
    close > 0 ? typeName.slice(1, close)
      : ""
  )
  parts := dtsSplitTopLevelTypeArgs(inner)
  parts.length() == 1 ? groupedTypeRef(parseDtsTypeRef(parts[0]), open)
    : tupleTypeRef(dtsTupleParamsFromStrings(parts, 0, []), open)
}

dtsTypeToken(typeName: String) -> Token => {
  kind: TokenKind.Ident,
  lexeme: typeName,
  offset: 0,
  line: 0,
  column: 0
}

dtsTypeRefPostfix(
  tokens: Array[Token],
  index: Int,
  typeRef: ParsedTypeRef
) -> ParsedTypeRef => (
  index >= tokens.length() ? typeRef
    : dtsTypeRefPostfixStep(tokens, index, typeRef)
)

dtsTypeRefPostfixStep(
  tokens: Array[Token],
  index: Int,
  typeRef: ParsedTypeRef
) -> ParsedTypeRef => {
  token := tokens[index]
  token.kind {
    TokenKind.LBracket => dtsTypeRefPostfix(tokens, dtsSkipBracket(tokens, index + 1, 1), dtsApplyTypeArgs(typeRef, dtsBracketArgs(tokens, index)))
    TokenKind.Question => dtsTypeRefPostfix(tokens, index + 1, nullableTypeRef(typeRef))
    _ => dtsTypeRefPostfix(tokens, index + 1, typeRef)
  }
}

dtsApplyTypeArgs(
  typeRef: ParsedTypeRef,
  args: Array[ParsedTypeRef]
) -> ParsedTypeRef => typeRefWithArgs(typeRef, args)

dtsBracketArgs(
  tokens: Array[Token],
  open: Int
) -> Array[ParsedTypeRef] => {
  close := dtsBracketClose(tokens, open + 1, 1)
  inner := dtsTokenRangeText(tokens, open + 1, close, "")
  parts := dtsSplitTopLevelTypeArgs(inner)
  dtsTypeRefsFromStrings(parts, 0, [])
}

dtsBracketClose(
  tokens: Array[Token],
  index: Int,
  depth: Int
) -> Int => (
  index >= tokens.length() ? index
    : (
      tokens[index].kind == TokenKind.LBracket ? dtsBracketClose(tokens, index + 1, depth + 1)
        : (
          tokens[index].kind == TokenKind.RBracket ? (
            depth == 1 ? index
              : dtsBracketClose(tokens, index + 1, depth - 1)
          )
            : dtsBracketClose(tokens, index + 1, depth)
        )
    )
)

dtsSkipBracket(
  tokens: Array[Token],
  index: Int,
  depth: Int
) -> Int => (
  index >= tokens.length() ? index
    : (
      tokens[index].kind == TokenKind.LBracket ? dtsSkipBracket(tokens, index + 1, depth + 1)
        : (
          tokens[index].kind == TokenKind.RBracket ? (
            depth == 1 ? index + 1
              : dtsSkipBracket(tokens, index + 1, depth - 1)
          )
            : dtsSkipBracket(tokens, index + 1, depth)
        )
    )
)

dtsTokenAt(
  tokens: Array[Token],
  index: Int
) -> Token => (
  index >= tokens.length() ? dtsTypeToken("Dynamic")
    : tokens[index]
)

dtsTokenRangeText(
  tokens: Array[Token],
  index: Int,
  endExclusive: Int,
  out: String
) -> String => (
  (index >= endExclusive) || (index >= tokens.length()) ? out
    : dtsTokenRangeText(tokens, index + 1, endExclusive, out + tokens[index].lexeme)
)

dtsSplitTopLevelTypeArgs(source: String) -> Array[String] => dtsSplitTopLevelTypeArgsLoop(source, 0, 0, 0, [])

dtsSplitTopLevelTypeArgsLoop(
  source: String,
  index: Int,
  start: Int,
  depth: Int,
  out: Array[String]
) -> Array[String] => (
  index >= source.length() ? dtsPushTypeArg(out, source.slice(start, source.length()).trim())
    : dtsSplitTopLevelTypeArgsStep(source, index, start, depth, out)
)

dtsSplitTopLevelTypeArgsStep(
  source: String,
  index: Int,
  start: Int,
  depth: Int,
  out: Array[String]
) -> Array[String] => {
  ch := source.at(index)
  ch {
    '[' | '(' => dtsSplitTopLevelTypeArgsLoop(source, index + 1, start, depth + 1, out)
    ']' | ')' => dtsSplitTopLevelTypeArgsLoop(source, index + 1, start, depth - 1, out)
    ',' => (
      depth == 0 ? dtsSplitTopLevelTypeArgsLoop(source, index + 1, index + 1, depth, dtsPushTypeArg(out, source.slice(start, index).trim()))
        : dtsSplitTopLevelTypeArgsLoop(source, index + 1, start, depth, out)
    )
    _ => dtsSplitTopLevelTypeArgsLoop(source, index + 1, start, depth, out)
  }
}

dtsPushTypeArg(
  out: Array[String],
  item: String
) -> Array[String] => {
  item != "" ? out.push(item)
  out
}

dtsTypeRefsFromStrings(
  parts: Array[String],
  index: Int,
  out: Array[ParsedTypeRef]
) -> Array[ParsedTypeRef] => {
  index >= parts.length() ? out
    : dtsTypeRefsFromStringsPush(parts, index, out)
}

dtsTypeRefsFromStringsPush(
  parts: Array[String],
  index: Int,
  out: Array[ParsedTypeRef]
) -> Array[ParsedTypeRef] => {
  out.push(parseDtsTypeRef(parts[index]))
  dtsTypeRefsFromStrings(parts, index + 1, out)
}

dtsTupleParamsFromStrings(
  parts: Array[String],
  index: Int,
  out: Array[ParsedTypeParam]
) -> Array[ParsedTypeParam] => {
  index >= parts.length() ? out
    : dtsTupleParamsFromStringsPush(parts, index, out)
}

dtsTupleParamsFromStringsPush(
  parts: Array[String],
  index: Int,
  out: Array[ParsedTypeParam]
) -> Array[ParsedTypeParam] => {
  param := emptyParsedTypeParam()
  param.name = ""
  param.optional = false
  param.typeRef = parseDtsTypeRef(parts[index])
  out.push(param)
  dtsTupleParamsFromStrings(parts, index + 1, out)
}

clearNullableTypeRef(typeRef: ParsedTypeRef) -> ParsedTypeRef => {
  kind: typeRef.kind,
  name: typeRef.name,
  module: typeRef.module,
  nullable: false,
  args: typeRef.args,
  params: typeRef.params,
  returnTypes: typeRef.returnTypes,
  line: typeRef.line,
  column: typeRef.column
}

dtsTypeRef(typeRef: ParsedTypeRef) -> String => {
  typeRef.nullable {
    true => dtsNullableTypeRef(typeRef)
    false => dtsPlainTypeRef(typeRef)
  }
}

dtsNullableTypeRef(typeRef: ParsedTypeRef) -> String => dtsTypeRef(clearNullableTypeRef(typeRef)) + " | null"

dtsPlainTypeRef(typeRef: ParsedTypeRef) -> String => typeRef.kind {
  TypeRefKind.Name => dtsNamedTypeRef(typeRef)
  TypeRefKind.Group => dtsGroupedTypeRef(typeRef)
  TypeRefKind.Tuple => dtsTupleTypeRef(typeRef)
  TypeRefKind.Function => dtsFunctionTypeRef(typeRef)
  _ => "any"
}

dtsNamedTypeRef(typeRef: ParsedTypeRef) -> String => {
  typeName := dtsQualifiedTypeName(typeRef)
  typeName {
    "" | "Void" => "void"
    "Int" | "Int4" | "Int8" | "Int16" | "UInt" | "UInt8" | "UInt16" | "Byte" | "Double" | "Float" => "number"
    "BigInt" | "Int64" | "UInt64" => "bigint"
    "String" | "Char" => "string"
    "Bool" => "boolean"
    "Null" => "null"
    "Object" => "object"
    "Bytes" => "DataView"
    "Buffer" => "RuneBuffer"
    "Reader" => "RuneReader"
    "Writer" => "RuneWriter"
    "StringBuffer" => "RuneStringBuffer"
    "FileStat" => "RuneFileStat"
    "TCPConnection" => "RuneTCPConnection"
    "TCPListener" => "RuneTCPListener"
    "Data" | "@io.Data" => "Uint8Array"
    "Error" => "RuneError"
    "Never" => "never"
    "Symbol" => "symbol"
    "Regex" => "RegExp"
    "HTMLElement" => "HTMLElement"
    "WebComponent" => "CustomElementConstructor"
    "Dynamic" | "Unknown" => "any"
    _ => dtsStructuredNamedTypeRef(typeRef)
  }
}

dtsQualifiedTypeName(typeRef: ParsedTypeRef) -> String => (
  typeRef.module == "" ? typeRef.name
    : ("@" + typeRef.module) + "." + typeRef.name
)

dtsStructuredNamedTypeRef(typeRef: ParsedTypeRef) -> String => {
  dtsQualifiedTypeName(typeRef) {
    "Array" => dtsArrayTypeRef(typeRef)
    "Result" => dtsGenericTypeRef("RuneResult", typeRef.args)
    "Task" => dtsGenericTypeRef("Promise", typeRef.args)
    "Iter" => dtsGenericTypeRef("RuneIter", typeRef.args)
    "ReadonlyArray" => dtsGenericTypeRef("ReadonlyArray", typeRef.args)
    "Tuple" => dtsTupleArgs(typeRef.args, false)
    "ReadonlyTuple" => dtsTupleArgs(typeRef.args, true)
    "Map" => dtsGenericTypeRef("Map", typeRef.args)
    "Set" => dtsGenericTypeRef("Set", typeRef.args)
    "WeakMap" => dtsGenericTypeRef("WeakMap", typeRef.args)
    "WeakSet" => dtsGenericTypeRef("WeakSet", typeRef.args)
    "Record" => dtsGenericTypeRef("Record", typeRef.args)
    _ => dtsNamedType(typeRef)
  }
}

dtsArrayTypeRef(typeRef: ParsedTypeRef) -> String => (
  typeRef.args.length() == 0 ? "any[]"
    : dtsTypeRef(typeRef.args[0]) + "[]"
)

dtsGenericTypeRef(
  name: String,
  args: Array[ParsedTypeRef]
) -> String => ((name + "<") + dtsTypeRefs(args, 0, "")) + ">"

dtsNamedType(typeRef: ParsedTypeRef) -> String => {
  prefix := (
    typeRef.module == "" ? ""
      : ("@" + typeRef.module) + "."
  )
  (
    typeRef.args.length() == 0 ? mangleIdent(prefix + typeRef.name)
      : ((mangleIdent(prefix + typeRef.name) + "<") + dtsTypeRefs(typeRef.args, 0, "")) + ">"
  )
}

dtsGroupedTypeRef(typeRef: ParsedTypeRef) -> String => (
  typeRef.args.length() == 0 ? "()"
    : ("(" + dtsTypeRef(typeRef.args[0])) + ")"
)

dtsTupleTypeRef(typeRef: ParsedTypeRef) -> String => dtsTupleParams(typeRef.params, false)

dtsTupleParams(
  params: Array[ParsedTypeParam],
  readonly: Bool
) -> String => {
  items := dtsTypeParams(params, 0, "")
  readonly ? ("readonly [" + items) + "]"
    : ("[" + items) + "]"
}

dtsTupleArgs(
  args: Array[ParsedTypeRef],
  readonly: Bool
) -> String => {
  items := dtsTypeRefs(args, 0, "")
  readonly ? ("readonly [" + items) + "]"
    : ("[" + items) + "]"
}

dtsFunctionTypeRef(typeRef: ParsedTypeRef) -> String => {
  ret := typeRef.returnTypes.length() == 0 ? "void"
    : dtsTypeRef(typeRef.returnTypes[0])
  (("(" + dtsTypeParams(typeRef.params, 0, "")) + ") => ") + ret
}

dtsTypeRefs(
  refs: Array[ParsedTypeRef],
  index: Int,
  out: String
) -> String => (
  index >= refs.length() ? out
    : dtsTypeRefs(refs, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + dtsTypeRef(refs[index]))
)

dtsTypeParams(
  params: Array[ParsedTypeParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : dtsTypeParams(params, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + dtsTypeParam(params[index]))
)

dtsTypeParam(param: ParsedTypeParam) -> String => {
  prefix := (
    param.name == "" ? ""
      : mangleIdent(param.name) + (
        param.optional ? "?: "
          : ": "
      )
  )
  prefix + dtsTypeRef(param.typeRef)
}

dtsExports(file: IRFile) -> String => (
  (((file.structs.length() + file.enums.length()) + file.constants.length()) + file.functions.length()) == 0 ? ""
    : ((("\n" + dtsStructExports(file.structs, 0)) + dtsEnumExports(file.enums, 0)) + dtsConstExports(file.constants, 0)) + dtsFunctionExports(file.functions, 0)
)

dtsStructExports(
  structs: Array[IRStructType],
  index: Int
) -> String => (
  index >= structs.length() ? ""
    : (
      structs[index].private ? dtsStructExports(structs, index + 1)
        : dtsExportTypeAlias(structs[index].name) + dtsStructExports(structs, index + 1)
    )
)

dtsEnumExports(
  enums: Array[IREnumType],
  index: Int
) -> String => (
  index >= enums.length() ? ""
    : (
      enums[index].private ? dtsEnumExports(enums, index + 1)
        : (dtsExportTypeAlias(enums[index].name) + dtsExportValueAlias(enums[index].name)) + dtsEnumExports(enums, index + 1)
    )
)

dtsConstExports(
  constants: Array[IRConst],
  index: Int
) -> String => (
  index >= constants.length() ? ""
    : (
      constants[index].private ? dtsConstExports(constants, index + 1)
        : dtsExportValueAlias(constants[index].name) + dtsConstExports(constants, index + 1)
    )
)

dtsFunctionExports(
  functions: Array[IRFunction],
  index: Int
) -> String => (
  index >= functions.length() ? ""
    : (
      functions[index].macro || functions[index].private ? dtsFunctionExports(functions, index + 1)
        : dtsExportValueAlias(functions[index].name) + dtsFunctionExports(functions, index + 1)
    )
)

dtsExportTypeAlias(
  name: String
) -> String => (
  dtsCanUseBareProperty(name) ? ((("export type " + name) + " = ") + mangleIdent(name)) + ";\n"
    : ((("export type { " + mangleIdent(name)) + " as ") + dtsExportName(name)) + " };\n"
)

dtsExportValueAlias(
  name: String
) -> String => (
  dtsCanUseBareProperty(name) ? ((("export declare const " + name) + ": typeof ") + mangleIdent(name)) + ";\n"
    : ((("export { " + mangleIdent(name)) + " as ") + dtsExportName(name)) + " };\n"
)

dtsPropertyName(name: String) -> String => (
  dtsCanUseBareProperty(name) ? name
    : dtsQuoteName(name)
)

dtsExportName(name: String) -> String => dtsPropertyName(name)

dtsQuoteName(name: String) -> String => ("\"" + dtsEscapeName(name, 0, "")) + "\""

dtsEscapeName(
  name: String,
  index: Int,
  out: String
) -> String => (
  index >= name.length() ? out
    : dtsEscapeName(name, index + 1, out + dtsEscapeNameChar(name.at(index)))
)

dtsEscapeNameChar(ch: Char) -> String => ch {
  '\\' => "\\\\"
  '"' => "\\\""
  '\n' => "\\n"
  '\r' => "\\r"
  '\t' => "\\t"
  _ => ch.toString()
}

dtsCanUseBareProperty(
  name: String
) -> Bool => ((name != "") && (dtsReservedName(name) == false)) && dtsSafeIdent(name, 0, true)

dtsSafeIdent(
  name: String,
  index: Int,
  first: Bool
) -> Bool => (
  index >= name.length() ? true
    : (
      dtsSafeIdentChar(name.at(index), first) ? dtsSafeIdent(name, index + 1, false)
        : false
    )
)

dtsSafeIdentChar(
  ch: Char,
  first: Bool
) -> Bool => ch {
  '_' | '$' | 'a'..='z' | 'A'..='Z' => true
  '0'..='9' => first == false
  _ => false
}

dtsReservedName(name: String) -> Bool => name ~ ("await" | "break" | "case" | "catch" | "class" | "const" | "continue" | "debugger" | "default" | "delete" | "do" | "else" | "enum" | "export" | "extends" | "false" | "finally" | "for" | "function" | "if" | "implements" | "import" | "in" | "instanceof" | "interface" | "let" | "new" | "null" | "package" | "private" | "protected" | "public" | "return" | "static" | "super" | "switch" | "this" | "throw" | "true" | "try" | "typeof" | "var" | "void" | "while" | "with" | "yield")
