@"../ir/ir.rn"
@"./common.rn"

/// Generate a `.d.ts` declaration file describing the public surface of a
/// compiled Rune module.  Keep this byte-for-byte compatible with the host
/// TypeScript declaration generator where the self-host IR retains the data.
+ generateDeclarations(
  file: IRFile
) -> String => {
  out :=: dtsPreamble()
  out = out + dtsStructs(file.structs, 0)
  out = out + dtsEnums(file.enums, 0)
  out = out + dtsConsts(file.constants, 0)
  out = out + dtsFunctions(file.functions, 0)
  out + dtsExports(file)
}

dtsPreamble() -> String => `type RuneResult<T, E> = { ok: true; value: T } | { ok: false; error: E };
type RuneError = { code: number; message: string; cause: RuneError | null };
type RuneIter<T> = { next: () => [T, boolean] };
type RuneFileStat = { size: number; isFile: boolean; isDirectory: boolean };
type RuneTCPConnection = { socket: unknown };
type RuneTCPListener = { server: unknown; address: string };
declare class RuneStringBuffer {}
declare class RuneBuffer {}
declare class RuneReader {}
declare class RuneWriter {}

`

dtsStructs(
  structs: Array[IRStructType],
  index: Int
) -> String => (
  index >= structs.length() ? ""
    : (
      structs[index].private ? dtsStructs(structs, index + 1)
        : dtsStruct(structs[index]) + dtsStructs(structs, index + 1)
    )
)

dtsStruct(
  typeDecl: IRStructType
) -> String => {
  generics := dtsGenerics(typeDecl.generics)
  out :=: (("type " + mangleIdent(typeDecl.name)) + generics) + " = {\n"
  out = out + dtsStructFields(typeDecl.fields, 0)
  (out + "};\n") + "\n"
}

dtsStructFields(
  fields: Array[IRField],
  index: Int
) -> String => (
  index >= fields.length() ? ""
    : (
      fields[index].private ? dtsStructFields(fields, index + 1)
        : ((((indent(1) + dtsPropertyName(fields[index].name)) + ": ") + dtsType(fields[index].typeName)) + ";\n") + dtsStructFields(fields, index + 1)
    )
)

dtsEnums(
  enums: Array[IREnumType],
  index: Int
) -> String => (
  index >= enums.length() ? ""
    : (
      enums[index].private ? dtsEnums(enums, index + 1)
        : dtsEnum(enums[index]) + dtsEnums(enums, index + 1)
    )
)

dtsEnum(enumDecl: IREnumType) -> String => {
  name := mangleIdent(enumDecl.name)
  generics := dtsGenerics(enumDecl.generics)
  shape := dtsEnumHasPayload(enumDecl.members, 0) {
    true => "{ tag: number; payload: any[] }"
    false => "number"
  }
  out :=: (((("type " + name) + generics) + " = ") + shape) + ";\n"
  out = ((out + "declare const ") + name) + ": {\n"
  out = out + dtsEnumMembers(enumDecl.members, 0)
  (out + "};\n") + "\n"
}

dtsEnumHasPayload(
  members: Array[IREnumMember],
  index: Int
) -> Bool => (
  index >= members.length() ? false
    : (
      members[index].params.length() > 0 ? true
        : dtsEnumHasPayload(members, index + 1)
    )
)

dtsEnumMembers(
  members: Array[IREnumMember],
  index: Int
) -> String => (
  index >= members.length() ? ""
    : dtsEnumMembersAt(members, index)
)

dtsEnumMembersAt(
  members: Array[IREnumMember],
  index: Int
) -> String => (
  members[index].private ? dtsEnumMembers(members, index + 1)
    : (((((indent(1) + "readonly ") + dtsPropertyName(members[index].name)) + ": ") + enumValue(members[index], index)) + ";\n") + dtsEnumMembers(members, index + 1)
)

dtsConsts(
  constants: Array[IRConst],
  index: Int
) -> String => (
  index >= constants.length() ? ""
    : dtsConstsAt(constants, index)
)

dtsConstsAt(
  constants: Array[IRConst],
  index: Int
) -> String => (
  constants[index].private ? dtsConsts(constants, index + 1)
    : (((("declare const " + mangleIdent(constants[index].name)) + ": ") + dtsType(constants[index].typeName)) + ";\n") + dtsConsts(constants, index + 1)
)

dtsFunctions(
  functions: Array[IRFunction],
  index: Int
) -> String => (
  index >= functions.length() ? ""
    : dtsFunctionAt(functions, index) + dtsFunctions(functions, index + 1)
)

dtsFunctionAt(
  functions: Array[IRFunction],
  index: Int
) -> String => (
  functions[index].macro || functions[index].private ? ""
    : dtsFunction(functions[index])
)

dtsFunction(fn: IRFunction) -> String => {
  returnType := dtsType(fn.returnType)
  wrapped := fn.routine {
    true => ("Promise<" + returnType) + ">"
    false => returnType
  }
  (((((("declare function " + mangleIdent(fn.name)) + dtsGenerics(fn.generics)) + "(") + dtsParams(fn.params, 0, "")) + "): ") + wrapped) + ";\n"
}

dtsGenerics(
  generics: Array[String]
) -> String => (
  generics.length() == 0 ? ""
    : ("<" + dtsGenericNames(generics, 0, "")) + ">"
)

dtsGenericNames(
  generics: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= generics.length() ? out
    : dtsGenericNames(generics, index + 1, ((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(generics[index])) + " extends unknown")
)

dtsParams(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : dtsParams(params, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(params[index].name)) + ": ") + dtsType(params[index].typeName))
)

dtsType(typeName: String) -> String => {
  "" | "Void" => "void"
  "Int" | "Int4" | "Int8" | "Int16" | "UInt" | "UInt8" | "UInt16" | "Byte" | "Double" | "Float" => "number"
  "BigInt" | "Int64" | "UInt64" => "bigint"
  "String" | "Char" => "string"
  "Bool" => "boolean"
  "Null" => "null"
  "Object" => "object"
  "Bytes" => "DataView"
  "Buffer" => "RuneBuffer"
  "Reader" => "RuneReader"
  "Writer" => "RuneWriter"
  "StringBuffer" => "RuneStringBuffer"
  "FileStat" => "RuneFileStat"
  "TCPConnection" => "RuneTCPConnection"
  "TCPListener" => "RuneTCPListener"
  "Data" | "@io.Data" => "Uint8Array"
  "Error" => "RuneError"
  "Never" => "never"
  "Symbol" => "symbol"
  "Regex" => "RegExp"
  "HTMLElement" => "HTMLElement"
  "WebComponent" => "CustomElementConstructor"
  "Dynamic" | "Unknown" => "any"
  _ => dtsTypeFallback(typeName)
}

dtsTypeFallback(
  typeName: String
) -> String => (
  typeName.startsWith("&") ? "any"
    : (
      typeName.endsWith("?") ? dtsType(typeName.slice(0, typeName.length() - 1)) + " | null"
        : (
          genericInner(typeName, "Array") != "" ? dtsType(genericInner(typeName, "Array")) + "[]"
            : (
              genericInner(typeName, "Result") != "" ? dtsGenericType("RuneResult", genericInner(typeName, "Result"))
                : (
                  genericInner(typeName, "Task") != "" ? dtsGenericType("Promise", genericInner(typeName, "Task"))
                    : (
                      genericInner(typeName, "Iter") != "" ? dtsGenericType("RuneIter", genericInner(typeName, "Iter"))
                        : (
                          genericInner(typeName, "ReadonlyArray") != "" ? dtsGenericType("ReadonlyArray", genericInner(typeName, "ReadonlyArray"))
                            : (
                              genericInner(typeName, "Tuple") != "" ? ("[" + dtsTypeArgs(genericInner(typeName, "Tuple"))) + "]"
                                : (
                                  genericInner(typeName, "ReadonlyTuple") != "" ? ("readonly [" + dtsTypeArgs(genericInner(typeName, "ReadonlyTuple"))) + "]"
                                    : (
                                      genericInner(typeName, "Map") != "" ? dtsGenericType("Map", genericInner(typeName, "Map"))
                                        : (
                                          genericInner(typeName, "Set") != "" ? dtsGenericType("Set", genericInner(typeName, "Set"))
                                            : (
                                              genericInner(typeName, "WeakMap") != "" ? dtsGenericType("WeakMap", genericInner(typeName, "WeakMap"))
                                                : (
                                                  genericInner(typeName, "WeakSet") != "" ? dtsGenericType("WeakSet", genericInner(typeName, "WeakSet"))
                                                    : (
                                                      genericInner(typeName, "Record") != "" ? dtsGenericType("Record", genericInner(typeName, "Record"))
                                                        : dtsNamedType(typeName)
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

dtsGenericType(
  name: String,
  args: String
) -> String => ((name + "<") + dtsTypeArgs(args)) + ">"

dtsNamedType(typeName: String) -> String => {
  open := typeName.indexOf("[")
  (
    open < 0 ? mangleIdent(typeName)
      : ((mangleIdent(typeName.slice(0, open)) + "<") + dtsTypeArgs(typeName.slice(open + 1, typeName.length() - 1))) + ">"
  )
}

dtsTypeArgs(args: String) -> String => dtsTypeArgList(args.split(","), 0, "")

dtsTypeArgList(
  args: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= args.length() ? out
    : dtsTypeArgList(args, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + dtsType(args[index].trim()))
)

dtsExports(file: IRFile) -> String => (
  (((file.structs.length() + file.enums.length()) + file.constants.length()) + file.functions.length()) == 0 ? ""
    : ((("\n" + dtsStructExports(file.structs, 0)) + dtsEnumExports(file.enums, 0)) + dtsConstExports(file.constants, 0)) + dtsFunctionExports(file.functions, 0)
)

dtsStructExports(
  structs: Array[IRStructType],
  index: Int
) -> String => (
  index >= structs.length() ? ""
    : (
      structs[index].private ? dtsStructExports(structs, index + 1)
        : dtsExportTypeAlias(structs[index].name) + dtsStructExports(structs, index + 1)
    )
)

dtsEnumExports(
  enums: Array[IREnumType],
  index: Int
) -> String => (
  index >= enums.length() ? ""
    : (
      enums[index].private ? dtsEnumExports(enums, index + 1)
        : (dtsExportTypeAlias(enums[index].name) + dtsExportValueAlias(enums[index].name)) + dtsEnumExports(enums, index + 1)
    )
)

dtsConstExports(
  constants: Array[IRConst],
  index: Int
) -> String => (
  index >= constants.length() ? ""
    : (
      constants[index].private ? dtsConstExports(constants, index + 1)
        : dtsExportValueAlias(constants[index].name) + dtsConstExports(constants, index + 1)
    )
)

dtsFunctionExports(
  functions: Array[IRFunction],
  index: Int
) -> String => (
  index >= functions.length() ? ""
    : (
      functions[index].macro || functions[index].private ? dtsFunctionExports(functions, index + 1)
        : dtsExportValueAlias(functions[index].name) + dtsFunctionExports(functions, index + 1)
    )
)

dtsExportTypeAlias(
  name: String
) -> String => (
  dtsCanUseBareProperty(name) ? ((("export type " + name) + " = ") + mangleIdent(name)) + ";\n"
    : ((("export type { " + mangleIdent(name)) + " as ") + dtsExportName(name)) + " };\n"
)

dtsExportValueAlias(
  name: String
) -> String => (
  dtsCanUseBareProperty(name) ? ((("export declare const " + name) + ": typeof ") + mangleIdent(name)) + ";\n"
    : ((("export { " + mangleIdent(name)) + " as ") + dtsExportName(name)) + " };\n"
)

dtsPropertyName(name: String) -> String => (
  dtsCanUseBareProperty(name) ? name
    : dtsQuoteName(name)
)

dtsExportName(name: String) -> String => dtsPropertyName(name)

dtsQuoteName(name: String) -> String => ("\"" + dtsEscapeName(name, 0, "")) + "\""

dtsEscapeName(
  name: String,
  index: Int,
  out: String
) -> String => (
  index >= name.length() ? out
    : dtsEscapeName(name, index + 1, out + dtsEscapeNameChar(name.at(index)))
)

dtsEscapeNameChar(ch: Char) -> String => ch {
  '\\' => "\\\\"
  '"' => "\\\""
  '\n' => "\\n"
  '\r' => "\\r"
  '\t' => "\\t"
  _ => ch.toString()
}

dtsCanUseBareProperty(
  name: String
) -> Bool => ((name != "") && (dtsReservedName(name) == false)) && dtsSafeIdent(name, 0, true)

dtsSafeIdent(
  name: String,
  index: Int,
  first: Bool
) -> Bool => (
  index >= name.length() ? true
    : (
      dtsSafeIdentChar(name.at(index), first) ? dtsSafeIdent(name, index + 1, false)
        : false
    )
)

dtsSafeIdentChar(
  ch: Char,
  first: Bool
) -> Bool => ch {
  '_' | '$' | 'a'..='z' | 'A'..='Z' => true
  '0'..='9' => first == false
  _ => false
}

dtsReservedName(name: String) -> Bool => name ~ ("await" | "break" | "case" | "catch" | "class" | "const" | "continue" | "debugger" | "default" | "delete" | "do" | "else" | "enum" | "export" | "extends" | "false" | "finally" | "for" | "function" | "if" | "implements" | "import" | "in" | "instanceof" | "interface" | "let" | "new" | "null" | "package" | "private" | "protected" | "public" | "return" | "static" | "super" | "switch" | "this" | "throw" | "true" | "try" | "typeof" | "var" | "void" | "while" | "with" | "yield")
