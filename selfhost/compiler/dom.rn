// Ambient DOM event support for the self-hosted checker. The data lives in
// dom_types.rn (generated by internal/tsdecl/cmd/gen-dom-stub from
// TypeScript's lib.dom.d.ts):
//
//	DOM_EVENT_NAMES       — event listener names (e.g. "keydown")
//	DOM_EVENT_TYPE_NAMES  — matching event interface (e.g. "KeyboardEvent")
//	DOM_STRUCT_NAMES      — event interface names
//	DOM_STRUCT_MEMBERS    — per-interface member rows ("name: Type" fields and
//	                       "name(P1, ...): Ret" methods)
//
// Nothing here is hand-maintained: every mapping is derived from lib.dom.d.ts.

// compilerDomEventType resolves an XML `@event` listener name to the DOM event
// interface it dispatches. Unknown listeners degrade to "Event".
+ compilerDomEventType(
  name: String
) -> String => compilerDomEventTypeAt(name, 0)

compilerDomEventTypeAt(
  name: String,
  index: Int
) -> String => (
  index >= DOM_EVENT_NAMES.length() ? "Event"
    : compilerDomEventTypeStep(name, index)
)

compilerDomEventTypeStep(
  name: String,
  index: Int
) -> String => (
  DOM_EVENT_NAMES[index] == name ? DOM_EVENT_TYPE_NAMES[index]
    : compilerDomEventTypeAt(name, index + 1)
)

// compilerDomTargetType resolves an XML tag name to the element interface a
// handler's `e.target` is narrowed to. Form-control tags whose element interface
// is shipped in the stub (input, textarea, select, button, option) narrow so
// `e.target.value` resolves; every other tag keeps the vanilla `EventTarget`.
+ compilerDomTargetType(
  tag: String
) -> String => {
  elem := compilerDomElementType(tag, 0)
  hasStruct := compilerDomStructIndex(elem, 0) >= 0
  hasStruct ? elem
    : "EventTarget"
}

compilerDomElementType(
  tag: String,
  index: Int
) -> String => (
  index >= DOM_TAG_NAMES.length() ? "EventTarget"
    : compilerDomElementTypeStep(tag, index)
)

compilerDomElementTypeStep(
  tag: String,
  index: Int
) -> String => (
  DOM_TAG_NAMES[index] == tag ? DOM_TAG_ELEMENT_TYPES[index]
    : compilerDomElementType(tag, index + 1)
)

// compilerDomStructView returns a synthesized IRStructType for a DOM interface
// so member type lookups (e.g. `e.key`) resolve through the normal
// findCompilerStructField path. Missing interfaces return an empty struct.
+ compilerDomStructView(
  name: String
) -> IRStructType => {
  index := compilerDomStructIndex(name, 0)
  index < 0 ? emptyDomStruct()
    : compilerDomBuildStruct(name, DOM_STRUCT_MEMBERS[index])
}

// compilerDomStructViewWithTarget is compilerDomStructView with the event's
// target/currentTarget/srcElement fields narrowed to the handler's element
// interface (React `ChangeEvent<T>` parity).
+ compilerDomStructViewWithTarget(
  name: String,
  targetType: String
) -> IRStructType => {
  index := compilerDomStructIndex(name, 0)
  index < 0 ? emptyDomStruct()
    : compilerDomBuildStructWithTarget(name, DOM_STRUCT_MEMBERS[index], targetType)
}

compilerDomStructIndex(
  name: String,
  index: Int
) -> Int => (
  index >= DOM_STRUCT_NAMES.length() ? -1
    : compilerDomStructIndexStep(name, index)
)

compilerDomStructIndexStep(
  name: String,
  index: Int
) -> Int => (
  DOM_STRUCT_NAMES[index] == name ? index
    : compilerDomStructIndex(name, index + 1)
)

compilerDomBuildStruct(
  name: String,
  members: Array[String]
) -> IRStructType => compilerDomMakeStruct(name, compilerDomCollectFields(members, "", [], 0))

compilerDomBuildStructWithTarget(
  name: String,
  members: Array[String],
  targetType: String
) -> IRStructType => compilerDomMakeStruct(name, compilerDomCollectFields(members, targetType, [], 0))

compilerDomMakeStruct(
  name: String,
  fields: Array[IRField]
) -> IRStructType => IRStructType {
  name: name,
  private: false,
  generics: [],
  fields: fields,
  methods: [],
  sourcePath: "",
  line: 0,
  column: 0
}

+ emptyDomStruct() -> IRStructType => IRStructType {
  name: "",
  private: false,
  generics: [],
  fields: [],
  methods: [],
  sourcePath: "",
  line: 0,
  column: 0
}

compilerDomCollectFields(
  members: Array[String],
  targetType: String,
  acc: Array[IRField],
  index: Int
) -> Array[IRField] => (
  index >= members.length() ? acc
    : compilerDomCollectField(members[index], members, targetType, acc, index)
)

// Method rows carry a `(`; field rows carry `name: Type`. When targetType is
// non-empty, the event's target/currentTarget/srcElement fields are narrowed
// to it (React `ChangeEvent<T>` parity).
compilerDomCollectField(
  member: String,
  members: Array[String],
  targetType: String,
  acc: Array[IRField],
  index: Int
) -> Array[IRField] => {
  next := member.includes("(") ? acc
    : [..acc, compilerDomFieldFromRow(member, targetType)]
  compilerDomCollectFields(members, targetType, next, index + 1)
}

compilerDomFieldFromRow(
  row: String,
  targetType: String
) -> IRField => {
  colon := row.indexOf(":")
  name := colon < 0 ? row.trim() : row.slice(0, colon).trim()
  lineType := colon < 0 ? "Dynamic" : row.slice(colon + 1, row.length()).trim()
  isTarget := (
    (name == "target") || (name == "currentTarget") || (name == "srcElement")
  )
  typeName := isTarget && (targetType != "") ? targetType : lineType
  IRField {
    name: name,
    private: false,
    typeName: typeName,
    jsonName: name,
    jsonIgnore: false,
    line: 0,
    column: 0
  }
}