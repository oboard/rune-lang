@"../ir/ir.rn"
@"./common.rn"

+ generateTypeScript(
  file: IRFile
) -> String => {
  resolved := rewriteTSMethodCalls(file)
  out :=: emitTSImports(resolved)
  (
    fileUsesUnwrap(resolved) ? out = out + emitTSUnwrapHelper()
  )
  (
    fileUsesPathFamily(resolved) ? out = out + emitTSPathHelpers()
  )
  resolved.enums.each((enumDecl) => out = (out + emitTSEnum(enumDecl)) + "\n")
  resolved.enums.each((enumDecl) => out = out + emitTSEnumMethods(enumDecl))
  resolved.structs.each((typeDecl) => out = (out + emitTSStruct(typeDecl)) + "\n")
  resolved.structs.each((typeDecl) => out = out + emitTSMethods(typeDecl))
  resolved.constants.each((constant) => out = (out + emitTSConst(constant)) + "\n")
  resolved.functions.each((fn) => out = (
    fn.macro ? out
      : (out + emitTSFunction(fn)) + "\n"
  ))
  out + emitTSExports(resolved)
}

emitTSImports(file: IRFile) -> String => emitTSImportList(file.tsImports, 0, "")

rewriteTSMethodCalls(file: IRFile) -> IRFile => {
  structs := rewriteTSStructs(file.structs, file.structs, file.enums)
  enums := rewriteTSEnums(file.enums, file.structs, file.enums)
  IRFile {
    imports: file.imports,
    tsImports: file.tsImports,
    structs: structs,
    enums: enums,
    constants: rewriteTSConstants(file.constants, file.structs, file.enums),
    functions: rewriteTSFunctions(file.functions, file.structs, file.enums),
    tests: rewriteTSTests(file.tests, file.structs, file.enums),
    errors: file.errors
  }
}

rewriteTSStructs(
  structs: Array[IRStructType],
  allStructs: Array[IRStructType],
  enums: Array[IREnumType]
) -> Array[IRStructType] => {
  out := [IRStructType {
    name: "",
    private: false,
    generics: [],
    fields: [],
    methods: [],
    sourcePath: "",
    line: 0,
    column: 0
  }].slice(0, 0)
  structs.each((typeDecl) => out.push(IRStructType {
    name: typeDecl.name,
    private: typeDecl.private,
    generics: typeDecl.generics,
    fields: typeDecl.fields,
    methods: rewriteTSTypeMethods(typeDecl.methods, typeDecl.name, allStructs, enums),
    sourcePath: typeDecl.sourcePath,
    line: typeDecl.line,
    column: typeDecl.column
  }))
  out
}

rewriteTSEnums(
  enums: Array[IREnumType],
  structs: Array[IRStructType],
  allEnums: Array[IREnumType]
) -> Array[IREnumType] => {
  out := [IREnumType {
    name: "",
    private: false,
    generics: [],
    members: [],
    methods: [],
    sourcePath: "",
    line: 0,
    column: 0
  }].slice(0, 0)
  enums.each((typeDecl) => out.push(IREnumType {
    name: typeDecl.name,
    private: typeDecl.private,
    generics: typeDecl.generics,
    members: typeDecl.members,
    methods: rewriteTSTypeMethods(typeDecl.methods, typeDecl.name, structs, allEnums),
    sourcePath: typeDecl.sourcePath,
    line: typeDecl.line,
    column: typeDecl.column
  }))
  out
}

rewriteTSConstants(
  constants: Array[IRConst],
  structs: Array[IRStructType],
  enums: Array[IREnumType]
) -> Array[IRConst] => {
  out := [IRConst {
    name: "",
    private: false,
    typeName: "",
    value: emptyIRExpr(),
    line: 0,
    column: 0
  }].slice(0, 0)
  constants.each((constant) => {
    value := rewriteTSExpr(constant.value, structs, enums, [emptyCompilerTypeBinding()].slice(0, 0))
    out.push(IRConst {
      name: constant.name,
      private: constant.private,
      typeName: constant.typeName,
      value: value,
      line: constant.line,
      column: constant.column
    })
  })
  out
}

rewriteTSTests(
  tests: Array[IRTest],
  structs: Array[IRStructType],
  enums: Array[IREnumType]
) -> Array[IRTest] => {
  out := [IRTest {
    name: "",
    body: emptyIRExpr(),
    line: 0,
    column: 0
  }].slice(0, 0)
  tests.each((test) => {
    bindings := [emptyCompilerTypeBinding()].slice(0, 0)
    body := rewriteTSExpr(test.body, structs, enums, bindings)
    out.push(IRTest {
      name: test.name,
      body: body,
      line: test.line,
      column: test.column
    })
  })
  out
}

rewriteTSFunctions(
  functions: Array[IRFunction],
  structs: Array[IRStructType],
  enums: Array[IREnumType]
) -> Array[IRFunction] => {
  out := [emptyIRFunction()].slice(0, 0)
  functions.each((fn) => out.push(rewriteTSFunction(fn, structs, enums)))
  out
}

rewriteTSFunction(
  fn: IRFunction,
  structs: Array[IRStructType],
  enums: Array[IREnumType]
) -> IRFunction => rewriteTSFunctionWithThis(fn, structs, enums, "")

rewriteTSTypeMethods(
  methods: Array[IRFunction],
  typeName: String,
  structs: Array[IRStructType],
  enums: Array[IREnumType]
) -> Array[IRFunction] => {
  out := [emptyIRFunction()].slice(0, 0)
  methods.each((method) => out.push(rewriteTSFunctionWithThis(method, structs, enums, typeName)))
  out
}

rewriteTSFunctionWithThis(
  fn: IRFunction,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  thisType: String
) -> IRFunction => rewriteTSFunctionBody(fn, structs, enums, thisType)

rewriteTSFunctionBody(
  fn: IRFunction,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  thisType: String
) -> IRFunction => {
  bindings := [emptyCompilerTypeBinding()].slice(0, 0)
  fn.params.each((param) => bindings = tsAddBinding(bindings, param.name, param.typeName))
  bindings = (thisType == "") ? bindings : tsAddBinding(bindings, "this", thisType)
  body := rewriteTSExpr(fn.body, structs, enums, bindings)
  IRFunction {
    name: fn.name,
    private: fn.private,
    static: fn.static,
    routine: fn.routine,
    macro: fn.macro,
    receiverType: fn.receiverType,
    generics: fn.generics,
    params: fn.params,
    returnType: fn.returnType,
    body: body,
    sourcePath: fn.sourcePath,
    line: fn.line,
    column: fn.column
  }
}

emptyCompilerTypeBinding() -> CompilerTypeBinding => {
  name: "",
  typeName: ""
}

tsAddBinding(
  bindings: Array[CompilerTypeBinding],
  name: String,
  typeName: String
) -> Array[CompilerTypeBinding] => [..dropTSBinding(bindings, name, 0, [emptyCompilerTypeBinding()].slice(0, 0)), tsBinding(name, typeName)]

tsBinding(
  name: String,
  typeName: String
) -> CompilerTypeBinding => {
  name: name,
  typeName: typeName
}

dropTSBinding(
  bindings: Array[CompilerTypeBinding],
  name: String,
  index: Int,
  out: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => (
  index >= bindings.length() ? out
    : bindings[index].name == name ? dropTSBinding(bindings, name, index + 1, out)
      : dropTSBinding(bindings, name, index + 1, [..out, bindings[index]])
)

tsLookupBinding(
  bindings: Array[CompilerTypeBinding],
  name: String,
  index: Int
) -> CompilerTypeBinding => (
  index >= bindings.length() ? emptyCompilerTypeBinding()
    : bindings[index].name == name ? bindings[index]
      : tsLookupBinding(bindings, name, index + 1)
)

tsTypeBase(typeName: String) -> String => {
  open := typeName.indexOf("[")
  (
    open < 0 ? typeName
      : typeName.slice(0, open)
  )
}

rewriteTSExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> IRExpr => expr.kind {
  ExprKind.Call => rewriteTSCall(expr, structs, enums, bindings)
  ExprKind.Block => rewriteTSBlockExpr(expr, structs, enums, bindings)
  ExprKind.Let => rewriteTSLet(expr, structs, enums, bindings)
  _ => tsRebuildExpr(expr, rewriteTSChildren(expr.children, structs, enums, bindings))
}

rewriteTSBlockExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> IRExpr => {
  result := rewriteTSBlockStatements(expr.children, 0, structs, enums, bindings, [emptyIRExpr()].slice(0, 0))
  IRExpr {
    kind: expr.kind,
    text: expr.text,
    name: expr.name,
    value: expr.value,
    op: expr.op,
    params: expr.params,
    children: result,
    line: expr.line,
    column: expr.column
  }
}

rewriteTSBlockStatements(
  statements: Array[IRExpr],
  index: Int,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding],
  out: Array[IRExpr]
) -> Array[IRExpr] => (
  index >= statements.length() ? out
    : rewriteTSBlockStep(statements, index, structs, enums, bindings, out)
)

rewriteTSBlockStep(
  statements: Array[IRExpr],
  index: Int,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding],
  out: Array[IRExpr]
) => {
  statement := rewriteTSStatement(statements[index], structs, enums, bindings)
  nextBindings := tsStatementBindings(statements[index], structs, enums, bindings)
  rewriteTSBlockStatements(statements, index + 1, structs, enums, nextBindings, [..out, statement])
}

rewriteTSStatement(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> IRExpr => (
  expr.kind == ExprKind.Let ? rewriteTSLet(expr, structs, enums, bindings)
    : rewriteTSExpr(expr, structs, enums, bindings)
)

rewriteTSLet(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> IRExpr => IRExpr {
  kind: expr.kind,
  text: expr.text,
  name: expr.name,
  value: expr.value,
  op: expr.op,
  params: expr.params,
  children: tsRewriteChildren(expr.children, structs, enums, bindings),
  line: expr.line,
  column: expr.column
}

tsLetBindingType(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> String => (
  expr.value != "" ? tsTypeBase(expr.value)
    : (
      expr.children.length() > 0 ? (
        expr.children[0].kind == ExprKind.Struct ? tsTypeBase(expr.children[0].name)
          : tsResolveReceiverType(expr.children[0], structs, enums, bindings)
      )
        : ""
    )
)

tsStatementBindings(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => {
  kind := expr.kind
  kind == ExprKind.Let ? tsAddBinding(bindings, expr.name, tsLetBindingType(expr, structs, enums, bindings))
    : bindings
}

rewriteTSCall(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> IRExpr => {
  hasSelectorCallee := (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Selector)
  hasSelectorCallee {
    true => rewriteTSSelectorCall(expr, structs, enums, bindings)
    _ => tsRebuildExpr(expr, tsRewriteChildren(expr.children, structs, enums, bindings))
  }
}

rewriteTSSelectorCall(
  expr: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> IRExpr => {
  callee := expr.children[0]
  hasReceiver := callee.children.length() > 0
  receiver := (
    hasReceiver ? rewriteTSExpr(callee.children[0], structs, enums, bindings)
      : emptyIRExpr()
  )
  receiverType := tsResolveReceiverType(receiver, structs, enums, bindings)
  rewrittenArgs := tsRewriteArgs(expr.children, structs, enums, bindings)
  shouldRewrite := tsFindMethodCall(structs, enums, receiverType, callee.name)
  shouldRewrite {
    true => tsBuildMethodCall(expr, receiverType, callee.name, receiver, rewrittenArgs)
    _ => tsRebuildExpr(expr, tsPrependExpr(tsRebuildExpr(callee, hasReceiver ? [receiver] : []), rewrittenArgs))
  }
}

tsBuildMethodCall(
  expr: IRExpr,
  receiverType: String,
  methodName: String,
  receiver: IRExpr,
  args: Array[IRExpr]
) -> IRExpr => {
  calleeIdent := tsMethodCallee((tsTypeBase(receiverType) + "_") + methodName)
  IRExpr {
    kind: expr.kind,
    text: expr.text,
    name: expr.name,
    value: expr.value,
    op: expr.op,
    params: expr.params,
    children: tsCallChildren(calleeIdent, receiver, args),
    line: expr.line,
    column: expr.column
  }
}

tsMethodCallee(name: String) -> IRExpr => IRExpr {
  kind: ExprKind.Identifier,
  text: name,
  name: name,
  value: "",
  op: "",
  params: [],
  children: [],
  line: 0,
  column: 0
}

tsCallChildren(
  callee: IRExpr,
  receiver: IRExpr,
  args: Array[IRExpr]
) -> Array[IRExpr] => tsPrependExprAll(callee, receiver, args)

tsPrependExprAll(
  callee: IRExpr,
  receiver: IRExpr,
  args: Array[IRExpr]
) -> Array[IRExpr] => {
  out := [callee, receiver]
  args.each((arg) => out.push(arg))
  out
}

tsPrependExpr(
  head: IRExpr,
  rest: Array[IRExpr]
) -> Array[IRExpr] => {
  out := [head]
  rest.each((item) => out.push(item))
  out
}

tsRebuildExpr(
  expr: IRExpr,
  children: Array[IRExpr]
) -> IRExpr => IRExpr {
  kind: expr.kind,
  text: expr.text,
  name: expr.name,
  value: expr.value,
  op: expr.op,
  params: expr.params,
  children: children,
  line: expr.line,
  column: expr.column
}

tsRewriteChildren(
  children: Array[IRExpr],
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> Array[IRExpr] => {
  out := [emptyIRExpr()].slice(0, 0)
  children.each((child) => out.push(rewriteTSExpr(child, structs, enums, bindings)))
  out
}

rewriteTSChildren(
  children: Array[IRExpr],
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> Array[IRExpr] => {
  out := [emptyIRExpr()].slice(0, 0)
  children.each((child) => out.push(rewriteTSExpr(child, structs, enums, bindings)))
  out
}

tsRewriteArgs(
  children: Array[IRExpr],
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> Array[IRExpr] => tsRewriteArgsFrom(children, 1, structs, enums, bindings, [emptyIRExpr()].slice(0, 0))

tsRewriteArgsFrom(
  children: Array[IRExpr],
  index: Int,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding],
  out: Array[IRExpr]
) -> Array[IRExpr] => (
  index >= children.length() ? out
    : tsRewriteArgsFrom(children, index + 1, structs, enums, bindings, [..out, rewriteTSExpr(children[index], structs, enums, bindings)])
)

tsResolveReceiverType(
  receiver: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> String => (
  receiver.text != "" ? receiver.text
    : receiver.kind {
      ExprKind.Identifier => tsLookupBinding(bindings, receiver.name, 0).typeName
      ExprKind.This => tsLookupBinding(bindings, "this", 0).typeName
      ExprKind.Struct => receiver.name
      ExprKind.Selector => tsResolveSelectorFieldType(receiver, structs, enums, bindings)
      _ => ""
    }
)

tsResolveSelectorFieldType(
  receiver: IRExpr,
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  empty := receiver.children.length() == 0
  empty {
    true => ""
    _ => receiver.children[0].text != "" ? receiver.children[0].text
      : tsStructFieldType(structs, tsTypeBase(tsResolveReceiverType(receiver.children[0], structs, enums, bindings)), receiver.name, 0)
  }
}

tsStructFieldType(
  structs: Array[IRStructType],
  typeName: String,
  fieldName: String,
  index: Int
) -> String => (
  index >= structs.length() ? ""
    : structs[index].name == typeName ? tsStructFieldTypeIn(structs[index].fields, fieldName, 0)
      : tsStructFieldType(structs, typeName, fieldName, index + 1)
)

tsStructFieldTypeIn(
  fields: Array[IRField],
  fieldName: String,
  index: Int
) -> String => (
  index >= fields.length() ? ""
    : fields[index].name == fieldName ? fields[index].typeName
      : tsStructFieldTypeIn(fields, fieldName, index + 1)
)

tsFindMethodCall(
  structs: Array[IRStructType],
  enums: Array[IREnumType],
  receiverType: String,
  methodName: String
) -> Bool => {
  base := tsTypeBase(receiverType)
  found := tsStructHasInstanceMethod(structs, base, methodName, 0)
  found {
    true => true
    _ => tsEnumHasInstanceMethod(enums, base, methodName, 0)
  }
}

tsEnumHasInstanceMethod(
  enums: Array[IREnumType],
  typeName: String,
  methodName: String,
  index: Int
) -> Bool => (
  index >= enums.length() ? false
    : enums[index].name == typeName ? tsStructMethodMatches(enums[index].methods, methodName, 0)
      : tsEnumHasInstanceMethod(enums, typeName, methodName, index + 1)
)

tsStructHasInstanceMethod(
  structs: Array[IRStructType],
  typeName: String,
  methodName: String,
  index: Int
) -> Bool => (
  index >= structs.length() ? false
    : structs[index].name == typeName ? tsStructMethodMatches(structs[index].methods, methodName, 0)
      : tsStructHasInstanceMethod(structs, typeName, methodName, index + 1)
)

tsStructMethodMatches(
  methods: Array[IRFunction],
  methodName: String,
  index: Int
) -> Bool => (
  index >= methods.length() ? false
    : (
      (methods[index].name == methodName) && (methods[index].static == false) ? true
        : tsStructMethodMatches(methods, methodName, index + 1)
    )
)

emitTSConst(
  constant: IRConst
) -> String => (((("const " + mangleIdent(constant.name)) + ": ") + tsType(constant.typeName)) + " = ") + emitTSExprExpected(constant.value, constant.typeName) + ";"

emitTSImportList(
  imports: Array[IRTSImport],
  index: Int,
  out: String
) -> String => (
  index >= imports.length() ? out
    : emitTSImportList(imports, index + 1, out + emitTSImport(imports[index]))
)

emitTSImport(
  importDecl: IRTSImport
) -> String => {
  names := emitTSImportNames(importDecl.functions, importDecl.values, 0, 0, "")
  (
    names == "" ? ""
      : ("import { " + names) + " } from " + tsQuoteString(tsRuntimeSpecifier(importDecl.specifier)) + ";\n"
  )
}

emitTSImportNames(
  functions: Array[IRFunction],
  values: Array[IRConst],
  fnIndex: Int,
  valueIndex: Int,
  out: String
) -> String => (
  fnIndex < functions.length() ? emitTSImportNames(functions, values, fnIndex + 1, valueIndex, appendTSImportName(out, functions[fnIndex].name))
    : (
      valueIndex < values.length() ? emitTSImportNames(functions, values, fnIndex, valueIndex + 1, appendTSImportName(out, values[valueIndex].name))
        : out
    )
)

appendTSImportName(
  out: String,
  name: String
) -> String => (out + (
  out == "" ? ""
    : ", "
)) + name + " as " + mangleIdent(name)

tsQuoteString(
  value: String
) -> String => ("\"" + value.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"")) + "\""

tsRuntimeSpecifier(
  specifier: String
) -> String => (
  (specifier == "") || specifier.startsWith("./") || specifier.startsWith("../") || specifier.startsWith("/") || specifier.includes("://") ? specifier
    : "./" + specifier
)

emitTSUnwrapHelper() -> String => `function __runeUnwrap(value: any): any {
  if (value && value.__tag === 0) return value.__payload?.[0];
  if (value && value.__payload && value.__payload.length > 0) throw value.__payload[0];
  throw new Error("Result.Err");
}

`

emitTSPathHelpers() -> String => `function __runePathBasename(path: string): string {
  const index = path.lastIndexOf("/");
  if (index < 0) return path;
  if (index === path.length - 1) return path;
  return path.slice(index + 1);
}

function __runePathExtname(path: string): string {
  const base = __runePathBasename(path);
  const index = base.lastIndexOf(".");
  if (index <= 0) return "";
  return base.slice(index);
}

function __runePathDirname(path: string): string {
  const index = path.lastIndexOf("/");
  if (index < 0) return ".";
  if (index === 0) return "/";
  return path.slice(0, index);
}

function __runePathJoin(parts: string[]): string {
  return __runePathNormalize(__runePathJoinParts(parts, 0, ""));
}

function __runePathNormalize(path: string): string {
  const absolute = path.startsWith("/");
  const out = __runePathNormalizeParts(path.split("/"), 0, absolute, []);
  const joined = __runePathJoinParts(out, 0, "");
  if (absolute) return "/" + joined;
  return joined === "" ? "." : joined;
}

function __runePathResolve(parts: string[]): string {
  if (parts.length === 0) return ".";
  return __runePathNormalize(__runePathJoin(parts));
}

function __runePathRelative(from: string, to: string): string {
  const fromParts = __runePathParts(__runePathResolve([from]));
  const toParts = __runePathParts(__runePathResolve([to]));
  let index = 0;
  while (index < fromParts.length && index < toParts.length && fromParts[index] === toParts[index]) index++;
  let out = "";
  for (let i = index; i < fromParts.length; i++) out = __runePathAppendPart(out, "..");
  for (let i = index; i < toParts.length; i++) out = __runePathAppendPart(out, toParts[i]);
  return out === "" ? "." : out;
}

function __runePathParts(path: string): string[] {
  return __runePathNormalize(path).split("/").filter((part) => part !== "");
}

function __runePathJoinParts(parts: string[], index: number, out: string): string {
  for (let i = index; i < parts.length; i++) out = __runePathAppendPart(out, parts[i]);
  return out;
}

function __runePathAppendPart(out: string, part: string): string {
  if (out === "") return part;
  if (part === "") return out;
  return out + "/" + part;
}

function __runePathNormalizeParts(parts: string[], index: number, absolute: boolean, out: string[]): string[] {
  while (index < parts.length) {
    const part = parts[index];
    if (part === "" || part === ".") {
      index++;
      continue;
    }
    if (part === "..") return __runePathNormalizeParent(parts, index, absolute, out);
    return __runePathNormalizePush(parts, index, absolute, out, part);
  }
  return out;
}

function __runePathNormalizeParent(parts: string[], index: number, absolute: boolean, out: string[]): string[] {
  if (out.length > 0) return __runePathNormalizePop(parts, index, absolute, out);
  if (absolute) return __runePathNormalizeParts(parts, index + 1, absolute, out);
  return __runePathNormalizePush(parts, index, absolute, out, "..");
}

function __runePathNormalizePop(parts: string[], index: number, absolute: boolean, out: string[]): string[] {
  return __runePathNormalizeParts(parts, index + 1, absolute, out.slice(0, out.length - 1));
}

function __runePathNormalizePush(parts: string[], index: number, absolute: boolean, out: string[], part: string): string[] {
  return __runePathNormalizeParts(parts, index + 1, absolute, [...out, part]);
}

function __runePathCollectParts(parts: string[], index: number, out: string[]): string[] {
  for (let i = index; i < parts.length; i++) {
    if (parts[i] !== "") out.push(parts[i]);
  }
  return out;
}

function __runePathCollectPart(parts: string[], index: number, out: string[]): string[] {
  if (index < parts.length) out.push(parts[index]);
  return __runePathCollectParts(parts, index + 1, out);
}

function __runePathRelativeFromParts(fromParts: string[], toParts: string[], index: number): string {
  while (index < fromParts.length && index < toParts.length && fromParts[index] === toParts[index]) index++;
  return __runePathRelativeTail(fromParts, toParts, index, index, "");
}

function __runePathRelativeTail(fromParts: string[], toParts: string[], fromIndex: number, toIndex: number, out: string): string {
  for (let i = fromIndex; i < fromParts.length; i++) out = __runePathAppendPart(out, "..");
  for (let i = toIndex; i < toParts.length; i++) out = __runePathAppendPart(out, toParts[i]);
  return out === "" ? "." : out;
}

`

emitTSEnum(
  enumDecl: IREnumType
) -> String => {
  tsEnumHasPayload(enumDecl.members, 0) ? emitTSPayloadEnum(enumDecl)
    : emitTSSimpleEnum(enumDecl)
}

emitTSSimpleEnum(
  enumDecl: IREnumType
) -> String => {
  out :=: ("type " + mangleIdent(enumDecl.name)) + " = number;\n"
  out = ((out + "const ") + mangleIdent(enumDecl.name)) + " = {\n"
  out = out + emitTSEnumMembers(enumDecl.members, 0, "")
  out + "} as const;\n"
}

emitTSPayloadEnum(
  enumDecl: IREnumType
) -> String => {
  out :=: (("type " + mangleIdent(enumDecl.name)) + emitTSGenerics(enumDecl.generics)) + " =\n"
  out = out + emitTSPayloadEnumMembers(enumDecl.members, 0, "")
  out = out + ";\n\n"
  out + emitTSPayloadEnumConstructors(enumDecl.name, enumDecl.generics, enumDecl.members, 0, "")
}

emitTSPayloadEnumMembers(
  members: Array[IREnumMember],
  index: Int,
  out: String
) -> String => (
  index >= members.length() ? out
    : emitTSPayloadEnumMembers(members, index + 1, out + emitTSPayloadEnumMember(members[index], index, index == 0))
)

emitTSPayloadEnumMember(
  member: IREnumMember,
  index: Int,
  first: Bool
) -> String => {
  prefix := (
    first ? "  "
      : "| "
  )
  (prefix + "{ __tag: ") + compilerIntToString(index) + "; __payload: " + emitTSPayloadTuple(member.params, 0, "") + " }\n"
}

emitTSPayloadTuple(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? "[" + out + "]"
    : emitTSPayloadTuple(params, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + tsType(params[index].typeName))
)

emitTSPayloadEnumConstructors(
  enumName: String,
  generics: Array[String],
  members: Array[IREnumMember],
  index: Int,
  out: String
) -> String => (
  index >= members.length() ? out
    : emitTSPayloadEnumConstructors(enumName, generics, members, index + 1, out + emitTSPayloadEnumConstructor(enumName, generics, members[index], index))
)

emitTSPayloadEnumConstructor(
  enumName: String,
  generics: Array[String],
  member: IREnumMember,
  index: Int
) -> String => {
  typeName := mangleIdent(enumName) + emitTSGenericsUse(generics)
  (
    member.params.length() == 0 ? (((("const " + mangleIdent((enumName + "_") + member.name)) + ": ") + typeName) + " = { __tag: ") + compilerIntToString(index) + ", __payload: [] };\n"
      : ((((((("function " + mangleIdent(member.name)) + emitTSGenerics(generics)) + "(") + emitTSParams(member.params, 0, "")) + "): ") + typeName) + " {\n") + line(1, ("return { __tag: " + compilerIntToString(index)) + ", __payload: [" + emitTSParamNames(member.params, 0, "") + "] };") + "}\n"
  )
}

emitTSParamNames(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : emitTSParamNames(params, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(params[index].name))
)

tsEnumHasPayload(
  members: Array[IREnumMember],
  index: Int
) -> Bool => (
  index >= members.length() ? false
    : (
      members[index].params.length() > 0 ? true
        : tsEnumHasPayload(members, index + 1)
    )
)

emitTSGenericsUse(
  generics: Array[String]
) -> String => (
  generics.length() == 0 ? ""
    : "<" + emitTSGenericNames(generics, 0, "") + ">"
)

emitTSEnumMembers(
  members: Array[IREnumMember],
  index: Int,
  out: String
) -> String => (
  index >= members.length() ? out
    : emitTSEnumMembers(members, index + 1, ((((out + indent(1)) + tsPropertyName(members[index].name)) + ": ") + enumValue(members[index], index)) + ",\n")
)

emitTSStruct(
  typeDecl: IRStructType
) -> String => {
  generics := emitTSGenerics(typeDecl.generics)
  out :=: (("type " + mangleIdent(typeDecl.name)) + generics) + " = {\n"
  typeDecl.fields.each((field) => out = ((((out + indent(1)) + tsPropertyName(field.name)) + ": ") + tsType(field.typeName)) + ";\n")
  out + "};\n"
}

emitTSMethods(
  typeDecl: IRStructType
) -> String => {
  out :=: ""
  typeDecl.methods.each((method) => out = (out + emitTSFunction(methodWithTSReceiver(typeDecl.name, method))) + "\n")
  out
}

emitTSEnumMethods(
  enumDecl: IREnumType
) -> String => {
  out :=: ""
  enumDecl.methods.each((method) => out = (out + emitTSFunction(methodWithTSReceiver(enumDecl.name, method))) + "\n")
  out
}

methodWithTSReceiver(
  typeName: String,
  method: IRFunction
) -> IRFunction => {
  name: (typeName + "_") + method.name,
  private: method.private,
  static: method.static,
  routine: method.routine,
  macro: method.macro,
  receiverType: method.receiverType,
  generics: method.generics,
  params: method.static {
    true => method.params
    false => prependThisParam(typeName, method.params)
  },
  returnType: method.returnType,
  body: method.body,
  sourcePath: method.sourcePath,
  line: method.line,
  column: method.column
}

prependThisParam(
  typeName: String,
  params: Array[IRParam]
) -> Array[IRParam] => {
  out := [IRParam {
    name: "this",
    typeName: typeName,
    line: 0,
    column: 0
  }]
  params.each((param) => out.push(param))
  out
}

emitTSFunction(fn: IRFunction) -> String => (
  fn.returnType == "WebComponent" ? emitTSWebComponentFunction(fn)
    : emitTSPlainFunction(fn)
)

emitTSPlainFunction(fn: IRFunction) -> String => {
  ret := tsType(fn.returnType)
  out :=: (((((("function " + mangleIdent(fn.name)) + emitTSGenerics(fn.generics)) + "(") + emitTSParams(fn.params, 0, "")) + "): ") + ret) + " {\n"
  out = out + emitTSBody(fn.body, returnsValue(fn.returnType), fn.returnType, 1)
  out + "}\n"
}

emitTSWebComponentFunction(fn: IRFunction) -> String => {
  out :=: (((((("function " + mangleIdent(fn.name)) + emitTSGenerics(fn.generics)) + "(") + emitTSParams(fn.params, 0, "")) + "): ") + tsType(fn.returnType)) + " {\n"
  out = out + line(1, "return class extends HTMLElement {")
  out = out + line(2, "connectedCallback(): void {")
  out = out + line(3, "if ((this as any).__runeMounted) return;")
  out = out + line(3, "(this as any).__runeMounted = true;")
  out = out + line(3, "const __root = " + emitTSExprExpected(fn.body, "HTMLElement") + ";")
  out = out + line(3, "this.appendChild(__root);")
  out = out + line(2, "}")
  out = out + line(1, "};")
  out + "}\n"
}

emitTSBody(
  expr: IRExpr,
  returns: Bool,
  returnType: String,
  level: Int
) -> String => expr.kind {
  ExprKind.Block => emitTSBlock(expr.children, 0, returns, returnType, level, "")
  _ => line(level, (
    returns ? ("return " + emitTSExprExpected(expr, returnType)) + ";"
      : emitTSExpr(expr) + ";"
  ))
}

emitTSBlock(
  statements: Array[IRExpr],
  index: Int,
  returns: Bool,
  returnType: String,
  level: Int,
  out: String
) -> String => (
  index >= statements.length() ? (
    returns && (statements.length() == 0) ? out + line(level, "return undefined;")
      : out
  )
    : emitTSBlock(statements, index + 1, returns, returnType, level, out + emitTSStatement(statements[index], index == (statements.length() - 1), returns, returnType, level))
)

emitTSStatement(
  expr: IRExpr,
  last: Bool,
  returns: Bool,
  returnType: String,
  level: Int
) -> String => expr.kind {
  ExprKind.Let => emitTSLet(expr, level)
  ExprKind.ObjectDestructure => emitTSObjectDestructure(expr, level)
  _ => (
    last && returns ? line(level, ("return " + emitTSExprExpected(expr, returnType)) + ";")
      : line(level, emitTSExpr(expr) + ";")
  )
}

emitTSLet(
  expr: IRExpr,
  level: Int
) -> String => line(level, (((tsLetKeyword(expr.op) + mangleIdent(expr.name)) + " = ") + emitTSExpr(expr.children[0])) + ";")

tsLetKeyword(op: String) -> String => op {
  ":=:" => "let "
  _ => "const "
}

emitTSObjectDestructure(
  expr: IRExpr,
  level: Int
) -> String => line(level, ((("const { " + emitTSObjectDestructureFields(expr.params, 0, "")) + " } = ") + emitTSExpr(expr.children[0])) + ";")

emitTSObjectDestructureFields(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : emitTSObjectDestructureFields(params, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + tsPropertyName(params[index].typeName)) + ": ") + mangleIdent(params[index].name))
)

emitTSParams(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : emitTSParams(params, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(params[index].name)) + ": ") + tsType(params[index].typeName))
)

emitTSGenerics(
  generics: Array[String]
) -> String => (
  generics.length() == 0 ? ""
    : ("<" + emitTSGenericNames(generics, 0, "")) + ">"
)

emitTSGenericNames(
  generics: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= generics.length() ? out
    : emitTSGenericNames(generics, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(generics[index]))
)

emitTSExports(file: IRFile) -> String => {
  exports := emitTSConstExportNames(file.constants, 0, emitTSExportNames(file.functions, 0, ""))
  (
    exports == "" ? ""
      : ("export { " + exports) + " };\n"
  )
}

emitTSConstExportNames(
  constants: Array[IRConst],
  index: Int,
  out: String
) -> String => (
  index >= constants.length() ? out
    : (
      constants[index].private ? emitTSConstExportNames(constants, index + 1, out)
        : emitTSConstExportNames(constants, index + 1, appendTSExportName(out, constants[index].name))
    )
)

emitTSExportNames(
  functions: Array[IRFunction],
  index: Int,
  out: String
) -> String => (
  index >= functions.length() ? out
    : (
      functions[index].macro || functions[index].private ? emitTSExportNames(functions, index + 1, out)
        : emitTSExportNames(functions, index + 1, appendTSExportName(out, functions[index].name))
    )
)

appendTSExportName(
  out: String,
  name: String
) -> String => (((out + (
  out == "" ? ""
    : ", "
)) + mangleIdent(name)) + " as ") + name

emitTSExpr(expr: IRExpr) -> String => expr.kind {
  ExprKind.Identifier => mangleIdent(expr.name)
  ExprKind.At => "@" + expr.name
  ExprKind.This => mangleIdent("this")
  ExprKind.Int => expr.value
  ExprKind.Double => expr.value
  ExprKind.BigInt => bigintLiteralDigits(expr.value) + "n"
  ExprKind.String => expr.value
  ExprKind.Template => emitTSTemplate(expr)
  ExprKind.Char => expr.value
  ExprKind.Regex => expr.value
  ExprKind.XMLText => tsQuoteString(expr.value)
  ExprKind.XMLElement => emitTSXMLExpr(expr)
  ExprKind.Bool => expr.value
  ExprKind.Null => "null"
  ExprKind.Unary => expr.op + emitTSExpr(expr.children[0])
  ExprKind.Postfix => emitTSExpr(expr.children[0]) + expr.op
  ExprKind.CompileTime => emitTSExpr(expr.children[0])
  ExprKind.Unwrap => "__runeUnwrap(" + emitTSExpr(expr.children[0]) + ")"
  ExprKind.Binary => emitTSBinary(expr)
  ExprKind.Ternary => emitTSTernary(expr)
  ExprKind.Assign => emitTSAssign(expr)
  ExprKind.Call => emitTSCall(expr)
  ExprKind.Lambda => emitTSLambda(expr)
  ExprKind.Selector => emitTSSelector(expr)
  ExprKind.Index => ((emitTSExpr(expr.children[0]) + "[") + emitTSExpr(expr.children[1])) + "]"
  ExprKind.Array => ("[" + emitTSExprList(expr.children, 0, "")) + "]"
  ExprKind.Tuple => ("[" + emitTSExprList(expr.children, 0, "")) + "]"
  ExprKind.Map => ("new Map([" + emitTSMapEntries(expr.children, 0, "")) + "])"
  ExprKind.Spread => "..." + emitTSExpr(expr.children[0])
  ExprKind.Reactive => emitTSExpr(expr.children[0])
  ExprKind.Struct => ("{" + emitTSFields(expr.children, 0, "")) + "}"
  ExprKind.Object => ("{" + emitTSFields(expr.children, 0, "")) + "}"
  ExprKind.Block => ("(() => {\n" + emitTSBlock(expr.children, 0, true, "Dynamic", 1, "")) + "})()"
  _ => "undefined"
}

emitTSXMLExpr(expr: IRExpr) -> String => (("(() => {\n" + emitTSXMLExprBody(expr, "__el0", 1)) + line(1, "return __el0;")) + "})()"

emitTSXMLCreateElement(expr: IRExpr) -> String => "document.createElement(" + tsQuoteString(expr.name) + ")"

emitTSXMLExprBody(
  expr: IRExpr,
  name: String,
  level: Int
) -> String => {
  out := line(level, (("const " + name) + " = ") + emitTSXMLCreateElement(expr) + ";")
  out = out + emitTSXMLParts(name, expr.children, 0, level, 1)
  out
}

emitTSXMLParts(
  parent: String,
  children: Array[IRExpr],
  index: Int,
  level: Int,
  childIndex: Int
) -> String => (
  index >= children.length() ? ""
    : emitTSXMLPart(parent, children, index, level, childIndex)
)

emitTSXMLPart(
  parent: String,
  children: Array[IRExpr],
  index: Int,
  level: Int,
  childIndex: Int
) -> String => {
  child := children[index]
  nextIndex := (
    child.kind == ExprKind.XMLElement ? childIndex + 1
      : childIndex
  )
  emitTSXMLChild(parent, child, level, childIndex) + emitTSXMLParts(parent, children, index + 1, level, nextIndex)
}

emitTSXMLChild(
  parent: String,
  child: IRExpr,
  level: Int,
  childIndex: Int
) -> String => child.kind {
  ExprKind.Field => emitTSXMLAttr(parent, child, level)
  ExprKind.XMLText => line(level, ((parent + ".appendChild(document.createTextNode(") + tsQuoteString(child.value)) + "));")
  ExprKind.XMLElement => emitTSXMLNestedChild(parent, child, level, childIndex)
  _ => emitTSXMLExprChild(parent, child, level, childIndex)
}

emitTSXMLNestedChild(
  parent: String,
  child: IRExpr,
  level: Int,
  childIndex: Int
) -> String => {
  name := (parent + "_") + childIndex.toString()
  emitTSXMLExprBody(child, name, level) + line(level, (parent + ".appendChild(") + name + ");")
}

emitTSXMLExprChild(
  parent: String,
  child: IRExpr,
  level: Int,
  childIndex: Int
) -> String => {
  childType := child.text
  childName := (parent + "_child") + childIndex.toString()
  childType.startsWith("Array[") ? line(level, ("for (const " + childName) + " of " + emitTSExpr(child) + ") {") + line(level + 1, (parent + ".appendChild(") + childName + ");") + line(level, "}")
    : (
      childType == "HTMLElement" ? line(level, (parent + ".appendChild(") + emitTSExpr(child) + ");")
        : line(level, ((parent + ".appendChild(document.createTextNode(String(") + emitTSExpr(child)) + ")));" )
    )
}

emitTSXMLAttr(
  parent: String,
  attr: IRExpr,
  level: Int
) -> String => {
  attr.op == "xmlEvent" ? emitTSXMLEventAttr(parent, attr, level)
    : emitTSXMLPlainAttr(parent, attr, level)
}

emitTSXMLEventAttr(
  parent: String,
  attr: IRExpr,
  level: Int
) -> String => (
  attr.children.length() == 0 ? ""
    : line(level, ((((parent + ".addEventListener(") + tsQuoteString(attr.name)) + ", () => { ") + emitTSExpr(attr.children[0])) + "; });")
)

emitTSXMLPlainAttr(
  parent: String,
  attr: IRExpr,
  level: Int
) -> String => {
  prefix := (parent + ".setAttribute(") + tsQuoteString(attr.name)
  attr.children.length() == 0 ? line(level, prefix + ", \"\");")
    : line(level, (prefix + ", String(") + emitTSExpr(attr.children[0]) + "));")
}

emitTSTemplate(expr: IRExpr) -> String => {
  raw := expr.value
  inner := (
    raw.length() >= 2 ? raw.slice(1, raw.length() - 1)
      : raw
  )
  emitTSTemplateParts(inner.split("<<<RUNE_TEMPLATE_PART>>>"), expr.children, 0, "`") + "`"
}

emitTSTemplateParts(
  segments: Array[String],
  children: Array[IRExpr],
  index: Int,
  out: String
) -> String => (
  index >= segments.length() ? out
    : emitTSTemplateAtom(segments, children, index, out)
)

emitTSTemplateAtom(
  segments: Array[String],
  children: Array[IRExpr],
  index: Int,
  out: String
) -> String => {
  textOut := out + tsEscapeTemplateText(segments[index])
  next := (
    index < children.length() ? textOut + ("${" + emitTSExpr(children[index]) + "}")
      : textOut
  )
  emitTSTemplateParts(segments, children, index + 1, next)
}

/// Escape text so it is safe inside a JavaScript/TypeScript template literal.
/// Rune backslash escapes for n/t/r/\\ and the backtick itself are already
/// interpreted consistently by JS template literals, so the only character that
/// needs shielding is the `$` that begins a JS `${...}` interpolation.
tsEscapeTemplateText(text: String) -> String => tsEscapeTemplateChars(text, 0, "")

tsEscapeTemplateChars(
  text: String,
  index: Int,
  out: String
) -> String => (index >= text.length() ? out
  : tsEscapeTemplateChar(text, index, out))

tsEscapeTemplateChar(
  text: String,
  index: Int,
  out: String
) -> String => ((text.at(index) == '$') && ((index + 1) < text.length()) && (text.at(index + 1) == '{')) {
  true => tsEscapeTemplateChars(text, index + 2, out + "\\${")
  _ => tsEscapeTemplateChars(text, index + 1, out + text.at(index).toString())
}

emitTSExprExpected(
  expr: IRExpr,
  expected: String
) -> String => expr.kind {
  ExprKind.Call => emitTSCallExpected(expr, expected)
  _ => emitTSExpr(expr)
}

emitTSCallExpected(
  expr: IRExpr,
  expected: String
) -> String => {
  args := genericInner(expected, "Result")
  (
    (args != "") && isTSResultConstructorCall(expr) ? ((emitTSExpr(expr.children[0]) + "<") + emitTSTypeArgs(args)) + ">(" + emitTSExprListFrom(expr.children, 1, "") + ")"
      : emitTSCall(expr)
  )
}

isTSResultConstructorCall(
  expr: IRExpr
) -> Bool => (
  (expr.kind == ExprKind.Call) && (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Identifier) && ((expr.children[0].name == "Ok") || (expr.children[0].name == "Err"))
)

emitTSBinary(expr: IRExpr) -> String => (((emitTSExpr(expr.children[0]) + " ") + tsBinaryOp(expr.op)) + " ") + emitTSExpr(expr.children[1])

emitTSTernary(expr: IRExpr) -> String => (((emitTSExpr(expr.children[0]) + " ? ") + emitTSExpr(expr.children[1])) + " : ") + (
  expr.children.length() > 2 ? emitTSExpr(expr.children[2])
    : "undefined"
)

emitTSAssign(expr: IRExpr) -> String => (
  expr.children.length() == 2 ? (emitTSExpr(expr.children[0]) + " = ") + emitTSExpr(expr.children[1])
    : (mangleIdent(expr.name) + " = ") + emitTSExpr(expr.children[0])
)

emitTSCall(expr: IRExpr) -> String => moduleCallKey(expr) {
  "io.println" => ("console.log(" + emitTSExprListFrom(expr.children, 1, "")) + ")"
  "json.stringify" => "JSON.stringify(" + emitTSExpr(expr.children[1]) + ")"
  "json.parse" => "JSON.parse(" + emitTSExpr(expr.children[1]) + ")"
  "map.new" => "new Map()"
  "set.new" => "new Set()"
  "path.isAbsolute" => emitTSExpr(expr.children[1]) + ".startsWith(\"/\")"
  "path.basename" => "__runePathBasename(" + emitTSExpr(expr.children[1]) + ")"
  "path.extname" => "__runePathExtname(" + emitTSExpr(expr.children[1]) + ")"
  "path.dirname" => "__runePathDirname(" + emitTSExpr(expr.children[1]) + ")"
  "path.join" => "__runePathJoin(" + emitTSExpr(expr.children[1]) + ")"
  "path.normalize" => "__runePathNormalize(" + emitTSExpr(expr.children[1]) + ")"
  "path.resolve" => "__runePathResolve(" + emitTSExpr(expr.children[1]) + ")"
  "path.relative" => ("__runePathRelative(" + emitTSExpr(expr.children[1]) + ", ") + emitTSExpr(expr.children[2]) + ")"
  "path.joinParts" => (((("__runePathJoinParts(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3]) + ")"
  "path.appendPathPart" => ("__runePathAppendPart(" + emitTSExpr(expr.children[1]) + ", ") + emitTSExpr(expr.children[2]) + ")"
  "path.normalizeParts" => (((((("__runePathNormalizeParts(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3])) + ", ") + emitTSExpr(expr.children[4]) + ")"
  "path.normalizePart" => (((((("__runePathNormalizeParts(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3])) + ", ") + emitTSExpr(expr.children[4]) + ")"
  "path.normalizeParent" => (((((("__runePathNormalizeParent(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3])) + ", ") + emitTSExpr(expr.children[4]) + ")"
  "path.normalizePop" => (((((("__runePathNormalizePop(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3])) + ", ") + emitTSExpr(expr.children[4]) + ")"
  "path.normalizePush" => ((((((((("__runePathNormalizePush(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3])) + ", ") + emitTSExpr(expr.children[4])) + ", ") + emitTSExpr(expr.children[5])) + ")"
  "path.pathParts" => "__runePathParts(" + emitTSExpr(expr.children[1]) + ")"
  "path.collectPathParts" => (((("__runePathCollectParts(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3]) + ")"
  "path.collectPathPart" => (((("__runePathCollectPart(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3]) + ")"
  "path.relativeFromParts" => (((("__runePathRelativeFromParts(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3]) + ")"
  "path.relativeTail" => (((((("__runePathRelativeTail(" + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2])) + ", ") + emitTSExpr(expr.children[3])) + ", ") + emitTSExpr(expr.children[4]) + ", " + emitTSExpr(expr.children[5]) + ")"
  "process.platform" => "\"js\""
  "process.cwd" => "\".\""
  "process.env" => "null"
  "process.argv" => "[]"
  "int.toString" => "String(" + emitTSExpr(expr.children[1]) + ")"
  "int.toDouble" => emitTSExpr(expr.children[1])
  "int.toBigInt" => "BigInt(" + emitTSExpr(expr.children[1]) + ")"
  "int4.fromInt" => "((__value: number): number => { const __n = __value & 0xf; return __n >= 8 ? __n - 16 : __n; })(" + emitTSExpr(expr.children[1]) + ")"
  "int8.fromInt" => "((__value: number): number => (__value << 24) >> 24)(" + emitTSExpr(expr.children[1]) + ")"
  "int16.fromInt" => "((__value: number): number => (__value << 16) >> 16)(" + emitTSExpr(expr.children[1]) + ")"
  "int64.fromInt" => "BigInt(" + emitTSExpr(expr.children[1]) + ")"
  "uint.fromInt" => "(" + emitTSExpr(expr.children[1]) + " >>> 0)"
  "uint8.fromInt" => "(" + emitTSExpr(expr.children[1]) + " & 0xff)"
  "uint16.fromInt" => "(" + emitTSExpr(expr.children[1]) + " & 0xffff)"
  "uint64.fromInt" => "BigInt.asUintN(64, BigInt(" + emitTSExpr(expr.children[1]) + "))"
  "float.fromDouble" => "Math.fround(" + emitTSExpr(expr.children[1]) + ")"
  "int4.toInt" | "int8.toInt" | "int16.toInt" | "uint.toInt" | "uint8.toInt" | "uint16.toInt" | "float.toDouble" => emitTSExpr(expr.children[1])
  "int64.toInt" | "uint64.toInt" => "Number(" + emitTSExpr(expr.children[1]) + ")"
  "bigint.fromInt" => "BigInt(" + emitTSExpr(expr.children[1]) + ")"
  "bigint.toString" => "String(" + emitTSExpr(expr.children[1]) + ")"
  "bigint.toDouble" => "Number(" + emitTSExpr(expr.children[1]) + ")"
  "double.trunc" => "Math.trunc(" + emitTSExpr(expr.children[1]) + ")"
  "double.floor" => "Math.floor(" + emitTSExpr(expr.children[1]) + ")"
  "double.ceil" => "Math.ceil(" + emitTSExpr(expr.children[1]) + ")"
  "double.round" => "Math.round(" + emitTSExpr(expr.children[1]) + ")"
  _ => emitTSMaybeCoreMethodCall(expr)
}

emitTSMaybeCoreMethodCall(
  expr: IRExpr
) -> String => (
  (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Selector) ? emitTSCoreMethodCall(expr, expr.children[0])
    : emitTSDefaultCall(expr)
)

emitTSCoreMethodCall(
  expr: IRExpr,
  selector: IRExpr
) -> String => (
  (selector.children.length() > 0) && (selector.children[0].kind != ExprKind.At) ? selector.name {
    "length" | "byteLength" => emitTSCoreLength(selector.children[0])
    "isEmpty" => ("(" + emitTSCoreLength(selector.children[0])) + " === 0)"
    "at" => emitTSCoreAt(expr, selector.children[0])
    "slice" => emitTSCoreSlice(expr, selector.children[0])
    _ => emitTSDefaultCall(expr)
  }
    : emitTSDefaultCall(expr)
)

emitTSCoreLength(
  receiver: IRExpr
) -> String => (
  receiver.text == "String" ? "Array.from(" + emitTSExpr(receiver) + ").length"
    : emitTSExpr(receiver) + ".length"
)

emitTSCoreAt(
  expr: IRExpr,
  receiver: IRExpr
) -> String => (
  receiver.text == "String" ? ("(Array.from(" + emitTSExpr(receiver) + ")[") + emitTSExpr(expr.children[1]) + "] ?? \"\")"
    : ((emitTSExpr(receiver) + "[") + emitTSExpr(expr.children[1])) + "]"
)

emitTSCoreSlice(
  expr: IRExpr,
  receiver: IRExpr
) -> String => (
  receiver.text == "String" ? (((("Array.from(" + emitTSExpr(receiver)) + ").slice(") + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2]) + ").join(\"\")"
    : (((emitTSExpr(receiver) + ".slice(") + emitTSExpr(expr.children[1])) + ", ") + emitTSExpr(expr.children[2]) + ")"
)

emitTSDefaultCall(
  expr: IRExpr
) -> String => ((emitTSExpr(expr.children[0]) + "(") + emitTSExprListFrom(expr.children, 1, "")) + ")"

emitTSLambda(expr: IRExpr) -> String => (("(" + emitTSParams(expr.params, 0, "")) + ") => ") + emitTSExpr(expr.children[0])

emitTSSelector(expr: IRExpr) -> String => expr.children[0].kind {
  ExprKind.At => emitTSAtSelector(expr)
  ExprKind.Identifier => expr.op {
    "::" => mangleIdent((expr.children[0].name + "_") + expr.name)
    _ => (emitTSExpr(expr.children[0]) + ".") + tsPropertyName(expr.name)
  }
  _ => (emitTSExpr(expr.children[0]) + ".") + tsPropertyName(expr.name)
}

emitTSAtSelector(
  expr: IRExpr
) -> String => {
  imported := expr.children[0].value != ""
  imported {
    true => mangleIdent(expr.name)
    _ => (("@" + expr.children[0].name) + ".") + expr.name
  }
}

emitTSExprList(
  exprs: Array[IRExpr],
  index: Int,
  out: String
) -> String => emitTSExprListFrom(exprs, index, out)

emitTSExprListFrom(
  exprs: Array[IRExpr],
  index: Int,
  out: String
) -> String => (
  index >= exprs.length() ? out
    : emitTSExprListFrom(exprs, index + 1, (out + (
      out == "" ? ""
        : ", "
    )) + emitTSExpr(exprs[index]))
)

emitTSMapEntries(
  entries: Array[IRExpr],
  index: Int,
  out: String
) -> String => (
  index >= entries.length() ? out
    : emitTSMapEntries(entries, index + 1, (((((out + (
      out == "" ? ""
        : ", "
    )) + "[") + emitTSExpr(entries[index].children[0])) + ", ") + emitTSExpr(entries[index].children[1])) + "]")
)

emitTSFields(
  fields: Array[IRExpr],
  index: Int,
  out: String
) -> String => (
  index >= fields.length() ? out
    : emitTSFields(fields, index + 1, (((out + (
      out == "" ? ""
        : ", "
    )) + tsPropertyName(fields[index].name)) + ": ") + emitTSExpr(fields[index].children[0]))
)

tsBinaryOp(op: String) -> String => op {
  "==" => "==="
  "!=" => "!=="
  _ => op
}

tsType(typeName: String) -> String => {
  "" | "Void" => "void"
  "Int" | "Int4" | "Int8" | "Int16" | "UInt" | "UInt8" | "UInt16" | "Double" | "Float" => "number"
  "BigInt" | "Int64" | "UInt64" => "bigint"
  "String" | "Char" => "string"
  "Bool" => "boolean"
  "Dynamic" => "any"
  "HTMLElement" => "HTMLElement"
  "WebComponent" => "CustomElementConstructor"
  "Data" | "@io.Data" => "Uint8Array"
  _ => tsTypeFallback(typeName)
}

tsTypeFallback(
  typeName: String
) -> String => (
  typeName.endsWith("?") ? tsType(typeName.slice(0, typeName.length() - 1)) + " | null"
    : (
      genericInner(typeName, "Array") != "" ? tsType(genericInner(typeName, "Array")) + "[]"
        : (
          genericInner(typeName, "ReadonlyArray") != "" ? ("ReadonlyArray<" + tsType(genericInner(typeName, "ReadonlyArray"))) + ">"
            : (
              genericInner(typeName, "Map") != "" ? ((("Map<" + tsType(typeArg(genericInner(typeName, "Map"), 0))) + ", ") + tsType(typeArg(genericInner(typeName, "Map"), 1))) + ">"
                : (
                  genericInner(typeName, "Set") != "" ? ("Set<" + tsType(genericInner(typeName, "Set"))) + ">"
                    : tsNamedType(typeName)
                )
            )
        )
    )
)

tsNamedType(
  typeName: String
) -> String => {
  open := typeName.indexOf("[")
  (
    open < 0 ? mangleIdent(typeName)
      : (mangleIdent(typeName.slice(0, open)) + "<") + emitTSTypeArgs(typeName.slice(open + 1, typeName.length() - 1)) + ">"
  )
}

emitTSTypeArgs(
  args: String
) -> String => emitTSTypeArgList(args.split(","), 0, "")

emitTSTypeArgList(
  args: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= args.length() ? out
    : emitTSTypeArgList(args, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + tsType(args[index].trim()))
)

tsPropertyName(name: String) -> String => name

joinStrings(
  values: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= values.length() ? out
    : joinStrings(values, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + values[index])
)
