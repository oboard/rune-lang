@"../ir/ir.rn"
@"./common.rn"

+ generateGo(file: IRFile) -> String => {
  out :=: "package main\n\n"
  out = out + emitGoImports(file)
  (
    fileUsesUnwrap(file) ? out = out + emitGoUnwrapHelper()
  )
  (
    fileUsesPathFamily(file) ? out = out + emitGoPathHelpers()
  )
  file.enums.each((enumDecl) => out = (out + emitGoEnum(enumDecl)) + "\n")
  file.enums.each((enumDecl) => out = out + emitGoEnumMethods(file, enumDecl))
  file.structs.each((typeDecl) => out = (out + emitGoStruct(typeDecl)) + "\n")
  file.structs.each((typeDecl) => out = out + emitGoMethods(file, typeDecl))
  file.functions.each((fn) => out = (
    fn.macro ? out
      : (out + emitGoFunction(file, fn, "")) + "\n"
  ))
  (
    hasMain(file) ? out = ((out + "func main() {\n\t") + mangleIdent("main")) + "()\n}\n"
  )
  out
}

emitGoImports(
  file: IRFile
) -> String => {
  imports := []
  (
    usesPrintFile(file) ? imports.push("fmt")
  )
  (
    fileUsesGoStrings(file) ? imports.push("strings")
  )
  (
    fileUsesModuleCall(file, "process.platform") ? imports.push("runtime")
  )
  (
    fileUsesModuleCall(file, "process.argv") || fileUsesModuleCall(file, "process.exit") ? imports.push("os")
  )
  (
    fileUsesDoubleMath(file) ? imports.push("math")
  )
  (
    fileUsesModuleCall(file, "int.toString") || fileUsesModuleCall(file, "bigint.toString") ? imports.push("strconv")
  )
  (
    fileUsesUnwrap(file) ? imports.push("reflect")
  )
  imports.length() == 0 ? ""
    : ("import (\n" + emitGoImportLines(imports, 0, "")) + ")\n\n"
}

emitGoImportLines(
  imports: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= imports.length() ? out
    : emitGoImportLines(imports, index + 1, ((out + "\t\"") + imports[index]) + "\"\n")
)

emitGoUnwrapHelper() -> String => `func __runeUnwrap(value any) any {
	v := reflect.ValueOf(value)
	if v.Kind() == reflect.Pointer {
		v = v.Elem()
	}
	tag := v.FieldByName("__tag").Int()
	payload := v.FieldByName("__payload")
	if tag == 0 {
		if payload.Len() == 0 {
			return nil
		}
		return payload.Index(0).Interface()
	}
	if payload.Len() > 0 {
		panic(payload.Index(0).Interface())
	}
	panic("Result.Err")
}

`

emitGoPathHelpers() -> String => `func __runePathBasename(path string) string {
	index := strings.LastIndex(path, "/")
	if index < 0 {
		return path
	}
	if index == len(path)-1 {
		return path
	}
	return path[index+1:]
}

func __runePathExtname(path string) string {
	base := __runePathBasename(path)
	index := strings.LastIndex(base, ".")
	if index <= 0 {
		return ""
	}
	return base[index:]
}

func __runePathDirname(path string) string {
	index := strings.LastIndex(path, "/")
	if index < 0 {
		return "."
	}
	if index == 0 {
		return "/"
	}
	return path[:index]
}

func __runePathJoin(parts []any) string {
	return __runePathNormalize(__runePathJoinParts(__runePathStringParts(parts), 0, ""))
}

func __runePathNormalize(path string) string {
	absolute := strings.HasPrefix(path, "/")
	out := __runePathNormalizeParts(strings.Split(path, "/"), 0, absolute, []string{})
	joined := __runePathJoinParts(out, 0, "")
	if absolute {
		return "/" + joined
	}
	if joined == "" {
		return "."
	}
	return joined
}

func __runePathResolve(parts []any) string {
	if len(parts) == 0 {
		return "."
	}
	return __runePathNormalize(__runePathJoin(parts))
}

func __runePathRelative(from string, to string) string {
	fromParts := __runePathParts(__runePathResolve([]any{from}))
	toParts := __runePathParts(__runePathResolve([]any{to}))
	index := 0
	for index < len(fromParts) && index < len(toParts) && fromParts[index] == toParts[index] {
		index++
	}
	out := ""
	for i := index; i < len(fromParts); i++ {
		out = __runePathAppendPart(out, "..")
	}
	for i := index; i < len(toParts); i++ {
		out = __runePathAppendPart(out, toParts[i])
	}
	if out == "" {
		return "."
	}
	return out
}

func __runePathStringParts(parts []any) []string {
	out := make([]string, 0, len(parts))
	for _, part := range parts {
		out = append(out, part.(string))
	}
	return out
}

func __runePathParts(path string) []string {
	clean := __runePathNormalize(path)
	out := []string{}
	for _, part := range strings.Split(clean, "/") {
		if part != "" {
			out = append(out, part)
		}
	}
	return out
}

func __runePathJoinParts(parts []string, index int, out string) string {
	for index < len(parts) {
		out = __runePathAppendPart(out, parts[index])
		index++
	}
	return out
}

func __runePathAppendPart(out string, part string) string {
	if out == "" {
		return part
	}
	if part == "" {
		return out
	}
	return out + "/" + part
}

func __runePathNormalizeParts(parts []string, index int, absolute bool, out []string) []string {
	for index < len(parts) {
		part := parts[index]
		if part == "" || part == "." {
			index++
			continue
		}
		if part == ".." {
			return __runePathNormalizeParent(parts, index, absolute, out)
		}
		return __runePathNormalizePush(parts, index, absolute, out, part)
	}
	return out
}

func __runePathNormalizeParent(parts []string, index int, absolute bool, out []string) []string {
	if len(out) > 0 {
		return __runePathNormalizePop(parts, index, absolute, out)
	}
	if absolute {
		return __runePathNormalizeParts(parts, index+1, absolute, out)
	}
	return __runePathNormalizePush(parts, index, absolute, out, "..")
}

func __runePathNormalizePop(parts []string, index int, absolute bool, out []string) []string {
	return __runePathNormalizeParts(parts, index+1, absolute, out[:len(out)-1])
}

func __runePathNormalizePush(parts []string, index int, absolute bool, out []string, part string) []string {
	return __runePathNormalizeParts(parts, index+1, absolute, append(out, part))
}

func __runePathCollectParts(parts []string, index int, out []string) []string {
	for index < len(parts) {
		if parts[index] != "" {
			out = append(out, parts[index])
		}
		index++
	}
	return out
}

func __runePathCollectPart(parts []string, index int, out []string) []string {
	if index < len(parts) {
		out = append(out, parts[index])
	}
	return __runePathCollectParts(parts, index+1, out)
}

func __runePathRelativeFromParts(fromParts []string, toParts []string, index int) string {
	for index < len(fromParts) && index < len(toParts) && fromParts[index] == toParts[index] {
		index++
	}
	return __runePathRelativeTail(fromParts, toParts, index, index, "")
}

func __runePathRelativeTail(fromParts []string, toParts []string, fromIndex int, toIndex int, out string) string {
	for fromIndex < len(fromParts) {
		out = __runePathAppendPart(out, "..")
		fromIndex++
	}
	for toIndex < len(toParts) {
		out = __runePathAppendPart(out, toParts[toIndex])
		toIndex++
	}
	if out == "" {
		return "."
	}
	return out
}

`

emitGoEnum(
  enumDecl: IREnumType
) -> String => {
  enumHasPayload(enumDecl.members) ? emitGoPayloadEnum(enumDecl)
    : emitGoSimpleEnum(enumDecl)
}

emitGoSimpleEnum(
  enumDecl: IREnumType
) -> String => {
  out :=: ("type " + mangleIdent(enumDecl.name)) + " int\n\n"
  out = out + "const (\n"
  out = out + emitGoEnumMembers(enumDecl.name, enumDecl.members, 0, "")
  out + ")\n"
}

emitGoPayloadEnum(
  enumDecl: IREnumType
) -> String => {
  out :=: (("type " + mangleIdent(enumDecl.name)) + emitGoGenericsDecl(enumDecl.generics)) + " struct {\n"
  out = out + "\t__tag int\n"
  out = out + "\t__payload []any\n"
  out = out + "}\n\n"
  out = out + "const (\n"
  out = out + emitGoPayloadEnumTags(enumDecl.name, enumDecl.members, 0, "")
  out = out + ")\n\n"
  out + emitGoPayloadEnumConstructors(enumDecl.name, enumDecl.generics, enumDecl.members, 0, "")
}

emitGoPayloadEnumTags(
  enumName: String,
  members: Array[IREnumMember],
  index: Int,
  out: String
) -> String => (
  index >= members.length() ? out
    : emitGoPayloadEnumTags(enumName, members, index + 1, (((out + "\t") + mangleIdent(((enumName + "_") + members[index].name) + "_tag")) + " = ") + enumValue(members[index], index) + "\n")
)

emitGoPayloadEnumConstructors(
  enumName: String,
  generics: Array[String],
  members: Array[IREnumMember],
  index: Int,
  out: String
) -> String => (
  index >= members.length() ? out
    : emitGoPayloadEnumConstructors(enumName, generics, members, index + 1, out + emitGoPayloadEnumConstructor(enumName, generics, members[index]))
)

emitGoPayloadEnumConstructor(
  enumName: String,
  generics: Array[String],
  member: IREnumMember
) -> String => {
  tagName := mangleIdent(((enumName + "_") + member.name) + "_tag")
  typeName := mangleIdent(enumName) + emitGoGenericsUse(generics)
  (
    member.params.length() == 0 ? (((("var " + mangleIdent((enumName + "_") + member.name)) + " = ") + typeName) + "{__tag: ") + tagName + ", __payload: nil}\n"
      : ((((((("func " + mangleIdent(member.name)) + emitGoGenericsDecl(generics)) + "(") + emitGoParams(member.params, 0, "")) + ") ") + typeName) + " {\n\treturn ") + typeName + "{__tag: " + tagName + ", __payload: []any{" + emitGoParamNames(member.params, 0, "") + "}}\n}\n"
  )
}

emitGoParamNames(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : emitGoParamNames(params, index + 1, (out + (
      out == "" ? ""
        : ", "
    )) + mangleIdent(params[index].name))
)

enumHasPayload(
  members: Array[IREnumMember]
) -> Bool => enumHasPayloadAt(members, 0)

enumHasPayloadAt(
  members: Array[IREnumMember],
  index: Int
) -> Bool => (
  index >= members.length() ? false
    : (
      members[index].params.length() > 0 ? true
        : enumHasPayloadAt(members, index + 1)
    )
)

emitGoEnumMembers(
  enumName: String,
  members: Array[IREnumMember],
  index: Int,
  out: String
) -> String => (
  index >= members.length() ? out
    : emitGoEnumMembers(enumName, members, index + 1, ((((((out + "\t") + mangleIdent((enumName + "_") + members[index].name)) + " ") + mangleIdent(enumName)) + " = ") + enumValue(members[index], index)) + "\n")
)

emitGoStruct(
  typeDecl: IRStructType
) -> String => {
  out :=: (("type " + mangleIdent(typeDecl.name)) + emitGoGenericsDecl(typeDecl.generics)) + " struct {\n"
  typeDecl.fields.each((field) => out = ((((out + "\t") + mangleIdent(field.name)) + " ") + goType(field.typeName)) + "\n")
  out + "}\n"
}

emitGoMethods(
  file: IRFile,
  typeDecl: IRStructType
) -> String => {
  out :=: ""
  typeDecl.methods.each((method) => out = (out + emitGoFunction(file, method, typeDecl.name)) + "\n")
  out
}

emitGoEnumMethods(
  file: IRFile,
  enumDecl: IREnumType
) -> String => {
  out :=: ""
  enumDecl.methods.each((method) => out = (out + emitGoFunction(file, method, enumDecl.name)) + "\n")
  out
}

emitGoFunction(
  file: IRFile,
  fn: IRFunction,
  receiverType: String
) -> String => {
  returnType := inferredGoReturnType(fn)
  params := emitGoFunctionParams(fn, 0, "")
  ret := (
    returnsValue(returnType) ? " " + goType(returnType)
      : ""
  )
  receiver := (
    receiverType == "" ? ""
      : ((("(" + mangleIdent("this")) + " ") + mangleIdent(receiverType)) + ") "
  )
  name := (
    receiverType == "" ? mangleIdent(fn.name)
      : mangleIdent(fn.name)
  )
  out :=: (((((("func " + receiver) + name) + "(") + params) + ")") + ret) + " {\n"
  out = out + emitGoBody(file, fn.body, returnsValue(returnType), returnType, 1)
  out + "}\n"
}

inferredGoReturnType(
  fn: IRFunction
) -> String => (
  fn.returnType != "" ? fn.returnType
    : (
      fn.body.kind == ExprKind.PatternBlock ? "Int"
        : ""
    )
)

emitGoFunctionParams(
  fn: IRFunction,
  index: Int,
  out: String
) -> String => (
  index >= fn.params.length() ? out
    : emitGoFunctionParams(fn, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(fn.params[index].name)) + " ") + goType(inferredGoParamType(fn, fn.params[index])))
)

inferredGoParamType(
  fn: IRFunction,
  param: IRParam
) -> String => (
  param.typeName != "" ? param.typeName
    : (
      (fn.body.kind == ExprKind.PatternBlock) && (fn.params.length() == 1) ? "Int"
        : ""
    )
)

emitGoBody(
  file: IRFile,
  expr: IRExpr,
  returns: Bool,
  returnType: String,
  level: Int
) -> String => expr.kind {
  ExprKind.Block => emitGoBlock(file, expr.children, 0, returns, returnType, level, "")
  ExprKind.PatternBlock => emitGoPatternBlock(file, expr, returns, returnType, level)
  _ => line(level, (
    returns ? "return " + emitGoExprExpected(expr, returnType)
      : emitGoExpr(expr)
  ))
}

emitGoPatternBlock(
  file: IRFile,
  expr: IRExpr,
  returns: Bool,
  returnType: String,
  level: Int
) -> String => emitGoPatternBranches(file, expr.children, 0, returns, returnType, level, "")

emitGoPatternBranches(
  file: IRFile,
  branches: Array[IRExpr],
  index: Int,
  returns: Bool,
  returnType: String,
  level: Int,
  out: String
) -> String => (
  index >= branches.length() ? out + line(level, "}") + (
    returns ? line(level, "return " + goZero(returnType))
      : ""
  )
    : emitGoPatternBranches(file, branches, index + 1, returns, returnType, level, out + emitGoPatternBranch(file, branches[index], returns, returnType, level, index == 0))
)

emitGoPatternBranch(
  file: IRFile,
  branch: IRExpr,
  returns: Bool,
  returnType: String,
  level: Int,
  first: Bool
) -> String => {
  pattern := branch.children[0]
  value := branch.children[1]
  head := (
    first ? "if "
      : "else if "
  )
  (
    pattern.text == "_" ? line(level, emitGoPatternPrefix(first) + "else {") + emitGoPatternBranchBody(file, value, returns, returnType, level + 1)
      : line(level, (emitGoPatternPrefix(first) + head + emitGoPatternCondition(pattern)) + " {") + emitGoPatternBranchBody(file, value, returns, returnType, level + 1)
  )
}

emitGoPatternPrefix(
  first: Bool
) -> String => (
  first ? ""
    : "} "
)

emitGoPatternBranchBody(
  file: IRFile,
  value: IRExpr,
  returns: Bool,
  returnType: String,
  level: Int
) -> String => (
  returns ? line(level, "return " + emitGoExprExpected(value, returnType))
    : line(level, emitGoExpr(value))
)

emitGoPatternCondition(
  pattern: IRExpr
) -> String => "__n == " + pattern.text

emitGoBlock(
  file: IRFile,
  statements: Array[IRExpr],
  index: Int,
  returns: Bool,
  returnType: String,
  level: Int,
  out: String
) -> String => (
  index >= statements.length() ? (
    returns && (statements.length() == 0) ? out + line(level, "return " + goZero(returnType))
      : out
  )
    : emitGoBlock(file, statements, index + 1, returns, returnType, level, out + emitGoStatement(file, statements[index], index == (statements.length() - 1), returns, returnType, level))
)

emitGoStatement(
  file: IRFile,
  expr: IRExpr,
  last: Bool,
  returns: Bool,
  returnType: String,
  level: Int
) -> String => expr.kind {
  ExprKind.Let => emitGoLet(file, expr, level)
  ExprKind.ObjectDestructure => emitGoObjectDestructure(expr, level)
  _ => (
    last && returns ? line(level, "return " + emitGoExprExpected(expr, returnType))
      : line(level, emitGoExpr(expr))
  )
}

emitGoLet(
  file: IRFile,
  expr: IRExpr,
  level: Int
) -> String => {
  value := emitGoExpr(expr.children[0])
  payload := unwrapPayloadType(file, expr.children[0])
  (
    payload != "" ? value = (value + ".(") + goType(payload) + ")"
  )
  line(level, (mangleIdent(expr.name) + " := ") + value) + line(level, "_ = " + mangleIdent(expr.name))
}

emitGoObjectDestructure(
  expr: IRExpr,
  level: Int
) -> String => {
  source := emitGoExpr(expr.children[0])
  out :=: ""
  expr.params.each((param) => out = (out + line(level, (((mangleIdent(param.name) + " := ") + source) + ".") + mangleIdent(param.typeName))) + line(level, "_ = " + mangleIdent(param.name)))
  out
}

emitGoParams(
  params: Array[IRParam],
  index: Int,
  out: String
) -> String => (
  index >= params.length() ? out
    : emitGoParams(params, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(params[index].name)) + " ") + goType(params[index].typeName))
)

emitGoExpr(expr: IRExpr) -> String => expr.kind {
  ExprKind.Identifier => mangleIdent(expr.name)
  ExprKind.At => expr.name
  ExprKind.This => mangleIdent("this")
  ExprKind.Int => expr.value
  ExprKind.Double => expr.value
  ExprKind.BigInt => "int64(" + bigintLiteralDigits(expr.value) + ")"
  ExprKind.String => expr.value
  ExprKind.Template => "\"\""
  ExprKind.Char => expr.value
  ExprKind.Regex => expr.value
  ExprKind.Bool => expr.value
  ExprKind.Null => "nil"
  ExprKind.Unary => expr.op + emitGoExpr(expr.children[0])
  ExprKind.Postfix => emitGoExpr(expr.children[0]) + expr.op
  ExprKind.CompileTime => emitGoExpr(expr.children[0])
  ExprKind.Unwrap => "__runeUnwrap(" + emitGoExpr(expr.children[0]) + ")"
  ExprKind.Binary => emitGoBinary(expr)
  ExprKind.Ternary => emitGoTernary(expr)
  ExprKind.Assign => emitGoAssign(expr)
  ExprKind.Call => emitGoCall(expr)
  ExprKind.Lambda => emitGoLambda(expr)
  ExprKind.Selector => emitGoSelector(expr)
  ExprKind.Index => ((emitGoExpr(expr.children[0]) + "[") + emitGoExpr(expr.children[1])) + "]"
  ExprKind.Array => ("[]any{" + emitGoExprList(expr.children, 0, "")) + "}"
  ExprKind.Tuple => ("[]any{" + emitGoExprList(expr.children, 0, "")) + "}"
  ExprKind.Map => ("map[any]any{" + emitGoMapEntries(expr.children, 0, "")) + "}"
  ExprKind.Spread => emitGoExpr(expr.children[0])
  ExprKind.Reactive => emitGoExpr(expr.children[0])
  ExprKind.Struct => ((mangleIdent(expr.name) + "{") + emitGoFields(expr.children, 0, "")) + "}"
  ExprKind.Object => "struct{}{}"
  ExprKind.Block => ("func() any {\n" + emitGoBlockNoContext(expr.children, 0, true, "Dynamic", 1, "")) + "}()"
  _ => "nil"
}

emitGoExprExpected(
  expr: IRExpr,
  expected: String
) -> String => expr.kind {
  ExprKind.Call => emitGoCallExpected(expr, expected)
  ExprKind.Object => emitGoObjectExpected(expr, expected)
  ExprKind.Binary => emitGoBinaryExpected(expr, expected)
  _ => emitGoExpr(expr)
}

emitGoObjectExpected(
  expr: IRExpr,
  expected: String
) -> String => expected {
  "" => emitGoExpr(expr)
  "Dynamic" => emitGoExpr(expr)
  _ => ((goType(expected) + "{") + emitGoFields(expr.children, 0, "")) + "}"
}

emitGoCallExpected(
  expr: IRExpr,
  expected: String
) -> String => {
  args := genericInner(expected, "Result")
  (
    (args != "") && isResultConstructorCall(expr) ? ((emitGoExpr(expr.children[0]) + "[") + emitGoTypeArgs(args)) + "](" + emitGoExprListFrom(expr.children, 1, "") + ")"
      : emitGoCall(expr)
  )
}

isResultConstructorCall(
  expr: IRExpr
) -> Bool => (
  (expr.kind == ExprKind.Call) && (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Identifier) && ((expr.children[0].name == "Ok") || (expr.children[0].name == "Err"))
)

emitGoTypeArgs(
  args: String
) -> String => emitGoTypeArgList(args.split(","), 0, "")

emitGoTypeArgList(
  args: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= args.length() ? out
    : emitGoTypeArgList(args, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + goType(args[index].trim()))
)

emitGoBlockNoContext(
  statements: Array[IRExpr],
  index: Int,
  returns: Bool,
  returnType: String,
  level: Int,
  out: String
) -> String => (
  index >= statements.length() ? (
    returns && (statements.length() == 0) ? out + line(level, "return " + goZero(returnType))
      : out
  )
    : emitGoBlockNoContext(statements, index + 1, returns, returnType, level, out + emitGoStatementNoContext(statements[index], index == (statements.length() - 1), returns, level))
)

emitGoStatementNoContext(
  expr: IRExpr,
  last: Bool,
  returns: Bool,
  level: Int
) -> String => expr.kind {
  ExprKind.Let => line(level, (mangleIdent(expr.name) + " := ") + emitGoExpr(expr.children[0])) + line(level, "_ = " + mangleIdent(expr.name))
  ExprKind.ObjectDestructure => emitGoObjectDestructure(expr, level)
  _ => (
    last && returns ? line(level, "return " + emitGoExpr(expr))
      : line(level, emitGoExpr(expr))
  )
}

emitGoBinary(expr: IRExpr) -> String => (
  expr.op == "??" ? emitGoNullCoalesce(expr, expr.text)
    : (((emitGoExpr(expr.children[0]) + " ") + goBinaryOp(expr.op)) + " ") + emitGoExpr(expr.children[1])
)

emitGoBinaryExpected(
  expr: IRExpr,
  expected: String
) -> String => (
  expr.op == "??" ? emitGoNullCoalesce(expr, expected)
    : emitGoBinary(expr)
)

emitGoNullCoalesce(
  expr: IRExpr,
  expected: String
) -> String => {
  resultType := goCoalesceResultType(expr, expected)
  (
    (expr.children.length() < 2) || (expr.children[0].kind == ExprKind.Null) ? emitGoExpr(expr.children[1])
      : (
        resultType == "" ? (((("func() any { __coalesce := " + emitGoExpr(expr.children[0])) + "; if __coalesce != nil { return __coalesce }; return ") + emitGoExpr(expr.children[1])) + " }()")
          : ((((((("func() " + goType(resultType)) + " { __coalesce := ") + emitGoExpr(expr.children[0])) + "; if __coalesce != nil { return __coalesce.(") + goType(resultType)) + ") }; return ") + emitGoExprExpected(expr.children[1], resultType)) + " }()"
      )
  )
}

goCoalesceResultType(
  expr: IRExpr,
  expected: String
) -> String => {
  candidate := (
    (expected != "") && (expected != "Dynamic") ? expected
      : expr.text
  )
  (
    candidate.endsWith("?") ? candidate.slice(0, candidate.length() - 1)
      : (
        candidate == "Null" ? ""
          : candidate
      )
  )
}

emitGoTernary(expr: IRExpr) -> String => ((((("func() any { if " + emitGoExpr(expr.children[0])) + " { return ") + emitGoExpr(expr.children[1])) + " }; return ") + (
  expr.children.length() > 2 ? emitGoExpr(expr.children[2])
    : "nil"
)) + " }()"

emitGoAssign(expr: IRExpr) -> String => (
  expr.children.length() == 2 ? (emitGoExpr(expr.children[0]) + " = ") + emitGoExpr(expr.children[1])
    : (mangleIdent(expr.name) + " = ") + emitGoExpr(expr.children[0])
)

emitGoCall(expr: IRExpr) -> String => moduleCallKey(expr) {
  "io.println" => ("fmt.Println(" + emitGoExprListFrom(expr.children, 1, "")) + ")"
  "map.new" => "map[any]any{}"
  "set.new" => "map[any]struct{}{}"
  "path.isAbsolute" => "strings.HasPrefix(" + emitGoExpr(expr.children[1]) + ", \"/\")"
  "path.basename" => "__runePathBasename(" + emitGoExpr(expr.children[1]) + ")"
  "path.extname" => "__runePathExtname(" + emitGoExpr(expr.children[1]) + ")"
  "path.dirname" => "__runePathDirname(" + emitGoExpr(expr.children[1]) + ")"
  "path.join" => "__runePathJoin(" + emitGoExpr(expr.children[1]) + ")"
  "path.normalize" => "__runePathNormalize(" + emitGoExpr(expr.children[1]) + ")"
  "path.resolve" => "__runePathResolve(" + emitGoExpr(expr.children[1]) + ")"
  "path.relative" => ("__runePathRelative(" + emitGoExpr(expr.children[1]) + ", ") + emitGoExpr(expr.children[2]) + ")"
  "path.joinParts" => (((("__runePathJoinParts(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", ") + emitGoExpr(expr.children[3]) + ")"
  "path.appendPathPart" => ("__runePathAppendPart(" + emitGoExpr(expr.children[1]) + ", ") + emitGoExpr(expr.children[2]) + ")"
  "path.normalizeParts" => (((((("__runePathNormalizeParts(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", ") + emitGoExpr(expr.children[3])) + ", __runePathStringParts(") + emitGoExpr(expr.children[4]) + "))"
  "path.normalizePart" => (((((("__runePathNormalizeParts(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", ") + emitGoExpr(expr.children[3])) + ", __runePathStringParts(") + emitGoExpr(expr.children[4]) + "))"
  "path.normalizeParent" => (((((("__runePathNormalizeParent(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", ") + emitGoExpr(expr.children[3])) + ", __runePathStringParts(") + emitGoExpr(expr.children[4]) + "))"
  "path.normalizePop" => (((((("__runePathNormalizePop(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", ") + emitGoExpr(expr.children[3])) + ", __runePathStringParts(") + emitGoExpr(expr.children[4]) + "))"
  "path.normalizePush" => ((((((((("__runePathNormalizePush(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", ") + emitGoExpr(expr.children[3])) + ", __runePathStringParts(") + emitGoExpr(expr.children[4])) + "), ") + emitGoExpr(expr.children[5])) + ")"
  "path.pathParts" => "__runePathParts(" + emitGoExpr(expr.children[1]) + ")"
  "path.collectPathParts" => (((("__runePathCollectParts(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", __runePathStringParts(") + emitGoExpr(expr.children[3]) + "))"
  "path.collectPathPart" => (((("__runePathCollectPart(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), ") + emitGoExpr(expr.children[2])) + ", __runePathStringParts(") + emitGoExpr(expr.children[3]) + "))"
  "path.relativeFromParts" => (((("__runePathRelativeFromParts(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), __runePathStringParts(") + emitGoExpr(expr.children[2])) + "), ") + emitGoExpr(expr.children[3]) + ")"
  "path.relativeTail" => (((((("__runePathRelativeTail(__runePathStringParts(" + emitGoExpr(expr.children[1])) + "), __runePathStringParts(") + emitGoExpr(expr.children[2])) + "), ") + emitGoExpr(expr.children[3])) + ", ") + emitGoExpr(expr.children[4]) + ", " + emitGoExpr(expr.children[5]) + ")"
  "process.platform" => "runtime.GOOS"
  "process.cwd" => "\".\""
  "process.env" => "(*string)(nil)"
  "process.argv" => "append([]string(nil), os.Args...)"
  "process.exit" => ("func() struct{} { os.Exit(" + emitGoExpr(expr.children[1])) + "); return struct{}{} }()"
  "int.toString" => "strconv.Itoa(" + emitGoExpr(expr.children[1]) + ")"
  "int.toDouble" => "float64(" + emitGoExpr(expr.children[1]) + ")"
  "int.toBigInt" => "int64(" + emitGoExpr(expr.children[1]) + ")"
  "int4.fromInt" => "func() int8 { n := (" + emitGoExpr(expr.children[1]) + ") & 0xf; if n >= 8 { return int8(n - 16) }; return int8(n) }()"
  "int8.fromInt" => "func() int8 { n := int(" + emitGoExpr(expr.children[1]) + "); return int8(n) }()"
  "int16.fromInt" => "func() int16 { n := int(" + emitGoExpr(expr.children[1]) + "); return int16(n) }()"
  "int64.fromInt" => "int64(" + emitGoExpr(expr.children[1]) + ")"
  "uint.fromInt" => "uint(" + emitGoExpr(expr.children[1]) + ")"
  "uint8.fromInt" => "func() uint8 { n := int(" + emitGoExpr(expr.children[1]) + "); return uint8(n) }()"
  "uint16.fromInt" => "func() uint16 { n := int(" + emitGoExpr(expr.children[1]) + "); return uint16(n) }()"
  "uint64.fromInt" => "uint64(" + emitGoExpr(expr.children[1]) + ")"
  "float.fromDouble" => "float32(" + emitGoExpr(expr.children[1]) + ")"
  "int4.toInt" | "int8.toInt" | "int16.toInt" | "int64.toInt" | "uint.toInt" | "uint8.toInt" | "uint16.toInt" | "uint64.toInt" => "int(" + emitGoExpr(expr.children[1]) + ")"
  "float.toDouble" => "float64(" + emitGoExpr(expr.children[1]) + ")"
  "bigint.fromInt" => "int64(" + emitGoExpr(expr.children[1]) + ")"
  "bigint.toString" => "strconv.FormatInt(" + emitGoExpr(expr.children[1]) + ", 10)"
  "bigint.toDouble" => "float64(" + emitGoExpr(expr.children[1]) + ")"
  "double.trunc" => "int(math.Trunc(" + emitGoExpr(expr.children[1]) + "))"
  "double.floor" => "int(math.Floor(" + emitGoExpr(expr.children[1]) + "))"
  "double.ceil" => "int(math.Ceil(" + emitGoExpr(expr.children[1]) + "))"
  "double.round" => "int(math.Round(" + emitGoExpr(expr.children[1]) + "))"
  _ => emitGoMaybeCoreMethodCall(expr)
}

fileUsesDoubleMath(
  file: IRFile
) -> Bool => (
  fileUsesModuleCall(file, "double.trunc") || fileUsesModuleCall(file, "double.floor") || fileUsesModuleCall(file, "double.ceil") || fileUsesModuleCall(file, "double.round")
)

fileUsesGoStrings(
  file: IRFile
) -> Bool => fileUsesModuleCall(file, "path.isAbsolute") || fileUsesPathFamily(file)

emitGoMaybeCoreMethodCall(
  expr: IRExpr
) -> String => (
  (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Selector) ? emitGoCoreMethodCall(expr, expr.children[0])
    : emitGoDefaultCall(expr)
)

emitGoCoreMethodCall(
  expr: IRExpr,
  selector: IRExpr
) -> String => (
  (selector.children.length() > 0) && (selector.children[0].kind != ExprKind.At) ? selector.name {
    "length" | "byteLength" => emitGoCoreLength(selector.children[0])
    "isEmpty" => ("(" + emitGoCoreLength(selector.children[0])) + ") == 0"
    "at" => emitGoCoreAt(expr, selector.children[0])
    "slice" => emitGoCoreSlice(expr, selector.children[0])
    "push" => emitGoCorePush(expr, selector.children[0])
    "set" => emitGoCoreSet(expr, selector.children[0])
    "getOr" => emitGoCoreGetOr(expr, selector.children[0])
    _ => emitGoDefaultCall(expr)
  }
    : emitGoDefaultCall(expr)
)

emitGoCoreLength(
  receiver: IRExpr
) -> String => (
  receiver.text == "String" ? "len([]rune(" + emitGoExpr(receiver) + "))"
    : "len(" + emitGoExpr(receiver) + ")"
)

emitGoCoreAt(
  expr: IRExpr,
  receiver: IRExpr
) -> String => (
  receiver.text == "String" ? ("[]rune(" + emitGoExpr(receiver) + ")[") + emitGoExpr(expr.children[1]) + "]"
    : ((emitGoExpr(receiver) + "[") + emitGoExpr(expr.children[1])) + "]"
)

emitGoCoreSlice(
  expr: IRExpr,
  receiver: IRExpr
) -> String => (
  receiver.text == "String" ? ((((("func() string { runes := []rune(" + emitGoExpr(receiver)) + "); return string(runes[") + emitGoExpr(expr.children[1])) + ":") + emitGoExpr(expr.children[2])) + "]) }()"
    : (((emitGoExpr(receiver) + "[") + emitGoExpr(expr.children[1])) + ":") + emitGoExpr(expr.children[2]) + "]"
)

emitGoCorePush(
  expr: IRExpr,
  receiver: IRExpr
) -> String => (((("func() int { " + emitGoExpr(receiver)) + " = append(") + emitGoExpr(receiver)) + ", ") + emitGoExpr(expr.children[1]) + "); return len(" + emitGoExpr(receiver) + ") }()"

emitGoCoreSet(
  expr: IRExpr,
  receiver: IRExpr
) -> String => (((((("func() any { " + emitGoExpr(receiver)) + "[") + emitGoExpr(expr.children[1])) + "] = ") + emitGoExpr(expr.children[2])) + "; return ") + emitGoExpr(expr.children[2]) + " }()"

emitGoCoreGetOr(
  expr: IRExpr,
  receiver: IRExpr
) -> String => {
  resultType := goCoalesceResultType(expr, expr.text)
  (
    resultType == "" ? (((((("func() any { if __value, ok := " + emitGoExpr(receiver)) + "[") + emitGoExpr(expr.children[1])) + "]; ok { return __value }; return ") + emitGoExpr(expr.children[2])) + " }()")
      : (((((((("func() " + goType(resultType)) + " { if __value, ok := ") + emitGoExpr(receiver)) + "[") + emitGoExpr(expr.children[1])) + "]; ok { return __value.(") + goType(resultType)) + ") }; return ") + emitGoExprExpected(expr.children[2], resultType) + " }()"
  )
}

emitGoDefaultCall(
  expr: IRExpr
) -> String => ((emitGoExpr(expr.children[0]) + "(") + emitGoExprListFrom(expr.children, 1, "")) + ")"

emitGoLambda(expr: IRExpr) -> String => ((("func(" + emitGoParams(expr.params, 0, "")) + ") any { return ") + emitGoExpr(expr.children[0])) + " }"

emitGoSelector(expr: IRExpr) -> String => expr.children[0].kind {
  ExprKind.At => (expr.children[0].name + ".") + expr.name
  ExprKind.Identifier => (
    looksLikeTypeName(expr.children[0].name) ? mangleIdent((expr.children[0].name + "_") + expr.name)
      : (emitGoExpr(expr.children[0]) + ".") + mangleIdent(expr.name)
  )
  _ => (emitGoExpr(expr.children[0]) + ".") + mangleIdent(expr.name)
}

emitGoExprList(
  exprs: Array[IRExpr],
  index: Int,
  out: String
) -> String => emitGoExprListFrom(exprs, index, out)

emitGoExprListFrom(
  exprs: Array[IRExpr],
  index: Int,
  out: String
) -> String => (
  index >= exprs.length() ? out
    : emitGoExprListFrom(exprs, index + 1, (out + (
      out == "" ? ""
        : ", "
    )) + emitGoExpr(exprs[index]))
)

emitGoMapEntries(
  entries: Array[IRExpr],
  index: Int,
  out: String
) -> String => (
  index >= entries.length() ? out
    : emitGoMapEntries(entries, index + 1, (((out + (
      out == "" ? ""
        : ", "
    )) + emitGoExpr(entries[index].children[0])) + ": ") + emitGoExpr(entries[index].children[1]))
)

emitGoFields(
  fields: Array[IRExpr],
  index: Int,
  out: String
) -> String => (
  index >= fields.length() ? out
    : emitGoFields(fields, index + 1, (((out + (
      out == "" ? ""
        : ", "
    )) + mangleIdent(fields[index].name)) + ": ") + emitGoStructFieldValue(fields[index].children[0]))
)

emitGoStructFieldValue(
  expr: IRExpr
) -> String => (
  (expr.kind == ExprKind.Array) && (expr.children.length() == 0) ? "nil"
    : emitGoExpr(expr)
)

goBinaryOp(op: String) -> String => op

hasMain(file: IRFile) -> Bool => hasFunction(file.functions, "main", 0)

hasFunction(
  functions: Array[IRFunction],
  name: String,
  index: Int
) -> Bool => (
  index >= functions.length() ? false
    : (
      (functions[index].macro == false) && (functions[index].name == name) ? true
        : hasFunction(functions, name, index + 1)
    )
)

usesPrintFile(file: IRFile) -> Bool => functionsUsePrint(file.functions, 0) || structsUsePrint(file.structs, 0) || enumsUsePrint(file.enums, 0)

functionsUsePrint(
  functions: Array[IRFunction],
  index: Int
) -> Bool => (
  index >= functions.length() ? false
    : (
      functions[index].macro ? functionsUsePrint(functions, index + 1)
        : exprUsesPrint(functions[index].body) ? true
        : functionsUsePrint(functions, index + 1)
    )
)

structsUsePrint(
  structs: Array[IRStructType],
  index: Int
) -> Bool => (
  index >= structs.length() ? false
    : (
      functionsUsePrint(structs[index].methods, 0) ? true
        : structsUsePrint(structs, index + 1)
    )
)

enumsUsePrint(
  enums: Array[IREnumType],
  index: Int
) -> Bool => (
  index >= enums.length() ? false
    : (
      functionsUsePrint(enums[index].methods, 0) ? true
        : enumsUsePrint(enums, index + 1)
    )
)

exprUsesPrint(expr: IRExpr) -> Bool => moduleCallKey(expr) {
  "io.println" => true
  _ => exprChildrenUsePrint(expr.children, 0)
}

exprChildrenUsePrint(
  children: Array[IRExpr],
  index: Int
) -> Bool => (
  index >= children.length() ? false
    : (
      exprUsesPrint(children[index]) ? true
        : exprChildrenUsePrint(children, index + 1)
    )
)

goType(typeName: String) -> String => typeName {
  "" => "any"
  "Void" => "struct{}"
  "Int" => "int"
  "Int4" | "Int8" => "int8"
  "Int16" => "int16"
  "Int64" => "int64"
  "BigInt" => "int64"
  "UInt" => "uint"
  "UInt8" => "uint8"
  "UInt16" => "uint16"
  "UInt64" => "uint64"
  "Double" => "float64"
  "Float" => "float32"
  "String" => "string"
  "Char" => "rune"
  "Bool" => "bool"
  "Dynamic" => "any"
  "Data" | "@io.Data" => "[]byte"
  _ => goTypeFallback(typeName)
}

goTypeFallback(
  typeName: String
) -> String => (
  typeName.endsWith("?") ? "any"
    : (
      genericInner(typeName, "Array") != "" ? "[]" + goType(genericInner(typeName, "Array"))
        : (
          genericInner(typeName, "ReadonlyArray") != "" ? "[]" + goType(genericInner(typeName, "ReadonlyArray"))
            : (
              genericInner(typeName, "Map") != "" ? (("map[" + goType(typeArg(genericInner(typeName, "Map"), 0))) + "]") + goType(typeArg(genericInner(typeName, "Map"), 1))
                : (
                  genericInner(typeName, "Set") != "" ? ("map[" + goType(genericInner(typeName, "Set"))) + "]struct{}"
                    : goNamedType(typeName)
                )
            )
        )
    )
)

goNamedType(
  typeName: String
) -> String => {
  open := typeName.indexOf("[")
  (
    open < 0 ? mangleIdent(typeName)
      : (mangleIdent(typeName.slice(0, open)) + "[") + emitGoTypeArgs(typeName.slice(open + 1, typeName.length() - 1)) + "]"
  )
}

emitGoGenericsDecl(
  generics: Array[String]
) -> String => (
  generics.length() == 0 ? ""
    : "[" + emitGoGenericDeclItems(generics, 0, "") + "]"
)

emitGoGenericDeclItems(
  generics: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= generics.length() ? out
    : emitGoGenericDeclItems(generics, index + 1, (((out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(generics[index])) + " any"))
)

emitGoGenericsUse(
  generics: Array[String]
) -> String => (
  generics.length() == 0 ? ""
    : "[" + emitGoGenericUseItems(generics, 0, "") + "]"
)

emitGoGenericUseItems(
  generics: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= generics.length() ? out
    : emitGoGenericUseItems(generics, index + 1, (out + (
      index == 0 ? ""
        : ", "
    )) + mangleIdent(generics[index]))
)

unwrapPayloadType(
  file: IRFile,
  expr: IRExpr
) -> String => (
  expr.kind == ExprKind.Unwrap ? resultPayloadType(unwrapSourceType(file, expr.children[0]))
    : ""
)

unwrapSourceType(
  file: IRFile,
  expr: IRExpr
) -> String => expr.kind {
  ExprKind.Call => callReturnType(file, expr)
  _ => ""
}

callReturnType(
  file: IRFile,
  expr: IRExpr
) -> String => (
  (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Identifier) ? functionReturnType(file.functions, expr.children[0].name, 0)
    : ""
)

functionReturnType(
  functions: Array[IRFunction],
  name: String,
  index: Int
) -> String => (
  index >= functions.length() ? ""
    : (
      (functions[index].macro == false) && (functions[index].name == name) ? functions[index].returnType
        : functionReturnType(functions, name, index + 1)
    )
)

resultPayloadType(
  typeName: String
) -> String => {
  args := genericInner(typeName, "Result")
  (
    args == "" ? ""
      : typeArg(args, 0)
  )
}

goZero(typeName: String) -> String => typeName {
  "Int" | "Int4" | "Int8" | "Int16" | "Int64" | "UInt" | "UInt8" | "UInt16" | "UInt64" | "BigInt" => "0"
  "Double" | "Float" => "0.0"
  "String" => "\"\""
  "Char" => "'\\x00'"
  "Bool" => "false"
  _ => "nil"
}

looksLikeTypeName(name: String) -> Bool => (
  name.length() > 0 ? (name.at(0) >= 'A') && (name.at(0) <= 'Z')
    : false
)
