@"../ir/ir.rn"
@"./common.rn"
@"./go.rn"
@"./mbt.rn"
@"./ts.rn"

+ CompileResult: {
  ok: Bool
  output: String
  errors: Array[String]
}

+ SourceFile: {
  path: String
  source: String
}

CompilerCallable: {
  name: String
  arity: Int
}

+ compileTypeScript(
  source: String
) -> CompileResult => compile(source, "ts")

+ compileGo(
  source: String
) -> CompileResult => compile(source, "go")

+ compileMoonBit(
  source: String
) -> CompileResult => compile(source, "mbt")

+ compile(
  source: String,
  target: String
) -> CompileResult => {
  file := lower(source)
  compileFile(file, target)
}

+ compileTypeScriptFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "ts")

+ compileGoFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "go")

+ compileMoonBitFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "mbt")

+ compileFiles(
  files: Array[SourceFile],
  target: String
) -> CompileResult => {
  file := lowerFiles(files)
  compileFile(file, target)
}

compileFile(
  file: IRFile,
  target: String
) -> CompileResult => (
  (
    file.errors.length() > 0 ? compileResult(false, "", parseErrorMessages(file.errors))
      : compileCheckedFile(file, target)
  )
)

compileCheckedFile(
  file: IRFile,
  target: String
) -> CompileResult => {
  errors := checkFileErrors(file)
  (
    errors.length() > 0 ? compileResult(false, "", errors)
      : target {
        "ts" => compileResult(true, generateTypeScript(file), [])
        "go" => compileResult(true, generateGo(file), [])
        "mbt" => compileResult(true, generateMoonBit(file), [])
        _ => compileResult(false, "", unsupportedTargetErrors(target))
      }
  )
}

checkFileErrors(
  file: IRFile
) -> Array[String] => {
  callables := compilerCallables(file)
  errors := [""].slice(0, 0)
  file.functions.each((fn) => errors = (
    fn.macro ? errors
      : checkExpr(fn.body, callables, errors)
  ))
  file.structs.each((typeDecl) => typeDecl.methods.each((method) => errors = checkExpr(method.body, callables, errors)))
  file.enums.each((typeDecl) => typeDecl.methods.each((method) => errors = checkExpr(method.body, callables, errors)))
  file.tests.each((testDecl) => errors = checkExpr(testDecl.body, callables, errors))
  errors
}

compilerCallables(
  file: IRFile
) -> Array[CompilerCallable] => {
  callables := [emptyCompilerCallable()].slice(0, 0)
  file.functions.each((fn) => (
    fn.macro ? 0
      : callables.push(compilerCallable(fn.name, fn.params.length()))
  ))
  file.tsImports.each((importDecl) => importDecl.functions.each((fn) => callables.push(compilerCallable(fn.name, fn.params.length()))))
  file.enums.each((typeDecl) => typeDecl.members.each((member) => callables.push(compilerCallable(member.name, member.params.length()))))
  callables
}

checkExpr(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String]
) -> Array[String] => {
  next := checkExprCall(expr, callables, errors)
  expr.children.each((child) => next = checkExpr(child, callables, next))
  next
}

checkExprCall(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String]
) -> Array[String] => {
  identifierCall := ((expr.kind == ExprKind.Call) && (expr.children.length() > 0)) && (expr.children[0].kind == ExprKind.Identifier)
  identifierCall {
    true => checkIdentifierCall(expr.children[0].name, expr.children.length() - 1, callables, errors)
    _ => errors
  }
}

checkIdentifierCall(
  name: String,
  arity: Int,
  callables: Array[CompilerCallable],
  errors: Array[String]
) -> Array[String] => {
  callable := findCompilerCallable(callables, name, 0)
  found := callable.name != ""
  found {
    true => checkCallableArity(callable, arity, errors)
    _ => [..errors, "undefined function " + name]
  }
}

checkCallableArity(
  callable: CompilerCallable,
  arity: Int,
  errors: Array[String]
) -> Array[String] => {
  ok := callable.arity == arity
  ok {
    true => errors
    _ => [..errors, (((("function \"" + callable.name) + "\" expects ") + compilerIntToString(callable.arity)) + " args, got ") + compilerIntToString(arity)]
  }
}

findCompilerCallable(
  callables: Array[CompilerCallable],
  name: String,
  index: Int
) -> CompilerCallable => {
  done := index >= callables.length()
  done {
    true => emptyCompilerCallable()
    _ => findCompilerCallableAt(callables, name, index)
  }
}

findCompilerCallableAt(
  callables: Array[CompilerCallable],
  name: String,
  index: Int
) -> CompilerCallable => {
  matched := callables[index].name == name
  matched {
    true => callables[index]
    _ => findCompilerCallable(callables, name, index + 1)
  }
}

compilerCallable(
  name: String,
  arity: Int
) -> CompilerCallable => {
  name: name,
  arity: arity
}

emptyCompilerCallable() -> CompilerCallable => compilerCallable("", 0)

compilerContains(
  values: Array[String],
  value: String
) -> Bool => compilerContainsAt(values, value, 0)

compilerContainsAt(
  values: Array[String],
  value: String,
  index: Int
) -> Bool => (
  index >= values.length() ? false
    : (
      values[index] == value ? true
        : compilerContainsAt(values, value, index + 1)
    )
)

lowerFiles(
  files: Array[SourceFile]
) -> IRFile => (
  files.length() == 0 ? emptyCompilerIRFile()
    : lowerReachableTypeScriptFiles(files, lowerReachableRuneFiles(files, [files[0].path], [], emptyCompilerIRFile()))
)

lowerReachableRuneFiles(
  files: Array[SourceFile],
  pending: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  empty := pending.length() == 0
  empty {
    true => out
    _ => lowerReachableRuneFile(files, pending[0], pending.slice(1, pending.length()), seen, out)
  }
}

lowerReachableRuneFile(
  files: Array[SourceFile],
  path: String,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  alreadySeen := compilerContains(seen, path)
  alreadySeen {
    true => lowerReachableRuneFiles(files, rest, seen, out)
    _ => lowerUnseenRuneFile(files, path, rest, [..seen, path], out)
  }
}

lowerUnseenRuneFile(
  files: Array[SourceFile],
  path: String,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  file := findSourceFile(files, path, 0)
  missing := file.path.isEmpty()
  missing {
    true => lowerReachableRuneFiles(files, rest, seen, mergeCompilerIRFile(out, missingImportFile(path)))
    _ => lowerFoundSourceFile(files, file, rest, seen, out)
  }
}

lowerFoundSourceFile(
  files: Array[SourceFile],
  file: SourceFile,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  typeScript := sourceFileIsTypeScript(file)
  typeScript {
    true => lowerReachableRuneFiles(files, rest, seen, out)
    _ => lowerFoundRuneSourceFile(files, file, rest, seen, out)
  }
}

lowerFoundRuneSourceFile(
  files: Array[SourceFile],
  file: SourceFile,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  lowered := lower(file.source)
  lowerReachableRuneFiles(files, appendImportPaths(rest, lowered.imports, 0), seen, mergeCompilerIRFile(out, lowered))
}

lowerReachableTypeScriptFiles(
  files: Array[SourceFile],
  out: IRFile
) -> IRFile => {
  files.each((file) => out = (
    sourceFileIsTypeScript(file) ? mergeCompilerIRFile(out, lowerTypeScriptSourceFile(file, out.imports))
      : out
  ))
  out
}

appendImportPaths(
  pending: Array[String],
  imports: Array[IRImport],
  index: Int
) -> Array[String] => {
  done := index >= imports.length()
  done {
    true => pending
    _ => appendImportPath(pending, imports, index)
  }
}

appendImportPath(
  pending: Array[String],
  imports: Array[IRImport],
  index: Int
) -> Array[String] => {
  goImport := imports[index].go
  goImport {
    true => appendImportPaths(pending, imports, index + 1)
    _ => appendImportPaths([..pending, imports[index].path], imports, index + 1)
  }
}

findSourceFile(
  files: Array[SourceFile],
  path: String,
  index: Int
) -> SourceFile => {
  done := index >= files.length()
  done {
    true => emptySourceFile()
    _ => findSourceFileAt(files, path, index)
  }
}

findSourceFileAt(
  files: Array[SourceFile],
  path: String,
  index: Int
) -> SourceFile => {
  matched := sourceFileMatches(files[index], path)
  matched {
    true => files[index]
    _ => findSourceFile(files, path, index + 1)
  }
}

sourceFileMatches(
  file: SourceFile,
  path: String
) -> Bool => (file.path == path) || (compilerPathBasename(file.path) == compilerPathBasename(path))

emptySourceFile() -> SourceFile => SourceFile {
  path: "",
  source: ""
}

missingImportFile(
  path: String
) -> IRFile => {
  out := emptyCompilerIRFile()
  out.errors.push(ParseError {
    message: "missing import " + path,
    line: 0,
    column: 0
  })
  out
}

sourceFileIsTypeScript(
  file: SourceFile
) -> Bool => file.path.endsWith(".ts")

lowerTypeScriptSourceFile(
  file: SourceFile,
  imports: Array[IRImport]
) -> IRFile => {
  out := emptyCompilerIRFile()
  specifier := typeScriptImportSpecifier(file.path, imports, 0)
  (
    specifier != "" ? out.tsImports.push(parseTypeScriptImport(file.path, specifier, file.source))
  )
  out
}

typeScriptImportSpecifier(
  path: String,
  imports: Array[IRImport],
  index: Int
) -> String => (
  index >= imports.length() ? ""
    : (
      (imports[index].path.endsWith(".ts") && compilerPathBasename(path) == compilerPathBasename(imports[index].path)) ? imports[index].path
        : typeScriptImportSpecifier(path, imports, index + 1)
    )
)

compilerPathBasename(
  path: String
) -> String => {
  slash := path.lastIndexOf("/")
  (
    slash < 0 ? path
      : path.slice(slash + 1, path.length())
  )
}

parseTypeScriptImport(
  path: String,
  specifier: String,
  source: String
) -> IRTSImport => {
  imports := IRTSImport {
    path: path,
    specifier: specifier,
    functions: [emptyIRFunction()].slice(0, 0),
    values: [emptyIRConst()].slice(0, 0),
    line: 0,
    column: 0
  }
  source.split("\n").each((line) => imports = parseTypeScriptExportLine(imports, line.trim()))
  imports
}

parseTypeScriptExportLine(
  imports: IRTSImport,
  line: String
) -> IRTSImport => (
  line.startsWith("export async function ") ? pushTypeScriptFunction(imports, line.slice("export async function ".length(), line.length()), true)
    : (
      line.startsWith("export function ") ? pushTypeScriptFunction(imports, line.slice("export function ".length(), line.length()), false)
        : (
          line.startsWith("export const ") ? pushTypeScriptValue(imports, line.slice("export const ".length(), line.length()))
            : (
              line.startsWith("export let ") ? pushTypeScriptValue(imports, line.slice("export let ".length(), line.length()))
                : (
                  line.startsWith("export var ") ? pushTypeScriptValue(imports, line.slice("export var ".length(), line.length()))
                    : imports
                )
            )
        )
    )
)

pushTypeScriptFunction(
  imports: IRTSImport,
  text: String,
  routine: Bool
) -> IRTSImport => {
  open := text.indexOf("(")
  close := text.indexOf(")")
  name := (
    open < 0 ? ""
      : text.slice(0, open).trim()
  )
  returnType := typeScriptReturnTypeName(text)
  (
    name != "" ? imports.functions.push(IRFunction {
        name: name,
        private: false,
        routine: routine,
        macro: false,
        receiverType: "",
        generics: [],
        params: (
          (open >= 0) && (close > open) ? parseTypeScriptParams(text.slice(open + 1, close))
            : [emptyIRParam()].slice(0, 0)
        ),
        returnType: returnType,
        body: emptyIRExpr(),
        line: 0,
        column: 0
      })
  )
  imports
}

pushTypeScriptValue(
  imports: IRTSImport,
  text: String
) -> IRTSImport => {
  end := typeScriptNameEnd(text)
  name := text.slice(0, end).trim()
  typeName := typeScriptValueTypeName(text)
  (
    name != "" ? imports.values.push(IRConst {
        name: name,
        private: false,
        typeName: typeName,
        value: emptyIRExpr(),
        line: 0,
        column: 0
      })
  )
  imports
}

typeScriptNameEnd(
  text: String
) -> Int => {
  colon := text.indexOf(":")
  equal := text.indexOf("=")
  (
    (colon >= 0) && ((equal < 0) || (colon < equal)) ? colon
      : (
        equal >= 0 ? equal
          : text.length()
      )
  )
}

typeScriptReturnTypeName(
  text: String
) -> String => {
  close := text.indexOf(")")
  colon := (
    close >= 0 ? text.slice(close + 1, text.length()).indexOf(":")
      : -1
  )
  (
    (close >= 0) && (colon >= 0) ? typeScriptTextType(text.slice(close + 1 + colon + 1, typeScriptReturnTypeEnd(text)).trim())
      : "Dynamic"
  )
}

typeScriptReturnTypeEnd(
  text: String
) -> Int => {
  brace := text.indexOf("{")
  semi := text.indexOf(";")
  (
    (brace >= 0) && ((semi < 0) || (brace < semi)) ? brace
      : (
        semi >= 0 ? semi
          : text.length()
      )
  )
}

typeScriptValueTypeName(
  text: String
) -> String => {
  colon := text.indexOf(":")
  (
    colon < 0 ? "Dynamic"
      : typeScriptTextType(text.slice(colon + 1, typeScriptNameEnd(text.slice(colon + 1, text.length())) + colon + 1).trim())
  )
}

parseTypeScriptParams(
  text: String
) -> Array[IRParam] => {
  params := [emptyIRParam()].slice(0, 0)
  text.split(",").each((param) => (
    param.trim() != "" ? params.push(parseTypeScriptParam(param.trim()))
  ))
  params
}

emptyIRParam() -> IRParam => {
  name: "",
  typeName: "Dynamic",
  line: 0,
  column: 0
}

emptyIRConst() -> IRConst => {
  name: "",
  private: false,
  typeName: "Dynamic",
  value: emptyIRExpr(),
  line: 0,
  column: 0
}

parseTypeScriptParam(
  text: String
) -> IRParam => {
  colon := text.indexOf(":")
  rawName := (
    colon < 0 ? text
      : text.slice(0, colon)
  )
  name := rawName.replaceAll("...", "").replaceAll("?", "").trim()
  IRParam {
    name: name,
    typeName: (
      colon < 0 ? "Dynamic"
        : typeScriptTextType(text.slice(colon + 1, text.length()).trim())
    ),
    line: 0,
    column: 0
  }
}

typeScriptTextType(
  text: String
) -> String => text {
  "string" => "String"
  "boolean" => "Bool"
  "bigint" => "BigInt"
  "number" => "Double"
  "void" | "undefined" => "Void"
  _ => "Dynamic"
}

emptyCompilerIRFile() -> IRFile => {
  imports: [],
  tsImports: [],
  structs: [],
  enums: [],
  constants: [],
  functions: [],
  tests: [],
  errors: []
}

mergeCompilerIRFile(
  out: IRFile,
  file: IRFile
) -> IRFile => {
  file.imports.each((importDecl) => out.imports.push(importDecl))
  file.tsImports.each((importDecl) => out.tsImports.push(importDecl))
  file.structs.each((typeDecl) => out.structs.push(typeDecl))
  file.enums.each((typeDecl) => out.enums.push(typeDecl))
  file.constants.each((constant) => out.constants.push(constant))
  file.functions.each((fn) => out.functions.push(fn))
  file.tests.each((testDecl) => out.tests.push(testDecl))
  file.errors.each((error) => out.errors.push(error))
  out
}

compileResult(
  ok: Bool,
  output: String,
  errors: Array[String]
) -> CompileResult => {
  ok: ok,
  output: output,
  errors: errors
}

unsupportedTargetErrors(
  target: String
) -> Array[String] => {
  errors := []
  errors.push("unsupported target " + target)
  errors
}

parseErrorMessages(
  errors: Array[ParseError]
) -> Array[String] => {
  out := []
  errors.each((error) => out.push((((("line " + compilerIntToString(error.line)) + ":") + compilerIntToString(error.column)) + ": ") + error.message))
  out
}
