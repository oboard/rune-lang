@"../ir/ir.rn"
@"./common.rn"
@"./go.rn"
@"./mbt.rn"
@"./ts.rn"

+ CompileResult: {
  ok: Bool
  output: String
  errors: Array[String]
}

+ SourceFile: {
  path: String
  source: String
}

+ compileTypeScript(
  source: String
) -> CompileResult => compile(source, "ts")

+ compileGo(
  source: String
) -> CompileResult => compile(source, "go")

+ compileMoonBit(
  source: String
) -> CompileResult => compile(source, "mbt")

+ compile(
  source: String,
  target: String
) -> CompileResult => {
  file := lower(source)
  compileFile(file, target)
}

+ compileTypeScriptFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "ts")

+ compileGoFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "go")

+ compileMoonBitFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "mbt")

+ compileFiles(
  files: Array[SourceFile],
  target: String
) -> CompileResult => {
  file := lowerFiles(files)
  compileFile(file, target)
}

compileFile(
  file: IRFile,
  target: String
) -> CompileResult => (
  (
    file.errors.length() > 0 ? compileResult(false, "", parseErrorMessages(file.errors))
      : target {
        "ts" => compileResult(true, generateTypeScript(file), [])
        "go" => compileResult(true, generateGo(file), [])
        "mbt" => compileResult(true, generateMoonBit(file), [])
        _ => compileResult(false, "", unsupportedTargetErrors(target))
      }
  )
)

lowerFiles(
  files: Array[SourceFile]
) -> IRFile => {
  out := emptyCompilerIRFile()
  files.each((file) => out = mergeCompilerIRFile(out, lower(file.source)))
  out
}

emptyCompilerIRFile() -> IRFile => {
  imports: [],
  structs: [],
  enums: [],
  constants: [],
  functions: [],
  tests: [],
  errors: []
}

mergeCompilerIRFile(
  out: IRFile,
  file: IRFile
) -> IRFile => {
  file.imports.each((importDecl) => out.imports.push(importDecl))
  file.structs.each((typeDecl) => out.structs.push(typeDecl))
  file.enums.each((typeDecl) => out.enums.push(typeDecl))
  file.constants.each((constant) => out.constants.push(constant))
  file.functions.each((fn) => out.functions.push(fn))
  file.tests.each((testDecl) => out.tests.push(testDecl))
  file.errors.each((error) => out.errors.push(error))
  out
}

compileResult(
  ok: Bool,
  output: String,
  errors: Array[String]
) -> CompileResult => {
  ok: ok,
  output: output,
  errors: errors
}

unsupportedTargetErrors(
  target: String
) -> Array[String] => {
  errors := []
  errors.push("unsupported target " + target)
  errors
}

parseErrorMessages(
  errors: Array[ParseError]
) -> Array[String] => {
  out := []
  errors.each((error) => out.push((((("line " + compilerIntToString(error.line)) + ":") + compilerIntToString(error.column)) + ": ") + error.message))
  out
}
