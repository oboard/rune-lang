@"../ir/ir.rn"
@"./common.rn"
@"./go.rn"
@"./mbt.rn"
@"./ts.rn"

+ CompileResult: {
  ok: Bool
  output: String
  errors: Array[String]
}

+ SourceFile: {
  path: String
  source: String
}

CompilerCallable: {
  name: String
  arity: Int
  returnType: String
  paramTypes: Array[String]
}

CompilerMacroBinding: {
  name: String
  macro: Bool
  paramTypes: Array[String]
}

CompilerTypeBinding: {
  name: String
  typeName: String
}

CompilerNamespaceAlias: {
  name: String
  module: String
}

+ compileTypeScript(
  source: String
) -> CompileResult => compile(source, "ts")

+ compileGo(
  source: String
) -> CompileResult => compile(source, "go")

+ compileMoonBit(
  source: String
) -> CompileResult => compile(source, "mbt")

+ compile(
  source: String,
  target: String
) -> CompileResult => {
  file := lowerCompilerSource(source)
  compileFile(file, target)
}

+ compileTypeScriptFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "ts")

+ compileGoFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "go")

+ compileMoonBitFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "mbt")

+ compileFiles(
  files: Array[SourceFile],
  target: String
) -> CompileResult => {
  file := lowerFiles(files)
  compileFile(file, target)
}

compileFile(
  file: IRFile,
  target: String
) -> CompileResult => (
  file.errors.length() > 0 ? compileResult(false, "", parseErrorMessages(file.errors))
    : compileCheckedFile(file, target)
)

compileCheckedFile(
  file: IRFile,
  target: String
) -> CompileResult => {
  errors := checkFileErrors(file)
  targetErrors := checkTargetFileErrors(file, target)
  allErrors := [..errors, ..targetErrors]
  (
    allErrors.length() > 0 ? compileResult(false, "", allErrors)
      : target {
        "ts" => compileResult(true, generateTypeScript(file), [])
        "go" => compileResult(true, generateGo(file), [])
        "mbt" => compileResult(true, generateMoonBit(file), [])
        _ => compileResult(false, "", unsupportedTargetErrors(target))
      }
  )
}

checkTargetFileErrors(
  file: IRFile,
  target: String
) -> Array[String] => target {
  "ts" => checkTypeScriptTargetFileErrors(file)
  "go" => checkGoTargetFileErrors(file)
  "mbt" => checkMoonBitTargetFileErrors(file)
  _ => []
}

checkTypeScriptTargetFileErrors(
  file: IRFile
) -> Array[String] => {
  hasGoImports := fileHasGoImports(file)
  hasGoImports {
    true => ["TypeScript backend does not support @go.import"]
    _ => []
  }
}

checkGoTargetFileErrors(
  file: IRFile
) -> Array[String] => {
  hasTypeScriptImports := file.tsImports.length() > 0
  hasTypeScriptImports {
    true => ["Go backend does not support TypeScript imports"]
    _ => []
  }
}

checkMoonBitTargetFileErrors(
  file: IRFile
) -> Array[String] => {
  errors :=: [""].slice(0, 0)
  hasTypeScriptImports := file.tsImports.length() > 0
  errors = compilerAppendErrorIf(errors, hasTypeScriptImports, "MoonBit backend does not support TypeScript imports")
  hasGoImports := fileHasGoImports(file)
  errors = compilerAppendErrorIf(errors, hasGoImports, "MoonBit backend does not support @go.import")
  errors
}

compilerAppendErrorIf(
  errors: Array[String],
  condition: Bool,
  message: String
) -> Array[String] => condition {
  true => [..errors, message]
  _ => errors
}

fileHasGoImports(file: IRFile) -> Bool => fileHasGoImportsAt(file.imports, 0)

fileHasGoImportsAt(
  imports: Array[IRImport],
  index: Int
) -> Bool => {
  done := index >= imports.length()
  done {
    true => false
    _ => fileHasGoImportAt(imports, index)
  }
}

fileHasGoImportAt(
  imports: Array[IRImport],
  index: Int
) -> Bool => imports[index].go {
  true => true
  _ => fileHasGoImportsAt(imports, index + 1)
}

checkFileErrors(
  file: IRFile
) -> Array[String] => {
  callables := compilerCallables(file)
  bindings := compilerInitialBindings(file)
  knownTypes := compilerKnownTypes(file)
  errors := checkDuplicateDeclarations(file, [""].slice(0, 0))
  errors = checkDeclarationTypes(file, knownTypes, errors)
  file.functions.each((fn) => errors = (
    fn.macro ? errors
      : checkFunctionErrors(fn, file.structs, callables, errors, bindings)
  ))
  file.structs.each((typeDecl) => typeDecl.methods.each((method) => errors = checkFunctionErrors(method, file.structs, callables, errors, bindings)))
  file.enums.each((typeDecl) => typeDecl.methods.each((method) => errors = checkFunctionErrors(method, file.structs, callables, errors, bindings)))
  file.tests.each((testDecl) => errors = checkExpr(testDecl.body, file.structs, callables, errors, bindings))
  errors
}

compilerKnownTypes(
  file: IRFile
) -> Array[String] => {
  names := compilerBuiltinTypes()
  file.structs.each((typeDecl) => names.push(typeDecl.name))
  file.enums.each((typeDecl) => names.push(typeDecl.name))
  names
}

compilerBuiltinTypes() -> Array[String] => ["Int", "Int4", "Int8", "Int16", "Int64", "UInt", "UInt8", "UInt16", "UInt64", "Double", "Float", "Bool", "String", "Char", "BigInt", "Byte", "Bytes", "Object", "Dynamic", "Void", "Null", "Error", "Regex", "Symbol", "MacroContext", "Array", "ReadonlyArray", "Map", "Set", "Result"]

checkDuplicateDeclarations(
  file: IRFile,
  errors: Array[String]
) -> Array[String] => {
  next := checkDuplicateStructTypeNames(file.structs, 0, errors)
  next = checkDuplicateEnumTypeNames(file.enums, file.structs, 0, next)
  next = checkDuplicateFunctionNames(file.functions, 0, next)
  file.structs.each((typeDecl) => next = checkDuplicateStructMembers(typeDecl, next))
  file.enums.each((typeDecl) => next = checkDuplicateEnumMembers(typeDecl, next))
  next
}

checkDuplicateStructTypeNames(
  structs: Array[IRStructType],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= structs.length()
  done {
    true => errors
    _ => checkDuplicateStructTypeName(structs, index, errors)
  }
}

checkDuplicateStructTypeName(
  structs: Array[IRStructType],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerStructNameAppearsAfter(structs, structs[index].name, index + 1)
  next := duplicate {
    true => [..errors, ("duplicate type \"" + structs[index].name) + "\""]
    _ => errors
  }
  checkDuplicateStructTypeNames(structs, index + 1, next)
}

checkDuplicateEnumTypeNames(
  enums: Array[IREnumType],
  structs: Array[IRStructType],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= enums.length()
  done {
    true => errors
    _ => checkDuplicateEnumTypeName(enums, structs, index, errors)
  }
}

checkDuplicateEnumTypeName(
  enums: Array[IREnumType],
  structs: Array[IRStructType],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerEnumNameAppearsAfter(enums, enums[index].name, index + 1) || compilerStructNameAppearsAfter(structs, enums[index].name, 0)
  next := duplicate {
    true => [..errors, ("duplicate type \"" + enums[index].name) + "\""]
    _ => errors
  }
  checkDuplicateEnumTypeNames(enums, structs, index + 1, next)
}

checkDuplicateFunctionNames(
  functions: Array[IRFunction],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= functions.length()
  done {
    true => errors
    _ => checkDuplicateFunctionName(functions, index, errors)
  }
}

checkDuplicateFunctionName(
  functions: Array[IRFunction],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerFunctionNameAppearsBefore(functions, functions[index].name, functions[index].macro, index - 1)
  next := duplicate {
    true => [..errors, ("duplicate function \"" + functions[index].name) + "\""]
    _ => errors
  }
  checkDuplicateFunctionNames(functions, index + 1, next)
}

checkDuplicateStructMembers(
  typeDecl: IRStructType,
  errors: Array[String]
) -> Array[String] => {
  next := checkDuplicateStructFields(typeDecl.fields, 0, errors)
  checkDuplicateStructMethods(typeDecl.name, typeDecl.methods, 0, next)
}

checkDuplicateStructFields(
  fields: Array[IRField],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= fields.length()
  done {
    true => errors
    _ => checkDuplicateStructField(fields, index, errors)
  }
}

checkDuplicateStructField(
  fields: Array[IRField],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerFieldNameAppearsBefore(fields, fields[index].name, index - 1)
  next := duplicate {
    true => [..errors, ("duplicate field \"" + fields[index].name) + "\""]
    _ => errors
  }
  checkDuplicateStructFields(fields, index + 1, next)
}

checkDuplicateStructMethods(
  typeName: String,
  methods: Array[IRFunction],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= methods.length()
  done {
    true => errors
    _ => checkDuplicateStructMethod(typeName, methods, index, errors)
  }
}

checkDuplicateStructMethod(
  typeName: String,
  methods: Array[IRFunction],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerMethodNameAppearsBefore(methods, methods[index].name, index - 1)
  next := duplicate {
    true => [..errors, (("duplicate method " + typeName) + ".") + methods[index].name]
    _ => errors
  }
  checkDuplicateStructMethods(typeName, methods, index + 1, next)
}

checkDuplicateEnumMembers(
  typeDecl: IREnumType,
  errors: Array[String]
) -> Array[String] => {
  next := checkDuplicateEnumConstructors(typeDecl.name, typeDecl.members, 0, errors)
  checkDuplicateEnumMethods(typeDecl.name, typeDecl.methods, 0, next)
}

checkDuplicateEnumConstructors(
  enumName: String,
  members: Array[IREnumMember],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= members.length()
  done {
    true => errors
    _ => checkDuplicateEnumConstructor(enumName, members, index, errors)
  }
}

checkDuplicateEnumConstructor(
  enumName: String,
  members: Array[IREnumMember],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerEnumMemberNameAppearsBefore(members, members[index].name, index - 1)
  next := duplicate {
    true => [..errors, (("duplicate enum member " + enumName) + ".") + members[index].name]
    _ => errors
  }
  checkDuplicateEnumConstructors(enumName, members, index + 1, next)
}

checkDuplicateEnumMethods(
  enumName: String,
  methods: Array[IRFunction],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= methods.length()
  done {
    true => errors
    _ => checkDuplicateEnumMethod(enumName, methods, index, errors)
  }
}

checkDuplicateEnumMethod(
  enumName: String,
  methods: Array[IRFunction],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerMethodNameAppearsBefore(methods, methods[index].name, index - 1)
  next := duplicate {
    true => [..errors, (("duplicate method " + enumName) + ".") + methods[index].name]
    _ => errors
  }
  checkDuplicateEnumMethods(enumName, methods, index + 1, next)
}

checkDeclarationTypes(
  file: IRFile,
  knownTypes: Array[String],
  errors: Array[String]
) -> Array[String] => {
  next := errors
  file.structs.each((typeDecl) => next = checkStructDeclarationTypes(typeDecl, knownTypes, next))
  file.enums.each((typeDecl) => next = checkEnumDeclarationTypes(typeDecl, knownTypes, next))
  file.functions.each((fn) => next = checkFunctionDeclarationTypes(fn, knownTypes, next))
  next
}

checkStructDeclarationTypes(
  typeDecl: IRStructType,
  knownTypes: Array[String],
  errors: Array[String]
) -> Array[String] => {
  next := errors
  typeDecl.fields.each((field) => next = checkCompilerTypeName(field.typeName, knownTypes, typeDecl.generics, next))
  typeDecl.methods.each((method) => next = checkFunctionDeclarationTypesWithGenerics(method, knownTypes, typeDecl.generics, next))
  next
}

checkEnumDeclarationTypes(
  typeDecl: IREnumType,
  knownTypes: Array[String],
  errors: Array[String]
) -> Array[String] => {
  next := errors
  typeDecl.members.each((member) => member.params.each((param) => next = checkCompilerTypeName(param.typeName, knownTypes, typeDecl.generics, next)))
  typeDecl.methods.each((method) => next = checkFunctionDeclarationTypesWithGenerics(method, knownTypes, typeDecl.generics, next))
  next
}

checkFunctionDeclarationTypes(
  fn: IRFunction,
  knownTypes: Array[String],
  errors: Array[String]
) -> Array[String] => checkFunctionDeclarationTypesWithGenerics(fn, knownTypes, [], errors)

checkFunctionDeclarationTypesWithGenerics(
  fn: IRFunction,
  knownTypes: Array[String],
  parentGenerics: Array[String],
  errors: Array[String]
) -> Array[String] => {
  generics := compilerMergeGenerics(parentGenerics, fn.generics)
  next := checkDuplicateParams(fn.params, 0, errors)
  next = checkCompilerTypeName(fn.returnType, knownTypes, generics, next)
  fn.params.each((param) => next = checkCompilerTypeName(param.typeName, knownTypes, generics, next))
  next
}

checkDuplicateParams(
  params: Array[IRParam],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= params.length()
  done {
    true => errors
    _ => checkDuplicateParam(params, index, errors)
  }
}

checkDuplicateParam(
  params: Array[IRParam],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  duplicate := compilerParamNameAppearsBefore(params, params[index].name, index - 1)
  next := duplicate {
    true => [..errors, ("duplicate parameter \"" + params[index].name) + "\""]
    _ => errors
  }
  checkDuplicateParams(params, index + 1, next)
}

compilerMergeGenerics(
  parentGenerics: Array[String],
  functionGenerics: Array[String]
) -> Array[String] => {
  out := parentGenerics.slice(0, parentGenerics.length())
  functionGenerics.each((name) => out.push(name))
  out
}

checkCompilerTypeName(
  typeName: String,
  knownTypes: Array[String],
  generics: Array[String],
  errors: Array[String]
) -> Array[String] => {
  normalized := compilerNormalizeTypeName(typeName)
  shouldSkip := compilerShouldSkipTypeName(normalized)
  shouldSkip {
    true => errors
    _ => checkCompilerNamedType(normalized, knownTypes, generics, errors)
  }
}

compilerNormalizeTypeName(
  typeName: String
) -> String => {
  nullable := typeName.endsWith("?")
  nullable {
    true => compilerNormalizeTypeName(typeName.slice(0, typeName.length() - 1))
    _ => typeName
  }
}

compilerShouldSkipTypeName(
  typeName: String
) -> Bool => (typeName == "") || ((typeName.startsWith("@") || typeName.startsWith("(")) || typeName.startsWith("Syntax"))

checkCompilerNamedType(
  typeName: String,
  knownTypes: Array[String],
  generics: Array[String],
  errors: Array[String]
) -> Array[String] => {
  base := compilerTypeBase(typeName)
  known := compilerContains(knownTypes, base) || compilerContains(generics, base)
  known {
    true => checkCompilerTypeArgs(typeName, knownTypes, generics, errors)
    _ => [..errors, ("unknown type \"" + base) + "\""]
  }
}

checkCompilerTypeArgs(
  typeName: String,
  knownTypes: Array[String],
  generics: Array[String],
  errors: Array[String]
) -> Array[String] => {
  inner := compilerGenericInner(typeName)
  empty := inner == ""
  empty {
    true => errors
    _ => checkCompilerTypeArgList(inner.split(","), knownTypes, generics, errors, 0)
  }
}

checkCompilerTypeArgList(
  args: Array[String],
  knownTypes: Array[String],
  generics: Array[String],
  errors: Array[String],
  index: Int
) -> Array[String] => {
  done := index >= args.length()
  done {
    true => errors
    _ => checkCompilerTypeArgList(args, knownTypes, generics, checkCompilerTypeName(args[index].trim(), knownTypes, generics, errors), index + 1)
  }
}

compilerGenericInner(
  typeName: String
) -> String => {
  open := typeName.indexOf("[")
  complete := (open >= 0) && typeName.endsWith("]")
  complete {
    true => typeName.slice(open + 1, typeName.length() - 1)
    _ => ""
  }
}

compilerCallables(
  file: IRFile
) -> Array[CompilerCallable] => {
  callables := [emptyCompilerCallable()].slice(0, 0)
  file.functions.each((fn) => (
    fn.macro ? 0
      : callables.push(compilerCallable(fn.name, fn.params.length(), fn.returnType, compilerParamTypeNames(fn.params)))
  ))
  file.tsImports.each((importDecl) => importDecl.functions.each((fn) => callables.push(compilerCallable(fn.name, fn.params.length(), fn.returnType, compilerParamTypeNames(fn.params)))))
  file.structs.each((typeDecl) => typeDecl.methods.each((method) => callables.push(compilerMethodCallable(typeDecl.name, method))))
  file.enums.each((typeDecl) => typeDecl.methods.each((method) => callables.push(compilerMethodCallable(typeDecl.name, method))))
  file.enums.each((typeDecl) => typeDecl.members.each((member) => callables.push(compilerCallable(member.name, member.params.length(), typeDecl.name, compilerParamTypeNames(member.params)))))
  callables
}

compilerMethodCallable(
  typeName: String,
  method: IRFunction
) -> CompilerCallable => compilerCallable(compilerMethodCallableName(typeName, method), method.params.length(), method.returnType, compilerParamTypeNames(method.params))

compilerMethodCallableName(
  typeName: String,
  method: IRFunction
) -> String => method.static {
  true => compilerStaticMethodName(typeName, method.name)
  _ => compilerInstanceMethodName(typeName, method.name)
}

compilerStaticMethodName(
  typeName: String,
  methodName: String
) -> String => (typeName + "::") + methodName

compilerInstanceMethodName(
  typeName: String,
  methodName: String
) -> String => (typeName + ".") + methodName

checkFunctionErrors(
  fn: IRFunction,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  baseBindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  bindings := compilerFunctionBindings(fn.params, baseBindings)
  checkFunctionReturn(fn, structs, callables, checkExpr(fn.body, structs, callables, errors, bindings), bindings)
}

checkExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => expr.kind {
  ExprKind.Block => checkBlockExpr(expr.children, 0, structs, callables, errors, bindings)
  ExprKind.Let => checkLetExpr(expr, structs, callables, errors, bindings)
  ExprKind.Struct => checkStructExpr(expr, structs, callables, errors, bindings)
  ExprKind.Ternary => checkTernaryExpr(expr, structs, callables, errors, bindings)
  ExprKind.Unary => checkUnaryExpr(expr, structs, callables, errors, bindings)
  ExprKind.Binary => checkBinaryExpr(expr, structs, callables, errors, bindings)
  ExprKind.Array => checkArrayExpr(expr, structs, callables, errors, bindings)
  ExprKind.Index => checkIndexExpr(expr, structs, callables, errors, bindings)
  _ => checkExprDefault(expr, structs, callables, errors, bindings)
}

checkExprDefault(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  next := checkExprCall(expr, callables, errors, bindings)
  expr.children.each((child) => next = checkExpr(child, structs, callables, next, bindings))
  next
}

checkTernaryExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  checked := checkExprDefault(expr, structs, callables, errors, bindings)
  withCondition := checkTernaryCondition(expr, callables, bindings, checked)
  checkTernaryBranches(expr, callables, bindings, withCondition)
}

checkTernaryCondition(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  complete := expr.children.length() > 0
  complete {
    true => checkTernaryConditionType(expr.children[0], callables, bindings, errors)
    _ => errors
  }
}

checkTernaryConditionType(
  condition: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(condition, callables, bindings)
  mismatch := (actual != "") && (actual != "Bool")
  mismatch {
    true => [..errors, "ternary condition expects Bool, got " + actual]
    _ => errors
  }
}

checkTernaryBranches(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  complete := expr.children.length() >= 3
  complete {
    true => checkTernaryBranchTypes(expr.children[1], expr.children[2], callables, bindings, errors)
    _ => errors
  }
}

checkTernaryBranchTypes(
  consequence: IRExpr,
  alternative: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  left := inferCompilerExprType(consequence, callables, bindings)
  right := inferCompilerExprType(alternative, callables, bindings)
  shouldCheck := (left != "") && (right != "")
  mismatch := shouldCheck && (inferCompilerCommonType(left, right) == "")
  mismatch {
    true => [..errors, (("ternary branches return " + left) + " and ") + right]
    _ => errors
  }
}

checkUnaryExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  checked := checkExprDefault(expr, structs, callables, errors, bindings)
  expr.op {
    "!" => checkBoolOperand("!", expr.children[0], callables, bindings, checked)
    "-" => checkNumericUnaryOperand(expr, callables, bindings, checked)
    "~" => checkBitwiseUnaryOperand(expr, callables, bindings, checked)
    _ => checked
  }
}

checkBinaryExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  checked := checkExprDefault(expr, structs, callables, errors, bindings)
  boolOp := (expr.op == "&&") || (expr.op == "||")
  boolOp {
    true => checkBinaryBoolOperands(expr, callables, bindings, checked)
    _ => checkTypedBinaryExpr(expr, callables, bindings, checked)
  }
}

checkTypedBinaryExpr(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  checked := checkEqualityComparisonExpr(expr, callables, bindings, errors)
  checked = checkOrderedComparisonExpr(expr, callables, bindings, checked)
  checked = checkNumericBinaryExpr(expr, callables, bindings, checked)
  checkBitwiseBinaryExpr(expr, callables, bindings, checked)
}

checkBinaryBoolOperands(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  complete := expr.children.length() >= 2
  complete {
    true => checkBoolOperand(expr.op, expr.children[1], callables, bindings, checkBoolOperand(expr.op, expr.children[0], callables, bindings, errors))
    _ => errors
  }
}

checkBoolOperand(
  op: String,
  operand: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(operand, callables, bindings)
  mismatch := (actual != "") && (actual != "Bool")
  mismatch {
    true => [..errors, (("operator '" + op) + "' expects Bool, got ") + actual]
    _ => errors
  }
}

checkArrayExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  checked := checkExprDefault(expr, structs, callables, errors, bindings)
  checkArrayElementTypes(expr.children, callables, bindings, checked, 0, "")
}

checkArrayElementTypes(
  elements: Array[IRExpr],
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String],
  index: Int,
  expected: String
) -> Array[String] => {
  done := index >= elements.length()
  done {
    true => errors
    _ => checkArrayElementType(elements, callables, bindings, errors, index, expected)
  }
}

checkArrayElementType(
  elements: Array[IRExpr],
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String],
  index: Int,
  expected: String
) -> Array[String] => {
  elem := elements[index]
  actual := inferCompilerArrayLiteralElementType(elem, callables, bindings)
  nextExpected := compilerNextArrayElementType(expected, actual)
  nextErrors := checkArrayElementTypeError(elem, expected, actual, callables, bindings, errors)
  checkArrayElementTypes(elements, callables, bindings, nextErrors, index + 1, nextExpected)
}

compilerNextArrayElementType(
  expected: String,
  actual: String
) -> String => expected {
  "" => actual
  _ => expected
}

checkArrayElementTypeError(
  elem: IRExpr,
  expected: String,
  actual: String,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  spreadErrors := checkArraySpreadElementType(elem, callables, bindings, errors)
  mismatch := ((expected != "") && (actual != "")) && (compilerTypesCompatible(expected, actual) == false)
  mismatch {
    true => [..spreadErrors, (("array element has type " + actual) + ", expected ") + expected]
    _ => spreadErrors
  }
}

checkArraySpreadElementType(
  elem: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => elem.kind {
  ExprKind.Spread => checkArraySpreadReceiverType(elem, callables, bindings, errors)
  _ => errors
}

checkArraySpreadReceiverType(
  elem: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(elem.children[0], callables, bindings)
  mismatch := (actual != "") && (compilerArrayElementType(actual) == "")
  mismatch {
    true => [..errors, "spread expects Array, got " + actual]
    _ => errors
  }
}

checkIndexExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  checked := checkExprDefault(expr, structs, callables, errors, bindings)
  complete := expr.children.length() >= 2
  complete {
    true => checkIndexExprTypes(expr, callables, bindings, checked)
    _ => checked
  }
}

checkIndexExprTypes(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  receiver := inferCompilerExprType(expr.children[0], callables, bindings)
  index := inferCompilerExprType(expr.children[1], callables, bindings)
  checkIndexReceiverType(receiver, index, errors)
}

checkIndexReceiverType(
  receiver: String,
  index: String,
  errors: Array[String]
) -> Array[String] => {
  arrayElem := compilerArrayElementType(receiver)
  mapKey := compilerMapKeyType(receiver)
  tuple := compilerTupleType(receiver)
  arrayElem {
    "" => checkNonArrayIndexReceiver(receiver, mapKey, tuple, index, errors)
    _ => checkArrayIndexType(index, errors)
  }
}

checkNonArrayIndexReceiver(
  receiver: String,
  mapKey: String,
  tuple: Bool,
  index: String,
  errors: Array[String]
) -> Array[String] => mapKey {
  "" => checkTupleOrUnknownIndexReceiver(receiver, tuple, index, errors)
  _ => checkMapIndexType(mapKey, index, errors)
}

checkTupleOrUnknownIndexReceiver(
  receiver: String,
  tuple: Bool,
  index: String,
  errors: Array[String]
) -> Array[String] => tuple {
  true => checkTupleIndexType(index, errors)
  _ => receiver {
    "" => errors
    _ => [..errors, ("type " + receiver) + " is not indexable"]
  }
}

checkArrayIndexType(
  index: String,
  errors: Array[String]
) -> Array[String] => {
  mismatch := (index != "") && (index != "Int")
  mismatch {
    true => [..errors, "array index expects Int, got " + index]
    _ => errors
  }
}

checkMapIndexType(
  expected: String,
  actual: String,
  errors: Array[String]
) -> Array[String] => {
  mismatch := ((expected != "") && (actual != "")) && (compilerTypesCompatible(expected, actual) == false)
  mismatch {
    true => [..errors, (("map index has type " + actual) + ", expected ") + expected]
    _ => errors
  }
}

checkTupleIndexType(
  index: String,
  errors: Array[String]
) -> Array[String] => {
  mismatch := (index != "") && (index != "Int")
  mismatch {
    true => [..errors, "tuple index expects an integer literal"]
    _ => errors
  }
}

checkEqualityComparisonExpr(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => compilerEqualityComparisonOp(expr.op) {
  true => checkEqualityComparisonOperands(expr, callables, bindings, errors)
  _ => errors
}

checkEqualityComparisonOperands(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  complete := expr.children.length() >= 2
  complete {
    true => checkEqualityComparisonTypes(expr, callables, bindings, errors)
    _ => errors
  }
}

checkEqualityComparisonTypes(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  left := inferCompilerExprType(expr.children[0], callables, bindings)
  right := inferCompilerExprType(expr.children[1], callables, bindings)
  mismatch := ((left != "") && (right != "")) && (compilerTypesComparable(left, right) == false)
  mismatch {
    true => [..errors, (("cannot compare " + left) + " and ") + right]
    _ => errors
  }
}

checkOrderedComparisonExpr(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => compilerOrderedComparisonOp(expr.op) {
  true => checkOrderedComparisonOperands(expr, callables, bindings, errors)
  _ => errors
}

checkOrderedComparisonOperands(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  complete := expr.children.length() >= 2
  complete {
    true => checkOrderedComparisonMatch(expr, callables, bindings, checkOrderedComparisonOperand(expr.children[1], callables, bindings, checkOrderedComparisonOperand(expr.children[0], callables, bindings, errors)))
    _ => errors
  }
}

checkOrderedComparisonOperand(
  operand: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(operand, callables, bindings)
  mismatch := (actual != "") && (compilerOrderedComparisonType(actual) == false)
  mismatch {
    true => [..errors, "ordered comparison expects a numeric type or String, got " + actual]
    _ => errors
  }
}

checkOrderedComparisonMatch(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  left := inferCompilerExprType(expr.children[0], callables, bindings)
  right := inferCompilerExprType(expr.children[1], callables, bindings)
  mismatch := ((left != "") && (right != "")) && (left != right)
  mismatch {
    true => [..errors, (("ordered comparison requires matching types, got " + left) + " and ") + right]
    _ => errors
  }
}

compilerOrderedComparisonOp(
  op: String
) -> Bool => (((op == "<") || (op == "<=")) || (op == ">")) || (op == ">=")

compilerEqualityComparisonOp(
  op: String
) -> Bool => (op == "==") || (op == "!=")

compilerOrderedComparisonType(
  typeName: String
) -> Bool => {
  numeric := compilerNumericType(typeName)
  base := compilerTypeBase(typeName)
  numeric || ((base == "String") || (base == "Char"))
}

checkNumericUnaryOperand(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(expr.children[0], callables, bindings)
  mismatch := (actual != "") && (compilerNumericType(actual) == false)
  mismatch {
    true => [..errors, "operator '-' expects a numeric type, got " + actual]
    _ => errors
  }
}

checkBitwiseUnaryOperand(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(expr.children[0], callables, bindings)
  mismatch := (actual != "") && (compilerBitwiseType(actual) == false)
  mismatch {
    true => [..errors, "operator '~' expects an integer type, got " + actual]
    _ => errors
  }
}

checkNumericBinaryExpr(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => compilerArithmeticOp(expr.op) {
  true => checkArithmeticOperands(expr, callables, bindings, errors)
  _ => errors
}

checkBitwiseBinaryExpr(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => compilerBitwiseOp(expr.op) {
  true => checkBitwiseOperands(expr, callables, bindings, errors)
  _ => errors
}

checkArithmeticOperands(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  complete := expr.children.length() >= 2
  complete {
    true => checkArithmeticOperandTypes(expr, callables, bindings, errors)
    _ => errors
  }
}

checkBitwiseOperands(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  complete := expr.children.length() >= 2
  complete {
    true => checkBitwiseOperandTypes(expr, callables, bindings, errors)
    _ => errors
  }
}

checkArithmeticOperandTypes(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  left := inferCompilerExprType(expr.children[0], callables, bindings)
  right := inferCompilerExprType(expr.children[1], callables, bindings)
  expr.op {
    "+" => checkPlusOperandTypes(left, right, errors)
    _ => checkNumericOperandTypes(expr.op, left, right, errors)
  }
}

checkBitwiseOperandTypes(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  left := inferCompilerExprType(expr.children[0], callables, bindings)
  right := inferCompilerExprType(expr.children[1], callables, bindings)
  checked := checkBitwiseOperand(right, checkBitwiseOperand(left, errors))
  withUnsigned := checkUnsignedShiftLeftOperand(expr.op, left, checked)
  checkBitwiseOperandMatch(left, right, withUnsigned)
}

checkPlusOperandTypes(
  left: String,
  right: String,
  errors: Array[String]
) -> Array[String] => {
  stringConcat := (left == "String") || (right == "String")
  stringConcat {
    true => checkStringConcatOperandTypes(left, right, errors)
    _ => checkNumericOperandTypes("+", left, right, errors)
  }
}

checkStringConcatOperandTypes(
  left: String,
  right: String,
  errors: Array[String]
) -> Array[String] => {
  next := checkStringConcatOperand(left, errors)
  checkStringConcatOperand(right, next)
}

checkStringConcatOperand(
  actual: String,
  errors: Array[String]
) -> Array[String] => {
  mismatch := (actual != "") && (actual != "String")
  mismatch {
    true => [..errors, "string concatenation expects String, got " + actual]
    _ => errors
  }
}

checkBitwiseOperand(
  actual: String,
  errors: Array[String]
) -> Array[String] => {
  mismatch := (actual != "") && (compilerBitwiseType(actual) == false)
  mismatch {
    true => [..errors, "bitwise operator expects integer operands, got " + actual]
    _ => errors
  }
}

checkUnsignedShiftLeftOperand(
  op: String,
  left: String,
  errors: Array[String]
) -> Array[String] => {
  invalid := ((op == ">>>") && (left != "")) && (compilerUnsignedIntegerType(left) == false)
  invalid {
    true => [..errors, "operator '>>>' expects an unsigned integer left operand, got " + left]
    _ => errors
  }
}

checkBitwiseOperandMatch(
  left: String,
  right: String,
  errors: Array[String]
) -> Array[String] => {
  shouldCheck := ((left != "") && (right != "")) && (compilerBitwiseType(left) && compilerBitwiseType(right))
  mismatch := shouldCheck && (left != right)
  mismatch {
    true => [..errors, (("bitwise operator requires matching integer types, got " + left) + " and ") + right]
    _ => errors
  }
}

checkNumericOperandTypes(
  op: String,
  left: String,
  right: String,
  errors: Array[String]
) -> Array[String] => {
  checked := checkNumericOperand(right, checkNumericOperand(left, errors))
  checkNumericOperandMatch(op, left, right, checked)
}

checkNumericOperand(
  actual: String,
  errors: Array[String]
) -> Array[String] => {
  mismatch := (actual != "") && (compilerNumericType(actual) == false)
  mismatch {
    true => [..errors, "arithmetic expects numeric operands, got " + actual]
    _ => errors
  }
}

checkNumericOperandMatch(
  op: String,
  left: String,
  right: String,
  errors: Array[String]
) -> Array[String] => {
  shouldCheck := ((left != "") && (right != "")) && (compilerNumericType(left) && compilerNumericType(right))
  mismatch := shouldCheck && (left != right)
  withMatch := mismatch {
    true => [..errors, (("arithmetic requires matching numeric types, got " + left) + " and ") + right]
    _ => errors
  }
  checkModuloOperand(op, left, right, withMatch)
}

checkModuloOperand(
  op: String,
  left: String,
  right: String,
  errors: Array[String]
) -> Array[String] => {
  invalid := (op == "%") && (((left == "Double") || (left == "Float")) || ((right == "Double") || (right == "Float")))
  invalid {
    true => [..errors, "operator '%' expects integer operands, got " + left]
    _ => errors
  }
}

compilerArithmeticOp(op: String) -> Bool => (((op == "+") || (op == "-")) || (op == "*")) || ((op == "/") || (op == "%"))

compilerBitwiseOp(op: String) -> Bool => (((op == "&") || (op == "|")) || ((op == "^") || (op == "<<"))) || ((op == ">>") || (op == ">>>"))

compilerNumericType(
  typeName: String
) -> Bool => {
  base := compilerTypeBase(typeName)
  (compilerIntegerType(base) || (base == "BigInt")) || ((base == "Double") || (base == "Float"))
}

compilerBitwiseType(
  typeName: String
) -> Bool => {
  base := compilerTypeBase(typeName)
  compilerIntegerType(base) || (base == "BigInt")
}

compilerIntegerType(
  base: String
) -> Bool => compilerSignedIntegerType(base) || compilerUnsignedIntegerType(base)

compilerSignedIntegerType(
  base: String
) -> Bool => (((base == "Int") || (base == "Int4")) || ((base == "Int8") || (base == "Int16"))) || (base == "Int64")

compilerUnsignedIntegerType(
  base: String
) -> Bool => (((base == "UInt") || (base == "UInt8")) || (base == "UInt16")) || (base == "UInt64")

checkLetExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  hasValue := expr.children.length() > 0
  hasValue {
    true => checkLetValueExpr(expr, structs, callables, errors, bindings)
    _ => errors
  }
}

checkLetValueExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  value := expr.children[0]
  checked := checkExprExpected(value, expr.value, structs, callables, errors, bindings)
  checkLetDeclaredType(expr.name, value, expr.value, callables, bindings, checked)
}

checkExprExpected(
  expr: IRExpr,
  expected: String,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  checked := checkExpr(expr, structs, callables, errors, bindings)
  checkExpectedExprType(expr, expected, structs, callables, bindings, checked)
}

checkExpectedExprType(
  expr: IRExpr,
  expected: String,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => moduleCallKey(expr) {
  "json.parse" => checkJsonParseTarget(expected, structs, errors)
  _ => errors
}

checkLetDeclaredType(
  name: String,
  value: IRExpr,
  expected: String,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(value, callables, bindings)
  mismatch := compilerShouldCheckArgType(expected, actual) && (compilerTypesCompatible(expected, actual) == false)
  mismatch {
    true => [..errors, (((("binding \"" + name) + "\" has type ") + actual) + ", expected ") + expected]
    _ => errors
  }
}

checkJsonParseTarget(
  expected: String,
  structs: Array[IRStructType],
  errors: Array[String]
) -> Array[String] => expected {
  "" => [..errors, "@json.parse target type cannot be inferred; add ': Type' to the binding"]
  "Dynamic" => [..errors, "@json.parse target type cannot be inferred; add ': Type' to the binding"]
  "Object" => errors
  _ => checkJsonParseFromJsonTarget(expected, structs, errors)
}

checkJsonParseFromJsonTarget(
  expected: String,
  structs: Array[IRStructType],
  errors: Array[String]
) -> Array[String] => {
  typeDecl := findCompilerStruct(structs, compilerTypeBase(expected), 0)
  ok := (typeDecl.name != "") && compilerStructHasFromJson(typeDecl, expected, 0)
  ok {
    true => errors
    _ => [..errors, ("@json.parse target type " + expected) + " does not implement &FromJson"]
  }
}

compilerStructHasFromJson(
  typeDecl: IRStructType,
  expected: String,
  index: Int
) -> Bool => {
  done := index >= typeDecl.methods.length()
  done {
    true => false
    _ => compilerStructHasFromJsonAt(typeDecl, expected, index)
  }
}

compilerStructHasFromJsonAt(
  typeDecl: IRStructType,
  expected: String,
  index: Int
) -> Bool => {
  method := typeDecl.methods[index]
  matched := ((method.name == "fromJson") && method.static) && compilerFromJsonSignatureMatches(method, expected)
  matched {
    true => true
    _ => compilerStructHasFromJson(typeDecl, expected, index + 1)
  }
}

compilerFromJsonSignatureMatches(
  method: IRFunction,
  expected: String
) -> Bool => {
  arityOk := method.params.length() == 1
  arityOk {
    true => (method.params[0].typeName == "String") && compilerTypesCompatible(expected, method.returnType)
    _ => false
  }
}

checkBlockExpr(
  statements: Array[IRExpr],
  index: Int,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  done := index >= statements.length()
  done {
    true => errors
    _ => checkBlockExprStep(statements, index, structs, callables, errors, bindings)
  }
}

checkBlockExprStep(
  statements: Array[IRExpr],
  index: Int,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  statement := statements[index]
  nextErrors := checkExpr(statement, structs, callables, errors, bindings)
  nextBindings := blockBindingsAfterStatement(statement, callables, bindings)
  checkBlockExpr(statements, index + 1, structs, callables, nextErrors, nextBindings)
}

checkStructExpr(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  typeDecl := findCompilerStruct(structs, expr.name, 0)
  found := typeDecl.name != ""
  found {
    true => checkStructExprFields(expr, typeDecl, structs, callables, errors, bindings)
    _ => checkStructExprUnknownType(expr, structs, callables, errors, bindings)
  }
}

checkStructExprUnknownType(
  expr: IRExpr,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  next := [..errors, ("unknown type \"" + expr.name) + "\""]
  expr.children.each((field) => next = checkExpr(field.children[0], structs, callables, next, bindings))
  next
}

checkStructExprFields(
  expr: IRExpr,
  typeDecl: IRStructType,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  checked := checkStructExprFieldValues(expr.name, expr.children, typeDecl.fields, 0, structs, callables, errors, bindings)
  checkStructMissingFields(expr.name, typeDecl.fields, expr.children, 0, checked)
}

checkStructExprFieldValues(
  typeName: String,
  fields: Array[IRExpr],
  expectedFields: Array[IRField],
  index: Int,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  done := index >= fields.length()
  done {
    true => errors
    _ => checkStructExprFieldValue(typeName, fields, expectedFields, index, structs, callables, errors, bindings)
  }
}

checkStructExprFieldValue(
  typeName: String,
  fields: Array[IRExpr],
  expectedFields: Array[IRField],
  index: Int,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  field := fields[index]
  value := field.children[0]
  expected := findCompilerStructField(expectedFields, field.name, 0)
  found := expected.name != ""
  next := found {
    true => {
      checkedValue := checkExprExpected(value, expected.typeName, structs, callables, errors, bindings)
      checkStructFieldType(typeName, field.name, value, expected.typeName, callables, bindings, checkedValue)
    }
    _ => [..checkExpr(value, structs, callables, errors, bindings), ((("type " + typeName) + " has no field \"") + field.name) + "\""]
  }
  checkStructExprFieldValues(typeName, fields, expectedFields, index + 1, structs, callables, next, bindings)
}

checkStructFieldType(
  typeName: String,
  fieldName: String,
  value: IRExpr,
  expected: String,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  actual := inferCompilerExprType(value, callables, bindings)
  mismatch := compilerShouldCheckArgType(expected, actual) && (compilerTypesCompatible(expected, actual) == false)
  mismatch {
    true => [..errors, (((((("field " + typeName) + ".") + fieldName) + " has type ") + actual) + ", expected ") + expected]
    _ => errors
  }
}

checkStructMissingFields(
  typeName: String,
  expectedFields: Array[IRField],
  fields: Array[IRExpr],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  done := index >= expectedFields.length()
  done {
    true => errors
    _ => checkStructMissingField(typeName, expectedFields, fields, index, errors)
  }
}

checkStructMissingField(
  typeName: String,
  expectedFields: Array[IRField],
  fields: Array[IRExpr],
  index: Int,
  errors: Array[String]
) -> Array[String] => {
  field := expectedFields[index]
  present := compilerExprFieldContains(fields, field.name, 0)
  present {
    true => checkStructMissingFields(typeName, expectedFields, fields, index + 1, errors)
    _ => checkStructMissingFields(typeName, expectedFields, fields, index + 1, [..errors, (("missing field " + typeName) + ".") + field.name])
  }
}

compilerExprFieldContains(
  fields: Array[IRExpr],
  name: String,
  index: Int
) -> Bool => {
  done := index >= fields.length()
  done {
    true => false
    _ => compilerExprFieldContainsAt(fields, name, index)
  }
}

compilerExprFieldContainsAt(
  fields: Array[IRExpr],
  name: String,
  index: Int
) -> Bool => {
  matched := fields[index].name == name
  matched {
    true => true
    _ => compilerExprFieldContains(fields, name, index + 1)
  }
}

blockBindingsAfterStatement(
  statement: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => statement.kind {
  ExprKind.Let => bindCompilerLet(statement, callables, bindings)
  _ => bindings
}

bindCompilerLet(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => {
  hasValue := expr.children.length() > 0
  hasValue {
    true => addCompilerTypeBinding(bindings, expr.name, compilerLetBindingType(expr, callables, bindings))
    _ => bindings
  }
}

compilerLetBindingType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => expr.value {
  "" => inferCompilerExprType(expr.children[0], callables, bindings)
  _ => expr.value
}

addCompilerTypeBinding(
  bindings: Array[CompilerTypeBinding],
  name: String,
  typeName: String
) -> Array[CompilerTypeBinding] => {
  known := typeName != ""
  known {
    true => [..dropCompilerTypeBinding(bindings, name, 0, [emptyCompilerTypeBinding()].slice(0, 0)), compilerTypeBinding(name, typeName)]
    _ => bindings
  }
}

dropCompilerTypeBinding(
  bindings: Array[CompilerTypeBinding],
  name: String,
  index: Int,
  out: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => {
  done := index >= bindings.length()
  done {
    true => out
    _ => dropCompilerTypeBindingStep(bindings, name, index, out)
  }
}

dropCompilerTypeBindingStep(
  bindings: Array[CompilerTypeBinding],
  name: String,
  index: Int,
  out: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => {
  matched := bindings[index].name == name
  matched {
    true => dropCompilerTypeBinding(bindings, name, index + 1, out)
    _ => dropCompilerTypeBinding(bindings, name, index + 1, [..out, bindings[index]])
  }
}

checkExprCall(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  identifierCall := ((expr.kind == ExprKind.Call) && (expr.children.length() > 0)) && (expr.children[0].kind == ExprKind.Identifier)
  identifierCall {
    true => checkIdentifierCall(expr, expr.children[0].name, expr.children.length() - 1, callables, errors, bindings)
    _ => checkSelectorCall(expr, callables, errors, bindings)
  }
}

checkSelectorCall(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  selectorCall := ((expr.kind == ExprKind.Call) && (expr.children.length() > 0)) && (expr.children[0].kind == ExprKind.Selector)
  selectorCall {
    true => checkSelectorCallExpr(expr, expr.children[0], callables, errors, bindings)
    _ => errors
  }
}

checkSelectorCallExpr(
  expr: IRExpr,
  selector: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  hasReceiver := selector.children.length() > 0
  hasReceiver {
    true => checkSelectorCallReceiver(expr, selector, selector.children[0], callables, errors, bindings)
    _ => errors
  }
}

checkSelectorCallReceiver(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => receiver.kind {
  ExprKind.At => checkAtSelectorCall(expr, selector, receiver, callables, errors, bindings)
  ExprKind.Identifier => checkIdentifierSelectorCall(expr, selector, receiver, callables, errors, bindings)
  _ => checkInstanceSelectorCall(expr, selector, receiver, callables, errors, bindings)
}

checkAtSelectorCall(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  importPath := compilerIRAtImportPath(receiver)
  (importPath == "") {
    true => errors
    _ => checkIdentifierCall(expr, selector.name, expr.children.length() - 1, callables, errors, bindings)
  }
}

checkIdentifierSelectorCall(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => selector.op {
  "::" => checkStaticSelectorCall(expr, selector, receiver.name, callables, errors, bindings)
  _ => checkInstanceSelectorCall(expr, selector, receiver, callables, errors, bindings)
}

checkStaticSelectorCall(
  expr: IRExpr,
  selector: IRExpr,
  receiverType: String,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  name := compilerStaticMethodName(receiverType, selector.name)
  callable := findCompilerCallable(callables, name, 0)
  found := callable.name != ""
  found {
    true => checkCallableCall(callable, expr, expr.children.length() - 1, callables, bindings, errors)
    _ => errors
  }
}

checkInstanceSelectorCall(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  receiverType := inferCompilerExprType(receiver, callables, bindings)
  known := receiverType != ""
  known {
    true => checkKnownInstanceSelectorCall(expr, selector, compilerTypeBase(receiverType), callables, errors, bindings)
    _ => errors
  }
}

checkKnownInstanceSelectorCall(
  expr: IRExpr,
  selector: IRExpr,
  receiverType: String,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  name := compilerInstanceMethodName(receiverType, selector.name)
  callable := findCompilerCallable(callables, name, 0)
  found := callable.name != ""
  found {
    true => checkCallableCall(callable, expr, expr.children.length() - 1, callables, bindings, errors)
    _ => errors
  }
}

checkIdentifierCall(
  expr: IRExpr,
  name: String,
  arity: Int,
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  callable := findCompilerCallable(callables, name, 0)
  found := callable.name != ""
  found {
    true => checkCallableCall(callable, expr, arity, callables, bindings, errors)
    _ => [..errors, "undefined function " + name]
  }
}

checkCallableCall(
  callable: CompilerCallable,
  expr: IRExpr,
  arity: Int,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String]
) -> Array[String] => {
  arityOk := callable.arity == arity
  arityOk {
    true => checkCallableArgTypes(callable, expr, callables, bindings, errors, 0)
    _ => checkCallableArity(callable, arity, errors)
  }
}

checkCallableArity(
  callable: CompilerCallable,
  arity: Int,
  errors: Array[String]
) -> Array[String] => {
  ok := callable.arity == arity
  ok {
    true => errors
    _ => [..errors, (((("function \"" + callable.name) + "\" expects ") + compilerIntToString(callable.arity)) + " args, got ") + compilerIntToString(arity)]
  }
}

checkCallableArgTypes(
  callable: CompilerCallable,
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String],
  index: Int
) -> Array[String] => {
  done := index >= callable.paramTypes.length()
  done {
    true => errors
    _ => checkCallableArgType(callable, expr, callables, bindings, errors, index)
  }
}

checkCallableArgType(
  callable: CompilerCallable,
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  errors: Array[String],
  index: Int
) -> Array[String] => {
  expected := callable.paramTypes[index]
  actual := inferCompilerExprType(expr.children[index + 1], callables, bindings)
  mismatch := compilerShouldCheckArgType(expected, actual) && (compilerTypesCompatible(expected, actual) == false)
  next := mismatch {
    true => [..errors, compilerArgumentTypeError(callable.name, index + 1, actual, expected)]
    _ => errors
  }
  checkCallableArgTypes(callable, expr, callables, bindings, next, index + 1)
}

compilerArgumentTypeError(
  name: String,
  index: Int,
  actual: String,
  expected: String
) -> String => (((((("argument " + compilerIntToString(index)) + " to \"") + name) + "\" has type ") + actual) + ", expected ") + expected

compilerShouldCheckArgType(
  expected: String,
  actual: String
) -> Bool => ((expected != "") && ((expected != "Dynamic") && (actual != ""))) && (compilerTypeIsGenericPlaceholder(expected) == false)

compilerTypeIsGenericPlaceholder(
  typeName: String
) -> Bool => (typeName.length() == 1) && ((typeName.at(0) >= 'A') && (typeName.at(0) <= 'Z'))

checkFunctionReturn(
  fn: IRFunction,
  structs: Array[IRStructType],
  callables: Array[CompilerCallable],
  errors: Array[String],
  bindings: Array[CompilerTypeBinding]
) -> Array[String] => {
  expected := fn.returnType
  checked := checkExpectedExprType(fn.body, expected, structs, callables, bindings, errors)
  actual := inferCompilerExprType(fn.body, callables, bindings)
  shouldCheck := ((expected != "") && (expected != "Dynamic")) && (actual != "")
  shouldCheck {
    true => checkFunctionReturnType(fn.name, expected, actual, checked)
    _ => checked
  }
}

checkFunctionReturnType(
  name: String,
  expected: String,
  actual: String,
  errors: Array[String]
) -> Array[String] => {
  ok := compilerTypesCompatible(expected, actual)
  ok {
    true => errors
    _ => [..errors, (((("function \"" + name) + "\" returns ") + actual) + ", expected ") + expected]
  }
}

compilerTypesCompatible(
  expected: String,
  actual: String
) -> Bool => {
  nullable := expected.endsWith("?")
  nullable {
    true => (actual == "Null") || compilerTypesCompatible(expected.slice(0, expected.length() - 1), actual)
    _ => compilerNonNullableTypesCompatible(expected, actual)
  }
}

compilerNonNullableTypesCompatible(
  expected: String,
  actual: String
) -> Bool => {
  same := expected == actual
  same {
    true => true
    _ => compilerGenericTypesCompatible(expected, actual)
  }
}

compilerGenericTypesCompatible(
  expected: String,
  actual: String
) -> Bool => {
  expectedBase := compilerTypeBase(expected)
  actualBase := compilerTypeBase(actual)
  sameBase := expectedBase == actualBase
  sameBase {
    true => compilerGenericTypeArgsCompatible(expected, actual)
    _ => expectedBase == actual
  }
}

compilerGenericTypeArgsCompatible(
  expected: String,
  actual: String
) -> Bool => {
  expectedArgs := compilerGenericArgs(expected)
  actualArgs := compilerGenericArgs(actual)
  hasExpected := expectedArgs.length() > 0
  hasActual := actualArgs.length() > 0
  hasExpected {
    true => hasActual {
      true => compilerGenericArgListsCompatible(expectedArgs, actualArgs, 0)
      _ => true
    }
    _ => true
  }
}

compilerGenericArgListsCompatible(
  expected: Array[String],
  actual: Array[String],
  index: Int
) -> Bool => {
  lengthMismatch := expected.length() != actual.length()
  lengthMismatch {
    true => false
    _ => compilerGenericArgListsCompatibleAt(expected, actual, index)
  }
}

compilerGenericArgListsCompatibleAt(
  expected: Array[String],
  actual: Array[String],
  index: Int
) -> Bool => {
  done := index >= expected.length()
  done {
    true => true
    _ => compilerTypesCompatible(expected[index].trim(), actual[index].trim()) && compilerGenericArgListsCompatibleAt(expected, actual, index + 1)
  }
}

compilerTypesComparable(
  left: String,
  right: String
) -> Bool => {
  unknown := (left == "") || (right == "")
  unknown {
    true => true
    _ => compilerKnownTypesComparable(left, right)
  }
}

compilerKnownTypesComparable(
  left: String,
  right: String
) -> Bool => {
  same := left == right
  same {
    true => true
    _ => compilerNullableTypesComparable(left, right)
  }
}

compilerNullableTypesComparable(
  left: String,
  right: String
) -> Bool => {
  leftNullable := left.endsWith("?")
  leftNullable {
    true => compilerLeftNullableComparable(left, right)
    _ => compilerRightNullableComparable(left, right)
  }
}

compilerLeftNullableComparable(
  left: String,
  right: String
) -> Bool => {
  rightNull := right == "Null"
  rightNull {
    true => true
    _ => compilerTypesComparable(left.slice(0, left.length() - 1), right)
  }
}

compilerRightNullableComparable(
  left: String,
  right: String
) -> Bool => {
  rightNullable := right.endsWith("?")
  rightNullable {
    true => compilerRightNullableInnerComparable(left, right)
    _ => false
  }
}

compilerRightNullableInnerComparable(
  left: String,
  right: String
) -> Bool => {
  leftNull := left == "Null"
  leftNull {
    true => true
    _ => compilerTypesComparable(left, right.slice(0, right.length() - 1))
  }
}

compilerTypeBase(
  typeName: String
) -> String => {
  generic := typeName.indexOf("[")
  (
    generic < 0 ? typeName
      : typeName.slice(0, generic)
  )
}

compilerGenericArgs(
  typeName: String
) -> Array[String] => {
  inner := compilerGenericInner(typeName)
  inner {
    "" => []
    _ => inner.split(",")
  }
}

compilerArrayType(
  elem: String
) -> String => elem {
  "" => "Array"
  _ => ("Array[" + elem) + "]"
}

compilerNullableType(
  inner: String
) -> String => inner {
  "" => ""
  "Null" => "Null"
  _ => inner.endsWith("?") {
    true => inner
    _ => inner + "?"
  }
}

compilerArrayElementType(
  typeName: String
) -> String => {
  base := compilerTypeBase(typeName)
  args := compilerGenericArgs(typeName)
  valid := (base == "Array") && (args.length() == 1)
  valid {
    true => args[0].trim()
    _ => ""
  }
}

compilerMapKeyType(
  typeName: String
) -> String => {
  base := compilerTypeBase(typeName)
  args := compilerGenericArgs(typeName)
  valid := (base == "Map") && (args.length() == 2)
  valid {
    true => args[0].trim()
    _ => ""
  }
}

compilerMapValueType(
  typeName: String
) -> String => {
  base := compilerTypeBase(typeName)
  args := compilerGenericArgs(typeName)
  valid := (base == "Map") && (args.length() == 2)
  valid {
    true => args[1].trim()
    _ => ""
  }
}

compilerTupleType(
  typeName: String
) -> Bool => {
  base := compilerTypeBase(typeName)
  (base == "Tuple") || (base == "ReadonlyTuple")
}

inferCompilerExprType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => expr.kind {
  ExprKind.Identifier => findCompilerTypeBinding(bindings, expr.name, 0).typeName
  ExprKind.Selector => inferCompilerSelectorType(expr, callables, bindings)
  ExprKind.String => "String"
  ExprKind.Template => "String"
  ExprKind.Int => "Int"
  ExprKind.Double => "Double"
  ExprKind.BigInt => "BigInt"
  ExprKind.Char => "Char"
  ExprKind.Bool => "Bool"
  ExprKind.Null => "Null"
  ExprKind.Struct => expr.name
  ExprKind.Call => inferCompilerCallType(expr, callables, bindings)
  ExprKind.Block => inferCompilerBlockType(expr, callables, bindings)
  ExprKind.Ternary => inferCompilerTernaryType(expr, callables, bindings)
  ExprKind.Unary => inferCompilerUnaryType(expr, callables, bindings)
  ExprKind.Binary => inferCompilerBinaryType(expr, callables, bindings)
  ExprKind.Array => inferCompilerArrayType(expr, callables, bindings)
  ExprKind.Spread => inferCompilerSpreadType(expr, callables, bindings)
  ExprKind.Index => inferCompilerIndexType(expr, callables, bindings)
  _ => ""
}

inferCompilerArrayType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => compilerArrayType(inferCompilerArrayElementType(expr.children, callables, bindings, 0, ""))

inferCompilerArrayElementType(
  elements: Array[IRExpr],
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  index: Int,
  expected: String
) -> String => {
  done := index >= elements.length()
  done {
    true => expected
    _ => inferCompilerArrayElementTypeAt(elements, callables, bindings, index, expected)
  }
}

inferCompilerArrayElementTypeAt(
  elements: Array[IRExpr],
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  index: Int,
  expected: String
) -> String => {
  actual := inferCompilerArrayLiteralElementType(elements[index], callables, bindings)
  next := compilerNextArrayElementType(expected, actual)
  inferCompilerArrayElementType(elements, callables, bindings, index + 1, next)
}

inferCompilerArrayLiteralElementType(
  elem: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => elem.kind {
  ExprKind.Spread => compilerArrayElementType(inferCompilerExprType(elem.children[0], callables, bindings))
  _ => inferCompilerExprType(elem, callables, bindings)
}

inferCompilerSpreadType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  complete := expr.children.length() > 0
  complete {
    true => inferCompilerExprType(expr.children[0], callables, bindings)
    _ => ""
  }
}

inferCompilerIndexType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  complete := expr.children.length() >= 2
  complete {
    true => inferCompilerIndexReceiverType(inferCompilerExprType(expr.children[0], callables, bindings))
    _ => ""
  }
}

inferCompilerIndexReceiverType(
  receiverType: String
) -> String => {
  arrayElem := compilerArrayElementType(receiverType)
  mapValue := compilerMapValueType(receiverType)
  arrayElem {
    "" => compilerNullableType(mapValue)
    _ => arrayElem
  }
}

inferCompilerCallType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  identifierCall := (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Identifier)
  identifierCall {
    true => compilerCallableReturnOrText(findCompilerCallable(callables, expr.children[0].name, 0), expr.text)
    _ => inferCompilerSelectorCallType(expr, callables, bindings)
  }
}

compilerCallableReturnOrText(
  callable: CompilerCallable,
  fallback: String
) -> String => {
  found := callable.name != ""
  found {
    true => callable.returnType
    _ => fallback
  }
}

inferCompilerSelectorCallType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  selectorCall := (expr.children.length() > 0) && (expr.children[0].kind == ExprKind.Selector)
  selectorCall {
    true => inferCompilerSelectorCallTypeFromSelector(expr, expr.children[0], callables, bindings)
    _ => expr.text
  }
}

inferCompilerSelectorCallTypeFromSelector(
  expr: IRExpr,
  selector: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  hasReceiver := selector.children.length() > 0
  hasReceiver {
    true => inferCompilerSelectorCallTypeFromReceiver(expr, selector, selector.children[0], callables, bindings)
    _ => expr.text
  }
}

inferCompilerSelectorCallTypeFromReceiver(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => receiver.kind {
  ExprKind.At => inferCompilerAtSelectorCallType(expr, selector, receiver, callables)
  ExprKind.Identifier => inferCompilerIdentifierSelectorCallType(expr, selector, receiver, callables, bindings)
  _ => inferCompilerInstanceSelectorCallType(expr, selector, receiver, callables, bindings)
}

inferCompilerAtSelectorCallType(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable]
) -> String => {
  importPath := compilerIRAtImportPath(receiver)
  (importPath == "") {
    true => expr.text
    _ => compilerCallableReturnOrText(findCompilerCallable(callables, selector.name, 0), expr.text)
  }
}

inferCompilerSelectorType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  hasReceiver := expr.children.length() > 0
  hasReceiver {
    true => inferCompilerSelectorTypeFromReceiver(expr, expr.children[0], callables, bindings)
    _ => ""
  }
}

inferCompilerSelectorTypeFromReceiver(
  expr: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => receiver.kind {
  ExprKind.At => compilerIRAtImportPath(receiver) {
    "" => ""
    _ => findCompilerTypeBinding(bindings, expr.name, 0).typeName
  }
  _ => ""
}

inferCompilerIdentifierSelectorCallType(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => selector.op {
  "::" => compilerCallableReturnOrText(findCompilerCallable(callables, compilerStaticMethodName(receiver.name, selector.name), 0), expr.text)
  _ => inferCompilerInstanceSelectorCallType(expr, selector, receiver, callables, bindings)
}

inferCompilerInstanceSelectorCallType(
  expr: IRExpr,
  selector: IRExpr,
  receiver: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  receiverType := inferCompilerExprType(receiver, callables, bindings)
  known := receiverType != ""
  known {
    true => compilerCallableReturnOrText(findCompilerCallable(callables, compilerInstanceMethodName(compilerTypeBase(receiverType), selector.name), 0), expr.text)
    _ => expr.text
  }
}

inferCompilerBlockType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => inferCompilerBlockTypeAt(expr.children, 0, callables, bindings, "Void")

inferCompilerBlockTypeAt(
  statements: Array[IRExpr],
  index: Int,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding],
  lastType: String
) -> String => {
  done := index >= statements.length()
  done {
    true => lastType
    _ => inferCompilerBlockTypeStep(statements, index, callables, bindings)
  }
}

inferCompilerBlockTypeStep(
  statements: Array[IRExpr],
  index: Int,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  statement := statements[index]
  statementType := inferCompilerExprType(statement, callables, bindings)
  nextBindings := blockBindingsAfterStatement(statement, callables, bindings)
  inferCompilerBlockTypeAt(statements, index + 1, callables, nextBindings, statementType)
}

inferCompilerTernaryType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  complete := expr.children.length() >= 3
  complete {
    true => inferCompilerCommonType(inferCompilerExprType(expr.children[1], callables, bindings), inferCompilerExprType(expr.children[2], callables, bindings))
    _ => ""
  }
}

inferCompilerUnaryType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => expr.op {
  "!" => "Bool"
  _ => inferCompilerExprType(expr.children[0], callables, bindings)
}

inferCompilerBinaryType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => {
  comparison := (((expr.op == "==") || (expr.op == "!=")) || ((expr.op == "<") || (expr.op == "<="))) || ((expr.op == ">") || (expr.op == ">="))
  boolOp := (expr.op == "&&") || (expr.op == "||")
  knownBool := comparison || boolOp
  knownBool {
    true => "Bool"
    _ => inferCompilerBinaryValueType(expr, callables, bindings)
  }
}

inferCompilerBinaryValueType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => compilerArithmeticOp(expr.op) {
  true => inferCompilerNumericBinaryType(expr, callables, bindings)
  _ => inferCompilerBitwiseBinaryType(expr, callables, bindings)
}

inferCompilerNumericBinaryType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => inferCompilerNumericPairType(inferCompilerExprType(expr.children[0], callables, bindings), inferCompilerExprType(expr.children[1], callables, bindings))

inferCompilerBitwiseBinaryType(
  expr: IRExpr,
  callables: Array[CompilerCallable],
  bindings: Array[CompilerTypeBinding]
) -> String => compilerBitwiseOp(expr.op) {
  true => inferCompilerBitwisePairType(inferCompilerExprType(expr.children[0], callables, bindings), inferCompilerExprType(expr.children[1], callables, bindings))
  _ => ""
}

inferCompilerBitwisePairType(
  left: String,
  right: String
) -> String => {
  missing := (left == "") || (right == "")
  missing {
    true => ""
    _ => inferCompilerMatchingPairType(left, right)
  }
}

inferCompilerMatchingPairType(
  left: String,
  right: String
) -> String => {
  matched := left == right
  matched {
    true => left
    _ => ""
  }
}

inferCompilerNumericPairType(
  left: String,
  right: String
) -> String => (
  (left == "") || (right == "") ? ""
    : (
      (left == "Double") || (right == "Double") ? "Double"
        : inferCompilerCommonType(left, right)
    )
)

inferCompilerCommonType(
  left: String,
  right: String
) -> String => (
  left == right ? left
    : ""
)

findCompilerCallable(
  callables: Array[CompilerCallable],
  name: String,
  index: Int
) -> CompilerCallable => {
  done := index >= callables.length()
  done {
    true => emptyCompilerCallable()
    _ => findCompilerCallableAt(callables, name, index)
  }
}

findCompilerCallableAt(
  callables: Array[CompilerCallable],
  name: String,
  index: Int
) -> CompilerCallable => {
  matched := callables[index].name == name
  matched {
    true => callables[index]
    _ => findCompilerCallable(callables, name, index + 1)
  }
}

compilerCallable(
  name: String,
  arity: Int,
  returnType: String,
  paramTypes: Array[String]
) -> CompilerCallable => {
  name: name,
  arity: arity,
  returnType: returnType,
  paramTypes: paramTypes
}

emptyCompilerCallable(
) -> CompilerCallable => compilerCallable("", 0, "", [])

compilerParamTypeNames(
  params: Array[IRParam]
) -> Array[String] => {
  names := [""].slice(0, 0)
  params.each((param) => names.push(param.typeName))
  names
}

compilerParamBindings(
  params: Array[IRParam]
) -> Array[CompilerTypeBinding] => {
  compilerFunctionBindings(params, [emptyCompilerTypeBinding()].slice(0, 0))
}

compilerInitialBindings(
  file: IRFile
) -> Array[CompilerTypeBinding] => {
  bindings := [emptyCompilerTypeBinding()].slice(0, 0)
  file.tsImports.each((importDecl) => bindings = compilerImportValueBindings(importDecl.values, bindings))
  bindings
}

compilerImportValueBindings(
  values: Array[IRConst],
  bindings: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => {
  out := bindings
  values.each((value) => out = addCompilerTypeBinding(out, value.name, value.typeName))
  out
}

compilerFunctionBindings(
  params: Array[IRParam],
  baseBindings: Array[CompilerTypeBinding]
) -> Array[CompilerTypeBinding] => {
  bindings := baseBindings
  params.each((param) => bindings = addCompilerTypeBinding(bindings, param.name, param.typeName))
  bindings
}

compilerTypeBinding(
  name: String,
  typeName: String
) -> CompilerTypeBinding => {
  name: name,
  typeName: typeName
}

emptyCompilerTypeBinding(
) -> CompilerTypeBinding => compilerTypeBinding("", "")

findCompilerTypeBinding(
  bindings: Array[CompilerTypeBinding],
  name: String,
  index: Int
) -> CompilerTypeBinding => {
  done := index >= bindings.length()
  done {
    true => emptyCompilerTypeBinding()
    _ => findCompilerTypeBindingAt(bindings, name, index)
  }
}

findCompilerTypeBindingAt(
  bindings: Array[CompilerTypeBinding],
  name: String,
  index: Int
) -> CompilerTypeBinding => {
  matched := bindings[index].name == name
  matched {
    true => bindings[index]
    _ => findCompilerTypeBinding(bindings, name, index + 1)
  }
}

findCompilerStruct(
  structs: Array[IRStructType],
  name: String,
  index: Int
) -> IRStructType => {
  done := index >= structs.length()
  done {
    true => emptyCompilerStruct()
    _ => findCompilerStructAt(structs, name, index)
  }
}

findCompilerStructAt(
  structs: Array[IRStructType],
  name: String,
  index: Int
) -> IRStructType => {
  matched := structs[index].name == name
  matched {
    true => structs[index]
    _ => findCompilerStruct(structs, name, index + 1)
  }
}

emptyCompilerStruct() -> IRStructType => {
  name: "",
  private: false,
  generics: [],
  fields: [],
  methods: [],
  line: 0,
  column: 0
}

findCompilerStructField(
  fields: Array[IRField],
  name: String,
  index: Int
) -> IRField => {
  done := index >= fields.length()
  done {
    true => emptyCompilerField()
    _ => findCompilerStructFieldAt(fields, name, index)
  }
}

findCompilerStructFieldAt(
  fields: Array[IRField],
  name: String,
  index: Int
) -> IRField => {
  matched := fields[index].name == name
  matched {
    true => fields[index]
    _ => findCompilerStructField(fields, name, index + 1)
  }
}

emptyCompilerField() -> IRField => {
  name: "",
  private: false,
  typeName: "",
  jsonName: "",
  jsonIgnore: false,
  line: 0,
  column: 0
}

compilerContains(
  values: Array[String],
  value: String
) -> Bool => compilerContainsAt(values, value, 0)

compilerContainsAt(
  values: Array[String],
  value: String,
  index: Int
) -> Bool => (
  index >= values.length() ? false
    : (
      values[index] == value ? true
        : compilerContainsAt(values, value, index + 1)
    )
)

compilerStructNameAppearsAfter(
  structs: Array[IRStructType],
  name: String,
  index: Int
) -> Bool => {
  done := index >= structs.length()
  done {
    true => false
    _ => (structs[index].name == name) {
      true => true
      _ => compilerStructNameAppearsAfter(structs, name, index + 1)
    }
  }
}

compilerEnumNameAppearsAfter(
  enums: Array[IREnumType],
  name: String,
  index: Int
) -> Bool => {
  done := index >= enums.length()
  done {
    true => false
    _ => (enums[index].name == name) {
      true => true
      _ => compilerEnumNameAppearsAfter(enums, name, index + 1)
    }
  }
}

compilerFunctionNameAppearsBefore(
  functions: Array[IRFunction],
  name: String,
  macro: Bool,
  index: Int
) -> Bool => {
  done := index < 0
  done {
    true => false
    _ => compilerFunctionNameAppearsBeforeAt(functions, name, macro, index)
  }
}

compilerFunctionNameAppearsBeforeAt(
  functions: Array[IRFunction],
  name: String,
  macro: Bool,
  index: Int
) -> Bool => {
  matched := (functions[index].name == name) && (functions[index].macro == macro)
  matched {
    true => true
    _ => compilerFunctionNameAppearsBefore(functions, name, macro, index - 1)
  }
}

compilerFieldNameAppearsBefore(
  fields: Array[IRField],
  name: String,
  index: Int
) -> Bool => {
  done := index < 0
  done {
    true => false
    _ => (fields[index].name == name) {
      true => true
      _ => compilerFieldNameAppearsBefore(fields, name, index - 1)
    }
  }
}

compilerMethodNameAppearsBefore(
  methods: Array[IRFunction],
  name: String,
  index: Int
) -> Bool => {
  done := index < 0
  done {
    true => false
    _ => (methods[index].name == name) {
      true => true
      _ => compilerMethodNameAppearsBefore(methods, name, index - 1)
    }
  }
}

compilerEnumMemberNameAppearsBefore(
  members: Array[IREnumMember],
  name: String,
  index: Int
) -> Bool => {
  done := index < 0
  done {
    true => false
    _ => (members[index].name == name) {
      true => true
      _ => compilerEnumMemberNameAppearsBefore(members, name, index - 1)
    }
  }
}

compilerParamNameAppearsBefore(
  params: Array[IRParam],
  name: String,
  index: Int
) -> Bool => {
  done := index < 0
  done {
    true => false
    _ => (params[index].name == name) {
      true => true
      _ => compilerParamNameAppearsBefore(params, name, index - 1)
    }
  }
}

lowerFiles(
  files: Array[SourceFile]
) -> IRFile => (
  files.length() == 0 ? emptyCompilerIRFile()
    : lowerReachableRuneFiles(files, [files[0].path], [], emptyCompilerIRFile())
)

lowerCompilerSource(
  source: String
) -> IRFile => lowerParsed(expandCompilerMacros(parse(source)))

expandCompilerMacros(
  file: ParsedFile
) -> ParsedFile => {
  imports := compilerMergeParsedImports(file.imports, compilerImportExpressions(file), 0)
  errors := compilerMacroErrors(file, file.errors)
  out := ParsedFile {
    imports: imports,
    types: [],
    functions: [],
    tests: [],
    errors: errors
  }
  file.types.each((typeDecl) => out.types.push(expandCompilerTypeMacros(typeDecl)))
  file.functions.each((fn) => out.functions.push(expandCompilerFunctionMacros(fn)))
  file.tests.each((testDecl) => out.tests.push(expandCompilerTestMacros(testDecl)))
  out
}

expandCompilerTypeMacros(
  typeDecl: ParsedType
) -> ParsedType => {
  typeName := compilerRenameDeclarationName(typeDecl.annotations, typeDecl.name)
  fields := typeDecl.fields.slice(0, 0)
  methods := typeDecl.methods.slice(0, 0)
  members := typeDecl.members.slice(0, 0)
  typeDecl.fields.each((field) => fields.push(expandCompilerFieldMacros(field)))
  typeDecl.methods.each((method) => methods.push(expandCompilerFunctionMacros(method)))
  typeDecl.members.each((member) => members.push(expandCompilerEnumMemberMacros(member)))
  ParsedType {
    name: typeName,
    private: typeDecl.private,
    enum: typeDecl.enum,
    annotations: typeDecl.annotations,
    generics: typeDecl.generics,
    fields: fields,
    methods: expandCompilerTypeMacroMethods(typeDecl, typeName, methods),
    members: members,
    line: typeDecl.line,
    column: typeDecl.column
  }
}

expandCompilerTypeMacroMethods(
  typeDecl: ParsedType,
  typeName: String,
  methods: Array[ParsedFunction]
) -> Array[ParsedFunction] => typeDecl.enum {
  true => methods
  _ => expandCompilerStructMacroMethods(typeDecl, typeName, methods)
}

expandCompilerStructMacroMethods(
  typeDecl: ParsedType,
  typeName: String,
  methods: Array[ParsedFunction]
) -> Array[ParsedFunction] => {
  shouldAddFromJson := compilerHasAnnotation(typeDecl.annotations, "#", "json", "object") && (compilerHasFromJsonMethod(methods, 0) == false)
  shouldAddFromJson {
    true => [..methods, compilerJsonFromJsonMethod(typeDecl, typeName)]
    _ => methods
  }
}

compilerJsonFromJsonMethod(
  typeDecl: ParsedType,
  typeName: String
) -> ParsedFunction => {
  name: "fromJson",
  private: false,
  static: true,
  routine: false,
  macro: false,
  annotations: compilerEmptyAnnotations(),
  receiverType: typeName,
  generics: [],
  params: [ParsedParam {
    name: "text",
    typeRef: compilerTypeRef("String", typeDecl.line, typeDecl.column),
    line: typeDecl.line,
    column: typeDecl.column
  }],
  returnType: compilerGenericTypeRef(typeName, typeDecl.generics, typeDecl.line, typeDecl.column),
  body: compilerJsonParseExpr(typeDecl.line, typeDecl.column),
  line: typeDecl.line,
  column: typeDecl.column
}

compilerJsonParseExpr(
  line: Int,
  column: Int
) -> ParsedExpr => {
  jsonModule := compilerParsedExpr(ExprKind.At, "@", "json", "", "", [], [], line, column)
  parseSelector := compilerParsedExpr(ExprKind.Selector, "parse", "parse", "", ".", [], [jsonModule], line, column)
  textArg := compilerParsedExpr(ExprKind.Identifier, "text", "text", "", "", [], [], line, column)
  compilerParsedExpr(ExprKind.Call, "parse", "", "", "", [], [parseSelector, textArg], line, column)
}

compilerEmptyAnnotations(
) -> Array[ParsedAnnotation] => [ParsedAnnotation {
  marker: "",
  module: "",
  name: "",
  args: [],
  line: 0,
  column: 0
}].slice(0, 0)

compilerParsedExpr(
  kind: ExprKind,
  text: String,
  name: String,
  value: String,
  op: String,
  params: Array[ParsedParam],
  children: Array[ParsedExpr],
  line: Int,
  column: Int
) -> ParsedExpr => {
  kind: kind,
  text: text,
  name: name,
  value: value,
  op: op,
  params: params,
  children: children,
  line: line,
  column: column
}

compilerGenericTypeRef(
  name: String,
  generics: Array[String],
  line: Int,
  column: Int
) -> ParsedTypeRef => {
  args := compilerGenericTypeRefArgs(generics, 0, line, column, [emptyParsedTypeRef()].slice(0, 0))
  compilerTypeRefWithArgs(name, args, line, column)
}

compilerGenericTypeRefArgs(
  generics: Array[String],
  index: Int,
  line: Int,
  column: Int,
  out: Array[ParsedTypeRef]
) -> Array[ParsedTypeRef] => {
  done := index >= generics.length()
  done {
    true => out
    _ => compilerGenericTypeRefArgsStep(generics, index, line, column, out)
  }
}

compilerGenericTypeRefArgsStep(
  generics: Array[String],
  index: Int,
  line: Int,
  column: Int,
  out: Array[ParsedTypeRef]
) -> Array[ParsedTypeRef] => {
  out.push(compilerTypeRef(generics[index], line, column))
  compilerGenericTypeRefArgs(generics, index + 1, line, column, out)
}

compilerTypeRef(
  name: String,
  line: Int,
  column: Int
) -> ParsedTypeRef => compilerTypeRefWithArgs(name, [emptyParsedTypeRef()].slice(0, 0), line, column)

compilerTypeRefWithArgs(
  name: String,
  args: Array[ParsedTypeRef],
  line: Int,
  column: Int
) -> ParsedTypeRef => {
  kind: TypeRefKind.Name,
  name: name,
  module: "",
  nullable: false,
  args: args,
  params: [],
  returnTypes: [],
  line: line,
  column: column
}

compilerHasFromJsonMethod(
  methods: Array[ParsedFunction],
  index: Int
) -> Bool => {
  done := index >= methods.length()
  done {
    true => false
    _ => compilerHasFromJsonMethodAt(methods, index)
  }
}

compilerHasFromJsonMethodAt(
  methods: Array[ParsedFunction],
  index: Int
) -> Bool => {
  matched := methods[index].name == "fromJson"
  matched {
    true => true
    _ => compilerHasFromJsonMethod(methods, index + 1)
  }
}

compilerHasAnnotation(
  annotations: Array[ParsedAnnotation],
  marker: String,
  module: String,
  name: String
) -> Bool => compilerHasAnnotationAt(annotations, marker, module, name, 0)

compilerHasAnnotationAt(
  annotations: Array[ParsedAnnotation],
  marker: String,
  module: String,
  name: String,
  index: Int
) -> Bool => {
  done := index >= annotations.length()
  done {
    true => false
    _ => compilerHasAnnotationStep(annotations, marker, module, name, index)
  }
}

compilerHasAnnotationStep(
  annotations: Array[ParsedAnnotation],
  marker: String,
  module: String,
  name: String,
  index: Int
) -> Bool => {
  annotation := annotations[index]
  matched := ((annotation.marker == marker) && (annotation.module == module)) && (annotation.name == name)
  matched {
    true => true
    _ => compilerHasAnnotationAt(annotations, marker, module, name, index + 1)
  }
}

expandCompilerFieldMacros(
  field: ParsedField
) -> ParsedField => {
  name: compilerRenameDeclarationName(field.annotations, field.name),
  private: field.private,
  annotations: field.annotations,
  typeRef: field.typeRef,
  line: field.line,
  column: field.column
}

expandCompilerEnumMemberMacros(
  member: ParsedEnumMember
) -> ParsedEnumMember => {
  name: compilerRenameDeclarationName(member.annotations, member.name),
  private: member.private,
  annotations: member.annotations,
  value: member.value,
  params: member.params,
  line: member.line,
  column: member.column
}

expandCompilerFunctionMacros(
  fn: ParsedFunction
) -> ParsedFunction => {
  name: compilerRenameDeclarationName(fn.annotations, fn.name),
  private: fn.private,
  static: fn.static,
  routine: fn.routine,
  macro: fn.macro,
  annotations: fn.annotations,
  receiverType: fn.receiverType,
  generics: fn.generics,
  params: fn.params,
  returnType: fn.returnType,
  body: expandCompilerNamespaceAliases(fn.body, [emptyCompilerNamespaceAlias()].slice(0, 0)),
  line: fn.line,
  column: fn.column
}

compilerMacroErrors(
  file: ParsedFile,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  functionErrors := compilerMacroFunctionErrors(file.functions, 0, errors)
  compilerAnnotationErrors(file, functionErrors)
}

compilerMacroFunctionErrors(
  functions: Array[ParsedFunction],
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  done := index >= functions.length()
  done {
    true => errors
    _ => compilerMacroFunctionErrors(functions, index + 1, compilerMacroFunctionError(functions[index], errors))
  }
}

compilerMacroFunctionError(
  fn: ParsedFunction,
  errors: Array[ParseError]
) -> Array[ParseError] => fn.macro {
  true => compilerSyntaxMacroSignatureOk(fn) {
    true => errors
    _ => [..errors, compilerParseError(("macro " + fn.name) + " must accept SyntaxFile and MacroContext first and return SyntaxFile", fn.line, fn.column)]
  }
  _ => errors
}

compilerSyntaxMacroSignatureOk(
  fn: ParsedFunction
) -> Bool => {
  returnOk := typeRefToString(fn.returnType) == "SyntaxFile"
  paramsOk := (fn.params.length() >= 2) && ((typeRefToString(fn.params[0].typeRef) == "SyntaxFile") && (typeRefToString(fn.params[1].typeRef) == "MacroContext"))
  returnOk && paramsOk
}

compilerAnnotationErrors(
  file: ParsedFile,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  next := compilerTypeAnnotationErrors(file.types, file.functions, 0, errors)
  compilerFunctionAnnotationErrors(file.functions, file.functions, 0, next)
}

compilerTypeAnnotationErrors(
  types: Array[ParsedType],
  functions: Array[ParsedFunction],
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  done := index >= types.length()
  done {
    true => errors
    _ => compilerTypeAnnotationErrors(types, functions, index + 1, compilerTypeAnnotationError(types[index], functions, errors))
  }
}

compilerTypeAnnotationError(
  typeDecl: ParsedType,
  functions: Array[ParsedFunction],
  errors: Array[ParseError]
) -> Array[ParseError] => {
  next := compilerAnnotationListErrors(typeDecl.annotations, functions, 0, errors)
  next = compilerFieldAnnotationErrors(typeDecl.fields, functions, 0, next)
  next = compilerEnumMemberAnnotationErrors(typeDecl.members, functions, 0, next)
  compilerFunctionAnnotationErrors(typeDecl.methods, functions, 0, next)
}

compilerFieldAnnotationErrors(
  fields: Array[ParsedField],
  functions: Array[ParsedFunction],
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  done := index >= fields.length()
  done {
    true => errors
    _ => compilerFieldAnnotationErrors(fields, functions, index + 1, compilerAnnotationListErrors(fields[index].annotations, functions, 0, errors))
  }
}

compilerEnumMemberAnnotationErrors(
  members: Array[ParsedEnumMember],
  functions: Array[ParsedFunction],
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  done := index >= members.length()
  done {
    true => errors
    _ => compilerEnumMemberAnnotationErrors(members, functions, index + 1, compilerAnnotationListErrors(members[index].annotations, functions, 0, errors))
  }
}

compilerFunctionAnnotationErrors(
  functions: Array[ParsedFunction],
  topLevelFunctions: Array[ParsedFunction],
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  done := index >= functions.length()
  done {
    true => errors
    _ => compilerFunctionAnnotationErrors(functions, topLevelFunctions, index + 1, compilerAnnotationListErrors(functions[index].annotations, topLevelFunctions, 0, errors))
  }
}

compilerAnnotationListErrors(
  annotations: Array[ParsedAnnotation],
  functions: Array[ParsedFunction],
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  done := index >= annotations.length()
  done {
    true => errors
    _ => compilerAnnotationListErrors(annotations, functions, index + 1, compilerAnnotationError(annotations[index], functions, errors))
  }
}

compilerAnnotationError(
  annotation: ParsedAnnotation,
  functions: Array[ParsedFunction],
  errors: Array[ParseError]
) -> Array[ParseError] => annotation.marker {
  "#" => compilerHashAnnotationError(annotation, functions, errors)
  _ => errors
}

compilerHashAnnotationError(
  annotation: ParsedAnnotation,
  functions: Array[ParsedFunction],
  errors: Array[ParseError]
) -> Array[ParseError] => annotation.module {
  "" => compilerLocalAnnotationError(annotation, functions, errors)
  _ => compilerModuleAnnotationError(annotation, errors)
}

compilerLocalAnnotationError(
  annotation: ParsedAnnotation,
  functions: Array[ParsedFunction],
  errors: Array[ParseError]
) -> Array[ParseError] => annotation.name {
  "" => errors
  "alias" => errors
  _ => compilerResolvedLocalAnnotationError(annotation, findCompilerMacroBinding(functions, annotation.name, 0), errors)
}

compilerResolvedLocalAnnotationError(
  annotation: ParsedAnnotation,
  binding: CompilerMacroBinding,
  errors: Array[ParseError]
) -> Array[ParseError] => binding.name {
  "" => [..errors, compilerParseError("unknown macro #" + annotation.name, annotation.line, annotation.column)]
  _ => binding.macro {
    true => compilerAnnotationArgErrors(annotation, binding, errors)
    _ => [..errors, compilerParseError(("#" + annotation.name) + " refers to a function that is not a macro", annotation.line, annotation.column)]
  }
}

compilerModuleAnnotationError(
  annotation: ParsedAnnotation,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  binding := compilerBuiltinMacroBinding(annotation.module, annotation.name)
  binding.name {
    "" => compilerUnknownModuleMacroError(annotation, errors)
    _ => compilerAnnotationArgErrors(annotation, binding, errors)
  }
}

compilerUnknownModuleMacroError(
  annotation: ParsedAnnotation,
  errors: Array[ParseError]
) -> Array[ParseError] => compilerKnownOrdinaryAnnotationFunction(annotation.module, annotation.name) {
  true => [..errors, compilerParseError(((("#" + annotation.module) + ".") + annotation.name) + " refers to a function that is not a macro", annotation.line, annotation.column)]
  _ => [..errors, compilerParseError((("unknown macro #" + annotation.module) + ".") + annotation.name, annotation.line, annotation.column)]
}

compilerAnnotationArgErrors(
  annotation: ParsedAnnotation,
  binding: CompilerMacroBinding,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  arityOk := annotation.args.length() == binding.paramTypes.length()
  arityOk {
    true => compilerAnnotationArgTypeErrors(annotation, binding, 0, errors)
    _ => [..errors, compilerParseError((((("function \"" + binding.name) + "\" expects ") + compilerIntToString(binding.paramTypes.length())) + " args, got ") + compilerIntToString(annotation.args.length()), annotation.line, annotation.column)]
  }
}

compilerAnnotationArgTypeErrors(
  annotation: ParsedAnnotation,
  binding: CompilerMacroBinding,
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  done := index >= binding.paramTypes.length()
  done {
    true => errors
    _ => compilerAnnotationArgTypeErrors(annotation, binding, index + 1, compilerAnnotationArgTypeError(annotation, binding, index, errors))
  }
}

compilerAnnotationArgTypeError(
  annotation: ParsedAnnotation,
  binding: CompilerMacroBinding,
  index: Int,
  errors: Array[ParseError]
) -> Array[ParseError] => {
  expected := binding.paramTypes[index]
  actual := compilerParsedAnnotationArgType(annotation.args[index])
  shouldCheck := compilerShouldCheckArgType(expected, actual)
  mismatch := shouldCheck && (compilerTypesCompatible(expected, actual) == false)
  mismatch {
    true => [..errors, compilerParseError(compilerArgumentTypeError(binding.name, index + 1, actual, expected), annotation.line, annotation.column)]
    _ => errors
  }
}

compilerParsedAnnotationArgType(
  expr: ParsedExpr
) -> String => expr.kind {
  ExprKind.String => "String"
  ExprKind.Template => "String"
  ExprKind.Int => "Int"
  ExprKind.Double => "Double"
  ExprKind.BigInt => "BigInt"
  ExprKind.Char => "Char"
  ExprKind.Bool => "Bool"
  ExprKind.Null => "Null"
  _ => ""
}

findCompilerMacroBinding(
  functions: Array[ParsedFunction],
  name: String,
  index: Int
) -> CompilerMacroBinding => {
  done := index >= functions.length()
  done {
    true => emptyCompilerMacroBinding()
    _ => findCompilerMacroBindingAt(functions, name, index)
  }
}

findCompilerMacroBindingAt(
  functions: Array[ParsedFunction],
  name: String,
  index: Int
) -> CompilerMacroBinding => {
  matched := functions[index].name == name
  matched {
    true => compilerMacroBindingFromFunction(functions[index])
    _ => findCompilerMacroBinding(functions, name, index + 1)
  }
}

compilerMacroBindingFromFunction(
  fn: ParsedFunction
) -> CompilerMacroBinding => {
  name: fn.name,
  macro: fn.macro,
  paramTypes: fn.macro {
    true => compilerVisibleMacroParamTypes(fn.params, 2, [""].slice(0, 0))
    _ => compilerParsedParamTypeNames(fn.params, 0, [""].slice(0, 0))
  }
}

compilerVisibleMacroParamTypes(
  params: Array[ParsedParam],
  index: Int,
  out: Array[String]
) -> Array[String] => {
  done := index >= params.length()
  done {
    true => out
    _ => compilerVisibleMacroParamTypes(params, index + 1, [..out, typeRefToString(params[index].typeRef)])
  }
}

compilerParsedParamTypeNames(
  params: Array[ParsedParam],
  index: Int,
  out: Array[String]
) -> Array[String] => {
  done := index >= params.length()
  done {
    true => out
    _ => compilerParsedParamTypeNames(params, index + 1, [..out, typeRefToString(params[index].typeRef)])
  }
}

compilerBuiltinMacroBinding(
  module: String,
  name: String
) -> CompilerMacroBinding => module {
  "macro" => compilerMacroModuleBinding(name)
  "json" => compilerJsonModuleMacroBinding(name)
  "cli" => compilerCliModuleMacroBinding(name)
  _ => emptyCompilerMacroBinding()
}

compilerMacroModuleBinding(
  name: String
) -> CompilerMacroBinding => name {
  "renameDeclaration" => compilerMacroBinding("renameDeclaration", true, ["String"])
  _ => emptyCompilerMacroBinding()
}

compilerJsonModuleMacroBinding(
  name: String
) -> CompilerMacroBinding => name {
  "object" => compilerMacroBinding("object", true, [])
  "name" => compilerMacroBinding("name", true, ["String"])
  "ignore" => compilerMacroBinding("ignore", true, [])
  _ => emptyCompilerMacroBinding()
}

compilerCliModuleMacroBinding(
  name: String
) -> CompilerMacroBinding => name {
  "command" => compilerMacroBinding("command", true, ["String", "String", "String"])
  "flag" => compilerMacroBinding("flag", true, ["String", "String"])
  "option" => compilerMacroBinding("option", true, ["String", "String", "String", "String"])
  "arg" => compilerMacroBinding("arg", true, ["String"])
  "parser" => compilerMacroBinding("parser", true, ["String", "String", "String", "String", "String"])
  "main" => compilerMacroBinding("main", true, [])
  _ => emptyCompilerMacroBinding()
}

compilerKnownOrdinaryAnnotationFunction(
  module: String,
  name: String
) -> Bool => module {
  "json" => (name == "parse") || (name == "stringify")
  "go" => ((name == "import") || (name == "stmt")) || (name == "expr")
  _ => false
}

compilerMacroBinding(
  name: String,
  macro: Bool,
  paramTypes: Array[String]
) -> CompilerMacroBinding => {
  name: name,
  macro: macro,
  paramTypes: paramTypes
}

emptyCompilerMacroBinding(
) -> CompilerMacroBinding => compilerMacroBinding("", false, [])

compilerParseError(
  message: String,
  line: Int,
  column: Int
) -> ParseError => {
  message: message,
  line: line,
  column: column
}

expandCompilerTestMacros(
  testDecl: ParsedTest
) -> ParsedTest => {
  name: testDecl.name,
  body: expandCompilerNamespaceAliases(testDecl.body, [emptyCompilerNamespaceAlias()].slice(0, 0)),
  line: testDecl.line,
  column: testDecl.column
}

compilerImportExpressions(
  file: ParsedFile
) -> Array[ParsedImport] => {
  imports := [compilerEmptyParsedImport()].slice(0, 0)
  file.types.each((typeDecl) => imports = compilerCollectTypeImportExprs(typeDecl, imports))
  file.functions.each((fn) => imports = compilerCollectFunctionImportExprs(fn, imports))
  file.tests.each((testDecl) => imports = compilerCollectImportExprs(testDecl.body, imports))
  imports
}

compilerCollectTypeImportExprs(
  typeDecl: ParsedType,
  imports: Array[ParsedImport]
) -> Array[ParsedImport] => {
  out := imports
  typeDecl.methods.each((method) => out = compilerCollectFunctionImportExprs(method, out))
  out
}

compilerCollectFunctionImportExprs(
  fn: ParsedFunction,
  imports: Array[ParsedImport]
) -> Array[ParsedImport] => compilerCollectImportExprs(fn.body, imports)

compilerCollectImportExprs(
  expr: ParsedExpr,
  imports: Array[ParsedImport]
) -> Array[ParsedImport] => {
  next := expr.kind {
    ExprKind.At => compilerAppendImportExpr(imports, expr)
    _ => imports
  }
  expr.children.each((child) => next = compilerCollectImportExprs(child, next))
  next
}

compilerAppendImportExpr(
  imports: Array[ParsedImport],
  expr: ParsedExpr
) -> Array[ParsedImport] => {
  path := compilerAtImportPath(expr)
  (
    path == "" ? imports
      : compilerAppendParsedImportIfMissing(imports, ParsedImport {
        path: path,
        go: false,
        line: expr.line,
        column: expr.column
      })
  )
}

compilerMergeParsedImports(
  imports: Array[ParsedImport],
  extra: Array[ParsedImport],
  index: Int
) -> Array[ParsedImport] => (
  index >= extra.length() ? imports
    : compilerMergeParsedImports(compilerAppendParsedImportIfMissing(imports, extra[index]), extra, index + 1)
)

compilerAppendParsedImportIfMissing(
  imports: Array[ParsedImport],
  importDecl: ParsedImport
) -> Array[ParsedImport] => compilerParsedImportContains(imports, importDecl.path, importDecl.go, 0) {
  true => imports
  _ => [..imports, importDecl]
}

compilerParsedImportContains(
  imports: Array[ParsedImport],
  path: String,
  go: Bool,
  index: Int
) -> Bool => (
  index >= imports.length() ? false
    : (
      (imports[index].path == path) && (imports[index].go == go) ? true
        : compilerParsedImportContains(imports, path, go, index + 1)
    )
)

compilerEmptyParsedImport(
) -> ParsedImport => {
  path: "",
  go: false,
  line: 0,
  column: 0
}

expandCompilerNamespaceAliases(
  expr: ParsedExpr,
  aliases: Array[CompilerNamespaceAlias]
) -> ParsedExpr => expr.kind {
  ExprKind.Block => expandCompilerNamespaceAliasBlock(expr, aliases)
  ExprKind.Lambda => expandCompilerNamespaceAliasLambda(expr, aliases)
  ExprKind.Selector => expandCompilerNamespaceAliasSelector(expr, aliases)
  _ => expandCompilerNamespaceAliasChildren(expr, aliases)
}

expandCompilerNamespaceAliasBlock(
  expr: ParsedExpr,
  aliases: Array[CompilerNamespaceAlias]
) -> ParsedExpr => compilerWithChildren(expr, expandCompilerNamespaceAliasBlockChildren(expr.children, 0, aliases, expr.children.slice(0, 0)))

expandCompilerNamespaceAliasBlockChildren(
  statements: Array[ParsedExpr],
  index: Int,
  aliases: Array[CompilerNamespaceAlias],
  out: Array[ParsedExpr]
) -> Array[ParsedExpr] => {
  done := index >= statements.length()
  done {
    true => out
    _ => expandCompilerNamespaceAliasBlockStep(statements, index, aliases, out)
  }
}

expandCompilerNamespaceAliasBlockStep(
  statements: Array[ParsedExpr],
  index: Int,
  aliases: Array[CompilerNamespaceAlias],
  out: Array[ParsedExpr]
) -> Array[ParsedExpr] => {
  statement := statements[index]
  alias := compilerNamespaceAliasFromLet(statement)
  isAlias := alias.name != ""
  isAlias {
    true => expandCompilerNamespaceAliasBlockChildren(statements, index + 1, addCompilerNamespaceAlias(aliases, alias), out)
    _ => {
      expanded := expandCompilerNamespaceAliases(statement, aliases)
      nextAliases := compilerNamespaceAliasesAfterBinding(expanded, aliases)
      expandCompilerNamespaceAliasBlockChildren(statements, index + 1, nextAliases, [..out, expanded])
    }
  }
}

compilerNamespaceAliasesAfterBinding(
  statement: ParsedExpr,
  aliases: Array[CompilerNamespaceAlias]
) -> Array[CompilerNamespaceAlias] => statement.kind {
  ExprKind.Let => dropCompilerNamespaceAlias(aliases, statement.name, 0, [emptyCompilerNamespaceAlias()].slice(0, 0))
  ExprKind.ObjectDestructure => dropCompilerNamespaceAliasParams(aliases, statement.params, 0)
  _ => aliases
}

dropCompilerNamespaceAliasParams(
  aliases: Array[CompilerNamespaceAlias],
  params: Array[ParsedParam],
  index: Int
) -> Array[CompilerNamespaceAlias] => (
  index >= params.length() ? aliases
    : dropCompilerNamespaceAliasParams(dropCompilerNamespaceAlias(aliases, params[index].name, 0, [emptyCompilerNamespaceAlias()].slice(0, 0)), params, index + 1)
)

expandCompilerNamespaceAliasLambda(
  expr: ParsedExpr,
  aliases: Array[CompilerNamespaceAlias]
) -> ParsedExpr => compilerWithChildren(expr, expandCompilerNamespaceAliasChildrenList(expr.children, 0, dropCompilerNamespaceAliasParams(aliases, expr.params, 0), expr.children.slice(0, 0)))

expandCompilerNamespaceAliasSelector(
  expr: ParsedExpr,
  aliases: Array[CompilerNamespaceAlias]
) -> ParsedExpr => {
  noReceiver := expr.children.length() == 0
  noReceiver {
    true => expr
    _ => expandCompilerNamespaceAliasSelectorReceiver(expr, expandCompilerNamespaceAliases(expr.children[0], aliases), aliases)
  }
}

expandCompilerNamespaceAliasSelectorReceiver(
  expr: ParsedExpr,
  receiver: ParsedExpr,
  aliases: Array[CompilerNamespaceAlias]
) -> ParsedExpr => {
  canAlias := receiver.kind == ExprKind.Identifier
  alias := (
    canAlias ? findCompilerNamespaceAlias(aliases, receiver.name, 0)
      : emptyCompilerNamespaceAlias()
  )
  found := alias.name != ""
  found {
    true => expandCompilerNamespaceAliasSelectorFound(expr, receiver, alias)
    _ => compilerWithChildren(expr, [receiver])
  }
}

expandCompilerNamespaceAliasSelectorFound(
  expr: ParsedExpr,
  receiver: ParsedExpr,
  alias: CompilerNamespaceAlias
) -> ParsedExpr => {
  moduleAlias := alias.module != ""
  moduleAlias {
    true => compilerWithChildren(expr, [compilerModuleAtExpr(alias.module, receiver.line, receiver.column)])
    _ => compilerParsedExpr(ExprKind.Identifier, expr.name, expr.name, "", "", [], [], expr.line, expr.column)
  }
}

expandCompilerNamespaceAliasChildren(
  expr: ParsedExpr,
  aliases: Array[CompilerNamespaceAlias]
) -> ParsedExpr => compilerWithChildren(expr, expandCompilerNamespaceAliasChildrenList(expr.children, 0, aliases, expr.children.slice(0, 0)))

expandCompilerNamespaceAliasChildrenList(
  children: Array[ParsedExpr],
  index: Int,
  aliases: Array[CompilerNamespaceAlias],
  out: Array[ParsedExpr]
) -> Array[ParsedExpr] => (
  index >= children.length() ? out
    : expandCompilerNamespaceAliasChildrenList(children, index + 1, aliases, [..out, expandCompilerNamespaceAliases(children[index], aliases)])
)

compilerNamespaceAliasFromLet(
  expr: ParsedExpr
) -> CompilerNamespaceAlias => {
  valid := (expr.kind == ExprKind.Let) && (expr.children.length() > 0)
  valid {
    true => compilerNamespaceAliasFromLetValue(expr.name, expr.children[0])
    _ => emptyCompilerNamespaceAlias()
  }
}

compilerNamespaceAliasFromLetValue(
  name: String,
  value: ParsedExpr
) -> CompilerNamespaceAlias => {
  valid := value.kind == ExprKind.At
  valid {
    true => compilerNamespaceAliasFromAt(name, value)
    _ => emptyCompilerNamespaceAlias()
  }
}

compilerNamespaceAliasFromAt(
  name: String,
  expr: ParsedExpr
) -> CompilerNamespaceAlias => {
  importPath := compilerAtImportPath(expr)
  (
    importPath != "" ? compilerNamespaceAlias(name, "")
      : (
        expr.name != "" ? compilerNamespaceAlias(name, expr.name)
          : emptyCompilerNamespaceAlias()
      )
  )
}

compilerAtImportPath(
  expr: ParsedExpr
) -> String => (
  (expr.kind == ExprKind.At) && (expr.value != "") ? compilerUnquoteString(expr.value)
    : ""
)

compilerIRAtImportPath(
  expr: IRExpr
) -> String => (
  (expr.kind == ExprKind.At) && (expr.value != "") ? compilerUnquoteString(expr.value)
    : ""
)

compilerModuleAtExpr(
  module: String,
  line: Int,
  column: Int
) -> ParsedExpr => compilerParsedExpr(ExprKind.At, "@", module, "", "", [], [], line, column)

compilerWithChildren(
  expr: ParsedExpr,
  children: Array[ParsedExpr]
) -> ParsedExpr => compilerParsedExpr(expr.kind, expr.text, expr.name, expr.value, expr.op, expr.params, children, expr.line, expr.column)

compilerNamespaceAlias(
  name: String,
  module: String
) -> CompilerNamespaceAlias => {
  name: name,
  module: module
}

emptyCompilerNamespaceAlias(
) -> CompilerNamespaceAlias => compilerNamespaceAlias("", "")

addCompilerNamespaceAlias(
  aliases: Array[CompilerNamespaceAlias],
  alias: CompilerNamespaceAlias
) -> Array[CompilerNamespaceAlias] => [..dropCompilerNamespaceAlias(aliases, alias.name, 0, [emptyCompilerNamespaceAlias()].slice(0, 0)), alias]

dropCompilerNamespaceAlias(
  aliases: Array[CompilerNamespaceAlias],
  name: String,
  index: Int,
  out: Array[CompilerNamespaceAlias]
) -> Array[CompilerNamespaceAlias] => (
  index >= aliases.length() ? out
    : (
      aliases[index].name == name ? dropCompilerNamespaceAlias(aliases, name, index + 1, out)
        : dropCompilerNamespaceAlias(aliases, name, index + 1, [..out, aliases[index]])
    )
)

findCompilerNamespaceAlias(
  aliases: Array[CompilerNamespaceAlias],
  name: String,
  index: Int
) -> CompilerNamespaceAlias => (
  index >= aliases.length() ? emptyCompilerNamespaceAlias()
    : (
      aliases[index].name == name ? aliases[index]
        : findCompilerNamespaceAlias(aliases, name, index + 1)
    )
)

compilerRenameDeclarationName(
  annotations: Array[ParsedAnnotation],
  fallback: String
) -> String => compilerRenameDeclarationNameAt(annotations, fallback, 0)

compilerRenameDeclarationNameAt(
  annotations: Array[ParsedAnnotation],
  fallback: String,
  index: Int
) -> String => {
  done := index >= annotations.length()
  done {
    true => fallback
    _ => compilerRenameDeclarationNameStep(annotations, fallback, index)
  }
}

compilerRenameDeclarationNameStep(
  annotations: Array[ParsedAnnotation],
  fallback: String,
  index: Int
) -> String => {
  annotation := annotations[index]
  matched := (((annotation.marker == "#") && (annotation.module == "macro")) && (annotation.name == "renameDeclaration")) && (annotation.args.length() > 0)
  matched {
    true => compilerAnnotationStringArg(annotation, 0, fallback)
    _ => compilerRenameDeclarationNameAt(annotations, fallback, index + 1)
  }
}

compilerAnnotationStringArg(
  annotation: ParsedAnnotation,
  index: Int,
  fallback: String
) -> String => {
  valid := (index < annotation.args.length()) && (annotation.args[index].kind == ExprKind.String)
  valid {
    true => compilerUnquoteString(annotation.args[index].value)
    _ => fallback
  }
}

compilerUnquoteString(
  raw: String
) -> String => (
  raw.length() >= 2 ? raw.slice(1, raw.length() - 1)
    : raw
)

lowerReachableRuneFiles(
  files: Array[SourceFile],
  pending: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  empty := pending.length() == 0
  empty {
    true => out
    _ => lowerReachableRuneFile(files, pending[0], pending.slice(1, pending.length()), seen, out)
  }
}

lowerReachableRuneFile(
  files: Array[SourceFile],
  path: String,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  alreadySeen := compilerContains(seen, path)
  alreadySeen {
    true => lowerReachableRuneFiles(files, rest, seen, out)
    _ => lowerUnseenRuneFile(files, path, rest, [..seen, path], out)
  }
}

lowerUnseenRuneFile(
  files: Array[SourceFile],
  path: String,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  file := findSourceFile(files, path, 0)
  missing := file.path.isEmpty()
  missing {
    true => lowerReachableRuneFiles(files, rest, seen, mergeCompilerIRFile(out, missingImportFile(path)))
    _ => lowerFoundSourceFile(files, file, rest, seen, out)
  }
}

lowerFoundSourceFile(
  files: Array[SourceFile],
  file: SourceFile,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  typeScript := sourceFileIsTypeScript(file)
  typeScript {
    true => lowerReachableRuneFiles(files, rest, seen, out)
    _ => lowerFoundRuneSourceFile(files, file, rest, seen, out)
  }
}

lowerFoundRuneSourceFile(
  files: Array[SourceFile],
  file: SourceFile,
  rest: Array[String],
  seen: Array[String],
  out: IRFile
) -> IRFile => {
  lowered := lowerCompilerSource(file.source)
  merged := mergeCompilerIRFile(out, lowered)
  withTypeScript := lowerTypeScriptImportsForRuneFile(files, file.path, lowered.imports, 0, merged)
  lowerReachableRuneFiles(files, appendImportPaths(rest, file.path, lowered.imports, 0), seen, withTypeScript)
}

lowerTypeScriptImportsForRuneFile(
  files: Array[SourceFile],
  basePath: String,
  imports: Array[IRImport],
  index: Int,
  out: IRFile
) -> IRFile => {
  done := index >= imports.length()
  done {
    true => out
    _ => lowerTypeScriptImportForRuneFile(files, basePath, imports, index, out)
  }
}

lowerTypeScriptImportForRuneFile(
  files: Array[SourceFile],
  basePath: String,
  imports: Array[IRImport],
  index: Int,
  out: IRFile
) -> IRFile => {
  importDecl := imports[index]
  shouldLoad := (importDecl.go == false) && importDecl.path.endsWith(".ts")
  shouldLoad {
    true => lowerTypeScriptImportPathForRuneFile(files, basePath, imports, index, out)
    _ => lowerTypeScriptImportsForRuneFile(files, basePath, imports, index + 1, out)
  }
}

lowerTypeScriptImportPathForRuneFile(
  files: Array[SourceFile],
  basePath: String,
  imports: Array[IRImport],
  index: Int,
  out: IRFile
) -> IRFile => {
  importDecl := imports[index]
  resolved := resolveCompilerImportPath(basePath, importDecl.path)
  file := findSourceFile(files, resolved, 0)
  missing := file.path.isEmpty()
  next := missing {
    true => mergeCompilerIRFile(out, missingImportFile(resolved))
    _ => mergeCompilerIRFile(out, lowerTypeScriptSourceFile(file, importDecl.path))
  }
  lowerTypeScriptImportsForRuneFile(files, basePath, imports, index + 1, next)
}

appendImportPaths(
  pending: Array[String],
  basePath: String,
  imports: Array[IRImport],
  index: Int
) -> Array[String] => {
  done := index >= imports.length()
  done {
    true => pending
    _ => appendImportPath(pending, basePath, imports, index)
  }
}

appendImportPath(
  pending: Array[String],
  basePath: String,
  imports: Array[IRImport],
  index: Int
) -> Array[String] => {
  goImport := imports[index].go
  goImport {
    true => appendImportPaths(pending, basePath, imports, index + 1)
    _ => appendImportPathIfRune(pending, basePath, imports, index)
  }
}

appendImportPathIfRune(
  pending: Array[String],
  basePath: String,
  imports: Array[IRImport],
  index: Int
) -> Array[String] => {
  typeScript := imports[index].path.endsWith(".ts")
  typeScript {
    true => appendImportPaths(pending, basePath, imports, index + 1)
    _ => appendImportPaths([..pending, resolveCompilerImportPath(basePath, imports[index].path)], basePath, imports, index + 1)
  }
}

findSourceFile(
  files: Array[SourceFile],
  path: String,
  index: Int
) -> SourceFile => {
  exact := findSourceFileExact(files, compilerPathNormalize(path), index)
  found := exact.path.isEmpty() == false
  found {
    true => exact
    _ => findSourceFileBasename(files, path, index)
  }
}

findSourceFileExact(
  files: Array[SourceFile],
  path: String,
  index: Int
) -> SourceFile => {
  done := index >= files.length()
  done {
    true => emptySourceFile()
    _ => findSourceFileExactAt(files, path, index)
  }
}

findSourceFileExactAt(
  files: Array[SourceFile],
  path: String,
  index: Int
) -> SourceFile => {
  matched := compilerPathNormalize(files[index].path) == path
  matched {
    true => files[index]
    _ => findSourceFileExact(files, path, index + 1)
  }
}

findSourceFileBasename(
  files: Array[SourceFile],
  path: String,
  index: Int
) -> SourceFile => {
  done := index >= files.length()
  done {
    true => emptySourceFile()
    _ => findSourceFileBasenameAt(files, path, index)
  }
}

findSourceFileBasenameAt(
  files: Array[SourceFile],
  path: String,
  index: Int
) -> SourceFile => {
  matched := compilerPathBasename(files[index].path) == compilerPathBasename(path)
  matched {
    true => files[index]
    _ => findSourceFileBasename(files, path, index + 1)
  }
}

emptySourceFile() -> SourceFile => {
  path: "",
  source: ""
}

missingImportFile(
  path: String
) -> IRFile => {
  out := emptyCompilerIRFile()
  out.errors.push(ParseError {
    message: "missing import " + path,
    line: 0,
    column: 0
  })
  out
}

sourceFileIsTypeScript(
  file: SourceFile
) -> Bool => file.path.endsWith(".ts")

resolveCompilerImportPath(
  basePath: String,
  importPath: String
) -> String => {
  absolute := importPath.startsWith("/")
  absolute {
    true => compilerPathNormalize(importPath)
    _ => compilerPathNormalize(compilerPathJoin(compilerPathDirname(basePath), importPath))
  }
}

compilerPathDirname(
  path: String
) -> String => {
  slash := path.lastIndexOf("/")
  (
    slash < 0 ? ""
      : (
        slash == 0 ? "/"
          : path.slice(0, slash)
      )
  )
}

compilerPathJoin(
  base: String,
  child: String
) -> String => (
  base.isEmpty() ? child
    : (
      base == "/" ? "/" + child
        : (base + "/") + child
    )
)

compilerPathNormalize(
  path: String
) -> String => {
  absolute := path.startsWith("/")
  parts := path.split("/")
  normalized := compilerPathNormalizeParts(parts, 0, absolute, parts.slice(0, 0))
  joined := compilerPathJoinParts(normalized, 0, "")
  absolute {
    true => "/" + joined
    _ => (
      joined.isEmpty() ? "."
        : joined
    )
  }
}

compilerPathNormalizeParts(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String]
) -> Array[String] => (
  index >= parts.length() ? out
    : compilerPathNormalizePart(parts, index, absolute, out)
)

compilerPathNormalizePart(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String]
) -> Array[String] => {
  part := parts[index]
  (
    part.isEmpty() || (part == ".") ? compilerPathNormalizeParts(parts, index + 1, absolute, out)
      : (
        part == ".." ? compilerPathNormalizeParent(parts, index, absolute, out)
          : compilerPathNormalizeParts(parts, index + 1, absolute, [..out, part])
      )
  )
}

compilerPathNormalizeParent(
  parts: Array[String],
  index: Int,
  absolute: Bool,
  out: Array[String]
) -> Array[String] => {
  canPop := (out.length() > 0) && (out[out.length() - 1] != "..")
  canPop {
    true => compilerPathNormalizeParts(parts, index + 1, absolute, out.slice(0, out.length() - 1))
    _ => (
      absolute ? compilerPathNormalizeParts(parts, index + 1, absolute, out)
        : compilerPathNormalizeParts(parts, index + 1, absolute, [..out, ".."])
    )
  }
}

compilerPathJoinParts(
  parts: Array[String],
  index: Int,
  out: String
) -> String => (
  index >= parts.length() ? out
    : compilerPathJoinParts(parts, index + 1, compilerPathJoin(out, parts[index]))
)

lowerTypeScriptSourceFile(
  file: SourceFile,
  specifier: String
) -> IRFile => {
  out := emptyCompilerIRFile()
  (
    specifier != "" ? out.tsImports.push(parseTypeScriptImport(file.path, specifier, file.source))
  )
  out
}

typeScriptImportSpecifier(
  path: String,
  imports: Array[IRImport],
  index: Int
) -> String => (
  index >= imports.length() ? ""
    : (
      imports[index].path.endsWith(".ts") && (compilerPathBasename(path) == compilerPathBasename(imports[index].path)) ? imports[index].path
        : typeScriptImportSpecifier(path, imports, index + 1)
    )
)

compilerPathBasename(
  path: String
) -> String => {
  slash := path.lastIndexOf("/")
  (
    slash < 0 ? path
      : path.slice(slash + 1, path.length())
  )
}

parseTypeScriptImport(
  path: String,
  specifier: String,
  source: String
) -> IRTSImport => {
  imports := IRTSImport {
    path: path,
    specifier: specifier,
    functions: [emptyIRFunction()].slice(0, 0),
    values: [emptyIRConst()].slice(0, 0),
    line: 0,
    column: 0
  }
  source.split("\n").each((line) => imports = parseTypeScriptExportLine(imports, line.trim()))
  imports
}

parseTypeScriptExportLine(
  imports: IRTSImport,
  line: String
) -> IRTSImport => (
  line.startsWith("export async function ") ? pushTypeScriptFunction(imports, line.slice("export async function ".length(), line.length()), true)
    : (
      line.startsWith("export function ") ? pushTypeScriptFunction(imports, line.slice("export function ".length(), line.length()), false)
        : (
          line.startsWith("export const ") ? pushTypeScriptValue(imports, line.slice("export const ".length(), line.length()))
            : (
              line.startsWith("export let ") ? pushTypeScriptValue(imports, line.slice("export let ".length(), line.length()))
                : (
                  line.startsWith("export var ") ? pushTypeScriptValue(imports, line.slice("export var ".length(), line.length()))
                    : imports
                )
            )
        )
    )
)

pushTypeScriptFunction(
  imports: IRTSImport,
  text: String,
  routine: Bool
) -> IRTSImport => {
  open := text.indexOf("(")
  close := text.indexOf(")")
  name := (
    open < 0 ? ""
      : text.slice(0, open).trim()
  )
  returnType := typeScriptReturnTypeName(text)
  (
    name != "" ? imports.functions.push(IRFunction {
      name: name,
      private: false,
      static: false,
      routine: routine,
      macro: false,
      receiverType: "",
      generics: [],
      params: (
        (open >= 0) && (close > open) ? parseTypeScriptParams(text.slice(open + 1, close))
          : [emptyIRParam()].slice(0, 0)
      ),
      returnType: returnType,
      body: emptyIRExpr(),
      line: 0,
      column: 0
    })
  )
  imports
}

pushTypeScriptValue(
  imports: IRTSImport,
  text: String
) -> IRTSImport => {
  end := typeScriptNameEnd(text)
  name := text.slice(0, end).trim()
  typeName := typeScriptValueTypeName(text)
  (
    name != "" ? imports.values.push(IRConst {
      name: name,
      private: false,
      typeName: typeName,
      value: emptyIRExpr(),
      line: 0,
      column: 0
    })
  )
  imports
}

typeScriptNameEnd(text: String) -> Int => {
  colon := text.indexOf(":")
  equal := text.indexOf("=")
  (
    (colon >= 0) && ((equal < 0) || (colon < equal)) ? colon
      : (
        equal >= 0 ? equal
          : text.length()
      )
  )
}

typeScriptReturnTypeName(
  text: String
) -> String => {
  close := text.indexOf(")")
  colon := (
    close >= 0 ? text.slice(close + 1, text.length()).indexOf(":")
      : -1
  )
  (
    (close >= 0) && (colon >= 0) ? typeScriptTextType(text.slice(((close + 1) + colon) + 1, typeScriptReturnTypeEnd(text)).trim())
      : "Dynamic"
  )
}

typeScriptReturnTypeEnd(
  text: String
) -> Int => {
  brace := text.indexOf("{")
  semi := text.indexOf(";")
  (
    (brace >= 0) && ((semi < 0) || (brace < semi)) ? brace
      : (
        semi >= 0 ? semi
          : text.length()
      )
  )
}

typeScriptValueTypeName(
  text: String
) -> String => {
  colon := text.indexOf(":")
  (
    colon < 0 ? "Dynamic"
      : typeScriptTextType(text.slice(colon + 1, (typeScriptNameEnd(text.slice(colon + 1, text.length())) + colon) + 1).trim())
  )
}

parseTypeScriptParams(
  text: String
) -> Array[IRParam] => {
  params := [emptyIRParam()].slice(0, 0)
  text.split(",").each((param) => (
    param.trim() != "" ? params.push(parseTypeScriptParam(param.trim()))
  ))
  params
}

emptyIRParam() -> IRParam => {
  name: "",
  typeName: "Dynamic",
  line: 0,
  column: 0
}

emptyIRConst() -> IRConst => {
  name: "",
  private: false,
  typeName: "Dynamic",
  value: emptyIRExpr(),
  line: 0,
  column: 0
}

parseTypeScriptParam(
  text: String
) -> IRParam => {
  colon := text.indexOf(":")
  rawName := (
    colon < 0 ? text
      : text.slice(0, colon)
  )
  name := rawName.replaceAll("...", "").replaceAll("?", "").trim()
  IRParam {
    name: name,
    typeName: (
      colon < 0 ? "Dynamic"
        : typeScriptTextType(text.slice(colon + 1, text.length()).trim())
    ),
    line: 0,
    column: 0
  }
}

typeScriptTextType(
  text: String
) -> String => text {
  "string" => "String"
  "boolean" => "Bool"
  "bigint" => "BigInt"
  "number" => "Double"
  "void" | "undefined" => "Void"
  _ => "Dynamic"
}

emptyCompilerIRFile() -> IRFile => {
  imports: [],
  tsImports: [],
  structs: [],
  enums: [],
  constants: [],
  functions: [],
  tests: [],
  errors: []
}

mergeCompilerIRFile(
  out: IRFile,
  file: IRFile
) -> IRFile => {
  file.imports.each((importDecl) => out.imports.push(importDecl))
  file.tsImports.each((importDecl) => out.tsImports.push(importDecl))
  file.structs.each((typeDecl) => out.structs.push(typeDecl))
  file.enums.each((typeDecl) => out.enums.push(typeDecl))
  file.constants.each((constant) => out.constants.push(constant))
  file.functions.each((fn) => out.functions.push(fn))
  file.tests.each((testDecl) => out.tests.push(testDecl))
  file.errors.each((error) => out.errors.push(error))
  out
}

compileResult(
  ok: Bool,
  output: String,
  errors: Array[String]
) -> CompileResult => {
  ok: ok,
  output: output,
  errors: errors
}

unsupportedTargetErrors(
  target: String
) -> Array[String] => {
  errors := []
  errors.push("unsupported target " + target)
  errors
}

parseErrorMessages(
  errors: Array[ParseError]
) -> Array[String] => {
  out := []
  errors.each((error) => out.push((((("line " + compilerIntToString(error.line)) + ":") + compilerIntToString(error.column)) + ": ") + error.message))
  out
}
