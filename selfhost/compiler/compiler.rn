@"../ir/ir.rn"
@"./common.rn"
@"./go.rn"
@"./mbt.rn"
@"./ts.rn"

+ CompileResult: {
  ok: Bool
  output: String
  errors: Array[String]
}

+ SourceFile: {
  path: String
  source: String
}

+ compileTypeScript(
  source: String
) -> CompileResult => compile(source, "ts")

+ compileGo(
  source: String
) -> CompileResult => compile(source, "go")

+ compileMoonBit(
  source: String
) -> CompileResult => compile(source, "mbt")

+ compile(
  source: String,
  target: String
) -> CompileResult => {
  file := lower(source)
  compileFile(file, target)
}

+ compileTypeScriptFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "ts")

+ compileGoFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "go")

+ compileMoonBitFiles(
  files: Array[SourceFile]
) -> CompileResult => compileFiles(files, "mbt")

+ compileFiles(
  files: Array[SourceFile],
  target: String
) -> CompileResult => {
  file := lowerFiles(files)
  compileFile(file, target)
}

compileFile(
  file: IRFile,
  target: String
) -> CompileResult => (
  (
    file.errors.length() > 0 ? compileResult(false, "", parseErrorMessages(file.errors))
      : compileCheckedFile(file, target)
  )
)

compileCheckedFile(
  file: IRFile,
  target: String
) -> CompileResult => {
  errors := checkFileErrors(file)
  (
    errors.length() > 0 ? compileResult(false, "", errors)
      : target {
        "ts" => compileResult(true, generateTypeScript(file), [])
        "go" => compileResult(true, generateGo(file), [])
        "mbt" => compileResult(true, generateMoonBit(file), [])
        _ => compileResult(false, "", unsupportedTargetErrors(target))
      }
  )
}

checkFileErrors(
  file: IRFile
) -> Array[String] => {
  names := compilerCallableNames(file)
  errors := [""].slice(0, 0)
  file.functions.each((fn) => errors = checkExpr(fn.body, names, errors))
  file.structs.each((typeDecl) => typeDecl.methods.each((method) => errors = checkExpr(method.body, names, errors)))
  file.enums.each((typeDecl) => typeDecl.methods.each((method) => errors = checkExpr(method.body, names, errors)))
  file.tests.each((testDecl) => errors = checkExpr(testDecl.body, names, errors))
  errors
}

compilerCallableNames(
  file: IRFile
) -> Array[String] => {
  names := [""].slice(0, 0)
  file.functions.each((fn) => names.push(fn.name))
  file.enums.each((typeDecl) => typeDecl.members.each((member) => names.push(member.name)))
  names
}

checkExpr(
  expr: IRExpr,
  names: Array[String],
  errors: Array[String]
) -> Array[String] => {
  next := (
    isUnknownFunctionCall(expr, names) ? [..errors, "undefined function " + expr.children[0].name]
      : errors
  )
  expr.children.each((child) => next = checkExpr(child, names, next))
  next
}

isUnknownFunctionCall(
  expr: IRExpr,
  names: Array[String]
) -> Bool => (
  ((expr.kind == ExprKind.Call) && (expr.children.length() > 0)) && (expr.children[0].kind == ExprKind.Identifier) ? compilerContains(names, expr.children[0].name) == false
    : false
)

compilerContains(
  values: Array[String],
  value: String
) -> Bool => compilerContainsAt(values, value, 0)

compilerContainsAt(
  values: Array[String],
  value: String,
  index: Int
) -> Bool => (
  index >= values.length() ? false
    : (
      values[index] == value ? true
        : compilerContainsAt(values, value, index + 1)
    )
)

lowerFiles(
  files: Array[SourceFile]
) -> IRFile => {
  out := emptyCompilerIRFile()
  files.each((file) => out = mergeCompilerIRFile(out, lower(file.source)))
  out
}

emptyCompilerIRFile() -> IRFile => {
  imports: [],
  structs: [],
  enums: [],
  constants: [],
  functions: [],
  tests: [],
  errors: []
}

mergeCompilerIRFile(
  out: IRFile,
  file: IRFile
) -> IRFile => {
  file.imports.each((importDecl) => out.imports.push(importDecl))
  file.structs.each((typeDecl) => out.structs.push(typeDecl))
  file.enums.each((typeDecl) => out.enums.push(typeDecl))
  file.constants.each((constant) => out.constants.push(constant))
  file.functions.each((fn) => out.functions.push(fn))
  file.tests.each((testDecl) => out.tests.push(testDecl))
  file.errors.each((error) => out.errors.push(error))
  out
}

compileResult(
  ok: Bool,
  output: String,
  errors: Array[String]
) -> CompileResult => {
  ok: ok,
  output: output,
  errors: errors
}

unsupportedTargetErrors(
  target: String
) -> Array[String] => {
  errors := []
  errors.push("unsupported target " + target)
  errors
}

parseErrorMessages(
  errors: Array[ParseError]
) -> Array[String] => {
  out := []
  errors.each((error) => out.push((((("line " + compilerIntToString(error.line)) + ":") + compilerIntToString(error.column)) + ": ") + error.message))
  out
}
