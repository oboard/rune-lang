+ RuneCliInvocation: {
  ok: Bool
  command: String
  backend: String
  path: String
  output: String
  target: String
  pattern: String
  checkOnly: Bool
  stdout: Bool
  backendExplicit: Bool
  runArgs: Array[String]
  errors: Array[String]
  help: Bool
  helpText: String
}

+ RuneCliExecution: {
  ok: Bool
  output: String
  errors: Array[String]
}

#cli.command("rune-selfhost", "Self-hosted Rune CLI entry point", "0.0.0")
RuneCliArgsEntry: {
  #cli.option("b", "BACKEND", "target backend", "go")
  backend: String
  #cli.arg("rune command")
  command: String
}

+ parseCli(
  args: Array[String]
) -> RuneCliInvocation => {
  parsed := @cli.parseCommandArgs(runeCommand(), runeCommands(), runeAliases(), ["run"], args)
  root := parsed.root
  backend := root.values.getOr("backend", "go")
  errors := cliErrors(root)
  commandError := parsed.error ?? ""
  (
    commandError.isEmpty() ? 0
      : errors.push(commandError)
  )
  invalidBackend := @cli.contains(["go", "ts", "mbt"], backend) == false
  (
    invalidBackend ? errors.push("unsupported backend " + backend)
      : 0
  )
  backendExplicit := @cli.contains(root.explicitOptions, "backend")
  (
    errors.length() > 0 ? errorInvocation("", backend, errors)
      : (
        parsed.commandName.isEmpty() ? helpInvocation(backend)
          : invocationFromResult(parsed.commandName, backend, backendExplicit, parsed.command)
      )
  )
}

+ runCli(
  args: Array[String]
) -> RuneCliExecution => {
  invocation := parseCli(args)
  (
    invocation.help ? successExecution(invocation.helpText)
      : (
        invocation.ok ? executeInvocation(invocation)
          : failureExecution(invocation.errors)
      )
  )
}

executeInvocation(
  invocation: RuneCliInvocation
) -> RuneCliExecution => invocation.command {
  "run" => hostRun(invocation.path, invocation.backend, invocation.backendExplicit, invocation.target, invocation.runArgs)
  "build" => hostBuild(invocation.path, invocation.backend, invocation.target, invocation.output)
  "go" => hostEmit("go", invocation.path, invocation.output)
  "ts" => hostEmit("ts", invocation.path, invocation.output)
  "mbt" => hostEmit("mbt", invocation.path, invocation.output)
  "check" => hostCheck(invocation.path)
  "test" => hostTest(invocation.path, invocation.pattern, invocation.backend, invocation.backendExplicit)
  "fmt" => hostFmt(invocation.path, invocation.checkOnly, invocation.stdout)
  "repl" => hostRepl()
  "lsp" => hostLsp()
  _ => failureExecution(["unknown command " + invocation.command])
}

successExecution(
  output: String
) -> RuneCliExecution => {
  ok: true,
  output: output,
  errors: []
}

failureExecution(
  errors: Array[String]
) -> RuneCliExecution => {
  ok: false,
  output: "",
  errors: errors
}

hostRun(
  path: String,
  backend: String,
  backendExplicit: Bool,
  target: String,
  args: Array[String]
) -> RuneCliExecution => @go.expr("hostRun($path, $backend, $backendExplicit, $target, $args)")

hostBuild(
  path: String,
  backend: String,
  target: String,
  output: String
) -> RuneCliExecution => @go.expr("hostBuild($path, $backend, $target, $output)")

hostEmit(
  backend: String,
  path: String,
  output: String
) -> RuneCliExecution => @go.expr("hostEmit($backend, $path, $output)")

hostCheck(
  path: String
) -> RuneCliExecution => @go.expr("hostCheck($path)")

hostTest(
  path: String,
  pattern: String,
  backend: String,
  backendExplicit: Bool
) -> RuneCliExecution => @go.expr("hostTest($path, $pattern, $backend, $backendExplicit)")

hostFmt(
  path: String,
  checkOnly: Bool,
  stdout: Bool
) -> RuneCliExecution => @go.expr("hostFmt($path, $checkOnly, $stdout)")

hostRepl() -> RuneCliExecution => @go.expr("hostRepl()")

hostLsp() -> RuneCliExecution => @go.expr("hostLsp()")

+ runeCommand() -> CliCommand => {
  command := @cli.command("rune", "Rune language toolchain")
  command = @cli.withOption(command, @cli.option("backend", "b", "BACKEND", "target backend", false, "go"))
  command
}

+ runeCommands() -> Array[CliCommand] => [
  runCommand(),
  buildCommand(),
  emitCommand("go"),
  emitCommand("ts"),
  emitCommand("mbt"),
  singlePathCommand("check"),
  fmtCommand(),
  testCommand(),
  @cli.command("repl", ""),
  lspCommand()
]

+ runeAliases() -> Array[CliCommandAlias] => [
  @cli.alias("format", "fmt")
]

+ runCommand() -> CliCommand => {
  command := @cli.command("run", "Compile and run a Rune program")
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "MoonBit run target", false, null))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ buildCommand() -> CliCommand => {
  command := @cli.command("build", "Compile a Rune program to an executable")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output executable path", false, ""))
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "build target", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ emitCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Compile a Rune program")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output file", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ singlePathCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Parse and type-check Rune source")
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ fmtCommand() -> CliCommand => {
  command := @cli.command("fmt", "Format Rune source")
  command = @cli.withOption(command, @cli.flag("check", "", "fail if not formatted"))
  command = @cli.withOption(command, @cli.flag("stdout", "", "write formatted source to stdout"))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ testCommand() -> CliCommand => {
  command := @cli.command("test", "Run Rune tests")
  command = @cli.withArgument(command, @cli.argument("path", "Rune test path", false))
  @cli.withArgument(command, @cli.argument("pattern", "test name pattern", false))
}

+ lspCommand() -> CliCommand => {
  command := @cli.command("lsp", "Start the Rune language server")
  @cli.withOption(command, @cli.flag("stdio", "", "serve LSP over stdin/stdout"))
}

invocationFromResult(
  name: String,
  backend: String,
  backendExplicit: Bool,
  result: CliParseResult
) -> RuneCliInvocation => {
  errors := cliErrors(result)
  target := result.values.getOr("target", "")
  target = defaultTargetForCommand(name, backend, target)
  errors = invocationErrors(name, backend, target, errors)
  RuneCliInvocation {
    ok: errors.isEmpty(),
    command: name,
    backend: backend,
    path: defaultPathForCommand(name, result.positionals.getOr("path", "")),
    output: result.values.getOr("output", ""),
    target: target,
    pattern: result.positionals.getOr("pattern", ""),
    checkOnly: result.flags.getOr("check", false),
    stdout: result.flags.getOr("stdout", false),
    backendExplicit: backendExplicit,
    runArgs: result.rest,
    errors: errors,
    help: result.help,
    helpText: invocationHelpText(name)
  }
}

invocationErrors(
  name: String,
  backend: String,
  target: String,
  errors: Array[String]
) -> Array[String] => (
  (name == "build") && (@cli.contains(["go", "mbt"], backend) == false) ? [..errors, "rune build only supports --backend go or --backend mbt"]
    : (
      ((name == "run") && (target.isEmpty() == false)) && (backend != "mbt") ? [..errors, "rune run --target is only supported with --backend mbt"]
        : errors
    )
)

defaultTargetForCommand(
  name: String,
  backend: String,
  target: String
) -> String => (
  ((name == "run") && (backend == "mbt")) && target.isEmpty() ? "native"
    : target
)

defaultPathForCommand(
  name: String,
  path: String
) -> String => (
  (name == "test") && path.isEmpty() ? "tests"
    : path
)

invocationHelpText(
  name: String
) -> String => name {
  "run" => @cli.help(runCommand())
  "build" => @cli.help(buildCommand())
  "go" => @cli.help(emitCommand("go"))
  "ts" => @cli.help(emitCommand("ts"))
  "mbt" => @cli.help(emitCommand("mbt"))
  "check" => @cli.help(singlePathCommand("check"))
  "fmt" => @cli.help(fmtCommand())
  "test" => @cli.help(testCommand())
  "repl" => @cli.help(@cli.command("repl", ""))
  "lsp" => @cli.help(lspCommand())
  _ => @cli.help(runeCommand())
}

cliErrors(
  result: CliParseResult
) -> Array[String] => {
  error := result.error ?? ""
  errors := []
  (
    error.isEmpty() ? 0
      : errors.push(error)
  )
  errors
}

helpInvocation(
  backend: String
) -> RuneCliInvocation => {
  ok: true,
  command: "",
  backend: backend,
  path: "",
  output: "",
  target: "",
    pattern: "",
    checkOnly: false,
    stdout: false,
    backendExplicit: false,
    runArgs: [],
    errors: [],
    help: true,
    helpText: @cli.help(runeCommand())
}

errorInvocation(
  command: String,
  backend: String,
  errors: Array[String]
) -> RuneCliInvocation => {
  ok: false,
  command: command,
  backend: backend,
  path: "",
  output: "",
  target: "",
    pattern: "",
    checkOnly: false,
    stdout: false,
    backendExplicit: false,
    runArgs: [],
    errors: errors,
    help: false,
    helpText: ""
}

#cli.main
main(args: RuneCliArgsEntry) => {
  invocation := parseCli(["--backend=" + args.backend, args.command])
  (
    invocation.help ? @io.print(@cli.help(runeCommand()))
      : @io.println(invocation.command)
  )
}
