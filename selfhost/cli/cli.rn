+ RuneCliInvocation: {
  ok: Bool
  command: String
  backend: String
  path: String
  output: String
  target: String
  pattern: String
  checkOnly: Bool
  stdout: Bool
  backendExplicit: Bool
  runArgs: Array[String]
  errors: Array[String]
  help: Bool
  helpText: String
}

#cli.parser("runeCommand", "runeCommands", "runeAliases", "runeTrailingRest", "invocationFromParsed")
+ parseCli(
  args: Array[String]
) -> RuneCliInvocation => emptyInvocation()

invocationFromParsed(
  parsed: CliCommandParseResult,
  rootCommand: CliCommand,
  commands: Array[CliCommand]
) -> RuneCliInvocation => {
  root := parsed.root
  backend := root.values.getOr("backend", "go")
  errors := cliErrors(root)
  commandError := parsed.error ?? ""
  (
    commandError.isEmpty() ? 0
      : errors.push(commandError)
  )
  invalidBackend := @cli.contains(["go", "ts", "mbt"], backend) == false
  (
    invalidBackend ? errors.push("unsupported backend " + backend)
      : 0
  )
  backendExplicit := @cli.contains(root.explicitOptions, "backend")
  (
    errors.length() > 0 ? errorInvocation(backend, errors)
      : (
        parsed.commandName.isEmpty() ? helpInvocation(rootCommand, backend, backendExplicit)
          : invocationFromResult(parsed.commandName, rootCommand, commands, backend, backendExplicit, parsed.command)
      )
  )
}

invocationFromResult(
  name: String,
  rootCommand: CliCommand,
  commands: Array[CliCommand],
  backend: String,
  backendExplicit: Bool,
  result: CliParseResult
) -> RuneCliInvocation => {
  errors := cliErrors(result)
  target := result.values.getOr("target", "")
  target = defaultTargetForCommand(name, backend, target)
  errors = invocationErrors(name, backend, target, errors)
  RuneCliInvocation {
    ok: errors.isEmpty(),
    command: name,
    backend: backend,
    path: defaultPathForCommand(name, result.positionals.getOr("path", "")),
    output: result.values.getOr("output", ""),
    target: target,
    pattern: result.positionals.getOr("pattern", ""),
    checkOnly: result.flags.getOr("check", false),
    stdout: result.flags.getOr("stdout", false),
    backendExplicit: backendExplicit,
    runArgs: result.rest,
    errors: errors,
    help: result.help,
    helpText: @cli.help(invocationHelpCommand(rootCommand, commands, name))
  }
}

invocationErrors(
  name: String,
  backend: String,
  target: String,
  errors: Array[String]
) -> Array[String] => (
  (name == "build") && (@cli.contains(["go", "mbt"], backend) == false) ? [..errors, "rune build only supports --backend go or --backend mbt"]
    : (
      ((name == "run") && (target.isEmpty() == false)) && (backend != "mbt") ? [..errors, "rune run --target is only supported with --backend mbt"]
        : errors
    )
)

defaultTargetForCommand(
  name: String,
  backend: String,
  target: String
) -> String => (
  ((name == "run") && (backend == "mbt")) && target.isEmpty() ? "native"
    : target
)

defaultPathForCommand(
  name: String,
  path: String
) -> String => (
  (name == "test") && path.isEmpty() ? "tests"
    : path
)

invocationHelpCommand(
  rootCommand: CliCommand,
  commands: Array[CliCommand],
  name: String
) -> CliCommand => commands.foldl(rootCommand, (found, command) => (
  command.name == name ? command
    : found
))

cliErrors(
  result: CliParseResult
) -> Array[String] => {
  error := result.error ?? ""
  errors := []
  (
    error.isEmpty() ? 0
      : errors.push(error)
  )
  errors
}

helpInvocation(
  rootCommand: CliCommand,
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  ok: true,
  command: "",
  backend: backend,
  path: "",
  output: "",
  target: "",
  pattern: "",
  checkOnly: false,
  stdout: false,
  backendExplicit: backendExplicit,
  runArgs: [],
  errors: [],
  help: true,
  helpText: @cli.help(rootCommand)
}

errorInvocation(
  backend: String,
  errors: Array[String]
) -> RuneCliInvocation => {
  ok: false,
  command: "",
  backend: backend,
  path: "",
  output: "",
  target: "",
  pattern: "",
  checkOnly: false,
  stdout: false,
  backendExplicit: false,
  runArgs: [],
  errors: errors,
  help: false,
  helpText: ""
}

emptyInvocation() -> RuneCliInvocation => errorInvocation("", [])

+ runeCommand() -> CliCommand => {
  command := @cli.command("rune", "Rune language toolchain")
  command = @cli.withOption(command, @cli.option("backend", "b", "BACKEND", "target backend", false, "go"))
  command = @cli.withCommands(command, runeCommands())
  @cli.withAliases(command, runeAliases())
}

+ runeCommands() -> Array[CliCommand] => [
  runCommand(),
  buildCommand(),
  emitCommand("go"),
  emitCommand("ts"),
  emitCommand("dts"),
  emitCommand("mbt"),
  singlePathCommand("check"),
  fmtCommand(),
  testCommand(),
  @cli.command("repl", ""),
  lspCommand()
]

+ runeAliases() -> Array[CliCommandAlias] => [
  @cli.alias("format", "fmt")
]

+ runeTrailingRest() -> Array[String] => ["run"]

+ runCommand() -> CliCommand => {
  command := @cli.command("run", "Compile and run a Rune program")
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "MoonBit run target", false, null))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ buildCommand() -> CliCommand => {
  command := @cli.command("build", "Compile a Rune program to an executable")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output executable path", false, ""))
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "build target", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ emitCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Compile a Rune program")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output file", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ singlePathCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Parse and type-check Rune source")
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ fmtCommand() -> CliCommand => {
  command := @cli.command("fmt", "Format Rune source")
  command = @cli.withOption(command, @cli.flag("check", "", "fail if not formatted"))
  command = @cli.withOption(command, @cli.flag("stdout", "", "write formatted source to stdout"))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ testCommand() -> CliCommand => {
  command := @cli.command("test", "Run Rune tests")
  command = @cli.withArgument(command, @cli.argument("path", "Rune test path", false))
  @cli.withArgument(command, @cli.argument("pattern", "test name pattern", false))
}

+ lspCommand() -> CliCommand => {
  command := @cli.command("lsp", "Start the Rune language server")
  @cli.withOption(command, @cli.flag("stdio", "", "serve LSP over stdin/stdout"))
}

main() => {
  argv := @process.argv()
  invocation := parseCli(argv.slice(1, argv.length()))
  (
    invocation.help ? @io.print(@cli.help(runeCommand()))
      : @io.println(invocation.command)
  )
}
