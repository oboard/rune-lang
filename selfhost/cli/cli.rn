+ RuneCliInvocation: {
  ok: Bool
  command: String
  backend: String
  path: String
  output: String
  target: String
  pattern: String
  checkOnly: Bool
  stdout: Bool
  backendExplicit: Bool
  runArgs: Array[String]
  errors: Array[String]
  help: Bool
  helpText: String
}

+ RuneCliExecution: {
  ok: Bool
  output: String
  errors: Array[String]
}

+ RuneCliRootArgs: {
  globalArgs: Array[String]
  commandArgs: Array[String]
  backendExplicit: Bool
}

#cli.command("rune-selfhost", "Self-hosted Rune CLI entry point", "0.0.0")
RuneCliArgsEntry: {
  #cli.option("b", "BACKEND", "target backend", "go")
  backend: String
  #cli.arg("rune command")
  command: String
}

+ parseCli(
  args: Array[String]
) -> RuneCliInvocation => {
  split := splitRootArgs(args)
  root := parseRoot(split.globalArgs)
  backend := root.values.getOr("backend", "go")
  errors := cliErrors(root)
  invalidBackend := @cli.contains(["go", "ts", "mbt"], backend) == false
  (
    invalidBackend ? errors.push("unsupported backend " + backend)
      : 0
  )
  (
    errors.length() > 0 ? errorInvocation("", backend, errors)
      : parseCommandAt(split.commandArgs, 0, backend, split.backendExplicit)
  )
}

+ runeCommand() -> CliCommand => {
  command := @cli.command("rune", "Rune language toolchain")
  command = @cli.withOption(command, @cli.option("backend", "b", "BACKEND", "target backend", false, "go"))
  command
}

parseRoot(
  args: Array[String]
) -> CliParseResult => {
  command := runeCommand()
  @cli.parseArgs(command, args)
}

splitRootArgs(
  args: Array[String]
) -> RuneCliRootArgs => {
  splitRootArgsAt(args, 0, [], [], false, false, false)
}

splitRootArgsAt(
  args: Array[String],
  position: Int,
  globalArgs: Array[String],
  commandArgs: Array[String],
  backendExplicit: Bool,
  skipNext: Bool,
  inRest: Bool
) -> RuneCliRootArgs => (
  position >= args.length() ? RuneCliRootArgs {
    globalArgs: globalArgs,
    commandArgs: commandArgs,
    backendExplicit: backendExplicit
  }
    : splitRootArgAt(args, position, globalArgs, commandArgs, backendExplicit, skipNext, inRest)
)

splitRootArgAt(
  args: Array[String],
  position: Int,
  globalArgs: Array[String],
  commandArgs: Array[String],
  backendExplicit: Bool,
  skipNext: Bool,
  inRest: Bool
) -> RuneCliRootArgs => skipNext {
  true => splitRootArgsAt(args, position + 1, globalArgs, commandArgs, backendExplicit, false, inRest)
  _ => splitRootArgValue(args, position, globalArgs, commandArgs, backendExplicit, inRest)
}

splitRootArgValue(
  args: Array[String],
  position: Int,
  globalArgs: Array[String],
  commandArgs: Array[String],
  backendExplicit: Bool,
  inRest: Bool
) -> RuneCliRootArgs => {
  arg := args[position]
  backendPair := isRootBackendPair(inRest, arg)
  hasBackendValue := backendPair && ((position + 1) < args.length())
  backendInline := isRootBackendInline(inRest, arg)
  rootHelp := isRootHelpArg(inRest, commandArgs.length(), arg)
  (
    backendPair ? splitRootAfterBackendPair(args, position, globalArgs, commandArgs, hasBackendValue, inRest)
      : (
        backendInline ? splitRootAfterBackendInline(args, position, globalArgs, commandArgs, inRest)
          : (
            rootHelp ? splitRootAfterGlobal(args, position, globalArgs, commandArgs, backendExplicit, inRest)
              : splitRootAfterCommand(args, position, globalArgs, commandArgs, backendExplicit, inRest)
          )
      )
  )
}

isRootBackendPair(
  inRest: Bool,
  arg: String
) -> Bool => (
  (inRest == false) && @cli.contains(["--backend", "-b"], arg)
)

isRootBackendInline(
  inRest: Bool,
  arg: String
) -> Bool => (
  (inRest == false) && (arg.startsWith("--backend=") || (arg.startsWith("-b") && (arg.length() > 2)))
)

isRootHelpArg(
  inRest: Bool,
  commandCount: Int,
  arg: String
) -> Bool => (
  ((inRest == false) && (commandCount == 0)) && @cli.contains(["--help", "-h"], arg)
)

splitRootAfterBackendPair(
  args: Array[String],
  position: Int,
  globalArgs: Array[String],
  commandArgs: Array[String],
  hasValue: Bool,
  inRest: Bool
) -> RuneCliRootArgs => {
  globalArgs.push(args[position])
  (
    hasValue ? globalArgs.push(args[position + 1])
      : 0
  )
  splitRootArgsAt(args, position + 1, globalArgs, commandArgs, true, hasValue, inRest)
}

splitRootAfterBackendInline(
  args: Array[String],
  position: Int,
  globalArgs: Array[String],
  commandArgs: Array[String],
  inRest: Bool
) -> RuneCliRootArgs => {
  globalArgs.push(args[position])
  splitRootArgsAt(args, position + 1, globalArgs, commandArgs, true, false, inRest)
}

splitRootAfterGlobal(
  args: Array[String],
  position: Int,
  globalArgs: Array[String],
  commandArgs: Array[String],
  backendExplicit: Bool,
  inRest: Bool
) -> RuneCliRootArgs => {
  globalArgs.push(args[position])
  splitRootArgsAt(args, position + 1, globalArgs, commandArgs, backendExplicit, false, inRest)
}

splitRootAfterCommand(
  args: Array[String],
  position: Int,
  globalArgs: Array[String],
  commandArgs: Array[String],
  backendExplicit: Bool,
  inRest: Bool
) -> RuneCliRootArgs => {
  commandArgs.push(args[position])
  splitRootArgsAt(args, position + 1, globalArgs, commandArgs, backendExplicit, false, inRest || (args[position] == "--"))
}

parseCommandAt(
  args: Array[String],
  index: Int,
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => (
  index >= args.length() ? helpInvocation(backend)
    : dispatchCommand(args[index], args.slice(index + 1, args.length()), backend, backendExplicit)
)

dispatchCommand(
  command: String,
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => command {
  "run" => parseRun(args, backend, backendExplicit)
  "build" => parseBuild(args, backend, backendExplicit)
  "check" => parseSinglePath(command, args, backend, backendExplicit)
  "fmt" | "format" => parseFmt(args, backend, backendExplicit)
  "test" => parseTest(args, backend, backendExplicit)
  "ts" | "go" | "mbt" => parseEmit(command, args, backend, backendExplicit)
  "repl" => parseNoArgs(command, args, backend, backendExplicit)
  "lsp" => parseLsp(args, backend, backendExplicit)
  _ => errorInvocation(command, backend, ["unknown command " + command])
}

parseRun(
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(runCommand(), normalizeRunArgs(args))
  invocationFromResult("run", backend, backendExplicit, result, result.rest, false, false)
}

normalizeRunArgs(
  args: Array[String]
) -> Array[String] => normalizeRunArgsAt(args, 0, [], false, false)

normalizeRunArgsAt(
  args: Array[String],
  index: Int,
  out: Array[String],
  seenPath: Bool,
  skipValue: Bool
) -> Array[String] => (
  index >= args.length() ? out
    : normalizeRunArgAt(args, index, out, seenPath, skipValue)
)

normalizeRunArgAt(
  args: Array[String],
  index: Int,
  out: Array[String],
  seenPath: Bool,
  skipValue: Bool
) -> Array[String] => {
  arg := args[index]
  (
    seenPath && (arg != "--") ? appendRunRest(args, index, [..out, "--"])
      : (
        arg == "--" ? appendRunRest(args, index, out)
          : normalizeRunArgBeforeRest(args, index, [..out, arg], seenPath, skipValue)
      )
  )
}

normalizeRunArgBeforeRest(
  args: Array[String],
  index: Int,
  out: Array[String],
  seenPath: Bool,
  skipValue: Bool
) -> Array[String] => (
  skipValue ? normalizeRunArgsAt(args, index + 1, out, seenPath, false)
    : (
      isRunOptionValueArg(args[index]) ? normalizeRunArgsAt(args, index + 1, out, seenPath, true)
        : normalizeRunArgsAt(args, index + 1, out, seenPath || !args[index].startsWith("-"), false)
    )
)

isRunOptionValueArg(
  arg: String
) -> Bool => arg == "--target"

appendRunRest(
  args: Array[String],
  index: Int,
  out: Array[String]
) -> Array[String] => (
  index >= args.length() ? out
    : appendRunRest(args, index + 1, [..out, args[index]])
)

+ runCommand() -> CliCommand => {
  command := @cli.command("run", "Compile and run a Rune program")
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "MoonBit run target", false, null))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

parseBuild(
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(buildCommand(), args)
  invocationFromResult("build", backend, backendExplicit, result, [], false, false)
}

+ buildCommand() -> CliCommand => {
  command := @cli.command("build", "Compile a Rune program to an executable")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output executable path", false, ""))
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "build target", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

parseEmit(
  name: String,
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(emitCommand(name), args)
  invocationFromResult(name, backend, backendExplicit, result, [], false, false)
}

+ emitCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Compile a Rune program")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output file", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

parseSinglePath(
  name: String,
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(singlePathCommand(name), args)
  invocationFromResult(name, backend, backendExplicit, result, [], false, false)
}

+ singlePathCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Parse and type-check Rune source")
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

parseFmt(
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(fmtCommand(), args)
  invocationFromResult("fmt", backend, backendExplicit, result, [], result.flags.getOr("check", false), result.flags.getOr("stdout", false))
}

+ fmtCommand() -> CliCommand => {
  command := @cli.command("fmt", "Format Rune source")
  command = @cli.withOption(command, @cli.flag("check", "", "fail if not formatted"))
  command = @cli.withOption(command, @cli.flag("stdout", "", "write formatted source to stdout"))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

parseTest(
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(testCommand(), args)
  invocationFromResult("test", backend, backendExplicit, result, [], false, false)
}

+ testCommand() -> CliCommand => {
  command := @cli.command("test", "Run Rune tests")
  command = @cli.withArgument(command, @cli.argument("path", "Rune test path", false))
  @cli.withArgument(command, @cli.argument("pattern", "test name pattern", false))
}

parseNoArgs(
  name: String,
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(@cli.command(name, ""), args)
  invocationFromResult(name, backend, backendExplicit, result, [], false, false)
}

parseLsp(
  args: Array[String],
  backend: String,
  backendExplicit: Bool
) -> RuneCliInvocation => {
  result := @cli.parseArgs(lspCommand(), args)
  invocationFromResult("lsp", backend, backendExplicit, result, [], false, false)
}

+ lspCommand() -> CliCommand => {
  command := @cli.command("lsp", "Start the Rune language server")
  @cli.withOption(command, @cli.flag("stdio", "", "serve LSP over stdin/stdout"))
}

invocationFromResult(
  name: String,
  backend: String,
  backendExplicit: Bool,
  result: CliParseResult,
  runArgs: Array[String],
  checkOnly: Bool,
  stdout: Bool
) -> RuneCliInvocation => {
  errors := cliErrors(result)
  target := result.values.getOr("target", "")
  errors = invocationErrors(name, backend, target, errors)
  RuneCliInvocation {
    ok: errors.isEmpty(),
    command: name,
    backend: backend,
    path: defaultPathForCommand(name, result.positionals.getOr("path", "")),
    output: result.values.getOr("output", ""),
    target: target,
    pattern: result.positionals.getOr("pattern", ""),
    checkOnly: checkOnly,
    stdout: stdout,
    backendExplicit: backendExplicit,
    runArgs: runArgs,
    errors: errors,
    help: result.help,
    helpText: invocationHelpText(name)
  }
}

invocationErrors(
  name: String,
  backend: String,
  target: String,
  errors: Array[String]
) -> Array[String] => (
  (name == "build") && (@cli.contains(["go", "mbt"], backend) == false) ? [..errors, "rune build only supports --backend go or --backend mbt"]
    : (
      ((name == "run") && (target.isEmpty() == false)) && (backend != "mbt") ? [..errors, "rune run --target is only supported with --backend mbt"]
        : errors
    )
)

defaultPathForCommand(
  name: String,
  path: String
) -> String => (
  (name == "test") && path.isEmpty() ? "tests"
    : path
)

invocationHelpText(
  name: String
) -> String => name {
  "run" => @cli.help(runCommand())
  "build" => @cli.help(buildCommand())
  "go" => @cli.help(emitCommand("go"))
  "ts" => @cli.help(emitCommand("ts"))
  "mbt" => @cli.help(emitCommand("mbt"))
  "check" => @cli.help(singlePathCommand("check"))
  "fmt" => @cli.help(fmtCommand())
  "test" => @cli.help(testCommand())
  "repl" => @cli.help(@cli.command("repl", ""))
  "lsp" => @cli.help(lspCommand())
  _ => @cli.help(runeCommand())
}

cliErrors(
  result: CliParseResult
) -> Array[String] => {
  error := result.error ?? ""
  errors := []
  (
    error.isEmpty() ? 0
      : errors.push(error)
  )
  errors
}

helpInvocation(
  backend: String
) -> RuneCliInvocation => {
  ok: true,
  command: "",
  backend: backend,
  path: "",
  output: "",
  target: "",
    pattern: "",
    checkOnly: false,
    stdout: false,
    backendExplicit: false,
    runArgs: [],
    errors: [],
    help: true,
    helpText: @cli.help(runeCommand())
}

errorInvocation(
  command: String,
  backend: String,
  errors: Array[String]
) -> RuneCliInvocation => {
  ok: false,
  command: command,
  backend: backend,
  path: "",
  output: "",
  target: "",
    pattern: "",
    checkOnly: false,
    stdout: false,
    backendExplicit: false,
    runArgs: [],
    errors: errors,
    help: false,
    helpText: ""
}

#cli.main
main(args: RuneCliArgsEntry) => {
  invocation := parseCli(["--backend=" + args.backend, args.command])
  (
    invocation.help ? @io.print(@cli.help(runeCommand()))
      : @io.println(invocation.command)
  )
}
