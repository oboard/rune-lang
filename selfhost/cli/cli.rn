+ RuneCliExecution: {
  ok: Bool
  output: String
  errors: Array[String]
}

+ RuneCliStringResult: {
  ok: Bool
  value: String
  errors: Array[String]
}

#cli.command("rune-selfhost", "Self-hosted Rune CLI entry point", "0.0.0")
RuneCliArgsEntry: {
  #cli.option("b", "BACKEND", "target backend", "go")
  backend: String
  #cli.arg("rune command")
  command: String
}

+ parseCli(
  args: Array[String]
) -> RuneCliInvocation => @cli.parseRuneCli(runeCommand(), runeCommands(), runeAliases(), args)

+ runCli(
  args: Array[String]
) -> RuneCliExecution => {
  invocation := parseCli(args)
  (
    invocation.help ? successExecution(invocation.helpText)
      : (
        invocation.ok ? executeInvocation(invocation)
          : failureExecution(invocation.errors)
      )
  )
}

+ runCliMain(
  args: Array[String]
) -> Int => {
  result := runCli(args)
  (
    result.output.isEmpty() ? 0
      : hostWriteStdout(result.output)
  )
  (
    result.ok ? 0
      : renderFailure(result.errors)
  )
}

renderFailure(
  errors: Array[String]
) -> Int => {
  errors.each((message) => hostWriteStderr(message + "\n"))
  1
}

executeInvocation(
  invocation: RuneCliInvocation
) -> RuneCliExecution => invocation.command {
  "run" => executeRun(invocation)
  "build" => executeBuild(invocation)
  "go" => hostEmitGo(invocation.path, invocation.output)
  "ts" => hostEmitTypeScript(invocation.path, invocation.output)
  "mbt" => hostEmitMoonBit(invocation.path, invocation.output)
  "check" => hostCheck(invocation.path)
  "test" => executeTest(invocation)
  "fmt" => hostFmt(invocation.path, invocation.checkOnly, invocation.stdout)
  "repl" => hostRepl()
  "lsp" => hostLsp()
  _ => failureExecution(["unknown command " + invocation.command])
}

executeRun(
  invocation: RuneCliInvocation
) -> RuneCliExecution => {
  entry := hostResolveRunEntry(invocation.path)
  (
    entry.ok ? executeResolvedRun(invocation, entry.value)
      : failureExecution(entry.errors)
  )
}

executeResolvedRun(
  invocation: RuneCliInvocation,
  entry: String
) -> RuneCliExecution => {
  backend := hostSelectRunBackend(entry, invocation.backend, invocation.backendExplicit)
  validated := hostValidateBackend(backend)
  (
    validated.ok ? hostRunEntry(entry, backend, invocation.target, invocation.runArgs)
      : validated
  )
}

executeBuild(
  invocation: RuneCliInvocation
) -> RuneCliExecution => invocation.backend {
  "mbt" => hostBuildMoonBit(invocation.path, invocation.target, invocation.output)
  _ => hostBuildGo(invocation.path, invocation.target, invocation.output)
}

executeTest(
  invocation: RuneCliInvocation
) -> RuneCliExecution => (
  invocation.backendExplicit ? hostTestWithBackend(invocation.path, invocation.pattern, invocation.backend)
    : hostTest(invocation.path, invocation.pattern)
)

successExecution(
  output: String
) -> RuneCliExecution => {
  ok: true,
  output: output,
  errors: []
}

failureExecution(
  errors: Array[String]
) -> RuneCliExecution => {
  ok: false,
  output: "",
  errors: errors
}

hostWriteStdout(
  text: String
) -> Int => @go.expr("runeCliHostWriteStdout($text)")

hostWriteStderr(
  text: String
) -> Int => @go.expr("runeCliHostWriteStderr($text)")

hostResolveRunEntry(
  path: String
) -> RuneCliStringResult => @go.expr("runeCliHostResolveRunEntry($path)")

hostSelectRunBackend(
  entry: String,
  backend: String,
  backendExplicit: Bool
) -> String => @go.expr("runeCliHostSelectRunBackend($entry, $backend, $backendExplicit)")

hostValidateBackend(
  backend: String
) -> RuneCliExecution => @go.expr("runeCliHostValidateBackend($backend)")

hostRunEntry(
  path: String,
  backend: String,
  target: String,
  args: Array[String]
) -> RuneCliExecution => @go.expr("runeCliHostRunEntry($path, $backend, $target, $args)")

hostBuildGo(
  path: String,
  target: String,
  output: String
) -> RuneCliExecution => @go.expr("runeCliHostBuildGo($path, $target, $output)")

hostBuildMoonBit(
  path: String,
  target: String,
  output: String
) -> RuneCliExecution => @go.expr("runeCliHostBuildMoonBit($path, $target, $output)")

hostEmitGo(
  path: String,
  output: String
) -> RuneCliExecution => @go.expr("runeCliHostEmitGo($path, $output)")

hostEmitTypeScript(
  path: String,
  output: String
) -> RuneCliExecution => @go.expr("runeCliHostEmitTypeScript($path, $output)")

hostEmitMoonBit(
  path: String,
  output: String
) -> RuneCliExecution => @go.expr("runeCliHostEmitMoonBit($path, $output)")

hostCheck(
  path: String
) -> RuneCliExecution => @go.expr("runeCliHostCheck($path)")

hostTest(
  path: String,
  pattern: String
) -> RuneCliExecution => @go.expr("runeCliHostTest($path, $pattern)")

hostTestWithBackend(
  path: String,
  pattern: String,
  backend: String
) -> RuneCliExecution => @go.expr("runeCliHostTestWithBackend($path, $pattern, $backend)")

hostFmt(
  path: String,
  checkOnly: Bool,
  stdout: Bool
) -> RuneCliExecution => @go.expr("runeCliHostFmt($path, $checkOnly, $stdout)")

hostRepl() -> RuneCliExecution => @go.expr("runeCliHostRepl()")

hostLsp() -> RuneCliExecution => @go.expr("runeCliHostLsp()")

+ runeCommand() -> CliCommand => {
  command := @cli.command("rune", "Rune language toolchain")
  command = @cli.withOption(command, @cli.option("backend", "b", "BACKEND", "target backend", false, "go"))
  command
}

+ runeCommands() -> Array[CliCommand] => [
  runCommand(),
  buildCommand(),
  emitCommand("go"),
  emitCommand("ts"),
  emitCommand("mbt"),
  singlePathCommand("check"),
  fmtCommand(),
  testCommand(),
  @cli.command("repl", ""),
  lspCommand()
]

+ runeAliases() -> Array[CliCommandAlias] => [
  @cli.alias("format", "fmt")
]

+ runCommand() -> CliCommand => {
  command := @cli.command("run", "Compile and run a Rune program")
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "MoonBit run target", false, null))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ buildCommand() -> CliCommand => {
  command := @cli.command("build", "Compile a Rune program to an executable")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output executable path", false, ""))
  command = @cli.withOption(command, @cli.option("target", "", "TARGET", "build target", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ emitCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Compile a Rune program")
  command = @cli.withOption(command, @cli.option("output", "o", "FILE", "output file", false, ""))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ singlePathCommand(
  name: String
) -> CliCommand => {
  command := @cli.command(name, "Parse and type-check Rune source")
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ fmtCommand() -> CliCommand => {
  command := @cli.command("fmt", "Format Rune source")
  command = @cli.withOption(command, @cli.flag("check", "", "fail if not formatted"))
  command = @cli.withOption(command, @cli.flag("stdout", "", "write formatted source to stdout"))
  @cli.withArgument(command, @cli.argument("path", "Rune source path", true))
}

+ testCommand() -> CliCommand => {
  command := @cli.command("test", "Run Rune tests")
  command = @cli.withArgument(command, @cli.argument("path", "Rune test path", false))
  @cli.withArgument(command, @cli.argument("pattern", "test name pattern", false))
}

+ lspCommand() -> CliCommand => {
  command := @cli.command("lsp", "Start the Rune language server")
  @cli.withOption(command, @cli.flag("stdio", "", "serve LSP over stdin/stdout"))
}

#cli.main
main(args: RuneCliArgsEntry) => {
  invocation := parseCli(["--backend=" + args.backend, args.command])
  (
    invocation.help ? @io.print(@cli.help(runeCommand()))
      : @io.println(invocation.command)
  )
}
